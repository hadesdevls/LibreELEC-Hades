+#pragma once
+
+#include "HdrMoreBits.h"
+
+#include <cstdint>
+#include <optional>
+
+/*!
+ * \brief Hades: a link of more than 8 bits per component that only deep colour takes above
+ *        340 MHz, looked at on the display a moment after it went out (i915 and xe, where Kodi
+ *        sets "max bpc" on an HDMI connector: LinkDepth.h)
+ *
+ * A mode whose 8-bit TMDS clock is at most 340 MHz goes over HDMI 2.0 with scrambling as soon as
+ * deep colour raises it above 340 MHz: 3840x2160 at 24, 25 and 30 Hz (297 MHz; 371 MHz at 10
+ * bits). A laptop of Tiger Lake (HP ProBook 640 G8, port B, a native HDMI port of a combo PHY)
+ * sent 3840x2160 at 24 Hz in RGB of 10 bits at 370.878 MHz, scrambled, to an LG TV, which showed
+ * no picture; the same TV, on the same input (the same EDID and the same CEC address), showed the
+ * same link from a GeForce RTX 5050 (370.875 MHz, 10 bits, scrambled), and showed from the same
+ * laptop 3840x2160 at 60 Hz in 8 bits (594 MHz, scrambled) and 1920x1080 at 60 Hz in 10 bits
+ * (185.625 MHz). Every value was within what the port (594 MHz: display version 12 and its VBT)
+ * and the display (600 MHz, 30-bit deep colour in its HDMI blocks) declare. What fails is deep
+ * colour above 340 MHz from that laptop's port, which nothing in the EDID or the driver tells.
+ *
+ * So, where such a link goes out, the display's SCDC is read through the DDC adapter of its
+ * connector (the one that the kernel names in sysfs: cardN-<connector>/ddc) CHECK_AFTER_MS after
+ * the commit, as HdrMoreBits.h does on NVIDIA: where the display says that it did not lock
+ * (HDR_MORE_BITS::LockOf()), that mode goes out at 8 bits for the rest of the session, the log
+ * says why, and the output is set again at once. A display that locked is left as it is, and the
+ * log says what it said. Only reads; only that bus.
+ */
+namespace KODI::WINDOWING::GBM::DEEP_LOCK
+{
+
+//! The TMDS clock of 10 bits of a mode (5/4 of its pixel clock), in kHz
+constexpr int64_t TmdsOf10Bits(int clockKHz)
+{
+  return static_cast<int64_t>(clockKHz) * 5 / 4;
+}
+
+//! Deep colour takes the mode above 340 MHz (scrambled), where 8 bits do not, and HDMI 2.0 carries
+//! it (at most 600 MHz)
+constexpr bool DeepGoesScrambled(int clockKHz)
+{
+  return clockKHz > 0 && clockKHz <= 340000 && TmdsOf10Bits(clockKHz) > 340000 &&
+         TmdsOf10Bits(clockKHz) <= 600000;
+}
+
+/*!
+ * \brief Whether the display is looked at after a commit
+ * \param managedHdmi Kodi sets "max bpc" on this HDMI connector (LinkDepthOutput::managed)
+ * \param nvidia the connector is one of nvidia-drm (HdrMoreBits.h looks at its HDR itself)
+ * \param maxBpc "max bpc" with the commit
+ * \param clockKHz the pixel clock of its mode
+ * \param capped the mode goes out at 8 bits already (Capped())
+ */
+constexpr bool Wanted(bool managedHdmi, bool nvidia, uint64_t maxBpc, int clockKHz, bool capped)
+{
+  return managedHdmi && !nvidia && maxBpc >= 10 && DeepGoesScrambled(clockKHz) && !capped;
+}
+
+enum class Step
+{
+  WAIT, //!< nothing yet
+  READ, //!< read the display's SCDC now (on a thread of its own)
+  DROP, //!< nothing to look at any more (the output went off)
+  KEEP, //!< the display locked onto it
+  UNKNOWN, //!< what it locked onto cannot be told
+  STEP_DOWN, //!< the display did not lock onto it: 8 bits for this mode, and set it again
+};
+
+struct Check
+{
+  bool armed = false; //!< a link of deep colour above 340 MHz went out (Wanted())
+  int64_t sinceMs = 0; //!< since the commit that put it out
+  bool outputOn = true;
+  bool readInFlight = false; //!< a read of the SCDC (this or another) has not answered yet
+  std::optional<HDR_MORE_BITS::Lock> lock; //!< what the read found, once it answered
+};
+
+constexpr Step Next(const Check& c)
+{
+  if (!c.armed)
+    return Step::WAIT;
+  if (!c.outputOn)
+    return Step::DROP;
+  if (c.lock)
+  {
+    switch (*c.lock)
+    {
+      case HDR_MORE_BITS::Lock::LOCKED:
+        return Step::KEEP;
+      case HDR_MORE_BITS::Lock::NOT_LOCKED:
+        return Step::STEP_DOWN;
+      case HDR_MORE_BITS::Lock::UNKNOWN:
+        break;
+    }
+    return Step::UNKNOWN;
+  }
+  if (c.readInFlight || c.sinceMs < HDR_MORE_BITS::CHECK_AFTER_MS)
+    return Step::WAIT;
+  return Step::READ;
+}
+
+} // namespace KODI::WINDOWING::GBM::DEEP_LOCK
