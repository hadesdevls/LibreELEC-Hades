+// Hades: a link of deep colour above 340 MHz on an HDMI connector of i915 or xe (QueueLinkDepth()),
+// and whether the display locked onto it: its SCDC, read CHECK_AFTER_MS after the mode set, through
+// the DDC adapter of the connector that the kernel names (ConnectorDdcAdapter()), on a thread of its
+// own. Not locked: 8 bits for this mode for the rest of the session, and the output turned off and
+// on so that the driver sets it so now; the log says it, and what the display said either way.
+// DeepColourLock.h.
+void CWinSystemGbmGLESContext::LookForDeepLock()
+{
+  using namespace DEEP_LOCK;
+  if (!m_deepLockArmed && !m_deepLockRead.valid())
+    return;
+  const auto drm = std::dynamic_pointer_cast<CDRMAtomic>(m_DRM);
+  CDRMConnector* connector = drm ? drm->GetConnector() : nullptr;
+  Check check;
+  check.armed = m_deepLockArmed && OutputModeKey() == m_deepLockKey;
+  check.sinceMs = std::chrono::duration_cast<std::chrono::milliseconds>(
+                      std::chrono::steady_clock::now() - m_deepLockAt)
+                      .count();
+  check.outputOn = connector && drm->IsActive() && drm->GetCrtc() &&
+                   drm->GetCrtc()->ReadPropertyValue("ACTIVE").value_or(0) != 0;
+  check.readInFlight = m_relinkRead.valid() || m_hdrLockRead.valid() || m_deepLockRead.valid();
+  std::string said;
+  if (m_deepLockRead.valid())
+  {
+    if (m_deepLockRead.wait_for(std::chrono::seconds(0)) != std::future_status::ready)
+      return;
+    const HOTPLUG_RELINK::ScdcRead read = m_deepLockRead.get();
+    if (!check.armed)
+      return; // (the output changed while it was read)
+    check.readInFlight = false;
+    check.lock = HDR_MORE_BITS::LockOf(read.flags, read.config, true);
+    said = read.said;
+  }
+  const Step step = Next(check);
+  if (step == Step::WAIT)
+    return;
+  const std::string where = m_deepLockKey;
+  if (step == Step::DROP || !connector)
+  {
+    m_deepLockArmed = false;
+    return;
+  }
+  if (step == Step::READ)
+  {
+    const int fd = drm->GetFileDescriptor();
+    const int adapter = ConnectorDdcAdapter(fd, connector->GetName());
+    const auto outputs = OutputsOfDevice(fd, false);
+    const auto own = outputs.find(*connector->GetConnectorId());
+    std::string why;
+    if (adapter < 0)
+      why = StringUtils::Format("the kernel names no DDC adapter of {} in sysfs",
+                                connector->GetName());
+    else if (own == outputs.end() || own->second.second.empty())
+      why = "the EDID of the connector could not be read";
+    else
+    {
+      try
+      {
+        m_deepLockRead = std::async(std::launch::async, ReadScdcThrough, adapter,
+                                    StringUtils::Format("the DDC of {}", connector->GetName()),
+                                    own->second.second, HOTPLUG_RELINK::Link::TMDS_SCRAMBLED);
+        return;
+      }
+      catch (const std::system_error& error)
+      {
+        why = StringUtils::Format("no thread could be started for it ({})", error.what());
+      }
+    }
+    CLog::Log(LOGINFO,
+              "Output depth: whether the display locked onto deep colour above 340 MHz (\"max "
+              "bpc\" {}) in {} is not known: its SCDC could not be read ({}); it stays so",
+              m_deepLockBpc, where, why);
+    m_deepLockArmed = false;
+    return;
+  }
+  if (step == Step::KEEP || step == Step::UNKNOWN)
+  {
+    CLog::Log(LOGINFO, "Output depth: deep colour above 340 MHz (\"max bpc\" {}) in {} ({}){}",
+              m_deepLockBpc, where, said,
+              step == Step::KEEP ? ": the display locked onto it"
+                                 : ": what the display locked onto cannot be told from it; it "
+                                   "stays so");
+    m_deepLockArmed = false;
+    return;
+  }
+
+  // Step::STEP_DOWN
+  m_deepCapped.insert(where);
+  CLog::Log(LOGWARNING,
+            "Output depth: the display did not lock onto deep colour above 340 MHz (\"max bpc\" "
+            "{}) in {} ({}): for the rest of the session this mode goes out at 8 bits, which the "
+            "port and the display take below 340 MHz, and the output is turned off and on so that "
+            "the driver sets it so now (DeepColourLock.h)",
+            m_deepLockBpc, where, said);
+  m_deepLockArmed = false;
+  // (the request that turns the output on again carries the depth asked for last,
+  // RequeueOutputProperties(): 8 now)
+  m_linkBpc = 8;
+  // (as LookForHdrLock() does: the display's answer to it is taken as an echo of it)
+  m_relinkDone = true;
+  m_relinkAt = std::chrono::steady_clock::now();
+  const auto active = [&drm]
+  { return drm->GetCrtc() && drm->GetCrtc()->ReadPropertyValue("ACTIVE").value_or(0) != 0; };
+  Hide();
+  const bool off = !drm->LastCommitRefused() && !active();
+  Show(true);
+  // (the depth is asked again, and what goes out now looked at again)
+  ResetOutputDepth();
+  if (!off)
+  {
+    CLog::Log(LOGWARNING, "Output depth: turning the output off was refused: 8 bits go out with "
+                          "the next change of mode");
+    return;
+  }
+  if (!active())
+  {
+    CLog::Log(LOGERROR, "Output depth: the output could not be turned on again: it is asked to "
+                        "again, after 1 s and then less often");
+    drm->AllowModeset();
+    OutputLeftOff();
+  }
+}
+
