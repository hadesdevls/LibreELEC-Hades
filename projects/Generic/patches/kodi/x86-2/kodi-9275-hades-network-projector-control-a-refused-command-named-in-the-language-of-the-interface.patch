From 7f735510e6720a445166697a47cb8070b2b0cf23 Mon Sep 17 00:00:00 2001
From: Hades <15710513+hadesdevls@users.noreply.github.com>
Date: Wed, 25 Nov 2026 04:07:14 +0000
Subject: [PATCH] [Hades][Network] Projector control: a refused command named
 in the language of the interface

The notice of a command that the projector refused is the string "{0}
did not take a command ({1})", translated, with the command in {1}. That
was an English text of the code, "picture mode Filmmaker Mode" or "lens
memory 2", so a Spanish interface showed "JVC no acepto una orden
(picture mode ...)". The command is now said in the words of the row of
the player information, which are translated in Estuary ("mode {0}",
"memory {0}": "modo {0}", "memoria {0}"), with their English as the
fallback where a skin has none, as that row does.
---
 xbmc/network/ProjectorControl.cpp | 8 +++++---
 1 file changed, 5 insertions(+), 3 deletions(-)

diff --git a/xbmc/network/ProjectorControl.cpp b/xbmc/network/ProjectorControl.cpp
index 301e54f..a6f4bff 100644
--- a/xbmc/network/ProjectorControl.cpp
+++ b/xbmc/network/ProjectorControl.cpp
@@ -461,8 +461,9 @@ void CProjectorControl::Send(
       }
       clean = false;
       m_problem = Failure::REJECTED;
-      Notify(Fill(Text(62757), BrandName(config.brand),
-                  std::string("picture mode ") + (name ? name : "?")));
+      // (the command in the words of the player information, in the language of the interface)
+      const std::string named = name ? name : "?";
+      Notify(Fill(Text(62757), BrandName(config.brand), Fill(Word(54785, "mode {0}"), named)));
     }
   }
   if (memory > 0)
@@ -483,7 +484,8 @@ void CProjectorControl::Send(
       }
       clean = false;
       m_problem = Failure::REJECTED;
-      Notify(Fill(Text(62757), BrandName(config.brand), "lens memory " + std::to_string(memory)));
+      Notify(Fill(Text(62757), BrandName(config.brand),
+                  Fill(Word(54794, "memory {0}"), std::to_string(memory))));
     }
   }
   session->Close();
-- 
