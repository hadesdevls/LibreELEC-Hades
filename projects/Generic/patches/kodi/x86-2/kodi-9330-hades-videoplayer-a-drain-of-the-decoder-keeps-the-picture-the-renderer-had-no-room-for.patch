+++ b/xbmc/cores/VideoPlayer/VideoPlayerVideo.cpp
@@ -433,12 +433,12 @@ void CVideoPlayerVideo::Process()
       //Okey, start rendering at stream fps now instead, we are likely in a stillframe
       if (!m_stalled)
       {
-        // squeeze pictures out
-        while (!m_bStop && m_pVideoCodec)
+        // squeeze pictures out (Hades: a picture that waits for the renderer is kept, and this
+        // loop offers it again before it squeezes the rest: KODI::VIDEOPLAYER::DECODER_DRAIN)
+        if (DrainDecoder(frametime, pts) == KODI::VIDEOPLAYER::DECODER_DRAIN::Result::WAITING)
         {
-          m_pVideoCodec->SetCodecControl(DVD_CODEC_CTRL_DRAIN);
-          if (!ProcessDecoderOutput(frametime, pts))
-            break;
+          onlyPrioMsgs = true;
+          continue;
         }
 
         CLog::Log(LOGDEBUG, "CVideoPlayerVideo - Stillframe detected, switching to forced {:f} fps",
@@ -555,14 +555,11 @@ void CVideoPlayerVideo::Process()
     {
       auto msg = std::static_pointer_cast<CDVDMsgVideoCodecChange>(pMsg);
 
-      while (!m_bStop && m_pVideoCodec)
-      {
-        m_pVideoCodec->SetCodecControl(DVD_CODEC_CTRL_DRAIN);
-        bool cont = ProcessDecoderOutput(frametime, pts);
-
-        if (!cont)
-          break;
-      }
+      // Hades: the decoder that is replaced is drained; a picture that still waits for the
+      // renderer is let go with what the decoder still holds (KODI::VIDEOPLAYER::DECODER_DRAIN)
+      if (DrainDecoder(frametime, pts) == KODI::VIDEOPLAYER::DECODER_DRAIN::Result::WAITING)
+        CLog::Log(LOGDEBUG, "CVideoPlayerVideo - the stream changes while a picture waits for the "
+                            "renderer: it and the pictures the decoder still holds are let go");
 
       OpenStream(msg->m_hints, std::move(msg->m_codec));
       msg->m_codec = NULL;
@@ -574,12 +571,11 @@ void CVideoPlayerVideo::Process()
     }
     else if (pMsg->IsType(CDVDMsg::VIDEO_DRAIN))
     {
-      while (!m_bStop && m_pVideoCodec)
-      {
-        m_pVideoCodec->SetCodecControl(DVD_CODEC_CTRL_DRAIN);
-        if (!ProcessDecoderOutput(frametime, pts))
-          break;
-      }
+      // Hades: a picture that waits for the renderer is kept: this loop offers it again, answering
+      // messages meanwhile, and drains the rest after it, the decoder keeping its drain control
+      // until the next packet (KODI::VIDEOPLAYER::DECODER_DRAIN)
+      if (DrainDecoder(frametime, pts) == KODI::VIDEOPLAYER::DECODER_DRAIN::Result::WAITING)
+        onlyPrioMsgs = true;
     }
     else if (pMsg->IsType(CDVDMsg::GENERAL_PAUSE))
     {
@@ -730,6 +726,26 @@ void CVideoPlayerVideo::UpdatePlayerInfo()
                                                       m_renderManager.GetSkippedFrames());
 }
 
+// Hades: drains the decoder for its last pictures, keeping one that waits for the renderer
+// (KODI::VIDEOPLAYER::DECODER_DRAIN)
+KODI::VIDEOPLAYER::DECODER_DRAIN::Result CVideoPlayerVideo::DrainDecoder(double& frametime,
+                                                                         double& pts)
+{
+  const auto takeNext = [&]
+  {
+    if (m_bStop || !m_pVideoCodec)
+      return false;
+    m_pVideoCodec->SetCodecControl(DVD_CODEC_CTRL_DRAIN);
+    return ProcessDecoderOutput(frametime, pts);
+  };
+  const auto waiting = [this]
+  { return m_outputSate == OUTPUT_AGAIN && m_picture.videoBuffer != nullptr; };
+  const auto offerAgain = [this] { m_outputSate = OutputPicture(&m_picture); };
+  const auto mayWait = [this]
+  { return !m_bStop && !m_bAbortOutput && !m_paused && m_speed != DVD_PLAYSPEED_PAUSE; };
+  return KODI::VIDEOPLAYER::DECODER_DRAIN::Drain(takeNext, waiting, offerAgain, mayWait);
+}
+
 bool CVideoPlayerVideo::ProcessDecoderOutput(double &frametime, double &pts)
 {
   CDVDVideoCodec::VCReturn decoderState = m_pVideoCodec->GetPicture(&m_picture);
