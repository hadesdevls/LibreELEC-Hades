+
+#pragma once
+
+namespace KODI
+{
+namespace VIDEOPLAYER
+{
+namespace DECODER_DRAIN
+{
+
+/*!
+ * \brief Hades: a drain of the video decoder keeps the picture that the renderer had no room for
+ *
+ * The video thread drains the decoder for its last pictures (CVideoPlayerVideo: at the end of the
+ * stream, before another stream is opened, and when the stream stalls on a still picture): it asks
+ * the decoder for a picture and offers it to the renderer, again and again until the decoder has
+ * none left. When the renderer has no free buffer for a picture within the wait of
+ * OutputPicture(), the picture stays in the thread's hands (OUTPUT_AGAIN). Kodi asked the decoder
+ * for the next picture all the same, and CDVDVideoCodec::GetPicture() releases the picture it is
+ * given to fill: the waiting picture was let go unseen. Every picture after it waited for a buffer
+ * in turn, up to 500 ms each, while the thread read no message: paused near the end of a file, or
+ * with the output stalled, the last pictures were lost and the player did not answer meanwhile.
+ *
+ * Here a waiting picture is offered again, while output can move, up to MAX_OFFERS_AGAIN more
+ * times; the decoder is asked for the next one only once it has gone out. If it still waits (the
+ * player paused, the output called off, or the renderer not taking it), the drain stops with the
+ * picture kept (Result::WAITING): the loop of the thread offers it again as it does any picture
+ * that waits, answering messages meanwhile, and asks the decoder for the rest after it.
+ */
+inline constexpr unsigned MAX_OFFERS_AGAIN = 3;
+
+enum class Result
+{
+  EMPTY, //!< the decoder has no picture left (or the thread stops)
+  WAITING //!< a picture still waits for the renderer: it is kept, the decoder still holds the rest
+};
+
+/*!
+ * \brief Drains a decoder
+ * \param takeNext asks the decoder for its next picture and offers it to the renderer; false when
+ *        the decoder has no picture left or the thread stops
+ * \param waiting whether the picture offered last is still kept, the renderer having had no room
+ * \param offerAgain offers the kept picture to the renderer again
+ * \param mayWait whether output can move while the drain waits (not paused, nothing called off)
+ */
+template<typename TakeNext, typename Waiting, typename OfferAgain, typename MayWait>
+Result Drain(TakeNext takeNext, Waiting waiting, OfferAgain offerAgain, MayWait mayWait)
+{
+  unsigned offeredAgain = 0;
+  while (true)
+  {
+    if (waiting())
+    {
+      if (!mayWait() || offeredAgain >= MAX_OFFERS_AGAIN)
+        return Result::WAITING;
+      ++offeredAgain;
+      offerAgain();
+      continue;
+    }
+    offeredAgain = 0;
+    if (!takeNext())
+      return Result::EMPTY;
+  }
+}
+
+} // namespace DECODER_DRAIN
+} // namespace VIDEOPLAYER
+} // namespace KODI
