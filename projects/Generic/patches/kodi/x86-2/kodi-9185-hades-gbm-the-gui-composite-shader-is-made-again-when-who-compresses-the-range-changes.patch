From 9c8c88842949b5ffc65e2b91dba2cddd6fdcbc1a Mon Sep 17 00:00:00 2001
From: Hades <15710513+hadesdevls@users.noreply.github.com>
Date: Tue, 24 Nov 2026 17:36:54 +0000
Subject: [PATCH] [Hades][GBM] The GUI composite shader is made again when who
 compresses the range changes

The GUI composited over HDR is drawn with KODI_LIMITED_RANGE where Kodi
compresses the range, a define set when the composite shader is made. It
stayed as it was made while the GUI stayed composited: a change of the
colour range in the menus with the GUI in HDR, once the kernel had it,
left the GUI plane in the old range until compositing was set up again.

As Kodi's b4fd1ce does, BeginGuiComposite() now makes the shader again
where it no longer matches: on GLES where Kodi compresses the range and
native Dolby Vision does not hold the output (CompositeLimited(), the
condition SetGuiCompositing() already used), on GL where Kodi compresses
the range. The transfer, the LUTs and what was told of the composite are
made as SetGuiCompositing() makes them, and a skipped GUI walk marks the
windows dirty so that the GUI is drawn again in the new range.
---
 xbmc/windowing/gbm/WinSystemGbmGLContext.cpp  | 16 +++++++++-
 xbmc/windowing/gbm/WinSystemGbmGLContext.h    |  2 ++
 .../windowing/gbm/WinSystemGbmGLESContext.cpp | 29 +++++++++++++++----
 xbmc/windowing/gbm/WinSystemGbmGLESContext.h  |  3 ++
 4 files changed, 44 insertions(+), 6 deletions(-)

diff --git a/xbmc/windowing/gbm/WinSystemGbmGLContext.cpp b/xbmc/windowing/gbm/WinSystemGbmGLContext.cpp
index 506332c..8a26d59 100644
--- a/xbmc/windowing/gbm/WinSystemGbmGLContext.cpp
+++ b/xbmc/windowing/gbm/WinSystemGbmGLContext.cpp
@@ -225,7 +225,8 @@ bool CWinSystemGbmGLContext::SetGuiCompositing(int colorTransfer)
     if (!m_compositeShader)
     {
       std::string defines;
-      if (UseLimitedColor())
+      m_compositeShaderLimited = UseLimitedColor();
+      if (m_compositeShaderLimited)
         defines += "#define KODI_LIMITED_RANGE 1\n";
       m_compositeShader = std::make_unique<CGuiCompositeShaderGL>(defines);
       if (!m_compositeShader->CompileAndLink())
@@ -260,6 +261,19 @@ bool CWinSystemGbmGLContext::BeginGuiComposite(bool guiWillRender)
   if (!m_guiCompositing)
     return false;
 
+  // Hades: the range is a define of the composite shader, set when it is made: made again where who
+  // compresses the range changed since (the colour range, once the kernel has it: CRgbRange), as
+  // Kodi's b4fd1ce does
+  if (m_compositeShader && m_compositeShaderLimited != UseLimitedColor())
+  {
+    m_compositeShader.reset();
+    if (!SetGuiCompositing(m_guiColorTransfer))
+      return false;
+    if (!guiWillRender)
+      if (CGUIComponent* gui = CServiceBroker::GetGUI())
+        gui->GetWindowManager().MarkDirty();
+  }
+
   m_guiWillRender = guiWillRender;
 
   int width = m_nWidth;
diff --git a/xbmc/windowing/gbm/WinSystemGbmGLContext.h b/xbmc/windowing/gbm/WinSystemGbmGLContext.h
index a5ac95b..4172a16 100644
--- a/xbmc/windowing/gbm/WinSystemGbmGLContext.h
+++ b/xbmc/windowing/gbm/WinSystemGbmGLContext.h
@@ -55,6 +55,8 @@ protected:
 
 private:
   bool m_guiCompositing{false};
+  //! Hades: the composite shader was made with KODI_LIMITED_RANGE (UseLimitedColor())
+  bool m_compositeShaderLimited{false};
   int m_guiColorTransfer{0};
   CFrameBufferObject m_guiFbo;
   int m_guiFboWidth{0};
diff --git a/xbmc/windowing/gbm/WinSystemGbmGLESContext.cpp b/xbmc/windowing/gbm/WinSystemGbmGLESContext.cpp
index eb43e3d..311c19d 100644
--- a/xbmc/windowing/gbm/WinSystemGbmGLESContext.cpp
+++ b/xbmc/windowing/gbm/WinSystemGbmGLESContext.cpp
@@ -2334,11 +2334,7 @@ bool CWinSystemGbmGLESContext::SetGuiCompositing(int colorTransfer)
     {
       std::string defines;
       m_compositeLimited = false;
-      if (UseLimitedColor()
-#ifdef HAVE_DVBRIDGE
-          && !m_outputHandover.HoldsOutput()
-#endif
-      )
+      if (CompositeLimited())
       {
         defines += "#define KODI_LIMITED_RANGE 1\n";
         m_compositeLimited = true;
@@ -2394,6 +2390,15 @@ bool CWinSystemGbmGLESContext::SetGuiCompositing(int colorTransfer)
   return m_guiCompositing;
 }
 
+bool CWinSystemGbmGLESContext::CompositeLimited()
+{
+  return UseLimitedColor()
+#ifdef HAVE_DVBRIDGE
+         && !m_outputHandover.HoldsOutput()
+#endif
+      ;
+}
+
 std::string CWinSystemGbmGLESContext::SetSdrWide(const VideoPicture* picture)
 {
   namespace SDRWIDE = KODI::UTILS::SDRWIDE;
@@ -2475,6 +2480,20 @@ bool CWinSystemGbmGLESContext::BeginGuiComposite(bool guiWillRender)
   if (!m_guiCompositing)
     return false;
 
+  // Hades: the range is a define of the composite shader (KODI_LIMITED_RANGE), set when the shader
+  // is made: made again where who compresses the range changed since (the colour range, once the
+  // kernel has it: CRgbRange; native Dolby Vision that holds the output or gives it back), as
+  // Kodi's b4fd1ce does. A skipped GUI walk would leave the GUI plane in the old range.
+  if (m_compositeShader && m_compositeLimited != CompositeLimited())
+  {
+    m_compositeShader.reset();
+    if (!SetGuiCompositing(m_compositeTransfer))
+      return false;
+    if (!guiWillRender)
+      if (CGUIComponent* gui = CServiceBroker::GetGUI())
+        gui->GetWindowManager().MarkDirty();
+  }
+
   // A change of the GUI white setting applies from this frame. LUTs that cannot be created leave
   // the ones in use, and that value is not tried again until the setting changes.
   // (Hades: and so a change of its tone curve, videoscreen.hadesguicurve)
diff --git a/xbmc/windowing/gbm/WinSystemGbmGLESContext.h b/xbmc/windowing/gbm/WinSystemGbmGLESContext.h
index e9e928c..5b8f7d9 100644
--- a/xbmc/windowing/gbm/WinSystemGbmGLESContext.h
+++ b/xbmc/windowing/gbm/WinSystemGbmGLESContext.h
@@ -720,6 +720,9 @@ private:
   //! Hades: what the GUI goes out as in HDR (PQ or HLG, its white, its tone curve), told in the log when
   //! it is not what was told last (TellGuiComposite(), from SetGuiCompositing() and BeginGuiComposite())
   void TellGuiComposite();
+  //! Hades: the composite shader is made with KODI_LIMITED_RANGE: Kodi compresses the range
+  //! (UseLimitedColor()), and native Dolby Vision does not hold the output
+  bool CompositeLimited();
   int m_compositeToldPQ{-1};
   int m_compositeToldWhite{-1};
   float m_compositeToldGamma{-1.0f};
-- 
2.53.0

