From 24c0e90638988d61594201473e7e6efb59bbad5d Mon Sep 17 00:00:00 2001
From: Hades <15710513+hadesdevls@users.noreply.github.com>
Date: Thu, 19 Nov 2026 08:41:37 +0000
Subject: [PATCH] [Hades] VideoPlayer: the picture timing of HEVC read past the
 packets of a TrueHD track

CDVDDemuxFFmpeg::PrefetchForPictureTiming() reads the picture timing of
the first 24 access units of a HEVC stream with
frame_field_info_present_flag before playback, and stopped at 1200
packets held. The packets of every stream count, and a TrueHD track
gives about 1200 a second: a Dolby Vision profile 7 film
(TrueHD and two subtitle tracks) stopped at 19 of its 24
access units, 497 KiB read, and was not known to be progressive, so
"Video at its own rate with VRR" did not take it.

The limits are now PROGRESSIVE_VIDEO::PictureTimingRead, pure: 4800
packets (more than three seconds of such a track), 48 MiB and 1.5 s as
before, which bound the memory held and the delay at the start.
PictureTimingReadStops() says which one stopped the read, and kodi.log
says it where the stream stays not known to be progressive.
---
 .../DVDDemuxers/DVDDemuxFFmpeg.cpp            | 21 ++++++++++-----
 xbmc/utils/ProgressiveVideo.h                 | 26 +++++++++++++++++++
 2 files changed, 40 insertions(+), 7 deletions(-)

diff --git a/xbmc/cores/VideoPlayer/DVDDemuxers/DVDDemuxFFmpeg.cpp b/xbmc/cores/VideoPlayer/DVDDemuxers/DVDDemuxFFmpeg.cpp
index 9b103c6..fe12f73 100644
--- a/xbmc/cores/VideoPlayer/DVDDemuxers/DVDDemuxFFmpeg.cpp
+++ b/xbmc/cores/VideoPlayer/DVDDemuxers/DVDDemuxFFmpeg.cpp
@@ -2485,9 +2485,6 @@ void CDVDDemuxFFmpeg::PrefetchForSoftTelecine()
 void CDVDDemuxFFmpeg::PrefetchForPictureTiming()
 {
   using namespace PROGRESSIVE_VIDEO;
-  static constexpr size_t MAX_PACKETS = 1200;
-  static constexpr size_t MAX_BYTES = 48 * 1024 * 1024;
-  static constexpr auto MAX_TIME = std::chrono::milliseconds(1500);
 
   if (!m_pFormatContext || !m_pInput || !m_pInput->IsStreamType(DVDSTREAM_TYPE_FILE) ||
       m_pInput->IsRealtime() || m_checkTransportStream)
@@ -2572,9 +2569,17 @@ void CDVDDemuxFFmpeg::PrefetchForPictureTiming()
     bytes += static_cast<size_t>(std::max(packet->size, 0));
   }
   const auto begin = std::chrono::steady_clock::now();
+  const auto elapsedMs = [&begin]
+  {
+    return static_cast<int64_t>(std::chrono::duration_cast<std::chrono::milliseconds>(
+                                    std::chrono::steady_clock::now() - begin)
+                                    .count());
+  };
+  // (Hades: the limits of PictureTimingRead, which say why the read stopped where it did)
+  const char* stoppedBy = nullptr;
   m_timeout.Set(2s);
-  while (!allDone() && m_prefetched.size() < MAX_PACKETS && bytes < MAX_BYTES &&
-         std::chrono::steady_clock::now() - begin < MAX_TIME &&
+  while (!allDone() &&
+         !(stoppedBy = PictureTimingReadStops(m_prefetched.size(), bytes, elapsedMs())) &&
          !(m_abortRequested || (m_cancelCheck && m_cancelCheck())))
   {
     AVPacket* packet = av_packet_alloc();
@@ -2618,9 +2623,11 @@ void CDVDDemuxFFmpeg::PrefetchForPictureTiming()
         CLog::Log(LOGINFO,
                   "CDVDDemuxFFmpeg: stream {} is HEVC whose VUI has frame_field_info_present_flag; "
                   "{} of its first {} access units had their picture timing (it takes {}; {} "
-                  "packets, {} KiB read ahead, {} ms): not known to be progressive, as before",
+                  "packets, {} KiB read ahead, {} ms; stopped by {}): not known to be progressive, "
+                  "as before",
                   index, proof.Timed(), proof.Units(), CPictureTimingProof::MIN_TIMED,
-                  m_prefetched.size(), bytes / 1024, ms);
+                  m_prefetched.size(), bytes / 1024, ms,
+                  stoppedBy ? stoppedBy : "the end of the stream or a cancel");
         break;
     }
   }
diff --git a/xbmc/utils/ProgressiveVideo.h b/xbmc/utils/ProgressiveVideo.h
index 8e1f35f..a9cbdc3 100644
--- a/xbmc/utils/ProgressiveVideo.h
+++ b/xbmc/utils/ProgressiveVideo.h
@@ -235,4 +235,30 @@ constexpr const char* PictureTimingNotNeeded(const PictureTimingNeed& n)
   return "at its frame rate Kodi chooses the same mode for a progressive video, and \"Video at "
          "its own rate with VRR\" is off";
 }
+
+/*!
+ * \brief Hades: how far the picture timing is read ahead (CDVDDemuxFFmpeg::PrefetchForPictureTiming()):
+ *        the packets held for the player (those the reads before it took count), their bytes, and
+ *        the time spent reading. The packets of every stream count: a TrueHD track gives about 1200
+ *        a second, and with a limit of 1200 the Dolby Vision profile 7 film of the test of 2026-11-19
+ *        (TrueHD, two subtitle tracks) stopped at 19 of the 24 access units of its video, 497 KiB
+ *        read, and was not known to be progressive. 4800 packets hold more than three seconds of such
+ *        a track; the bytes keep the memory held and the time the delay at the start, as before.
+ */
+struct PictureTimingRead
+{
+  static constexpr size_t MAX_PACKETS = 4800;
+  static constexpr size_t MAX_BYTES = 48 * 1024 * 1024;
+  static constexpr int64_t MAX_MS = 1500;
+};
+
+//! Hades: whether the read ahead of the picture timing goes on (PictureTimingRead), and if not, why
+//! (nullptr: it goes on)
+constexpr const char* PictureTimingReadStops(size_t packets, size_t bytes, int64_t ms)
+{
+  return packets >= PictureTimingRead::MAX_PACKETS ? "the packets held"
+         : bytes >= PictureTimingRead::MAX_BYTES   ? "the bytes held"
+         : ms >= PictureTimingRead::MAX_MS         ? "the time to read"
+                                                   : nullptr;
+}
 } // namespace PROGRESSIVE_VIDEO
-- 
