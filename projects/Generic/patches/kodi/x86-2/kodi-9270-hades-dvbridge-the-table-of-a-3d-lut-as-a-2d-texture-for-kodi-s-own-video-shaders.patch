From f7c55bde03071212662e29b27b5b9dbef9a3ef25 Mon Sep 17 00:00:00 2001
From: Hades <15710513+hadesdevls@users.noreply.github.com>
Date: Wed, 25 Nov 2026 03:12:56 +0000
Subject: [PATCH] [Hades][dvbridge] The table of a 3D LUT as a 2D texture for
 Kodi's own video shaders

The 3D LUT of the display (dvbridge_lut.h) is applied by the bridge to what
it maps, through libplacebo's pl_shader_custom_lut() and a 3D texture. The
SDR videos that Kodi draws itself (decoded by the processor, or by VAAPI
without the bridge) go through Kodi's own video shaders, which are of GLSL
ES 1.00 as well, where there is no 3D texture.

dvbridge_lut_atlas_make() lays the table that dvbridge_lut_parse() read
(the same reader, its checks and its values: nothing is read twice) out as
a 2D texture of 32-bit floats: the N slices of blue side by side, cols of
them a row (the smallest power of two whose square holds them, so that a
shader finds the place of a slice exactly: 2 to 16 for 2 to 256 points),
each N x N with red along x and green along y. It gives the values with
which such a shader takes its input to the LUT's range and grid and its
output back, those of dvbridge_lut_shader(): the input range (full, or
video levels), the shaper of two slopes of a .3dl of Nuke's shaper, and
the output range. A table larger than the GPU's largest texture is refused
with the reason.
---
 tools/dvbridge/CMakeLists.txt       |   2 +-
 tools/dvbridge/dvbridge_lut_atlas.c | 110 ++++++++++++++++++++++++++++
 tools/dvbridge/dvbridge_lut_atlas.h |  53 ++++++++++++++
 3 files changed, 164 insertions(+), 1 deletion(-)
 create mode 100644 tools/dvbridge/dvbridge_lut_atlas.c
 create mode 100644 tools/dvbridge/dvbridge_lut_atlas.h

diff --git a/tools/dvbridge/CMakeLists.txt b/tools/dvbridge/CMakeLists.txt
index 62d22bd..86cf7b4 100644
--- a/tools/dvbridge/CMakeLists.txt
+++ b/tools/dvbridge/CMakeLists.txt
@@ -20,7 +20,7 @@ add_library(dvbridge_core STATIC dvbridge_core.c dvbridge_placebo.c dvbridge_ren
                                 dvbridge_measure.c dvbridge_measured.c
                                 dvbridge_dvplus.c dvbridge_dvplus_gl.c dvbridge_graphics.c
                                 dvbridge_upscale.c dvbridge_scene_map.c dvbridge_l5area.c
-                                dvbridge_lut.c)
+                                dvbridge_lut.c dvbridge_lut_atlas.c)
 set_target_properties(dvbridge_core PROPERTIES POSITION_INDEPENDENT_CODE ON C_STANDARD 11)
 target_include_directories(dvbridge_core PUBLIC "${CMAKE_CURRENT_SOURCE_DIR}")
 target_link_libraries(dvbridge_core PUBLIC PkgConfig::DVPlacebo PkgConfig::DVAvutil
diff --git a/tools/dvbridge/dvbridge_lut_atlas.c b/tools/dvbridge/dvbridge_lut_atlas.c
new file mode 100644
index 0000000..ce4d4be
--- /dev/null
+++ b/tools/dvbridge/dvbridge_lut_atlas.c
@@ -0,0 +1,110 @@
+/*
+ *  Copyright (C) 2026 Hades
+ *  This file is part of LibreELEC Hades. It is not in Kodi as Team Kodi publishes it.
+ *
+ *  SPDX-License-Identifier: GPL-2.0-or-later
+ *  See LICENSES/README.md for more information.
+ */
+#include "dvbridge_lut_atlas.h"
+
+#include "dvbridge_lut.h"
+
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+
+/* (as dvbridge_lut.c takes a range: full is 0 to 255) */
+static bool full(struct dvbridge_lut_range r)
+{
+    return r.lo == 0.0f && r.hi == 255.0f;
+}
+
+bool dvbridge_lut_atlas_make(const struct dvbridge_lut *lut, int max_texture_size, struct dvbridge_lut_atlas *atlas,
+                             char *why, size_t why_size)
+{
+    if (why && why_size)
+        why[0] = '\0';
+    if (!atlas)
+        return false;
+    memset(atlas, 0, sizeof(*atlas));
+    if (!lut || !lut->data || lut->size < 2 || lut->size > DVBRIDGE_LUT_MAX_SIZE) {
+        if (why)
+            snprintf(why, why_size, "no LUT");
+        return false;
+    }
+    const int n = lut->size;
+    /* the slices a row: the smallest power of two whose square holds the N slices (2 to 16 for 2 to 256 points) */
+    int cols = 1;
+    while (cols * cols < n)
+        cols *= 2;
+    const int rows = (n + cols - 1) / cols;
+    const int width = cols * n, height = rows * n;
+    if (width > max_texture_size || height > max_texture_size) {
+        if (why)
+            snprintf(why, why_size, "its table of %d points a side needs a texture of %dx%d, and this GPU takes at most "
+                                    "%d a side", n, width, height, max_texture_size);
+        return false;
+    }
+    float *rgb = calloc((size_t)width * (size_t)height * 3, sizeof(float));
+    if (!rgb) {
+        if (why)
+            snprintf(why, why_size, "no memory for its table of %d points a side (%zu MB)", n,
+                     ((size_t)width * (size_t)height * 3 * sizeof(float)) >> 20);
+        return false;
+    }
+    /* slice b at column b % cols and row b / cols of slices; in it, red along x and green along y (the file's values,
+     * red fastest: dvbridge_lut.h) */
+    for (int b = 0; b < n; ++b) {
+        const int x0 = (b % cols) * n, y0 = (b / cols) * n;
+        for (int g = 0; g < n; ++g) {
+            const float *from = lut->data + (((size_t)b * (size_t)n + (size_t)g) * (size_t)n) * 3;
+            float *to = rgb + (((size_t)(y0 + g) * (size_t)width) + (size_t)x0) * 3;
+            memcpy(to, from, (size_t)n * 3 * sizeof(float));
+        }
+    }
+    atlas->size = n;
+    atlas->cols = cols;
+    atlas->rows = rows;
+    atlas->width = width;
+    atlas->height = height;
+    atlas->rgb = rgb;
+    atlas->grid[0] = (float)(n - 1);
+    atlas->grid[1] = (float)cols;
+    atlas->grid[2] = (float)(1.0 / width);
+    atlas->grid[3] = (float)(1.0 / height);
+    /* the input: (lo + (hi - lo) c) / 255, as dvbridge_lut_shader(); nothing where it is full */
+    if (full(lut->in)) {
+        atlas->in[0] = 1.0f;
+        atlas->in[1] = 0.0f;
+    } else {
+        atlas->in[0] = (float)(((double)lut->in.hi - (double)lut->in.lo) / 255.0);
+        atlas->in[1] = (float)((double)lut->in.lo / 255.0);
+    }
+    /* a .3dl of Nuke's shaper: codes 0 to knee in N - 2 steps, knee to the maximum in one (the grid coordinate; the
+     * reader takes it only with 3 points or more and a knee within (0, 1), which the shader's flag needs: knee > 0) */
+    if (lut->shaper_two) {
+        const double knee = lut->shaper_knee, steps = n - 2;
+        atlas->shaper[0] = lut->shaper_knee;
+        atlas->shaper[1] = (float)(steps / knee);
+        atlas->shaper[2] = (float)steps;
+        atlas->shaper[3] = (float)(1.0 / (1.0 - knee));
+    }
+    /* the output: (v 255 - lo) / (hi - lo), held within [0, 1] by the shader */
+    if (full(lut->out)) {
+        atlas->out[0] = 1.0f;
+        atlas->out[1] = 0.0f;
+    } else {
+        const double span = (double)lut->out.hi - (double)lut->out.lo;
+        atlas->out[0] = (float)(255.0 / span);
+        atlas->out[1] = (float)(-(double)lut->out.lo / span);
+    }
+    return true;
+}
+
+void dvbridge_lut_atlas_free(struct dvbridge_lut_atlas *atlas)
+{
+    if (!atlas)
+        return;
+    free(atlas->rgb);
+    memset(atlas, 0, sizeof(*atlas));
+}
diff --git a/tools/dvbridge/dvbridge_lut_atlas.h b/tools/dvbridge/dvbridge_lut_atlas.h
new file mode 100644
index 0000000..3bc24be
--- /dev/null
+++ b/tools/dvbridge/dvbridge_lut_atlas.h
@@ -0,0 +1,53 @@
+/*
+ *  Copyright (C) 2026 Hades
+ *  This file is part of LibreELEC Hades. It is not in Kodi as Team Kodi publishes it.
+ *
+ *  SPDX-License-Identifier: GPL-2.0-or-later
+ *  See LICENSES/README.md for more information.
+ */
+#ifndef DVBRIDGE_LUT_ATLAS_H
+#define DVBRIDGE_LUT_ATLAS_H
+
+/*
+ * Hades: the table of a 3D LUT of the display (dvbridge_lut.h, read and checked there) for the video shaders of Kodi's
+ * own renderer (system/shaders/GLES/2.0/gles_lut3d.frag), which take it for the pictures that Kodi draws itself, as
+ * the bridge takes it for those it maps (dvbridge_lut_shader()). Those shaders are of GLSL ES 1.00 too, which has no
+ * 3D texture: the table is a 2D texture of 32-bit floats (RGB) that holds the N slices of blue side by side, cols of
+ * them a row (a power of two, so that the shader finds the place of a slice exactly), each N x N with red along x and
+ * green along y. The shader reads the four corners of a tetrahedron at the centres of their texels and interpolates
+ * them as libplacebo's pl_shader_custom_lut() does: at the grid points the LUT gives the values of the file, to the
+ * bit, and between them the same interpolation as the bridge.
+ *
+ * The values that the shader takes its input to the LUT's range and grid with, and its output back, are those of
+ * dvbridge_lut_shader(): the input range of the LUT (full, or video levels), the shaper of two slopes of a .3dl of
+ * Nuke's shaper, and the output range.
+ */
+
+#include <stdbool.h>
+#include <stddef.h>
+
+struct dvbridge_lut;
+
+struct dvbridge_lut_atlas {
+    int size;          /* N: points a side */
+    int cols, rows;    /* slices of blue a row of the texture, and rows of slices */
+    int width, height; /* texels: cols * N, rows * N */
+    float *rgb;        /* width * height texels of 3 floats, the first row of glTexImage2D first */
+    /* the uniforms of gles_lut3d.frag */
+    float grid[4];     /* N - 1, cols, 1 / width, 1 / height */
+    float in[2];       /* scale, offset: the signal in full range to the input range of the LUT (1, 0: full) */
+    float shaper[4];   /* a .3dl of Nuke's shaper: knee, (N - 2) / knee, N - 2, 1 / (1 - knee); all 0: a uniform
+                          grid */
+    float out[2];      /* scale, offset: the output range of the LUT back to full (1, 0: full) */
+};
+
+/*
+ * The table of lut as a texture of at most max_texture_size texels a side (GL_MAX_TEXTURE_SIZE), and the values of
+ * the shader. False where it does not fit (why says why, at most why_size bytes) or where there is no memory for it;
+ * nothing is then kept. dvbridge_lut_atlas_free() lets it go.
+ */
+bool dvbridge_lut_atlas_make(const struct dvbridge_lut *lut, int max_texture_size, struct dvbridge_lut_atlas *atlas,
+                             char *why, size_t why_size);
+void dvbridge_lut_atlas_free(struct dvbridge_lut_atlas *atlas);
+
+#endif
-- 
