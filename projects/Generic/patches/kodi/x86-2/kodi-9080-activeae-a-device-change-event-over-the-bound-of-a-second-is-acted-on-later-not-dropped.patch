diff --git a/xbmc/cores/AudioEngine/Engines/ActiveAE/ActiveAEDeviceChangePace.h b/xbmc/cores/AudioEngine/Engines/ActiveAE/ActiveAEDeviceChangePace.h
new file mode 100644
index 0000000..b23a1d6
--- /dev/null
+++ b/xbmc/cores/AudioEngine/Engines/ActiveAE/ActiveAEDeviceChangePace.h
@@ -0,0 +1,103 @@
+/*
+ *  Copyright (C) 2026 Hades
+ *  This file is part of LibreELEC Hades. It is not in Kodi as Team Kodi publishes it.
+ *
+ *  SPDX-License-Identifier: GPL-2.0-or-later
+ *  See LICENSES/README.md for more information.
+ */
+
+#pragma once
+
+#include <algorithm>
+#include <chrono>
+#include <cstddef>
+#include <deque>
+#include <optional>
+
+/*!
+ * Hades: the device change events that ActiveAE acts on now, and those it keeps to act on once,
+ * a little later, so that none is lost.
+ *
+ * A device change event (DEVICECHANGE: the ELD controls of ALSA and its cards, PipeWire, X11's
+ * RandR) closes the output, lists the outputs again and opens it again. Kodi acted on three within
+ * a second of the wall clock and dropped any more, never acting on them later ("received N device
+ * change events within one second"): the outputs stayed as the last listing found them until
+ * another event came. A mode set of the display brings two (the ELD of the TV goes, and comes back),
+ * two mode sets within a second bring four, and the one dropped can be the one with which the TV's
+ * audio data came back: an HDMI output listed without the TV's name ("HDMI #0") and with the
+ * channels and formats of no display. And the second of the wall clock stayed full for as long as a
+ * step of the clock back lasted (the clock set at boot), dropping every event meanwhile.
+ *
+ * CDeviceChangePace keeps Kodi's bound (MOST listings within any WINDOW, of the steady clock) and
+ * keeps an event over it: the outputs are listed again once, for every event kept, when the bound
+ * allows (Due(): the oldest listing of the window is WINDOW old). ActiveAE sets a wake-up for that
+ * time with the first event kept (KEEP_FIRST), which comes back as a device change event of its
+ * own. An event acted on before then covers what was kept: the wake-up then does nothing (NOTHING),
+ * so that no listing is made twice for the same events.
+ *
+ * Nothing of ActiveAE is here: a test runs it on the host (TestActiveAEDeviceChangePace.cpp).
+ */
+namespace ActiveAE::INTERNAL
+{
+
+class CDeviceChangePace
+{
+public:
+  using Clock = std::chrono::steady_clock;
+  //! the listings made within WINDOW at most (Kodi's bound)
+  static constexpr size_t MOST = 3;
+  static constexpr Clock::duration WINDOW = std::chrono::seconds(1);
+
+  enum class Action
+  {
+    ACT, //!< list the outputs again now (this covers what was kept before)
+    KEEP_FIRST, //!< kept: the outputs are listed again at Due(), for which a wake-up is set now
+    KEEP, //!< kept: the wake-up that is set covers it
+    NOTHING, //!< a wake-up whose events a listing made meanwhile has covered
+  };
+
+  /*!
+   * \brief A device change event at now
+   * \param wakeUp the event is the wake-up that a KEEP_FIRST set
+   */
+  Action Event(Clock::time_point now, bool wakeUp = false)
+  {
+    while (!m_acted.empty() && now - m_acted.front() >= WINDOW)
+      m_acted.pop_front();
+    if (wakeUp && !m_due)
+      return Action::NOTHING;
+    if (m_acted.size() >= MOST)
+    {
+      // (a time kept from before is in the window still: no listing came since, so its wake-up is
+      // set; once that time passes, the oldest listing has left the window and an event is acted
+      // on, also where its wake-up went to a state that listed the outputs its own way)
+      const bool first = !m_due;
+      m_due = m_acted.front() + WINDOW;
+      return first ? Action::KEEP_FIRST : Action::KEEP;
+    }
+    m_acted.push_back(now);
+    m_due.reset();
+    return Action::ACT;
+  }
+
+  //! When the outputs are listed again for the events kept, while some are
+  std::optional<Clock::time_point> Due() const { return m_due; }
+
+  //! The outputs are listed now outside the bound (no wake-up could be set): nothing is kept
+  void Covered() { m_due.reset(); }
+
+  //! How long a wake-up for due waits from now: whole milliseconds, never less than one
+  static std::chrono::milliseconds Wait(Clock::time_point due, Clock::time_point now)
+  {
+    if (due <= now)
+      return std::chrono::milliseconds(1);
+    return std::max(std::chrono::milliseconds(1),
+                    std::chrono::ceil<std::chrono::milliseconds>(due - now));
+  }
+
+private:
+  std::deque<Clock::time_point> m_acted; //!< the listings made, within WINDOW
+  std::optional<Clock::time_point> m_due;
+};
+
+} // namespace ActiveAE::INTERNAL
