diff --git a/xbmc/cores/AudioEngine/Sinks/test/TestActiveAEDeviceChangePace.cpp b/xbmc/cores/AudioEngine/Sinks/test/TestActiveAEDeviceChangePace.cpp
new file mode 100644
index 0000000..2dc9423
--- /dev/null
+++ b/xbmc/cores/AudioEngine/Sinks/test/TestActiveAEDeviceChangePace.cpp
@@ -0,0 +1,212 @@
+/*
+ *  Copyright (C) 2026 Hades
+ *  This file is part of LibreELEC Hades. It is not in Kodi as Team Kodi publishes it.
+ *
+ *  SPDX-License-Identifier: GPL-2.0-or-later
+ *  See LICENSES/README.md for more information.
+ */
+
+#include "cores/AudioEngine/Engines/ActiveAE/ActiveAEDeviceChangePace.h"
+
+#include <algorithm>
+#include <chrono>
+#include <optional>
+#include <utility>
+#include <vector>
+
+#include <gtest/gtest.h>
+
+using namespace ActiveAE::INTERNAL;
+using namespace std::chrono_literals;
+using Action = CDeviceChangePace::Action;
+using Clock = CDeviceChangePace::Clock;
+
+namespace
+{
+const Clock::time_point T0 = Clock::time_point() + 1000s;
+
+/*!
+ * The engine as AE_TOP_CONFIGURED drives the pace: every event, and the wake-up that a kept one
+ * sets, which comes back as an event of its own at its time (m_extDeviceChangeTimer)
+ */
+struct Engine
+{
+  CDeviceChangePace pace;
+  std::optional<Clock::time_point> wakeUp;
+  std::vector<Clock::time_point> listings; //!< when the outputs were listed again
+
+  void Event(Clock::time_point now, bool isWakeUp = false)
+  {
+    switch (pace.Event(now, isWakeUp))
+    {
+      case Action::ACT:
+        listings.push_back(now);
+        break;
+      case Action::KEEP_FIRST:
+        ASSERT_TRUE(pace.Due());
+        // (the timer of CTimer calls back once its wait has passed)
+        wakeUp = now + CDeviceChangePace::Wait(*pace.Due(), now);
+        break;
+      case Action::KEEP:
+      case Action::NOTHING:
+        break;
+    }
+  }
+
+  //! the events of a run, in order, with the wake-ups that come between them
+  void Run(const std::vector<Clock::time_point>& events, Clock::time_point end)
+  {
+    for (const auto at : events)
+    {
+      DueWakeUps(at);
+      Event(at);
+    }
+    DueWakeUps(end);
+  }
+
+  void DueWakeUps(Clock::time_point until)
+  {
+    while (wakeUp && *wakeUp <= until)
+    {
+      const auto at = *std::exchange(wakeUp, std::nullopt);
+      Event(at, true);
+    }
+  }
+};
+} // namespace
+
+TEST(TestActiveAEDeviceChangePace, ActsOnThreeEventsWithinASecond)
+{
+  CDeviceChangePace pace;
+  EXPECT_EQ(pace.Event(T0), Action::ACT);
+  EXPECT_EQ(pace.Event(T0 + 100ms), Action::ACT);
+  EXPECT_EQ(pace.Event(T0 + 200ms), Action::ACT);
+  EXPECT_FALSE(pace.Due());
+}
+
+// Kodi dropped the fourth for good
+TEST(TestActiveAEDeviceChangePace, KeepsTheFourthAndListsOnceWhenTheBoundAllows)
+{
+  CDeviceChangePace pace;
+  pace.Event(T0);
+  pace.Event(T0 + 100ms);
+  pace.Event(T0 + 200ms);
+  EXPECT_EQ(pace.Event(T0 + 300ms), Action::KEEP_FIRST);
+  ASSERT_TRUE(pace.Due());
+  EXPECT_EQ(*pace.Due(), T0 + 1s);
+  EXPECT_EQ(pace.Event(T0 + 400ms), Action::KEEP);
+  EXPECT_EQ(pace.Event(T0 + 900ms), Action::KEEP);
+  // the wake-up: one listing for the three kept
+  EXPECT_EQ(pace.Event(T0 + 1s, true), Action::ACT);
+  EXPECT_FALSE(pace.Due());
+  // and a wake-up that comes again finds nothing kept
+  EXPECT_EQ(pace.Event(T0 + 1s + 1ms, true), Action::NOTHING);
+}
+
+TEST(TestActiveAEDeviceChangePace, AnEventActedOnBeforeTheWakeUpCoversTheKeptOnes)
+{
+  CDeviceChangePace pace;
+  pace.Event(T0);
+  pace.Event(T0 + 600ms);
+  pace.Event(T0 + 700ms);
+  EXPECT_EQ(pace.Event(T0 + 800ms), Action::KEEP_FIRST);
+  EXPECT_EQ(*pace.Due(), T0 + 1s);
+  // an event after the oldest left the window, before the wake-up came
+  EXPECT_EQ(pace.Event(T0 + 1s + 1ms), Action::ACT);
+  EXPECT_FALSE(pace.Due());
+  EXPECT_EQ(pace.Event(T0 + 1s + 5ms, true), Action::NOTHING);
+}
+
+TEST(TestActiveAEDeviceChangePace, EventsASecondApartAreAllActedOn)
+{
+  CDeviceChangePace pace;
+  for (int i = 0; i < 20; ++i)
+    EXPECT_EQ(pace.Event(T0 + i * 1s), Action::ACT);
+}
+
+// A storm of events (every 10 ms for 5 s): never more than three listings within a second, and the
+// last event is always listed, at most a second after it
+TEST(TestActiveAEDeviceChangePace, AStormIsBoundedAndItsLastEventIsListed)
+{
+  Engine engine;
+  std::vector<Clock::time_point> events;
+  for (int i = 0; i < 500; ++i)
+    events.push_back(T0 + i * 10ms);
+  engine.Run(events, T0 + 60s);
+  ASSERT_FALSE(engine.listings.empty());
+  for (size_t i = 0; i + CDeviceChangePace::MOST < engine.listings.size(); ++i)
+    EXPECT_GE(engine.listings[i + CDeviceChangePace::MOST] - engine.listings[i],
+              CDeviceChangePace::WINDOW)
+        << "listing " << i;
+  EXPECT_GE(engine.listings.back(), events.back());
+  EXPECT_LE(engine.listings.back() - events.back(), CDeviceChangePace::WINDOW);
+  // (the bound: three in the first second, then the wake-ups)
+  EXPECT_LE(engine.listings.size(), 5u * CDeviceChangePace::MOST + 1);
+}
+
+// Whatever the run, every event is followed by a listing: none is lost
+TEST(TestActiveAEDeviceChangePace, NoEventIsLeftWithoutAListingAfterIt)
+{
+  const std::vector<std::vector<int>> runs = {
+      {0, 1, 2, 3},
+      {0, 100, 200, 300, 400, 1500},
+      {0, 999, 1000, 1001, 1002, 1003, 2500, 2501, 2502, 2503},
+      {0, 5, 10, 15, 20, 25, 30, 990, 995, 1999, 2000, 2001, 2002},
+      {0, 300, 600, 900, 1200, 1500, 1800, 2100, 2400, 2700},
+  };
+  for (const auto& run : runs)
+  {
+    Engine engine;
+    std::vector<Clock::time_point> events;
+    for (const int ms : run)
+      events.push_back(T0 + ms * 1ms);
+    engine.Run(events, T0 + 60s);
+    ASSERT_FALSE(engine.listings.empty());
+    for (const auto at : events)
+      EXPECT_TRUE(std::any_of(engine.listings.begin(), engine.listings.end(),
+                              [at](Clock::time_point listing) { return listing >= at; }));
+    for (size_t i = 0; i + CDeviceChangePace::MOST < engine.listings.size(); ++i)
+      EXPECT_GE(engine.listings[i + CDeviceChangePace::MOST] - engine.listings[i],
+                CDeviceChangePace::WINDOW);
+  }
+}
+
+// A wake-up that went to a state that lists the outputs its own way (the display being reset, an
+// error) left its time behind: the next event over the bound sets a wake-up of its own
+TEST(TestActiveAEDeviceChangePace, AWakeUpThatWentElsewhereDoesNotStopTheNext)
+{
+  CDeviceChangePace pace;
+  pace.Event(T0);
+  pace.Event(T0 + 10ms);
+  pace.Event(T0 + 20ms);
+  EXPECT_EQ(pace.Event(T0 + 30ms), Action::KEEP_FIRST);
+  // (its wake-up came while suspended: not seen here)
+  pace.Event(T0 + 5s);
+  pace.Event(T0 + 5s + 10ms);
+  // the first of this burst was acted on: nothing is kept
+  EXPECT_FALSE(pace.Due());
+  pace.Event(T0 + 5s + 20ms);
+  EXPECT_EQ(pace.Event(T0 + 5s + 30ms), Action::KEEP_FIRST);
+}
+
+TEST(TestActiveAEDeviceChangePace, KeptEventsListedAnotherWayLeaveNothingDue)
+{
+  CDeviceChangePace pace;
+  pace.Event(T0);
+  pace.Event(T0 + 10ms);
+  pace.Event(T0 + 20ms);
+  EXPECT_EQ(pace.Event(T0 + 30ms), Action::KEEP_FIRST);
+  pace.Covered();
+  EXPECT_FALSE(pace.Due());
+  EXPECT_EQ(pace.Event(T0 + 40ms, true), Action::NOTHING);
+  // (the bound still holds: the next one is kept, and sets a wake-up of its own)
+  EXPECT_EQ(pace.Event(T0 + 50ms), Action::KEEP_FIRST);
+}
+
+TEST(TestActiveAEDeviceChangePace, TheWaitIsInWholeMillisecondsAndNeverNone)
+{
+  EXPECT_EQ(CDeviceChangePace::Wait(T0 + 1500us, T0), 2ms);
+  EXPECT_EQ(CDeviceChangePace::Wait(T0 + 1s, T0), 1000ms);
+  EXPECT_EQ(CDeviceChangePace::Wait(T0, T0), 1ms);
+  EXPECT_EQ(CDeviceChangePace::Wait(T0, T0 + 1s), 1ms);
+}
