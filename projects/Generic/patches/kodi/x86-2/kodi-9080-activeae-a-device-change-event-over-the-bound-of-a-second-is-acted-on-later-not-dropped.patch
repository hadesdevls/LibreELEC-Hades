@@ -4933,6 +4944,34 @@ void CActiveAE::DeviceChange()
   m_controlPort.SendOutMessage(CActiveAEControlProtocol::DEVICECHANGE);
 }
 
+void CActiveAE::DeviceChangeWakeUp()
+{
+  // (on the thread of the timer: a message, as DeviceChange() sends)
+  m_controlPort.SendOutMessage(CActiveAEControlProtocol::DEVICECHANGE, &DEVICE_CHANGE_WAKE_UP,
+                               sizeof(DEVICE_CHANGE_WAKE_UP));
+}
+
+bool CActiveAE::KeepDeviceChangeForLater(std::chrono::steady_clock::time_point now)
+{
+  const auto wait =
+      INTERNAL::CDeviceChangePace::Wait(m_extDeviceChangePace.Due().value_or(now), now);
+  // (one wake-up at a time: one set before, for events that a listing covered since, goes)
+  m_extDeviceChangeTimer.Stop(true);
+  if (!m_extDeviceChangeTimer.Start(wait))
+  {
+    CLog::Log(LOGERROR, "CActiveAE - a device change event over the bound of a second: no "
+                        "wake-up could be set for it, so it is acted on now");
+    m_extDeviceChangePace.Covered();
+    return false;
+  }
+  CLog::Log(LOGINFO,
+            "CActiveAE - a device change event after {} listings of the outputs within a "
+            "second: kept, and the outputs are listed again in {} ms, once for every event "
+            "until then",
+            INTERNAL::CDeviceChangePace::MOST, wait.count());
+  return true;
+}
+
 void CActiveAE::DefaultDeviceChange()
 {
   m_controlPort.SendOutMessage(CActiveAEControlProtocol::DEFAULTDEVICECHANGE);
