@@ -836,24 +842,29 @@ void CActiveAE::StateMachine(int signal, Protocol *port, Message *msg)
           return;
         case CActiveAEControlProtocol::DEVICECHANGE:
         {
-          time_t now;
-          time(&now);
-          // Hades: told without debug logging, with how long the output was closed (a cut in the
-          // sound of whatever plays)
+          // Hades: Kodi's bound of three listings of the outputs within a second, with an event
