+          // (CDeviceChangePace); the wake-up for that comes back here, marked
           const auto changeStart = std::chrono::steady_clock::now();
-          CLog::Log(LOGINFO, "CActiveAE - device change event: the output is closed, the outputs "
-                             "are listed again and it is opened again");
-          while (!m_extLastDeviceChange.empty() && (now - m_extLastDeviceChange.front() > 0))
+          const bool wakeUp = msg->data && msg->data[0] == DEVICE_CHANGE_WAKE_UP;
+          switch (m_extDeviceChangePace.Event(changeStart, wakeUp))
           {
-            m_extLastDeviceChange.pop();
-          }
-          if (m_extLastDeviceChange.size() > 2)
-          {
-            CLog::Log(LOGWARNING, "CActiveAE - received {} device change events within one second",
-                      m_extLastDeviceChange.size());
-            return;
+            case INTERNAL::CDeviceChangePace::Action::NOTHING:
+            case INTERNAL::CDeviceChangePace::Action::KEEP:
+              return;
+            case INTERNAL::CDeviceChangePace::Action::KEEP_FIRST:
+              if (KeepDeviceChangeForLater(changeStart))
+                return;
+              break;
+            case INTERNAL::CDeviceChangePace::Action::ACT:
