From 0beb97bcc01d5d3670c630efb2b83529493252b7 Mon Sep 17 00:00:00 2001
From: Hades <15710513+hadesdevls@users.noreply.github.com>
Date: Thu, 19 Nov 2026 05:23:35 +0000
Subject: [PATCH] [Hades][GBM] kodi.log says when the driver refuses the
 BT.2020 colour tag

A request that changes the colour tag of the output to BT.2020 (the connector's Colorspace to
BT2020_RGB: an HDR video, or an SDR video in BT.2020 colours with its setting on) and that the driver
refuses fell back to the request before it with the line "test commit failed ... falling back to last
successful atomic request", which names no cause. None of the drivers of this build refuses that value
where the connector offers it (the kernel keeps it as it is, nvidia-drm takes it, amdgpu asks for
Default only in the transport of native Dolby Vision, where this tag is never asked for), but a driver
that did would leave the picture in the tag it had, and kodi.log would not say why.

Now, once until a colour tag goes out, the same request is tested again, on a copy, with the tag that
the output has now (CDRMAtomic::TellBt2020Refused()), and kodi.log says whether that is taken (the
BT.2020 tag is the cause) or refused too (the cause is something else in it), and that the request
before it goes out in its place with the tag the output keeps. Nothing else changes: the test changes
nothing on the display, the refused request is not touched, and the fallback is the one there was.

The idea of looking at a refused BT.2020 tag is CroqueMr's (his build); the test and the line are this
build's own.

Checked: the changed file and the sources that include its header compile with the commands of the
image's build. Not seen in a log: no driver at hand refuses the tag.
---
 xbmc/windowing/gbm/drm/DRMAtomic.cpp | 44 ++++++++++++++++++++++++++++
 xbmc/windowing/gbm/drm/DRMAtomic.h   |  5 ++++
 2 files changed, 49 insertions(+)

diff --git a/xbmc/windowing/gbm/drm/DRMAtomic.cpp b/xbmc/windowing/gbm/drm/DRMAtomic.cpp
index 3a046e6..4d15bba 100644
--- a/xbmc/windowing/gbm/drm/DRMAtomic.cpp
+++ b/xbmc/windowing/gbm/drm/DRMAtomic.cpp
@@ -513,6 +513,9 @@ bool CDRMAtomic::DrmAtomicCommit(int fb_id, int flags, bool rendered, bool video
     }
     auto oldRequest = m_atomicRequestQueue.front().get();
     CDRMAtomicRequest::LogAtomicDiff(m_req, oldRequest);
+    // Hades: where the refused request changes the colour tag of the output to BT.2020, kodi.log
+    // says whether that tag is what the driver refused (TellBt2020Refused())
+    TellBt2020Refused(refused, flags);
     m_req = oldRequest;
 
     // update the old atomic request with the new fb id to avoid tearing
@@ -652,10 +655,51 @@ bool CDRMAtomic::DrmAtomicCommit(int fb_id, int flags, bool rendered, bool video
   if (modeset && !fellBack)
     m_lastModesetAt = std::chrono::steady_clock::now();
   m_dvFrameTest.Accepted(strict, modeset);
+  // Hades: a colour tag went out: a later refusal of the BT.2020 one is told again
+  if (!fellBack && m_req->Value(m_connector, "Colorspace"))
+    m_bt2020RefusalSaid = false;
   FinishRequest(true);
   return true;
 }
 
+void CDRMAtomic::TellBt2020Refused(int refused, int flags)
+{
+  if (!m_connector || m_bt2020RefusalSaid)
+    return;
+  const std::optional<uint64_t> bt2020 =
+      m_connector->GetPropertyEnumValue("Colorspace", "BT2020_RGB");
+  const std::optional<uint64_t> asked = m_req->Value(m_connector, "Colorspace");
+  const std::optional<uint64_t> now = m_connector->ReadPropertyValue("Colorspace");
+  if (!bt2020 || asked != bt2020 || now == bt2020)
+    return;
+  m_bt2020RefusalSaid = true;
+  // The same request with the tag that the output has now, tested only, on a copy: nothing changes
+  // on the display, and the refused request stays as it was. A property that a request names twice
+  // goes with the value it was added with last (drmModeAtomicCommit()).
+  const uint64_t instead =
+      now ? *now : m_connector->GetPropertyEnumValue("Colorspace", "Default").value_or(0);
+  const uint32_t property = m_connector->GetPropertyId("Colorspace");
+  std::unique_ptr<drmModeAtomicReq, AtomicReqFree> copy(drmModeAtomicDuplicate(m_req->Get()));
+  std::optional<bool> takenWithout;
+  if (copy && property &&
+      drmModeAtomicAddProperty(copy.get(), m_connector->GetId(), property, instead) >= 0)
+    takenWithout =
+        drmModeAtomicCommit(m_fd, copy.get(), flags | DRM_MODE_ATOMIC_TEST_ONLY, nullptr) == 0;
+  CLog::LogF(
+      LOGWARNING,
+      "the driver refused a request that changes the colour tag of {} to BT.2020 (Colorspace "
+      "BT2020_RGB, for HDR or for SDR video in BT.2020 colours) ({}): {}. The request before "
+      "it goes out in its place, and the output keeps the tag {}",
+      m_connector->GetName(), strerror(refused),
+      !takenWithout ? "whether that tag is the cause could not be tested"
+      : *takenWithout
+          ? "the same request with the tag that the output has now is taken, so the BT.2020 "
+            "tag is the cause"
+          : "the same request with the tag that the output has now is refused too, so the "
+            "cause is something else in it",
+      m_connector->GetPropertyEnumName("Colorspace", instead).value_or(std::to_string(instead)));
+}
+
 void CDRMAtomic::CommitOutputOffFirst(std::optional<uint64_t> linkBefore)
 {
   const double hz = (m_mode && m_mode->htotal && m_mode->vtotal)
diff --git a/xbmc/windowing/gbm/drm/DRMAtomic.h b/xbmc/windowing/gbm/drm/DRMAtomic.h
index ca00258..ae72d5b 100644
--- a/xbmc/windowing/gbm/drm/DRMAtomic.h
+++ b/xbmc/windowing/gbm/drm/DRMAtomic.h
@@ -317,6 +317,11 @@ private:
   std::optional<std::chrono::steady_clock::time_point> m_lastModesetAt; //!< Hades: LastModesetAt()
   bool m_bufferTaken = true; //!< Hades: see LastBufferTaken()
   std::optional<int> m_hdr10PlusTestError; //!< Hades: see TakeHDR10PlusTestError()
+  //! Hades: a request that changes the colour tag of the output to BT.2020 (Colorspace
+  //! BT2020_RGB), refused: kodi.log says so, and whether the same request with the tag that the
+  //! output has now is taken, once until a colour tag goes out
+  void TellBt2020Refused(int refused, int flags);
+  bool m_bt2020RefusalSaid{false};
   uint64_t m_requestGeneration = 0; //!< Hades: see RequestGeneration()
   //! Hades: a copy of the last request whose test was refused and told (TakeFlipRefused()), and
   //! the flags of its commit, for RefusedForBuffer()
