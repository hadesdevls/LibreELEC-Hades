+/*!
+ * \brief Hades: the 3D output, as the player information says it
+ *
+ * What goes out, not what was asked for: a frame-packed or half mode that the driver did not take is not it.
+ */
+enum class Shown
+{
+  NONE, //!< no 3D output: the eyes are not drawn split
+  FRAME_PACKING, //!< in a frame-packed mode: both eyes in full, in one frame of ScanoutHeight() lines
+  TOP_AND_BOTTOM, //!< the display is told top-and-bottom (by the mode, or by the vendor InfoFrame)
+  SIDE_BY_SIDE_HALF, //!< the display is told side-by-side (half), likewise
+  OTHER, //!< in a mode of another 3D layout, which is not drawn here
+  OVER_UNDER_UNTOLD, //!< the eyes are drawn one above the other, and the display is told nothing
+  SIDE_BY_SIDE_UNTOLD, //!< the eyes are drawn side by side, and the display is told nothing
+};
+
+/*!
+ * \brief Hades: the 3D output, from what is known of it
+ * \param output the layout of the mode that the kernel says the output is in (not that of a mode
+ *        that was asked for)
+ * \param infoFrame the half layout of the HDMI vendor InfoFrame that the driver has from Kodi with
+ *        a 2D mode (none while it has none, or the one that says "no 3D")
+ * \param split the eyes are drawn split (over/under or side by side)
+ * \param topAndBottom ... one above the other
+ *
+ * The mode first: of a mode with a 3D layout the driver tells the display itself. With a 2D mode,
+ * the InfoFrame that the driver sends. Without either, eyes drawn split go out as an ordinary 2D
+ * picture, and the display has to be switched to 3D by hand.
+ */
+constexpr Shown ShownOf(Layout output, Layout infoFrame, bool split, bool topAndBottom)
+{
+  switch (output)
+  {
+    case Layout::FRAME_PACKING:
+      return Shown::FRAME_PACKING;
+    case Layout::TOP_AND_BOTTOM:
+      return Shown::TOP_AND_BOTTOM;
+    case Layout::SIDE_BY_SIDE_HALF:
+      return Shown::SIDE_BY_SIDE_HALF;
+    case Layout::OTHER:
+      return Shown::OTHER;
+    case Layout::NONE:
+      break;
+  }
+  if (infoFrame == Layout::TOP_AND_BOTTOM)
+    return Shown::TOP_AND_BOTTOM;
+  if (infoFrame == Layout::SIDE_BY_SIDE_HALF)
+    return Shown::SIDE_BY_SIDE_HALF;
+  if (!split)
+    return Shown::NONE;
+  return topAndBottom ? Shown::OVER_UNDER_UNTOLD : Shown::SIDE_BY_SIDE_UNTOLD;
+}
