+// Hades: the mode of a frame-packed 3D output as the display gets it: the frame of both eyes and the
+// lines between them ("1920x2205 @ 23.976 Hz"; STEREO::ScanoutHeight()), at the refresh rate of the
+// mode, which is that of its 2D timing. The mode as it is where it has no frame packing.
+std::string FramePackedModeTextOf(const drmModeModeInfo& mode, const STEREO::Mode& stereo)
+{
+  if (STEREO::LayoutOf(stereo.flags) != STEREO::Layout::FRAME_PACKING)
+    return ModeTextOf(mode);
+  return KODI::UTILS::ModeText(mode.hdisplay, STEREO::ScanoutHeight(stereo), mode.clock, mode.htotal,
+                               mode.vtotal, (mode.flags & DRM_MODE_FLAG_INTERLACE) != 0,
+                               (mode.flags & DRM_MODE_FLAG_DBLSCAN) != 0, mode.vscan);
+}
+
+// Hades: how the 3D output goes, for the player information (hades.out.stereo; the skin's words for
+// it: HadesOvStereoVar, HadesOutStereoVar): nothing in 2D
+const char* StereoShownCode(STEREO::Shown shown)
+{
+  switch (shown)
+  {
+    case STEREO::Shown::NONE:
+      return "";
+    case STEREO::Shown::FRAME_PACKING:
+      return "fp";
+    case STEREO::Shown::TOP_AND_BOTTOM:
+      return "tab";
+    case STEREO::Shown::SIDE_BY_SIDE_HALF:
+      return "sbs";
+    case STEREO::Shown::OTHER:
+      return "other";
+    case STEREO::Shown::OVER_UNDER_UNTOLD:
+      return "overunder";
+    case STEREO::Shown::SIDE_BY_SIDE_UNTOLD:
+      return "sidebyside";
+  }
+  return "";
+}
