       if (m_serializeSize > 0)
         CLog::Log(LOGINFO, "GAME: Savestate size: {}", m_serializeSize);
diff --git a/xbmc/games/addons/GameClient.h b/xbmc/games/addons/GameClient.h
index 2af4783..b3fc0b2 100644
--- a/xbmc/games/addons/GameClient.h
+++ b/xbmc/games/addons/GameClient.h
@@ -199,6 +199,18 @@ public:
     Restore,
   };
   size_t GetSerializeSize(SerializeSizeMode mode = SerializeSizeMode::Lazy) const;
+
+  /*!
+   * \brief False once the client has run for a while and still gives no
+   *        savestate size, as it then can't save its state
+   *
+   * Reads what the client last answered to GetSerializeSize(), without asking it.
+   */
+  bool SupportsSavestates() const { return !m_noSerializeSize; }
+
+  // Some clients only give a savestate size once they have booted, so no size
+  // means no savestates only after this many frames, about ten seconds of play
+  static constexpr unsigned int SAVESTATE_SIZE_FRAMES = 600;
   bool Serialize(uint8_t* data, size_t size);
   RestoreResult Deserialize(const uint8_t* data,
                             size_t size,
@@ -365,6 +377,7 @@ private:
   // Properties of the current playing file
   std::atomic_bool m_bIsPlaying; // True between OpenFile() and CloseFile()
   std::atomic_bool m_hasFrameRun{false};
+  std::atomic<unsigned int> m_framesRun{0}; // Counted up to SAVESTATE_SIZE_FRAMES
   // The speed the player is running at, as a multiple of normal speed. Written
   // by the thread that changes the speed and read by the client's own, so it is
   // atomic; a client asks for it from inside a call of its own, which can be on
@@ -381,6 +394,7 @@ private:
   std::string m_missingFile; // The first file the client reported missing while loading
   bool m_bRequiresGameLoop = false;
   mutable size_t m_serializeSize = 0;
+  mutable std::atomic_bool m_noSerializeSize{false};
   IGameInputCallback* m_input = nullptr; // The input callback passed to OpenFile()
   std::atomic<double> m_framerate{0.0}; // Video frame rate (fps)
   std::atomic<double> m_samplerate{0.0}; // Audio sample rate (Hz)
diff --git a/xbmc/games/addons/streams/test/TestGameClientHardwareRendering.cpp b/xbmc/games/addons/streams/test/TestGameClientHardwareRendering.cpp
index 23f108b..514a83a 100644
--- a/xbmc/games/addons/streams/test/TestGameClientHardwareRendering.cpp
+++ b/xbmc/games/addons/streams/test/TestGameClientHardwareRendering.cpp
@@ -1294,6 +1294,25 @@ TEST_F(TestGameClientHardwareRendering, PreFrameZeroSizeDoesNotDisableLazyRetry)
   EXPECT_EQ(m_core.sizeQueries, 2U);
 }
 
+TEST_F(TestGameClientHardwareRendering, NoSavestateSizeWhileBootingStillSupportsSavestates)
+{
+  m_core.readyFrame = CGameClient::SAVESTATE_SIZE_FRAMES + 100;
+  m_client->RunFrame(false);
+  EXPECT_EQ(m_client->GetSerializeSize(), 0U);
+  EXPECT_TRUE(m_client->SupportsSavestates());
+
+  while (m_core.frames < CGameClient::SAVESTATE_SIZE_FRAMES)
+    m_client->RunFrame(false);
+  EXPECT_EQ(m_client->GetSerializeSize(), 0U);
+  EXPECT_FALSE(m_client->SupportsSavestates());
+
+  // A client that gives a size later, once it has booted, gets savestates back
+  while (m_core.frames < m_core.readyFrame)
+    m_client->RunFrame(false);
+  EXPECT_EQ(m_client->GetSerializeSize(), 1U);
+  EXPECT_TRUE(m_client->SupportsSavestates());
+}
+
 TEST_F(TestGameClientHardwareRendering, AcceptedHardwarePreservesUnrelatedLoadErrors)
 {
   if (!HARDWARE_API_SUPPORTED)
