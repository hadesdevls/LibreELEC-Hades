From bb586aa411245720a968b53d7849cebe6c203d1e Mon Sep 17 00:00:00 2001
From: Hades <15710513+hadesdevls@users.noreply.github.com>
Date: Tue, 24 Nov 2026 17:40:00 +0000
Subject: [PATCH] [Hades][VideoPlayer] Say where the second view of an MVC
 track was declared

A Matroska file of H.264 MVC declares its second view by a box 'mvcC' in the
codec private data, by a block addition mapping of type 'mvcC' (the form
the Matroska codec specifications prefer), or only by the subset sequence
parameter set in its stream. Hades' ffmpeg-9953 gives the last two to Kodi
in the first form and says which it found in the stream metadata
"mvc_configuration". The line that kodi.log writes for such a track now
says it too, so that a report shows how a file that plays in 2D or in 3D
declares its second view (issue 33: a file of the second form played in
2D, and the log could not say why).
---
 .../DVDDemuxers/DVDDemuxFFmpeg.cpp            | 28 ++++++++++++++-----
 1 file changed, 21 insertions(+), 7 deletions(-)

diff --git a/xbmc/cores/VideoPlayer/DVDDemuxers/DVDDemuxFFmpeg.cpp b/xbmc/cores/VideoPlayer/DVDDemuxers/DVDDemuxFFmpeg.cpp
index e8b3a33..55c2bcf 100644
--- a/xbmc/cores/VideoPlayer/DVDDemuxers/DVDDemuxFFmpeg.cpp
+++ b/xbmc/cores/VideoPlayer/DVDDemuxers/DVDDemuxFFmpeg.cpp
@@ -3969,6 +3969,19 @@ CDemuxStream* CDVDDemuxFFmpeg::AddStream(int streamIdx)
                                                  pStream->codecpar->extradata_size))
         {
           const std::string containerMode = st->stereo_mode;
+          // (where the file declares the second view, as FFmpeg says it: Hades' ffmpeg-9953 reads
+          // a block addition mapping of Matroska and a stream that declares it nowhere else)
+          const AVDictionaryEntry* const declared =
+              av_dict_get(pStream->metadata, "mvc_configuration", nullptr, 0);
+          const std::string declaredBy =
+              !declared                                               ? "its codec data"
+              : std::string_view(declared->value) == "codec private" ? "its codec data"
+              : std::string_view(declared->value) == "block addition mapping"
+                  ? "a block addition mapping of the file (its codec data has no box 'mvcC')"
+              : std::string_view(declared->value) == "stream"
+                  ? "its stream only (a subset sequence parameter set; nothing in its codec data or "
+                    "the file)"
+                  : declared->value;
           KODI::MULTIVIEW::Track track;
           track.h264 = true;
           const int setting = CServiceBroker::GetSettingsComponent()->GetSettings()->GetInt(
@@ -3987,17 +4000,18 @@ CDemuxStream* CDVDDemuxFFmpeg::AddStream(int streamIdx)
             st->stereo_mode = KODI::MULTIVIEW::PACKED_STEREO_MODE;
             ConfigureOffsetMetadata(pStream, st);
             CLog::Log(LOGINFO,
-                      "CDVDDemuxFFmpeg::AddStream - stream {}: H.264 with a second view (MVC); "
-                      "both views are to be decoded, the base view as the {} eye (the container "
-                      "says \"{}\")",
-                      pStream->index, st->multiviewBaseRight ? "right" : "left", containerMode);
+                      "CDVDDemuxFFmpeg::AddStream - stream {}: H.264 with a second view (MVC), "
+                      "declared by {}; both views are to be decoded, the base view as the {} eye "
+                      "(the container says \"{}\")",
+                      pStream->index, declaredBy, st->multiviewBaseRight ? "right" : "left",
+                      containerMode);
           }
           else
           {
             CLog::Log(LOGINFO,
-                      "CDVDDemuxFFmpeg::AddStream - stream {}: H.264 with a second view (MVC) "
-                      "that is not decoded ({}); its base view plays, as before",
-                      pStream->index,
+                      "CDVDDemuxFFmpeg::AddStream - stream {}: H.264 with a second view (MVC), "
+                      "declared by {}, that is not decoded ({}); its base view plays, as before",
+                      pStream->index, declaredBy,
                       !track.allowed && setting == KODI::MULTIVIEW::SETTING_AUTOMATIC
                           ? "the setting is on automatic and the display does not say that it "
                             "takes 3D"
