From ca2510ddf221fce7b8b51285740619066bbe26b2 Mon Sep 17 00:00:00 2001
From: Kel Modderman <kelvmod@gmail.com>
Date: Wed, 11 Nov 2026 19:31:52 +1000
Subject: [PATCH] [python] Abort a Monitor made after its script was told to
 stop

A script told to stop before it creates its xbmc.Monitor, for example
while a service is still importing at startup, never sees the abort:
the notification only reaches monitors that already exist. The script
then runs until SystemExit, or until Kodi quits if it waits in
waitForAbort() without a timeout.

Keep track of which scripts have been told to stop, and set the abort on
any Monitor they create later.

Assisted-by: Claude
(cherry picked from commit 8244e4f7de84b6f114d5201e215d31a0f42267d7)
(cherry picked from commit 45e7baea216ef635a8f2981901f8f5a491b58771)
---
 xbmc/interfaces/python/XBPython.cpp | 12 ++++++++++++
 xbmc/interfaces/python/XBPython.h   |  1 +
 2 files changed, 13 insertions(+)

diff --git a/xbmc/interfaces/python/XBPython.cpp b/xbmc/interfaces/python/XBPython.cpp
index 568fec3..61c0645 100644
--- a/xbmc/interfaces/python/XBPython.cpp
+++ b/xbmc/interfaces/python/XBPython.cpp
@@ -379,6 +379,9 @@ void XBPython::RegisterPythonMonitorCallBack(XBMCAddon::xbmc::Monitor* pCallback
   XBMC_TRACE;
   std::unique_lock lock(m_vecMonitorCallbackList);
   m_vecMonitorCallbackList.push_back(pCallback);
+  // the script may have been told to stop before it made this Monitor
+  if (m_abortedInvokers.contains(pCallback->GetInvokerId()))
+    pCallback->AbortNotify();
 }
 
 void XBPython::UnregisterPythonMonitorCallBack(XBMCAddon::xbmc::Monitor* pCallback)
@@ -710,7 +713,11 @@ void XBPython::NotifyScriptAborting(ILanguageInvoker* invoker)
 
   long invokerId(-1);
   if (invoker != NULL)
+  {
     invokerId = invoker->GetId();
+    std::unique_lock lock(m_vecMonitorCallbackList);
+    m_abortedInvokers.insert(invokerId);
+  }
 
   LOCK_AND_COPY(std::vector<XBMCAddon::xbmc::Monitor*>, tmp, m_vecMonitorCallbackList);
   for (auto& it : tmp)
@@ -725,6 +732,11 @@ void XBPython::NotifyScriptAborting(ILanguageInvoker* invoker)
 
 void XBPython::OnExecutionEnded(ILanguageInvoker* invoker)
 {
+  {
+    std::unique_lock lock(m_vecMonitorCallbackList);
+    m_abortedInvokers.erase(invoker->GetId());
+  }
+
   std::unique_lock lock(m_vecPyList);
   PyList::iterator it = m_vecPyList.begin();
   while (it != m_vecPyList.end())
diff --git a/xbmc/interfaces/python/XBPython.h b/xbmc/interfaces/python/XBPython.h
index ceba3fb..4a30aaa 100644
--- a/xbmc/interfaces/python/XBPython.h
+++ b/xbmc/interfaces/python/XBPython.h
@@ -134,6 +134,7 @@ private:
   PyList m_vecPyList;
   PlayerCallbackList m_vecPlayerCallbackList;
   MonitorCallbackList m_vecMonitorCallbackList;
+  std::set<long> m_abortedInvokers;
 
   // any global events that scripts should be using
   CEvent m_globalEvent;
