From c670991a9c4661910f8189d6980c5c81eb8fb362 Mon Sep 17 00:00:00 2001
From: Hades <15710513+hadesdevls@users.noreply.github.com>
Date: Wed, 18 Nov 2026 02:52:35 +0000
Subject: [PATCH] CEC: tell libCEC itself that a route takes no input of the TV

The adapter of an output that does not carry Kodi's picture is
configured without the activation of the source and without the TV
among the devices to wake (the commit before). For a routing change to
it, the first libcec-9015 went by the devices to wake; but libCEC ties
them to the activation of the source (CCECClient::SetConfiguration():
taking the TV off the devices to wake turns the activation off, and
Kodi writes that back to its settings), so a user who keeps the TV off
the devices to wake on the output with the picture lost the switch of
the TV to the PC when a receiver routes to it.

Kodi now tells libCEC what it decided: CECSetTakesNoTvInput(), which
libcec-9015 of LibreELEC Hades adds (CEC_HADES_TAKES_NO_TV_INPUT), true
for an adapter of another output, false otherwise, after each creation
of the libCEC instance and each new verdict. Every setting is as before
on the output with the picture. Built against a libCEC without it, Kodi
says in its log that a routing change still takes the TV's input.
---
 .../devices/PeripheralCecAdapter.cpp            | 17 +++++++++++++++++
 xbmc/peripherals/devices/PeripheralCecAdapter.h |  3 +++
 xbmc/peripherals/devices/PeripheralCecPicture.h |  7 ++++---
 3 files changed, 24 insertions(+), 3 deletions(-)

diff --git a/xbmc/peripherals/devices/PeripheralCecAdapter.cpp b/xbmc/peripherals/devices/PeripheralCecAdapter.cpp
index e903f56..482b516 100644
--- a/xbmc/peripherals/devices/PeripheralCecAdapter.cpp
+++ b/xbmc/peripherals/devices/PeripheralCecAdapter.cpp
@@ -315,6 +315,9 @@ bool CPeripheralCecAdapter::InitialiseFeature(const PeripheralFeature feature)
       SetVersionInfo(m_configuration);
     }
 
+    // Hades: and whether a route to Kodi takes the TV's input through it (JudgePicture())
+    TellTakesNoTvInput();
+
     m_bStarted = true;
     Create();
 
@@ -2125,6 +2128,20 @@ void CPeripheralCecAdapter::ProcessPictureChange(void)
   SetConfigurationFromSettings();
   if (m_queryThread && m_queryThread->IsRunning())
     m_queryThread->UpdateConfiguration(&m_configuration);
+  TellTakesNoTvInput();
+}
+
+void CPeripheralCecAdapter::TellTakesNoTvInput(void)
+{
+#if defined(CEC_HADES_TAKES_NO_TV_INPUT)
+  if (m_cecAdapter)
+    CECSetTakesNoTvInput(m_cecAdapter, m_picture == CEC_PICTURE::Verdict::OTHER);
+#else
+  // (a libCEC without libcec-9015: a routing change to Kodi takes the TV's input as before)
+  if (m_picture == CEC_PICTURE::Verdict::OTHER)
+    CLog::Log(LOGINFO, "CEC: this libCEC cannot be told to take no input of the TV on a routing "
+                       "change to Kodi: a receiver switched to the PC still switches the TV");
+#endif
 }
 
 void CPeripheralCecAdapter::StandbyDevices(void)
diff --git a/xbmc/peripherals/devices/PeripheralCecAdapter.h b/xbmc/peripherals/devices/PeripheralCecAdapter.h
index 9d8f998..b0a2b5c 100644
--- a/xbmc/peripherals/devices/PeripheralCecAdapter.h
+++ b/xbmc/peripherals/devices/PeripheralCecAdapter.h
@@ -163,6 +163,9 @@ private:
   CEC_PICTURE::Verdict JudgePicture(void);
   //! Hades: the configuration made again when Kodi's picture moves to another output
   void ProcessPictureChange(void);
+  //! Hades: libCEC told whether a route to Kodi takes the TV's input through this adapter
+  //! (CECSetTakesNoTvInput() of libcec-9015): not through an adapter of another output
+  void TellTakesNoTvInput(void);
 
   void PushCecKeypress(const CEC::cec_keypress& key);
   void PushCecKeypress(const CecButtonPress& key);
diff --git a/xbmc/peripherals/devices/PeripheralCecPicture.h b/xbmc/peripherals/devices/PeripheralCecPicture.h
index f0aa391..a9d09da 100644
--- a/xbmc/peripherals/devices/PeripheralCecPicture.h
+++ b/xbmc/peripherals/devices/PeripheralCecPicture.h
@@ -86,9 +86,10 @@ inline Verdict Decide(const std::optional<AdapterConnector>& adapter,
 }
 
 //! What the adapter is configured with: through an adapter of another output, no activation of
-//! the source and no waking of the TV (libCEC sends <Image View On> to wake it, and libcec-9015 of
-//! Hades takes a TV that is not to be woken as one whose input is not taken on a routing change
-//! either); else what the user's settings say
+//! the source and no waking of the TV (libCEC sends <Image View On> to wake it); else what the
+//! user's settings say. A routing change to it is told apart by the client itself
+//! (CECSetTakesNoTvInput() of libcec-9015 of Hades), not by these settings, which libCEC ties
+//! together: a user who keeps the TV off the devices to wake on the picture's output is as before.
 struct TvInput
 {
   bool activateSource{false};
-- 
