From 6d39189b2903613224b8f1213b77131c1ab57c4a Mon Sep 17 00:00:00 2001
From: Hades <15710513+hadesdevls@users.noreply.github.com>
Date: Tue, 24 Nov 2026 21:06:30 +0000
Subject: [PATCH] DVDDemuxFFmpeg: an HLS stream loads only the variant it plays

Kodi opened a stream that avformat opens itself, closed it, and opened
it again with load_all_variants=0, an option of the HLS demuxer that no
FFmpeg Kodi builds with had. Hades opens it once already, with the
option; the HLS demuxer of Hades' FFmpeg now takes it (ffmpeg-9972, in
LibreELEC), with max_bandwidth: of a master playlist, only the variant
that HLSSelectProgram() chooses is loaded (the highest resolution, then
bandwidth, within the bandwidth setting of the network; 0 is no limit),
with the playlists of its renditions, instead of every variant's
playlists and the probing of all their streams. The author measured
15 to 25 s of start of an HLS channel before (not measured here).

The bandwidth setting now goes with the open as max_bandwidth. Where an
HLS stream (by its content type or by .m3u8/.m3u) does not open with one
variant, which may be broken where the others are not, it is opened
again with all of them, as before; not when the open was ended (the
player stops, or the 30 s of the open are over), and not for a stream of
another kind, which fails at once as before.

From Daniil Gentili's pull request to Kodi, xbmc/xbmc#30046
("[VideoPlayer] DemuxFFmpeg: fix slow start of HLS streams", open at the
time; CoreELEC/xbmc commit 02ca54eaf2), adapted to Hades' single open.
---
 .../DVDDemuxers/DVDDemuxFFmpeg.cpp            | 37 +++++++++++++++----
 1 file changed, 30 insertions(+), 7 deletions(-)

diff --git a/xbmc/cores/VideoPlayer/DVDDemuxers/DVDDemuxFFmpeg.cpp b/xbmc/cores/VideoPlayer/DVDDemuxers/DVDDemuxFFmpeg.cpp
index a190e86..99a55a6 100644
--- a/xbmc/cores/VideoPlayer/DVDDemuxers/DVDDemuxFFmpeg.cpp
+++ b/xbmc/cores/VideoPlayer/DVDDemuxers/DVDDemuxFFmpeg.cpp
@@ -427,13 +427,18 @@ bool CDVDDemuxFFmpeg::Open(const std::shared_ptr<CDVDInputStream>& pInput, bool
     }
     if (result < 0)
     {
-      // Hades: opened once. It was opened, closed, and opened again with load_all_variants=0, an
-      // option of the HLS demuxer of the FFmpeg that Kodi used to carry patches in, which no FFmpeg
-      // it builds with now has (9.0.2 has no option of that name anywhere): every stream was
-      // connected to and probed twice, and every playlist of an HLS stream loaded twice, for the
-      // same context. The option still goes with the open, where an FFmpeg might take it; one that
-      // does not leaves it in the dictionary.
+      // Hades: opened once. It was opened, closed, and opened again with load_all_variants=0: every
+      // stream was connected to and probed twice, and every playlist of an HLS stream loaded
+      // twice, for the same context. The HLS demuxer of Hades' FFmpeg (ffmpeg-9972) takes
+      // load_all_variants=0 with max_bandwidth: of a master playlist, it loads only the variant
+      // that HLSSelectProgram() would choose below (the highest resolution, then bandwidth, within
+      // the bandwidth setting; 0 is no limit), and the playlists of that variant alone. Other
+      // demuxers leave both options in the dictionary.
+      const int bandwidthKbps = CServiceBroker::GetSettingsComponent()->GetSettings()->GetInt(
+          CSettings::SETTING_NETWORK_BANDWIDTH);
       av_dict_set_int(&options, "load_all_variants", 0, 0);
+      av_dict_set_int(&options, "max_bandwidth",
+                      bandwidthKbps > 0 ? static_cast<int64_t>(bandwidthKbps) * 1000 : 0, 0);
       // a failed attempt (mmsh, above) freed the context, and the one avformat_open_input() would
       // make has no interrupt callback (the second open gave it one)
       if (!m_pFormatContext)
@@ -441,7 +446,25 @@ bool CDVDDemuxFFmpeg::Open(const std::shared_ptr<CDVDInputStream>& pInput, bool
         m_pFormatContext = avformat_alloc_context();
         m_pFormatContext->interrupt_callback = int_cb;
       }
-      if (avformat_open_input(&m_pFormatContext, strFile.c_str(), iformat, &options) < 0)
+      int opened = avformat_open_input(&m_pFormatContext, strFile.c_str(), iformat, &options);
+      // the one variant of an HLS stream may be broken where the others are not: it is opened
+      // again with all of them, as it was before, unless the open was ended (the player stops, or
+      // the 30 s are over). Another stream that does not open is not tried again, as before.
+      std::string hlsContent = m_pInput->GetContent();
+      StringUtils::ToLower(hlsContent);
+      const bool mayBeHls = hlsContent.find("mpegurl") != std::string::npos ||
+                            URIUtils::HasExtension(url.GetFileName(), ".m3u8|.m3u");
+      if (opened < 0 && opened != AVERROR_EXIT && !m_abortRequested && mayBeHls)
+      {
+        CLog::Log(LOGDEBUG, "CDVDDemuxFFmpeg::Open - {} not opened with one variant: again with all",
+                  CURL::GetRedacted(strFile));
+        av_dict_free(&options);
+        options = GetFFMpegOptionsFromInput();
+        m_pFormatContext = avformat_alloc_context();
+        m_pFormatContext->interrupt_callback = int_cb;
+        opened = avformat_open_input(&m_pFormatContext, strFile.c_str(), iformat, &options);
+      }
+      if (opened < 0)
       {
         CLog::Log(LOGDEBUG, "Error, could not open file {}", CURL::GetRedacted(strFile));
         Dispose();
-- 
2.53.0

