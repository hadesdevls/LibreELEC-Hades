+  glBindTexture(GL_TEXTURE_2D, m_texture);
+  glTexSubImage2D(GL_TEXTURE_2D, 0, x, y, width, height, GL_RGB, GL_FLOAT, rgb);
+  const GLenum error = glGetError();
+  glBindTexture(GL_TEXTURE_2D, 0);
+  glActiveTexture(GL_TEXTURE0);
+  glPixelStorei(GL_UNPACK_ALIGNMENT, alignment);
+  glPixelStorei(GL_UNPACK_ROW_LENGTH, rowLength);
+  if (error != GL_NO_ERROR)
+  {
+    why = StringUtils::Format("the GPU did not take a part of its table ({}x{} at {},{}): GL error {:#x}", width,
+                              height, x, y, error);
+    Release();
+    return false;
+  }
+  return true;
+#else
+  why = "its table is a texture of 32-bit floats, which needs OpenGL ES 3";
+  return false;
+#endif
+}
