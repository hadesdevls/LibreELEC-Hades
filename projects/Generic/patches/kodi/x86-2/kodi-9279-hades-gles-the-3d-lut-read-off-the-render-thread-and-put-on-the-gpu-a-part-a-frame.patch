+
+#pragma once
+
+#include <atomic>
+#include <chrono>
+#include <functional>
+#include <memory>
+#include <mutex>
+#include <string>
+#include <thread>
+#include <utility>
+#include <vector>
+
+namespace KODI::WINDOWING::GBM::DISPLAY_LUT
+{
+
+/*!
+ * \brief Hades: the LUT files of the display read and converted off the render thread (DisplayLut.h)
+ *
+ * A madVR LUT is a file of up to 256 MB and a table of 256^3 points (200 MB of floats). It was read, converted and
+ * kept on the render thread, in the frame that first needed it: that frame stalled for as long as the reading took,
+ * and the file, the table and Kodi's copy of the table for its renderer were in memory at once (650 MB at most).
+ *
+ * Here a file is read and converted on a thread of the loader's (load: the bytes are let go as soon as the table is
+ * made: only the table is kept), and the render thread asks for the table of a kind (Want()) without ever waiting:
+ * LOADING while it is read (the picture is drawn without it, and the player information says so), READY with the table
+ * (or with none and why, where the file could not be read) once it is. The memory is bounded: one table of each kind,
+ * and one file being read at a time. Asking for another file or range of a kind lets go of the table of before at once,
+ * before the new one is read; a read whose file is no longer asked for (another file, or the setting turned off:
+ * Clear()) is let go of when it ends, and the next one asked is read after it. The loader's thread runs only while there
+ * is something to read; the destructor waits for a read in progress to end (the files are bounded: DVBRIDGE_LUT_MAX_BYTES).
+ *
+ * Table is the converted table (dvbridge_lut); only the render thread calls Want() and Clear(). Pure logic: a host test
+ * runs it with loads of its own (tools/regress of LibreELEC, kodi-host: display_lut_loader_test.cpp).
+ */
+template<typename Table>
+class CLutLoader
+{
+public:
+  using Ptr = std::shared_ptr<Table>;
+  //! reads and converts a file (on the loader's thread): the table, or null and why
+  using Load = std::function<Ptr(const std::string& path, int range, std::string& why)>;
+
+  enum class State
+  {
+    LOADING,
+    READY,
+  };
+
+  //! What Want() gives
+  struct Got
+  {
+    State state = State::LOADING;
+    Ptr table; //!< READY: the table (null: the file could not be read, why says why)
+    std::string why;
+    double ms = 0; //!< READY: how long the reading took
+    bool fresh = false; //!< READY: the first time this table (or failure) is given, for the log
+  };
+
+  explicit CLutLoader(Load load, int kinds = 2) : m_load(std::move(load)), m_slots(kinds) {}
+  ~CLutLoader()
+  {
+    m_stop = true;
+    if (m_thread.joinable())
+      m_thread.join();
+  }
+  CLutLoader(const CLutLoader&) = delete;
+  CLutLoader& operator=(const CLutLoader&) = delete;
+
+  /*!
+   * \brief The table of a kind for this file and range (render thread; never waits for a read)
+   */
+  Got Want(int kind, const std::string& path, int range)
+  {
+    Got got;
+    Ptr gone;
+    {
+      std::unique_lock lock(m_lock);
+      if (kind < 0 || kind >= static_cast<int>(m_slots.size()))
+      {
+        got.state = State::READY;
+        got.why = "no such kind of LUT";
+        return got;
+      }
+      Slot& s = m_slots[kind];
+      if (!s.asked || s.path != path || s.range != range)
+      {
+        // another file of the kind: the table of before goes now (below, without the lock), before the new one is read
+        gone = std::move(s.table);
+        s = Slot();
+        s.asked = true;
+        s.path = path;
+        s.range = range;
+      }
+      if (s.done)
+      {
+        got.state = State::READY;
+        got.table = s.table;
+        got.why = s.why;
+        got.ms = s.ms;
+        got.fresh = !std::exchange(s.told, true);
+        return got;
+      }
+      StartLocked();
+    }
+    return got;
+  }
+
+  //! Every table let go (the setting is off; render thread); a read in progress is let go of when it ends
+  void Clear()
+  {
+    std::vector<Ptr> gone;
+    std::unique_lock lock(m_lock);
+    for (Slot& s : m_slots)
+    {
+      gone.push_back(std::move(s.table));
+      s = Slot();
+    }
+    lock.unlock();
+  }
+
+  //! Whether a file is being read (for the tests and the log)
+  bool Busy() const
+  {
+    std::unique_lock lock(m_lock);
+    return m_running;
+  }
+
+private:
+  struct Slot
+  {
+    bool asked = false;
+    std::string path;
+    int range = -1;
+    bool done = false;
+    Ptr table;
+    std::string why;
+    double ms = 0;
+    bool told = false;
+  };
+
+  // (with m_lock) the thread, where it does not run: a thread that ended is joined first (it has left its loop)
+  void StartLocked()
+  {
+    if (m_running)
+      return;
+    if (m_thread.joinable())
+      m_thread.join();
+    m_running = true;
+    m_thread = std::thread([this] { Run(); });
+  }
+
+  void Run()
+  {
+    for (;;)
+    {
+      int kind = -1;
+      std::string path;
+      int range = -1;
+      {
+        std::unique_lock lock(m_lock);
+        for (size_t k = 0; k < m_slots.size() && kind < 0; ++k)
+          if (m_slots[k].asked && !m_slots[k].done)
+          {
+            kind = static_cast<int>(k);
+            path = m_slots[k].path;
+            range = m_slots[k].range;
+          }
+        if (kind < 0 || m_stop)
+        {
+          m_running = false;
+          return;
+        }
+      }
+      std::string why;
+      const auto start = std::chrono::steady_clock::now();
+      Ptr table = m_load(path, range, why);
+      const double ms =
+          std::chrono::duration<double, std::milli>(std::chrono::steady_clock::now() - start).count();
+      {
+        std::unique_lock lock(m_lock);
+        Slot& s = m_slots[kind];
+        // (still asked for: kept; else let go of below, without the lock)
+        if (s.asked && !s.done && s.path == path && s.range == range)
+        {
+          s.table = std::move(table);
+          s.why = std::move(why);
+          s.done = true;
+          s.ms = ms;
+        }
+      }
+    }
+  }
+
+  Load m_load;
+  mutable std::mutex m_lock;
+  std::vector<Slot> m_slots;
+  std::thread m_thread;
+  bool m_running = false;
+  std::atomic<bool> m_stop{false};
+};
+
+} // namespace KODI::WINDOWING::GBM::DISPLAY_LUT
