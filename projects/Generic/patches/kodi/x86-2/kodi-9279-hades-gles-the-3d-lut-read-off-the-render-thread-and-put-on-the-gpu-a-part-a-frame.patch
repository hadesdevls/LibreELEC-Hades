diff --git a/tools/dvbridge/dvbridge_lut_atlas.c b/tools/dvbridge/dvbridge_lut_atlas.c
index ce4d4be..6110f4a 100644
--- a/tools/dvbridge/dvbridge_lut_atlas.c
+++ b/tools/dvbridge/dvbridge_lut_atlas.c
@@ -19,8 +19,48 @@ static bool full(struct dvbridge_lut_range r)
     return r.lo == 0.0f && r.hi == 255.0f;
 }
 
+void dvbridge_lut_atlas_slice(const struct dvbridge_lut_atlas *atlas, int b, int *x0, int *y0)
+{
+    /* slice b at column b % cols and row b / cols of slices */
+    *x0 = (b % atlas->cols) * atlas->size;
+    *y0 = (b / atlas->cols) * atlas->size;
+}
+
+const float *dvbridge_lut_atlas_slice_data(const struct dvbridge_lut *lut, int b)
+{
+    /* the file's values, red fastest, then green, then blue (dvbridge_lut.h) */
+    return lut->data + (size_t)b * (size_t)lut->size * (size_t)lut->size * 3;
+}
+
 bool dvbridge_lut_atlas_make(const struct dvbridge_lut *lut, int max_texture_size, struct dvbridge_lut_atlas *atlas,
                              char *why, size_t why_size)
+{
+    if (!dvbridge_lut_atlas_layout(lut, max_texture_size, atlas, why, why_size))
+        return false;
+    const int n = atlas->size, width = atlas->width, height = atlas->height;
+    float *rgb = calloc((size_t)width * (size_t)height * 3, sizeof(float));
+    if (!rgb) {
+        if (why)
+            snprintf(why, why_size, "no memory for its table of %d points a side (%zu MB)", n,
+                     ((size_t)width * (size_t)height * 3 * sizeof(float)) >> 20);
+        memset(atlas, 0, sizeof(*atlas));
+        return false;
+    }
+    /* in each slice, red along x and green along y */
+    for (int b = 0; b < n; ++b) {
+        int x0, y0;
+        dvbridge_lut_atlas_slice(atlas, b, &x0, &y0);
+        const float *slice = dvbridge_lut_atlas_slice_data(lut, b);
+        for (int g = 0; g < n; ++g)
+            memcpy(rgb + (((size_t)(y0 + g) * (size_t)width) + (size_t)x0) * 3, slice + (size_t)g * (size_t)n * 3,
+                   (size_t)n * 3 * sizeof(float));
+    }
+    atlas->rgb = rgb;
+    return true;
+}
+
+bool dvbridge_lut_atlas_layout(const struct dvbridge_lut *lut, int max_texture_size, struct dvbridge_lut_atlas *atlas,
+                               char *why, size_t why_size)
 {
     if (why && why_size)
         why[0] = '\0';
@@ -45,29 +85,12 @@ bool dvbridge_lut_atlas_make(const struct dvbridge_lut *lut, int max_texture_siz
                                     "%d a side", n, width, height, max_texture_size);
         return false;
     }
-    float *rgb = calloc((size_t)width * (size_t)height * 3, sizeof(float));
-    if (!rgb) {
-        if (why)
-            snprintf(why, why_size, "no memory for its table of %d points a side (%zu MB)", n,
-                     ((size_t)width * (size_t)height * 3 * sizeof(float)) >> 20);
-        return false;
-    }
-    /* slice b at column b % cols and row b / cols of slices; in it, red along x and green along y (the file's values,
-     * red fastest: dvbridge_lut.h) */
-    for (int b = 0; b < n; ++b) {
-        const int x0 = (b % cols) * n, y0 = (b / cols) * n;
-        for (int g = 0; g < n; ++g) {
-            const float *from = lut->data + (((size_t)b * (size_t)n + (size_t)g) * (size_t)n) * 3;
-            float *to = rgb + (((size_t)(y0 + g) * (size_t)width) + (size_t)x0) * 3;
-            memcpy(to, from, (size_t)n * 3 * sizeof(float));
-        }
-    }
     atlas->size = n;
     atlas->cols = cols;
     atlas->rows = rows;
     atlas->width = width;
     atlas->height = height;
-    atlas->rgb = rgb;
+    atlas->rgb = NULL;
     atlas->grid[0] = (float)(n - 1);
     atlas->grid[1] = (float)cols;
     atlas->grid[2] = (float)(1.0 / width);
diff --git a/tools/dvbridge/dvbridge_lut_atlas.h b/tools/dvbridge/dvbridge_lut_atlas.h
index 3bc24be..836c667 100644
--- a/tools/dvbridge/dvbridge_lut_atlas.h
+++ b/tools/dvbridge/dvbridge_lut_atlas.h
@@ -50,4 +50,19 @@ bool dvbridge_lut_atlas_make(const struct dvbridge_lut *lut, int max_texture_siz
                              char *why, size_t why_size);
 void dvbridge_lut_atlas_free(struct dvbridge_lut_atlas *atlas);
 
+/*
+ * Hades: the same without the copy of the table (rgb is NULL): its size, its place in a texture and the values of the
+ * shader, for a caller that puts the slices of blue into the texture itself, each straight from the LUT
+ * (dvbridge_lut_atlas_slice(), dvbridge_lut_atlas_slice_data()): Kodi's renderer, a part in each frame, so that a large
+ * table is neither copied nor put on the GPU in one frame. The texels are the same as those of
+ * dvbridge_lut_atlas_make().
+ */
+bool dvbridge_lut_atlas_layout(const struct dvbridge_lut *lut, int max_texture_size, struct dvbridge_lut_atlas *atlas,
+                               char *why, size_t why_size);
+/* Where slice b of blue begins in the texture (its N x N texels: red along x, green along y) */
+void dvbridge_lut_atlas_slice(const struct dvbridge_lut_atlas *atlas, int b, int *x0, int *y0);
+/* ... and its N x N texels of 3 floats in the LUT, the rows of green one after the other, as glTexSubImage2D() takes
+ * them */
+const float *dvbridge_lut_atlas_slice_data(const struct dvbridge_lut *lut, int b);
+
 #endif
diff --git a/xbmc/cores/VideoPlayer/VideoRenderers/LinuxRendererGLES.cpp b/xbmc/cores/VideoPlayer/VideoRenderers/LinuxRendererGLES.cpp
index 2354dcb..ba8aca8 100644
--- a/xbmc/cores/VideoPlayer/VideoRenderers/LinuxRendererGLES.cpp
+++ b/xbmc/cores/VideoPlayer/VideoRenderers/LinuxRendererGLES.cpp
@@ -1534,44 +1534,84 @@ void CLinuxRendererGLES::Lut3dTake()
     m_lut3dRefused = true;
     lut = nullptr;
   }
-  // its table on the GPU, once for each LUT
-  if (lut && !(m_lut3d.Valid() && lut == m_lut3dOf && lut->pl.signature == m_lut3dSig))
+  // its table on the GPU, once for each LUT, a part in each frame (LUT_PART_BYTES at most) and straight from the LUT
+  // (no copy of it is made): the pictures go without it until all of it is there, and the player information says it
+  // is loading
+  m_lut3dPending = false;
+  std::string why;
+  if (lut && !(m_lut3d.Started() && lut == m_lut3dOf && lut->pl.signature == m_lut3dSig))
   {
-    const auto start = std::chrono::steady_clock::now();
+    m_lut3d.Release();
+    m_lut3dOf = nullptr;
+    m_lut3dSig = 0;
     GLint maxSize = 0;
     glGetIntegerv(GL_MAX_TEXTURE_SIZE, &maxSize);
-    dvbridge_lut_atlas atlas{};
     char atlasWhy[256] = {};
-    std::string why;
-    if (!dvbridge_lut_atlas_make(lut, maxSize, &atlas, atlasWhy, sizeof(atlasWhy)))
+    dvbridge_lut_atlas layout{};
+    if (!dvbridge_lut_atlas_layout(lut, maxSize, &layout, atlasWhy, sizeof(atlasWhy)))
       why = atlasWhy;
-    else if (m_lut3d.Upload(atlas.rgb, atlas.width, atlas.height, why))
+    else if (m_lut3d.Begin(layout.width, layout.height, why))
     {
-      std::copy(std::begin(atlas.grid), std::end(atlas.grid), m_lut3d.m_grid);
-      std::copy(std::begin(atlas.in), std::end(atlas.in), m_lut3d.m_in);
-      std::copy(std::begin(atlas.shaper), std::end(atlas.shaper), m_lut3d.m_shaper);
-      std::copy(std::begin(atlas.out), std::end(atlas.out), m_lut3d.m_out);
+      std::copy(std::begin(layout.grid), std::end(layout.grid), m_lut3d.m_grid);
+      std::copy(std::begin(layout.in), std::end(layout.in), m_lut3d.m_in);
+      std::copy(std::begin(layout.shaper), std::end(layout.shaper), m_lut3d.m_shaper);
+      std::copy(std::begin(layout.out), std::end(layout.out), m_lut3d.m_out);
+      m_lut3dSize = layout.size;
+      m_lut3dCols = layout.cols;
+      m_lut3dWidth = layout.width;
+      m_lut3dHeight = layout.height;
       m_lut3dOf = lut;
       m_lut3dSig = lut->pl.signature;
-      CLog::Log(LOGINFO,
-                "3D LUT: the table of {} points a side on the GPU for Kodi's renderer in {:.0f} ms: {}x{} texels of "
-                "32-bit floats ({} MB), {} slices a row",
-                atlas.size,
-                std::chrono::duration<double, std::milli>(std::chrono::steady_clock::now() - start).count(),
-                atlas.width, atlas.height, m_lut3d.Bytes() >> 20, atlas.cols);
+      m_lut3dPart = 0;
+      m_lut3dFrames = 0;
+      m_lut3dMs = 0;
+    }
+  }
+  if (lut && m_lut3d.Started() && !m_lut3d.Valid())
+  {
+    // the next slices of blue, each straight from the LUT
+    const auto start = std::chrono::steady_clock::now();
+    dvbridge_lut_atlas layout{};
+    layout.size = m_lut3dSize;
+    layout.cols = m_lut3dCols;
+    const int n = m_lut3dSize;
+    const size_t slice = static_cast<size_t>(n) * static_cast<size_t>(n) * 3 * sizeof(float);
+    size_t put = 0;
+    while (m_lut3dPart < n && (put == 0 || put + slice <= LUT_PART_BYTES))
+    {
+      int x0 = 0, y0 = 0;
+      dvbridge_lut_atlas_slice(&layout, m_lut3dPart, &x0, &y0);
+      if (!m_lut3d.Put(dvbridge_lut_atlas_slice_data(lut, m_lut3dPart), x0, y0, n, n, why))
+        break;
+      put += slice;
+      ++m_lut3dPart;
     }
-    dvbridge_lut_atlas_free(&atlas);
-    if (!m_lut3d.Valid())
+    ++m_lut3dFrames;
+    m_lut3dMs += std::chrono::duration<double, std::milli>(std::chrono::steady_clock::now() - start).count();
+    if (m_lut3d.Started() && m_lut3dPart == n)
     {
-      CLog::Log(LOGWARNING, "3D LUT: Kodi's renderer cannot apply it: {}; the pictures are drawn without it", why);
-      m_lut3dFailedOf = lut;
-      m_lut3dFailedSig = lut->pl.signature;
-      m_lut3dRefused = true;
-      lut = nullptr;
+      m_lut3d.Ready();
+      CLog::Log(LOGINFO,
+                "3D LUT: the table of {} points a side on the GPU for Kodi's renderer in {} frames ({:.0f} ms in all, "
+                "{} MB at most a frame): {}x{} texels of 32-bit floats ({} MB), {} slices a row",
+                n, m_lut3dFrames, m_lut3dMs, LUT_PART_BYTES >> 20, m_lut3dWidth, m_lut3dHeight,
+                m_lut3d.Bytes() >> 20, m_lut3dCols);
     }
+    else if (m_lut3d.Started())
+      m_lut3dPending = true;
+  }
+  if (lut && !m_lut3d.Started())
+  {
+    CLog::Log(LOGWARNING, "3D LUT: Kodi's renderer cannot apply it: {}; the pictures are drawn without it", why);
+    m_lut3dFailedOf = lut;
+    m_lut3dFailedSig = lut->pl.signature;
+    m_lut3dRefused = true;
+    m_lut3dOf = nullptr;
+    m_lut3dSig = 0;
+    lut = nullptr;
   }
-  const bool want = lut != nullptr;
-  if (!want && m_lut3d.Valid())
+  const bool want = lut != nullptr && m_lut3d.Valid();
+  if (!lut && m_lut3d.Started())
   {
     m_lut3d.Release();
     m_lut3dOf = nullptr;
@@ -1618,7 +1658,7 @@ void CLinuxRendererGLES::Lut3dDrawn()
     Lut3dShaderFailed("the shader that drew the picture");
     failed = true;
   }
-  window->LutDrawn(true, applied, failed);
+  window->LutDrawn(true, applied, failed, m_lut3dPending);
 }
 
 const CLut3dGLES* CLinuxRendererGLES::Lut3dShaders() const
diff --git a/xbmc/cores/VideoPlayer/VideoRenderers/LinuxRendererGLES.h b/xbmc/cores/VideoPlayer/VideoRenderers/LinuxRendererGLES.h
index 06ef63d..fa0929a 100644
--- a/xbmc/cores/VideoPlayer/VideoRenderers/LinuxRendererGLES.h
+++ b/xbmc/cores/VideoPlayer/VideoRenderers/LinuxRendererGLES.h
@@ -350,6 +350,19 @@ protected:
   //! refused by this GPU
   bool m_lut3dTaken = false;
   bool m_lut3dRefused = false;
+  //! the table put on the GPU a part in each frame (Lut3dTake()): its layout (dvbridge_lut_atlas_layout(): points a
+  //! side, slices a row, texels), the next slice of blue, the frames and the time it took so far; pending: not all of it
+  //! is there yet (the picture goes without it)
+  int m_lut3dSize = 0;
+  int m_lut3dCols = 0;
+  int m_lut3dWidth = 0;
+  int m_lut3dHeight = 0;
+  int m_lut3dPart = 0;
+  unsigned int m_lut3dFrames = 0;
+  double m_lut3dMs = 0;
+  bool m_lut3dPending = false;
+  //! at most this much of the table a frame
+  static constexpr size_t LUT_PART_BYTES = size_t{16} << 20;
 #endif
   // Hades: the chroma of the 4:2:0 pictures that this renderer draws itself (ChromaStepDown.h,
   // gles_yuv2rgb_chroma.frag): where the video places its samples, with Lanczos 3, a level down
diff --git a/xbmc/cores/VideoPlayer/VideoRenderers/VideoShaders/Lut3dGLES.cpp b/xbmc/cores/VideoPlayer/VideoRenderers/VideoShaders/Lut3dGLES.cpp
index 6a98593..7fc465f 100644
--- a/xbmc/cores/VideoPlayer/VideoRenderers/VideoShaders/Lut3dGLES.cpp
+++ b/xbmc/cores/VideoPlayer/VideoRenderers/VideoShaders/Lut3dGLES.cpp
@@ -13,11 +13,11 @@
 
 using namespace Shaders::GLES;
 
-bool CLut3dGLES::Upload(const float* rgb, int width, int height, std::string& why)
+bool CLut3dGLES::Begin(int width, int height, std::string& why)
 {
   why.clear();
   Release();
-  if (!rgb || width < 1 || height < 1)
+  if (width < 1 || height < 1)
   {
     why = "no table";
     return false;
@@ -26,12 +26,6 @@ bool CLut3dGLES::Upload(const float* rgb, int width, int height, std::string& wh
   // (errors of before are not this upload's; a lost context may keep giving one)
   for (int i = 0; i < 16 && glGetError() != GL_NO_ERROR; ++i)
     ;
-  // the unpacking as the table is laid out (the planes of the video may leave a row length or an alignment set)
-  GLint alignment = 4, rowLength = 0;
-  glGetIntegerv(GL_UNPACK_ALIGNMENT, &alignment);
-  glGetIntegerv(GL_UNPACK_ROW_LENGTH, &rowLength);
-  glPixelStorei(GL_UNPACK_ALIGNMENT, 4);
-  glPixelStorei(GL_UNPACK_ROW_LENGTH, 0);
