From e5cae9612f18e9dfbb91b18b19b5727b6cb7d02e Mon Sep 17 00:00:00 2001
From: Hades <15710513+hadesdevls@users.noreply.github.com>
Date: Wed, 18 Nov 2026 21:43:26 +0000
Subject: [PATCH] estuary: the bar of the player information shows the use of
 the CPU alone where its temperature is not available

On a PC without a temperature sensor of its CPU, System.CPUTemperature is Kodi's "Not available"
(string 10005, GetSystemHeatInfo()). The CPU box of the bar at the bottom of the player information
is 150 px wide: "100%, Not available" takes 227 px in font12 and "Not available" alone does not fit
either, so the bar showed "Not availa..." or a cut line on such a PC, in English and in Spanish.

HadesBarCpuVar now shows the temperature only where it is not that string: the use of the CPU and
its temperature, the use alone, or the temperature alone before the first use is published. The
generated pages for other skins (system/hades) are made again from Estuary's files.
---
 addons/skin.estuary/xml/Variables.xml | 9 ++++++---
 system/hades/HadesIncludes.xml        | 5 +++--
 2 files changed, 9 insertions(+), 5 deletions(-)

diff --git a/addons/skin.estuary/xml/Variables.xml b/addons/skin.estuary/xml/Variables.xml
index 82d7521..54d0434 100644
--- a/addons/skin.estuary/xml/Variables.xml
+++ b/addons/skin.estuary/xml/Variables.xml
@@ -1448,10 +1448,13 @@
 		<value condition="String.IsEqual(Window(Home).Property(hades.out.vrr),none)">$ADDON[skin.estuary 61904]</value>
 		<value>$ADDON[skin.estuary 61899]</value>
 	</variable>
-	<!-- Hades: the CPU in the bar of the player information: its use and its temperature, as the GPU -->
+	<!-- Hades: the CPU in the bar of the player information: its use and its temperature, as the GPU. On a PC without a
+	     temperature sensor of its CPU, Kodi gives "Not available" (string 10005) for System.CPUTemperature: that text
+	     does not fit the box of the bar, after the use or alone, so the bar shows the use alone there -->
 	<variable name="HadesBarCpuVar">
-		<value condition="!String.IsEmpty(Window(Home).Property(hades.sys.cpu))">$INFO[Window(Home).Property(hades.sys.cpu),,%]$INFO[System.CPUTemperature,$COMMA ,]</value>
-		<value>$INFO[System.CPUTemperature]</value>
+		<value condition="!String.IsEmpty(Window(Home).Property(hades.sys.cpu)) + !String.IsEqual(System.CPUTemperature,$LOCALIZE[10005])">$INFO[Window(Home).Property(hades.sys.cpu),,%]$INFO[System.CPUTemperature,$COMMA ,]</value>
+		<value condition="!String.IsEmpty(Window(Home).Property(hades.sys.cpu))">$INFO[Window(Home).Property(hades.sys.cpu),,%]</value>
+		<value condition="!String.IsEqual(System.CPUTemperature,$LOCALIZE[10005])">$INFO[System.CPUTemperature]</value>
 	</variable>
 	<!-- Hades: what the TV declares in its EDID, on the system page of the player information (hades.tv.*, set by
 	     DeclaresOf() of WinSystemGbmGLESContext once per display change): the HDR formats, the Dolby Vision block, the
diff --git a/system/hades/HadesIncludes.xml b/system/hades/HadesIncludes.xml
index 8f3d262..03bd14f 100644
--- a/system/hades/HadesIncludes.xml
+++ b/system/hades/HadesIncludes.xml
@@ -57,8 +57,9 @@
 		<value condition="String.IsEqual(Window(Home).Property(hades.sum.arg),codecoff)">$ADDON[skin.estuary 52728]</value>
 	</variable>
 	<variable name="HadesBarCpuVar">
-		<value condition="!String.IsEmpty(Window(Home).Property(hades.sys.cpu))">$INFO[Window(Home).Property(hades.sys.cpu),,%]$INFO[System.CPUTemperature,$COMMA ,]</value>
-		<value>$INFO[System.CPUTemperature]</value>
+		<value condition="!String.IsEmpty(Window(Home).Property(hades.sys.cpu)) + !String.IsEqual(System.CPUTemperature,$LOCALIZE[10005])">$INFO[Window(Home).Property(hades.sys.cpu),,%]$INFO[System.CPUTemperature,$COMMA ,]</value>
+		<value condition="!String.IsEmpty(Window(Home).Property(hades.sys.cpu))">$INFO[Window(Home).Property(hades.sys.cpu),,%]</value>
+		<value condition="!String.IsEqual(System.CPUTemperature,$LOCALIZE[10005])">$INFO[System.CPUTemperature]</value>
 	</variable>
 	<variable name="HadesDVAheadVar">
 		<value condition="String.IsEqual(Window(Home).Property(hades.dv.ahead),yes)">$LOCALIZE[107]</value>
-- 
2.53.0

