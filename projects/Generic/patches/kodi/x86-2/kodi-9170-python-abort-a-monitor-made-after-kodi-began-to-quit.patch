From 3ed20c8f3730b20251bb9e224c56db6d96ca2f2e Mon Sep 17 00:00:00 2001
From: Kel Modderman <kelvmod@gmail.com>
Date: Mon, 16 Nov 2026 06:21:05 +1000
Subject: [PATCH] [python] Abort a Monitor made after Kodi began to quit

When Kodi quits it tells every script to abort, but only monitors that
exist at that moment get the notification. A plugin that fills a list
control and creates its xbmc.Monitor after that point sees
abortRequested() == False and runs to its end, and the quit waits for
it (#30577).

Remember that the abort went to all scripts, and set it on any Monitor
created afterwards.

Assisted-by: Claude
(cherry picked from commit de718e34cd608d3670866dd3feb1633cf8003a67)
(cherry picked from commit c1c4ab9898f56708697d990263622d4acd2ec46e)
---
 xbmc/interfaces/python/XBPython.cpp | 12 ++++++++----
 xbmc/interfaces/python/XBPython.h   |  1 +
 2 files changed, 9 insertions(+), 4 deletions(-)

diff --git a/xbmc/interfaces/python/XBPython.cpp b/xbmc/interfaces/python/XBPython.cpp
index 61c0645..63e32c8 100644
--- a/xbmc/interfaces/python/XBPython.cpp
+++ b/xbmc/interfaces/python/XBPython.cpp
@@ -380,7 +380,7 @@ void XBPython::RegisterPythonMonitorCallBack(XBMCAddon::xbmc::Monitor* pCallback
   std::unique_lock lock(m_vecMonitorCallbackList);
   m_vecMonitorCallbackList.push_back(pCallback);
   // the script may have been told to stop before it made this Monitor
-  if (m_abortedInvokers.contains(pCallback->GetInvokerId()))
+  if (m_abortedAllInvokers || m_abortedInvokers.contains(pCallback->GetInvokerId()))
     pCallback->AbortNotify();
 }
 
@@ -712,11 +712,15 @@ void XBPython::NotifyScriptAborting(ILanguageInvoker* invoker)
   XBMC_TRACE;
 
   long invokerId(-1);
-  if (invoker != NULL)
   {
-    invokerId = invoker->GetId();
     std::unique_lock lock(m_vecMonitorCallbackList);
-    m_abortedInvokers.insert(invokerId);
+    if (invoker != NULL)
+    {
+      invokerId = invoker->GetId();
+      m_abortedInvokers.insert(invokerId);
+    }
+    else
+      m_abortedAllInvokers = true;
   }
 
   LOCK_AND_COPY(std::vector<XBMCAddon::xbmc::Monitor*>, tmp, m_vecMonitorCallbackList);
diff --git a/xbmc/interfaces/python/XBPython.h b/xbmc/interfaces/python/XBPython.h
index 4a30aaa..08b6957 100644
--- a/xbmc/interfaces/python/XBPython.h
+++ b/xbmc/interfaces/python/XBPython.h
@@ -135,6 +135,7 @@ private:
   PlayerCallbackList m_vecPlayerCallbackList;
   MonitorCallbackList m_vecMonitorCallbackList;
   std::set<long> m_abortedInvokers;
+  bool m_abortedAllInvokers{false};
 
   // any global events that scripts should be using
   CEvent m_globalEvent;
-- 
