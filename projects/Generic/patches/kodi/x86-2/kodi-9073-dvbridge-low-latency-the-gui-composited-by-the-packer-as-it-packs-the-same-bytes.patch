diff --git a/tools/dvbridge/dvbridge_gl_pack.c b/tools/dvbridge/dvbridge_gl_pack.c
index a3e17d4..365075b 100644
--- a/tools/dvbridge/dvbridge_gl_pack.c
+++ b/tools/dvbridge/dvbridge_gl_pack.c
@@ -22,10 +22,22 @@ void dvbridge_gl_drain_errors(void)
         ;
 }
 
+/* Hades: a program of the packer and the locations of its uniforms (gui, gui_peak, gui_gamma: the
+ * program with Kodi's GUI composited, DVBRIDGE_PACK_GUI; -1 in the other one) */
+struct pack_program {
+    GLuint program;
+    GLint input, words, count, flip, gui, peak, gamma;
+};
+
 struct dvbridge_gl_packer {
-    GLuint program, vao, sampler;
-    GLint input, words, count, flip;
+    struct pack_program main;
+    GLuint vao, sampler;
     bool quad;
+    /* Hades: the program that composites Kodi's GUI as it packs
+     * (dvbridge_gl_pack_no_metadata_gui()); gui_failed: a pack with it failed on this GPU (never
+     * used again) */
+    struct pack_program gui;
+    bool gui_failed;
 };
 
 /* first: lines in place of the first line of the source, its #version. quiet: a shader that does
@@ -103,17 +115,27 @@ bool dvbridge_gl_fragment_quad(void)
 }
 
 /* quad: both stages as ESSL 3.10 (the version that the subgroup extensions need in Mesa; shaders
- * of two ES versions do not link), and the fragment shader with DVBRIDGE_PACK_QUAD */
-static bool build_program(struct dvbridge_gl_packer *p, const char *vertex, const char *fragment,
-                          bool quad)
+ * of two ES versions do not link), and the fragment shader with DVBRIDGE_PACK_QUAD. Hades: gui:
+ * the fragment shader with DVBRIDGE_PACK_GUI as well (Kodi's GUI composited as it packs), and its
+ * uniforms. Quiet where it has a fallback (the form with quad operations, or the GUI's program). */
+static bool build_program(struct pack_program *p, const char *vertex, const char *fragment,
+                          bool quad, bool gui)
 {
     static const char version[] = "#version 310 es\n";
     static const char prelude[] = "#version 310 es\n"
                                   "#extension GL_KHR_shader_subgroup_basic : require\n"
                                   "#extension GL_KHR_shader_subgroup_quad : require\n"
                                   "#define DVBRIDGE_PACK_QUAD 1\n";
-    GLuint vs = compile(GL_VERTEX_SHADER, vertex, quad ? version : NULL, quad);
-    GLuint fs = compile(GL_FRAGMENT_SHADER, fragment, quad ? prelude : NULL, quad);
+    static const char gui_version[] = "#version 300 es\n"
+                                      "#define DVBRIDGE_PACK_GUI 1\n";
+    static const char gui_prelude[] = "#version 310 es\n"
+                                      "#extension GL_KHR_shader_subgroup_basic : require\n"
+                                      "#extension GL_KHR_shader_subgroup_quad : require\n"
+                                      "#define DVBRIDGE_PACK_QUAD 1\n"
+                                      "#define DVBRIDGE_PACK_GUI 1\n";
+    const char *first = gui ? (quad ? gui_prelude : gui_version) : (quad ? prelude : NULL);
+    GLuint vs = compile(GL_VERTEX_SHADER, vertex, quad ? version : NULL, quad || gui);
+    GLuint fs = compile(GL_FRAGMENT_SHADER, fragment, first, quad || gui);
     if (!vs || !fs) {
         glDeleteShader(vs);
         glDeleteShader(fs);
@@ -131,7 +153,11 @@ static bool build_program(struct dvbridge_gl_packer *p, const char *vertex, cons
     p->words = glGetUniformLocation(p->program, "metadata_words");
     p->count = glGetUniformLocation(p->program, "packet_count");
     p->flip = glGetUniformLocation(p->program, "flip_y");
-    if (!linked || p->input < 0 || p->words < 0 || p->count < 0 || p->flip < 0) {
+    p->gui = gui ? glGetUniformLocation(p->program, "gui") : -1;
+    p->peak = gui ? glGetUniformLocation(p->program, "gui_peak") : -1;
+    p->gamma = gui ? glGetUniformLocation(p->program, "gui_gamma") : -1;
+    if (!linked || p->input < 0 || p->words < 0 || p->count < 0 || p->flip < 0 ||
+        (gui && (p->gui < 0 || p->peak < 0 || p->gamma < 0))) {
         glDeleteProgram(p->program);
         p->program = 0;
         return false;
@@ -139,8 +165,9 @@ static bool build_program(struct dvbridge_gl_packer *p, const char *vertex, cons
     return true;
 }
 
+/* Hades: gui: the program that composites Kodi's GUI as well */
 static struct dvbridge_gl_packer *create_packer(const char *vertex, const char *fragment,
-                                                bool allow_quad)
+                                                bool allow_quad, bool gui)
 {
     struct dvbridge_gl_packer *p = calloc(1, sizeof(*p));
     if (!p)
@@ -149,23 +176,38 @@ static struct dvbridge_gl_packer *create_packer(const char *vertex, const char *
      * where it can (DVBRIDGE_PACK_QUAD), and fetches it otherwise: the same bytes. Where that
      * does not compile or link, the shaders are made as they are written. Either program, and
      * the vertex array and sampler it draws with (make_objects()), or no packer. */
-    p->quad = allow_quad && dvbridge_gl_fragment_quad() && build_program(p, vertex, fragment, true);
-    if ((!p->quad && !build_program(p, vertex, fragment, false)) ||
+    p->quad = allow_quad && dvbridge_gl_fragment_quad() &&
+              build_program(&p->main, vertex, fragment, true, false);
+    if ((!p->quad && !build_program(&p->main, vertex, fragment, false, false)) ||
         !make_objects(&p->vao, &p->sampler)) {
         dvbridge_gl_packer_destroy(p);
         return NULL;
     }
+    /* Hades: and the program that composites Kodi's GUI as it packs, only in the form with quad
+     * operations: there each pixel composites the GUI once and the odd pixel of a pair takes its
+     * even pixel's colour from the quad. Without them the odd pixel composites its even pixel's GUI
+     * again, and on the software bridge that form measured slower than the composite and the
+     * packing where a GUI stays still (a seek bar over a tenth of the raster: 24.1 against 17.5 ms;
+     * the player information over 40 %: 28.5 against 23.0 ms), the same bytes; every GPU in the
+     * logs of Hades' users packs with them. Where it is not made, the GUI is composited over the
+     * picture first, as before (dvbridge_gl_packer_gui()). Its errors are not left for
+     * libplacebo. */
+    if (gui && p->quad && !build_program(&p->gui, vertex, fragment, true, true))
+        p->gui.program = 0;
+    dvbridge_gl_drain_errors();
     return p;
 }
 
 struct dvbridge_gl_packer *dvbridge_gl_packer_create(const char *vertex, const char *fragment)
 {
-    return create_packer(vertex, fragment, true);
+    return create_packer(vertex, fragment, true, true);
 }
 
 struct dvbridge_gl_packer *dvbridge_gl_packer_create_plain(const char *vertex, const char *fragment)
 {
-    return create_packer(vertex, fragment, false);
+    /* (never with quad operations, so never the program that composites the GUI either: the
+     * packer of a check of the bytes never packs a frame with a GUI) */
+    return create_packer(vertex, fragment, false, false);
 }
 
 void dvbridge_gl_packer_destroy(struct dvbridge_gl_packer *p)
@@ -174,7 +216,8 @@ void dvbridge_gl_packer_destroy(struct dvbridge_gl_packer *p)
         return;
     glDeleteVertexArrays(1, &p->vao);
     glDeleteSamplers(1, &p->sampler);
-    glDeleteProgram(p->program);
+    glDeleteProgram(p->main.program);
+    glDeleteProgram(p->gui.program);
     free(p);
 }
 
@@ -183,6 +226,11 @@ bool dvbridge_gl_packer_quad(const struct dvbridge_gl_packer *p)
     return p && p->quad;
 }
 
+bool dvbridge_gl_packer_gui(const struct dvbridge_gl_packer *p)
+{
+    return p && p->gui.program && !p->gui_failed;
+}
+
 struct dvbridge_gl_copier {
     GLuint program, vao, sampler;
     GLint picture, flip_height, levels, limited;
@@ -475,7 +523,8 @@ restore:
 }
 
 static bool pack(struct dvbridge_gl_packer *p, unsigned texture, unsigned framebuffer, int width,
-                 int height, const uint32_t packets[512], unsigned count, bool flip);
+                 int height, const uint32_t packets[512], unsigned count, bool flip,
+                 const struct pack_program *program, unsigned gui, float peak, float gamma);
 
 bool dvbridge_gl_pack(struct dvbridge_gl_packer *p, unsigned texture, unsigned framebuffer,
                      int width, int height, const uint32_t packets[512], unsigned count, bool flip)
@@ -483,7 +532,8 @@ bool dvbridge_gl_pack(struct dvbridge_gl_packer *p, unsigned texture, unsigned f
     /* (16 packets of 32 words: dvbridge_packets()) */
     if (!p || !texture || !packets || !count || count > 16 || width != 3840 || height != 2160)
         return false;
-    return pack(p, texture, framebuffer, width, height, packets, count, flip);
+    return pack(p, texture, framebuffer, width, height, packets, count, flip, &p->main, 0, 0.0f,
+                0.0f);
 }
 
 bool dvbridge_gl_pack_no_metadata(struct dvbridge_gl_packer *p, unsigned texture,
@@ -492,11 +542,43 @@ bool dvbridge_gl_pack_no_metadata(struct dvbridge_gl_packer *p, unsigned texture
     static const uint32_t none[512];
     if (!p || !texture || width != 3840 || height != 2160)
         return false;
-    return pack(p, texture, framebuffer, width, height, none, 0, flip);
+    return pack(p, texture, framebuffer, width, height, none, 0, flip, &p->main, 0, 0.0f, 0.0f);
+}
+
+bool dvbridge_gl_pack_gui_curve(float peak, float gamma)
+{
+    /* (the GUI white within PQ, and a tone curve that Kodi's composite takes:
+     * CGuiCompositeShaderGLES::ValidGamma()) */
+    return isfinite(peak) && peak > 0.0f && peak <= 1.0f &&
+           (gamma == 0.0f || (gamma >= 1.0f && gamma <= 3.0f));
+}
+
+bool dvbridge_gl_pack_no_metadata_gui(struct dvbridge_gl_packer *p, unsigned texture, unsigned gui,
+                                      float peak, float gamma, unsigned framebuffer, int width,
+                                      int height, bool flip)
+{
+    static const uint32_t none[512];
+    if (!dvbridge_gl_packer_gui(p) || !texture || !gui || width != 3840 || height != 2160 ||
+        !dvbridge_gl_pack_gui_curve(peak, gamma))
+        return false;
+    const bool ok = pack(p, texture, framebuffer, width, height, none, 0, flip, &p->gui, gui, peak,
+                         gamma);
+    /* (a GPU that cannot draw it once is not asked again: the GUI is composited over the picture
+     * first, as before, from the next frame on) */
+    if (!ok) {
+        p->gui_failed = true;
+        fprintf(stderr, "DV transport: the packing that composites the GUI failed; the GUI is "
+                        "composited over the picture from the next frame on\n");
+    }
+    return ok;
 }
 
+/* Hades: program: the main one, or the one that composites Kodi's GUI from its texture gui (unit
+ * 1, with the texture's own filter, as Kodi's composite samples it: no sampler object), its white
+ * peak and its tone curve gamma */
 static bool pack(struct dvbridge_gl_packer *p, unsigned texture, unsigned framebuffer, int width,
-                 int height, const uint32_t packets[512], unsigned count, bool flip)
+                 int height, const uint32_t packets[512], unsigned count, bool flip,
+                 const struct pack_program *program, unsigned gui, float peak, float gamma)
 {
     /* Errors left by earlier, unrelated GL work are not ours: clear them (bounded), so that the
      * checks below see only what the pack raised. */
@@ -525,17 +607,26 @@ static bool pack(struct dvbridge_gl_packer *p, unsigned texture, unsigned frameb
         goto restore;
     glViewport(0, 0, width, height);
     glColorMask(GL_TRUE, GL_TRUE, GL_TRUE, GL_TRUE);
-    glUseProgram(p->program);
+    glUseProgram(program->program);
     glBindVertexArray(p->vao);
     // libplacebo-owned textures use sampler objects and need not have usable
     // default texture filtering (e.g. mipmaps may be absent). Own our exact
     // non-mipmapped sampler without mutating the borrowed texture's state.
     glBindSampler(0, p->sampler);
     glBindTexture(GL_TEXTURE_2D, texture);
-    glUniform1i(p->input, 0);
-    glUniform4uiv(p->words, 128, packets);
-    glUniform1ui(p->count, count);
-    glUniform1ui(p->flip, flip);
+    glUniform1i(program->input, 0);
+    glUniform4uiv(program->words, 128, packets);
+    glUniform1ui(program->count, count);
+    glUniform1ui(program->flip, flip);
+    if (program->gui >= 0) {
+        glActiveTexture(GL_TEXTURE1);
+        glBindTexture(GL_TEXTURE_2D, gui);
+        glBindSampler(1, 0);
+        glUniform1i(program->gui, 1);
+        glUniform1f(program->peak, peak);
+        glUniform1f(program->gamma, gamma);
+        glActiveTexture(GL_TEXTURE0);
+    }
     glDrawArrays(GL_TRIANGLES, 0, 3);
     ok = glGetError() == GL_NO_ERROR;
 restore:
diff --git a/tools/dvbridge/dvbridge_gl_pack.h b/tools/dvbridge/dvbridge_gl_pack.h
index 492d5d5..81a9833 100644
--- a/tools/dvbridge/dvbridge_gl_pack.h
+++ b/tools/dvbridge/dvbridge_gl_pack.h
@@ -41,6 +41,28 @@ bool dvbridge_gl_pack(struct dvbridge_gl_packer *packer, unsigned pq_texture,
 #define DVBRIDGE_GL_PACK_NO_METADATA 1
 bool dvbridge_gl_pack_no_metadata(struct dvbridge_gl_packer *packer, unsigned pq_texture,
                                   unsigned framebuffer, int width, int height, bool flip_y);
+/* Hades: the same, with Kodi's GUI composited over the picture as it is packed, instead of into the
+ * picture first (CWinSystemGbmGLESContext::CompositeGui()): the GUI texture gui (Kodi's GUI FBO, of
+ * the raster's size, its last row the top of the screen) sampled where the composite samples it,
+ * with the arithmetic of the composite where fragment shaders have highp (gles_gui_composite.frag,
+ * KODI_GUI_EXACT, PQ in full range) and the blend of its factors: peak, the GUI white in units of
+ * 10000 cd/m2 (its u_pqPeak); gamma, its tone curve (its u_guiGamma: a pure power of 1 to 3, or 0
+ * for the sRGB EOTF). Where the GUI covers nothing, the bytes of dvbridge_gl_pack_no_metadata();
+ * under it, those of the composite and then that packing (measured on the software bridge; a GPU
+ * may round its blend unit apart from the shader by a code here and there). The 3840x2160
+ * picture of 32-bit floats is then neither read and written by the composite nor cleared again
+ * where the GUI drew over its bars. false where the packer has no such program
+ * (dvbridge_gl_packer_gui(): made only in the form with quad operations,
+ * dvbridge_gl_packer_quad(); never by dvbridge_gl_packer_create_plain()), for a peak or a curve
+ * outside those, or where the pack failed: then the packer never packs so again, and the caller
+ * composites the GUI first, as before.
+ * dvbridge_gl_pack_gui_curve(): whether a peak and a curve are ones this packing takes. */
+#define DVBRIDGE_GL_PACK_NO_METADATA_GUI 1
+bool dvbridge_gl_pack_no_metadata_gui(struct dvbridge_gl_packer *packer, unsigned pq_texture,
+                                      unsigned gui, float peak, float gamma, unsigned framebuffer,
+                                      int width, int height, bool flip_y);
+bool dvbridge_gl_packer_gui(const struct dvbridge_gl_packer *packer);
+bool dvbridge_gl_pack_gui_curve(float peak, float gamma);
 /* Hades: copies a picture from a float texture (first row at the top) into a framebuffer of the
  * same size, sample for sample, for output as HDR10. A fixed-point framebuffer gets the nearest
  * of its levels of every value: the shader picks the level, since a framebuffer may also cut a
diff --git a/tools/dvbridge/dvbridge_render.c b/tools/dvbridge/dvbridge_render.c
index b424a0b..1030b5d 100644
--- a/tools/dvbridge/dvbridge_render.c
+++ b/tools/dvbridge/dvbridge_render.c
@@ -50,12 +50,14 @@ enum {
 
 /* Hades: the bridge's own passes that are timed (dvbridge_render_time_passes()), each with a few
  * queries in flight, read when they have come back (as libplacebo does with its own) */
-enum { TIMER_ROWS, TIMER_PICTURE, TIMER_PACK_SOURCE, TIMER_PACK_CONVERTED, PASS_TIMERS };
+enum { TIMER_ROWS, TIMER_PICTURE, TIMER_PACK_SOURCE, TIMER_PACK_CONVERTED, TIMER_PACK_LL_GUI,
+       PASS_TIMERS };
 static const char *const TIMER_NAMES[PASS_TIMERS] = {
     "bridge: 4:2:2 rows (source transport)",
     "bridge: picture drawn over (source transport)",
     "bridge: packing (source transport)",
-    "bridge: packing (converted transport)"};
+    "bridge: packing (converted transport)",
+    "bridge: packing with GUI (Low-Latency)"};
 #define TIMER_QUERIES 8
 #ifndef GL_TIME_ELAPSED_EXT
 #define GL_TIME_ELAPSED_EXT 0x88BF
@@ -201,6 +203,11 @@ struct dvbridge_renderer {
     /* Hades: the GUI white for the GUI read in place by the packer, for the next frame
      * (dvbridge_render_set_gui_in_place()); 0: not asked. Hades: and its tone curve */
     float inplace_peak, inplace_gamma;
+    /* Hades: Low-Latency: the picture prepared last takes Kodi's GUI composited by the packer of
+     * the converted transport as it packs (dvbridge_gl_pack_no_metadata_gui()), from this GUI
+     * texture, with this white and tone curve; 0: the caller composites the GUI over the picture */
+    unsigned ll_gui;
+    float ll_gui_peak, ll_gui_gamma;
     /* Hades: Dolby Vision Low-Latency (dvbridge_render_set_low_latency()): the picture mapped to
      * ll_mapping, packed without metadata; ll_pattern, the test pattern in its place */
     bool low_latency, ll_pattern;
@@ -757,6 +764,7 @@ void dvbridge_renderer_recover(struct dvbridge_renderer *r)
     r->packed = false;
     r->hdr10_ready = false;
     r->tunnel_frame = false;
+    r->ll_gui = 0;
     if (r->renderer)
         pl_renderer_reset_errors(r->renderer, NULL);
 }
@@ -1595,6 +1603,7 @@ static bool render(struct dvbridge_renderer *r, const struct pl_frame *source,
     r->residual_drawn = false;
     r->packed = packed != NULL;
     r->gui_drawn = 0;
+    r->ll_gui = 0; /* (Hades: set by dvbridge_render_rgb() for the picture it draws) */
     r->ll_curve_drawn = r->ll_curve_held = false; /* (Hades: dvbridge_render_hdr10plus_curve()) */
     dvbridge_candidate_destroy(r->pending);
     r->pending = NULL;
@@ -1918,6 +1927,20 @@ bool dvbridge_render_rgb(struct dvbridge_renderer *r, const struct pl_frame *sou
     if (r && ok && r->ll_curve_held)
         note(r, NOTE_HDR10PLUS_LL_FAILED);
     restore_gl_state(&state);
+    /* Hades: Low-Latency: Kodi's GUI composited by the packer as it packs, where it is asked for
+     * this frame (dvbridge_render_set_gui_in_place(): the caller asks only where its packer can,
+     * and where its composite converts exactly) and its white and tone curve are ones that packing
+     * takes. The picture is drawn whole whatever is drawn over it (Low-Latency has no tiles), so
+     * nothing of it changes; the caller then does not composite the GUI
+     * (dvbridge_render_gui_in_place()). */
+    if (r) {
+        r->ll_gui = ok && r->low_latency && !r->source && r->drawn_gui &&
+                            dvbridge_gl_pack_gui_curve(r->inplace_peak, r->inplace_gamma)
+                        ? r->drawn_gui
+                        : 0;
+        r->ll_gui_peak = r->inplace_peak;
+        r->ll_gui_gamma = r->inplace_gamma;
+    }
     /* Hades: what was to be drawn over this frame (dvbridge_render_set_drawn()) is this frame's */
     if (r) {
         r->drawn_gui = 0;
@@ -1938,6 +1961,7 @@ bool dvbridge_render_packed(struct dvbridge_renderer *r, const struct pl_frame *
          * this one was refused is told again) */
         r->drawn_gui = 0;
         r->inplace_peak = 0.0f;
+        r->ll_gui = 0;
     }
     /* (Hades: the converted transport's direct way also needs quad operations and a picture that
      * fills the raster, which render() checks: the source transport packs a picture drawn at its own
@@ -3832,6 +3856,11 @@ void dvbridge_render_set_gui_in_place(struct dvbridge_renderer *r, float peak, f
 
 bool dvbridge_render_gui_in_place(const struct dvbridge_renderer *r)
 {
+    /* Hades: (Low-Latency: composited by the packer of the converted transport,
+     * dvbridge_render_rgb()) */
+    if (r && r->ready && r->low_latency && !r->packed && !r->source && !r->tunnel_frame &&
+        r->ll_gui)
+        return true;
     return r && r->ready && r->source && dvbridge_source_gui_in_placed(r->source_packer);
 }
 
@@ -3885,6 +3914,13 @@ bool dvbridge_render_gui_cache_read(struct dvbridge_renderer *r, unsigned counts
 
 bool dvbridge_render_complete(struct dvbridge_renderer *r)
 {
+    /* Hades: Low-Latency, whose picture is always whole: a GUI that the packer was to composite is
+     * composited over the picture by the caller instead, after what is drawn into it now (PQ
+     * subtitles, which the GUI covers), as before (dvbridge_render_gui_in_place() then says so) */
