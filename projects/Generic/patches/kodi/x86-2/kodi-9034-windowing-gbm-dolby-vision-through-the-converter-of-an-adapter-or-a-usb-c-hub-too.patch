diff --git a/xbmc/windowing/gbm/WinSystemGbm.cpp b/xbmc/windowing/gbm/WinSystemGbm.cpp
index 0cab06d..fff1b81 100644
--- a/xbmc/windowing/gbm/WinSystemGbm.cpp
+++ b/xbmc/windowing/gbm/WinSystemGbm.cpp
@@ -1803,28 +1803,30 @@ bool CWinSystemGbm::DVTurnedOff() const
 }
 
 #ifdef HAVE_DVBRIDGE
-// Hades: what the output says of the converter of its board (DVBRIDGE_DV_CONVERTER), once when the
-// output is taken: the setting for it is shown where the connector has the property
+// Hades: what the output says of the converter behind it (DVBRIDGE_DV_CONVERTER), once when the
+// output is taken: the setting for it is shown where a converter that the driver takes is behind
+// the port (the kernel gives every DisplayPort connector of its i915 and xe ports the property, and
+// most of them are a DisplayPort display or nothing: there the setting would do nothing)
 void CWinSystemGbm::ReadDVConverterOutput(CDRMConnector& connector)
 {
   // (the output was just read, its display probed: read from the kernel again)
   CDetectedProperty::DisplayLooked();
   const auto verdict = COutputHandover::ConverterVerdict(connector);
-  m_dvConverterChoice = verdict.has_value();
+  m_dvConverterChoice = verdict.has_value() && *verdict != 0;
   if (!verdict)
     return;
   static const char* const names[] = {"none", "unlisted", "listed", "forced"};
   CLog::Log(LOGINFO,
-            "DVBridge: {} can carry Dolby Vision through the DisplayPort to HDMI converter of the "
-            "board (DVBRIDGE_DV_CONVERTER is {}): {}",
+            "DVBridge: {} can carry Dolby Vision through a DisplayPort to HDMI converter, on the "
+            "board or in an adapter or USB-C hub (DVBRIDGE_DV_CONVERTER is {}): {}",
             connector.GetName(), *verdict < 4 ? names[*verdict] : "unknown",
-            *verdict == 0   ? "no such converter is behind the port now"
-            : *verdict == 2 ? "the board is on the list of those where it was seen working: "
-                              "offered by default"
+            *verdict == 0   ? "no such converter is behind the port now: the setting is not shown"
+            : *verdict == 2 ? "the board or the converter is on a list of those where it was seen "
+                              "working: offered by default"
             : *verdict == 3 ? "the kernel takes every converter as verified (dv_pcon=1): offered "
                               "by default"
                             : "offered only where \"Dolby Vision through a display converter\" is "
-                              "On, as nobody has seen it carry Dolby Vision on this board");
+                              "On, as nobody has seen this converter carry Dolby Vision");
 }
 
 int CWinSystemGbm::DVConverterUse() const
diff --git a/xbmc/windowing/gbm/drm/DVConverter.h b/xbmc/windowing/gbm/drm/DVConverter.h
index 8af37d3..6ec7767 100644
--- a/xbmc/windowing/gbm/drm/DVConverter.h
+++ b/xbmc/windowing/gbm/drm/DVConverter.h
@@ -17,15 +17,17 @@ namespace KODI::WINDOWING::GBM
 {
 
 /*!
- * \brief Hades: Dolby Vision through the DisplayPort to HDMI converter that some boards have
- *        between the graphics port and their HDMI socket (i915 and xe, linux-9976 to 9978)
+ * \brief Hades: Dolby Vision through a DisplayPort to HDMI converter: the one that some boards have
+ *        between the graphics port and their HDMI socket, or the one of an adapter or a USB-C hub
+ *        (i915 and xe, linux-9976 to 9978, and linux-9890, which finds it by the port's DPCD)
  *
  * Such a port is a DisplayPort connector for the driver, not an HDMI one, and native output was
  * offered on HDMI connectors only. The kernel gives a DisplayPort connector of a port that can
  * carry the tunnel through a converter the tunnel property (DVBRIDGE_DV_STANDARD_LAB) and
  * DVBRIDGE_DV_CONVERTER, read only, with what it found behind the port: no converter that it
- * takes, a converter that nobody has seen carry the Dolby vendor InfoFrame, a board that is on its
- * list of those where that was seen working, or every converter taken as verified on the command
+ * takes, a converter that nobody has seen carry the Dolby vendor InfoFrame, a board or a converter
+ * that is on its lists of those where that was seen working, or every converter taken as verified on
+ * the command
  * line (dv_pcon=1). A converter that does not carry the vendor InfoFrame leaves the display
  * without Dolby Vision, or without a picture, so the default is to offer it only where somebody
  * has seen it work (the list is the kernel's); the user can ask for it anywhere
@@ -91,7 +93,7 @@ inline Offer Decide(Use use, bool displayPort, const std::optional<uint64_t>& ve
   if (use == Use::OFF)
   {
     offer.code = "converteroff";
-    offer.reason = "Dolby Vision through the converter of the board is turned off in the settings "
+    offer.reason = "Dolby Vision through a display converter is turned off in the settings "
                    "(System > Display)";
     return offer;
   }
@@ -101,18 +103,18 @@ inline Offer Decide(Use use, bool displayPort, const std::optional<uint64_t>& ve
     offer.reason =
         "the display is on a connector that the driver calls DisplayPort, and no "
         "DisplayPort to HDMI converter that the driver takes is behind it (a DisplayPort "
-        "or USB-C adapter, a converter that may go to FRL, or no converter); native "
-        "output needs an HDMI connector or such a converter";
+        "display, an adapter to another kind of socket, a converter that may go to FRL, or no "
+        "converter); native output needs an HDMI connector or such a converter";
     return offer;
   }
   if (use == Use::AUTO && v == Verdict::UNLISTED)
   {
     offer.code = "converterunlisted";
     offer.reason =
