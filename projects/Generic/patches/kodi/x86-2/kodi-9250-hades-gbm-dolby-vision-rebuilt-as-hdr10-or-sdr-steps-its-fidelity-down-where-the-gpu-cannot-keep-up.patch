diff --git a/xbmc/windowing/gbm/DVConvertStep.h b/xbmc/windowing/gbm/DVConvertStep.h
new file mode 100644
index 0000000..d784d4a
--- /dev/null
+++ b/xbmc/windowing/gbm/DVConvertStep.h
@@ -0,0 +1,166 @@
+/*
+ *  Copyright (C) 2026 Hades
+ *  This file is part of LibreELEC Hades. It is not in Kodi as Team Kodi publishes it.
+ *
+ *  SPDX-License-Identifier: GPL-2.0-or-later
+ *  See LICENSES/README.md for more information.
+ */
+
+#pragma once
+
+#include "DVStepDown.h"
+
+#include <cstdint>
+#include <utility>
+
+namespace KODI
+{
+namespace WINDOWING
+{
+namespace GBM
+{
+
+/*!
+ * \brief The fidelity step-down of Dolby Vision rebuilt for output as HDR10 or SDR, where the GPU cannot keep up
+ *
+ * On a display without Dolby Vision, the bridge rebuilds each picture (with the residual of a full enhancement layer)
+ * and maps it to HDR10 or to SDR in Kodi's ordinary output (CWinSystemGbmGLESContext::RenderDVConversion()). The
+ * rebuilding has the levels of native output (dvbridge_render_set_step(): the planes scaled up to the picture's size
+ * scaled up more simply, one level at a time); the mapping has none. This decides the level of each picture by the
+ * rule of native output, CDVStepDown, with what the ordinary output can tell:
+ *
+ * - the pace is the way that waits (Pace::WAITING): Kodi draws a frame and its commit waits for its flip; a picture
+ *   has one refresh period, less what the rest of the frame takes;
+ * - the GPU time of a picture is that of the bridge's work on it, the rebuilding, the mapping and the copy into the
+ *   window, timed on the GPU (Timed());
+ * - whether a picture missed its refresh comes from the flips: the commit that carries a new picture (Committed())
+ *   missed its refresh when its flip came more than one and a half refresh periods after the flip of the commit
+ *   before it (Flipped(): every commit while pictures are rebuilt, with the times the kernel gives for them). A flip
+ *   that is not known (no out-fence, a wait that timed out) tells nothing, and the next one is not measured against
+ *   it either.
+ *
+ * Only new pictures count: one drawn again for a refresh where the video has none (24p in a 60 Hz mode, the pause) is
+ * not rebuilt and is not measured; such commits still give their flips, which the next new picture is measured
+ * against. So a level goes down only where both the GPU times (5 % of a window over 80 % of the period, or most of it
+ * over it) and the missed refreshes say so, or where the GPU could not keep up in any case; it goes back up when the
+ * level above would fit with room to spare; a GPU that keeps up never leaves level 0, the faithful picture, the same
+ * bytes as without this. The enhancement layer is never given up at any level: the levels change filters, and a
+ * picture whose layer is drawn at level 0 has it drawn at every level (the ladder of such a picture,
+ * dvbridge_render_step_levels(), is of that picture).
+ *
+ * As for native output, "Fidelity step-down" (videoscreen.hadesdvstepmode) decides: Automatic (the default) as above,
+ * Never always level 0, a level for every picture where one is set (or advancedsettings.xml's <dvstepdown>). What is
+ * found stays from one video to the next in a session (a picture format keeps its level and its measurements); a
+ * new session measures again. This class only decides; the window system draws each picture at Level(), gives the
+ * times and the flips, and logs what changes.
+ */
+class CDVConvertStep
+{
+public:
+  using Step = CDVStepDown::Step;
+  using Pace = CDVStepDown::Pace;
+
+  //! A new picture as drawn: its format (CDVFrameLoad), its level and the levels of its ladder; not valid: none
+  struct Frame
+  {
+    bool valid = false;
+    uint64_t format = 0;
+    int level = 0;
+    unsigned int ladder = 1;
+  };
+
+  //! A flip later than this many refresh periods after the one before it missed a refresh
+  static constexpr double LATE_PERIODS = 1.5;
+
+  //! The settings, as native output reads them (CDVEngineSettings): the level set for every picture (-1: none) and
+  //! whether Kodi lowers the fidelity where the GPU cannot keep up
+  void Configure(int forced, bool automatic)
+  {
+    m_forced = forced >= 0 ? std::min(forced, CDVStepDown::LEVELS - 1) : -1;
+    m_automatic = automatic;
+  }
+  int Forced() const { return m_forced; }
+  bool Automatic() const { return m_automatic; }
+  //! Whether pictures are measured: neither a level set nor the faithful picture always
+  bool Measuring() const { return m_forced < 0 && m_automatic; }
+
+  //! A new video, a seek, or the end of the conversion: the first seconds are left out, the flips begin again
+  void Restart()
+  {
+    m_step.Seeked();
+    m_committed = Frame();
+    m_lastFlipNs = 0;
+  }
+
+  /*!
+   * \brief The level that a new picture of this format is drawn at
+   * \param ladder the levels that change anything for it (dvbridge_render_step_levels())
+   * \param step what changed with it, for the log (Step::changed)
+   */
+  int Level(uint64_t format, unsigned int ladder, Step* step = nullptr)
+  {
+    if (m_forced >= 0)
+      return CDVStepDown::Effective(ladder, m_forced);
+    if (!m_automatic || format == 0)
+      return 0;
+    const Step s = m_step.Draw(format, ladder);
+    if (step)
+      *step = s;
+    return CDVStepDown::Chosen(m_forced, m_automatic, s.level);
+  }
+
+  //! The GPU time of a new picture; a window that ends with it decides (the step for the log)
+  Step Timed(const Frame& frame, double ms, double periodMs)
+  {
+    if (!Measuring() || !frame.valid)
+      return Step();
+    return m_step.Measured(frame.format, frame.level, ms, periodMs, Pace::WAITING, false, true,
+                           frame.ladder);
+  }
+
+  //! The commit of this pass carries a new picture (frame), or none (a picture drawn again, or nothing rebuilt)
+  void Committed(const Frame& frame) { m_committed = frame; }
+
+  /*!
+   * \brief The flip of the commit before came at flipNs (steady clock; 0: not known)
+   * \return whether the picture it carried missed its refresh (false where that is not known or it carried none)
+   */
+  bool Flipped(int64_t flipNs, double periodMs)
+  {
+    const Frame frame = std::exchange(m_committed, Frame());
+    if (flipNs <= 0 || !(periodMs > 0))
+    {
+      m_lastFlipNs = 0;
+      return false;
+    }
+    bool late = false;
+    if (frame.valid && m_lastFlipNs > 0)
+    {
+      late = static_cast<double>(flipNs - m_lastFlipNs) > LATE_PERIODS * periodMs * 1e6;
+      if (Measuring())
+        m_step.Presented(frame.format, frame.level, late, Pace::WAITING, frame.ladder);
+    }
+    m_lastFlipNs = flipNs;
+    return late;
+  }
+
+  //! Whether the flips of the commits are wanted (a new picture was committed, or the chain of flips goes on)
+  bool WantsFlips() const { return m_committed.valid || m_lastFlipNs > 0; }
+
+  //! The level of a format, without drawing a picture (0 when it is not known)
+  int LevelOf(uint64_t format, unsigned int ladder = 0) const
+  {
+    return m_forced >= 0 ? m_forced : m_automatic ? m_step.Level(format, ladder) : 0;
+  }
+
+private:
+  CDVStepDown m_step;
+  int m_forced = -1;
+  bool m_automatic = true;
+  Frame m_committed;
+  int64_t m_lastFlipNs = 0;
+};
+
