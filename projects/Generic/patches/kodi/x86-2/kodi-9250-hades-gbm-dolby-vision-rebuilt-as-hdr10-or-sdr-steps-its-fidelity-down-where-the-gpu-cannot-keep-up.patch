+int CWinSystemGbmGLESContext::ConvStepLevel(uint64_t format, unsigned int ladder)
+{
+  // The settings of native output, read once a video (DVEngineRead(): videoscreen.hadesdvstepmode, and
+  // advancedsettings.xml's <dvstepdown> before it)
+  if (!m_convStepRead)
+  {
+    m_convStepRead = true;
+    const auto component = CServiceBroker::GetSettingsComponent();
+    const auto settings = component ? component->GetSettings() : nullptr;
+    const auto advanced = component ? component->GetAdvancedSettings() : nullptr;
+    CDVEngineSettings::Read read;
+    read.step = settings && settings->GetSetting(CSettings::SETTING_VIDEOSCREEN_HADESDVSTEPMODE)
+                    ? settings->GetInt(CSettings::SETTING_VIDEOSCREEN_HADESDVSTEPMODE)
+                    : 0;
+    CDVEngineSettings::Advanced fromFile;
+    if (advanced)
+      fromFile.stepDown = advanced->m_videoDVStepDown;
+    const CDVEngineSettings engine = CDVEngineSettings::Resolve(read, fromFile);
+    const bool changed =
+        engine.stepForced != m_convStep.Forced() || engine.stepAutomatic != m_convStep.Automatic();
+    m_convStep.Configure(engine.stepForced, engine.stepAutomatic);
+    m_convStep.Restart();
+    if (changed || !m_convStepTold)
+    {
+      m_convStepTold = true;
+      if (engine.stepForced >= 0)
+        CLog::Log(
+            LOGINFO,
+            "DVBridge: the fidelity step-down of Dolby Vision rebuilt for output as HDR10 or SDR "
+            "is "
+            "forced to level {} by {}: {} (a picture for which that level changes nothing is drawn "
+            "at "
+            "the highest level under it that changes it, or exactly)",
+            engine.stepForced,
+            engine.stepByAdvanced ? "advancedsettings.xml (dvstepdown)"
+                                  : "the setting (videoscreen.hadesdvstepmode)",
+            DVStepWhat(engine.stepForced, m_dvConvertBridge && m_dvConvertBridge->CCMComposer()));
+      else if (!engine.stepAutomatic)
+        CLog::Log(LOGINFO,
+                  "DVBridge: the fidelity of Dolby Vision rebuilt for output as HDR10 or SDR is "
+                  "never lowered (the setting says never): level 0 even where the graphics "
+                  "cannot keep up");
+      else
+        CLog::Log(
+            LOGINFO,
+            "DVBridge: Dolby Vision rebuilt for output as HDR10 or SDR is drawn faithfully "
+            "(fidelity "
+            "step-down level 0) unless the graphics are measured not to keep up with its pictures, "
+            "as native output (videoscreen.hadesdvstepmode: automatic); the enhancement layer is "
+            "drawn at every level");
+    }
+  }
+  // the pictures around a seek or a change of stream are left out (as for native output: m_dvStepSeeks)
+  if (const unsigned int seeks = m_dvStepSeeks.load(std::memory_order_relaxed);
+      seeks != m_convSeeksSeen)
+  {
+    m_convSeeksSeen = seeks;
+    m_convStep.Restart();
+  }
+  CDVStepDown::Step step;
+  const int level = m_convStep.Level(format, ladder, &step);
+  ConvStepReport(step, format);
+  return level;
+}
+
+void CWinSystemGbmGLESContext::ConvTimerMark(bool begin, const CDVConvertStep::Frame& frame)
+{
+  if (!m_convStep.Measuring())
+    return;
+  if (!m_convTimersMade)
+  {
+    m_convTimersMade = true;
+    if (IsExtSupported("GL_EXT_disjoint_timer_query"))
+    {
+      if (!m_glGenQueriesEXT)
+        m_glGenQueriesEXT =
+            reinterpret_cast<PFNGLGENQUERIESEXTPROC>(eglGetProcAddress("glGenQueriesEXT"));
+      if (!m_glDeleteQueriesEXT)
+        m_glDeleteQueriesEXT =
+            reinterpret_cast<PFNGLDELETEQUERIESEXTPROC>(eglGetProcAddress("glDeleteQueriesEXT"));
+      if (!m_glQueryCounterEXT)
+        m_glQueryCounterEXT =
+            reinterpret_cast<PFNGLQUERYCOUNTEREXTPROC>(eglGetProcAddress("glQueryCounterEXT"));
+      if (!m_glGetQueryObjectuivEXT)
+        m_glGetQueryObjectuivEXT = reinterpret_cast<PFNGLGETQUERYOBJECTUIVEXTPROC>(
+            eglGetProcAddress("glGetQueryObjectuivEXT"));
+      if (!m_glGetQueryObjectui64vEXT)
+        m_glGetQueryObjectui64vEXT = reinterpret_cast<PFNGLGETQUERYOBJECTUI64VEXTPROC>(
+            eglGetProcAddress("glGetQueryObjectui64vEXT"));
+    }
+    if (m_glGenQueriesEXT && m_glDeleteQueriesEXT && m_glQueryCounterEXT &&
+        m_glGetQueryObjectuivEXT && m_glGetQueryObjectui64vEXT)
+      for (auto& timer : m_convTimers)
+      {
+        m_glGenQueriesEXT(1, &timer.begin);
+        m_glGenQueriesEXT(1, &timer.end);
+      }
+    else
+      CLog::Log(LOGINFO,
+                "DVBridge: the pictures of Dolby Vision rebuilt for output as HDR10 or SDR are not "
+                "timed (no GL_EXT_disjoint_timer_query): their fidelity is not lowered");
+  }
+  auto& timer = m_convTimers[m_convTimerIndex];
+  if (!timer.begin || !timer.end)
+    return;
+  if (begin)
+  {
+    if (timer.pending)
+      return; // (its result is not back yet: this picture is not timed)
+    m_glQueryCounterEXT(timer.begin, GL_TIMESTAMP_EXT);
+    timer.begun = true;
+  }
+  else if (timer.begun)
+  {
+    timer.begun = false;
+    // (nothing new was drawn: nothing to measure)
+    if (!frame.valid)
+      return;
+    m_glQueryCounterEXT(timer.end, GL_TIMESTAMP_EXT);
+    timer.pending = true;
+    timer.frame = frame;
+    m_convTimerIndex = (m_convTimerIndex + 1) % m_convTimers.size();
+  }
+}
+
+void CWinSystemGbmGLESContext::ConvTimerCollect()
+{
+  if (!m_glGetQueryObjectuivEXT || !m_convTimers[0].begin)
+    return;
+  // (reading the disjoint state clears it; a disjoint period makes the results in flight useless)
+  GLint disjoint = 0;
+  glGetIntegerv(GL_GPU_DISJOINT_EXT, &disjoint);
+  const double periodMs = DVRefreshPeriodMs();
+  for (size_t n = 0; n < m_convTimers.size(); ++n)
+  {
+    auto& timer = m_convTimers[(m_convTimerIndex + n) % m_convTimers.size()];
+    if (!timer.pending)
+      continue;
+    GLuint available = 0;
+    m_glGetQueryObjectuivEXT(timer.end, GL_QUERY_RESULT_AVAILABLE_EXT, &available);
+    if (!available)
+      break;
+    timer.pending = false;
+    GLuint64 start = 0, finish = 0;
+    m_glGetQueryObjectui64vEXT(timer.begin, GL_QUERY_RESULT_EXT, &start);
+    m_glGetQueryObjectui64vEXT(timer.end, GL_QUERY_RESULT_EXT, &finish);
+    if (disjoint || finish <= start)
+      continue;
+    ConvStepReport(
+        m_convStep.Timed(timer.frame, static_cast<double>(finish - start) / 1e6, periodMs),
+        timer.frame.format);
+  }
+}
+
+void CWinSystemGbmGLESContext::ConvTimersFree()
+{
+  if (m_glDeleteQueriesEXT)
+    for (auto& timer : m_convTimers)
+      if (timer.begin)
+      {
+        m_glDeleteQueriesEXT(1, &timer.begin);
+        m_glDeleteQueriesEXT(1, &timer.end);
+      }
+  m_convTimers = {};
+  m_convTimerIndex = 0;
+  m_convTimersMade = false;
+}
+
+void CWinSystemGbmGLESContext::ConvStepReport(const CDVStepDown::Step& step, uint64_t format)
+{
+  using Why = CDVStepDown::Why;
+  if (!step.changed && step.why != Why::NOTHING_KEEPS_UP)
+    return;
+  const std::string which =
+      StringUtils::Format("pictures {} the residual of an enhancement layer",
+                          CDVFrameLoad::WithResidual(format) ? "with" : "without");
+  const std::string window =
+      StringUtils::Format("{} of {} pictures took more than the {:.1f} ms that a picture can take "
+                          "of the {:.1f} ms of a refresh ({:.1f} "
+                          "ms of GPU time on average); {} of {} refreshes missed",
+                          step.over, step.frames, step.budgetMs, step.periodMs, step.averageMs,
+                          step.lost, step.presented);
+  std::string known = "what the levels took:";
+  for (int level = 0; level < CDVStepDown::LEVELS; ++level)
+  {
+    if (!CDVStepDown::In(step.ladder, level))
+      continue;
+    const double ms = step.knownMs[static_cast<size_t>(level)];
+    known += ms > 0 ? StringUtils::Format(" {}: {:.1f} ms", level, ms)
+                    : StringUtils::Format(" {}: not measured", level);
+  }
+  const bool ccm = m_dvConvertBridge && m_dvConvertBridge->CCMComposer();
+  switch (step.why)
+  {
+    case Why::BEHIND:
+      CLog::Log(LOGINFO,
+                "DVBridge: Dolby Vision rebuilt for output as HDR10 or SDR does not keep up at "
+                "fidelity step-down "
+                "level {}: drawn at level {} from now on ({}; the enhancement layer is still "
+                "drawn) ({}; {}; {})",
+                step.from, step.to, DVStepWhat(step.to, ccm), which, window, known);
+      break;
+    case Why::NO_GAIN:
+      CLog::Log(LOGINFO,
+                "DVBridge: Dolby Vision rebuilt for output as HDR10 or SDR does not keep up at any "
+                "fidelity "
+                "step-down level, and none below level {} is measured to save time: drawn at level "
+                "{} ({}) from "
+                "now on ({}; {}; {})",
+                step.to, step.to, DVStepWhat(step.to, ccm), which, window, known);
+      break;
+    case Why::NOTHING_KEEPS_UP:
+      CLog::Log(LOGINFO,
+                "DVBridge: Dolby Vision rebuilt for output as HDR10 or SDR does not keep up at any "
+                "fidelity "
+                "step-down level: it stays at level {}, the fastest that was measured ({}; {}; {})",
+                step.to, which, window, known);
+      break;
+    case Why::FITS:
+      CLog::Log(LOGINFO,
+                "DVBridge: Dolby Vision rebuilt for output as HDR10 or SDR: level {} would take "
+                "{:.1f} ms now, "
+                "which fits the {:.1f} ms of a refresh with room to spare: drawn at level {} ({}) "
+                "from now on, "
+                "not {} ({}; {}; {})",
+                step.to, step.estimateMs, step.periodMs, step.to, DVStepWhat(step.to, ccm),
+                step.from, which, window, known);
+      break;
+    case Why::LADDER:
+      CLog::Log(LOGINFO,
+                "DVBridge: Dolby Vision rebuilt for output as HDR10 or SDR: {} have other levels "
+                "now; drawn at "
+                "level {} ({}), the level found for them, not {}",
+                which, step.to, DVStepWhat(step.to, ccm), step.from);
+      break;
+    default:
+      break;
+  }
+}
+
 void CWinSystemGbmGLESContext::DVStepReport(const CDVStepDown::Step& step,
                                             bool layered,
                                             uint64_t format)
