From 7b897cd648302ffc7dacef142fa78ff647054f42 Mon Sep 17 00:00:00 2001
From: Hades <15710513+hadesdevls@users.noreply.github.com>
Date: Thu, 26 Nov 2026 07:49:47 +0000
Subject: [PATCH] [Hades] \brief in ten comments where a backspace stood

Ten Doxygen comments of Hades had a backspace (0x08) in place of the
backslash of "\brief", in eight headers: DVDClock.h, DVPlaybackPolicy.h,
MultiviewPacker.h (two), BlurayOffsetMetadata.h, RenderManager.h,
OverlayRenderer.h, GraphicContext.h (two) and Lut3dGLES.h. Doxygen took
none of them for a brief, and a control byte has no place in a source
file. Comments only: no line of code changes.

(The one in PAPlayer.h comes with Kodi's source and stays as it is.)
---
 xbmc/cores/VideoPlayer/DVDClock.h                             | 2 +-
 xbmc/cores/VideoPlayer/DVDCodecs/Video/DVPlaybackPolicy.h     | 2 +-
 xbmc/cores/VideoPlayer/DVDCodecs/Video/MultiviewPacker.h      | 4 ++--
 xbmc/cores/VideoPlayer/DVDDemuxers/BlurayOffsetMetadata.h     | 2 +-
 xbmc/cores/VideoPlayer/VideoRenderers/OverlayRenderer.h       | 2 +-
 xbmc/cores/VideoPlayer/VideoRenderers/RenderManager.h         | 2 +-
 .../cores/VideoPlayer/VideoRenderers/VideoShaders/Lut3dGLES.h | 2 +-
 xbmc/windowing/GraphicContext.h                               | 4 ++--
 8 files changed, 10 insertions(+), 10 deletions(-)

diff --git a/xbmc/cores/VideoPlayer/DVDClock.h b/xbmc/cores/VideoPlayer/DVDClock.h
index de30ab4..aeda32a 100644
--- a/xbmc/cores/VideoPlayer/DVDClock.h
+++ b/xbmc/cores/VideoPlayer/DVDClock.h
@@ -54,7 +54,7 @@ public:
   void SetVsyncAdjust(double adjustment);
   double GetVsyncAdjust();
   /*!
-   * rief Hades: how far ahead of this clock with its vsync adjustment the sound plays, as the
+   * \brief Hades: how far ahead of this clock with its vsync adjustment the sound plays, as the
    *        audio engine last measured it (CAudioSinkAE), in DVD time; known: false while there is
    *        no such measurement (no sound, a stream that starts, flushed or paused)
    *
diff --git a/xbmc/cores/VideoPlayer/DVDCodecs/Video/DVPlaybackPolicy.h b/xbmc/cores/VideoPlayer/DVDCodecs/Video/DVPlaybackPolicy.h
index 766364b..cbb6010 100644
--- a/xbmc/cores/VideoPlayer/DVDCodecs/Video/DVPlaybackPolicy.h
+++ b/xbmc/cores/VideoPlayer/DVDCodecs/Video/DVPlaybackPolicy.h
@@ -539,7 +539,7 @@ constexpr bool NativeAllowed(OutputChoice choice)
 }
 
 /*!
- * rief Hades: whether a Dolby Vision stream of this profile may go out natively
+ * \brief Hades: whether a Dolby Vision stream of this profile may go out natively
  *
  * Not profile 20, Dolby Vision in MV-HEVC (the 3D films made for the Vision Pro, Apple's only
  * Dolby Vision for stereo video). Its base view with its RPU could go to a display in Dolby Vision
diff --git a/xbmc/cores/VideoPlayer/DVDCodecs/Video/MultiviewPacker.h b/xbmc/cores/VideoPlayer/DVDCodecs/Video/MultiviewPacker.h
index 93eca95..9a6605a 100644
--- a/xbmc/cores/VideoPlayer/DVDCodecs/Video/MultiviewPacker.h
+++ b/xbmc/cores/VideoPlayer/DVDCodecs/Video/MultiviewPacker.h
@@ -21,7 +21,7 @@ struct AVFrame;
 namespace KODI::MULTIVIEW
 {
 /*!
- * rief The decoder that outputs both views of a stream of this codec, where this build of
+ * \brief The decoder that outputs both views of a stream of this codec, where this build of
  *        FFmpeg has one: h264_mvc for H.264 (DECODER_NAME), FFmpeg's own HEVC decoder where it
  *        takes the option that asks for the views (HEVC_DECODER_NAME, DECODER_VIEWS_OPTION: FFmpeg
  *        7.1 and later); nothing for any other codec
@@ -100,7 +100,7 @@ public:
   void Fail(const char* reason);
 
   /*!
-   * rief A picture went out: how the playback kept up with it (KODI::MULTIVIEW::Paced()). Where
+   * \brief A picture went out: how the playback kept up with it (KODI::MULTIVIEW::Paced()). Where
    *        the processor is taken not to keep up, the second view is given up (GivenUp(), Slow())
    */
   void Paced(bool late, bool judged);
diff --git a/xbmc/cores/VideoPlayer/DVDDemuxers/BlurayOffsetMetadata.h b/xbmc/cores/VideoPlayer/DVDDemuxers/BlurayOffsetMetadata.h
index 81c2b90..071dd3a 100644
--- a/xbmc/cores/VideoPlayer/DVDDemuxers/BlurayOffsetMetadata.h
+++ b/xbmc/cores/VideoPlayer/DVDDemuxers/BlurayOffsetMetadata.h
@@ -103,7 +103,7 @@ public:
   std::optional<int> GetOffset(double pts, unsigned int sequence) const;
 
   /*!
-   * rief Hades: whether a block kept carries the sequence: the title places in depth what
+   * \brief Hades: whether a block kept carries the sequence: the title places in depth what
    *        follows it (CVideoPlayer::SubtitleDepthFromDisc()). A stream that follows a sequence
    *        no block carries is placed by nothing the title says.
    */
diff --git a/xbmc/cores/VideoPlayer/VideoRenderers/OverlayRenderer.h b/xbmc/cores/VideoPlayer/VideoRenderers/OverlayRenderer.h
index d3d29ce..f8c2e09 100644
--- a/xbmc/cores/VideoPlayer/VideoRenderers/OverlayRenderer.h
+++ b/xbmc/cores/VideoPlayer/VideoRenderers/OverlayRenderer.h
@@ -153,7 +153,7 @@ namespace OVERLAY {
     void SetSubtitlePlaneOffset(std::optional<int> offset) { m_subtitlePlaneOffset = offset; }
 
     /*!
-     * rief Hades: the depth the subtitles get where the disc gives them none, measured from the
+     * \brief Hades: the depth the subtitles get where the disc gives them none, measured from the
      *        picture (KODI::STEREODEPTH::CStereoDepthMeter): a crossed disparity, as a share of the
      *        width of the picture (more is nearer). Nothing leaves the setting in charge; the disc's
      *        offsets, where there are any, come first.
diff --git a/xbmc/cores/VideoPlayer/VideoRenderers/RenderManager.h b/xbmc/cores/VideoPlayer/VideoRenderers/RenderManager.h
index e40155b..4512dda 100644
--- a/xbmc/cores/VideoPlayer/VideoRenderers/RenderManager.h
+++ b/xbmc/cores/VideoPlayer/VideoRenderers/RenderManager.h
@@ -77,7 +77,7 @@ protected:
    */
   virtual std::optional<int> GetSubtitlePlaneOffset(double pts) { return std::nullopt; }
   /*!
-   * rief Hades: whether the subtitles being shown are placed in depth by the title (a Blu-ray 3D
+   * \brief Hades: whether the subtitles being shown are placed in depth by the title (a Blu-ray 3D
    *        that carries their offset sequence): then nothing else places them, also for a frame the
    *        title says nothing about (GetSubtitlePlaneOffset()), and the depth measured from the
    *        picture is not used for them.
diff --git a/xbmc/cores/VideoPlayer/VideoRenderers/VideoShaders/Lut3dGLES.h b/xbmc/cores/VideoPlayer/VideoRenderers/VideoShaders/Lut3dGLES.h
index 4031cfd..65b32d4 100644
--- a/xbmc/cores/VideoPlayer/VideoRenderers/VideoShaders/Lut3dGLES.h
+++ b/xbmc/cores/VideoPlayer/VideoRenderers/VideoShaders/Lut3dGLES.h
@@ -53,7 +53,7 @@ public:
   bool Begin(int width, int height, std::string& why);
   bool Put(const float* rgb, int x, int y, int width, int height, std::string& why);
   /*!
-   * rief Hades: the 1D LUT applied before the table, where the LUT has one (dvbridge_lut_atlas: curve_*): its points
+   * \brief Hades: the 1D LUT applied before the table, where the LUT has one (dvbridge_lut_atlas: curve_*): its points
    *        (size of them, 3 floats each, one after the other) put on the GPU at once, in rows of width texels
    *        (height of them, the last filled as far as they go), after Begin(); false and why where the GPU does not take
    *        it (no texture is then kept, the table's neither). A shader made with it applies it (gles_lut3d_curve.frag).
diff --git a/xbmc/windowing/GraphicContext.h b/xbmc/windowing/GraphicContext.h
index da69d4c..30db565 100644
--- a/xbmc/windowing/GraphicContext.h
+++ b/xbmc/windowing/GraphicContext.h
@@ -180,14 +180,14 @@ public:
   void RestoreStereoFactor();
 
   /*!
-   * rief Hades: the depth of the interface drawn over a 3D video in full screen: a shift of each
+   * \brief Hades: the depth of the interface drawn over a 3D video in full screen: a shift of each
    *        eye's picture of it, in pixels of the screen, added to the depth the skin gives each
    *        control. Set once a frame by the render manager (KODI::STEREODEPTH::CStereoDepthMeter),
    *        0 where nothing is measured.
    */
   void SetGuiDepthOverVideo(float pixels) { m_guiDepthOverVideo = pixels; }
   /*!
-   * rief Hades: whether what is drawn from now on is over the video (the controls of the
+   * \brief Hades: whether what is drawn from now on is over the video (the controls of the
    *        full-screen video window, after the video and its subtitles, and the dialogs over it):
    *        it then takes SetGuiDepthOverVideo(). Off at each SetStereoView(), and while the video
    *        and its subtitles are drawn (CGUIWindowFullScreen::Render()).
-- 
