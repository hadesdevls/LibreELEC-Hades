 /* Hades: the tiles of what is drawn over, on unit 3, and how a pass takes them (tiles_mode) */
 static void set_tiles(struct dvbridge_source_packer *p, GLint tiles, GLint mode, int how)
 {
diff --git a/tools/dvbridge/dvbridge_source.h b/tools/dvbridge/dvbridge_source.h
index 1755ab2..3d210f8 100644
--- a/tools/dvbridge/dvbridge_source.h
+++ b/tools/dvbridge/dvbridge_source.h
@@ -349,8 +349,19 @@ bool dvbridge_source_can_ipt(const struct dvbridge_source_packer *packer);
 void dvbridge_source_compute_rows(struct dvbridge_source_packer *packer, bool use);
 bool dvbridge_source_compute_rows_usable(const struct dvbridge_source_packer *packer);
 bool dvbridge_source_rows_computed(const struct dvbridge_source_packer *packer);
+/* Hades: use (above) asks for the compute form of dvbridge_source_to_ipt() as well: one pass where
+ * each invocation takes the chain of each pixel of two pairs once (the even pixel gives its I and its
+ * pair's P and T), where the fragment passes take that of the even pixel twice; the same functions
+ * on the same codes (a float rounding apart where the GPU fuses operations otherwise: within one
+ * code, measured as close to the chain in double precision). Where the GL does not make it (OpenGL
+ * ES 3.1), or it fails on the GPU (it is then not tried again), the fragment passes. usable: it was
+ * made and has not failed; computed: the codes of the rows in use (dvbridge_source_to_ipt()) were
+ * made by it. */
+#define DVBRIDGE_SOURCE_COMPUTE_IPT 1
+bool dvbridge_source_ipt_compute_usable(const struct dvbridge_source_packer *packer);
+bool dvbridge_source_ipt_computed(const struct dvbridge_source_packer *packer);
 /* Hades: after dvbridge_source_rows() or dvbridge_source_scale() of a picture of src, its codes in
- * IPT-PQ-c2, 12 bits, in two passes: the chroma of every pixel (between the pairs, Lanczos 6 in
+ * IPT-PQ-c2, 12 bits, in two fragment passes or one compute pass (above): the chroma of every pixel (between the pairs, Lanczos 6 in
  * integers, the filter of the rows, DVBRIDGE_SOURCE_LANCZOS), its codes through YCCtoRGB of the RPU,
