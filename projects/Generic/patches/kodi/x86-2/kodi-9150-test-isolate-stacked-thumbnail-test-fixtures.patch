From cca34e05e4de67c53a0b2e1ccd7c860e72e6d25b Mon Sep 17 00:00:00 2001
From: Garrett Brown <themagnificentmrb@gmail.com>
Date: Wed, 11 Nov 2026 14:52:06 -0800
Subject: [PATCH] [test] Isolate stacked thumbnail test fixtures

Concurrent test processes can delete the shared foo-cd1.tbn before lookup.
Allocate an owned root with a fixed child directory and remove it on
scope exit.

AI-implementation: gpt-6-astra (xhigh)
AI-review: gpt-6-astra (xhigh)
(cherry picked from commit f07b32a9c38367df1d7e7425ba00cdbdd5d88612)
---
 xbmc/utils/test/TestArtUtils.cpp | 10 +++++++---
 1 file changed, 7 insertions(+), 3 deletions(-)

diff --git a/xbmc/utils/test/TestArtUtils.cpp b/xbmc/utils/test/TestArtUtils.cpp
index f922557..354718c 100644
--- a/xbmc/utils/test/TestArtUtils.cpp
+++ b/xbmc/utils/test/TestArtUtils.cpp
@@ -15,7 +15,7 @@
 #include "settings/Settings.h"
 #include "settings/SettingsComponent.h"
 #include "utils/ArtUtils.h"
-#include "utils/FileUtils.h"
+#include "utils/ScopeGuard.h"
 #include "utils/StringUtils.h"
 #include "utils/URIUtils.h"
 #include "video/VideoInfoTag.h"
@@ -1202,16 +1202,20 @@ INSTANTIATE_TEST_SUITE_P(TestArtUtils, GetTbnTest, testing::ValuesIn(tbn_tests))
 TEST(TestArtUtils, GetTbnStack)
 {
   std::error_code ec;
-  auto path = KODI::PLATFORM::FILESYSTEM::temp_directory_path(ec);
+  const auto root = KODI::PLATFORM::FILESYSTEM::create_temp_directory(ec);
   ASSERT_TRUE(!ec);
+  const UTILS::CScopeGuard<const std::string*, nullptr, void(const std::string*)> cleanup(
+      [](const std::string* path) { XFILE::CDirectory::RemoveRecursive(*path); }, &root);
+  const auto path = URIUtils::AddFileToFolder(root, "tbn_test");
+  ASSERT_TRUE(XFILE::CDirectory::Create(path));
   const auto file_path = URIUtils::AddFileToFolder(path, "foo-cd1.tbn");
   {
     std::ofstream of(file_path, std::ios::out);
+    ASSERT_TRUE(of.is_open());
   }
   const std::string stackPath =
       fmt::format("stack://{} , {}", URIUtils::AddFileToFolder(path, "foo-cd1.avi"),
                   URIUtils::AddFileToFolder(path, "foo-cd2.avi"));
   CFileItem item(stackPath, false);
   EXPECT_EQ(ART::GetTBNFile(item), file_path);
-  CFileUtils::DeleteItem(file_path);
 }
