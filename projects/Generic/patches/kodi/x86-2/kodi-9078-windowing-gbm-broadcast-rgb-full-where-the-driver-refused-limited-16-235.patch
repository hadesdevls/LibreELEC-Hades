From 0efa120cdb86c1b2b3605c723a5af823fcff61a0 Mon Sep 17 00:00:00 2001
From: Hades <15710513+hadesdevls@users.noreply.github.com>
Date: Wed, 18 Nov 2026 06:25:33 +0000
Subject: [PATCH] windowing/gbm: Broadcast RGB "Full" where the driver refused
 "Limited 16:235"

With "Use limited colour range" on, Hades asks the driver for Broadcast RGB
"Limited 16:235" and draws full range once the kernel has it, so that the
range is compressed once. Where the driver refused that value twice, Hades
stopped asking and Kodi compressed its picture to 16-235 itself with the
property as the kernel had it, "Automatic" in practice: i915 and xe compress
every TV mode of an HDMI sink in RGB at "Automatic", and amdgpu those of a
display that cannot select the range, so the picture was compressed twice
there (raised blacks, dull whites: what the setting is turned on to avoid).

Now, with the setting on, a refused "Limited 16:235" is followed by "Full"
in its place: the driver sends Kodi's 16-235 as it is, and the range is
compressed once, by Kodi. A display that cannot select the range takes a
TV mode as limited, as it should. One that can is told full range then,
and shows Kodi's 16-235 with raised blacks unless its black level is set to
limited, which is what it showed before too (a picture compressed twice,
told limited range). On nvidia-drm "Full" is what "Automatic" is.

"Full" has a count of refusals of its own (CRgbRange::Requests): where the
driver refuses it too, or has no "Full", Kodi compresses as before with
the property as the kernel has it, and the log says so (fail closed). A
"Full" taken does not reset the refusals of "Limited 16:235", so that this
is not asked again with a mode set of its own each time. With the setting
off, Kodi's own "Full" goes back to "Automatic" as its "Limited 16:235"
does; a "Full" that Kodi did not ask for stays. The end of native Dolby
Vision gives the property what the setting asks for in the same way
(AtHandBack()). Native Dolby Vision itself is not touched: its transport
sets "Full", and nothing of the range is asked while it has the output.

kodi.log says each decision ("RGB range: ..."): a refusal, "Full" asked in
place of "Limited 16:235", the fail-closed case, and, once for each mode,
the property, its value and who compresses the range.

TestRgbRange.cpp runs CRgbRange on the host as CWinSystemGbm drives it,
with i915's rule at "Automatic": the picture compressed once where the
driver refuses "Limited 16:235", no loop of mode sets, the fail-closed
case, the setting off, native Dolby Vision and its end.
---
 xbmc/windowing/gbm/RgbRange.h        | 145 ++++++++++++---
 xbmc/windowing/gbm/WinSystemGbm.cpp  | 122 +++++++++----
 xbmc/windowing/gbm/WinSystemGbm.h    |   4 +-
 xbmc/windowing/test/CMakeLists.txt   |   3 +-
 xbmc/windowing/test/TestRgbRange.cpp | 254 +++++++++++++++++++++++++++
 5 files changed, 461 insertions(+), 67 deletions(-)
 create mode 100644 xbmc/windowing/test/TestRgbRange.cpp

diff --git a/xbmc/windowing/gbm/RgbRange.h b/xbmc/windowing/gbm/RgbRange.h
index 7cb2db0..89da7d0 100644
--- a/xbmc/windowing/gbm/RgbRange.h
+++ b/xbmc/windowing/gbm/RgbRange.h
@@ -41,16 +41,30 @@ namespace GBM
  * compresses everything on the output once (planes, cursor, the console after Kodi), and its AVI
  * InfoFrame says limited range where the sink can be told. With the setting off the property is
  * not touched (today's output), but where Kodi itself left it at "Limited 16:235" (the setting
- * was on): it goes back to "Automatic". A change of it needs a mode set (i915 makes one of it,
- * intel_digital_connector_atomic_check()): it goes in a commit that allows one, never while a video
- * plays unless the video makes one anyway, and never in a commit whose request has the property
- * already (native Dolby Vision, whose transport sets "Full" and puts back what it found; the
- * clean-up of a session that ended with it). A commit with it that the driver refuses is asked
- * again with the next mode set, REFUSALS times: then Kodi makes the range itself on that output,
- * as before (fail closed). nvidia-drm has the property with Hades' drivers (nvidia-open-kernel-modules-9056,
- * nvidia-legacy-open-9067: "Limited 16:235" makes NVKMS compress the range of the head and say so in the AVI
- * InfoFrame; never with the Dolby VSIF, whatever the property says); a driver without it: Kodi makes the
- * range there, as before.
+ * was on), or at its "Full" (below): it goes back to "Automatic". A change of it needs a mode set
+ * (i915 makes one of it, intel_digital_connector_atomic_check()): it goes in a commit that allows
+ * one, never while a video plays unless the video makes one anyway, and never in a commit whose
+ * request has the property already (native Dolby Vision, whose transport sets "Full" and puts back
+ * what it found; the clean-up of a session that ended with it). A commit with it that the driver
+ * refuses is asked again with the next mode set, REFUSALS times (Requests).
+ *
+ * Where the driver refused "Limited 16:235" REFUSALS times, Kodi compresses the range itself, and
+ * with the setting on it asks for "Full" in its place: at "Automatic" the driver would compress
+ * Kodi's 16-235 again (i915 and xe at every TV mode, amdgpu at those of a display without QS: the
+ * raised blacks the setting was turned on to avoid), while at "Full" it sends the picture as Kodi
+ * draws it, so that the range is compressed once, by Kodi. A display that cannot select the range
+ * takes a TV mode as limited, as it should; one that can is told full range then, and shows Kodi's
+ * 16-235 so unless its black level is set to limited, which is what it showed at "Automatic" too
+ * (nvidia-drm: "Full" is "Automatic", full range). "Full" has REFUSALS of its own: where the driver
+ * refuses it too, or has no "Full", Kodi makes the range itself on that output with the property as
+ * the kernel has it, as before (fail closed, said in the log).
+ *
+ * nvidia-drm has the property with Hades' drivers (nvidia-open-kernel-modules-9056,
+ * nvidia-legacy-open-9067: "Limited 16:235" makes NVKMS compress the range of the head and say so in
+ * the AVI InfoFrame; never with the Dolby VSIF, whatever the property says); a driver without it:
+ * Kodi makes the range there, as before.
+ *
+ * Nothing of DRM is here: a test runs it on the host (TestRgbRange.cpp).
  */
 class CRgbRange
 {
@@ -59,23 +73,54 @@ public:
   static constexpr const char* AUTOMATIC = "Automatic";
   static constexpr const char* FULL = "Full";
   static constexpr const char* LIMITED = "Limited 16:235";
-  //! commits refused with the property in them before Kodi makes the range itself on an output
+  //! commits refused with a value in them before Kodi gives that value up on an output
   static constexpr unsigned int REFUSALS = 2;
 
   //! What the connector offers, and the value the kernel has (the last commit)
   struct Connector
   {
     std::optional<uint64_t> automatic; //!< the value of "Automatic", where the property has it
+    std::optional<uint64_t> full; //!< ... of "Full"
     std::optional<uint64_t> limited; //!< ... of "Limited 16:235"
     std::optional<uint64_t> kernel; //!< the value of the property, where the connector has it
   };
 
+  //! What came of Kodi's requests on an output, from one change of the setting (or of the output)
+  //! to the next
+  struct Requests
+  {
+    //! commits refused with "Limited 16:235" (the setting on), or with Kodi's own value taken back
+    //! to "Automatic" (the setting off)
+    unsigned int refused = 0;
+    //! commits refused with "Full", asked in place of "Limited 16:235"
+    unsigned int fullRefused = 0;
+    //! the kernel has "Full" because Kodi asked for it in place of "Limited 16:235" (it is taken
+    //! back with the setting off, as Kodi's "Limited 16:235" is)
+    bool ownFull = false;
+
+    bool GivenUp() const { return refused >= REFUSALS; }
+    bool FullGivenUp() const { return fullRefused >= REFUSALS; }
+    //! the setting changed: what it asks for is asked again, whatever the other one met
+    void NewSetting()
+    {
+      refused = 0;
+      fullRefused = 0;
+    }
+  };
+
   //! The driver compresses the range of the RGB output: the kernel has "Limited 16:235"
   static bool KernelLimits(const Connector& connector)
   {
     return connector.limited && connector.kernel && *connector.kernel == *connector.limited;
   }
 
+  //! The kernel has "Full", and Kodi asked for it in place of "Limited 16:235"
+  static bool KernelHasOwnFull(const Connector& connector, const Requests& requests)
+  {
+    return requests.ownFull && connector.full && connector.kernel &&
+           *connector.kernel == *connector.full;
+  }
+
   //! Kodi draws in 16-235 (UseLimitedColor()): its setting asks for limited range, and the driver
   //! does not make it on this output
   static bool KodiCompresses(bool setting, const Connector& connector)
@@ -84,14 +129,27 @@ public:
   }
 
   //! The value that the property should have (nothing: it is left as the kernel has it)
-  static std::optional<uint64_t> Wanted(bool setting, const Connector& connector)
+  static std::optional<uint64_t> Wanted(bool setting,
+                                        const Connector& connector,
+                                        const Requests& requests)
   {
     if (!connector.kernel || !connector.limited || !connector.automatic)
       return std::nullopt;
     if (setting)
-      return *connector.limited;
-    // (with the setting off, only Kodi's own value is taken back: "Automatic" and "Full" stay)
-    if (*connector.kernel == *connector.limited)
+    {
+      if (!requests.GivenUp())
+        return *connector.limited;
+      // the driver refused "Limited 16:235": "Full", so that what Kodi compresses is not compressed
+      // again (nothing where the driver refused that too, or has no "Full")
+      if (connector.full && !requests.FullGivenUp())
+        return *connector.full;
+      return std::nullopt;
+    }
+    // (with the setting off, only Kodi's own values are taken back: "Automatic" and a "Full" that
+    // Kodi did not ask for stay)
+    if (requests.GivenUp())
+      return std::nullopt;
+    if (*connector.kernel == *connector.limited || KernelHasOwnFull(connector, requests))
       return *connector.automatic;
     return std::nullopt;
   }
@@ -100,13 +158,13 @@ public:
    * \brief Hades: what native Dolby Vision gives the property when it ends, by the setting that the
    *        user has now (they may have changed it meanwhile): what Wanted() says for the value that
    *        the end puts back (connector.kernel is that value: what was found). Nothing: it goes
-   *        back as found (the setting agrees, or the driver refused it REFUSALS times: givenUp).
+   *        back as found (the setting agrees, or the driver refused what it asks REFUSALS times).
    */
-  static std::optional<uint64_t> AtHandBack(bool setting, const Connector& connector, bool givenUp)
+  static std::optional<uint64_t> AtHandBack(bool setting,
+                                            const Connector& connector,
+                                            const Requests& requests)
   {
-    if (givenUp)
-      return std::nullopt;
-    const auto want = Wanted(setting, connector);
+    const auto want = Wanted(setting, connector, requests);
     if (!want || (connector.kernel && *want == *connector.kernel))
       return std::nullopt;
     return want;
@@ -119,21 +177,21 @@ public:
   };
 
   /*!
-   * \brief What the request of this commit carries: givenUp, the driver refused it REFUSALS times
-   *        on this output; transport, native Dolby Vision has the output; inRequest, the request
-   *        has the property already; modesetPending, the commit allows a mode set already;
-   *        videoPlays, a video plays (no mode set is made for it then)
+   * \brief What the request of this commit carries: requests, what came of Kodi's requests on this
+   *        output; transport, native Dolby Vision has the output; inRequest, the request has the
+   *        property already; modesetPending, the commit allows a mode set already; videoPlays, a
+   *        video plays (no mode set is made for it then)
    */
   static Step Stage(bool setting,
                     const Connector& connector,
-                    bool givenUp,
+                    const Requests& requests,
                     bool transport,
                     bool inRequest,
                     bool modesetPending,
                     bool videoPlays)
   {
-    const auto want = Wanted(setting, connector);
-    if (!want || *want == *connector.kernel || givenUp || transport || inRequest)
+    const auto want = Wanted(setting, connector, requests);
+    if (!want || *want == *connector.kernel || transport || inRequest)
       return {};
     if (!modesetPending && videoPlays)
       return {};
@@ -171,6 +229,39 @@ public:
       return Outcome::TAKEN;
     return refused ? Outcome::REFUSED : Outcome::PENDING;
   }
+
+  /*!
+   * \brief Hades: what came of a commit (outcome, for staged; connector as the kernel has it
+   *        after it) counted in requests. "Full" taken leaves the refusals of "Limited 16:235" as
+   *        they are: asking for it again would set a mode for every try.
+   */
+  static void Count(Outcome outcome,
+                    std::optional<uint64_t> staged,
+                    const Connector& connector,
+                    Requests& requests)
+  {
+    const bool full = staged && connector.full && *staged == *connector.full;
+    if (outcome == Outcome::TAKEN)
+    {
+      if (full)
+      {
+        requests.fullRefused = 0;
+        requests.ownFull = true;
+      }
+      else
+        requests.refused = 0;
+    }
+    else if (outcome == Outcome::REFUSED)
+    {
+      if (full)
+        ++requests.fullRefused;
+      else
+        ++requests.refused;
+    }
+    // a "Full" that the kernel no longer has is no longer Kodi's
+    if (!connector.full || !connector.kernel || *connector.kernel != *connector.full)
+      requests.ownFull = false;
+  }
 };
 
 } // namespace GBM
