+
+#include "windowing/gbm/RgbRange.h"
+
+#include <algorithm>
+#include <cstdint>
+#include <optional>
+#include <vector>
+
+#include <gtest/gtest.h>
+
+using KODI::WINDOWING::GBM::CRgbRange;
+
+namespace
+{
+// The values of "Broadcast RGB" as i915 has them (enum intel_broadcast_rgb)
+constexpr uint64_t AUTOMATIC = 0;
+constexpr uint64_t FULL = 1;
+constexpr uint64_t LIMITED = 2;
+
+/*!
+ * An HDMI output of i915 at a TV mode, as CWinSystemGbm drives CRgbRange: UseLimitedColor() for the
+ * frame that is drawn, then FlipPage() (StageRgbRange(), the commit, RgbRangeCommitted())
+ */
+struct Output
+{
+  CRgbRange::Connector connector{AUTOMATIC, FULL, LIMITED, AUTOMATIC};
+  CRgbRange::Requests requests;
+  std::optional<bool> settingBefore; //!< m_rgbRangeSetting
+  std::vector<uint64_t> refused; //!< the driver refuses a commit that sets one of these
+  bool videoPlays = false;
+  int modeSets = 0; //!< the mode sets that Kodi made of its own for the property
+
+  //! UseLimitedColor()
+  bool KodiCompresses(bool setting) const { return CRgbRange::KodiCompresses(setting, connector); }
+
+  //! FlipPage() of one frame
+  void Flip(bool setting)
+  {
+    // StageRgbRange()
+    if (settingBefore != setting)
+    {
+      settingBefore = setting;
+      requests.NewSetting();
+    }
+    const CRgbRange::Step step =
+        CRgbRange::Stage(setting, connector, requests, false, false, false, videoPlays);
+    // the commit
+    bool refusedNow = false;
+    if (step.value)
+    {
+      if (step.allowModeset)
+        ++modeSets;
+      if (std::find(refused.begin(), refused.end(), *step.value) != refused.end())
+        refusedNow = true;
+      else
+        connector.kernel = *step.value;
+    }
+    // RgbRangeCommitted()
+    const auto outcome = CRgbRange::AfterCommit(step.value, connector.kernel, refusedNow);
+    CRgbRange::Count(outcome, step.value, connector, requests);
+  }
+
+  void Frames(bool setting, int count)
+  {
+    for (int i = 0; i < count; ++i)
+      Flip(setting);
+  }
+
+  //! i915 compresses an RGB output at a TV mode with "Limited 16:235", and at "Automatic"
+  //! (intel_hdmi_limited_color_range())
+  bool DriverCompresses() const
+  {
+    return connector.kernel == LIMITED || connector.kernel == AUTOMATIC;
+  }
+
+  //! How many times the picture of the next frame is compressed to 16-235
+  int Compressions(bool setting) const
+  {
+    return (KodiCompresses(setting) ? 1 : 0) + (DriverCompresses() ? 1 : 0);
+  }
+};
+} // namespace
+
+TEST(TestRgbRange, TheDriverMakesTheLimitedRangeOnce)
+{
+  Output out;
+  out.Frames(true, 3);
+  EXPECT_EQ(out.connector.kernel, LIMITED);
+  EXPECT_FALSE(out.KodiCompresses(true));
+  EXPECT_EQ(out.Compressions(true), 1);
+  EXPECT_EQ(out.modeSets, 1);
+}
+
+// Issue #79 of another build, as Hades had it after REFUSALS refusals: Kodi compressed, and i915 at
+// "Automatic" compressed every TV mode again
+TEST(TestRgbRange, RefusedLimitedAsksForFullAndTheRangeIsCompressedOnce)
+{
+  Output out;
+  out.refused = {LIMITED};
+  out.Frames(true, 10);
+  EXPECT_TRUE(out.requests.GivenUp());
+  EXPECT_EQ(out.connector.kernel, FULL);
+  EXPECT_TRUE(out.requests.ownFull);
+  EXPECT_TRUE(out.KodiCompresses(true));
+  EXPECT_EQ(out.Compressions(true), 1);
+}
+
+TEST(TestRgbRange, FullTakenDoesNotAskForLimitedAgain)
+{
+  Output out;
+  out.refused = {LIMITED};
+  out.Frames(true, 10);
+  const int modeSets = out.modeSets;
+  // two refused, then "Full": three mode sets of Kodi's own, and none after
+  EXPECT_EQ(modeSets, 3);
+  out.Frames(true, 50);
+  EXPECT_EQ(out.modeSets, modeSets);
+  EXPECT_EQ(out.connector.kernel, FULL);
+}
+
+TEST(TestRgbRange, RefusedFullTooKodiCompressesAsBefore)
+{
+  Output out;
+  out.refused = {LIMITED, FULL};
+  out.Frames(true, 20);
+  EXPECT_TRUE(out.requests.GivenUp());
+  EXPECT_TRUE(out.requests.FullGivenUp());
+  EXPECT_EQ(out.modeSets, 4);
+  EXPECT_EQ(out.connector.kernel, AUTOMATIC);
+  // fail closed: Kodi makes the range itself, as before, and nothing more is asked
+  EXPECT_TRUE(out.KodiCompresses(true));
+  EXPECT_FALSE(
+      CRgbRange::Stage(true, out.connector, out.requests, false, false, false, false).value);
+}
+
+TEST(TestRgbRange, NoFullValueGivesUpAsBefore)
+{
+  Output out;
+  out.connector.full.reset();
+  out.refused = {LIMITED};
+  out.Frames(true, 10);
+  EXPECT_EQ(out.modeSets, 2);
+  EXPECT_EQ(out.connector.kernel, AUTOMATIC);
+  EXPECT_TRUE(out.KodiCompresses(true));
+}
+
+TEST(TestRgbRange, ARefusalOfFullIsNotOneOfLimited)
+{
+  CRgbRange::Connector connector{AUTOMATIC, FULL, LIMITED, AUTOMATIC};
+  CRgbRange::Requests requests;
+  CRgbRange::Count(CRgbRange::Outcome::REFUSED, FULL, connector, requests);
+  EXPECT_EQ(requests.refused, 0u);
+  EXPECT_EQ(requests.fullRefused, 1u);
+  CRgbRange::Count(CRgbRange::Outcome::REFUSED, LIMITED, connector, requests);
+  EXPECT_EQ(requests.refused, 1u);
+  EXPECT_EQ(requests.fullRefused, 1u);
+  requests.NewSetting();
+  EXPECT_EQ(requests.refused, 0u);
+  EXPECT_EQ(requests.fullRefused, 0u);
+}
+
+TEST(TestRgbRange, SettingOffTakesKodisFullBack)
+{
+  Output out;
+  out.refused = {LIMITED};
+  out.Frames(true, 10);
+  ASSERT_EQ(out.connector.kernel, FULL);
+  out.Frames(false, 3);
+  EXPECT_EQ(out.connector.kernel, AUTOMATIC);
+  EXPECT_FALSE(out.requests.ownFull);
+  EXPECT_FALSE(out.KodiCompresses(false));
+}
+
+TEST(TestRgbRange, SettingOffLeavesAFullKodiDidNotAskFor)
+{
+  Output out;
+  out.connector.kernel = FULL;
+  out.Frames(false, 3);
+  EXPECT_EQ(out.connector.kernel, FULL);
+  EXPECT_EQ(out.modeSets, 0);
+}
+
+TEST(TestRgbRange, SettingOffTakesKodisLimitedBack)
+{
+  Output out;
+  out.Frames(true, 2);
+  ASSERT_EQ(out.connector.kernel, LIMITED);
+  out.Frames(false, 2);
+  EXPECT_EQ(out.connector.kernel, AUTOMATIC);
+  EXPECT_FALSE(out.KodiCompresses(false));
+}
+
+TEST(TestRgbRange, KodiCompressesWhereTheKernelDoesNot)
+{
+  EXPECT_TRUE(CRgbRange::KodiCompresses(true, {AUTOMATIC, FULL, LIMITED, FULL}));
+  EXPECT_TRUE(CRgbRange::KodiCompresses(true, {AUTOMATIC, FULL, LIMITED, AUTOMATIC}));
+  EXPECT_FALSE(CRgbRange::KodiCompresses(true, {AUTOMATIC, FULL, LIMITED, LIMITED}));
+  EXPECT_FALSE(CRgbRange::KodiCompresses(false, {AUTOMATIC, FULL, LIMITED, FULL}));
+}
+
+// Native Dolby Vision: its transport sets "Full" (TransportSpecs.h), so that the tunnel goes out as
+// its bytes are; nothing of the range is asked while it has the output, whatever came before
+TEST(TestRgbRange, NativeDolbyVisionKeepsItsFull)
+{
+  const CRgbRange::Connector transport{AUTOMATIC, FULL, LIMITED, FULL};
+  for (const bool setting : {false, true})
+    for (const unsigned int refused : {0u, CRgbRange::REFUSALS})
+      for (const unsigned int fullRefused : {0u, CRgbRange::REFUSALS})
+        for (const bool ownFull : {false, true})
+          for (const bool pending : {false, true})
+          {
+            CRgbRange::Requests requests;
+            requests.refused = refused;
+            requests.fullRefused = fullRefused;
+            requests.ownFull = ownFull;
+            EXPECT_FALSE(
+                CRgbRange::Stage(setting, transport, requests, true, false, pending, true).value);
+            EXPECT_FALSE(
+                CRgbRange::Stage(setting, transport, requests, true, false, pending, false).value);
+          }
+}
+
+TEST(TestRgbRange, TheEndOfDolbyVisionGivesTheRangeOfTheSettingNow)
+{
+  CRgbRange::Requests fresh;
+  CRgbRange::Requests limitedRefused;
+  limitedRefused.refused = CRgbRange::REFUSALS;
+  CRgbRange::Requests bothRefused = limitedRefused;
+  bothRefused.fullRefused = CRgbRange::REFUSALS;
+  CRgbRange::Requests ownFull = limitedRefused;
+  ownFull.ownFull = true;
+  const CRgbRange::Connector foundAutomatic{AUTOMATIC, FULL, LIMITED, AUTOMATIC};
+  const CRgbRange::Connector foundFull{AUTOMATIC, FULL, LIMITED, FULL};
+  const CRgbRange::Connector foundLimited{AUTOMATIC, FULL, LIMITED, LIMITED};
+
+  EXPECT_EQ(CRgbRange::AtHandBack(true, foundAutomatic, fresh), LIMITED);
+  EXPECT_EQ(CRgbRange::AtHandBack(true, foundAutomatic, limitedRefused), FULL);
+  EXPECT_FALSE(CRgbRange::AtHandBack(true, foundAutomatic, bothRefused));
+  EXPECT_FALSE(CRgbRange::AtHandBack(true, foundFull, ownFull));
+  EXPECT_FALSE(CRgbRange::AtHandBack(true, foundLimited, fresh));
+  EXPECT_FALSE(CRgbRange::AtHandBack(false, foundAutomatic, fresh));
+  EXPECT_EQ(CRgbRange::AtHandBack(false, foundLimited, fresh), AUTOMATIC);
+  CRgbRange::Requests ownFullSettingOff;
+  ownFullSettingOff.ownFull = true;
+  EXPECT_EQ(CRgbRange::AtHandBack(false, foundFull, ownFullSettingOff), AUTOMATIC);
+  EXPECT_FALSE(CRgbRange::AtHandBack(false, foundFull, fresh));
+}
