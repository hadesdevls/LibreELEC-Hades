From 8cd3eb8f7b9028c07c7eabd4b1cfe692e11a50aa Mon Sep 17 00:00:00 2001
From: Garrett Brown <themagnificentmrb@gmail.com>
Date: Wed, 11 Nov 2026 20:21:35 -0800
Subject: [PATCH] [GLES] Sample HDR GUI LUTs at texel centers

Map LUT inputs to the centers of the 256 entries generated at i/255.
This removes the sampling offset that darkens HDR GUI colors.

[Hades: where fragment shaders have highp (every OpenGL ES 3 GPU), Hades
converts the GUI without the LUTs (KODI_GUI_EXACT), and that path is
unchanged. The LUTs stay, now sampled at the centres of their texels,
only where fragment shaders have no highp: the change goes into the
also 256 entries at i/255 (LUT_SIZE, GenerateDegammaLUT(),
GeneratePQLUT()).]
(cherry picked from commit 26090b9263d654977c09cda5aea45f12988d2e4a)
---
 .../shaders/GLES/2.0/gles_gui_composite.frag  | 19 +++++++++++--------
 1 file changed, 11 insertions(+), 8 deletions(-)

diff --git a/system/shaders/GLES/2.0/gles_gui_composite.frag b/system/shaders/GLES/2.0/gles_gui_composite.frag
index b8e38b7..7c98855 100644
--- a/system/shaders/GLES/2.0/gles_gui_composite.frag
+++ b/system/shaders/GLES/2.0/gles_gui_composite.frag
@@ -14,7 +14,8 @@
 // the PQ or HLG signal of that light, all in highp. The LUTs of 256
 // entries, linear in light and sampled off the centres of their texels, darkened the dark tones of the
 // GUI by up to a third of the PQ range (a grey of sRGB code 13 at 12-bit luma 494 where it is 746,
-// code 1 black), and the more the brighter the GUI white. Without highp the LUTs stay, as before.
+// code 1 black), and the more the brighter the GUI white. Without highp the LUTs stay, as before, now
+// sampled at the centres of their texels.
 #if defined(GL_FRAGMENT_PRECISION_HIGH)
 #define KODI_GUI_EXACT 1
 precision highp float;
@@ -25,7 +26,7 @@ uniform sampler2D u_samp;       // GUI FBO texture (sRGB, rendered by GUI shader
 #endif
 varying vec2 v_tex;
 uniform sampler2D u_lutDegamma; // GUI -> linear LUT (Hades: by the GUI's tone curve, as u_guiGamma)
-uniform sampler2D u_lutTF;      // linear -> PQ LUT (1024 entries, sdrPeak baked in)
+uniform sampler2D u_lutTF;      // linear -> PQ LUT (256 entries, sdrPeak baked in)
 uniform float u_ootfGamma;      // HLG: OOTF gamma (1.2 for BT.2100 1000-nit ref)
                                 // PQ: 0.0 (use LUT path instead)
 #if defined(KODI_GUI_EXACT)
@@ -117,10 +118,11 @@ void main()
     linear *= u_hlgWhite;
 #else
   // GUI -> linear via LUT (Hades: its tone curve, replaces inline pow)
+  vec3 lutCoord = (clamp(gui.rgb, 0.0, 1.0) * 255.0 + 0.5) / 256.0;
   vec3 linear = vec3(
-    texture2D(u_lutDegamma, vec2(gui.r, 0.5)).r,
-    texture2D(u_lutDegamma, vec2(gui.g, 0.5)).r,
-    texture2D(u_lutDegamma, vec2(gui.b, 0.5)).r
+    texture2D(u_lutDegamma, vec2(lutCoord.r, 0.5)).r,
+    texture2D(u_lutDegamma, vec2(lutCoord.g, 0.5)).r,
+    texture2D(u_lutDegamma, vec2(lutCoord.b, 0.5)).r
   );
 #endif
 
@@ -158,10 +160,11 @@ void main()
     result = forwardPQ(linear * u_pqPeak);
 #else
     // PQ path: LUT lookup (sdrPeak baked into LUT range)
+    lutCoord = (clamp(linear, 0.0, 1.0) * 255.0 + 0.5) / 256.0;
     result = vec3(
-      texture2D(u_lutTF, vec2(linear.r, 0.5)).r,
-      texture2D(u_lutTF, vec2(linear.g, 0.5)).r,
-      texture2D(u_lutTF, vec2(linear.b, 0.5)).r
+      texture2D(u_lutTF, vec2(lutCoord.r, 0.5)).r,
+      texture2D(u_lutTF, vec2(lutCoord.g, 0.5)).r,
+      texture2D(u_lutTF, vec2(lutCoord.b, 0.5)).r
     );
 #endif
   }
