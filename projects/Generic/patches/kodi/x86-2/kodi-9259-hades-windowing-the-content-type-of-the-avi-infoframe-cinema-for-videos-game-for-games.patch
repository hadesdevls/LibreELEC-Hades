   static constexpr auto SETTING_VIDEOSCREEN_HADESHDMIVRR = "videoscreen.hadeshdmivrr";
+  //! Hades: the content type of the AVI InfoFrame (windowing/gbm/ContentType.h)
+  static constexpr auto SETTING_VIDEOSCREEN_HADESCONTENTTYPE = "videoscreen.hadescontenttype";
