+              <option label="62543">1</option> <!-- as LibreELEC -->
+            </options>
+          </constraints>
+          <dependencies>
+            <dependency type="visible" on="property" name="supportscontenttype"/>
+          </dependencies>
+          <control type="spinner" format="string" />
