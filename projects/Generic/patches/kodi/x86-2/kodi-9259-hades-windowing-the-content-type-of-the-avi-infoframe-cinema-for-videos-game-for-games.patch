+// Hades: the setting of the content type of the AVI InfoFrame, where the output has the property
+bool SupportsContentTypeChoice(const std::string& /*condition*/,
+                               const std::string& /*value*/,
+                               const SettingConstPtr& /*setting*/)
+{
+  const auto* winSystem = CServiceBroker::GetWinSystem();
+  return winSystem && winSystem->SupportsContentTypeChoice();
+}
