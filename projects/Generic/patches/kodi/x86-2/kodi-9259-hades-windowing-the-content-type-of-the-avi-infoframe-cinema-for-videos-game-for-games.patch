+CONTENT_TYPE::Choice CWinSystemGbm::ContentTypeChoice() const
+{
+  const auto component = CServiceBroker::GetSettingsComponent();
+  const auto settings = component ? component->GetSettings() : nullptr;
+  if (!settings || !settings->GetSetting(CSettings::SETTING_VIDEOSCREEN_HADESCONTENTTYPE))
+    return CONTENT_TYPE::Choice::AUTOMATIC;
+  return CONTENT_TYPE::ChoiceOf(settings->GetInt(CSettings::SETTING_VIDEOSCREEN_HADESCONTENTTYPE));
+}
+
+std::optional<CONTENT_TYPE::Type> CWinSystemGbm::ContentTypeKernel() const
+{
+  CDRMConnector* connector = m_DRM ? m_DRM->GetConnector() : nullptr;
+  const auto value = connector ? connector->GetPropertyValue(CONTENT_TYPE::PROPERTY) : std::nullopt;
+  if (!value)
+    return std::nullopt;
+  const auto name = connector->GetPropertyEnumName(CONTENT_TYPE::PROPERTY, *value);
+  return name ? CONTENT_TYPE::TypeOfName(*name) : std::nullopt;
+}
+
+namespace
+{
+// Hades: what the AVI InfoFrame says of a content type, for kodi.log
+std::string ContentTypeAviText(const std::optional<CONTENT_TYPE::Avi>& avi)
+{
+  if (!avi)
+    return "as the driver makes it (not known for this driver)";
+  if (avi->itc == 0)
+    return "no content type (ITC 0)";
+  static const char* const names[] = {"graphics", "photo", "cinema", "game"};
+  return StringUtils::Format("ITC 1, CN {} ({})", avi->cn, names[avi->cn & 3]);
+}
+} // namespace
+
+void CWinSystemGbm::ReadContentTypeOutput()
+{
+  m_contentTypeAsked.reset();
+  m_contentTypeOwn.reset();
+  m_contentTypeWaitTold.clear();
+  m_contentTypeDeclared = {};
+  CDRMConnector* connector = m_DRM ? m_DRM->GetConnector() : nullptr;
+  m_contentTypeChoice = connector && connector->SupportsProperty(CONTENT_TYPE::PROPERTY);
+  m_contentTypeLogged = ContentTypeKernel();
+  if (!m_contentTypeChoice)
+    return;
+  m_contentTypeDeclared = CONTENT_TYPE::DeclaredOf(connector->GetEDID());
+  const auto& d = m_contentTypeDeclared;
+  std::string declared;
+  for (const auto& [on, name] : {std::pair{d.graphics, "Graphics"}, std::pair{d.photo, "Photo"},
+                                 std::pair{d.cinema, "Cinema"}, std::pair{d.game, "Game"}})
+    if (on)
+      declared += (declared.empty() ? "" : ", ") + std::string(name);
+  CLog::Log(
+      LOGINFO,
+      "Content type: {} ({}) has \"{}\"; the display declares {} in its EDID (CNC of its HDMI "
+      "VSDB); \"Content type\" (System > Display) is {}: {}",
+      connector->GetName(), m_rgbRangeDriver.empty() ? "unknown driver" : m_rgbRangeDriver,
+      m_contentTypeLogged ? CONTENT_TYPE::EnumName(*m_contentTypeLogged) : "?",
+      declared.empty() ? std::string("no content type") : declared,
+      ContentTypeChoice() == CONTENT_TYPE::Choice::AUTOMATIC ? "Automatic" : "As LibreELEC",
+      ContentTypeChoice() == CONTENT_TYPE::Choice::AS_LIBREELEC
+          ? "Kodi does not set it"
+          : (d.cinema ? "a video is said to be Cinema"
+                      : "a video is not said to be Cinema (the display does not declare it)") +
+                std::string(d.game ? ", a game Game" : "") +
+                ", with the change of mode that it makes anyway");
+}
+
+void CWinSystemGbm::StageContentType()
+{
+  const auto drm = std::dynamic_pointer_cast<CDRMAtomic>(m_DRM);
+  CDRMConnector* connector = drm ? drm->GetConnector() : nullptr;
+  if (!connector || !m_contentTypeChoice)
+    return;
+  const auto kernel = ContentTypeKernel();
+  if (!kernel)
+    return;
+  using namespace CONTENT_TYPE;
+  const auto player = CServiceBroker::GetAppComponents().GetComponent<CApplicationPlayer>();
+  Situation situation = Situation::MENUS;
+  if (player && player->IsPlayingGame())
+    situation = Situation::GAME;
+  else if (player && player->IsPlayingVideo())
+    situation = Situation::VIDEO;
+  const auto want =
+      Wanted(ContentTypeChoice(), situation, m_contentTypeDeclared, *kernel, m_contentTypeOwn);
+  if (!want)
+  {
+    m_contentTypeWaitTold.clear();
+    return;
+  }
+  const auto* onOutput = drm->ModeOnOutput();
+  const auto* selected = drm->GetSelectedMode();
+  const bool modeChanges =
+      onOutput && selected && !CCommittedMode<drmModeModeInfo>::SameTiming(*onOutput, *selected);
+  const bool inRequest = drm->RequestValue(connector, PROPERTY).has_value();
+  const bool nativeDV = NativeDVOutputInUse();
+  if (!Carried(drm->ModesetPending(), modeChanges, inRequest, nativeDV))
+  {
+    // once for each value that waits, while it waits (native Dolby Vision decides its own)
+    const std::string key = std::string(EnumName(*want)) + "|" + EnumName(*kernel);
+    if (!nativeDV && !inRequest && key != m_contentTypeWaitTold)
+    {
+      m_contentTypeWaitTold = key;
+      CLog::Log(LOGINFO,
+                "Content type: \"{}\" waits for the next change of mode of {} (it has \"{}\"): "
+                "the content type changes only in a change of mode that is made anyway, never in "
+                "one of its own (a video in the mode of the menus keeps theirs)",
+                EnumName(*want), connector->GetName(), EnumName(*kernel));
+    }
+    return;
+  }
+  const auto value = connector->GetPropertyEnumValue(PROPERTY, EnumName(*want));
+  if (!value || !drm->AddProperty(connector, PROPERTY, *value))
+    return;
+  m_contentTypeAsked = want;
+  m_contentTypeWaitTold.clear();
+}
+
+void CWinSystemGbm::ContentTypeCommitted()
+{
+  const auto asked = std::exchange(m_contentTypeAsked, std::nullopt);
+  const auto drm = std::dynamic_pointer_cast<CDRMAtomic>(m_DRM);
+  CDRMConnector* connector = drm ? drm->GetConnector() : nullptr;
+  if (!connector || !m_contentTypeChoice)
+    return;
+  const auto kernel = ContentTypeKernel();
+  if (!kernel)
+    return;
+  using namespace CONTENT_TYPE;
+  const bool nativeDV = NativeDVOutputInUse();
+  if (asked && *asked == *kernel)
+  {
+    // Kodi's own value, which As LibreELEC takes back; the "No Data" of the transport of native
+    // Dolby Vision does not take it away (its end gives back what it found)
+    if (*kernel != Type::NO_DATA)
+      m_contentTypeOwn = *kernel;
+    else if (!nativeDV)
+      m_contentTypeOwn.reset();
+  }
+  else if (asked && drm->LastCommitRefused())
+    CLog::Log(LOGWARNING,
+              "Content type: the driver refused the commit with \"{}\" on {}: it is asked again "
+              "with the next change of mode",
+              EnumName(*asked), connector->GetName());
+  // a line of kodi.log for each change of what the kernel has
+  if (m_contentTypeLogged == kernel)
+    return;
+  m_contentTypeLogged = kernel;
+  const auto* mode = drm->GetSelectedMode();
+  const double refresh =
+      mode && mode->htotal && mode->vtotal
+          ? mode->clock * 1000.0 / (static_cast<double>(mode->htotal) * mode->vtotal)
+          : 0.0;
+  CLog::Log(LOGINFO,
+            "Content type: {} has \"{}\" ({}x{} at {:.3f} Hz{}): the AVI InfoFrame says {}{}",
+            connector->GetName(), EnumName(*kernel), mode ? mode->hdisplay : 0,
+            mode ? mode->vdisplay : 0, refresh, nativeDV ? ", native Dolby Vision" : "",
+            ContentTypeAviText(AviOf(DriverOf(m_rgbRangeDriver), *kernel, nativeDV)),
+            *kernel == Type::CINEMA ? "; a TV with Filmmaker Mode Auto Start goes to Filmmaker Mode"
+            : *kernel == Type::GAME ? "; a TV that switches by it goes to its game mode"
+                                    : "");
+}
+
+const char* CWinSystemGbm::ContentTypeForTransport(bool lowLatency, bool hdrTunnel)
+{
+  if (!m_contentTypeChoice)
+    return nullptr;
+  const auto kernel = ContentTypeKernel();
+  if (!kernel)
+    return nullptr;
+  const auto value = CONTENT_TYPE::ForTransport(ContentTypeChoice(), lowLatency, hdrTunnel,
+                                                m_contentTypeDeclared, *kernel, m_contentTypeOwn);
+  if (!value)
+    return nullptr;
+  m_contentTypeAsked = *value;
+  return CONTENT_TYPE::EnumName(*value);
+}
