+#pragma once
+
+#include <cstddef>
+#include <cstdint>
+#include <optional>
+#include <string_view>
+#include <vector>
+
+/*!
+ * \file
+ * \brief Hades: the content type that the AVI InfoFrame of HDMI says (ITC and CN1 CN0 of
+ *        CTA-861), through DRM's standard "content type" connector property
+ *
+ * Without it every driver says what it always says, a film or the menus alike: NVIDIA's NVKMS and
+ * amdgpu "IT content, graphics" (ITC 1, CN 0: NvTiming_ConstructVideoInfoframeCtrl(), DC's
+ * set_avi_info_frame() for DISPLAY_CONTENT_TYPE_NO_DATA), i915 and xe "no data" (ITC 0: DRM's
+ * drm_hdmi_avi_infoframe_content_type()). Kodi never set the property. A TV that chooses its
+ * picture mode by the content type does not know that a film is a film: an LG TV with "Filmmaker
+ * Mode Auto Start" goes to Filmmaker Mode on Cinema, the way a Kaleidescape player makes it do.
+ *
+ * "Content type" (videoscreen.hadescontenttype):
+ * - Automatic (the default): a video says Cinema, a game of RetroPlayer Game, each only where the
+ *   display declares that it takes that content type (CNC2 and CNC3 of its HDMI VSDB; nothing is
+ *   said to a display that does not); the menus "No Data", which leaves each driver's own value,
+ *   as LibreELEC sends it; native Dolby Vision that the TV processes (Standard, and the HDMI 1.4b
+ *   signalling) "No Data", which the tunnel of every driver of Hades sends as ITC 0, "no data", as
+ *   a licensed Dolby Vision set-top box sends it; Dolby Vision Low-Latency, which the source maps
+ *   and the TV shows as a picture, and HDR over the tunnel are videos: Cinema.
+ * - As LibreELEC: Kodi does not set it. Where the kernel has a value that Kodi itself set (with
+ *   Automatic before), it goes back to "No Data"; a value that another program set stays.
+ *
+ * When: the AVI InfoFrame changes only with a mode set in i915 (intel_digital_connector_atomic_
+ * check() sets mode_changed for it, and a fastset does not take a new AVI InfoFrame), in amdgpu
+ * (mode_changed, and a stream that comes out the same keeps the old one: the change would not
+ * reach the display) and in NVIDIA's driver of Hades (nvidia-open-kernel-modules-9085,
+ * nvidia-legacy-open-9082: a mode set of the head). So Kodi changes it only in a commit that
+ * changes the mode of the output anyway (another timing: the refresh rate or the size of a video,
+ * the mode of the menus after it; Carried()), or in the commit that starts or ends native Dolby
+ * Vision (its transport, TransportSpecs.h, a mode set in every driver): never with a mode set of
+ * its own, never a black screen more. A video that plays in the mode of the menus keeps the value
+ * of the menus, and kodi.log says so.
+ *
+ * Nothing of DRM is here: a test runs it on the host (content_type_test.cpp).
+ */
+namespace KODI
+{
+namespace WINDOWING
+{
+namespace GBM
+{
+namespace CONTENT_TYPE
+{
+
+constexpr const char* PROPERTY = "content type";
+
+//! DRM's values of the property (DRM_MODE_CONTENT_TYPE_*), by their names
+enum class Type
+{
+  NO_DATA = 0,
+  GRAPHICS = 1,
+  PHOTO = 2,
+  CINEMA = 3,
+  GAME = 4,
+};
+
+//! The name of a value as DRM's enum has it (drm_content_type_enum_list)
+inline const char* EnumName(Type type)
+{
+  switch (type)
+  {
+    case Type::GRAPHICS:
+      return "Graphics";
+    case Type::PHOTO:
+      return "Photo";
+    case Type::CINEMA:
+      return "Cinema";
+    case Type::GAME:
+      return "Game";
+    default:
+      return "No Data";
+  }
+}
+
+inline std::optional<Type> TypeOfName(std::string_view name)
+{
+  for (const Type type : {Type::NO_DATA, Type::GRAPHICS, Type::PHOTO, Type::CINEMA, Type::GAME})
+    if (name == EnumName(type))
+      return type;
+  return std::nullopt;
+}
+
+//! The choice of the setting (videoscreen.hadescontenttype)
+enum class Choice
+{
+  AUTOMATIC = 0,
+  AS_LIBREELEC = 1,
+};
+
+inline Choice ChoiceOf(int value)
+{
+  return value == static_cast<int>(Choice::AS_LIBREELEC) ? Choice::AS_LIBREELEC : Choice::AUTOMATIC;
+}
+
+//! What the output shows
+enum class Situation
+{
+  MENUS, //!< nothing plays (music and pictures included)
+  VIDEO, //!< a video plays: SDR, HDR10, HDR10+, HLG, Dolby Vision drawn by Kodi or Low-Latency
+  GAME, //!< a game of RetroPlayer plays
+  DV_TV_LED, //!< native Dolby Vision that the TV processes (Standard, or the HDMI 1.4b signalling)
+};
+
+//! The content types that the display declares in the CNC bits of its HDMI VSDB (CTA-861: byte 8
+//! of the HDMI Vendor-Specific Data Block, OUI 00-0C-03)
+struct Declared
+{
+  bool graphics = false; //!< CNC0
+  bool photo = false; //!< CNC1
+  bool cinema = false; //!< CNC2
+  bool game = false; //!< CNC3
+};
+
+/*!
+ * \brief Hades: the CNC bits of the HDMI VSDB of the CTA-861 extensions of an EDID; none where the
+ *        EDID has no HDMI VSDB that long (a DisplayPort monitor, a DVI display, a short VSDB)
+ */
+inline Declared DeclaredOf(const std::vector<uint8_t>& edid)
+{
+  Declared declared;
+  for (size_t block = 1; (block + 1) * 128 <= edid.size(); ++block)
+  {
+    const uint8_t* cta = edid.data() + block * 128;
+    if (cta[0] != 0x02)
+      continue;
+    // the data blocks lie from byte 4 to the offset of the detailed timings (byte 2)
+    const size_t end = cta[2] >= 4 && cta[2] <= 127 ? cta[2] : 4;
+    for (size_t i = 4; i < end;)
+    {
+      const unsigned int tag = cta[i] >> 5;
+      const size_t length = cta[i] & 0x1F;
+      const uint8_t* payload = cta + i + 1;
+      if (i + 1 + length > end)
+        break;
+      // the HDMI VSDB: tag 3, IEEE OUI 00-0C-03 least significant byte first; CNC in its byte 8,
+      // the eighth byte of its payload
+      if (tag == 3 && length >= 8 && payload[0] == 0x03 && payload[1] == 0x0C && payload[2] == 0x00)
+      {
+        const uint8_t byte8 = payload[7];
+        declared.graphics = (byte8 & 0x01) != 0;
+        declared.photo = (byte8 & 0x02) != 0;
+        declared.cinema = (byte8 & 0x04) != 0;
+        declared.game = (byte8 & 0x08) != 0;
+        return declared;
+      }
+      i += 1 + length;
+    }
+  }
+  return declared;
+}
+
+/*!
+ * \brief Hades: the value that the property is to have in a situation; nothing: it is left as the
+ *        kernel has it. own: the value that Kodi set on this connector, where the kernel has it
+ *        (Kodi's own value, which As LibreELEC takes back).
+ */
+inline std::optional<Type> Wanted(Choice choice,
+                                  Situation situation,
+                                  const Declared& declared,
+                                  Type kernel,
+                                  std::optional<Type> own)
+{
+  if (choice == Choice::AS_LIBREELEC)
+  {
+    if (own && *own == kernel && kernel != Type::NO_DATA)
+      return Type::NO_DATA;
+    return std::nullopt;
+  }
+  Type want = Type::NO_DATA;
+  if (situation == Situation::VIDEO && declared.cinema)
+    want = Type::CINEMA;
+  else if (situation == Situation::GAME && declared.game)
+    want = Type::GAME;
+  if (want == kernel)
+    return std::nullopt;
+  return want;
+}
+
+/*!
+ * \brief Hades: whether a commit carries a change of the content type: one that allows a mode set
+ *        (modesetAllowed) and changes the mode of the output (modeChanges: another timing than the
+ *        one Kodi's commits put there, which must be known), whose request does not have the
+ *        property already (inRequest: the transport of native Dolby Vision, or its end), while
+ *        native Dolby Vision does not hold the output (the transport decides then). Never a mode
+ *        set of its own.
+ */
+inline bool Carried(bool modesetAllowed, bool modeChanges, bool inRequest, bool nativeDV)
+{
+  return modesetAllowed && modeChanges && !inRequest && !nativeDV;
+}
+
+/*!
+ * \brief Hades: the value that the transport of native Dolby Vision sets (nothing: the property is
+ *        not part of it; its end gives back what it found). Automatic: Low-Latency, which the
+ *        source maps and the TV shows as a picture, and HDR over the tunnel are videos (Cinema
+ *        where the display declares it, as Wanted() says for a video); the rest is Dolby Vision
+ *        that the TV processes, "No Data" (ITC 0 in every driver of Hades). As LibreELEC: only
+ *        Kodi's own value goes back to "No Data".
+ */
+inline std::optional<Type> ForTransport(Choice choice,
+                                        bool lowLatency,
+                                        bool hdrTunnel,
+                                        const Declared& declared,
+                                        Type kernel,
+                                        std::optional<Type> own)
+{
+  if (choice == Choice::AS_LIBREELEC)
+    return Wanted(choice, Situation::DV_TV_LED, declared, kernel, own);
+  return (lowLatency || hdrTunnel) && declared.cinema ? Type::CINEMA : Type::NO_DATA;
+}
+
+//! The driver of the output, for what the AVI InfoFrame says of a value (AviOf())
+enum class Driver
+{
+  INTEL, //!< i915 and xe: DRM's drm_hdmi_avi_infoframe_content_type()
+  AMDGPU, //!< DC's set_avi_info_frame(); the tunnel of Hades with DRM's helper
+  NVIDIA, //!< nvidia-drm of Hades (nvHadesAviContent() of NVKMS)
+  OTHER,
+};
+
+inline Driver DriverOf(std::string_view name)
+{
+  if (name == "i915" || name == "xe")
+    return Driver::INTEL;
+  if (name == "amdgpu")
+    return Driver::AMDGPU;
+  if (name == "nvidia-drm")
+    return Driver::NVIDIA;
+  return Driver::OTHER;
+}
+
+//! What the AVI InfoFrame says: ITC (byte 3, bit 7) and CN1 CN0 (byte 5, bits 5:4)
+struct Avi
+{
+  int itc = 0;
+  int cn = 0;
+  bool operator==(const Avi& other) const { return itc == other.itc && cn == other.cn; }
+};
+
+/*!
+ * \brief Hades: what the AVI InfoFrame says for a value of the property, in each driver; dolby:
+ *        native Dolby Vision has the output (its tunnel, Standard, Low-Latency or HDMI 1.4b).
+ *        Nothing where the driver is not known.
+ */
+inline std::optional<Avi> AviOf(Driver driver, Type type, bool dolby)
+{
+  if (driver == Driver::OTHER)
+    return std::nullopt;
+  switch (type)
+  {
+    case Type::GRAPHICS:
+      return Avi{1, 0};
+    case Type::PHOTO:
+      return Avi{1, 1};
+    case Type::CINEMA:
+      return Avi{1, 2};
+    case Type::GAME:
+      return Avi{1, 3};
+    default:
+      break;
+  }
+  // "No Data": DRM's helper says no data (i915, xe, and the tunnel of amdgpu); DC and NVKMS say
+  // graphics, but NVKMS of Hades says no data with Dolby Vision
+  if (driver == Driver::INTEL || dolby)
+    return Avi{0, 0};
+  return Avi{1, 0};
+}
+
+/*!
+ * \brief Hades: the value of the player information (hades.out.content) for what the AVI
+ *        InfoFrame says: cinema, game, photo, graphics or none (ITC 0); empty where it is not
+ *        known
+ */
+inline const char* RowValue(const std::optional<Avi>& avi)
+{
+  if (!avi)
+    return "";
+  if (avi->itc == 0)
+    return "none";
+  switch (avi->cn)
+  {
+    case 1:
+      return "photo";
+    case 2:
+      return "cinema";
+    case 3:
+      return "game";
+    default:
+      return "graphics";
+  }
+}
+
+} // namespace CONTENT_TYPE
+} // namespace GBM
+} // namespace WINDOWING
+} // namespace KODI
