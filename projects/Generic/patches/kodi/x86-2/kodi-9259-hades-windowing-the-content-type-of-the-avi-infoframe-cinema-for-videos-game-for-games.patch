index 1db5ff3..c6104ba 100644
--- a/addons/resource.language.en_gb/resources/strings.po
+++ b/addons/resource.language.en_gb/resources/strings.po
@@ -28230,3 +28230,27 @@ msgstr ""
 msgctxt "#62502"
 msgid "Lets the display switch to its HDR mode for HDR videos. On (the default): HDR10, HDR10+ and HLG videos go out as HDR, and the display shows them in its HDR mode. Off: the display stays in SDR, and those videos are converted to SDR, as for a display without HDR (see \"HDR to SDR: the display it is made for\"). Dolby Vision videos, and the videos that a setting sends as Dolby Vision, still go out as Dolby Vision while \"Native Dolby Vision output\" is on: to have them as SDR too, turn that off as well, or, for one video, choose \"As SDR (without HDR)\" for it while it plays, in \"Output of this video\" of the player information (the O key of a keyboard, Info on a remote, then OK on that button). To send only HLG videos as SDR, leave this on and use \"Play HDR videos as SDR\", below. Applies from the next video."
 msgstr ""
+
+#: system/settings/settings.xml
+#. Hades: label of setting "videoscreen.hadescontenttype"; translated in Estuary (#54540)
+msgctxt "#62540"
+msgid "Content type (Filmmaker Mode)"
+msgstr ""
+
+#: system/settings/settings.xml
+#. Hades: help of setting "videoscreen.hadescontenttype"; translated in Estuary (#54541)
+msgctxt "#62541"
+msgid "Tells the TV what the picture is, a film, a game or the menus, in the content type of the AVI InfoFrame of HDMI (CTA-861). A TV that chooses its picture mode by it changes by itself: an LG TV with Filmmaker Mode Auto Start on (in its picture settings) shows a film in Filmmaker Mode. Automatic (the default): videos are said to be Cinema and games (RetroPlayer) Game, each where the TV declares in its EDID that it takes that content type; the menus go out as the graphics driver says them, as in LibreELEC; Dolby Vision that the TV processes itself says no content type, as licensed players send it, and Dolby Vision Low-Latency is a video. It changes only with a change of mode that is made anyway (a video at its own refresh rate with \"Adjust display refresh rate\"), never with a black screen of its own, so a video that plays in the mode of the menus keeps theirs. As LibreELEC: LibreELEC Hades does not set it, and the graphics driver says what it always says (NVIDIA and AMD: computer graphics; Intel: nothing). The picture does not change by a single byte. The player information shows what the TV is told (Video page, Video output), and kodi.log each change."
+msgstr ""
+
+#: system/settings/settings.xml
+#. Hades: value "Automatic" of setting "videoscreen.hadescontenttype"; translated in Estuary (#54542)
+msgctxt "#62542"
+msgid "Automatic"
+msgstr ""
+
+#: system/settings/settings.xml
+#. Hades: value "As LibreELEC" of setting "videoscreen.hadescontenttype"; translated in Estuary (#54543)
+msgctxt "#62543"
+msgid "As LibreELEC"
+msgstr ""
