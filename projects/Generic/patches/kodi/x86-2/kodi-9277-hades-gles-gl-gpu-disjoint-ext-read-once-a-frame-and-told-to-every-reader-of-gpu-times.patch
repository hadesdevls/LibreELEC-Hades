+
+#pragma once
+
+#include <cstdint>
+
+namespace KODI
+{
+namespace WINDOWING
+{
+namespace GBM
+{
+
+/*!
+ * \brief Hades: GL_GPU_DISJOINT_EXT of GL_EXT_disjoint_timer_query, read once a frame and told to every reader of
+ *        GPU times
+ *
+ * The state says that the GPU lost the time since it was last read (a change of its clocks, a reset), so that the
+ * results of the timer queries in flight are not to be trusted; and reading it clears it. Several parts of the render
+ * thread time their pictures: Kodi's renderer (the step-down of its chroma, CLinuxRendererGLES), HDR10 adapted to the
+ * display, the passes of the conversion bridge, Dolby Vision rebuilt as HDR10 or SDR, native Dolby Vision. Each read
+ * the state itself, so that the first of them in a frame took a notice that the others then never saw, and took the
+ * results of a lost period as true (one sample in 48 does not lower a level, but a run of them can).
+ *
+ * Here the state is read by the first reader of a frame alone (read: the call that reads and clears it), and every
+ * disjoint period it finds is counted; each reader keeps the count it last saw, and learns of every period since then,
+ * whatever frame it reads in and in whatever order. Only the render thread calls it. Pure logic: a host test runs it
+ * (tools/regress of LibreELEC, kodi-host: gpu_disjoint_test.cpp).
+ */
+class CGpuDisjoint
+{
+public:
+  //! What a reader has seen
+  struct Reader
+  {
+    uint64_t seen = 0;
+  };
+
+  //! A new frame: the state is read again by the first reader in it (PresentRender())
+  void Frame() { ++m_frame; }
+
+  //! A reader that has just made its timers: nothing of it is in flight, so no period before now is its own
+  void Join(Reader& reader) const { reader.seen = m_periods; }
+
+  /*!
+   * \brief Whether the GPU lost its time since this reader last asked
+   * \param read the call that reads the state of the GL and clears it (true: disjoint); made at most once a frame
+   */
+  template<typename Read>
+  bool Lost(Reader& reader, Read&& read)
+  {
+    if (m_readFrame != m_frame)
+    {
+      m_readFrame = m_frame;
+      if (read())
+        ++m_periods;
+    }
+    const bool lost = reader.seen != m_periods;
+    reader.seen = m_periods;
+    return lost;
+  }
+
+  //! Disjoint periods found since the start (for the log and the tests)
+  uint64_t Periods() const { return m_periods; }
+
+private:
+  uint64_t m_frame = 1;
+  uint64_t m_readFrame = 0;
+  uint64_t m_periods = 0;
+};
+
+} // namespace GBM
+} // namespace WINDOWING
+} // namespace KODI
