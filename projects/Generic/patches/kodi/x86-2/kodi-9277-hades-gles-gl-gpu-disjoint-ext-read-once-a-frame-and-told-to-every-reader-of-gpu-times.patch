+  // (a disjoint period makes the results in flight useless: CGpuDisjoint)
+  const bool disjoint = GpuDisjointLost(m_convDisjoint);
   const double periodMs = DVRefreshPeriodMs();
   for (size_t n = 0; n < m_convTimers.size(); ++n)
   {
@@ -11045,11 +11061,11 @@ void CWinSystemGbmGLESContext::DVGpuTimerCollect()
 {
   if (!m_glGetQueryObjectuivEXT || !m_dvGpuTimers[0].begin)
     return;
-  // reading the disjoint state also clears it; a disjoint period invalidates pending results
-  GLint disjoint = 0;
-  glGetIntegerv(GL_GPU_DISJOINT_EXT, &disjoint);
-  // Hades: ... and so are those of the passes (libplacebo leaves this state to Kodi: libplacebo-9944)
-  if (disjoint && m_dvBridge)
+  // a disjoint period invalidates pending results (CGpuDisjoint: read once a frame, told to every reader)
+  const bool disjoint = GpuDisjointLost(m_dvDisjoint);
+  // Hades: ... and so are those of the passes (libplacebo leaves this state to Kodi: libplacebo-9944), whose reader is
