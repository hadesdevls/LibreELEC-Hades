+  if (GpuDisjointLost(m_dvPassesDisjoint) && m_dvBridge)
     m_dvBridge->PassTimesLost();
   // In the order of the frames: the timer that the next frame takes is that of the oldest one.
   for (size_t n = 0; n < m_dvGpuTimers.size(); ++n)
