-  // (reading the disjoint state clears it; a disjoint period makes the results in flight useless)
-  GLint disjoint = 0;
-  glGetIntegerv(GL_GPU_DISJOINT_EXT, &disjoint);
+  // (a disjoint period makes the results in flight useless: CGpuDisjoint, which every reader is told by)
+  const bool disjoint = GpuDisjointLost(m_hdr10AdaptDisjoint);
   // Hades: ... and those of the passes of the bridge (libplacebo leaves this state to Kodi)
-  if (disjoint && m_dvConvertBridge)
-    m_dvConvertBridge->PassTimesLost();
+  ConversionTimesDisjoint();
   for (size_t n = 0; n < m_hdr10AdaptTimers.size(); ++n)
   {
     auto& timer = m_hdr10AdaptTimers[(m_hdr10AdaptTimerIndex + n) % m_hdr10AdaptTimers.size()];
@@ -5972,13 +5973,22 @@ void CWinSystemGbmGLESContext::ConversionTimesDisjoint()
 {
   if (!m_dvConvertBridge || !m_dvConvertBridge->PassSampleEvery())
     return;
-  // (reading it clears it)
-  GLint disjoint = 0;
-  glGetIntegerv(GL_GPU_DISJOINT_EXT, &disjoint);
-  if (disjoint)
+  // (a reader of its own: CGpuDisjoint)
+  if (GpuDisjointLost(m_convPassesDisjoint))
     m_dvConvertBridge->PassTimesLost();
 }
 
+bool CWinSystemGbmGLESContext::GpuDisjointLost(CGpuDisjoint::Reader& reader)
+{
+  return m_gpuDisjoint.Lost(reader,
+                            []
+                            {
+                              GLint disjoint = 0;
+                              glGetIntegerv(GL_GPU_DISJOINT_EXT, &disjoint);
+                              return disjoint != 0;
+                            });
+}
