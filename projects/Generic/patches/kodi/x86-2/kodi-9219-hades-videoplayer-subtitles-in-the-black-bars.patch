+void CLinuxRendererGLES::SubtitleBarsTick(int index)
+{
+  // Hades: subtitles in the black bars (SubtitleBars.h). The setting is looked at once a second; with
+  // it off nothing is measured, and what was measured is let go. The luma plane of the picture about
+  // to be drawn (one sample a texel: not packed 4:2:2) is measured twice a second at most and read
+  // back at a later frame (SubtitleBarsGLES.h); a measurement read back goes to the bar of the video.
+  const auto now = std::chrono::steady_clock::now();
+  if (now - m_barsSettingRead >= std::chrono::seconds(1))
+  {
+    m_barsSettingRead = now;
+    const auto component = CServiceBroker::GetSettingsComponent();
+    const auto settings = component ? component->GetSettings() : nullptr;
+    const bool on = settings && settings->GetBool(CSettings::SETTING_SUBTITLES_HADESINBARS);
+    if (on != m_subtitleBarsOn)
+    {
+      m_subtitleBarsOn = on;
+      m_subtitleBars.Reset();
+      if (!on)
+        m_barsMeasure.Release();
+    }
+  }
+  if (!m_subtitleBarsOn || m_textureTarget != GL_TEXTURE_2D || index < 0 || index >= NUM_BUFFERS)
+    return;
+  const CPictureBuffer& buf = m_buffers[index];
+  const CYuvPlane& luma = buf.fields[FIELD_FULL][0];
+  if (!luma.id || luma.pixpertex_x != 1 || luma.pixpertex_y != 1)
+    return;
+  // (the texture of a plane of more than 8 bits holds its codes as Kodi's shaders read them:
+  // CConvertMatrix scales such a texture by 65535 / (2^bits - 1); limited range is black at 16/255)
+  const float scale = buf.m_srcTextureBits > 8
+                          ? 65535.0f / static_cast<float>((1 << buf.m_srcTextureBits) - 1)
+                          : 1.0f;
+  const float black = buf.m_srcFullRange ? 0.0f : 16.0f / 255.0f;
+  KODI::SUBTITLES::BARS::Measure measure;
+  if (m_barsMeasure.Tick(luma.id, luma.texwidth, luma.texheight, static_cast<int>(m_sourceWidth),
+                         static_cast<int>(m_sourceHeight), scale, black, measure))
+    m_subtitleBars.Measured(measure, std::chrono::duration<double>(now.time_since_epoch()).count());
+}
