+namespace KODI::SUBTITLES::BARS
+{
+namespace
+{
+// a triangle over the whole target, from the number of its vertex (no buffer of vertices)
+constexpr const char* VERTEX = R"(#version 300 es
+void main()
+{
+  vec2 p = vec2(float((gl_VertexID << 1) & 2), float(gl_VertexID & 2));
+  gl_Position = vec4(p * 2.0 - 1.0, 0.0, 1.0);
+}
+)";
+
+// a texel of the target: band x of the columns, rows 2y and 2y + 1 of the picture (the row 0 of the
+// target is the top of the picture: the rows read back are in the order of the picture). Every other
+// column of the band is read.
+constexpr const char* FRAGMENT = R"(#version 300 es
+precision highp float;
+precision highp int;
+uniform highp sampler2D u_luma;
+uniform ivec2 u_size;
+uniform float u_scale;
+out vec4 o_colour;
+void main()
+{
+  int band = int(gl_FragCoord.x);
+  int row = int(gl_FragCoord.y) * 2;
+  int x0 = band * u_size.x / 16;
+  int x1 = (band + 1) * u_size.x / 16;
+  int row2 = min(row + 1, u_size.y - 1);
+  float m = 0.0;
+  for (int x = x0; x < x1; x += 2)
+  {
+    m = max(m, texelFetch(u_luma, ivec2(x, row), 0).r);
+    m = max(m, texelFetch(u_luma, ivec2(x, row2), 0).r);
+  }
+  o_colour = vec4(clamp(m * u_scale, 0.0, 1.0), 0.0, 0.0, 1.0);
+}
+)";
+
+GLuint Compile(GLenum type, const char* source, std::string& log)
+{
+  const GLuint shader = glCreateShader(type);
+  glShaderSource(shader, 1, &source, nullptr);
+  glCompileShader(shader);
+  GLint ok = GL_FALSE;
+  glGetShaderiv(shader, GL_COMPILE_STATUS, &ok);
+  if (ok != GL_TRUE)
+  {
+    char text[512] = {};
+    glGetShaderInfoLog(shader, sizeof(text) - 1, nullptr, text);
+    log = text;
+    glDeleteShader(shader);
+    return 0;
+  }
+  return shader;
+}
+
+//! the state of GL that the pass changes, and puts back
+struct SavedState
+{
+  GLint drawFbo = 0, readFbo = 0, viewport[4] = {}, program = 0, active = 0, texture = 0, vao = 0,
+        pack = 0;
+  GLboolean blend = GL_FALSE, dither = GL_FALSE, scissor = GL_FALSE, depth = GL_FALSE,
+            stencil = GL_FALSE, cull = GL_FALSE, mask[4] = {};
+
+  SavedState()
+  {
+    glGetIntegerv(GL_DRAW_FRAMEBUFFER_BINDING, &drawFbo);
+    glGetIntegerv(GL_READ_FRAMEBUFFER_BINDING, &readFbo);
+    glGetIntegerv(GL_VIEWPORT, viewport);
+    glGetIntegerv(GL_CURRENT_PROGRAM, &program);
+    glGetIntegerv(GL_ACTIVE_TEXTURE, &active);
+    glActiveTexture(GL_TEXTURE0);
+    glGetIntegerv(GL_TEXTURE_BINDING_2D, &texture);
+    glGetIntegerv(GL_VERTEX_ARRAY_BINDING, &vao);
+    glGetIntegerv(GL_PIXEL_PACK_BUFFER_BINDING, &pack);
+    blend = glIsEnabled(GL_BLEND);
+    dither = glIsEnabled(GL_DITHER);
+    scissor = glIsEnabled(GL_SCISSOR_TEST);
+    depth = glIsEnabled(GL_DEPTH_TEST);
+    stencil = glIsEnabled(GL_STENCIL_TEST);
+    cull = glIsEnabled(GL_CULL_FACE);
+    glGetBooleanv(GL_COLOR_WRITEMASK, mask);
+  }
+  ~SavedState()
+  {
+    const auto set = [](GLenum cap, GLboolean on) { on ? glEnable(cap) : glDisable(cap); };
+    set(GL_BLEND, blend);
+    set(GL_DITHER, dither);
+    set(GL_SCISSOR_TEST, scissor);
+    set(GL_DEPTH_TEST, depth);
+    set(GL_STENCIL_TEST, stencil);
+    set(GL_CULL_FACE, cull);
+    glColorMask(mask[0], mask[1], mask[2], mask[3]);
+    glBindBuffer(GL_PIXEL_PACK_BUFFER, static_cast<GLuint>(pack));
+    glBindVertexArray(static_cast<GLuint>(vao));
+    glActiveTexture(GL_TEXTURE0);
+    glBindTexture(GL_TEXTURE_2D, static_cast<GLuint>(texture));
+    glActiveTexture(static_cast<GLenum>(active));
+    glUseProgram(static_cast<GLuint>(program));
+    glViewport(viewport[0], viewport[1], viewport[2], viewport[3]);
+    glBindFramebuffer(GL_READ_FRAMEBUFFER, static_cast<GLuint>(readFbo));
+    glBindFramebuffer(GL_DRAW_FRAMEBUFFER, static_cast<GLuint>(drawFbo));
+  }
+};
+} // namespace
+
+CBarsMeasureGLES::~CBarsMeasureGLES()
+{
+  // (the renderer releases it with its context current: UnInit())
+}
+
+void CBarsMeasureGLES::Release()
+{
+  if (m_fence)
+    glDeleteSync(m_fence);
+  m_fence = nullptr;
+  if (m_pbo)
+    glDeleteBuffers(1, &m_pbo);
+  if (m_target)
+    glDeleteTextures(1, &m_target);
+  if (m_fbo)
+    glDeleteFramebuffers(1, &m_fbo);
+  if (m_vao)
+    glDeleteVertexArrays(1, &m_vao);
+  if (m_program)
+    glDeleteProgram(m_program);
+  m_pbo = m_target = m_fbo = m_vao = m_program = 0;
+  m_pboBytes = m_targetRows = 0;
+  m_last = {};
+}
+
+void CBarsMeasureGLES::Fail(const char* what)
+{
+  m_failed = true;
+  CLog::Log(
+      LOGWARNING,
+      "Subtitles in the bars: the measurement of the bars cannot run here ({}): subtitles stay "
+      "where Kodi puts them, except under a picture drawn smaller than the screen",
+      what);
+  Release();
+}
+
+bool CBarsMeasureGLES::Init()
+{
+  if (m_program)
+    return true;
+  const char* version = reinterpret_cast<const char*>(glGetString(GL_VERSION));
+  if (!version || std::strncmp(version, "OpenGL ES ", 10) != 0 || version[10] < '3')
+  {
+    Fail("it needs OpenGL ES 3.0");
+    return false;
+  }
+  std::string log;
+  const GLuint vs = Compile(GL_VERTEX_SHADER, VERTEX, log);
+  const GLuint fs = vs ? Compile(GL_FRAGMENT_SHADER, FRAGMENT, log) : 0;
+  if (!vs || !fs)
+  {
+    if (vs)
+      glDeleteShader(vs);
+    CLog::Log(LOGWARNING, "Subtitles in the bars: the shader of the measurement: {}", log);
+    Fail("its shader was not compiled");
+    return false;
+  }
+  m_program = glCreateProgram();
+  glAttachShader(m_program, vs);
+  glAttachShader(m_program, fs);
+  glLinkProgram(m_program);
+  glDeleteShader(vs);
+  glDeleteShader(fs);
+  GLint linked = GL_FALSE;
+  glGetProgramiv(m_program, GL_LINK_STATUS, &linked);
+  if (linked != GL_TRUE)
+  {
+    Fail("its shader was not linked");
+    return false;
+  }
+  m_locLuma = glGetUniformLocation(m_program, "u_luma");
+  m_locSize = glGetUniformLocation(m_program, "u_size");
+  m_locScale = glGetUniformLocation(m_program, "u_scale");
+  glGenVertexArrays(1, &m_vao);
+  glGenFramebuffers(1, &m_fbo);
+  glGenTextures(1, &m_target);
+  glGenBuffers(1, &m_pbo);
+  return true;
+}
+
+bool CBarsMeasureGLES::Start(GLuint texture, int width, int height, float scale)
+{
+  const int rows = (height + 1) / 2;
+  const SavedState saved;
+  if (rows != m_targetRows)
+  {
+    glBindTexture(GL_TEXTURE_2D, m_target);
+    glTexImage2D(GL_TEXTURE_2D, 0, GL_RGBA8, BANDS, rows, 0, GL_RGBA, GL_UNSIGNED_BYTE, nullptr);
+    glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_MIN_FILTER, GL_NEAREST);
+    glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_MAG_FILTER, GL_NEAREST);
+    glBindFramebuffer(GL_FRAMEBUFFER, m_fbo);
+    glFramebufferTexture2D(GL_FRAMEBUFFER, GL_COLOR_ATTACHMENT0, GL_TEXTURE_2D, m_target, 0);
+    if (glCheckFramebufferStatus(GL_FRAMEBUFFER) != GL_FRAMEBUFFER_COMPLETE)
+      return false;
+    m_targetRows = rows;
+  }
+  glBindFramebuffer(GL_FRAMEBUFFER, m_fbo);
+  glViewport(0, 0, BANDS, rows);
+  glDisable(GL_BLEND);
+  glDisable(GL_DITHER);
+  glDisable(GL_SCISSOR_TEST);
+  glDisable(GL_DEPTH_TEST);
+  glDisable(GL_STENCIL_TEST);
+  glDisable(GL_CULL_FACE);
+  glColorMask(GL_TRUE, GL_TRUE, GL_TRUE, GL_TRUE);
+  glUseProgram(m_program);
+  glActiveTexture(GL_TEXTURE0);
+  glBindTexture(GL_TEXTURE_2D, texture);
+  glUniform1i(m_locLuma, 0);
+  glUniform2i(m_locSize, width, height);
+  glUniform1f(m_locScale, scale);
+  glBindVertexArray(m_vao);
+  glDrawArrays(GL_TRIANGLES, 0, 3);
+  const int bytes = BANDS * rows * 4;
+  glBindBuffer(GL_PIXEL_PACK_BUFFER, m_pbo);
+  if (bytes != m_pboBytes)
+  {
+    glBufferData(GL_PIXEL_PACK_BUFFER, bytes, nullptr, GL_STREAM_READ);
+    m_pboBytes = bytes;
+  }
+  glReadPixels(0, 0, BANDS, rows, GL_RGBA, GL_UNSIGNED_BYTE, nullptr);
+  m_fence = glFenceSync(GL_SYNC_GPU_COMMANDS_COMPLETE, 0);
+  m_rows = rows;
+  m_height = height;
+  return m_fence != nullptr;
+}
+
+bool CBarsMeasureGLES::Tick(GLuint texture,
+                            int texWidth,
+                            int texHeight,
+                            int width,
+                            int height,
+                            float scale,
+                            float black,
+                            Measure& out)
+{
+  if (m_failed || !texture || width <= 0 || height <= 0 || width > texWidth || height > texHeight)
+    return false;
+  bool read = false;
+  if (m_fence)
+  {
+    // (never waited for: a measurement whose fence has not passed is looked at again next frame)
+    const GLenum status = glClientWaitSync(m_fence, 0, 0);
+    if (status == GL_TIMEOUT_EXPIRED)
+      return false;
+    glDeleteSync(m_fence);
+    m_fence = nullptr;
+    if (status == GL_WAIT_FAILED)
+    {
+      Fail("its fence failed");
+      return false;
+    }
+    GLint pack = 0;
+    glGetIntegerv(GL_PIXEL_PACK_BUFFER_BINDING, &pack);
+    glBindBuffer(GL_PIXEL_PACK_BUFFER, m_pbo);
+    const void* data = glMapBufferRange(GL_PIXEL_PACK_BUFFER, 0, m_pboBytes, GL_MAP_READ_BIT);
+    if (data)
+    {
+      out = Analyse(static_cast<const uint8_t*>(data), m_rows, 2, m_height, m_black);
+      read = true;
+      glUnmapBuffer(GL_PIXEL_PACK_BUFFER);
+    }
+    glBindBuffer(GL_PIXEL_PACK_BUFFER, static_cast<GLuint>(pack));
+    if (!data)
+    {
+      Fail("its result could not be read back");
+      return false;
+    }
+  }
+  const auto now = std::chrono::steady_clock::now();
+  if (m_last != std::chrono::steady_clock::time_point{} && now - m_last < PERIOD)
+    return read;
+  if (!Init())
+    return read;
+  m_last = now;
+  m_black = black;
+  if (!Start(texture, width, height, scale))
+    Fail("its target could not be drawn into");
+  return read;
+}
+
+} // namespace KODI::SUBTITLES::BARS
