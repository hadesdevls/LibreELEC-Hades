+bool CRenderer::BarsApply() const
+{
+  // Hades: subtitles in the black bars (SubtitleBars.h): only at the bottom (Bottom of video or of
+  // screen: not the user's own Manual place, nor the top), not for 3D (each eye has its place and
+  // depth), not while a menu of a disc is shown
+  return m_barsOn && !m_barsMenu &&
+         (m_subtitleAlign == SUBTITLES::Align::BOTTOM_INSIDE ||
+          m_subtitleAlign == SUBTITLES::Align::BOTTOM_OUTSIDE) &&
+         (m_stereomode.empty() || m_stereomode == "mono") && m_rv.Height() > 0.0f;
+}
+
+SUBTITLES::BARS::Place CRenderer::BarsPlace(float need, const char* kind) const
+{
+  namespace BARS = SUBTITLES::BARS;
+  const BARS::Rect source{m_rs.x1, m_rs.y1, m_rs.x2, m_rs.y2};
+  const BARS::Rect dest{m_rd.x1, m_rd.y1, m_rd.x2, m_rd.y2};
+  const BARS::Rect view{m_rv.x1, m_rv.y1, m_rv.x2, m_rv.y2};
+  const BARS::Place place =
+      BARS::PlaceIn(source, dest, view, m_bars, need, BARS::GapOf(m_rv.Height()));
+  // (a line in kodi.log where what is done changes: the bar, the room, and whether it holds them;
+  // compared field by field, nothing made at each frame)
+  const long room = std::lround(place.room);
+  if (!m_barsSaid.kind || std::strcmp(m_barsSaid.kind, kind) != 0 ||
+      m_barsSaid.rows != m_bars.rows || m_barsSaid.height != m_bars.height ||
+      m_barsSaid.room != room || m_barsSaid.inBar != place.inBar)
+  {
+    m_barsSaid = {kind, m_bars.rows, m_bars.height, room, place.inBar};
+    if (m_bars.rows > 0)
+      CLog::Log(
+          LOGINFO,
+          "Subtitles in the bars: the bar under the picture is {} of its {} rows ({}); the room "
+          "under the picture on the screen is {:.0f} px, {} {} need {:.0f} px: {}",
+          m_bars.rows, m_bars.height, m_bars.how ? m_bars.how : "", place.room,
+          std::string(kind) == "text" ? "two lines of" : "these lines of", kind, need,
+          place.inBar ? "they go into it" : place.why);
+    else
+      CLog::Log(
+          LOGINFO,
+          "Subtitles in the bars: no bar found inside the picture (yet: a bright scene shows it); "
+          "the room under the picture on the screen is {:.0f} px, {} {} need {:.0f} px: {}",
+          place.room, std::string(kind) == "text" ? "two lines of" : "these lines of", kind, need,
+          place.inBar ? "they go into it"
+          : place.why ? place.why
+                      : "");
+  }
+  return place;
+}
