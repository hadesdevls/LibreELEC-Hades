+std::optional<double> CRenderer::BarsTextPosition(const CDVDOverlayLibass& overlay,
+                                                  const SUBTITLES::STYLE::style& style) const
+{
+  // Hades: subtitles in the black bars (SubtitleBars.h): the text that Kodi styles itself (SubRip,
+  // WebVTT and the like: an adapted subtitle); styled ASS subtitles keep the places of their author.
+  // The bottom of the box of the lower line goes where the bottom of two lines goes, less its border
+  // and shadow under it. libass puts the bottom of the box at the line position p (in % of the frame,
+  // from its bottom margin to its top: ass_render.c) of y = sb (1 - p / 100), sb the bottom of the
+  // frame less the vertical margin of the style (MarginV of ApplyStyle(), in units of a frame 720
+  // high), the frame being the screen.
+  namespace BARS = SUBTITLES::BARS;
+  if (!BarsApply() || overlay.IsForcedMargins())
+    return std::nullopt;
+  const auto handler = overlay.GetLibassHandler();
+  if (!handler || handler->GetSubtitleType() != ADAPTED)
+    return std::nullopt;
+  BARS::Border border = BARS::Border::OUTLINE_NO_SHADOW;
+  if (style.borderStyle == SUBTITLES::STYLE::BorderType::OUTLINE)
+    border = BARS::Border::OUTLINE;
+  else if (style.borderStyle == SUBTITLES::STYLE::BorderType::BOX)
+    border = BARS::Border::BOX;
+  else if (style.borderStyle == SUBTITLES::STYLE::BorderType::SQUARE_BOX)
+    border = BARS::Border::SQUARE_BOX;
+  const float frame = m_rv.Height();
+  const BARS::TextSize text = BARS::TextOf(static_cast<int>(style.fontSize), style.lineSpacing,
+                                           style.fontBorderSize, style.shadowSize, border, frame);
+  const BARS::Place place = BarsPlace(text.twoLines, "text");
+  if (!place.inBar)
+    return std::nullopt;
+  const double bottom = static_cast<double>(place.blockBottom - text.below - m_rv.y1);
+  const double sb =
+      static_cast<double>(frame) * (1.0 - static_cast<double>(style.marginVertical) / 720.0);
+  if (sb <= 0.0)
+    return std::nullopt;
+  return 100.0 * (1.0 - bottom / sb);
+}
