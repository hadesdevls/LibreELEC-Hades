+
+#pragma once
+
+#include "SubtitleBars.h"
+
+#include <chrono>
+
+#include "system_gl.h"
+
+namespace KODI::SUBTITLES::BARS
+{
+
+/*!
+ * \brief Hades: the measurement of the bar under the picture for subtitles in the black bars
+ *        (SubtitleBars.h), on the luma plane of the decoded picture as the renderer has it (a texture of
+ *        one sample per texel: NV12, P010, the planes of software decoding; not packed 4:2:2)
+ *
+ * At most every PERIOD, a pass of its own draws a target of BANDS x (rows of the picture / 2) texels:
+ * in each, the brightest luma of two rows of the picture in one band of columns (every other column of
+ * it), scaled to the range of the luma. It is read back into a pixel buffer behind a fence, and taken
+ * at a later frame once the fence has passed: the thread that draws never waits for the GPU. About 4
+ * million reads of a texture for a 3840x2160 picture, twice a second. Everything of GL that the pass
+ * changes is put back as it was (the framebuffers, the viewport, the program, the texture of unit 0 and
+ * the active unit, the vertex array, the pixel pack buffer, blending, dithering, the scissor, depth and
+ * stencil tests, culling and the colour mask). Needs OpenGL ES 3.0 (texelFetch, pixel buffers, fences);
+ * where a step fails, it says so in kodi.log once and measures nothing more (the subtitles stay where
+ * Kodi puts them).
+ */
+class CBarsMeasureGLES
+{
+public:
+  static constexpr std::chrono::milliseconds PERIOD{500};
+
+  CBarsMeasureGLES() = default;
+  ~CBarsMeasureGLES();
+  CBarsMeasureGLES(const CBarsMeasureGLES&) = delete;
+  CBarsMeasureGLES& operator=(const CBarsMeasureGLES&) = delete;
+
+  //! the GL objects freed (with the context of the renderer current)
+  void Release();
+
+  /*!
+   * \brief The picture about to be drawn: its luma plane (texture, the size of the texture in texels,
+   *        the size of the picture), scale (the texture's value times scale is the luma from 0 to 1 of
+   *        its range of codes) and black (the black of the video in that unit)
+   * \return true and the measurement where one is read back now
+   */
+  bool Tick(GLuint texture,
+            int texWidth,
+            int texHeight,
+            int width,
+            int height,
+            float scale,
+            float black,
+            Measure& out);
+
+private:
+  bool Init();
+  void Fail(const char* what);
+  bool Start(GLuint texture, int width, int height, float scale);
+
+  bool m_failed = false;
+  GLuint m_program = 0;
+  GLint m_locLuma = -1, m_locSize = -1, m_locScale = -1;
+  GLuint m_vao = 0;
+  GLuint m_fbo = 0;
+  GLuint m_target = 0;
+  int m_targetRows = 0;
+  GLuint m_pbo = 0;
+  int m_pboBytes = 0;
+  GLsync m_fence = nullptr;
+  //! what the measurement in the pixel buffer is of
+  int m_rows = 0, m_height = 0;
+  float m_black = 0.0f;
+  std::chrono::steady_clock::time_point m_last{};
+};
+
+} // namespace KODI::SUBTITLES::BARS
