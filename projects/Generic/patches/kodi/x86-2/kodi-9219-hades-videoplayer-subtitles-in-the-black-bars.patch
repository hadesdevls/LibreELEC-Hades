+#pragma once
+
+#include <algorithm>
+#include <cstdint>
+#include <string>
+
+/*!
+ * \file
+ * \brief Hades: subtitles in the black bars (subtitles.hadesinbars, off by default). For a film of
+ *        2.39:1 whose bars are inside a 16:9 picture (most UHD remuxes), subtitles go into the bar under
+ *        the picture, so that they never cover it, as projector users ask for. Kodi places subtitles by
+ *        the picture it is given (Settings > Player > Subtitles > Position on screen: "Bottom of video"
+ *        and "Bottom of screen" are the same place when the bars are in the picture), and does not know
+ *        the bars inside it.
+ *
+ * Where the bar under the picture begins, in rows of the picture (CBarsHysteresis):
+ *  - from the active area of a Dolby Vision video (level 5), where the video has one that leaves bars:
+ *    taken with the picture it comes with (the RPU says it scene by scene). A level 5 block of zeros
+ *    (the whole picture) says nothing: many encodes write it whatever the picture has (dovi_tool
+ *    "generate"), so the measurement below decides then;
+ *  - otherwise measured on the decoded picture (its luma, Measure(): twice a second at most, on the
+ *    GPU, read back a picture later, SubtitleBarsGLES.h): per row, the brightest sample in each of
+ *    BANDS bands of columns. A row is black where no band is above the black of the video by more
+ *    than BLACK_STEP; a row is of the picture across it where at least WIDE_BANDS bands are lit (above
+ *    the black by LIT_STEP).
+ *    - The bar is taken larger (subtitles go into it) only from measurements that saw the edge of the
+ *      picture: the first row above the black rows lit across (a bright scene, not a dark one where a
+ *      lamp is lit: a dark scene says nothing of where its picture ends). GROW_MEASURES of those within
+ *      GROW_SECONDS at least, the smallest of them taken. So a dark scene, or the black of a fade,
+ *      never moves the subtitles.
+ *    - The bar is taken smaller at once where picture lit across shows inside it (an IMAX scene that
+ *      opens to 1.90:1, a scene of 16:9): what is under the picture is the bar that is left, if any.
+ *      A logo or a line of subtitles burnt into the bar is not picture across it.
+ *    - A new video (or another size) starts from no bar.
+ *
+ * Where the subtitles go (Place()): the room under the picture on the screen is from the bottom of the
+ * active picture to the bottom of the screen: the bar inside the picture and, where the picture is
+ * drawn smaller than the screen (a 3840x1600 encode), Kodi's own bar under it. Where two lines of text
+ * fit in it, with a gap above and below, the block of two lines is centred in it (one line sits where
+ * the lower of the two would); otherwise subtitles stay where Kodi puts them (the bars are too small for
+ * two lines at the subtitle size chosen: the help of the setting says how small fits). Pictures
+ * (PGS, DVD, DVB) go there as a group of lines whose height fits; a taller one stays where the disc put
+ * it.
+ *
+ * Not moved: subtitles placed by the user (Position on screen: Manual), at the top, styled ASS
+ * subtitles that keep their own places, a 3D video (each eye has its own place and depth), a menu of a
+ * disc. Nothing here uses Kodi: a host test runs it.
+ */
+namespace KODI::SUBTITLES::BARS
+{
+
+//! the bands of columns of the measurement
+constexpr int BANDS = 16;
+//! a row of the picture across it: lit in at least this many bands
+constexpr int WIDE_BANDS = 12;
+//! black: no band brighter than the black of the video by more than this (a part of the range of
+//! the luma: about 5 codes of 8 bits, 20 of 10, above the noise of a black bar of a stream)
+constexpr float BLACK_STEP = 0.02f;
+//! lit: brighter than the black by more than this (about 15 codes of 8 bits)
+constexpr float LIT_STEP = 0.06f;
+//! the rows of a bar that make no change of it (less of the picture by at most this many rows)
+constexpr int TOLERANCE_ROWS = 4;
+//! measurements that saw the edge of the picture before a larger bar is taken ...
+constexpr int GROW_MEASURES = 3;
+//! ... over at least this time, from the first to the last
+constexpr double GROW_SECONDS = 2.0;
+//! the least room for a bar: a bar of fewer rows than this share of the picture is no bar
+constexpr double MIN_BAR_SHARE = 0.02;
+
+//! What a measured picture says of its bar at the bottom, in rows of the picture
+struct Measure
+{
+  int height = 0; //!< the rows of the picture
+  int black = 0; //!< the rows at the bottom that are black
+  int across = 0; //!< the rows at the bottom up to the first that is of the picture across it
+  //! the edge of the picture was seen: the first row that is not black, or one of the two above it,
+  //! is lit across (the picture is bright there, not a dark scene)
+  bool edge = false;
+};
+
+/*!
+ * \brief A measurement read back: rows x BANDS samples of 8 bits (the brightest luma in each band of
+ *        each row of the measurement, 0 to 255 for the range of the luma), from the top
+ * \param rgba the samples, 4 bytes each (the red one is the luma), a row of BANDS after another
+ * \param rows how many rows of the measurement
+ * \param rowsPerRow how many rows of the picture a row of the measurement holds (the brightest of them)
+ * \param height the rows of the picture
+ * \param black the black of the video, 0 to 1 of the range (16/255 for limited range, 0 for full)
+ */
+inline Measure Analyse(const uint8_t* rgba, int rows, int rowsPerRow, int height, float black)
+{
+  Measure m;
+  m.height = height;
+  if (!rgba || rows <= 0 || rowsPerRow <= 0 || height <= 0)
+    return m;
+  const float blackTop = (black + BLACK_STEP) * 255.0f;
+  const float litFrom = (black + LIT_STEP) * 255.0f;
+  const auto lit = [&](int r, float from)
+  {
+    int n = 0;
+    for (int b = 0; b < BANDS; ++b)
+      n += rgba[(r * BANDS + b) * 4] > from;
+    return n;
+  };
+  int r = rows - 1;
+  while (r >= 0 && lit(r, blackTop) == 0)
+    --r;
+  const int blackRows = rows - 1 - r;
+  int a = rows - 1;
+  while (a >= 0 && lit(a, litFrom) < WIDE_BANDS)
+    --a;
+  const int acrossRows = rows - 1 - a;
+  m.black = std::min(height, blackRows * rowsPerRow);
+  m.across = std::min(height, acrossRows * rowsPerRow);
+  // (the first row that is not black, or the two above it: an edge of the picture that a scaler softens
+  // over a row or two)
+  m.edge = r >= 0 && blackRows > 0 && a >= 0 && r - a <= 2;
+  return m;
+}
+
+//! The bar under the picture that the subtitles may go into, in rows of the picture
+struct Bar
+{
+  int height = 0; //!< the rows of the picture
+  int rows = 0; //!< the rows of the bar at the bottom: 0, none
+  const char* how = nullptr; //!< how it was taken (a fixed text, for kodi.log)
+  bool operator==(const Bar& o) const { return height == o.height && rows == o.rows; }
+};
+
+constexpr const char* HOW_L5 = "from the active area of its Dolby Vision metadata (level 5)";
+constexpr const char* HOW_MEASURED = "measured on its pictures";
+constexpr const char* HOW_SHRUNK = "measured: picture shows in the bar that was taken";
+
+//! The bar, picture by picture and measurement by measurement (see the top of this file). Not thread
+//! safe: the render thread.
+class CBarsHysteresis
+{
+public:
+  //! a new video: no bar until one is seen
+  void Reset() { *this = CBarsHysteresis(); }
+
+  //! the active area of a Dolby Vision picture of height rows leaves bottom rows under it (0: the
+  //! whole picture, which says nothing)
+  void L5(int height, int bottom)
+  {
+    Size(height);
+    if (bottom <= 0 || bottom >= height)
+    {
+      m_l5 = false;
+      m_l5Rows = 0;
+      return;
+    }
+    // (a value of the area that a measurement found picture across is not taken again while it lasts)
+    if (bottom != m_l5Rows)
+    {
+      m_l5Rows = bottom;
+      m_l5Contradicted = false;
+    }
+    m_l5 = true;
+    m_grow = 0;
+    if (!m_l5Contradicted)
+      Take(bottom, HOW_L5);
+  }
+
+  //! a measurement, at seconds (any clock that goes forward)
+  void Measured(const Measure& m, double seconds)
+  {
+    if (m.height <= 0)
+      return;
+    Size(m.height);
+    // picture across the bar that was taken: the bar is what is left under it, at once
+    if (m_bar.rows > 0 && m.across + TOLERANCE_ROWS < m_bar.rows)
+    {
+      m_grow = 0;
+      m_l5Contradicted = m_l5;
+      Take(m.across, HOW_SHRUNK);
+      return;
+    }
+    // a level 5 area says how large the bar is: the measurement only takes it smaller (and decides
+    // alone once it found picture across the area's bar)
+    if ((m_l5 && !m_l5Contradicted) || !m.edge)
+      return;
+    if (m.black <= m_bar.rows + TOLERANCE_ROWS)
+    {
+      // the bar as it is (or a little more of it), seen again
+      m_grow = 0;
+      return;
+    }
+    if (m_grow == 0)
+    {
+      m_growFirst = seconds;
+      m_growMin = m.black;
+    }
+    m_grow++;
+    m_growMin = std::min(m_growMin, m.black);
+    if (m_grow >= GROW_MEASURES && seconds - m_growFirst >= GROW_SECONDS)
+    {
+      m_grow = 0;
+      Take(m_growMin, HOW_MEASURED);
+    }
+  }
+
+  const Bar& Now() const { return m_bar; }
+
+private:
+  void Size(int height)
+  {
+    if (height != m_bar.height)
+    {
+      *this = CBarsHysteresis();
+      m_bar.height = height;
+    }
+  }
+  void Take(int rows, const char* how)
+  {
+    if (rows < MIN_BAR_SHARE * m_bar.height)
+      rows = 0;
+    m_bar.rows = rows;
+    m_bar.how = how;
+  }
+
+  Bar m_bar;
+  bool m_l5 = false;
+  int m_l5Rows = 0;
+  bool m_l5Contradicted = false;
+  int m_grow = 0;
+  int m_growMin = 0;
+  double m_growFirst = 0.0;
+};
+
+//! The border of Kodi's text subtitles (SUBTITLES::STYLE::BorderType)
+enum class Border
+{
+  OUTLINE_NO_SHADOW,
+  OUTLINE,
+  BOX,
+  SQUARE_BOX
+};
+
+//! The text of Kodi's own style (CDVDSubtitlesLibass::ApplyStyle() for a subtitle that Kodi adapts:
+//! SubRip, WebVTT and the like), its sizes in Kodi's units of a frame 720 high (the settings of Player
+//! > Subtitles), on a frame of frameHeight pixels: the height of two lines with their border and shadow,
+//! and how much of that is under the box of the lower line. libass sizes a font so that its ascent and
+//! descent make the size (FT_SIZE_REQUEST_TYPE_REAL_DIM), puts the line spacing between two lines, and
+//! draws the border around the text and the shadow under it.
+struct TextSize
+{
+  float twoLines = 0;
+  float below = 0;
+};
+inline TextSize TextOf(
+    int fontSize, int lineSpacing, int borderSize, int shadowSize, Border border, float frameHeight)
+{
+  const float unit =
+      frameHeight / 720.0f; // (PlayResY 1080 and the scale 1080 / 720 of ApplyStyle())
+  const float font = static_cast<float>(fontSize) * unit;
+  // ApplyStyle(): lineSpacing * (PlayResY / 4) / 100 * scale, given to libass as that / PlayResY *
+  // frameHeight / 4
+  const float spacing =
+      static_cast<float>(lineSpacing) / 100.0f * 270.0f * 1.5f / 1080.0f * frameHeight / 4.0f;
+  float outline = 0, shadow = 0, around = 0;
+  switch (border)
+  {
+    case Border::OUTLINE_NO_SHADOW:
+      outline = 0.1f * static_cast<float>(borderSize) * unit;
+      break;
+    case Border::OUTLINE:
+      outline = 0.1f * static_cast<float>(borderSize) * unit;
+      shadow = 0.1f * static_cast<float>(shadowSize) * unit;
+      break;
+    case Border::BOX:
+      outline = 4.0f * unit;
+      shadow = 0.1f * static_cast<float>(shadowSize) * unit;
+      break;
+    case Border::SQUARE_BOX:
+      outline = 0.1f * static_cast<float>(borderSize) * unit;
+      around = 4.0f * unit; // (the space between the text and the edges of its box, on every side)
+      break;
+  }
+  TextSize t;
+  t.twoLines = 2 * font + spacing + 2 * (outline + around) + shadow;
+  t.below = outline + around + shadow;
+  return t;
+}
+
+//! the least room between the picture and the text, and between the text and the bottom of the screen
+inline float GapOf(float frameHeight)
+{
+  return std::max(2.0f, 0.002f * frameHeight);
+}
+
+//! A rectangle of the screen (Kodi's CRect, without Kodi)
+struct Rect
+{
+  float x1 = 0, y1 = 0, x2 = 0, y2 = 0;
+  float Height() const { return y2 - y1; }
+};
+
+//! Where subtitles go
+struct Place
+{
+  bool inBar = false; //!< they go into the room under the picture
+  float pictureBottom = 0; //!< the bottom of the active picture on the screen
+  float room = 0; //!< the room under it, to the bottom of the screen
+  float blockBottom = 0; //!< the bottom of the block of two lines of text, where inBar
+  const char* why = nullptr; //!< where not inBar, why (a fixed text, for kodi.log)
+};
+
+constexpr const char* WHY_NO_ROOM = "the picture reaches the bottom of the screen";
+constexpr const char* WHY_TOO_SMALL = "the room under the picture is too small for two lines";
+
+/*!
+ * \brief Where the bottom of a block of text goes in the room under the picture
+ * \param source the part of the picture drawn (Kodi's source rectangle, in its samples)
+ * \param dest where that part is drawn (it may reach beyond the screen: a zoom)
+ * \param view the screen
+ * \param bar the bar under the picture (rows of the picture)
+ * \param need the height of two lines of text with their borders
+ * \param gap the least room between the picture and the text, and between the text and the bottom
+ */
+inline Place PlaceIn(
+    const Rect& source, const Rect& dest, const Rect& view, const Bar& bar, float need, float gap)
+{
+  Place p;
+  const float height = static_cast<float>(bar.height > 0 ? bar.height : 0);
+  float bottom = dest.y2;
+  if (bar.rows > 0 && height > 0 && source.Height() > 0)
+  {
+    const float row = height - static_cast<float>(bar.rows);
+    bottom = dest.y1 + (row - source.y1) * dest.Height() / source.Height();
+  }
+  bottom = std::clamp(bottom, view.y1, std::max(view.y1, view.y2));
+  p.pictureBottom = bottom;
+  p.room = view.y2 - bottom;
+  if (p.room <= 0)
+  {
+    p.why = WHY_NO_ROOM;
+    return p;
+  }
+  if (p.room < need + 2 * gap)
+  {
+    p.why = WHY_TOO_SMALL;
+    return p;
+  }
+  p.inBar = true;
+  p.blockBottom = bottom + (p.room + need) / 2;
+  return p;
+}
+
+/*!
+ * \brief Where a group of lines of a picture subtitle goes in the room of a place: its bottom where
+ *        the bottom of two lines of text goes, the room for two lines being that of the tallest group
+ *        seen (tallest), so that one line and two lines sit on the same line; nowhere (a negative
+ *        value) where the group does not fit with the gaps
+ */
+inline float GroupBottom(const Place& place, float groupHeight, float tallest, float gap)
+{
+  if (!place.inBar || groupHeight + 2 * gap > place.room)
+    return -1.0f;
+  const float block = std::clamp(std::max(tallest, groupHeight), 0.0f, place.room - 2 * gap);
+  return place.pictureBottom + (place.room + block) / 2;
+}
+
+} // namespace KODI::SUBTITLES::BARS
