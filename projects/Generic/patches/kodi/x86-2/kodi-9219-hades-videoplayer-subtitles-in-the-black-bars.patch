+void CRenderManager::L5BarsOf(const VideoPicture& picture, int& height, int& bottom) const
+{
+  height = bottom = 0;
+#ifdef HAVE_DVBRIDGE
+  // Hades: subtitles in the black bars (SubtitleBars.h): the bar under the active area of a Dolby
+  // Vision picture of the video's own (not the level 5 block that Hades makes of HDR10 or HDR10+),
+  // read as the serializer reads it (dvbridge_l5_area()); offsets that the measurement of native
+  // output found picture across are no bar (dvbridge_l5check.h). Nothing is read with the setting off.
+  const auto component = CServiceBroker::GetSettingsComponent();
+  const auto settings = component ? component->GetSettings() : nullptr;
+  if (!settings || !settings->GetBool(CSettings::SETTING_SUBTITLES_HADESINBARS))
+    return;
+  if (picture.doviMeasured || picture.doviFromHdr10Plus || !picture.doviMetadata.Data())
+    return;
+  const int w = static_cast<int>(picture.iWidth);
+  const int h = static_cast<int>(picture.iHeight);
+  int area[4] = {};
+  unsigned int offsets[4] = {};
+  bool cut = false;
+  const char* none =
+      dvbridge_l5_area(picture.doviMetadata.Data(), picture.doviMetadata.Size(), w, h,
+                       CDVBridgeGLES::L5OfPicture(picture.doviVideo), area, &cut, offsets);
+  if (none || CDVBridgeGLES::L5LeftAside(picture.doviVideo, offsets) || area[3] <= area[1])
+    return;
+  height = h;
+  bottom = h - area[3];
+#endif
+}
+
+void CRenderManager::SubtitleBarsToOverlays()
+{
+  // Hades: subtitles in the black bars (SubtitleBars.h): the bar of the picture presented, with the
+  // setting; nothing moves while the disc is in its menu (CDVDInputStreamBluray::IsInMenu()), whose
+  // graphics are placed on the whole picture (asked only with the setting on)
+  const bool on = m_pRenderer->SubtitleBarsOn();
+  bool menu = false;
+  if (on)
+  {
+    const auto player = CServiceBroker::GetAppComponents().GetComponent<CApplicationPlayer>();
+    menu = player && player->IsInMenu();
+  }
+  m_overlays.SetSubtitleBars(on, m_pRenderer->SubtitleBars(), menu);
+}
