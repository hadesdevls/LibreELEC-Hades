From 9e8d4c886995435c57a630504632ea244a42a79d Mon Sep 17 00:00:00 2001
From: Hades <15710513+hadesdevls@users.noreply.github.com>
Date: Thu, 26 Nov 2026 05:16:36 +0000
Subject: [PATCH] [Hades][3D] A 3D playback that stops goes back to the menus
 in one change of mode

When a 3D video stopped, the menus went back to their resolution while
the stereo mode of the video was still on: the window system gave that
resolution its 3D output (a 3D mode of the display at the menus' rate,
or the HDMI vendor InfoFrame of the layout), and only then did the
stereoscopics manager turn 3D off, which set the mode once more. A
GeForce RTX 5050 with an LG TV did two mode sets at each stop of a 3D
video: 1920x1080 at 60 Hz, side by side and told by the InfoFrame, and
then 3840x2160 at 60 Hz without it (or 1920x1080 at 60 Hz twice, the
second only to end the InfoFrame, which nvidia-drm sets with a mode
set). Each one switches the display into 3D and out of it, which a
projector takes seconds to follow.

Where the playback stopped and the stereoscopics manager is to turn 3D
off (videoplayer.quitstereomodeonstop, OnPlaybackStopped()), the change
of resolution that brings the menus back turns 3D off with it: the menus
come back in one mode set, without a 3D output, and the manager then
finds 3D off and sets nothing. kodi.log says it. A video that still
plays (the menus over it) keeps its 3D, and with the setting off nothing
changes.
---
 xbmc/windowing/GraphicContext.cpp | 22 +++++++++++++++++++++-
 1 file changed, 21 insertions(+), 1 deletion(-)

diff --git a/xbmc/windowing/GraphicContext.cpp b/xbmc/windowing/GraphicContext.cpp
index 5138993..8c28604 100644
--- a/xbmc/windowing/GraphicContext.cpp
+++ b/xbmc/windowing/GraphicContext.cpp
@@ -368,7 +368,27 @@ void CGraphicContext::SetFullScreenVideo(bool bOnOff)
 
     if (allowResolutionChangeOnStop && !bTriggerUpdateRes)
     {
-      SetVideoResolution(targetResolutionOnStop, false);
+      // Hades: a 3D mode that the stereoscopics manager turns off once the playback stopped
+      // (videoplayer.quitstereomodeonstop: CStereoscopicsManager::OnPlaybackStopped()) is turned
+      // off with this change of resolution. The menus came back in the 3D output of their mode
+      // first (a 3D mode of the display at their rate, or the HDMI vendor InfoFrame of a 3D
+      // layout), and turning 3D off set the mode once more: two mode sets where one does, each a
+      // switch of the display into 3D and out of it, which a projector takes seconds to follow.
+      // The manager finds 3D off then, and sets nothing.
+      if (!appPlayer->IsPlayingVideo() && m_nextStereoMode != RenderStereoMode::OFF &&
+          CServiceBroker::GetSettingsComponent()->GetSettings()->GetBool(
+              CSettings::SETTING_VIDEOPLAYER_QUITSTEREOMODEONSTOP))
+      {
+        CLog::Log(LOGINFO, "3D: the playback stopped: the menus go back to their resolution with "
+                           "3D off, in one change of mode");
+        m_stereoMode = RenderStereoMode::OFF;
+        m_nextStereoMode = RenderStereoMode::OFF;
+        SetVideoResolution(targetResolutionOnStop, false);
+        CServiceBroker::GetGUI()->GetWindowManager().SendMessage(GUI_MSG_NOTIFY_ALL, 0, 0,
+                                                                 GUI_MSG_RENDERER_RESET);
+      }
+      else
+        SetVideoResolution(targetResolutionOnStop, false);
     }
   }
   else
