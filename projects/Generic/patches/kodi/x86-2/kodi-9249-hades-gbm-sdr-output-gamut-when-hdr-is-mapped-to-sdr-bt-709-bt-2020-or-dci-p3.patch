diff --git a/xbmc/cores/VideoPlayer/VideoRenderers/LinuxRendererGLES.cpp b/xbmc/cores/VideoPlayer/VideoRenderers/LinuxRendererGLES.cpp
index 2c11483..48af842 100644
--- a/xbmc/cores/VideoPlayer/VideoRenderers/LinuxRendererGLES.cpp
+++ b/xbmc/cores/VideoPlayer/VideoRenderers/LinuxRendererGLES.cpp
@@ -293,6 +293,12 @@ bool CLinuxRendererGLES::Configure(const VideoPicture &picture, float fps, unsig
   // frame is loaded after every call to Configure().
   m_bValidated = false;
 
+  // Hades: the container of an HDR picture mapped to SDR (videoscreen.hadessdrhdrgamut), asked before the bridge's
+  // mapping is taken: the bridge maps into it (SdrWideConfigure() sets the output up for it below)
+  std::string sdrMappedWhy;
+  const int sdrMapped = KODI::UTILS::SDRWIDE::MappedCandidate(picture.color_transfer)
+                            ? CServiceBroker::GetWinSystem()->SdrMappedContainer(&sdrMappedWhy)
+                            : 0;
 #ifdef HAVE_DVBRIDGE
   // Decided before the output transition: SetVideoOutput() chooses the 8-bit transport format
   // only for a picture that this renderer draws natively.
@@ -354,7 +360,7 @@ bool CLinuxRendererGLES::Configure(const VideoPicture &picture, float fps, unsig
     // what the output is told and for how the pictures are drawn until the renderer is configured
     // again
     const dvbridge_hdr10_mapping mapping =
-        dvWindow->TakeDVConversionMapping(picture, sdr, false, LibplaceboKneeWanted());
+        dvWindow->TakeDVConversionMapping(picture, sdr, false, LibplaceboKneeWanted(), sdrMapped);
     m_dvConvertDescribed = CDVBridgeGLES::ConversionOutput(picture, hdr10, &mapping);
     // Hades: its gamut mapping table made ahead, while the first picture is decoded
     dvWindow->DVConversionAhead(true);
@@ -371,7 +377,7 @@ bool CLinuxRendererGLES::Configure(const VideoPicture &picture, float fps, unsig
   bool plain = !convert && dvWindow && !WantsDVBridge(picture) && WantsPlainMapping(picture);
   if (plain)
   {
-    dvWindow->TakeDVConversionMapping(picture, true, true, LibplaceboKneeWanted());
+    dvWindow->TakeDVConversionMapping(picture, true, true, LibplaceboKneeWanted(), sdrMapped);
     CDVBridgeGLES::ConversionOutputSdr(picture, hdr10);
     dvWindow->DVConversionAhead(false);
   }
@@ -584,10 +590,37 @@ bool CLinuxRendererGLES::Configure(const VideoPicture &picture, float fps, unsig
   // BT.2020 as it is (KODI::UTILS::SDRWIDE)
 #ifdef HAVE_DVBRIDGE
   const bool ordinaryOutput = !convert && !plain;
+  // Hades: an HDR picture that the bridge maps to SDR (Dolby Vision rebuilt for SDR, or HDR10, HDR10+ or HLG mapped)
+  const bool bridgeSdr = (convert && sdr) || (m_plainMap && !m_plainAdapt);
 #else
   const bool ordinaryOutput = true;
+  const bool bridgeSdr = false;
 #endif
-  SdrWideConfigure(picture, ordinaryOutput && !m_passthroughHDR && !m_hdrFboActive, sdrWideWas);
+  // ... or that Kodi's shaders draw in SDR: PQ of BT.2020 that they tone map, HLG (whose signal is SDR's below its
+  // reference white: BT.2100's compatible display)
+  const bool kodiSdr = ordinaryOutput && !m_passthroughHDR && !m_hdrFboActive &&
+                       ((picture.color_transfer == AVCOL_TRC_SMPTE2084 &&
+                         picture.color_primaries == AVCOL_PRI_BT2020 &&
+                         m_videoSettings.m_ToneMapMethod != VS_TONEMAPMETHOD_OFF) ||
+                        picture.color_transfer == AVCOL_TRC_ARIB_STD_B67);
+  const bool mappedSdr = bridgeSdr || kodiSdr;
+  if (mappedSdr && !sdrMappedWhy.empty())
+    CLog::Log(LOGINFO,
+              "SDR output gamut: this HDR video ({}x{}) mapped to SDR goes out in BT.709, as Kodi "
+              "sends SDR: {}",
+              picture.iWidth, picture.iHeight, sdrMappedWhy);
+  if (!SdrWideConfigure(picture, ordinaryOutput && !m_passthroughHDR && !m_hdrFboActive, sdrWideWas,
+                        mappedSdr, sdrMapped))
+  {
+#ifdef HAVE_DVBRIDGE
+    // (the bridge mapped into the container that could not be set up: into BT.709 again, as Kodi sends SDR)
+    if (bridgeSdr && dvWindow)
+    {
+      dvWindow->TakeDVConversionMapping(picture, true, !convert, LibplaceboKneeWanted(), 0);
+      dvWindow->DVConversionAhead(convert);
+    }
+#endif
+  }
 
 #ifdef HAVE_DVBRIDGE
   LogPictureSettings(picture, false, convert && !sdr);
@@ -690,13 +723,48 @@ void CLinuxRendererGLES::LogPictureSettings(const VideoPicture& picture,
 
 AVColorPrimaries CLinuxRendererGLES::DrawnPrimaries() const
 {
+  // (Hades: an HDR picture mapped to SDR in a wide container: drawn in that container)
+  if (m_sdrWide && m_sdrWideMapped && !m_passthroughHDR)
+    return KODI::UTILS::SDRWIDE::Primaries(
+        static_cast<KODI::UTILS::SDRWIDE::Container>(m_sdrContainer));
   return m_passthroughHDR || m_sdrWide ? m_srcPrimaries : AVColorPrimaries::AVCOL_PRI_BT709;
 }
 
-void CLinuxRendererGLES::SdrWideConfigure(const VideoPicture& picture, bool ordinary, bool wasOn)
+bool CLinuxRendererGLES::SdrWideConfigure(
+    const VideoPicture& picture, bool ordinary, bool wasOn, bool mapped, int mappedContainer)
 {
+  namespace SDRWIDE = KODI::UTILS::SDRWIDE;
+  bool setUp = true;
   m_sdrWide = false;
-  if (ordinary && KODI::UTILS::SDRWIDE::Candidate(picture.color_primaries, picture.color_transfer))
+  m_sdrWideMapped = false;
+  m_sdrContainer = 0;
+  if (mapped && mappedContainer != 0)
+  {
+    // Hades: an HDR picture mapped to SDR, in the container asked for (videoscreen.hadessdrhdrgamut)
+    const auto container = static_cast<SDRWIDE::Container>(mappedContainer);
+    const std::string why =
+        CServiceBroker::GetWinSystem()->SetSdrWide(&picture, mappedContainer, true);
+    m_sdrWide = why.empty();
+    setUp = m_sdrWide;
+    if (m_sdrWide)
+    {
+      m_sdrWideMapped = true;
+      m_sdrContainer = mappedContainer;
+      CLog::Log(LOGINFO,
+                "SDR output gamut: this HDR video ({}x{}) mapped to SDR goes out in {}: mapped "
+                "into it, the display told {}, and the GUI and the subtitles converted to {} over "
+                "it (videoscreen.hadessdrhdrgamut)",
+                picture.iWidth, picture.iHeight, SDRWIDE::ContainerName(container),
+                SDRWIDE::ContainerName(container), SDRWIDE::ContainerName(container));
+    }
+    else
+      CLog::Log(
+          LOGWARNING,
+          "SDR output gamut: this HDR video ({}x{}) mapped to SDR goes out in BT.709, as Kodi "
+          "sends SDR, not in {}: {}",
+          picture.iWidth, picture.iHeight, SDRWIDE::ContainerName(container), why);
+  }
+  else if (ordinary && SDRWIDE::Candidate(picture.color_primaries, picture.color_transfer))
   {
     const std::string why = CServiceBroker::GetWinSystem()->SetSdrWide(&picture);
     m_sdrWide = why.empty();
@@ -715,11 +783,19 @@ void CLinuxRendererGLES::SdrWideConfigure(const VideoPicture& picture, bool ordi
   // the composite of the configuration before ends, where this one does not take it over
   if (wasOn && !m_sdrWide && !m_hdrFboActive)
     CServiceBroker::GetWinSystem()->SetSdrWide(nullptr);
+  return setUp;
 }
 
 void CLinuxRendererGLES::SdrWideEnd(const char* why, AVColorSpace colSpace)
 {
+  // (Hades: the container it was in: BT.2020, or that of an HDR picture mapped to SDR)
+  const char* const container =
+      m_sdrWideMapped ? KODI::UTILS::SDRWIDE::ContainerName(
+                            static_cast<KODI::UTILS::SDRWIDE::Container>(m_sdrContainer))
+                      : "BT.2020";
   m_sdrWide = false;
+  m_sdrWideMapped = false;
+  m_sdrContainer = 0;
   m_reloadShaders = true;
   CServiceBroker::GetWinSystem()->SetSdrWide(nullptr);
   VideoPicture drawn{};
@@ -728,9 +804,9 @@ void CLinuxRendererGLES::SdrWideEnd(const char* why, AVColorSpace colSpace)
   drawn.iHeight = m_sourceHeight;
   CServiceBroker::GetWinSystem()->SetColorimetry(&drawn);
   CLog::Log(LOGWARNING,
-            "SDR in BT.2020: {}: the video is drawn in BT.709 from the next frame, and the display "
+            "SDR in {}: {}: the video is drawn in BT.709 from the next frame, and the display "
             "is told so",
-            why);
+            container, why);
 }
 
 bool CLinuxRendererGLES::ConfigChanged(const VideoPicture &picture)
@@ -3663,7 +3739,10 @@ void CLinuxRendererGLES::CheckVideoParameters(int index)
   // the composite of the GUI into BT.2020 is not on any more (fail closed: as Kodi draws it)
   if (m_sdrWide)
   {
