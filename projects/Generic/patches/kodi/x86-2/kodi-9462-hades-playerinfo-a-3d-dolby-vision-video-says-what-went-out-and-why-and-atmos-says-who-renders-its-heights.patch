   // Hades: measured in place of the stream's own metadata: where its Dolby Vision is its own (not
   // made from HDR10+ nor measured already), and native output can be had (what it is sent with)
   if (choice == OutputChoice::MEASURED)
@@ -3644,6 +3653,11 @@ bool DVBRIDGE::OutputChoiceAvailable(OutputChoice choice)
   return window && window->SupportsDVConversion();
 }
 
+bool DVBRIDGE::StreamIs3D()
