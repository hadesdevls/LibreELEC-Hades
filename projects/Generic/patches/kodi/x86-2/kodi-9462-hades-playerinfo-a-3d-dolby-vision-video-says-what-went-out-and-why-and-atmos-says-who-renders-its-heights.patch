     g_dvStreamHdr = KODI::GUILIB::GUIINFO::COREELEC::StreamHdr::NOT_KNOWN;
@@ -3449,6 +3452,8 @@ bool DVBRIDGE::StreamOutputMayBeHlg()
 void DVBRIDGE::VideoStreamOpened(const CDVDStreamInfo& stream)
 {
   g_dvStreamProfile = static_cast<int>(stream.dovi.dv_profile);
+  // Hades: 3D, which native output never carries (StreamIs3D())
+  g_dvStreamStereo = KODI::UTILS::STEREO3D::IsStereo(stream.stereo_mode);
   g_dvStreamCompatibility = static_cast<int>(stream.dovi.dv_bl_signal_compatibility_id);
   g_dvStreamOrigin = stream.doviFromHlg         ? 3
                      : stream.doviMeasured      ? 2
@@ -3616,9 +3621,13 @@ bool DVBRIDGE::OutputChoiceAvailable(OutputChoice choice)
   // metadata, or converted from HLG) where native output can be had; as Kodi plays it, where that
