+  // (Hades: a 3D video has no choice of native Dolby Vision, nor of "as Kodi plays it" that would
+  // be the same as the settings' then: StreamIs3D())
   if (source == ChoiceSource::HDR10 || source == ChoiceSource::HDR10PLUS ||
       source == ChoiceSource::HLG)
-    return choice == OutputChoice::AUTOMATIC || NativeOutputAvailable();
