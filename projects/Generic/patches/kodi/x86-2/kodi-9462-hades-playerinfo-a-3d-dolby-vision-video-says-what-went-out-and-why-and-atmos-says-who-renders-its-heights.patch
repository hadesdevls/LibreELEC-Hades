+             "in 3D, each view is rebuilt and goes out as HDR10 or SDR (the line \"3D video\" "
+             "says which); elsewhere it plays as Kodi plays it, from its base layer";
     case StreamKeptOut::RASTER:
       return "native Dolby Vision output is not used for this video: its picture is " +
              std::to_string(width) + "x" + std::to_string(height) +
@@ -1718,6 +1721,16 @@ bool OutputChoiceAvailable(OutputChoice choice);
 //! Native output can be had for the video that plays, in a mode that carries it (what AUTOMATIC
 //! then gives): for the player's video settings
 bool NativeOutputAvailable();
+//! Hades: the video stream of the video that plays is 3D (a stereo mode that is not "mono", as
+//! VideoStreamOpened() was given it): native output is never had for it, whatever the display takes
+bool StreamIs3D();
+//! Hades: whether a choice of the output of a video is one of native Dolby Vision, which a 3D
+//! video never has (OutputChoiceAvailable()): its own Dolby Vision over its HDR10+, measured, or
+//! made from HDR10+ or HLG
+constexpr bool NativeChoice(OutputChoice choice)
+{
+  return choice == OutputChoice::DOLBY_VISION || choice == OutputChoice::MEASURED;
+}
 //! Hades: whether an HDR10+ stream is sent as native Dolby Vision, with metadata made from its HDR10+
 //! metadata (videoscreen.hadesdvfromhdr10plus): the setting is on, the user chose no other output
 //! for the video, the display takes native Dolby Vision in a mode that carries it, and it is not sent
diff --git a/xbmc/utils/HadesPlayerInfo.h b/xbmc/utils/HadesPlayerInfo.h
index 798b8ad..477ccc1 100644
--- a/xbmc/utils/HadesPlayerInfo.h
+++ b/xbmc/utils/HadesPlayerInfo.h
@@ -636,9 +636,27 @@ inline std::string BedLayout(const std::string& bed)
  * \param bed the bed of an object-based stream (7.1.2), or empty; one that is no layout of
  *        speakers (BedLayout(): an LFE alone) says nothing, and the channels do
  * \param channels the channels of the stream, where it has no bed
+ * \param decoded (Hades) the sound is decoded to PCM here, not passed through to the receiver
+ *
+ * Dolby Atmos is a bed or core of channels and objects that the receiver renders to its speakers,
+ * its heights included: passed through, the badge says so ("DD+ Atmos 5.1 + objects": E-AC-3 with
+ * Atmos names no bed, and its 5.1 are the channels of its core). Decoded here, FFmpeg decodes the
+ * core alone, without the objects, and the badge says that too ("DD+ 5.1, no Atmos"), so that a
+ * receiver of heights that shows none is explained.
  */
-inline std::string AudioBadge(const std::string& codec, const std::string& bed, int channels)
+inline std::string AudioBadge(const std::string& codec,
+                              const std::string& bed,
+                              int channels,
+                              bool decoded = false)
 {
+  // (Hades) Atmos decoded here: the channels of the core, without its objects
+  const bool atmos = codec == "truehd_atmos" || codec == "eac3_ddp_atmos";
+  if (atmos && decoded)
+  {
+    const std::string core = codec == "truehd_atmos" ? "TrueHD" : "DD+";
+    const std::string layout = ChannelsName(channels);
+    return (layout.empty() ? core : core + " " + layout) + ", no Atmos";
+  }
   static const std::map<std::string, std::string> names{
       {"truehd_atmos", "TrueHD Atmos"}, {"truehd", "Dolby TrueHD"},
       {"eac3_ddp_atmos", "DD+ Atmos"},  {"eac3", "Dolby Digital+"},
@@ -666,7 +684,8 @@ inline std::string AudioBadge(const std::string& codec, const std::string& bed,
   }
   const std::string bedLayout = BedLayout(bed);
   const std::string layout = !bedLayout.empty() ? bedLayout : ChannelsName(channels);
-  return layout.empty() ? name : name + " " + layout;
+  const std::string badge = layout.empty() ? name : name + " " + layout;
+  return atmos ? badge + " + objects" : badge;
 }
 
