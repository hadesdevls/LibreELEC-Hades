From 72be55da6c7b13b735734a596bcfc58ca3702dd6 Mon Sep 17 00:00:00 2001
From: Hades <15710513+hadesdevls@users.noreply.github.com>
Date: Thu, 26 Nov 2026 18:35:13 +0000
Subject: [PATCH] [Hades][dvbridge] The IPT tunnel keeps the I code of a pixel
 as a float

Pass 9 rounded the I of a pixel to its code, a whole number from 0 to
4095 in a float, turned it into an unsigned integer and back into a
float to write it divided by 4096: two conversions for nothing, every
pixel, as the float of the code is the code itself. i_of(), ipt_i() and
ipt_pair() now return that float: the same values, the same bytes.

Measured, the same bytes: the 14 pictures of the profile 7 FEL stream
by both forms of pass 9 and three with the GUI over them (62 files).
radeonsi (ACO, gfx1030), 9c: 676 vector instructions to 668.
---
 tools/dvbridge/dvbridge_source.c | 14 +++++++-------
 1 file changed, 7 insertions(+), 7 deletions(-)

diff --git a/tools/dvbridge/dvbridge_source.c b/tools/dvbridge/dvbridge_source.c
index 80c8526..b8b4d08 100644
--- a/tools/dvbridge/dvbridge_source.c
+++ b/tools/dvbridge/dvbridge_source.c
@@ -1778,10 +1778,10 @@ struct common_uniforms {
     "    hi = vec3(l.x, m.x, s.x);\n"                                                             \
     "    rest = vec3(l.y, m.y, s.y);\n"                                                           \
     "}\n"                                                                                         \
-    "uint i_of(vec3 hi, vec3 rest)\n"                                                             \
+    "float i_of(vec3 hi, vec3 rest)\n"                                                            \
     "{\n"                                                                                         \
     "    float i = (to_ipt * hi).x + (to_ipt * rest).x;\n"                                        \
-    "    return uint(clamp(floor(i * 4096.0 + 0.5), 0.0, 4095.0));\n"                             \
+    "    return clamp(floor(i * 4096.0 + 0.5), 0.0, 4095.0);\n"                                   \
     "}\n"                                                                                         \
     /* P and T from L' - M' and S' - M' (the rows of the inverse of YCCtoRGB that give them sum to 0) */ \
     "uvec2 pt_of(vec3 hi, vec3 rest)\n"                                                           \
@@ -1791,7 +1791,7 @@ struct common_uniforms {
     "    vec2 pt = vec2(ir[1].x * dp.x + ir[1].z * dp.y, ir[2].x * dp.x + ir[2].z * dp.y);\n"     \
     "    return uvec2(clamp(floor(pt * 4096.0 + 0.5) + 2048.0, 0.0, 4095.0));\n"                  \
     "}\n"                                                                                         \
-    "uint ipt_i(float y, vec2 c)\n"                                                               \
+    "float ipt_i(float y, vec2 c)\n"                                                              \
     "{\n"                                                                                         \
     "    vec3 hi, rest;\n"                                                                        \
     "    pq_of(y, c, hi, rest);\n"                                                                \
@@ -1804,7 +1804,7 @@ struct common_uniforms {
     "    return pt_of(hi, rest);\n"                                                               \
     "}\n"                                                                                         \
     /* (9c) I of the even pixel of a pair and the pair's P and T */                               \
-    "uint ipt_pair(float y, vec2 c, out uvec2 pt)\n"                                              \
+    "float ipt_pair(float y, vec2 c, out uvec2 pt)\n"                                             \
     "{\n"                                                                                         \
     "    vec3 hi, rest;\n"                                                                        \
     "    pq_of(y, c, hi, rest);\n"                                                                \
@@ -1841,7 +1841,7 @@ static const char IPT_LUMA[] =
     "        ivec2 acc = accp - accn;\n"
     "        c = vec2(clamp((acc + (1 << 13)) >> 14, ivec2(0), ivec2(4095)));\n"
     "    }\n"
-    "    color = vec4(float(ipt_i(luma_at(q), c)) * (1.0 / code_scale), 0.0, 0.0, 1.0);\n"
+    "    color = vec4(ipt_i(luma_at(q), c) * (1.0 / code_scale), 0.0, 0.0, 1.0);\n"
     "}\n";
 
 /* 9b. P and T of each pair, from its even pixel; fragment (n, i): rows 2 i (rg) and 2 i + 1 (ba) */
@@ -1906,12 +1906,12 @@ static const char IPT_COMPUTE[] =
     "        float i0 = 0.0, i1 = 0.0;\n"
     "        if (active_at(x, r)) {\n"
     "            uvec2 pt;\n"
-    "            i0 = float(ipt_pair(luma_at(ivec2(x, r)), vec2(h == 0 ? even.rg : even.ba), pt))\n"
+    "            i0 = ipt_pair(luma_at(ivec2(x, r)), vec2(h == 0 ? even.rg : even.ba), pt)\n"
     "                 * (1.0 / code_scale);\n"
     "            if (h == 0) out_.rg = pt; else out_.ba = pt;\n"
     "        }\n"
     "        if (active_at(x + 1, r))\n"
-    "            i1 = float(ipt_i(luma_at(ivec2(x + 1, r)), vec2(h == 0 ? odd.xy : odd.zw)))\n"
+    "            i1 = ipt_i(luma_at(ivec2(x + 1, r)), vec2(h == 0 ? odd.xy : odd.zw))\n"
     "                 * (1.0 / code_scale);\n"
     "        imageStore(luma_out, ivec2(x, r), vec4(i0, 0.0, 0.0, 1.0));\n"
     "        if (x + 1 < size.z)\n"
-- 
