From 450e019b97350e6c462be7d79da92047fb638e9a Mon Sep 17 00:00:00 2001
From: sopparus <sopparus@users.noreply.github.com>
Date: Sun, 20 Sep 2026 10:08:22 +0200
Subject: [PATCH] [ActorProtocol] Release messages removed by PurgeIn and
 PurgeOut

Both drop the messages they remove without releasing them, so those objects
return neither to the free message queue nor to the heap: the destructor only
deletes what is in the free queue. Purge() does it correctly, these two do not.

Release them the same way, outside the lock. PurgeOut() also reports how many
messages it removed and can pass each of them to a callback before release,
so callers can tell whether duplicates were queued and what they carried.

Co-Authored-By: Claude Opus 5 <noreply@anthropic.com>
(cherry picked from commit 7687eefa353e9afa6601544df0740ce1fe87792c)
---
 xbmc/utils/ActorProtocol.cpp          |  87 +++++++++++++------
 xbmc/utils/ActorProtocol.h            |   8 +-
 xbmc/utils/test/CMakeLists.txt        |   3 +-
 xbmc/utils/test/TestActorProtocol.cpp | 118 ++++++++++++++++++++++++++
 4 files changed, 187 insertions(+), 29 deletions(-)
 create mode 100644 xbmc/utils/test/TestActorProtocol.cpp

diff --git a/xbmc/utils/ActorProtocol.cpp b/xbmc/utils/ActorProtocol.cpp
index 41ac5d9..5b685f1 100644
--- a/xbmc/utils/ActorProtocol.cpp
+++ b/xbmc/utils/ActorProtocol.cpp
@@ -15,6 +15,22 @@
 
 using namespace Actor;
 
+namespace
+{
+// messages are released outside the protocol's lock, as Purge() does
+void ReleaseMessages(std::queue<Message*>& messages,
+                     const std::function<void(const Message&)>& onRelease = {})
+{
+  while (!messages.empty())
+  {
+    if (onRelease)
+      onRelease(*messages.front());
+    messages.front()->Release();
+    messages.pop();
+  }
+}
+} // namespace
+
 void Message::Release()
 {
   bool skip;
@@ -341,42 +357,59 @@ void Protocol::PurgeIn(int signal)
 {
   Message *msg;
   std::queue<Message*> msgs;
+  std::queue<Message*> purged;
 
-  std::unique_lock lock(criticalSection);
-
-  while (!inMessages.empty())
   {
-    msg = inMessages.front();
-    inMessages.pop();
-    if (msg->signal != signal)
-      msgs.push(msg);
-  }
-  while (!msgs.empty())
-  {
-    msg = msgs.front();
-    msgs.pop();
-    inMessages.push(msg);
+    std::unique_lock lock(criticalSection);
+
+    while (!inMessages.empty())
+    {
+      msg = inMessages.front();
+      inMessages.pop();
+      if (msg->signal != signal)
+        msgs.push(msg);
+      else
+        purged.push(msg);
+    }
+    while (!msgs.empty())
+    {
+      msg = msgs.front();
+      msgs.pop();
+      inMessages.push(msg);
+    }
   }
+
+  ReleaseMessages(purged);
 }
 
-void Protocol::PurgeOut(int signal)
+size_t Protocol::PurgeOut(int signal, const std::function<void(const Message&)>& onPurged)
 {
   Message *msg;
   std::queue<Message*> msgs;
+  std::queue<Message*> purged;
 
-  std::unique_lock lock(criticalSection);
-
-  while (!outMessages.empty())
   {
-    msg = outMessages.front();
-    outMessages.pop();
-    if (msg->signal != signal)
-      msgs.push(msg);
-  }
-  while (!msgs.empty())
-  {
-    msg = msgs.front();
-    msgs.pop();
-    outMessages.push(msg);
+    std::unique_lock lock(criticalSection);
+
+    while (!outMessages.empty())
+    {
+      msg = outMessages.front();
+      outMessages.pop();
+      if (msg->signal != signal)
+        msgs.push(msg);
+      else
+        purged.push(msg);
+    }
+    while (!msgs.empty())
+    {
+      msg = msgs.front();
+      msgs.pop();
+      outMessages.push(msg);
+    }
   }
+
+  const size_t count = purged.size();
+  ReleaseMessages(purged, onPurged);
+
+  return count;
 }
diff --git a/xbmc/utils/ActorProtocol.h b/xbmc/utils/ActorProtocol.h
index 50f3039..7801d68 100644
--- a/xbmc/utils/ActorProtocol.h
+++ b/xbmc/utils/ActorProtocol.h
@@ -11,6 +11,7 @@
 #include "threads/CriticalSection.h"
 
 #include <cstddef>
+#include <functional>
 #include <memory>
 #include <queue>
 #include <string>
@@ -104,7 +105,12 @@ public:
   bool ReceiveInMessage(Message **msg);
   void Purge();
   void PurgeIn(int signal);
-  void PurgeOut(int signal);
+  /*!
+   * \brief Remove queued outgoing messages with this signal
+   * \param onPurged called for each removed message before it is released
+   * \return number of messages removed
+   */
+  size_t PurgeOut(int signal, const std::function<void(const Message&)>& onPurged = {});
   void DeferIn(bool value) { inDefered = value; }
   void DeferOut(bool value) { outDefered = value; }
   void Lock() { criticalSection.lock(); }
