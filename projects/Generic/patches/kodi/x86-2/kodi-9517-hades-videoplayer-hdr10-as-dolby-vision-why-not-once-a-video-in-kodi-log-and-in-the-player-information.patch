diff --git a/xbmc/cores/VideoPlayer/DVDCodecs/Video/DVPlaybackPolicy.h b/xbmc/cores/VideoPlayer/DVDCodecs/Video/DVPlaybackPolicy.h
index cbb6010..8925416 100644
--- a/xbmc/cores/VideoPlayer/DVDCodecs/Video/DVPlaybackPolicy.h
+++ b/xbmc/cores/VideoPlayer/DVDCodecs/Video/DVPlaybackPolicy.h
@@ -1747,6 +1747,38 @@ inline bool Hdr10PlusAsDolbyVisionFor(bool settingOn,
 {
   return settingOn && nativeAllowed && nativeOutput && !displaySentHdr10Plus;
 }
+/*!
+ * \brief Hades: why Hdr10PlusAsDolbyVision() does not send an HDR10+ stream as native Dolby Vision, in the
+ *        order it decides: "choice" (the user chose another output for the video than AUTOMATIC or
+ *        DOLBY_VISION), "off" (videoscreen.hadesdvfromhdr10plus is off and the video has AUTOMATIC),
+ *        "nodv" (no native Dolby Vision on this output in a mode that carries it: the reason of the
+ *        output is CWinSystemGbm::NativeDVOutputReason()), "hdr10plus" (the display is sent HDR10+, and
+ *        gets the video's own; DOLBY_VISION for the video, "HDR output (this video)", sends it as
+ *        Dolby Vision all the same); ""
+ *        where it is sent so. The same verdict as Hdr10PlusAsDolbyVisionFor(), with its reason.
+ * \param nativeOutput, displaySentHdr10Plus as for Hdr10PlusAsDolbyVisionFor() (asked only where
+ *        the choice and the setting want it)
+ */
+constexpr const char* Hdr10PlusAsDolbyVisionWhy(bool settingOn,
+                                                OutputChoice choice,
+                                                bool nativeOutput,
+                                                bool displaySentHdr10Plus)
+{
+  const bool chosen = choice == OutputChoice::DOLBY_VISION;
+  if (!chosen && choice != OutputChoice::AUTOMATIC)
+    return "choice";
+  if (!chosen && !settingOn)
+    return "off";
+  if (!nativeOutput)
+    return "nodv";
+  if (!chosen && displaySentHdr10Plus)
+    return "hdr10plus";
+  return "";
+}
+//! Hades: Hdr10PlusAsDolbyVisionWhy() for the video that plays, as Hdr10PlusAsDolbyVision() last decided
+//! it (once its demuxer found HDR10+ metadata); "" where it was sent so or nothing was decided yet. For
+//! the player information; any thread.
+std::string Hdr10PlusAsDolbyVisionWhyNow();
 //! Hades: whether an HDR10 stream without HDR10+ or Dolby Vision metadata is sent as native Dolby
 //! Vision, with metadata that Hades measures from the picture as it plays
 //! (videoscreen.hadesdvfromhdr10, dvbridge_measured.h): the setting is on, the user chose no other
diff --git a/xbmc/cores/VideoPlayer/DVDDemuxers/DVDDemuxFFmpeg.cpp b/xbmc/cores/VideoPlayer/DVDDemuxers/DVDDemuxFFmpeg.cpp
index a9db9eb..4af7871 100644
--- a/xbmc/cores/VideoPlayer/DVDDemuxers/DVDDemuxFFmpeg.cpp
+++ b/xbmc/cores/VideoPlayer/DVDDemuxers/DVDDemuxFFmpeg.cpp
@@ -1912,10 +1912,10 @@ void CDVDDemuxFFmpeg::ProbeHdr10Plus(CDemuxStream* stream,
   DVBRIDGE::Hdr10PlusFound();
   if (!DVBRIDGE::Hdr10PlusAsDolbyVision())
   {
+    // (Hades: why, said once a video at the info level by Hdr10PlusAsDolbyVision())
     CLog::Log(LOGDEBUG,
-              "CDVDDemuxFFmpeg: stream {} has HDR10+ metadata; not sent as Dolby Vision (the setting "
-              "is off, or the display takes HDR10+, or no native Dolby Vision)",
-              streamIdx);
+              "CDVDDemuxFFmpeg: stream {} has HDR10+ metadata; not sent as Dolby Vision ({})",
+              streamIdx, DVBRIDGE::Hdr10PlusAsDolbyVisionWhyNow());
     return;
   }
   AVDOVIDecoderConfigurationRecord record{};
diff --git a/xbmc/utils/HadesPlayerInfo.h b/xbmc/utils/HadesPlayerInfo.h
index 399ee7b..c98bb664 100644
--- a/xbmc/utils/HadesPlayerInfo.h
+++ b/xbmc/utils/HadesPlayerInfo.h
@@ -104,6 +104,9 @@ struct SummaryInput
   //! the video went back to 2D), "dvipt" (Dolby Vision profile 20 whose base layer is no picture by
   //! itself: one view is rebuilt), or empty
   std::string secondView;
+  //! Hades: why an HDR10+ video was not sent as Dolby Vision (DVBRIDGE::Hdr10PlusAsDolbyVisionWhy()):
+  //! off, choice, nodv, hdr10plus, or empty (it was, or nothing was decided)
+  std::string hdr10PlusAsDv;
 };
 
 //! One thing worth saying about the playback
@@ -113,11 +116,12 @@ struct Note
   //! dv_not_native, hdr_to_sdr, hdr_not_sent, frames_failed, frames_dropped, frames_skipped,
   //! frames_gpu, frames_buffering, step_down, fel_resync,
   //! rate_mismatch, audio_decoded, unknown_output, hdr_as_sdr, second_view (Hades: its arg is
-  //! SummaryInput::secondView)
+  //! SummaryInput::secondView), hdr10plus_not_dv (Hades: its arg is SummaryInput::hdr10PlusAsDv)
   std::string code;
   std::string arg; //!< the reason, or the number, that the sentence has in it
   //! what to do about it: tv, mode, choice, rate, ratemode, hdr, sync, system, converteron,
-  //! convertertry, port, hdrassdr (Hades: the setting "Play HDR videos as SDR"); or empty
+  //! convertertry, port, hdrassdr (Hades: the setting "Play HDR videos as SDR"), dvthisvideo (Hades:
+  //! Dolby Vision chosen for the video); or empty
   std::string todo;
 };
 
@@ -167,6 +171,23 @@ inline std::string TodoForReason(const std::string& reason)
   return "";
 }
 
+/*!
+ * \brief Hades: what to do about an HDR10+ video that "Play HDR10+ videos as Dolby Vision" did not send
+ *        as Dolby Vision: Dolby Vision chosen for the video, where the display takes HDR10+
+ *        (dvthisvideo); the choice of the video again (choice); for no native Dolby Vision, what the
+ *        reason of the output says (TodoForReason())
+ */
+inline std::string Hdr10PlusAsDvTodo(const std::string& why, const std::string& dvReason)
+{
+  if (why == "hdr10plus")
+    return "dvthisvideo";
+  if (why == "choice")
+    return "choice";
+  if (why == "nodv")
+    return TodoForReason(dvReason);
+  return "";
+}
+
 /*!
  * \brief What to do about a reason that the sound is decoded where it could be passed through: the
  *        sync to the display (sync), passthrough turned off (passthrough) or turned off for this
@@ -325,6 +346,13 @@ inline std::vector<Note> Notes(const SummaryInput& in)
   // Hades: an HDR video sent as SDR by the user's choice: not a fault, said with where it is chosen
   if (in.hdrAsSdr && !dv)
     note.push_back({Severity::NOTE, "hdr_as_sdr", "", "hdrassdr"});
+  // Hades: an HDR10+ video that "Play HDR10+ videos as Dolby Vision", on, did not send as Dolby Vision:
+  // why (nothing where the setting is off, which says it all; nothing is lost: it plays as HDR10+ or
+  // HDR10)
+  if (in.source == "hdr10plus" && in.dvState != "native" && in.signal != "dv" &&
+      !in.hdr10PlusAsDv.empty() && in.hdr10PlusAsDv != "off")
+    note.push_back({Severity::NOTE, "hdr10plus_not_dv", in.hdr10PlusAsDv,
+                    Hdr10PlusAsDvTodo(in.hdr10PlusAsDv, in.dvReason)});
   if (!in.audioWhy.empty())
     note.push_back({Severity::NOTE, "audio_decoded", in.audioWhy, AudioTodo(in.audioWhy)});
   // what the display is told could not be read (the connector has no such property): the page
diff --git a/xbmc/windowing/gbm/WinSystemGbmGLESContext.cpp b/xbmc/windowing/gbm/WinSystemGbmGLESContext.cpp
index f5ad164..cdd42c6 100644
--- a/xbmc/windowing/gbm/WinSystemGbmGLESContext.cpp
+++ b/xbmc/windowing/gbm/WinSystemGbmGLESContext.cpp
@@ -3457,6 +3457,11 @@ std::atomic<int> g_dvStreamOrigin{0};
 std::atomic<bool> g_dvHdr10Needed{false};
 // Hades: HLG sent as Dolby Vision was said in the log for the video that plays (HlgAsDolbyVision())
 std::atomic<bool> g_dvHlgTold{false};
+// Hades: why the HDR10+ video that plays is not sent as Dolby Vision (Hdr10PlusAsDolbyVisionWhy(), as
+// Hdr10PlusAsDolbyVision() last decided it), and whether kodi.log said so for this video
+std::mutex g_dvHdr10PlusWhyLock;
+std::string g_dvHdr10PlusWhy;
+std::atomic<bool> g_dvHdr10PlusWhyTold{false};
 // Hades: a picture of it was refused for its base layer (DVBRIDGE::BaseLayerRefused())
 std::atomic<bool> g_dvBaseRefused{false};
 // Hades: ... and, for the labels named as in the CoreELEC builds (guilib/guiinfo/CoreELECLabels.h,
@@ -3662,6 +3667,11 @@ void DVBRIDGE::NewVideo()
   g_dvStreamPq = false;
   g_dvStreamHlg = false;
   g_dvHlgTold = false;
+  {
+    std::unique_lock lock(g_dvHdr10PlusWhyLock);
+    g_dvHdr10PlusWhy.clear();
+  }
+  g_dvHdr10PlusWhyTold = false;
   {
     std::unique_lock lock(g_dvMemoryLock);
     g_dvFileKey.clear();
@@ -4297,14 +4307,46 @@ bool DVBRIDGE::Hdr10PlusAsDolbyVision()
   // display takes HDR10+; any choice but that and AUTOMATIC keeps the stream as it is)
   const OutputChoice choice = GetOutputChoice();
   const bool chosen = choice == OutputChoice::DOLBY_VISION;
-  if (!chosen && (choice != OutputChoice::AUTOMATIC ||
-                  !BoolSetting(SettingsNow(), CSettings::SETTING_VIDEOSCREEN_HADESDVFROMHDR10PLUS,
-                               false)))
-    return false;
+  const bool setting =
+      BoolSetting(SettingsNow(), CSettings::SETTING_VIDEOSCREEN_HADESDVFROMHDR10PLUS, false);
   auto* window = dynamic_cast<CWinSystemGbmGLESContext*>(CServiceBroker::GetWinSystem());
-  return window && Hdr10PlusAsDolbyVisionFor(
-                       true, true, window->SupportsNativeDVOutput(true),
-                       !chosen && window->GetDisplayHDRCapabilities().SupportsHDR10Plus());
+  const bool wanted = chosen || (choice == OutputChoice::AUTOMATIC && setting);
+  const bool native = wanted && window && window->SupportsNativeDVOutput(true);
+  const bool sentHdr10Plus =
+      native && !chosen && window->GetDisplayHDRCapabilities().SupportsHDR10Plus();
+  // Hades: and why not, for the player information and once a video in kodi.log (the demuxer asks
+  // when it has looked at the stream, not for each picture)
+  const std::string why = Hdr10PlusAsDolbyVisionWhy(setting, choice, native, sentHdr10Plus);
+  {
+    std::unique_lock lock(g_dvHdr10PlusWhyLock);
+    g_dvHdr10PlusWhy = why;
+  }
+  if (!why.empty() && !g_dvHdr10PlusWhyTold.exchange(true))
+  {
+    if (why == "off")
+      CLog::Log(LOGINFO, "DVBridge: an HDR10+ video is not sent as Dolby Vision: \"Play HDR10+ "
+                         "videos as Dolby Vision\" is off (videoscreen.hadesdvfromhdr10plus)");
+    else if (why == "choice")
+      CLog::Log(LOGINFO, "DVBridge: an HDR10+ video is not sent as Dolby Vision: another output "
+                         "was chosen for this video");
+    else if (why == "hdr10plus")
+      CLog::Log(LOGINFO,
+                "DVBridge: an HDR10+ video is not sent as Dolby Vision: the display takes HDR10+ "
+                "and gets the video's own HDR10+ metadata; Dolby Vision in \"HDR output (this "
+                "video)\" sends it as Dolby Vision for this video");
+    else
+      CLog::Log(LOGINFO,
+                "DVBridge: an HDR10+ video is not sent as Dolby Vision: this output has no native "
+                "Dolby Vision ({}; the line of native Dolby Vision output above says why)",
+                window ? window->NativeDVOutputReason() : std::string("no window system"));
+  }
+  return why.empty();
+}
