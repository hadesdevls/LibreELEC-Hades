From 6bd95cff1bc70982477908750c55ec1b53e13694 Mon Sep 17 00:00:00 2001
From: Hades <15710513+hadesdevls@users.noreply.github.com>
Date: Wed, 18 Nov 2026 01:17:18 +0000
Subject: [PATCH] windowing/gbm: tell at INFO why a hot-plug is left alone,
 once per change

After a hot-plug event of the display in use, Kodi decides whether to
turn the output of an NVIDIA card off and on again, so that the driver
sets the link up from scratch (HotplugRelink.h, the fix of issue #11 in
RC6). The verdicts that do something, or that a display answered, were
told at INFO; those that say why nothing is done were told at DEBUG:
the display is not there after the event (NOT_CONNECTED), the output is
off (OFF), the connector does not drive its display as HDMI (NOT_HDMI),
the link has nothing written to the display (NOT_SCRAMBLED).

Issue #24 (2026-11-13): the "No Signal" after the TV was turned off came
back with 1.0 on the RTX 3050 and LG B7 of #11, and the log at the
default level had no line of the hot-plug: whether Kodi saw the event,
and why it did nothing, could not be told. A TV that keeps its hot-plug
low for more than the 2 s that Kodi waits leaves by NOT_CONNECTED or
OFF without a word.

Those four are now told at INFO when the event before had another
verdict (HOTPLUG_RELINK::AtInfo(); the first event counts as a change),
and at DEBUG when it repeats, so that a display that keeps its hot-plug
low, or a DisplayPort monitor, fills no log. The verdicts of the build
and the driver (SETTING_OFF, NOT_NVIDIA) stay at DEBUG. Nothing that is
decided changes.

Tested on the host (the tree has no tests of the GBM windowing headers):
4 tests pass, three mutants are caught.
---
 xbmc/windowing/gbm/HotplugRelink.h            | 25 +++++++++++++++++++
 .../windowing/gbm/WinSystemGbmGLESContext.cpp |  5 +++-
 xbmc/windowing/gbm/WinSystemGbmGLESContext.h  |  2 ++
 3 files changed, 31 insertions(+), 1 deletion(-)

diff --git a/xbmc/windowing/gbm/HotplugRelink.h b/xbmc/windowing/gbm/HotplugRelink.h
index ad16022..8a51a8c 100644
--- a/xbmc/windowing/gbm/HotplugRelink.h
+++ b/xbmc/windowing/gbm/HotplugRelink.h
@@ -360,4 +360,29 @@ inline bool TellsAtInfo(Verdict v)
   return v == Verdict::SINK_KEPT || v == Verdict::ECHO || v == Verdict::OTHER_OUTPUT ||
          v == Verdict::TOO_SOON || v == Verdict::NATIVE_DV;
 }
+
+/*!
+ * \brief Whether the verdict is told at INFO where the event before had another one: the display not
+ *        there after the event, the output off, a connector not driven as HDMI, a link with nothing
+ *        written to the display
+ *
+ * They were told at DEBUG only. Issue #24 (2026-11-13): the "No Signal" after the TV was turned off,
+ * which RC6 had fixed for that RTX 3050 and LG B7, came back with 1.0, and the log at the default
+ * level had no line of the hot-plug at all: whether Kodi saw the event, and why it did nothing, could
+ * not be told. Once for each change, so that a display that keeps its hot-plug low, or a DisplayPort
+ * monitor, fills no log. The verdicts of the build and the driver (SETTING_OFF, NOT_NVIDIA) stay at
+ * DEBUG.
+ */
+inline bool TellsAtInfoOnChange(Verdict v)
+{
+  return v == Verdict::NOT_HDMI || v == Verdict::NOT_CONNECTED || v == Verdict::OFF ||
+         v == Verdict::NOT_SCRAMBLED;
+}
+
+//! The level of a verdict: INFO for TellsAtInfo(), and for TellsAtInfoOnChange() where it is not the
+//! verdict of the event before (before: that one; none for the first event)
+inline bool AtInfo(Verdict v, std::optional<Verdict> before)
+{
+  return TellsAtInfo(v) || (TellsAtInfoOnChange(v) && before != v);
+}
 } // namespace HOTPLUG_RELINK
diff --git a/xbmc/windowing/gbm/WinSystemGbmGLESContext.cpp b/xbmc/windowing/gbm/WinSystemGbmGLESContext.cpp
index f38debc..617dc13 100644
--- a/xbmc/windowing/gbm/WinSystemGbmGLESContext.cpp
+++ b/xbmc/windowing/gbm/WinSystemGbmGLESContext.cpp
@@ -1891,11 +1891,14 @@ void CWinSystemGbmGLESContext::RelinkDecide(HOTPLUG_RELINK::Facts facts,
   if (!connector)
     return;
   const HOTPLUG_RELINK::Verdict verdict = HOTPLUG_RELINK::Decide(facts);
+  // (Hades: the verdicts that say why nothing is done, at INFO once for each change)
+  const std::optional<HOTPLUG_RELINK::Verdict> before = m_relinkVerdict;
+  m_relinkVerdict = verdict;
   const std::string name = connector->GetName();
   if (verdict != HOTPLUG_RELINK::Verdict::RELINK)
   {
     if (const char* why = HOTPLUG_RELINK::Why(verdict))
-      CLog::Log(HOTPLUG_RELINK::TellsAtInfo(verdict) ? LOGINFO : LOGDEBUG,
+      CLog::Log(HOTPLUG_RELINK::AtInfo(verdict, before) ? LOGINFO : LOGDEBUG,
                 "Hot-plug: after the event, the output of {} is not turned off and on again: {}{}",
                 name, why, scdc.empty() ? std::string() : " (" + scdc + ")");
     return;
diff --git a/xbmc/windowing/gbm/WinSystemGbmGLESContext.h b/xbmc/windowing/gbm/WinSystemGbmGLESContext.h
index 1cf8f1f..32a2ede 100644
--- a/xbmc/windowing/gbm/WinSystemGbmGLESContext.h
+++ b/xbmc/windowing/gbm/WinSystemGbmGLESContext.h
@@ -529,6 +529,8 @@ private:
   //! it), the facts that it is for, and when it began
   std::future<HOTPLUG_RELINK::ScdcRead> m_relinkRead;
   HOTPLUG_RELINK::Facts m_relinkFacts;
+  //! ... and the verdict of the event before (HOTPLUG_RELINK::AtInfo()); none before the first
+  std::optional<HOTPLUG_RELINK::Verdict> m_relinkVerdict;
   std::chrono::steady_clock::time_point m_relinkReadAt{};
   //! Hades: HDR of more than 8 bits that the parameters of nvidia-modeset made (HdrMoreBits.h):
   //! what went out in the mode of the last depth question (ProbeOutputDepth()), and whether the
-- 
