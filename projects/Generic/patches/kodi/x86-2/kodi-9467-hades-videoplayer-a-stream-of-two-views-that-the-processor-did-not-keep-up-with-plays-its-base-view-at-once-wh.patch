From a786584ec719662a2ef0d5584219cd8b5863e84e Mon Sep 17 00:00:00 2001
From: Hades <15710513+hadesdevls@users.noreply.github.com>
Date: Thu, 26 Nov 2026 04:39:38 +0000
Subject: [PATCH] [Hades][VideoPlayer] A stream of two views that the processor
 did not keep up with plays its base view at once when it opens again

Where the processor does not decode both views of a 3D stream in time,
the stream goes back to its base view in 2D. A change of the output of
the video in the player information (O) opens its video stream again,
and the decoder of both views was tried again each time: seconds of a
picture that juddered before it went back to 2D again (a Radeon 780M
laptop, a Dolby Vision 3D film: three times in a minute, after "As SDR"
and "as the settings say").

The stream given up for slowness (by the processor, not NVDEC) is now
kept with its file and size, and while the same file plays, opening it
again plays its base view at once, in 2D, and says so in kodi.log ("the
processor did not decode both views of this stream in time earlier: its
base view plays at once, in 2D") and in the player information, as the
first time. Another file forgets it, so that both views are tried again
there.
---
 .../DVDCodecs/Video/DVDVideoCodecFFmpeg.cpp   | 42 ++++++++++++++++++-
 .../DVDCodecs/Video/DVDVideoCodecFFmpeg.h     |  4 ++
 xbmc/cores/VideoPlayer/MultiviewChoice.h      | 24 +++++++++++
 3 files changed, 69 insertions(+), 1 deletion(-)

diff --git a/xbmc/cores/VideoPlayer/DVDCodecs/Video/DVDVideoCodecFFmpeg.cpp b/xbmc/cores/VideoPlayer/DVDCodecs/Video/DVDVideoCodecFFmpeg.cpp
index 6e67d75..db7a042 100644
--- a/xbmc/cores/VideoPlayer/DVDCodecs/Video/DVDVideoCodecFFmpeg.cpp
+++ b/xbmc/cores/VideoPlayer/DVDCodecs/Video/DVDVideoCodecFFmpeg.cpp
@@ -620,6 +620,20 @@ bool CDVDVideoCodecFFmpeg::Open(CDVDStreamInfo &hints, CDVDCodecOptions &options
   bool multiview = hints.multiview &&
                    (hints.codec == AV_CODEC_ID_H264 || hints.codec == AV_CODEC_ID_HEVC) &&
                    !m_multiviewFailed;
+  // (Hades: asked of every stream that opens, so that another file forgets it)
+  const bool stillSlow = StillSlow(hints);
+  // Hades: the processor did not decode both views of this stream in time before: its base view at
+  // once, when the stream is opened again (KODI::MULTIVIEW::SlowStream)
+  if (multiview && stillSlow)
+  {
+    multiview = false;
+    m_multiviewFailed = true;
+    CServiceBroker::GetDataCacheCore().SetVideoSecondView("slow");
+    CLog::Log(LOGINFO,
+              "CDVDVideoCodecFFmpeg::Open() the processor did not decode both views of this "
+              "stream in time earlier: its base view plays at once, in 2D (both views are tried "
+              "again once another file has played)");
+  }
   if (multiview)
   {
     pCodec = KODI::MULTIVIEW::DecoderOfTwoViews(hints.codec);
@@ -1006,6 +1020,28 @@ const char* CDVDVideoCodecFFmpeg::MultiviewDecoderName() const
                                            : KODI::MULTIVIEW::DECODER_NAME;
 }
 
+namespace
+{
+// Hades: the stream whose two views the processor did not decode in time (KODI::MULTIVIEW::SlowStream)
+std::mutex g_slowLock;
+KODI::MULTIVIEW::SlowStream g_slow;
+} // namespace
+
+bool CDVDVideoCodecFFmpeg::StillSlow(const CDVDStreamInfo& hints)
+{
+  std::unique_lock lock(g_slowLock);
+  // (another file forgets it: KODI::MULTIVIEW::SlowStream)
+  if (g_slow.file != hints.filename)
+    g_slow = {};
+  return KODI::MULTIVIEW::StillSlow(g_slow, hints.filename, hints.width, hints.height);
+}
+
+void CDVDVideoCodecFFmpeg::KeepSlow(const CDVDStreamInfo& hints)
+{
+  std::unique_lock lock(g_slowLock);
+  g_slow = {hints.filename, hints.width, hints.height};
+}
+
 CDVDVideoCodec::VCReturn CDVDVideoCodecFFmpeg::LeaveMultiview()
 {
   // Hades: where NVDEC gave the views and they could not be had (not for slowness: the processor
@@ -1016,9 +1052,13 @@ CDVDVideoCodec::VCReturn CDVDVideoCodecFFmpeg::LeaveMultiview()
             "CDVDVideoCodecFFmpeg: the decoder of both views is given up for this stream ({}): "
             "its base view plays, as before",
             m_multiview->Reason());
-  // Hades: ... in 2D; the player information says why where the processor did not keep up
+  // Hades: ... in 2D; the player information says why where the processor did not keep up, and
+  // the stream plays its base view at once if it is opened again while this file plays
   if (m_multiview->Slow())
+  {
     CServiceBroker::GetDataCacheCore().SetVideoSecondView("slow");
+    KeepSlow(m_hints);
+  }
   av_frame_unref(m_pDecodedFrame);
   m_multiviewFailed = true;
   // The stream is opened again as at first: with the decoder of every other stream, and with
diff --git a/xbmc/cores/VideoPlayer/DVDCodecs/Video/DVDVideoCodecFFmpeg.h b/xbmc/cores/VideoPlayer/DVDCodecs/Video/DVDVideoCodecFFmpeg.h
index c727807..7bf840d 100644
--- a/xbmc/cores/VideoPlayer/DVDCodecs/Video/DVDVideoCodecFFmpeg.h
+++ b/xbmc/cores/VideoPlayer/DVDCodecs/Video/DVDVideoCodecFFmpeg.h
@@ -294,6 +294,10 @@ protected:
   //! views copied from the card (DownloadView(), m_viewDownload); FFmpeg no longer offered it
   //! (GetFormat()); it failed for this stream, which outlives Dispose() as m_multiviewFailed does
   bool m_multiviewNvdec = false;
+  //! Hades: the stream whose two views the processor did not decode in time while its file plays
+  //! (KODI::MULTIVIEW::SlowStream): asked when the stream opens, kept when it is given up so
+  static bool StillSlow(const CDVDStreamInfo& hints);
+  static void KeepSlow(const CDVDStreamInfo& hints);
   //! Hades: the time spent in the decoder of both views that the processor runs since the last
   //! picture of two views (CMultiviewPacker::Paced())
   std::chrono::steady_clock::duration m_multiviewBusy{};
diff --git a/xbmc/cores/VideoPlayer/MultiviewChoice.h b/xbmc/cores/VideoPlayer/MultiviewChoice.h
index 46ce6b5..fb81317 100644
--- a/xbmc/cores/VideoPlayer/MultiviewChoice.h
+++ b/xbmc/cores/VideoPlayer/MultiviewChoice.h
@@ -15,6 +15,7 @@
 #include <numeric>
 #include <optional>
 #include <span>
+#include <string>
 #include <string_view>
 #include <vector>
 
@@ -1635,6 +1636,29 @@ inline bool Paced(Pace& pace, bool late, bool judged)
   return pace.slowWindows >= PACE_SLOW_WINDOWS;
 }
 
+/*!
+ * \brief Hades: the stream whose two views the processor did not decode in time (Worked(),
+ *        Paced()), kept while the same file plays
+ *
+ * A change of the output of a video in the player information opens its video stream again, and
+ * the decoder of both views was tried again each time: seconds of a picture that judders before
+ * the stream went back to 2D again (a Radeon 780M laptop: three times in a minute). The same
+ * stream of the same file is opened for its base view at once instead, until another file is
+ * played. Not where NVDEC decoded the views: it is not the processor.
+ */
+struct SlowStream
+{
+  std::string file;
+  int width{0};
+  int height{0};
+};
+
+//! Hades: whether a stream is the one kept in SlowStream (a file of no name never is)
+inline bool StillSlow(const SlowStream& slow, const std::string& file, int width, int height)
+{
+  return !file.empty() && slow.file == file && slow.width == width && slow.height == height;
+}
+
 //! Hades: pictures after a start or a seek before the work of the decoder is measured (its threads
 //! fill, and the first pictures of each cost more)
 inline constexpr unsigned int WORK_SKIP = 8;
