From 21117a688147fced917b3b0e8394e0e40033754b Mon Sep 17 00:00:00 2001
From: =?UTF-8?q?Markus=20H=C3=A4rer?= <markus.haerer@gmx.net>
Date: Tue, 10 Nov 2026 01:44:29 +0100
Subject: [PATCH] [guilib] Mark children drawn outside of a grouplist dirty
 with it

The children of a grouplist can be drawn outside of its render region:
its size is limited to its content while they are drawn up to its clip
size, and a list without a size doesn't clip them at all. When the list
or one of its parent groups was shown, hidden or faded, only the render
region was marked dirty and these children weren't redrawn. E.g. stale
labels remained on a widget switch in Arctic Zephyr Mod's home.

Track the region the children are drawn in separately and mark it along
with the control. The render regions stay as they are, so no control is
marked more often than before.

(cherry picked from commit 20329269792a037dc04fb06ff0560dcc5afbd1d5)
(cherry picked from commit 8706e5667721d048d11efa3b0e496e1a1dcf2c96)
---
 xbmc/guilib/GUIControl.cpp          |  9 ++++-----
 xbmc/guilib/GUIControl.h            |  4 ++++
 xbmc/guilib/GUIControlGroup.cpp     | 11 +++++++++++
 xbmc/guilib/GUIControlGroup.h       |  2 ++
 xbmc/guilib/GUIControlGroupList.cpp |  7 +++++++
 5 files changed, 28 insertions(+), 5 deletions(-)

diff --git a/xbmc/guilib/GUIControl.cpp b/xbmc/guilib/GUIControl.cpp
index b7e2271..509c5b7 100644
--- a/xbmc/guilib/GUIControl.cpp
+++ b/xbmc/guilib/GUIControl.cpp
@@ -127,7 +127,8 @@ void CGUIControl::DynamicResourceAlloc(bool bOnOff)
 // 3. reset the animation transform
 void CGUIControl::DoProcess(unsigned int currentTime, CDirtyRegionList &dirtyregions)
 {
-  CRect dirtyRegion = m_renderRegion;
+  const CRect renderRegion = m_renderRegion;
+  CRect dirtyRegion = GetDrawnRegion();
 
   bool changed = (m_controlDirtyState & DIRTY_STATE_CONTROL) != 0 || (m_bInvalidated && IsVisible());
   m_controlDirtyState = 0;
@@ -162,11 +163,9 @@ void CGUIControl::DoProcess(unsigned int currentTime, CDirtyRegionList &dirtyreg
     Process(currentTime, dirtyregions);
     m_bInvalidated = false;
 
-    if (dirtyRegion != m_renderRegion)
-    {
-      dirtyRegion.Union(m_renderRegion);
+    if (renderRegion != m_renderRegion)
       changed = true;
-    }
+    dirtyRegion.Union(GetDrawnRegion());
 
     if (m_hasCamera)
       CServiceBroker::GetWinSystem()->GetGfxContext().RestoreCameraPosition();
diff --git a/xbmc/guilib/GUIControl.h b/xbmc/guilib/GUIControl.h
index 83de23e..1dd5179 100644
--- a/xbmc/guilib/GUIControl.h
+++ b/xbmc/guilib/GUIControl.h
@@ -192,6 +192,10 @@ public:
   /*! \brief return the render region in screen coordinates of this control
    */
   const CRect& GetRenderRegion() const { return m_renderRegion; }
+  /*! \brief return the region in screen coordinates this control and its children are drawn in
+   Marked dirty when the control itself changed
+   */
+  virtual CRect GetDrawnRegion() const { return m_renderRegion; }
   /*! \brief calculate the render region in parentcontrol coordinates of this control
    Called during process to update m_renderRegion
    */
diff --git a/xbmc/guilib/GUIControlGroup.cpp b/xbmc/guilib/GUIControlGroup.cpp
index 09fbec8..8c68a5a 100644
--- a/xbmc/guilib/GUIControlGroup.cpp
+++ b/xbmc/guilib/GUIControlGroup.cpp
@@ -91,13 +91,17 @@ void CGUIControlGroup::Process(unsigned int currentTime, CDirtyRegionList &dirty
   CServiceBroker::GetWinSystem()->GetGfxContext().SetOrigin(pos.x, pos.y);
 
   CRect rect;
+  m_childRegion = CRect();
   for (auto *control : m_children)
   {
     control->UpdateVisibility(nullptr);
     unsigned int oldDirty = dirtyregions.size();
     control->DoProcess(currentTime, dirtyregions);
     if (control->IsVisible() || (oldDirty != dirtyregions.size())) // visible or dirty (was visible?)
+    {
       rect.Union(control->GetRenderRegion());
+      m_childRegion.Union(control->GetDrawnRegion());
+    }
   }
 
   CServiceBroker::GetWinSystem()->GetGfxContext().RestoreOrigin();
@@ -105,6 +109,13 @@ void CGUIControlGroup::Process(unsigned int currentTime, CDirtyRegionList &dirty
   m_renderRegion = rect;
 }
 
+CRect CGUIControlGroup::GetDrawnRegion() const
+{
+  CRect region = m_renderRegion;
+  region.Union(m_childRegion);
+  return region;
+}
+
 void CGUIControlGroup::Render()
 {
   CPoint pos(GetPosition());
diff --git a/xbmc/guilib/GUIControlGroup.h b/xbmc/guilib/GUIControlGroup.h
index 3d808f1..dfe03ed 100644
--- a/xbmc/guilib/GUIControlGroup.h
+++ b/xbmc/guilib/GUIControlGroup.h
@@ -31,6 +31,7 @@ public:
   CGUIControlGroup* Clone() const override { return new CGUIControlGroup(*this); }
 
   void Process(unsigned int currentTime, CDirtyRegionList &dirtyregions) override;
+  CRect GetDrawnRegion() const override;
   void Render() override;
   void RenderEx() override;
   bool OnAction(const CAction &action) override;
@@ -92,6 +93,7 @@ protected:
   bool m_defaultAlways;
   int m_focusedControl;
   bool m_renderFocusedLast;
+  CRect m_childRegion; ///< region the children are drawn in, in screen coordinates
 private:
   typedef std::vector< std::vector<CGUIControl *> * > COLLECTORTYPE;
 
diff --git a/xbmc/guilib/GUIControlGroupList.cpp b/xbmc/guilib/GUIControlGroupList.cpp
index 697d894..b3fd8a4 100644
--- a/xbmc/guilib/GUIControlGroupList.cpp
+++ b/xbmc/guilib/GUIControlGroupList.cpp
@@ -101,6 +101,7 @@ void CGUIControlGroupList::Process(unsigned int currentTime, CDirtyRegionList &d
   // we run through the controls, rendering as we go
   int index = 0;
   float pos = GetAlignOffset();
+  m_childRegion = CRect();
   for (iControls it = m_children.begin(); it != m_children.end(); ++it)
   {
     // note we render all controls, even if they're offscreen, as then they'll be updated
@@ -114,6 +115,7 @@ void CGUIControlGroupList::Process(unsigned int currentTime, CDirtyRegionList &d
 
     if (control->IsVisible())
     {
+      m_childRegion.Union(control->GetDrawnRegion());
       if (IsControlOnScreen(pos, control))
       {
         if (control->HasFocus())
@@ -126,6 +128,11 @@ void CGUIControlGroupList::Process(unsigned int currentTime, CDirtyRegionList &d
     CServiceBroker::GetWinSystem()->GetGfxContext().RestoreOrigin();
   }
   CGUIControl::Process(currentTime, dirtyregions);
+  // children are drawn up to the clip size, which can exceed the render region, and a list
+  // without a size doesn't clip them at all
+  const CRect clip(m_posX, m_posY, m_posX + m_width, m_posY + m_height);
+  if (!clip.IsEmpty())
+    m_childRegion.Intersect(CServiceBroker::GetWinSystem()->GetGfxContext().GenerateAABB(clip));
 }
 
 void CGUIControlGroupList::Render()
-- 
