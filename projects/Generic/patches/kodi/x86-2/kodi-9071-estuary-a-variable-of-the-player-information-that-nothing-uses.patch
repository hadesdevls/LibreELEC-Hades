From 51700ef148684abcb3b329ab5ee970b0a88cbe32 Mon Sep 17 00:00:00 2001
From: Hades <15710513+hadesdevls@users.noreply.github.com>
Date: Wed, 18 Nov 2026 07:04:16 +0000
Subject: [PATCH] estuary: a variable of the player information that nothing
 uses

HadesPlayerInfoSubVar (the mode of the output and the audio, joined with
a middle dot) was the line under the heading of the overview page of
before the panel in one frame; nothing has used it since. It is taken
out of Variables.xml; the pages that make-playerinfo.py makes for other
skins never had it.
---
 addons/skin.estuary/xml/Variables.xml | 4 ----
 1 file changed, 4 deletions(-)

diff --git a/addons/skin.estuary/xml/Variables.xml b/addons/skin.estuary/xml/Variables.xml
index 758c8d3..d800213 100644
--- a/addons/skin.estuary/xml/Variables.xml
+++ b/addons/skin.estuary/xml/Variables.xml
@@ -1034,10 +1034,6 @@
 		<value condition="String.IsEqual(Window(Home).Property(hades.audio.bits),float)">PCM, $INFO[Window(Home).Property(hades.audio.channels)] x $INFO[Window(Home).Property(hades.audio.rate),, kHz], $LOCALIZE[31823]</value>
 		<value>PCM, $INFO[Window(Home).Property(hades.audio.channels)] x $INFO[Window(Home).Property(hades.audio.rate),, kHz]$INFO[Window(Home).Property(hades.audio.bits),$COMMA , bits]</value>
 	</variable>
-	<variable name="HadesPlayerInfoSubVar">
-		<value condition="!String.IsEmpty(Window(Home).Property(hades.audio.path))">$INFO[Window(Home).Property(hades.out.mode),, · ]$VAR[HadesAudioOutVar]</value>
-		<value>$INFO[Window(Home).Property(hades.out.mode)]</value>
-	</variable>
 	<variable name="HadesDVL2Var">
 		<value condition="String.IsEqual(Window(Home).Property(hades.dv.l2),0)">$LOCALIZE[31838]</value>
 		<value>$INFO[Window(Home).Property(hades.dv.l2)]$INFO[Window(Home).Property(hades.dv.l2targets),: , nits]</value>
-- 
