diff --git a/xbmc/dialogs/GUIDialogPlayerProcessInfo.cpp b/xbmc/dialogs/GUIDialogPlayerProcessInfo.cpp
index 3f32e0d..0546005 100644
--- a/xbmc/dialogs/GUIDialogPlayerProcessInfo.cpp
+++ b/xbmc/dialogs/GUIDialogPlayerProcessInfo.cpp
@@ -29,6 +29,18 @@
 #include "utils/XBMCTinyXML.h"
 #include "utils/log.h"
 
+#include <array>
+
+namespace
+{
+// Hades: the animations that keep the panel processed in every frame while they run: every type of Kodi's
+// (VisibleEffect.h) but none, which Kodi runs only in the frames that process their control
+constexpr std::array<ANIMATION_TYPE, 7> ANIMATIONS = {ANIM_TYPE_WINDOW_OPEN, ANIM_TYPE_WINDOW_CLOSE,
+                                                      ANIM_TYPE_VISIBLE,     ANIM_TYPE_HIDDEN,
+                                                      ANIM_TYPE_FOCUS,       ANIM_TYPE_UNFOCUS,
+                                                      ANIM_TYPE_CONDITIONAL};
+} // namespace
+
 CGUIDialogPlayerProcessInfo::CGUIDialogPlayerProcessInfo(void)
     : CGUIDialog(WINDOW_DIALOG_PLAYER_PROCESS_INFO, "DialogPlayerProcessInfo.xml")
 {
@@ -119,7 +131,12 @@ void CGUIDialogPlayerProcessInfo::ReadTemperaturesAhead(std::string_view xml)
 bool CGUIDialogPlayerProcessInfo::ProcessDue(unsigned int currentTime)
 {
   return m_refresh.Due(currentTime, m_moves || m_closing || IsAnimating(ANIM_TYPE_WINDOW_OPEN) ||
-                                        IsAnimating(ANIM_TYPE_WINDOW_CLOSE));
+                                        IsAnimating(ANIM_TYPE_WINDOW_CLOSE) || Animates(*this));
+}
+
+bool CGUIDialogPlayerProcessInfo::Animates(const CGUIControlGroup& group)
+{
+  return CPlayerInfoRefresh::Animates<CGUIControlGroup, CGUIControl>(group, ANIMATIONS);
 }
 
 void CGUIDialogPlayerProcessInfo::DoProcess(unsigned int currentTime, CDirtyRegionList& dirtyregions)
diff --git a/xbmc/dialogs/GUIDialogPlayerProcessInfo.h b/xbmc/dialogs/GUIDialogPlayerProcessInfo.h
index 6bc0432..1f4266b 100644
--- a/xbmc/dialogs/GUIDialogPlayerProcessInfo.h
+++ b/xbmc/dialogs/GUIDialogPlayerProcessInfo.h
@@ -34,6 +34,9 @@ public:
   //! a text box that scrolls its lines, a multi-image), so that the panel is processed in every frame
   //! while it does (CPlayerInfoRefresh)
   static bool Moves(const CGUIControlGroup& group);
+  //! Hades: whether a control of a group, shown, animates or is about to (CPlayerInfoRefresh::Animates()), so that the
+  //! panel is processed in every frame while it does: the animations of a skin's own panel run as before
+  static bool Animates(const CGUIControlGroup& group);
 
 protected:
   void OnWindowLoaded() override;
diff --git a/xbmc/dialogs/PlayerInfoRefresh.h b/xbmc/dialogs/PlayerInfoRefresh.h
index 128f38b..70f2e6a 100644
--- a/xbmc/dialogs/PlayerInfoRefresh.h
+++ b/xbmc/dialogs/PlayerInfoRefresh.h
@@ -27,6 +27,10 @@
  * Now()), and in every frame while something of it moves by itself (busy: its window opening or
  * closing, a text that scrolls), so that what it shows moves as before.
  *
+ * Hades: and in every frame while a control of it animates, or is about to (Animates()): Kodi runs the
+ * animation of a control only in the frames that process it, so that the animations of a skin's own panel
+ * (a fade when a row shows or hides, a focus, a conditional one) would run at four frames a second.
+ *
  * Only the thread of the GUI calls it. This header only decides and counts; a test builds it on the
  * host (tools/regress/kodi-host).
  */
@@ -59,6 +63,36 @@ public:
   //! the panel opens: its first frame is processed, and the counts begin again
   void Reset() { *this = CPlayerInfoRefresh(); }
 
+  /*!
+   * \brief Hades: whether a control of a group animates, or is about to (busy for Due())
+   *
+   * An animation of a control runs (types: every type of animation, Kodi's ANIMATION_TYPE but none), or a condition of
+   * a control has changed since it was last processed, so that one starts as soon as it is (its visibility, the
+   * condition of a conditional animation: Control::ConditionsChanged()). Only the controls that a processed frame
+   * would process are looked at: those of a group that is shown, as Kodi processes them (a group that is not shown has
+   * its own animations and conditions looked at, not those of its controls).
+   * Group: Children() (pointers to Control); Control: IsAnimating(type), ConditionsChanged(), IsVisible(), IsGroup();
+   * a control that IsGroup() is a Group (Kodi: CGUIControlGroup, CGUIControl).
+   */
+  template<typename Group, typename Control, typename Types>
+  static bool Animates(const Group& group, const Types& types)
+  {
+    for (Control* control : group.Children())
+    {
+      if (!control)
+        continue;
+      for (const auto type : types)
+        if (control->IsAnimating(type))
+          return true;
+      if (control->ConditionsChanged())
+        return true;
+      if (control->IsGroup() && control->IsVisible() &&
+          Animates<Group, Control>(*static_cast<const Group*>(control), types))
+        return true;
+    }
+    return false;
+  }
+
 private:
   bool m_now = true;
   bool m_processed = false;
diff --git a/xbmc/guilib/GUIControl.cpp b/xbmc/guilib/GUIControl.cpp
index 2e86942..b7e2271 100644
--- a/xbmc/guilib/GUIControl.cpp
+++ b/xbmc/guilib/GUIControl.cpp
@@ -692,6 +692,19 @@ bool CGUIControl::UpdateColors(const CGUIListItem* item)
   return m_diffuseColor.Update(item);
 }
 
+bool CGUIControl::ConditionsChanged() const
+{
+  if (m_visibleCondition &&
+      m_visibleCondition->Get(INFO::DEFAULT_CONTEXT, nullptr) != m_visibleFromSkinCondition)
+    return true;
+  for (const CAnimation& anim : m_animations)
+  {
+    if (anim.GetType() == ANIM_TYPE_CONDITIONAL && anim.ConditionChanged())
+      return true;
+  }
+  return false;
+}
+
 void CGUIControl::SetInitialVisibility()
 {
   if (m_visibleCondition)
