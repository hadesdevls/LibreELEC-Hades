+++ b/xbmc/dialogs/GUIDialogHadesPlayerInfo.cpp
@@ -68,7 +68,8 @@ void CGUIDialogHadesPlayerInfo::OnWindowLoaded()
 bool CGUIDialogHadesPlayerInfo::ProcessDue(unsigned int currentTime)
 {
   return m_refresh.Due(currentTime, m_moves || m_closing || IsAnimating(ANIM_TYPE_WINDOW_OPEN) ||
-                                        IsAnimating(ANIM_TYPE_WINDOW_CLOSE));
