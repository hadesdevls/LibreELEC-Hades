index 55823b0..83de23e 100644
--- a/xbmc/guilib/GUIControl.h
+++ b/xbmc/guilib/GUIControl.h
@@ -229,6 +229,10 @@ public:
   bool HasVisibleCondition() const { return m_visibleCondition != NULL; }
   void SetEnableCondition(const std::string &expression);
   virtual void UpdateVisibility(const CGUIListItem *item);
+  //! Hades: whether a condition of the control has changed since UpdateVisibility() last looked at it, so that an
+  //! animation of it starts when it is next processed (its visibility, the condition of a conditional animation);
+  //! nothing is changed (CPlayerInfoRefresh::Animates())
+  bool ConditionsChanged() const;
   virtual void SetInitialVisibility();
   virtual void SetEnabled(bool bEnable);
   virtual void SetInvalid() { m_bInvalidated = true; }
diff --git a/xbmc/guilib/VisibleEffect.cpp b/xbmc/guilib/VisibleEffect.cpp
index a07ef7d..c6c9fbf 100644
--- a/xbmc/guilib/VisibleEffect.cpp
+++ b/xbmc/guilib/VisibleEffect.cpp
@@ -645,6 +645,11 @@ void CAnimation::UpdateCondition(const CGUIListItem *item)
   m_lastCondition = condition;
 }
 
+bool CAnimation::ConditionChanged() const
+{
+  return m_condition && m_condition->Get(INFO::DEFAULT_CONTEXT) != m_lastCondition;
+}
+
 void CAnimation::SetInitialCondition()
 {
   m_lastCondition = m_condition ? m_condition->Get(INFO::DEFAULT_CONTEXT) : false;
diff --git a/xbmc/guilib/VisibleEffect.h b/xbmc/guilib/VisibleEffect.h
index cf60cf0..4cb92ae 100644
--- a/xbmc/guilib/VisibleEffect.h
+++ b/xbmc/guilib/VisibleEffect.h
@@ -180,6 +180,8 @@ public:
 
   bool CheckCondition();
   void UpdateCondition(const CGUIListItem *item = NULL);
+  //! Hades: whether the condition has changed since UpdateCondition() last looked at it (nothing is changed)
+  bool ConditionChanged() const;
   void SetInitialCondition();
 
