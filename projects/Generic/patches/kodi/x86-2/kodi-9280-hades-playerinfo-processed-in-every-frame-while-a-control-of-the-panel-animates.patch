 xbmc/dialogs/GUIDialogPlayerProcessInfo.cpp | 19 +++++++++++-
 xbmc/dialogs/GUIDialogPlayerProcessInfo.h   |  3 ++
 xbmc/dialogs/PlayerInfoRefresh.h            | 34 +++++++++++++++++++++
 xbmc/guilib/GUIControl.cpp                  | 13 ++++++++
 xbmc/guilib/GUIControl.h                    |  4 +++
 xbmc/guilib/VisibleEffect.cpp               |  5 +++
 xbmc/guilib/VisibleEffect.h                 |  2 ++
 8 files changed, 81 insertions(+), 2 deletions(-)

