From 2874987c9d98ef4e1499da78fe1567bfb62e9623 Mon Sep 17 00:00:00 2001
From: Hades <15710513+hadesdevls@users.noreply.github.com>
Date: Thu, 19 Nov 2026 08:41:37 +0000
Subject: [PATCH] [Hades][GBM] A video that "Always" refused for the mode of
 the menus keeps the mode it got

With "Video at its own rate with VRR" at "Always", a mode of the menus
set while HDMI VRR was off keeps a fixed refresh, so the first video
after the setting is changed is refused and Kodi changes the mode to its
rate, which allows VRR again. Kodi asks again when the first picture
comes (CRenderManager::GetResolution()), and that second answer took
the video back to the mode of the menus with VRR: two changes of mode
(an LG C5: 3840x2160 at 23.976 Hz,
then at 120 Hz).

Where VRR_VIDEO::RefusedForModeSetOnly() says that this was the only
reason, the rest of that video keeps the mode it got; the hold ends
with the video (out of the full-screen video, or no video on its way to
the screen for 3 s after it had been), and the next video goes with
VRR. The wanted rate also keeps the display's VRR minimum, for the
player information.
---
 xbmc/windowing/gbm/VrrVideo.h       | 17 +++++++++++
 xbmc/windowing/gbm/WinSystemGbm.cpp | 45 ++++++++++++++++++++++++++---
 xbmc/windowing/gbm/WinSystemGbm.h   |  7 +++++
 3 files changed, 65 insertions(+), 4 deletions(-)

diff --git a/xbmc/windowing/gbm/VrrVideo.h b/xbmc/windowing/gbm/VrrVideo.h
index fe89337..fd4f7fc 100644
--- a/xbmc/windowing/gbm/VrrVideo.h
+++ b/xbmc/windowing/gbm/VrrVideo.h
@@ -417,6 +417,23 @@ inline Verdict Decide(const Query& q)
   return v;
 }
 
+/*!
+ * \brief Whether a refusal holds for the rest of the video: it was refused only because the mode of
+ *        the menus was set with HDMI VRR off (Query::hdmiVrrOffInMode). The change of mode of that
+ *        video allows VRR again, and Kodi asks again once its first picture comes
+ *        (CRenderManager::GetResolution()): taken then, the video went back to the mode of the menus,
+ *        a second change of mode (the LG C5 with "Always", 2026-11-19 02:50:09: 3840x2160 at 23.976
+ *        Hz, then at 120 Hz). The video keeps the mode it got; the next one goes with VRR.
+ */
+inline bool RefusedForModeSetOnly(const Query& q)
+{
+  if (!q.hdmiVrrOffInMode)
+    return false;
+  Query without = q;
+  without.hdmiVrrOffInMode = false;
+  return Decide(without).use;
+}
+
 /*!
  * \brief The times of the flips: slot n at first + n periods, in ns of one clock, with no error that
  *        grows with n
diff --git a/xbmc/windowing/gbm/WinSystemGbm.cpp b/xbmc/windowing/gbm/WinSystemGbm.cpp
index 9c51e69..251413c 100644
--- a/xbmc/windowing/gbm/WinSystemGbm.cpp
+++ b/xbmc/windowing/gbm/WinSystemGbm.cpp
@@ -4315,14 +4315,17 @@ bool CWinSystemGbm::TakeVideoAtOwnRate(float fps,
   // VRR did not come on in the first second of this video (JudgeVrrStart()): its mode is chosen as
   // without the setting, until its playback ends
   bool refused = false;
+  bool heldForModeSet = false;
   bool tellRefused = false;
   {
     std::unique_lock lock(m_vrrLock);
     refused = m_vrrRefused;
-    if (refused)
+    heldForModeSet = m_vrrHeldForModeSet;
+    if (refused || heldForModeSet)
     {
       m_vrrWanted = {};
-      const std::string key = StringUtils::Format("refused|{:.3f}", fps);
+      const std::string key =
+          StringUtils::Format("{}|{:.3f}", refused ? "refused" : "modeset", fps);
       tellRefused = key != m_vrrToldKey;
       m_vrrToldKey = key;
     }
@@ -4339,6 +4342,18 @@ bool CWinSystemGbm::TakeVideoAtOwnRate(float fps,
                           : "changes the mode as Kodi chooses it without VRR");
     return false;
   }
+  // (Hades: the video was refused only because the mode of the menus had HDMI VRR off: it keeps the
+  // mode it got, one change of mode, until its playback ends; VRR_VIDEO::RefusedForModeSetOnly())
+  if (heldForModeSet)
+  {
+    if (tellRefused)
+      CLog::Log(LOGINFO,
+                "VRR video: {:.3f} fps keeps the mode it got for this video: the mode of the menus "
+                "had HDMI VRR off when it started, and going back to it now would be a second "
+                "change of mode; the next video goes with VRR",
+                fps);
+    return false;
+  }
   q.fps = fps;
   q.progressive = progressive;
   q.is3D = is3D;
@@ -4419,12 +4434,23 @@ bool CWinSystemGbm::TakeVideoAtOwnRate(float fps,
   const std::string key = StringUtils::Format(
       "{:.3f}|{}|{}|{:.3f}|{}", fps, v.use, v.why ? v.why : "", v.rate, static_cast<int>(v.pacing));
   bool tell = false;
+  // (refused only for the mode of the menus set with HDMI VRR off: the rest of this video keeps the
+  // mode that Kodi chooses now; only "Always", which asks before Kodi's choice)
+  const bool holdForModeSet = !v.use && !automatic && RefusedForModeSetOnly(q);
   {
     std::unique_lock lock(m_vrrLock);
     m_vrrWanted = {};
     if (v.use)
-      m_vrrWanted = {true,      v.rate,        fps, v.multiple,
-                     v.pacing,  v.mediaTarget, static_cast<double>(q.guiRefresh)};
+      m_vrrWanted = {true,
+                     v.rate,
+                     fps,
+                     v.multiple,
+                     v.pacing,
+                     v.mediaTarget,
+                     static_cast<double>(q.guiRefresh),
+                     q.vrrMin};
+    if (holdForModeSet)
+      m_vrrHeldForModeSet = true;
     tell = key != m_vrrToldKey;
     m_vrrToldKey = key;
   }
@@ -4474,6 +4500,8 @@ void CWinSystemGbm::EndVideoAtOwnRate()
   std::unique_lock lock(m_vrrLock);
   m_vrrWanted = {};
   m_vrrToldKey.clear();
+  m_vrrHeldForModeSet = false;
+  m_vrrHeldSawVideo = false;
   // (a refusal holds for the video that had it, until no video is on its way to the screen
   // (PaceVrrVideo()): a full screen left and taken again while it plays does not try VRR, and
   // change the mode, again)
@@ -4646,6 +4674,15 @@ std::optional<int64_t> CWinSystemGbm::PaceVrrVideo()
       m_vrrApplied = static_cast<int>(Applied::NONE);
       m_vrrRefusedFps = 0.0;
     }
+    // (the hold for the mode set ends with its video: once it has been on its way to the screen and
+    // then gone for 3 s; a stream that takes long to bring its first picture keeps it)
+    if (m_vrrHeldForModeSet && videoRendering)
+      m_vrrHeldSawVideo = true;
+    if (m_vrrHeldForModeSet && m_vrrHeldSawVideo && videoGone)
+    {
+      m_vrrHeldForModeSet = false;
+      m_vrrHeldSawVideo = false;
+    }
     wanted = m_vrrWanted;
   }
   const bool want = Paced(wanted.use, crtc != nullptr, GetGfxContext().IsFullScreenVideo(),
diff --git a/xbmc/windowing/gbm/WinSystemGbm.h b/xbmc/windowing/gbm/WinSystemGbm.h
index bba280e..e028fd6 100644
--- a/xbmc/windowing/gbm/WinSystemGbm.h
+++ b/xbmc/windowing/gbm/WinSystemGbm.h
@@ -561,6 +561,7 @@ protected:
     KODI::WINDOWING::GBM::VRR_VIDEO::Pacing pacing = KODI::WINDOWING::GBM::VRR_VIDEO::Pacing::NONE;
     unsigned int mediaTarget = 0;
     double modeRefresh = 0.0; //!< the refresh rate of the mode of the menus, which stays
+    int vrrMin = 0; //!< the display's VRR minimum, in Hz (for the player information)
   };
   mutable std::mutex m_vrrLock;
   VrrWanted m_vrrWanted;
@@ -568,6 +569,12 @@ protected:
   //! VRR did not come on in the first second of this video (VRR_VIDEO::CStartCheck): its mode is
   //! chosen as without the setting until the playback ends (under m_vrrLock)
   bool m_vrrRefused = false;
+  //! the video was refused only because the mode of the menus was set with HDMI VRR off
+  //! (VRR_VIDEO::RefusedForModeSetOnly()): it keeps the mode it got until its playback ends (under
+  //! m_vrrLock)
+  bool m_vrrHeldForModeSet = false;
+  bool m_vrrHeldSawVideo = false; //!< ... and its video has been on its way to the screen since
+
   //! what became of VRR for the video at its own rate (VRR_VIDEO::Applied), for the player
   //! information; any thread
   std::atomic<int> m_vrrApplied{static_cast<int>(KODI::WINDOWING::GBM::VRR_VIDEO::Applied::NONE)};
-- 
