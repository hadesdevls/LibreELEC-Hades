From b3dd9567b7e25dda1322474fb6423c7267bdf61e Mon Sep 17 00:00:00 2001
From: Hades <15710513+hadesdevls@users.noreply.github.com>
Date: Thu, 26 Nov 2026 15:00:37 +0000
Subject: [PATCH] [Hades][Estuary] Player information: the row of the projector
 fits the longest modes of a JVC

The row of the projector control on the System page of the player
information has two lines of 400 px for what the control selected:
"JVC: memory 10 for 2.39:1 (measured), mode Frame Adapt HDR3", with
the longest picture modes of a JVC (Frame Adapt HDR2 and HDR3), took a
third line in English, and its end was cut (measured with Estuary's
fonts, as the check of the panel measures every row). With the
anamorphic mode after the number of the memory ("memory 10 + D") the
text is longer still.

Its name, "Projector" ("Proyector" in Spanish, 102 px), takes 115 of the
130 px of its column: the value now has 415 px, and every text of the
row fits two lines in English and in the three Spanish languages. The
row keeps its height, so the page keeps its length.

The dialog of the player information for other skins
(system/hades/DialogHadesPlayerInfo.xml) is made again from Estuary's
files with tools/hades-playerinfo/make-playerinfo.py.
---
 addons/skin.estuary/xml/DialogPlayerProcessInfo.xml |  6 +++---
 system/hades/DialogHadesPlayerInfo.xml              | 12 ++++++------
 2 files changed, 9 insertions(+), 9 deletions(-)

diff --git a/addons/skin.estuary/xml/DialogPlayerProcessInfo.xml b/addons/skin.estuary/xml/DialogPlayerProcessInfo.xml
index c8685e4..98f01b0 100644
--- a/addons/skin.estuary/xml/DialogPlayerProcessInfo.xml
+++ b/addons/skin.estuary/xml/DialogPlayerProcessInfo.xml
@@ -3355,15 +3355,15 @@
 						<param name="ruletop" value="-3.5"/>
 						<param name="valuemax" value="71"/>
 					</include>
-					<!-- Hades: the control of a projector over the network, while it is on (with the display, under its TV rows): the lens memory and the picture mode it selected, or what stands in the way (network/ProjectorControl.h, read by the window system) -->
+					<!-- Hades: the control of a projector over the network, while it is on (with the display, under its TV rows): the lens memory and the picture mode it selected, or what stands in the way (network/ProjectorControl.h, read by the window system); its value 415 px wide (400 up to 1.2.2): the longest modes of a JVC ("Frame Adapt HDR3") after a lens memory and its anamorphic mode in two lines -->
 					<include content="HadesPanelRowText">
 						<param name="name" value="$ADDON[skin.estuary 54780]"/>
 						<param name="value" value="$INFO[Window(Home).Property(hades.video.projector)]"/>
 						<param name="visible" value="!String.IsEmpty(Window(Home).Property(hades.video.projector))"/>
 						<param name="flash" value="video.projector"/>
 						<param name="width" value="530"/>
-						<param name="namewidth" value="130"/>
-						<param name="valuewidth" value="400"/>
+						<param name="namewidth" value="115"/>
+						<param name="valuewidth" value="415"/>
 						<param name="rowheight" value="32"/>
 						<param name="valuetop" value="-1"/>
 						<param name="ruletop" value="-2"/>
diff --git a/system/hades/DialogHadesPlayerInfo.xml b/system/hades/DialogHadesPlayerInfo.xml
index 7abbe03..14c2f88 100644
--- a/system/hades/DialogHadesPlayerInfo.xml
+++ b/system/hades/DialogHadesPlayerInfo.xml
@@ -13724,12 +13724,12 @@
 						<control type="group">
 							<left>0</left>
 							<top>0</top>
-							<width>130</width>
+							<width>115</width>
 							<height>0</height>
 							<control type="label">
 								<left>0</left>
 								<top>0</top>
-								<width>130</width>
+								<width>115</width>
 								<height>32</height>
 								<aligny>center</aligny>
 								<font>font10</font>
@@ -13743,9 +13743,9 @@
 							</control>
 						</control>
 						<control type="textbox">
-							<left>130</left>
+							<left>115</left>
 							<top>-1</top>
-							<width>400</width>
+							<width>415</width>
 							<height min="1" max="65">auto</height>
 							<align>right</align>
 							<font>font10</font>
@@ -13754,9 +13754,9 @@
 							<visible>!String.IsEqual(Window(Home).Property(hades.f.video.projector),1)</visible>
 						</control>
 						<control type="textbox">
-							<left>130</left>
+							<left>115</left>
 							<top>-1</top>
-							<width>400</width>
+							<width>415</width>
 							<height min="1" max="65">auto</height>
 							<align>right</align>
 							<font>font10</font>
-- 
2.53.0

