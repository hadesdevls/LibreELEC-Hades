From 2759639255213ccb844eedd8554713f9eab0acde Mon Sep 17 00:00:00 2001
From: Hades <15710513+hadesdevls@users.noreply.github.com>
Date: Tue, 24 Nov 2026 15:53:41 +0000
Subject: [PATCH] [Hades][GBM][GLES] The GUI composite goes before its context,
 and its FBO follows the depth buffer

Upstream 02022842090b ("[GLES] Extract shared HDR GUI compositor", Garrett
Brown, Piers #30626) moves the FBO, the shader and the LUTs of the HDR GUI
composite out of the GBM GLES context into a class of their own,
CGuiCompositeGLES. In Hades the composite lives in the context together
with what native Dolby Vision output, the reuse of the GUI pass and the
tile masks add to it, and that move is not made here. The two changes of
behaviour that come with it are taken:

- The FBO is made again when its depth attachment changes (front-to-back
  rendering turned on or off), not only when its size does. Before, an
  FBO made without a depth buffer stayed without one.
- Its GL objects (FBO, shader and LUTs, and Hades' tile mask) are deleted
  while their context is current, before the window system takes it
  down, instead of by the destructor after it. Upstream does it in
  DestroyRenderSystem(); here it is DestroyWindowSystem(), after native
  Dolby Vision output has ended there (which may still set the composite
  up) and before CWinSystemGbmEGLContext destroys the context.
---
 .../windowing/gbm/WinSystemGbmGLESContext.cpp | 36 +++++++++++++++++--
 xbmc/windowing/gbm/WinSystemGbmGLESContext.h  |  7 ++++
 2 files changed, 40 insertions(+), 3 deletions(-)

diff --git a/xbmc/windowing/gbm/WinSystemGbmGLESContext.cpp b/xbmc/windowing/gbm/WinSystemGbmGLESContext.cpp
index 9de604a..eb43e3d 100644
--- a/xbmc/windowing/gbm/WinSystemGbmGLESContext.cpp
+++ b/xbmc/windowing/gbm/WinSystemGbmGLESContext.cpp
@@ -2378,6 +2378,7 @@ bool CWinSystemGbmGLESContext::SetGuiCompositing(int colorTransfer)
     m_guiFbo.Cleanup();
     m_guiFboWidth = 0;
     m_guiFboHeight = 0;
+    m_guiFboAttachDepth = false;
     m_compositeShader.reset();
     if (m_guiMask)
     {
@@ -2518,10 +2519,13 @@ bool CWinSystemGbmGLESContext::BeginGuiComposite(bool guiWillRender)
   int width = m_nWidth;
   int height = m_nHeight;
 
-  // create or recreate FBO if size changed
-  if (!m_guiFbo.IsValid() || m_guiFboWidth != width || m_guiFboHeight != height)
+  // create or recreate FBO if size or attachments changed
+  const bool attachDepth = GetEnabledFrontToBackRendering();
+  if (!m_guiFbo.IsValid() || m_guiFboWidth != width || m_guiFboHeight != height ||
+      m_guiFboAttachDepth != attachDepth)
   {
     m_guiFbo.Cleanup();
+    m_guiFboAttachDepth = false;
 
     if (!m_guiFbo.Initialize())
     {
@@ -2537,7 +2541,7 @@ bool CWinSystemGbmGLESContext::BeginGuiComposite(bool guiWillRender)
       return false;
     }
 
-    if (GetEnabledFrontToBackRendering() && !m_guiFbo.AttachDepthBuffer(width, height))
+    if (attachDepth && !m_guiFbo.AttachDepthBuffer(width, height))
     {
       CLog::Log(LOGERROR,
                 "CWinSystemGbmGLESContext: failed to attach depth buffer to GUI FBO {}x{}", width,
@@ -2548,6 +2552,7 @@ bool CWinSystemGbmGLESContext::BeginGuiComposite(bool guiWillRender)
 
     m_guiFboWidth = width;
     m_guiFboHeight = height;
+    m_guiFboAttachDepth = attachDepth;
     m_guiFboClean = false; // fresh FBO is undefined, force a clear
     m_guiSeen = false;
     ++m_guiGen;
@@ -11419,6 +11424,7 @@ bool CWinSystemGbmGLESContext::DestroyWindowSystem()
   m_dvL5InFlight = 0;
   m_dvBridge.reset();
   EndDVConversion();
+  ReleaseGuiComposite();
   return CWinSystemGbmEGLContext::DestroyWindowSystem();
 }
 #else
@@ -11426,8 +11432,32 @@ bool CWinSystemGbmGLESContext::OutputMoveBlocked() const
 {
   return CWinSystemGbm::OutputMoveBlocked() || m_guiCompositing || m_flipOutputOff;
 }
+
+bool CWinSystemGbmGLESContext::DestroyWindowSystem()
+{
+  ReleaseGuiComposite();
+  return CWinSystemGbmEGLContext::DestroyWindowSystem();
+}
 #endif
 
+void CWinSystemGbmGLESContext::ReleaseGuiComposite()
+{
+  // (after native Dolby Vision output has ended above, which may still set the composite up;
+  // left to the destructor, they would be deleted after the context)
+  m_guiFbo.Cleanup();
+  m_guiFboWidth = 0;
+  m_guiFboHeight = 0;
+  m_guiFboAttachDepth = false;
+  m_compositeShader.reset();
+  if (m_guiMask)
+  {
+    dvbridge_guimask_destroy(m_guiMask);
+    m_guiMask = nullptr;
+    m_hdrMaskPending = false;
+  }
+  m_guiCompositing = false;
+}
+
 bool CWinSystemGbmGLESContext::CreateContext()
 {
   const EGLint version = (m_renderableType == EGL_OPENGL_ES3_BIT) ? 3 : 2;
diff --git a/xbmc/windowing/gbm/WinSystemGbmGLESContext.h b/xbmc/windowing/gbm/WinSystemGbmGLESContext.h
index a383b4b..e9e928c 100644
--- a/xbmc/windowing/gbm/WinSystemGbmGLESContext.h
+++ b/xbmc/windowing/gbm/WinSystemGbmGLESContext.h
@@ -510,12 +510,17 @@ public:
   }
   void FinishDVBridgeRendering() override;
   void WaitDVBridgeFlip() override;
+#else
+  bool DestroyWindowSystem() override;
 #endif
 
 protected:
   void SetVSyncImpl(bool enable) override {}
   void PresentRenderImpl(bool rendered) override {};
   bool CreateContext() override;
+  //! The GL objects of the GUI composite (FBO, shader and LUTs, tile mask) are deleted with the
+  //! context they were made in current, before the window system takes it down
+  void ReleaseGuiComposite();
 #ifdef HAVE_DVBRIDGE
   int VideoOutputBitDepth(const VideoPicture* picture) const override;
   bool NativeDVOutputInUse() const override { return m_outputHandover.HoldsOutput(); }
@@ -628,6 +633,8 @@ private:
   CFrameBufferObject m_guiFbo;
   int m_guiFboWidth{0};
   int m_guiFboHeight{0};
+  //! Whether the GUI FBO has a depth buffer (front-to-back rendering); a change makes it again
+  bool m_guiFboAttachDepth{false};
   // True when the GUI FBO is empty (no draws this frame); CompositeGui skips composite when true.
   bool m_guiFboClean{false};
   //! Hades: the elements that the GUI pass of this frame drew into the FBO, counted where it ends
-- 
