From 1db262c3e45cb50c55df2a16b53d6ba6538b5c25 Mon Sep 17 00:00:00 2001
From: Hades <15710513+hadesdevls@users.noreply.github.com>
Date: Wed, 18 Nov 2026 06:24:37 +0000
Subject: [PATCH] windowing/gbm: the names of the properties of VRR video no
 longer hide Pacing

VrrVideo.h named nvidia-drm's properties NV_VRR_MEDIA and
NV_FLIP_TIME_RAW_NS as MEDIA and FLIP_TIME, in the same namespace as the
enumerators Pacing::MEDIA and Pacing::FLIP_TIME, which -Wshadow reports
when the host test of "Video at its own rate with VRR" is built with it.
The constants are VRR_MEDIA and FLIP_TIME_RAW_NS now, as the properties
are named; the strings and every use are the same.
---
 xbmc/windowing/gbm/VrrVideo.h       |  4 ++--
 xbmc/windowing/gbm/WinSystemGbm.cpp | 14 +++++++-------
 2 files changed, 9 insertions(+), 9 deletions(-)

diff --git a/xbmc/windowing/gbm/VrrVideo.h b/xbmc/windowing/gbm/VrrVideo.h
index 8cfe5ed..3a1fc4f 100644
--- a/xbmc/windowing/gbm/VrrVideo.h
+++ b/xbmc/windowing/gbm/VrrVideo.h
@@ -51,9 +51,9 @@ namespace KODI::WINDOWING::GBM::VRR_VIDEO
 
 constexpr const char* SETTING = "videoscreen.hadesvrrvideo";
 //! nvidia-drm: the time of a flip, in ns of CLOCK_MONOTONIC_RAW (nvidia-open-kernel-modules-9076)
-constexpr const char* FLIP_TIME = "NV_FLIP_TIME_RAW_NS";
+constexpr const char* FLIP_TIME_RAW_NS = "NV_FLIP_TIME_RAW_NS";
 //! nvidia-drm: Media VRR for the mode set of the head, where the GPU has it (same patch)
-constexpr const char* MEDIA = "NV_VRR_MEDIA";
+constexpr const char* VRR_MEDIA = "NV_VRR_MEDIA";
 //! nvidia-drm: the rate of Media VRR that the flips ask for (Hz << 1, bit 0 for 1.001)
 constexpr const char* MEDIA_TARGET = "NV_VRR_MEDIA_TARGET";
 //! The rate is at least this much above the display's VRR minimum, so that no refresh comes as late
diff --git a/xbmc/windowing/gbm/WinSystemGbm.cpp b/xbmc/windowing/gbm/WinSystemGbm.cpp
index fff1b81..f75e83f 100644
--- a/xbmc/windowing/gbm/WinSystemGbm.cpp
+++ b/xbmc/windowing/gbm/WinSystemGbm.cpp
@@ -4206,9 +4206,9 @@ bool CWinSystemGbm::TakeVideoAtOwnRate(float fps,
   {
     q.vrrCapable = connector->GetPropertyValue("vrr_capable") == 1u;
     q.crtcVrrEnabled = crtc->SupportsProperty("VRR_ENABLED");
-    q.flipTime = crtc->SupportsProperty(FLIP_TIME);
+    q.flipTime = crtc->SupportsProperty(FLIP_TIME_RAW_NS);
     q.nvidia = q.flipTime || connector->SupportsProperty(CHdmiVrrOff::PROPERTY);
-    q.media = crtc->SupportsProperty(MEDIA_TARGET) && crtc->GetPropertyValue(MEDIA) == 1u;
+    q.media = crtc->SupportsProperty(MEDIA_TARGET) && crtc->GetPropertyValue(VRR_MEDIA) == 1u;
   }
   q.hdmiVrrAllowed = HdmiVrrAllowedBySetting();
   if (const auto info = DisplayInfo())
@@ -4289,7 +4289,7 @@ void CWinSystemGbm::StageVrrMediaMode()
 {
   auto drm = std::dynamic_pointer_cast<CDRMAtomic>(m_DRM);
   CDRMCrtc* crtc = drm ? drm->GetCrtc() : nullptr;
-  if (!crtc || !drm->ModesetPending() || !crtc->SupportsProperty(VRR_VIDEO::MEDIA))
+  if (!crtc || !drm->ModesetPending() || !crtc->SupportsProperty(VRR_VIDEO::VRR_MEDIA))
     return;
   const auto component = CServiceBroker::GetSettingsComponent();
   const auto settings = component ? component->GetSettings() : nullptr;
@@ -4298,11 +4298,11 @@ void CWinSystemGbm::StageVrrMediaMode()
               settings->GetBool(CSettings::SETTING_VIDEOSCREEN_HADESVRRVIDEO)
           ? 1
           : 0;
-  if (crtc->GetPropertyValue(VRR_VIDEO::MEDIA) == want)
+  if (crtc->GetPropertyValue(VRR_VIDEO::VRR_MEDIA) == want)
     return;
-  if (drm->AddProperty(crtc, VRR_VIDEO::MEDIA, want))
+  if (drm->AddProperty(crtc, VRR_VIDEO::VRR_MEDIA, want))
     CLog::Log(LOGINFO, "VRR video: Media VRR is {} for the mode set of the menus ({} {})",
-              want ? "asked for" : "no longer asked for", VRR_VIDEO::MEDIA, want);
+              want ? "asked for" : "no longer asked for", VRR_VIDEO::VRR_MEDIA, want);
 }
 
 void CWinSystemGbm::StartVrrVideo(const VrrWanted& wanted)
@@ -4441,7 +4441,7 @@ std::optional<int64_t> CWinSystemGbm::PaceVrrVideo(bool videoLayer)
     // in the clock of RM's GPU-CPU time correlation (CLOCK_MONOTONIC_RAW), read beside the other
     const int64_t mono = ClockNs(CLOCK_MONOTONIC);
     const int64_t raw = ClockNs(CLOCK_MONOTONIC_RAW);
-    drm->AddProperty(crtc, FLIP_TIME, static_cast<uint64_t>(slot - (mono - raw)));
+    drm->AddProperty(crtc, FLIP_TIME_RAW_NS, static_cast<uint64_t>(slot - (mono - raw)));
   }
   else
   {
-- 
