From 222fbb468cbfd581c2ea8021ef82ec7a3267cbe5 Mon Sep 17 00:00:00 2001
From: Hades <15710513+hadesdevls@users.noreply.github.com>
Date: Thu, 26 Nov 2026 19:18:13 +0000
Subject: [PATCH] [Hades][Estuary] The names of the speakers of the plan are
 never cut to "T..."

A photo of the Audio page of 1.2.2 on a projector with a 5.1.2 receiver
showed every height speaker of the plan cut to "T....", TBL and TBR
too. Each name had a label as wide as its disc (44 px for a height, 54
for a floor speaker) and took 23 to 42 of them as measured, a few
pixels to spare. No font set (Default, Arial based), GUI size (1080p,
2160p), 3D layout or skin zoom measured or captured here cuts them, so
what differs on that system is not known; the names are made to fit by
construction instead: each label is 120 px wide and centred on its
disc, so a name of three letters keeps room for itself more than twice
over whatever the font and scale. Nothing moves where the name fits.
system/hades is made again from it (make-playerinfo.py).
---
 .../xml/Includes_HadesPlayerInfo.xml          |  16 +-
 system/hades/DialogHadesPlayerInfo.xml        | 160 +++++++++---------
 system/hades/HadesIncludes.xml                |   9 +-
 3 files changed, 95 insertions(+), 90 deletions(-)

diff --git a/addons/skin.estuary/xml/Includes_HadesPlayerInfo.xml b/addons/skin.estuary/xml/Includes_HadesPlayerInfo.xml
index 88e32c5..aca184b 100644
--- a/addons/skin.estuary/xml/Includes_HadesPlayerInfo.xml
+++ b/addons/skin.estuary/xml/Includes_HadesPlayerInfo.xml
@@ -396,8 +396,11 @@
 	     while it does not; "dim" false draws nothing for a speaker that is not lit (the ones that few
 	     layouts have). x and y are the centre of the disc. The disc is Estuary's round button, whose disc is
 	     two thirds of the picture: box is the size of the picture (81: a disc of 54), inner that of the
-	     plate-coloured disc that hollows it (75: a ring of 2), size the room of the label (the height
-	     speakers are smaller, between the floor speakers they sit above: 66, 60 and 44) -->
+	     plate-coloured disc that hollows it (75: a ring of 2), size the height of the label (the height
+	     speakers are smaller, between the floor speakers they sit above: 66, 60 and 44). (Hades, 1.2.3: the label is
+	     room wide, 120, centred on the disc, so that its name is never cut to "T...": the names are three letters at most
+	     and take 23 to 42 of the 44 or 54 that the disc has at 1080p, and a projector's photo of 1.2.2 showed every height
+	     cut; skin_check.py wants room for each name twice over) -->
 	<include name="HadesSpeaker">
 		<param name="x">0</param>
 		<param name="y">0</param>
@@ -408,6 +411,7 @@
 		<param name="inner">75</param>
 		<param name="size">54</param>
 		<param name="font">font10</param>
+		<param name="room">120</param>
 		<definition>
 			<control type="group">
 				<left>$PARAM[x]</left>
@@ -426,7 +430,7 @@
