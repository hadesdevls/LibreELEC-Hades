 						<centerleft>0</centerleft>
 						<centertop>0</centertop>
-						<width>$PARAM[size]</width>
+						<width>$PARAM[room]</width>
 						<height>$PARAM[size]</height>
 						<align>center</align>
 						<aligny>center</aligny>
@@ -456,7 +460,7 @@
 					<control type="label">
 						<centerleft>0</centerleft>
 						<centertop>0</centertop>
-						<width>$PARAM[size]</width>
+						<width>$PARAM[room]</width>
 						<height>$PARAM[size]</height>
 						<align>center</align>
 						<aligny>center</aligny>
@@ -485,7 +489,7 @@
