From fbc6d5019d455b56133deb26505c4eb8724aa888 Mon Sep 17 00:00:00 2001
From: Hades <15710513+hadesdevls@users.noreply.github.com>
Date: Tue, 24 Nov 2026 15:27:43 +0000
Subject: [PATCH] [Hades][VideoPlayer] Chroma: the log names a video that is
 not 4:2:0 as such, also with a level forced

With <chromastep> in advancedsettings.xml, the line of a 4:4:4 or 4:2:2 video
said that its "4:2:0 chroma" was drawn with the level forced, as for a 4:2:0
one (seen in QEMU with a 4:4:4 clip). Whether the video is 4:2:0 now decides
the line first; the picture was right (those formats keep Kodi's way).
---
 xbmc/cores/VideoPlayer/VideoRenderers/LinuxRendererGLES.cpp | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/xbmc/cores/VideoPlayer/VideoRenderers/LinuxRendererGLES.cpp b/xbmc/cores/VideoPlayer/VideoRenderers/LinuxRendererGLES.cpp
index b00132b..c34e934 100644
--- a/xbmc/cores/VideoPlayer/VideoRenderers/LinuxRendererGLES.cpp
+++ b/xbmc/cores/VideoPlayer/VideoRenderers/LinuxRendererGLES.cpp
@@ -3659,7 +3659,7 @@ void CLinuxRendererGLES::TellChroma(KODI::CHROMA::Filter filter)
   if (m_chromaTold)
     return;
   m_chromaTold = true;
-  if (filter == KODI::CHROMA::Filter::KODI && !m_chroma.Forced())
+  if (!Chroma420())
   {
     CLog::Log(LOGINFO,
               "Chroma: the chroma of this {}x{} video is not 4:2:0 in a format whose chroma the "
-- 
2.53.0

