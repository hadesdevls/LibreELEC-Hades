From 850b2065b52b357b8ea6a5ea911d0149e0d72d80 Mon Sep 17 00:00:00 2001
From: Hades <15710513+hadesdevls@users.noreply.github.com>
Date: Wed, 18 Nov 2026 06:28:33 +0000
Subject: [PATCH] windowing/gbm: who compresses the RGB range follows what the
 kernel has

UseLimitedColor() followed "Use limited colour range" as it was at each
frame, while the driver gets the matching Broadcast RGB only with a mode
set, which Kodi does not make for it while a video plays. Turned on during
a video, the setting made Kodi's GUI shaders, which ask with each frame,
compress the menus over the video at once while the kernel stayed at
"Automatic", where i915 and xe compress every TV mode too: the menus came
out compressed twice until the video ended, and the video, whose renderer
took the range when it opened, did not. Turned off during a video with
Kodi's own "Full", the menus came out not compressed at all.

Now who compresses follows the setting once the kernel has what it asks
for, or once nothing more is asked of it (no property, or the driver
refused it): CRgbRange::Settled(), kept in m_rgbRangeApplied by
StageRgbRange() and RgbRangeCommitted(), read by UseLimitedColor(). Until
then it stays as it was, so the menus and the video go on as before the
change, which comes with the mode set at the end of the video. Where the
connector has no Broadcast RGB nothing waits, and Kodi follows the setting
at once, as before. Native Dolby Vision is not concerned: its composition
and its subtitles do not ask UseLimitedColor() while it has the output.

kodi.log says it once for each mode and range: the value that goes to the
driver with the next mode set, and that Kodi draws as it did until then.

TestRgbRange.cpp: the setting turned on and off during a video, Kodi's
"Full" taken back after one, and an output without the property.
---
 xbmc/windowing/gbm/RgbRange.h        | 21 +++++++-
 xbmc/windowing/gbm/WinSystemGbm.cpp  | 23 +++++++--
 xbmc/windowing/gbm/WinSystemGbm.h    |  3 ++
 xbmc/windowing/test/TestRgbRange.cpp | 75 +++++++++++++++++++++++++++-
 4 files changed, 116 insertions(+), 6 deletions(-)

diff --git a/xbmc/windowing/gbm/RgbRange.h b/xbmc/windowing/gbm/RgbRange.h
index 89da7d0..c3449be 100644
--- a/xbmc/windowing/gbm/RgbRange.h
+++ b/xbmc/windowing/gbm/RgbRange.h
@@ -59,6 +59,12 @@ namespace GBM
  * refuses it too, or has no "Full", Kodi makes the range itself on that output with the property as
  * the kernel has it, as before (fail closed, said in the log).
  *
+ * Who compresses follows what the kernel has, not the setting of the moment (Settled()): a change
+ * of the setting that waits for a mode set (a video plays) changes nothing until the kernel has its
+ * value. Kodi's GUI shaders ask UseLimitedColor() with each frame and the video's renderer when it
+ * opens: following the setting, the menus over the video were compressed a second time (Intel, a
+ * TV mode at "Automatic") until the video ended, or not at all.
+ *
  * nvidia-drm has the property with Hades' drivers (nvidia-open-kernel-modules-9056,
  * nvidia-legacy-open-9067: "Limited 16:235" makes NVKMS compress the range of the head and say so in
  * the AVI InfoFrame; never with the Dolby VSIF, whatever the property says); a driver without it:
@@ -121,8 +127,8 @@ public:
            *connector.kernel == *connector.full;
   }
 
-  //! Kodi draws in 16-235 (UseLimitedColor()): its setting asks for limited range, and the driver
-  //! does not make it on this output
+  //! Kodi draws in 16-235 (UseLimitedColor()): its setting (as the kernel has it: Settled()) asks
+  //! for limited range, and the driver does not make it on this output
   static bool KodiCompresses(bool setting, const Connector& connector)
   {
     return setting && !KernelLimits(connector);
@@ -154,6 +160,17 @@ public:
     return std::nullopt;
   }
 
+  /*!
+   * \brief Hades: the kernel has what the setting asks for, or nothing more is asked of it (the
+   *        connector has no property, or the driver refused what it asks): who compresses the range
+   *        follows the setting from then on; until then it stays as it was (UseLimitedColor())
+   */
+  static bool Settled(bool setting, const Connector& connector, const Requests& requests)
+  {
+    const auto want = Wanted(setting, connector, requests);
+    return !want || *want == *connector.kernel;
+  }
+
   /*!
    * \brief Hades: what native Dolby Vision gives the property when it ends, by the setting that the
    *        user has now (they may have changed it meanwhile): what Wanted() says for the value that
diff --git a/xbmc/windowing/gbm/WinSystemGbm.cpp b/xbmc/windowing/gbm/WinSystemGbm.cpp
index c068e47..7e04801 100644
--- a/xbmc/windowing/gbm/WinSystemGbm.cpp
+++ b/xbmc/windowing/gbm/WinSystemGbm.cpp
@@ -3461,8 +3461,11 @@ CRgbRange::Connector RgbRangeOf(const CDRMConnector* connector)
 bool CWinSystemGbm::UseLimitedColor()
 {
   // Hades: where the driver makes the limited range (Broadcast RGB "Limited 16:235", CRgbRange),
-  // Kodi draws full range, so that the range is compressed once
-  return CRgbRange::KodiCompresses(LimitedRangeSetting(),
+  // Kodi draws full range, so that the range is compressed once; by the setting that the kernel
+  // has (CRgbRange::Settled()): while a change of the setting waits for a mode set (a video
+  // plays), who compresses stays as it was
+  const int applied = m_rgbRangeApplied;
+  return CRgbRange::KodiCompresses(applied < 0 ? LimitedRangeSetting() : applied > 0,
                                    RgbRangeOf(m_DRM ? m_DRM->GetConnector() : nullptr));
 }
 
@@ -4627,6 +4630,7 @@ void CWinSystemGbm::ReadRgbRangeOutput()
 {
   m_rgbRangeStaged.reset();
   m_rgbRange = {};
+  m_rgbRangeApplied = -1;
   m_rgbRangeSetting.reset();
   m_rgbRangeTold.clear();
   m_rgbRangeDriver.clear();
@@ -4655,6 +4659,9 @@ void CWinSystemGbm::StageRgbRange()
     m_rgbRange.NewSetting();
   }
   const CRgbRange::Connector range = RgbRangeOf(connector);
+  // (who compresses follows the setting once the kernel has what it asks for: UseLimitedColor())
+  if (CRgbRange::Settled(setting, range, m_rgbRange))
+    m_rgbRangeApplied = setting ? 1 : 0;
   const auto player = CServiceBroker::GetAppComponents().GetComponent<CApplicationPlayer>();
   const CRgbRange::Step step =
       CRgbRange::Stage(setting, range, m_rgbRange, NativeDVOutputInUse(),
@@ -4757,12 +4764,16 @@ void CWinSystemGbm::RgbRangeCommitted()
                 "asked again with the next mode set",
                 name(staged), connector->GetName());
   }
+  // who compresses follows the setting once the kernel has what it asks for (UseLimitedColor())
+  if (CRgbRange::Settled(setting, range, m_rgbRange))
+    m_rgbRangeApplied = setting ? 1 : 0;
 
   // Once for each mode and range: what Kodi asks for, the property and its value, and who
   // compresses the range. (Native Dolby Vision says what its transport sends.)
   if (NativeDVOutputInUse())
     return;
-  const bool kodiCompresses = CRgbRange::KodiCompresses(setting, range);
+  const int applied = m_rgbRangeApplied;
+  const bool kodiCompresses = CRgbRange::KodiCompresses(applied < 0 ? setting : applied > 0, range);
   const auto* mode = m_DRM->GetSelectedMode();
   const std::string told = StringUtils::Format(
       "{}|{}|{}x{}|{}|{}x{}|{}|{}|{}|{}|{}", connector->GetName(), m_rgbRangeDriver,
@@ -4828,6 +4839,12 @@ void CWinSystemGbm::RgbRangeCommitted()
               "compresses its picture to 16-235 itself, and the driver sends it as it is, so that "
               "it is compressed once",
               where, CRgbRange::FULL, CRgbRange::LIMITED);
+  else if (setting && !kodiCompresses)
+    CLog::Log(
+        LOGINFO,
+        "{}; Broadcast RGB is {}: {} goes to the driver with a commit with a mode set (at the "
+        "end of the video at the latest), and until then Kodi draws full range, as it did{}",
+        where, name(range.kernel), name(want), automaticRule);
   else if (setting)
     CLog::Log(
         LOGINFO, "{}; Broadcast RGB is {}: Kodi compresses its picture to 16-235 itself{}{}", where,
diff --git a/xbmc/windowing/gbm/WinSystemGbm.h b/xbmc/windowing/gbm/WinSystemGbm.h
index edd1cca..8cf7139 100644
--- a/xbmc/windowing/gbm/WinSystemGbm.h
+++ b/xbmc/windowing/gbm/WinSystemGbm.h
@@ -561,6 +561,9 @@ protected:
   std::optional<uint64_t> m_rgbRangeStaged;
   //! what came of Kodi's requests of the range on this output (refusals, Kodi's own "Full")
   CRgbRange::Requests m_rgbRange;
+  //! the setting that who compresses the range follows (UseLimitedColor()): the one that the
+  //! kernel has (CRgbRange::Settled()); -1 none yet (the setting itself), 0 off, 1 on
+  std::atomic<int> m_rgbRangeApplied{-1};
   std::optional<bool> m_rgbRangeSetting;
   std::string m_rgbRangeTold;
   std::string m_rgbRangeDriver;
diff --git a/xbmc/windowing/test/TestRgbRange.cpp b/xbmc/windowing/test/TestRgbRange.cpp
index 537f65b..ea9444a 100644
--- a/xbmc/windowing/test/TestRgbRange.cpp
+++ b/xbmc/windowing/test/TestRgbRange.cpp
@@ -33,12 +33,16 @@ struct Output
   CRgbRange::Connector connector{AUTOMATIC, FULL, LIMITED, AUTOMATIC};
   CRgbRange::Requests requests;
   std::optional<bool> settingBefore; //!< m_rgbRangeSetting
+  int applied = -1; //!< m_rgbRangeApplied
   std::vector<uint64_t> refused; //!< the driver refuses a commit that sets one of these
   bool videoPlays = false;
   int modeSets = 0; //!< the mode sets that Kodi made of its own for the property
 
   //! UseLimitedColor()
-  bool KodiCompresses(bool setting) const { return CRgbRange::KodiCompresses(setting, connector); }
+  bool KodiCompresses(bool setting) const
+  {
+    return CRgbRange::KodiCompresses(applied < 0 ? setting : applied > 0, connector);
+  }
 
   //! FlipPage() of one frame
   void Flip(bool setting)
@@ -49,6 +53,8 @@ struct Output
       settingBefore = setting;
       requests.NewSetting();
     }
+    if (CRgbRange::Settled(setting, connector, requests))
+      applied = setting ? 1 : 0;
     const CRgbRange::Step step =
         CRgbRange::Stage(setting, connector, requests, false, false, false, videoPlays);
     // the commit
@@ -65,6 +71,8 @@ struct Output
     // RgbRangeCommitted()
     const auto outcome = CRgbRange::AfterCommit(step.value, connector.kernel, refusedNow);
     CRgbRange::Count(outcome, step.value, connector, requests);
+    if (CRgbRange::Settled(setting, connector, requests))
+      applied = setting ? 1 : 0;
   }
 
   void Frames(bool setting, int count)
@@ -197,6 +205,71 @@ TEST(TestRgbRange, SettingOffTakesKodisLimitedBack)
   EXPECT_FALSE(out.KodiCompresses(false));
 }
 
+// While a change of the setting waits for the end of the video, who compresses stays as the kernel
+// has it: the menus over the video were compressed twice until it ended (i915, "Automatic")
+TEST(TestRgbRange, ASettingTurnedOnDuringAVideoWaitsWithWhoCompresses)
+{
+  Output out;
+  out.Frames(false, 2);
+  out.videoPlays = true;
+  out.Frames(true, 5);
+  EXPECT_EQ(out.connector.kernel, AUTOMATIC);
+  EXPECT_EQ(out.modeSets, 0);
+  EXPECT_FALSE(out.KodiCompresses(true));
+  EXPECT_EQ(out.Compressions(true), 1);
+  // the video ends: "Limited 16:235" with a mode set, and Kodi draws full range
+  out.videoPlays = false;
+  out.Frames(true, 2);
+  EXPECT_EQ(out.connector.kernel, LIMITED);
+  EXPECT_EQ(out.modeSets, 1);
+  EXPECT_FALSE(out.KodiCompresses(true));
+  EXPECT_EQ(out.Compressions(true), 1);
+}
+
+TEST(TestRgbRange, ASettingTurnedOffDuringAVideoWaitsWithWhoCompresses)
+{
+  Output out;
+  out.Frames(true, 2);
+  ASSERT_EQ(out.connector.kernel, LIMITED);
+  out.videoPlays = true;
+  out.Frames(false, 5);
+  EXPECT_EQ(out.connector.kernel, LIMITED);
+  EXPECT_FALSE(out.KodiCompresses(false));
+  out.videoPlays = false;
+  out.Frames(false, 2);
+  EXPECT_EQ(out.connector.kernel, AUTOMATIC);
+  EXPECT_FALSE(out.KodiCompresses(false));
+}
+
+TEST(TestRgbRange, KodisFullTakenBackAfterAVideoKeepsKodiCompressingUntilThen)
+{
+  Output out;
+  out.refused = {LIMITED};
+  out.Frames(true, 10);
+  ASSERT_EQ(out.connector.kernel, FULL);
+  out.videoPlays = true;
+  out.Frames(false, 5);
+  // the driver sends Kodi's picture as it is: Kodi goes on compressing it until "Automatic"
+  EXPECT_EQ(out.connector.kernel, FULL);
+  EXPECT_TRUE(out.KodiCompresses(false));
+  out.videoPlays = false;
+  out.Frames(false, 2);
+  EXPECT_EQ(out.connector.kernel, AUTOMATIC);
+  EXPECT_FALSE(out.KodiCompresses(false));
+}
+
+TEST(TestRgbRange, WithoutThePropertyKodiFollowsTheSettingAtOnce)
+{
+  Output out;
+  out.connector = {};
+  out.Frames(false, 2);
+  out.videoPlays = true;
+  out.Flip(true);
+  EXPECT_TRUE(out.KodiCompresses(true));
+  out.Flip(false);
+  EXPECT_FALSE(out.KodiCompresses(false));
+}
+
 TEST(TestRgbRange, KodiCompressesWhereTheKernelDoesNot)
 {
   EXPECT_TRUE(CRgbRange::KodiCompresses(true, {AUTOMATIC, FULL, LIMITED, FULL}));
-- 
