   s.start = now;
 }
 
+namespace
+{
+// Hades: a value of PQ in [0, 1] in cd/m2 (SMPTE ST 2084), for the log
+double PqToNits(double pq)
+{
+  constexpr double m1 = 0.1593017578125, m2 = 78.84375, c1 = 0.8359375, c2 = 18.8515625,
+                   c3 = 18.6875;
+  const double e = std::pow(std::clamp(pq, 0.0, 1.0), 1.0 / m2);
+  return 10000.0 * std::pow(std::max(e - c1, 0.0) / (c2 - c3 * e), 1.0 / m1);
+}
+} // namespace
+
+bool CWinSystemGbmGLESContext::SceneMeasureReady()
+{
+  if (m_sceneRestart.exchange(false))
+  {
+    if (m_sceneTold && m_sceneMap.scenes)
+      CLog::Log(LOGINFO,
+                "DVBridge: HDR10 mapped by its own scene, as the video ended: {} scenes, {} pictures "
+                "whose mapping moved within a scene",
+                m_sceneMap.scenes, m_sceneMap.moves);
+    ++m_sceneEpoch;
+    m_sceneSubmitted.clear();
+    m_scenePts = DVD_NOPTS_VALUE;
+    m_sceneFrames = m_sceneLate = 0;
+    m_sceneTold = false;
+    if (m_sceneMeasure)
+      dvbridge_measure_reset(m_sceneMeasure.get());
+    if (m_sceneMeasured)
+      dvbridge_measured_reset(m_sceneMeasured.get(), false);
+    dvbridge_scene_map_init(&m_sceneMap, nullptr);
+  }
+  if (!m_sceneMeasured)
+  {
+    // the average as measured: dovi_tool's floor is for the metadata of a Dolby Vision stream, not
+    // for a mapping (the brightest keeps its floor of 2081 codes, about 100 cd/m2: the darkest scenes
+    // are mapped as they are)
+    dvbridge_measured_params params = dvbridge_measured_default_params;
+    params.avg_floor = 0;
+    m_sceneMeasured.reset(dvbridge_measured_create(&params));
+    dvbridge_scene_map_init(&m_sceneMap, nullptr);
+  }
+  if (!m_sceneMeasure && !m_sceneMeasureFailed)
+  {
+    m_sceneMeasure.reset(dvbridge_measure_create());
+    if (!m_sceneMeasure)
+    {
+      m_sceneMeasureFailed = true;
+      CLog::Log(LOGWARNING, "DVBridge: HDR10 mapped by its own scene: the measurement of its "
+                            "pictures could not be set up: they are mapped by the static metadata "
+                            "of the video, as without the setting");
+    }
+  }
+  return m_sceneMeasure && m_sceneMeasured;
+}
+
+void CWinSystemGbmGLESContext::SceneMeasurePicture(const CDVBridgeGLES::Layer& layer)
+{
+  if (layer.layout != DVBRIDGE_P010 || !SceneMeasureReady())
+    return;
+  if (std::find(m_sceneSubmitted.begin(), m_sceneSubmitted.end(), layer.pts) !=
+      m_sceneSubmitted.end())
+    return;
+  int window[2];
+  dvbridge_measured_window(m_sceneMeasured.get(), layer.width / 2, window);
+  if (!dvbridge_measure_submit(m_sceneMeasure.get(), layer.planes[0].texture,
+                               layer.planes[1].texture, layer.width, layer.height, window,
+                               layer.pts, m_sceneEpoch))
+    return;
+  m_sceneSubmitted.push_back(layer.pts);
+  if (m_sceneSubmitted.size() > 64)
+    m_sceneSubmitted.pop_front();
+}
+
+void CWinSystemGbmGLESContext::SceneOf(const CDVBridgeGLES::Layer& layer, dvbridge_plain& plain)
+{
+  if (layer.layout != DVBRIDGE_P010 || !SceneMeasureReady())
+    return;
+  // a jump of the video (a seek): what was measured around it says nothing of what comes after it,
+  // and no scene goes on across it (as DVMeasuredMetadata())
+  const double gap = layer.duration > 0 ? 24 * layer.duration : 0;
+  if (m_scenePts != DVD_NOPTS_VALUE &&
+      (layer.pts < m_scenePts || (gap > 0 && layer.pts > m_scenePts + gap)))
+  {
+    ++m_sceneEpoch;
+    m_sceneSubmitted.clear();
+    dvbridge_measure_reset(m_sceneMeasure.get());
+    dvbridge_measured_reset(m_sceneMeasured.get(), true);
+    dvbridge_scene_map_reset(&m_sceneMap);
+  }
+  m_scenePts = layer.pts;
+  // (this picture, where it was not measured ahead)
+  SceneMeasurePicture(layer);
+  dvbridge_measure_collect(
+      m_sceneMeasure.get(),
+      [](const dvbridge_measured_raw* raw, uint64_t tag, void* context)
+      {
+        auto* self = static_cast<CWinSystemGbmGLESContext*>(context);
+        dvbridge_measured_picture picture;
+        if (tag == self->m_sceneEpoch &&
+            dvbridge_measured_reduce(self->m_sceneMeasured.get(), raw, &picture))
+          dvbridge_measured_add(self->m_sceneMeasured.get(), &picture);
+      },
+      this);
+  dvbridge_measured_l1 l1;
+  const bool measured = dvbridge_measured_take(m_sceneMeasured.get(), layer.pts, &l1);
+  float max = 0.0f, avg = 0.0f;
+  plain.scene.present = dvbridge_scene_map_next(&m_sceneMap, l1.measured, l1.refresh, l1.max_pq,
+                                                l1.avg_pq, &max, &avg);
+  plain.scene.max_pq = max;
+  plain.scene.avg_pq = avg;
+  ++m_sceneFrames;
+  m_sceneLate += measured ? 0 : 1;
+  if (plain.scene.present && !m_sceneTold)
+  {
+    m_sceneTold = true;
+    CLog::Log(LOGINFO,
+              "DVBridge: HDR10 mapped by its own scene (videoscreen.hadeshdr10scenes): each scene is "
+              "measured on the GPU as it plays, and the mapping takes its brightest and its average "
+              "(level 1 of ST 2094-10, over the area of the picture) instead of the static metadata "
+              "of the video; within a scene it follows a change only past {} codes, by at most {} "
+              "codes a picture. First scene: brightest {:.0f} cd/m2, average {:.1f} cd/m2",
+              m_sceneMap.p.max_band, m_sceneMap.p.max_rate, PqToNits(max), PqToNits(avg));
+  }
+  if (m_sceneFrames % 240 == 0)
+  {
+    CLog::Log(LOGINFO,
+              "DVBridge: HDR10 mapped by its own scene: {} of the last 240 pictures not measured in "
+              "time, {} scenes so far, {} pictures whose mapping moved within a scene; mapped now "
+              "from {:.0f} cd/m2 (brightest) and {:.1f} cd/m2 (average){}",
+              m_sceneLate, m_sceneMap.scenes, m_sceneMap.moves, PqToNits(max), PqToNits(avg),
+              plain.scene.present ? "" : " (nothing measured yet: the static metadata)");
+    m_sceneLate = 0;
+  }
+}
