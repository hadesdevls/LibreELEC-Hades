diff --git a/xbmc/cores/VideoPlayer/VideoRenderers/HwDecRender/RendererVAAPIGLES.cpp b/xbmc/cores/VideoPlayer/VideoRenderers/HwDecRender/RendererVAAPIGLES.cpp
index 0cf2c21..2c2dc53 100644
--- a/xbmc/cores/VideoPlayer/VideoRenderers/HwDecRender/RendererVAAPIGLES.cpp
+++ b/xbmc/cores/VideoPlayer/VideoRenderers/HwDecRender/RendererVAAPIGLES.cpp
@@ -337,6 +337,13 @@ int CRendererVAAPIGLES::RenderPlainMapping(int idx)
   // the tunnel, which draws the picture as it is: RenderHdr10Tunnel())
   dvbridge_plain plain = PlainColourOf(buffer);
   PlainHdr10Plus(buffer.hdr10PlusDynamic, buffer.m_srcColTransfer, plain);
+  // Hades: ... and its own scene, measured, where it is mapped by it (videoscreen.hadeshdr10scenes)
+  if (buffer.sceneMeasured && !plain.hdr10plus.present)
+  {
+    layer.pts = buffer.scenePts;
+    layer.duration = buffer.doviDuration;
+    window->SceneOf(layer, plain);
+  }
   return window->RenderPlainMapping(layer, plain, m_sourceRect, m_destRect, buffer.doviSerial);
 }
 
@@ -429,6 +436,37 @@ void CRendererVAAPIGLES::MeasureAhead(int idx)
   if (idx < 0 || idx >= NUM_BUFFERS)
     return;
   auto& buffer = m_buffers[idx];
+  // Hades: or a PQ picture that the bridge maps by its own scene (videoscreen.hadeshdr10scenes): the
+  // same measurement, its own pictures (CWinSystemGbmGLESContext::SceneMeasurePicture())
+  if (buffer.sceneMeasured)
+  {
+    if (buffer.sceneMeasureQueued || !buffer.videoBuffer || !m_isVAAPIBuffer ||
+        m_vaapiFourcc != VA_FOURCC_P010 || m_textureTarget != GL_TEXTURE_2D ||
+        buffer.scenePts == DVD_NOPTS_VALUE)
+      return;
+    buffer.sceneMeasureQueued = true;
+    auto* window = dynamic_cast<KODI::WINDOWING::GBM::CWinSystemGbmGLESContext*>(
+        CServiceBroker::GetWinSystem());
+    if (!window || !UploadTexture(idx))
+      return;
+    CDVBridgeGLES::Layer layer{};
+    layer.layout = DVBRIDGE_P010;
+    layer.width = m_sourceWidth;
+    layer.height = m_sourceHeight;
+    layer.chroma = buffer.doviChroma;
+    layer.pts = buffer.scenePts;
+    layer.duration = buffer.doviDuration;
+    for (int p = 0; p < 2; ++p)
+    {
+      const auto& plane = buffer.fields[FIELD_FULL][p];
+      layer.planes[p] = {plane.id, static_cast<int>(plane.texwidth),
+                         static_cast<int>(plane.texheight)};
+    }
+    window->SceneMeasurePicture(layer);
+    // (its surface is kept until the GPU has read it, as for the measurement below)
+    AfterRenderHook(idx);
+    return;
+  }
   if (!buffer.doviMeasured || buffer.doviMeasureQueued || !buffer.videoBuffer || !m_isVAAPIBuffer ||
       m_vaapiFourcc != VA_FOURCC_P010 || m_textureTarget != GL_TEXTURE_2D ||
       buffer.doviPts == DVD_NOPTS_VALUE)
diff --git a/xbmc/cores/VideoPlayer/VideoRenderers/LinuxRendererGLES.cpp b/xbmc/cores/VideoPlayer/VideoRenderers/LinuxRendererGLES.cpp
