@@ -1212,6 +1212,18 @@ void CLinuxRendererGLES::AddVideoPicture(const VideoPicture &picture, int index)
   buf.doviFromCpu = picture.doviFromCpu;
   buf.hdr10PlusDynamic = picture.hdr10PlusDynamic;
   buf.doviFromHdr10Plus = picture.doviFromHdr10Plus;
+  // Hades: a PQ picture that the bridge maps by its own scene, measured (videoscreen.hadeshdr10scenes):
+  // not one with HDR10+ statistics, which guide its mapping instead
+  buf.scenePts = picture.pts;
+  buf.sceneMeasureQueued = false;
+  {
+    const auto* window = m_plainMap ? dynamic_cast<KODI::WINDOWING::GBM::CWinSystemGbmGLESContext*>(
+                                          CServiceBroker::GetWinSystem())
+                                    : nullptr;
+    buf.sceneMeasured = window && window->SceneMappingWanted() &&
+                        picture.color_transfer == AVCOL_TRC_SMPTE2084 && !picture.hdr10PlusDynamic &&
+                        picture.pts != DVD_NOPTS_VALUE;
+  }
 #endif
   buf.m_srcPrimaries = picture.color_primaries;
   buf.m_srcColSpace = picture.color_space;
