+++ b/xbmc/cores/VideoPlayer/VideoRenderers/LinuxRendererGLES.h
@@ -414,6 +414,13 @@ protected:
     //! Hades: VideoPicture::hdr10PlusDynamic and VideoPicture::doviFromHdr10Plus
     std::shared_ptr<const AVDynamicHDRPlus> hdr10PlusDynamic;
     bool doviFromHdr10Plus = false;
+    //! Hades: HDR10 mapped by its own scene (videoscreen.hadeshdr10scenes): the time of the picture
