+    //! ahead of its presentation (CRendererVAAPIGLES::MeasureAhead())
+    double scenePts = DVD_NOPTS_VALUE;
+    bool sceneMeasured = false;
+    bool sceneMeasureQueued = false;
 #endif
   };
 
