@@ -665,9 +665,9 @@ bool CLinuxRendererGLES::Configure(const VideoPicture &picture, float fps, unsig
 #ifdef HAVE_DVBRIDGE
   // Hades: a 3D video: what it goes out as, and why (KODI::UTILS::STEREO3D)
   TellStereoVideo(picture, transfer);
-  LogPictureSettings(picture, false, convert && !sdr);
