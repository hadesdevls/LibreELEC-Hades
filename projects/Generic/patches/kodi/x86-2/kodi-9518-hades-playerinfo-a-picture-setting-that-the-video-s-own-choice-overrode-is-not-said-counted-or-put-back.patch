@@ -4349,6 +4349,16 @@ std::string DVBRIDGE::Hdr10PlusAsDolbyVisionWhyNow()
   return g_dvHdr10PlusWhy;
 }
 
+std::string DVBRIDGE::MadeDolbyVisionFromNow()
+{
+  // (as the player information says it, hades.dv.origin, for a stream whose Dolby Vision is not its own)
+  const int origin = g_dvStreamOrigin;
+  return origin == 3   ? "measuredhlg"
+         : origin == 2 ? (g_dvHdr10Needed ? "measuredauto" : "measured")
+         : origin == 1 ? "hdr10plus"
+                       : "";
+}
+
 bool DVBRIDGE::WantsConversion(const VideoPicture* picture, int toneMapMethod)
 {
   // Not by whether this picture has its metadata: one without it is only not reconstructed, and
@@ -14143,7 +14153,13 @@ void CWinSystemGbmGLESContext::PublishPlayerInfo()
       namespace PIC = KODI::SETTINGS::PICTURE;
       const auto component = CServiceBroker::GetSettingsComponent();
       const auto settings = component ? component->GetSettings() : nullptr;
-      const unsigned scope = PIC::ScopeOf(hdrType, input.dvState, input.signal);
+      // (Hades: a setting that makes a video Dolby Vision counts only where it did: the video goes
+      // out as Dolby Vision, made from what that setting makes it from, and its own choice is
+      // Automatic. A choice for the video, "HDR output (this video)", overrides the settings: what it
+      // overrode is neither named, nor counted, nor put back by the button)
+      const unsigned scope = PIC::ScopeOf(
+          hdrType, input.dvState, input.signal, dv("hades.dv.origin"),
+          DVBRIDGE::GetOutputChoice() == DVBRIDGE::OutputChoice::AUTOMATIC);
       const std::vector<PIC::Changed> changed =
           PIC::ChangedFor(scope,
                           [&settings](const char* id) -> std::optional<PIC::Value>
