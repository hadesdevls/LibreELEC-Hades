diff --git a/xbmc/settings/PictureDefaults.h b/xbmc/settings/PictureDefaults.h
index 53f8b70..e520278 100644
--- a/xbmc/settings/PictureDefaults.h
+++ b/xbmc/settings/PictureDefaults.h
@@ -45,6 +45,14 @@ enum Scope : unsigned
   HDR10 = 4, //!< an HDR10 or HDR10+ video
   HLG = 8, //!< an HLG video
   ANY_HDR = DV_NATIVE | DV_HDR10 | HDR10 | HLG,
+  //! An HDR10, HDR10+ or HLG video that its setting made Dolby Vision: it goes out as Dolby Vision
+  //! and its own choice ("HDR output (this video)") is Automatic. A setting that makes a video Dolby
+  //! Vision changes its picture only then: where the video's choice decides (Dolby Vision, measured,
+  //! as Kodi plays it, as SDR...) or the video does not go out as Dolby Vision, it changes nothing,
+  //! and putting it back would change nothing either.
+  MADE_DV_HDR10 = 16, //!< measured from an HDR10 picture (videoscreen.hadesdvfromhdr10)
+  MADE_DV_HDR10PLUS = 32, //!< made from the video's HDR10+ (videoscreen.hadesdvfromhdr10plus)
+  MADE_DV_HLG = 64, //!< an HLG picture converted to PQ and measured (videoscreen.hadeshlgasdv)
 };
 
 //! Any value other than the default counts
@@ -102,26 +110,55 @@ inline const std::vector<Entry>& Entries()
       {"videoscreen.hadeshdr10adapt", HDR10, ANY_VALUE, 54440, "adapted to your TV"},
       {"videoscreen.hadeshdr10scenes", HDR10, 1, 54441, "mapped scene by scene"},
       {"videoscreen.hadeshdr10limiton", HDR10, 1, 54442, "peak told limited"},
-      {"videoscreen.hadesdvfromhdr10", HDR10, 1, 54443, "made Dolby Vision"},
-      {"videoscreen.hadesdvfromhdr10plus", HDR10, 1, 54443, "made Dolby Vision"},
-      {"videoscreen.hadeshlgasdv", HLG, 1, 54443, "made Dolby Vision"},
+      {"videoscreen.hadesdvfromhdr10", MADE_DV_HDR10, 1, 54443, "made Dolby Vision"},
+      {"videoscreen.hadesdvfromhdr10plus", MADE_DV_HDR10PLUS, 1, 54443, "made Dolby Vision"},
+      {"videoscreen.hadeshlgasdv", MADE_DV_HLG, 1, 54443, "made Dolby Vision"},
   };
   return entries;
 }
 
+/*!
+ * \brief The setting that made an HDR10, HDR10+ or HLG video Dolby Vision, as a Scope bit
+ * \param origin what its Dolby Vision is made from (hades.dv.origin): measured (from an HDR10 picture,
+ *        by videoscreen.hadesdvfromhdr10 or the video's choice "measured"), measuredauto (measured
+ *        because the output cannot send HDR10: no setting made it so), measuredhlg, hdr10plus or
+ *        hdr10pluscurve (from its HDR10+ metadata), or empty
+ * \return MADE_DV_HDR10, MADE_DV_HDR10PLUS, MADE_DV_HLG, or 0
+ */
+inline unsigned MadeDolbyVisionBy(const std::string& origin)
+{
+  if (origin == "measured")
+    return MADE_DV_HDR10;
+  if (origin == "hdr10plus" || origin == "hdr10pluscurve")
+    return MADE_DV_HDR10PLUS;
+  if (origin == "measuredhlg")
+    return MADE_DV_HLG;
+  return 0;
+}
+
 /*!
  * \brief For which settings a video is played
  * \param source what the video is (hades.src.hdrtype): dolbyvision, hdr10, hdr10plus, hlg, or empty
  * \param dvState how Dolby Vision goes out (hades.dv.state): native, hdr10, sdr, or empty
- * \param signal what the display is told (hades.out.signal): dv, ... (an HDR10 or HLG video sent as
- *        Dolby Vision is told dv)
- * \return the Scope bits, 0 for an SDR video and for Dolby Vision mapped to SDR (the settings of SDR
- *         output are not these)
+ * \param signal what the display is told (hades.out.signal): dv, sdr, ... (an HDR10 or HLG video sent
+ *        as Dolby Vision is told dv)
+ * \param origin what the Dolby Vision of an HDR10, HDR10+ or HLG video sent as Dolby Vision is made
+ *        from (hades.dv.origin: MadeDolbyVisionBy())
+ * \param automatic the video's own choice of its output is Automatic: the settings decide it
+ * \return the Scope bits, 0 for an SDR video, for Dolby Vision mapped to SDR and for any HDR video
+ *         that goes out as SDR (the settings of SDR output are not these); MADE_DV_* only where the
+ *         settings, not the video's choice, made the video Dolby Vision
  */
 inline unsigned ScopeOf(const std::string& source,
                         const std::string& dvState,
-                        const std::string& signal)
+                        const std::string& signal,
+                        const std::string& origin = "",
+                        bool automatic = true)
 {
+  // (an HDR video sent as SDR, as the user chose for it or in "HDR as SDR": none of these settings
+  // reaches its picture)
+  if (signal == "sdr")
+    return 0;
   unsigned scope = 0;
   if (source == "dolbyvision")
   {
@@ -130,10 +167,12 @@ inline unsigned ScopeOf(const std::string& source,
     else if (dvState == "hdr10")
       scope |= DV_HDR10;
   }
-  else if (source == "hdr10" || source == "hdr10plus")
-    scope |= HDR10 | (signal == "dv" ? DV_NATIVE : 0u);
-  else if (source == "hlg")
-    scope |= HLG | (signal == "dv" ? DV_NATIVE : 0u);
+  else if (source == "hdr10" || source == "hdr10plus" || source == "hlg")
+  {
+    scope |= source == "hlg" ? HLG : HDR10;
+    if (signal == "dv")
+      scope |= DV_NATIVE | (automatic ? MadeDolbyVisionBy(origin) : 0u);
+  }
   return scope;
 }
 
