@@ -717,7 +717,8 @@ void CLinuxRendererGLES::SubtitleBarsTick(int index)
 
 void CLinuxRendererGLES::LogPictureSettings(const VideoPicture& picture,
                                             bool nativeDV,
-                                            bool dvAsHdr10)
+                                            bool dvAsHdr10,
+                                            bool asSdr)
 {
   // Hades: the settings that change the picture of this video from the film (settings/
   // PictureDefaults.h), said in kodi.log when it is set up, so that a diagnostic report has them at
@@ -732,20 +733,33 @@ void CLinuxRendererGLES::LogPictureSettings(const VideoPicture& picture,
       source = "dolbyvision";
       break;
     case StreamHdrType::HDR_TYPE_HDR10:
-    case StreamHdrType::HDR_TYPE_HDR10PLUS:
       source = "hdr10";
       break;
+    case StreamHdrType::HDR_TYPE_HDR10PLUS:
+      source = "hdr10plus";
+      break;
     case StreamHdrType::HDR_TYPE_HLG:
       source = "hlg";
       break;
     default:
       return;
   }
+  // (Hades: an HDR picture mapped to SDR here names none; a setting that makes a video Dolby Vision
+  // only where it did, as the player information says it: PIC::ScopeOf())
+  std::string origin;
+  bool automatic = true;
+#ifdef HAVE_DVBRIDGE
+  origin = DVBRIDGE::MadeDolbyVisionFromNow();
+  automatic = DVBRIDGE::GetOutputChoice() == DVBRIDGE::OutputChoice::AUTOMATIC;
+#endif
   const unsigned scope = PIC::ScopeOf(source,
                                       nativeDV    ? "native"
                                       : dvAsHdr10 ? "hdr10"
                                                   : "",
-                                      nativeDV ? "dv" : "");
+                                      nativeDV ? "dv"
+                                      : asSdr  ? "sdr"
+                                               : "",
+                                      origin, automatic);
   if (!scope)
     return;
   const auto component = CServiceBroker::GetSettingsComponent();
