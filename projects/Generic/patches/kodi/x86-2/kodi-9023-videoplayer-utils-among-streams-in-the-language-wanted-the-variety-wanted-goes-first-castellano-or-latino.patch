diff --git a/xbmc/cores/VideoPlayer/VideoPlayer.cpp b/xbmc/cores/VideoPlayer/VideoPlayer.cpp
index e7f8c7c..7c58bdc 100644
--- a/xbmc/cores/VideoPlayer/VideoPlayer.cpp
+++ b/xbmc/cores/VideoPlayer/VideoPlayer.cpp
@@ -119,6 +119,31 @@ bool IsKnownLanguage(const CLanguageTag& language)
 {
   return !language.IsUndetermined();
 }
+
+/*!
+ * \brief Hades: one line, where a variety of a language is wanted (castellano or latino...), with
+ *        the variety of the stream chosen and what decided it
+ */
+void LogLanguageVariety(const char* what,
+                        const SelectionStream& stream,
+                        int remembered,
+                        KODI::UTILS::LanguageVariety wanted)
+{
+  using KODI::UTILS::CLanguageVariety;
+  if (wanted == KODI::UTILS::LanguageVariety::UNKNOWN)
+    return;
+  const auto variety = CLanguageVariety::OfStream(stream.language, stream.name);
+  CLog::Log(LOGINFO,
+            "CVideoPlayer: {} stream {} chosen ({}, \"{}\"): {}; the variety wanted is {}{}", what,
+            stream.type_index, stream.language.AsBcp47(), stream.name,
+            variety == KODI::UTILS::LanguageVariety::UNKNOWN
+                ? "its variety is not known"
+                : fmt::format("it is in {}", CLanguageVariety::Name(variety)),
+            CLanguageVariety::Name(wanted),
+            remembered >= 0 && remembered == stream.type_index
+                ? " (the stream chosen for this video before, which goes first)"
+                : "");
+}
 } // unnamed namespace
 
 class PredicateSubtitleFilter
@@ -134,6 +159,7 @@ private:
   bool m_isSubNone;
   bool m_hideSameAudioLang;
   int m_subStream;
+  KODI::UTILS::LanguageVariety m_variety{KODI::UTILS::LanguageVariety::UNKNOWN};
 
 public:
   /*
@@ -170,8 +196,22 @@ public:
     // Dont allow "forced" setting to be combined with "impaired" setting
     if (m_isPrefHearingImp && m_isPrefForced)
       m_isPrefForced = false;
+
+    // Hades: the variety of that language that goes first (castellano or latino...)
+    m_variety = StreamUtils::WantedVariety(m_subLang);
   };
 
+  // \brief Hades: whether a variety of the subtitle language is wanted (WantedVariety())
+  bool WantsVariety() const { return m_variety != KODI::UTILS::LanguageVariety::UNKNOWN; }
+  // \brief Hades: how well a stream in the subtitle language fits the variety wanted: 2 in it,
+  //        1 not known, 0 in the other one
+  int VarietyRank(const SelectionStream& ss) const
+  {
+    return 1 + KODI::UTILS::CLanguageVariety::Affinity(
+                   m_variety, KODI::UTILS::CLanguageVariety::OfStream(ss.language, ss.name));
+  }
+  KODI::UTILS::LanguageVariety Variety() const { return m_variety; }
+
   // \brief Whether a stream is in the language the settings ask for
   bool MatchesSubtitleLanguage(const CLanguageTag& language) const
   {
@@ -302,11 +342,13 @@ public:
     return StreamUtils::CompareAudioPreference({.language = lh.language,
                                                 .codec = lh.codec,
                                                 .channels = lh.channels,
-                                                .flags = lh.flags},
+                                                .flags = lh.flags,
+                                                .name = lh.name},
                                                {.language = rh.language,
                                                 .codec = rh.codec,
                                                 .channels = rh.channels,
-                                                .flags = rh.flags},
+                                                .flags = rh.flags,
+                                                .name = rh.name},
                                                preferences) > 0;
   };
 };
