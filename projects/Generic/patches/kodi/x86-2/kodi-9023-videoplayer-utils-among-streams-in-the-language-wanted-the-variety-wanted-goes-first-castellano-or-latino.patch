+/*!
+ * \brief The variety of a language that a stream is in, where a language has two that people tell
+ *        apart: Spanish of Spain (castellano) or of Latin America (latino), Portuguese of Portugal
+ *        or of Brazil, French of France or of Canada, Chinese in simplified or traditional writing.
+ *
+ * CLanguageTag::Matches() narrows a language to ISO 639, so a Spanish track of Spain and one of
+ * Latin America are the same language to it, and the player took whichever came first. Among
+ * tracks in the language the user wants, the one in the variety the user wants goes first.
+ *
+ * A stream says its variety in its language tag when the container can carry one (es-419,
+ * pt-BR, zh-Hant), or in the curly braces of its title, and otherwise only in its title, in the
+ * words releases use ("Latino", "Castellano", "LatAm", "Brasil", "VFQ", "简体"...).
+ */
+enum class LanguageVariety : uint8_t
+{
+  UNKNOWN,
+  SPANISH_SPAIN,
+  SPANISH_LATIN_AMERICA,
+  PORTUGUESE_PORTUGAL,
+  PORTUGUESE_BRAZIL,
+  FRENCH_FRANCE,
+  FRENCH_CANADA,
+  CHINESE_SIMPLIFIED,
+  CHINESE_TRADITIONAL,
+};
+
+class CLanguageVariety
+{
+public:
+  /*!
+   * \brief The variety a language tag names by its region or script subtag: es-ES, es-419,
+   *        es-MX, pt-BR, fr-CA, zh-Hant, zh-TW... Also the forms Kodi keeps for a language add-on
+   *        (es_mx).
+   * \return UNKNOWN for a tag without such a subtag, or of a language without varieties here
+   */
+  static LanguageVariety OfTag(const CLanguageTag& tag);
+
+  /*!
+   * \brief The same for a tag given as text (a setting value, the locale of a language add-on).
+   */
+  static LanguageVariety OfTagText(std::string_view text);
+
+  /*!
+   * \brief The variety the title of a stream names, for a stream in the language of `language`:
+   *        the words of that language's varieties only, and nothing when it names both.
+   */
+  static LanguageVariety OfTitle(const CLanguageTag& language, std::string_view title);
+
+  /*!
+   * \brief The variety of a stream: its tag first, a tag in curly braces in its title next, and
+   *        the words of its title last.
+   */
+  static LanguageVariety OfStream(const CLanguageTag& language, std::string_view title);
+
+  /*!
+   * \brief Whether a stream is in the variety wanted.
+   * \return 1 when it is, -1 when it is in the other variety of the same language, 0 when its
+   *         variety is not known, no variety is wanted, or the two are of different languages
+   */
+  static int Affinity(LanguageVariety wanted, LanguageVariety stream);
+
+  //! The language of a variety, as an ISO 639-1 code ("es", "pt", "fr", "zh"); empty for UNKNOWN
+  static std::string_view LanguageOf(LanguageVariety variety);
+
+  //! The language of a tag among those with varieties here ("es"...), or empty
+  static std::string_view LanguageOfTag(const CLanguageTag& tag);
+  //! The same for a tag or locale in text form ("es-MX", "es_MX", "spa"), or empty
+  static std::string_view PrimaryOfText(std::string_view text);
+
+  //! A name for the log
+  static const char* Name(LanguageVariety variety);
+
+  /*!
+   * \brief The value of the setting of the variety (locale.languagevariety) as a variety:
+   *        "auto" and anything unknown are UNKNOWN
+   */
+  static LanguageVariety FromSettingValue(std::string_view value);
+};
+} // namespace KODI::UTILS
