+#include "utils/LanguageVariety.h"
+
+#include <algorithm>
+#include <array>
+#include <cctype>
+#include <string>
+#include <vector>
+
+using namespace KODI::UTILS;
+
+namespace
+{
+std::string Lower(std::string_view text)
+{
+  std::string out(text);
+  std::ranges::transform(out, out.begin(),
+                         [](unsigned char c) { return static_cast<char>(std::tolower(c)); });
+  return out;
+}
+
+//! The subtags of a tag in text form, lowercase: "es-419" -> {"es", "419"}; also "es_mx"
+std::vector<std::string> SubTags(std::string_view text)
+{
+  std::vector<std::string> tags;
+  std::string current;
+  for (char c : text)
+  {
+    if (c == '-' || c == '_')
+    {
+      tags.push_back(Lower(current));
+      current.clear();
+    }
+    else
+      current += c;
+  }
+  tags.push_back(Lower(current));
+  return tags;
+}
+
+//! The ISO 639-1 code of the languages with varieties here, from a primary subtag of 2 or 3 letters
+std::string_view PrimaryOf(std::string_view primary)
+{
+  if (primary == "es" || primary == "spa")
+    return "es";
+  if (primary == "pt" || primary == "por")
+    return "pt";
+  if (primary == "fr" || primary == "fre" || primary == "fra")
+    return "fr";
+  if (primary == "zh" || primary == "chi" || primary == "zho" || primary == "cmn")
+    return "zh";
+  return {};
+}
+
+std::string_view LanguageOfTagImpl(const CLanguageTag& tag)
+{
+  if (tag.IsEmpty())
+    return {};
+  const std::vector<std::string> tags = SubTags(tag.AsBcp47());
+  if (std::string_view lang = PrimaryOf(tags.front()); !lang.empty())
+    return lang;
+  // a name ("Spanish") or a code the table above does not hold: as Kodi narrows it
+  const std::string iso6391 = tag.AsIso6391();
+  return PrimaryOf(iso6391);
+}
+
+template<std::size_t N>
+bool In(const std::string& word, const std::array<std::string_view, N>& words)
+{
+  return std::ranges::find(words, word) != words.end();
+}
+
+LanguageVariety OfSubTag(std::string_view lang, const std::string& sub)
+{
+  using enum LanguageVariety;
+  // clang-format off
+  static constexpr std::array<std::string_view, 25> latinAmerica{
+      "419", "013", "005", "029", "021", "mx", "ar", "bo", "cl", "co", "cr", "cu", "do",
+      "ec",  "sv",  "gt",  "hn",  "ni",  "pa", "py", "pe", "pr", "uy", "ve", "us"};
+  // clang-format on
+  static constexpr std::array<std::string_view, 3> spain{"es", "ea", "ic"};
+  // clang-format off
+  static constexpr std::array<std::string_view, 8> portugal{"pt", "ao", "mz", "cv",
+                                                            "gw", "st", "tl", "mo"};
+  // clang-format on
+  static constexpr std::array<std::string_view, 5> france{"fr", "be", "ch", "lu", "mc"};
+  static constexpr std::array<std::string_view, 4> simplified{"hans", "cn", "sg", "my"};
+  static constexpr std::array<std::string_view, 4> traditional{"hant", "tw", "hk", "mo"};
+  if (lang == "es")
+  {
+    if (In(sub, spain))
+      return SPANISH_SPAIN;
+    if (In(sub, latinAmerica))
+      return SPANISH_LATIN_AMERICA;
+  }
+  else if (lang == "pt")
+  {
+    if (sub == "br")
+      return PORTUGUESE_BRAZIL;
+    if (In(sub, portugal))
+      return PORTUGUESE_PORTUGAL;
+  }
+  else if (lang == "fr")
+  {
+    if (sub == "ca")
+      return FRENCH_CANADA;
+    if (In(sub, france))
+      return FRENCH_FRANCE;
+  }
+  else if (lang == "zh")
+  {
+    if (In(sub, simplified))
+      return CHINESE_SIMPLIFIED;
+    if (In(sub, traditional))
+      return CHINESE_TRADITIONAL;
+  }
+  return UNKNOWN;
+}
+
+/*!
+ * The words of a title, lowercase, with the accents of Latin letters taken off ("España" ->
+ * "espana", "Québécois" -> "quebecois"); any other character separates words
+ */
+std::vector<std::string> Words(std::string_view title)
+{
+  std::vector<std::string> words;
+  std::string current;
+  auto flush = [&]()
+  {
+    if (!current.empty())
+      words.push_back(current);
+    current.clear();
+  };
+  for (std::size_t i = 0; i < title.size();)
+  {
+    const auto c = static_cast<unsigned char>(title[i]);
+    if (c < 0x80)
+    {
+      if (std::isalnum(c))
+        current += static_cast<char>(std::tolower(c));
+      else
+        flush();
+      i++;
+      continue;
+    }
+    // two-byte UTF-8 of the Latin-1 supplement: the accented letters of these languages
+    if ((c == 0xC3) && i + 1 < title.size())
+    {
+      const auto d = static_cast<unsigned char>(title[i + 1]);
+      const unsigned cp = ((c & 0x1F) << 6) | (d & 0x3F);
+      char base = 0;
+      if ((cp >= 0xC0 && cp <= 0xC5) || (cp >= 0xE0 && cp <= 0xE5))
+        base = 'a';
+      else if (cp == 0xC7 || cp == 0xE7)
+        base = 'c';
+      else if ((cp >= 0xC8 && cp <= 0xCB) || (cp >= 0xE8 && cp <= 0xEB))
+        base = 'e';
+      else if ((cp >= 0xCC && cp <= 0xCF) || (cp >= 0xEC && cp <= 0xEF))
+        base = 'i';
+      else if (cp == 0xD1 || cp == 0xF1)
+        base = 'n';
+      else if ((cp >= 0xD2 && cp <= 0xD6) || (cp >= 0xF2 && cp <= 0xF6))
+        base = 'o';
+      else if ((cp >= 0xD9 && cp <= 0xDC) || (cp >= 0xF9 && cp <= 0xFC))
+        base = 'u';
+      if (base)
+        current += base;
+      else
+        flush();
+      i += 2;
+      continue;
+    }
+    // anything else (CJK, punctuation outside ASCII): a separator here; the Chinese words are
+    // looked for in the text itself
+    flush();
+    i++;
+    while (i < title.size() && (static_cast<unsigned char>(title[i]) & 0xC0) == 0x80)
+      i++;
+  }
+  flush();
+  return words;
+}
+
+LanguageVariety OfWords(std::string_view lang,
+                        const std::vector<std::string>& words,
+                        std::string_view title)
+{
+  using enum LanguageVariety;
+  bool first = false;
+  bool second = false;
+  auto mark = [&](LanguageVariety v)
+  {
+    if (v == SPANISH_SPAIN || v == PORTUGUESE_PORTUGAL || v == FRENCH_FRANCE ||
+        v == CHINESE_SIMPLIFIED)
+      first = true;
+    else if (v != UNKNOWN)
+      second = true;
+  };
+
+  // a tag written as two words: "es-ES", "pt_BR", "zh-Hant"
+  for (std::size_t i = 0; i + 1 < words.size(); i++)
+  {
+    if (PrimaryOf(words[i]) == lang)
+      mark(OfSubTag(lang, words[i + 1]));
+  }
+
+  if (lang == "es")
+  {
+    // clang-format off
+    static constexpr std::array<std::string_view, 25> latin{
+        "latino",      "latina",        "latinos",        "latinoamericano", "latinoamericana",
+        "latinoamerica", "latam",       "lat",            "419",             "es419",
+        "esla",        "mexico",        "mexicano",       "mexicana",        "mex",
+        "argentina",   "argentino",     "colombia",       "colombiano",      "chile",
+        "chileno",     "hispanoamerica", "hispanoamericano", "neutro",       "latinoamer"};
+    // clang-format on
+    // ("esp" is not one: releases of both write it for "espanol")
+    // clang-format off
+    static constexpr std::array<std::string_view, 13> spain{
+        "castellano", "castellana", "castilian", "castillan", "espana",   "spain", "spanien",
+        "espagne",    "iberico",    "iberian",   "europeo",   "european", "eses"};
+    // clang-format on
+    bool latinWord = false;
+    bool americaWord = false;
+    for (const std::string& w : words)
+    {
+      if (In(w, latin))
+        mark(SPANISH_LATIN_AMERICA);
+      else if (In(w, spain))
+        mark(SPANISH_SPAIN);
+      if (w == "latin")
+        latinWord = true;
+      if (w == "america" || w == "american" || w == "americas" || w == "americano")
+        americaWord = true;
+    }
+    if (latinWord && americaWord)
+      mark(SPANISH_LATIN_AMERICA);
+    return first == second ? UNKNOWN : (first ? SPANISH_SPAIN : SPANISH_LATIN_AMERICA);
+  }
+  if (lang == "pt")
+  {
+    // clang-format off
+    static constexpr std::array<std::string_view, 7> brazil{
+        "brasil", "brazil", "brasileiro", "brasileira", "brazilian", "ptbr", "br"};
+    // clang-format on
+    // clang-format off
+    static constexpr std::array<std::string_view, 6> portugal{"portugal", "europeu", "europeia",
+                                                              "european", "ptpt",    "lusitano"};
+    // clang-format on
+    for (const std::string& w : words)
+    {
+      if (In(w, brazil))
+        mark(PORTUGUESE_BRAZIL);
+      else if (In(w, portugal))
+        mark(PORTUGUESE_PORTUGAL);
+    }
+    return first == second ? UNKNOWN : (first ? PORTUGUESE_PORTUGAL : PORTUGUESE_BRAZIL);
+  }
+  if (lang == "fr")
+  {
+    // clang-format off
+    static constexpr std::array<std::string_view, 10> canada{
+        "canada", "canadien", "canadienne", "canadian", "quebec",
+        "quebecois", "quebecoise", "vfq", "frca", "qc"};
+    // clang-format on
+    // clang-format off
+    static constexpr std::array<std::string_view, 5> france{"france", "vff", "vfi", "frfr",
+                                                            "parisien"};
+    // clang-format on
+    for (const std::string& w : words)
+    {
+      if (In(w, canada))
+        mark(FRENCH_CANADA);
+      else if (In(w, france))
+        mark(FRENCH_FRANCE);
+    }
+    return first == second ? UNKNOWN : (first ? FRENCH_FRANCE : FRENCH_CANADA);
+  }
+  if (lang == "zh")
+  {
+    // clang-format off
+    static constexpr std::array<std::string_view, 6> simplifiedWords{
+        "simplified", "chs", "hans", "gb", "mainland", "prc"};
+    // clang-format on
+    // clang-format off
+    static constexpr std::array<std::string_view, 8> traditionalWords{
+        "traditional", "cht", "hant", "big5", "taiwan", "hongkong", "hk", "tw"};
+    // clang-format on
+    for (const std::string& w : words)
+    {
+      if (In(w, simplifiedWords))
+        mark(CHINESE_SIMPLIFIED);
+      else if (In(w, traditionalWords))
+        mark(CHINESE_TRADITIONAL);
+    }
+    // 简 (simplified), 繁 (traditional), as in 简体 / 简中 / 繁體 / 繁体 / 繁中; 簡 is 简 written
+    // in traditional characters (簡體: "simplified" as a traditional title says it)
+    if (title.find("\xE7\xAE\x80") != std::string_view::npos ||
+        title.find("\xE7\xB0\xA1") != std::string_view::npos)
+      mark(CHINESE_SIMPLIFIED);
+    if (title.find("\xE7\xB9\x81") != std::string_view::npos)
+      mark(CHINESE_TRADITIONAL);
+    return first == second ? UNKNOWN : (first ? CHINESE_SIMPLIFIED : CHINESE_TRADITIONAL);
+  }
+  return UNKNOWN;
+}
+} // namespace
+
+LanguageVariety CLanguageVariety::OfTagText(std::string_view text)
+{
+  const std::vector<std::string> tags = SubTags(text);
+  const std::string_view lang = PrimaryOf(tags.front());
+  if (lang.empty())
+    return LanguageVariety::UNKNOWN;
+  for (std::size_t i = 1; i < tags.size(); i++)
+  {
+    if (const LanguageVariety v = OfSubTag(lang, tags[i]); v != LanguageVariety::UNKNOWN)
+      return v;
+  }
+  return LanguageVariety::UNKNOWN;
+}
+
+LanguageVariety CLanguageVariety::OfTag(const CLanguageTag& tag)
+{
+  if (tag.IsEmpty())
+    return LanguageVariety::UNKNOWN;
+  return OfTagText(tag.AsBcp47());
+}
+
+LanguageVariety CLanguageVariety::OfTitle(const CLanguageTag& language, std::string_view title)
+{
+  if (title.empty())
+    return LanguageVariety::UNKNOWN;
+  const std::string_view lang = LanguageOfTagImpl(language);
+  if (lang.empty())
+    return LanguageVariety::UNKNOWN;
+  return OfWords(lang, Words(title), title);
+}
+
+LanguageVariety CLanguageVariety::OfStream(const CLanguageTag& language, std::string_view title)
+{
+  if (const LanguageVariety v = OfTag(language); v != LanguageVariety::UNKNOWN)
+    return v;
+  if (!title.empty())
+  {
+    // a tag in curly braces in the title, for a container that cannot hold one
+    if (const auto tag = CLanguageTag::FindInText(std::string(title)); tag.has_value())
+    {
+      if (const LanguageVariety v = OfTag(*tag);
+          v != LanguageVariety::UNKNOWN && LanguageOf(v) == LanguageOfTagImpl(language))
+        return v;
+    }
+  }
+  return OfTitle(language, title);
+}
+
+int CLanguageVariety::Affinity(LanguageVariety wanted, LanguageVariety stream)
+{
+  if (wanted == LanguageVariety::UNKNOWN || stream == LanguageVariety::UNKNOWN)
+    return 0;
+  if (LanguageOf(wanted) != LanguageOf(stream))
+    return 0;
+  return wanted == stream ? 1 : -1;
+}
+
+std::string_view CLanguageVariety::LanguageOf(LanguageVariety variety)
+{
+  using enum LanguageVariety;
+  switch (variety)
+  {
+    case SPANISH_SPAIN:
+    case SPANISH_LATIN_AMERICA:
+      return "es";
+    case PORTUGUESE_PORTUGAL:
+    case PORTUGUESE_BRAZIL:
+      return "pt";
+    case FRENCH_FRANCE:
+    case FRENCH_CANADA:
+      return "fr";
+    case CHINESE_SIMPLIFIED:
+    case CHINESE_TRADITIONAL:
+      return "zh";
+    case UNKNOWN:
+    default:
+      return {};
+  }
+}
+
+const char* CLanguageVariety::Name(LanguageVariety variety)
+{
+  using enum LanguageVariety;
+  switch (variety)
+  {
+    case SPANISH_SPAIN:
+      return "Spanish of Spain";
+    case SPANISH_LATIN_AMERICA:
+      return "Spanish of Latin America";
+    case PORTUGUESE_PORTUGAL:
+      return "Portuguese of Portugal";
+    case PORTUGUESE_BRAZIL:
+      return "Portuguese of Brazil";
+    case FRENCH_FRANCE:
+      return "French of France";
+    case FRENCH_CANADA:
+      return "French of Canada";
+    case CHINESE_SIMPLIFIED:
+      return "Chinese, simplified";
+    case CHINESE_TRADITIONAL:
+      return "Chinese, traditional";
+    case UNKNOWN:
+    default:
+      return "none";
+  }
+}
+
+LanguageVariety CLanguageVariety::FromSettingValue(std::string_view value)
+{
+  if (value.empty() || value == "auto")
+    return LanguageVariety::UNKNOWN;
+  return OfTagText(value);
+}
+
+std::string_view CLanguageVariety::LanguageOfTag(const CLanguageTag& tag)
+{
+  return LanguageOfTagImpl(tag);
+}
+
+std::string_view CLanguageVariety::PrimaryOfText(std::string_view text)
+{
+  if (text.empty())
+    return {};
+  return PrimaryOf(SubTags(text).front());
+}
