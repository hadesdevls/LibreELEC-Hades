+KODI::UTILS::LanguageVariety StreamUtils::WantedVariety(const KODI::UTILS::CLanguageTag& preferred)
+{
+  // the values of the setting (system/settings/settings.xml), as the language tags they stand for
+  static constexpr std::array<std::string_view, 9> values{
+      "auto", "es-ES", "es-419", "pt-PT", "pt-BR", "fr-FR", "fr-CA", "zh-Hans", "zh-Hant"};
+  const std::shared_ptr<CSettings> settings{CServiceBroker::GetSettingsComponent()->GetSettings()};
+  const int value{settings->GetInt(CSettings::SETTING_LOCALE_LANGUAGEVARIETY)};
+  const std::string_view setting{value > 0 && value < static_cast<int>(values.size())
+                                     ? values[static_cast<size_t>(value)]
+                                     : values[0]};
+  return WantedVarietyFrom(preferred, setting, g_langInfo.GetLocale().ToString(),
+                           g_langInfo.GetRegionCodeAlpha2());
+}
+
+KODI::UTILS::LanguageVariety StreamUtils::WantedVarietyFrom(
+    const KODI::UTILS::CLanguageTag& preferred,
+    std::string_view setting,
+    std::string_view uiLocale,
+    std::string_view uiRegion)
+{
+  using KODI::UTILS::CLanguageVariety;
+  using KODI::UTILS::LanguageVariety;
+  const std::string_view language = CLanguageVariety::LanguageOfTag(preferred);
+  if (language.empty())
+    return LanguageVariety::UNKNOWN;
+
+  // the setting names one: wanted for streams in its language, and for no other
+  if (const LanguageVariety chosen = CLanguageVariety::FromSettingValue(setting);
+      chosen != LanguageVariety::UNKNOWN)
+    return CLanguageVariety::LanguageOf(chosen) == language ? chosen : LanguageVariety::UNKNOWN;
+
+  // Automatic: the region of the preferred language, where its setting names one (the language of
+  // the add-on "Spanish (Mexico)")
+  if (const LanguageVariety v = CLanguageVariety::OfTag(preferred); v != LanguageVariety::UNKNOWN)
+    return v;
+
+  // ... or, where it is the language of the interface, the region of the interface's language
+  // (es_MX) or of its region setting
+  if (CLanguageVariety::PrimaryOfText(uiLocale) == language)
+  {
+    if (const LanguageVariety v = CLanguageVariety::OfTagText(uiLocale);
+        v != LanguageVariety::UNKNOWN)
+      return v;
+    if (!uiRegion.empty())
+      return CLanguageVariety::OfTagText(std::string(language) + "-" + std::string(uiRegion));
+  }
+  return LanguageVariety::UNKNOWN;
+}
