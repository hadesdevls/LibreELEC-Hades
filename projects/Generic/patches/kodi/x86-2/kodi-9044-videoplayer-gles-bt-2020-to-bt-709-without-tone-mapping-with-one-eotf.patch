From 97ee894514f96157a482bb0fb25af4cb67ca81a5 Mon Sep 17 00:00:00 2001
From: Hades <15710513+hadesdevls@users.noreply.github.com>
Date: Wed, 18 Nov 2026 05:28:17 +0000
Subject: [PATCH] [VideoPlayer][GLES] BT.2020 to BT.709 without tone mapping
 with one EOTF

The GLES renderer converts the primaries of a picture in the light of its
signal: to light by a gamma of the source, through the matrix, and back by
a gamma of the destination (CConvertMatrix, since Kodi's "do colorspace
conversion in linear RGB", 2018): 2.4 for BT.2020 and 2.2 for BT.709. For an
SDR or HLG picture of BT.2020 drawn in BT.709 (an SDR video of BT.2020 with
"Keep the wide colours of SDR videos (BT.2020)" off, an HLG one on a display
without HDR), that raised the signal to 2.4 / 2.2: every grey came out
darker, 128 as 122. ITU-R BT.2087 case #1, which keeps the colours that a
display shows, takes the signal to light and back by the same EOTF (that
of BT.1886, 2.40): the display applies its own to the signal either way.

A conversion without tone mapping now goes back by the gamma it came in
by: grey stays grey. Kodi's tone mapping (Reinhard, ACES, Hable) is built
on its own pair of gammas and the inverse PQ after them, and keeps it; so
do a conversion between primaries of the same gamma (BT.601 to BT.709),
which is unchanged, and the OpenGL renderer, which Hades does not build.
---
 .../VideoRenderers/VideoShaders/YUV2RGBShaderGLES.cpp | 11 ++++++++++-
 .../VideoRenderers/VideoShaders/YUV2RGBShaderGLES.h   |  3 +++
 2 files changed, 13 insertions(+), 1 deletion(-)

diff --git a/xbmc/cores/VideoPlayer/VideoRenderers/VideoShaders/YUV2RGBShaderGLES.cpp b/xbmc/cores/VideoPlayer/VideoRenderers/VideoShaders/YUV2RGBShaderGLES.cpp
index 98447f8..df52715 100644
--- a/xbmc/cores/VideoPlayer/VideoRenderers/VideoShaders/YUV2RGBShaderGLES.cpp
+++ b/xbmc/cores/VideoPlayer/VideoRenderers/VideoShaders/YUV2RGBShaderGLES.cpp
@@ -74,6 +74,11 @@ BaseYUV2RGBGLSLShader::BaseYUV2RGBGLSLShader(EShaderFormat format,
   {
     m_colorConversion = true;
     m_defines += "#define XBMC_COL_CONVERSION\n";
+    // Hades: without tone mapping, the conversion alone (ITU-R BT.2087 case #1, OnEnabled()). Kodi's
+    // tone mapping is built on its own gammas of the conversion (2.4 for BT.2020, 2.2 for BT.709,
+    // and the inverse PQ after them): it keeps them
+    if (!toneMap)
+      m_conversionAlone = true;
   }
 
   if (toneMap)
@@ -173,7 +178,11 @@ bool BaseYUV2RGBGLSLShader::OnEnabled()
     Matrix3 primMat = m_convMatrix.GetPrimMat();
     glUniformMatrix3fv(m_hPrimMat, 1, GL_FALSE, primMat.ToRaw());
     glUniform1f(m_hGammaSrc, m_convMatrix.GetGammaSrc());
-    glUniform1f(m_hGammaDstInv, 1 / m_convMatrix.GetGammaDst());
+    // Hades: the conversion alone with the same EOTF on both sides (ITU-R BT.2087 case #1: 2.40 for
+    // BT.2020, which the display applies to the signal either way): grey stays grey. Kodi's 2.2 out
+    // of a BT.2020 source at 2.4 made a grey of 128 one of 122
+    glUniform1f(m_hGammaDstInv, 1 / (m_conversionAlone ? m_convMatrix.GetGammaSrc()
+                                                       : m_convMatrix.GetGammaDst()));
   }
 
   if (m_toneMapping)
diff --git a/xbmc/cores/VideoPlayer/VideoRenderers/VideoShaders/YUV2RGBShaderGLES.h b/xbmc/cores/VideoPlayer/VideoRenderers/VideoShaders/YUV2RGBShaderGLES.h
index 67e27ef..79c4858 100644
--- a/xbmc/cores/VideoPlayer/VideoRenderers/VideoShaders/YUV2RGBShaderGLES.h
+++ b/xbmc/cores/VideoPlayer/VideoRenderers/VideoShaders/YUV2RGBShaderGLES.h
@@ -78,6 +78,9 @@ class BaseYUV2RGBGLSLShader : public CGLSLShaderProgram
     float m_toneMappingParam{1.0};
 
     bool m_colorConversion{false};
+    //! Hades: a conversion of primaries without tone mapping (an SDR or HLG picture of BT.2020 drawn
+    //! in BT.709) made as ITU-R BT.2087 case #1 asks: the same EOTF on both sides
+    bool m_conversionAlone{false};
 
     float m_black;
     float m_contrast;
-- 
2.53.0

