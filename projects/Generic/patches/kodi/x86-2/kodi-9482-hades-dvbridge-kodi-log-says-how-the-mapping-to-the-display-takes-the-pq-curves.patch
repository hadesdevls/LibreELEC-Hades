From 33d1f01543f863509d78699ae4d13a251de0e778 Mon Sep 17 00:00:00 2001
From: Hades <15710513+hadesdevls@users.noreply.github.com>
Date: Thu, 26 Nov 2026 04:58:53 +0000
Subject: [PATCH] [Hades][dvbridge] kodi.log says how the mapping to the
 display takes the PQ curves

libplacebo-9982 reads the PQ curves of the colour mapping from tables made
in double precision where the GPU makes them, and computes them with pow()
as before where it does not (no sampleable 32-bit float texture, or a GLSL
without texelFetch() and floatBitsToUint()). dvbridge_render_pq_tables()
gives what pl_renderer_pq_tables() says of the renderer's colour mapping,
and the bridge's notes say it once a renderer maps a picture to a display
(Dolby Vision as HDR10 mapped, as SDR or in Low-Latency, HDR10, HDR10+ and
HLG mapped), and again if it changes: from the tables, or with pow() with a
warning (libplacebo says why just before).
---
 tools/dvbridge/dvbridge_render.c                      | 10 ++++++++++
 tools/dvbridge/dvbridge_render.h                      |  4 ++++
 .../cores/VideoPlayer/VideoRenderers/DVBridgeGLES.cpp | 11 +++++++++++
 xbmc/cores/VideoPlayer/VideoRenderers/DVBridgeGLES.h  |  2 ++
 4 files changed, 27 insertions(+)

diff --git a/tools/dvbridge/dvbridge_render.c b/tools/dvbridge/dvbridge_render.c
index 81525f4..285cfea 100644
--- a/tools/dvbridge/dvbridge_render.c
+++ b/tools/dvbridge/dvbridge_render.c
@@ -3827,6 +3827,16 @@ bool dvbridge_render_identity_planes(const struct dvbridge_renderer *r)
     return r && r->ready && r->source && r->identity_taken;
 }
 
+int dvbridge_render_pq_tables(const struct dvbridge_renderer *r)
+{
+#ifdef PL_RENDERER_PQ_TABLES
+    return r && r->renderer ? pl_renderer_pq_tables(r->renderer) : 0;
+#else
+    (void)r;
+    return 0;
+#endif
+}
+
 void dvbridge_render_allow_reuse(struct dvbridge_renderer *r, bool allow)
 {
     if (!r)
diff --git a/tools/dvbridge/dvbridge_render.h b/tools/dvbridge/dvbridge_render.h
index 777727c..a936ade 100644
--- a/tools/dvbridge/dvbridge_render.h
+++ b/tools/dvbridge/dvbridge_render.h
@@ -444,6 +444,10 @@ bool dvbridge_render_identity_planes(const struct dvbridge_renderer *renderer);
  * by the host test, to compare. reused: the last render took it (such a frame costs less than the
  * render of a picture, and is not one to measure the cost of a picture by). The caller tells the
  * renderer when it draws into the picture (dvbridge_render_texture_drawn()). */
+/* Hades: how the mapping to a display (libplacebo's colour mapping) of this renderer takes the PQ curves:
+ * 1 read from tables made in double precision (libplacebo-9982), -1 computed with pow() (this GPU does not
+ * make the tables; libplacebo says why), 0 not known yet (nothing mapped) */
+int dvbridge_render_pq_tables(const struct dvbridge_renderer *renderer);
 #define DVBRIDGE_RENDER_REUSE 1
 void dvbridge_render_allow_reuse(struct dvbridge_renderer *renderer, bool allow);
 bool dvbridge_render_reused(const struct dvbridge_renderer *renderer);
diff --git a/xbmc/cores/VideoPlayer/VideoRenderers/DVBridgeGLES.cpp b/xbmc/cores/VideoPlayer/VideoRenderers/DVBridgeGLES.cpp
index eb194c5..5215a62 100644
--- a/xbmc/cores/VideoPlayer/VideoRenderers/DVBridgeGLES.cpp
+++ b/xbmc/cores/VideoPlayer/VideoRenderers/DVBridgeGLES.cpp
@@ -1156,6 +1156,17 @@ void CDVBridgeGLES::LogEarlyMask(bool packed)
 
 void CDVBridgeGLES::LogNotes()
 {
+  // Hades: how the mapping to the display takes the PQ curves, once it maps (and again if that changes)
+  if (const int pq = dvbridge_render_pq_tables(m_renderer); pq != 0 && pq != m_pqTablesSaid)
+  {
+    m_pqTablesSaid = pq;
+    if (pq > 0)
+      CLog::Log(LOGINFO, "DVBridge: the PQ curves of the mapping to the display are read from tables "
+                         "made in double precision, with no pow() of the GPU (libplacebo-9982)");
+    else
+      CLog::Log(LOGWARNING, "DVBridge: the PQ curves of the mapping to the display are computed with pow(), "
+                            "as before: this GPU cannot make their tables (libplacebo said why above)");
+  }
   // Hades: and the gamut mapping table of a picture that was mapped, and how it was made
   LogGamutTable();
   LogGamutMade();
diff --git a/xbmc/cores/VideoPlayer/VideoRenderers/DVBridgeGLES.h b/xbmc/cores/VideoPlayer/VideoRenderers/DVBridgeGLES.h
index a835087..f4b20b9 100644
--- a/xbmc/cores/VideoPlayer/VideoRenderers/DVBridgeGLES.h
+++ b/xbmc/cores/VideoPlayer/VideoRenderers/DVBridgeGLES.h
@@ -764,6 +764,8 @@ private:
   //! Hades: a prepared frame took the picture of the frame before it (Reused()), and the log said
   //! so in this video (Prepare(); Reset() forgets it)
   bool m_reusedSaid = false;
+  //! Hades: what the log said of how the mapping to the display takes the PQ curves (LogNotes())
+  int m_pqTablesSaid = 0;
   unsigned m_guiCacheFrames = 0;
   unsigned long long m_guiCacheTiles[3] = {0, 0, 0};
   bool m_guiCacheDiffered = false;
-- 
2.53.0

