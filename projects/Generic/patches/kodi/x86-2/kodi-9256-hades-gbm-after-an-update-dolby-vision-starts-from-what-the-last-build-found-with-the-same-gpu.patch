                                                m_dvStep.Kept()[1].Known());
   // written with the other settings when Kodi stops
   if (after != before)
@@ -10613,44 +10613,60 @@ void CWinSystemGbmGLESContext::DVPathRecall()
       !settings->GetSetting(CSettings::SETTING_VIDEOSCREEN_HADESDVPATH))
     return; // nothing to tell this GPU from another by, or no place to keep it: as before
   const auto advanced = component->GetAdvancedSettings();
+  const std::string work =
+      std::string(advanced && !advanced->m_videoDVEarlyMask ? "\nno early mask" : "") +
+      (advanced && advanced->m_videoDVStepDown > 0
+           ? "\nstep-down " + std::to_string(advanced->m_videoDVStepDown)
+           : std::string()) +
+      (advanced && !advanced->m_videoDVCCMComposer ? "\nlibplacebo composer" : "");
   m_dvPathKey = DVPathKey(renderer + '\n' + text(GL_VERSION) + '\n' +
-                          CSysInfo::GetOsPrettyNameWithVersion() +
-                          (advanced && !advanced->m_videoDVEarlyMask ? "\nno early mask" : "") +
-                          (advanced && advanced->m_videoDVStepDown > 0
-                               ? "\nstep-down " + std::to_string(advanced->m_videoDVStepDown)
-                               : std::string()) +
-                          (advanced && !advanced->m_videoDVCCMComposer ? "\nlibplacebo composer" : ""));
+                          CSysInfo::GetOsPrettyNameWithVersion() + work);
+  // ... and the GPU alone, with the same work: after an update of the build or of the driver, what the last one found
+  // with it is where this one starts (else the first Dolby Vision video after an update would be measured from the
+  // defaults, which on an integrated AMD GPU with a FEL stream made it stutter until the ways were compared)
+  m_dvPathGpu = DVPathKey("gpu\n" + DVPathGpu(renderer) + work);
   m_dvPathNamed = true;
   // ... and the fidelity step-down levels found for the picture formats (CDVStepDown), kept the
   // same way in a setting of their own
+  // (what this GPU, driver and build found; else what the last driver or build found with this GPU: the place to
+  // start from, measured again as anything found is, CDVPathMemory::Prior())
+  const auto recall = [this](const std::string& all, std::array<std::string, 2>& texts)
+  {
+    if (CDVPathMemory::Get(all, m_dvPathKey, texts[0], texts[1]))
+      return "an earlier session found with this GPU, driver and build";
+    if (CDVPathMemory::Prior(all, m_dvPathGpu, texts[0], texts[1]))
+      return "the last session of another driver or build found with this GPU";
+    return static_cast<const char*>(nullptr);
+  };
   std::array<std::string, 2> steps;
-  if (settings->GetSetting(CSettings::SETTING_VIDEOSCREEN_HADESDVSTEP) &&
-      CDVPathMemory::Get(settings->GetString(CSettings::SETTING_VIDEOSCREEN_HADESDVSTEP),
-                         m_dvPathKey, steps[0], steps[1]))
+  const char* stepsFrom =
+      settings->GetSetting(CSettings::SETTING_VIDEOSCREEN_HADESDVSTEP)
+          ? recall(settings->GetString(CSettings::SETTING_VIDEOSCREEN_HADESDVSTEP), steps)
+          : nullptr;
+  if (stepsFrom)
   {
     for (size_t layered = 0; layered < steps.size(); ++layered)
     {
       if (m_dvStep.Kept()[layered].Recall(steps[layered]))
         CLog::Log(LOGINFO,
                   "DVBridge: frames {} an enhancement layer start at the fidelity step-down levels "
-                  "that an earlier session found for their formats with this GPU, driver and "
-                  "build ({})",
-                  layered ? "with" : "without", steps[layered]);
+                  "that {} for their formats ({})",
+                  layered ? "with" : "without", stepsFrom, steps[layered]);
     }
   }
   std::array<std::string, 2> known;
-  if (!CDVPathMemory::Get(settings->GetString(CSettings::SETTING_VIDEOSCREEN_HADESDVPATH),
-                          m_dvPathKey, known[0], known[1]))
+  const char* knownFrom = recall(settings->GetString(CSettings::SETTING_VIDEOSCREEN_HADESDVPATH), known);
+  if (!knownFrom)
     return;
   for (size_t layered = 0; layered < known.size(); ++layered)
   {
     if (m_dvPath.Kept()[layered].Recall(known[layered]))
       CLog::Log(LOGINFO,
                 "DVBridge: frames without GUI elements ({} an enhancement layer) are {} unless "
-                "their picture shape found otherwise, as an earlier session found with this GPU, "
-                "driver and build ({})",
+                "their picture shape found otherwise, as {} ({})",
                 layered ? "with" : "without",
-                m_dvPath.Kept()[layered].Direct() ? "drawn directly" : "composed", known[layered]);
+                m_dvPath.Kept()[layered].Direct() ? "drawn directly" : "composed", knownFrom,
+                known[layered]);
   }
 }
 
@@ -10663,7 +10679,7 @@ void CWinSystemGbmGLESContext::DVPathRemember()
       !settings->GetSetting(CSettings::SETTING_VIDEOSCREEN_HADESDVPATH))
     return;
   const std::string before = settings->GetString(CSettings::SETTING_VIDEOSCREEN_HADESDVPATH);
-  const std::string after = CDVPathMemory::Put(before, m_dvPathKey, m_dvPath.Kept()[0].Known(),
