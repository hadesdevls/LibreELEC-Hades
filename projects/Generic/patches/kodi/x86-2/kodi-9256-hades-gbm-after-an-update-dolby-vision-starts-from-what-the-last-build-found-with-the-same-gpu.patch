--- a/xbmc/windowing/gbm/DVPathChoice.h
+++ b/xbmc/windowing/gbm/DVPathChoice.h
@@ -72,7 +72,8 @@ namespace GBM
  * What has been confirmed also stays from one session to the next, for the same GPU, driver
