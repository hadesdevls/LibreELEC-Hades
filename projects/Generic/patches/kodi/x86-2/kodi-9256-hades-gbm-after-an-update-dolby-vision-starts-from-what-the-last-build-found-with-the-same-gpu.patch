@@ -10485,7 +10485,7 @@ void CWinSystemGbmGLESContext::DVStepRemember()
       !settings->GetSetting(CSettings::SETTING_VIDEOSCREEN_HADESDVSTEP))
     return;
   const std::string before = settings->GetString(CSettings::SETTING_VIDEOSCREEN_HADESDVSTEP);
-  const std::string after = CDVPathMemory::Put(before, m_dvPathKey, m_dvStep.Kept()[0].Known(),
