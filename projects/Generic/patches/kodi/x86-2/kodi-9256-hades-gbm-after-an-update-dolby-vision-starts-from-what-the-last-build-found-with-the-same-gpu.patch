 .../windowing/gbm/WinSystemGbmGLESContext.cpp |  54 +++---
 xbmc/windowing/gbm/WinSystemGbmGLESContext.h  |   1 +
 3 files changed, 164 insertions(+), 49 deletions(-)

diff --git a/xbmc/windowing/gbm/DVPathChoice.h b/xbmc/windowing/gbm/DVPathChoice.h
