@@ -947,30 +948,92 @@ inline uint64_t DVPathKey(const std::string& text)
   return key;
 }
 
+/*!
+ * \brief The GPU of a GL_RENDERER, without what changes with an update: the versions in its last list in parentheses
+ *
+ * Mesa names the GPU, its driver and its chip there, with the versions of LLVM, of the kernel's DRM interface and of
+ * the kernel: "AMD Radeon Graphics (radeonsi, raphael_mendocino, LLVM 21.1.8, DRM 3.64, 7.3.5)" is "AMD Radeon
+ * Graphics (radeonsi, raphael_mendocino)" here, for any build. An item of that list that begins with a version
+ * ("7.3.5", "6.12.0-rc4") or is LLVM, DRM or ACO and a version goes; anything else stays ("ADL GT2", the chip of an
+ * Intel GPU). NVIDIA's renderer has no versions ("NVIDIA GeForce RTX 4080 SUPER/PCIe/SSE2": GL_VERSION has them)
+ * and is kept whole.
+ */
+inline std::string DVPathGpu(const std::string& renderer)
+{
+  const size_t open = renderer.rfind('(');
+  const size_t close = open == std::string::npos ? std::string::npos : renderer.find(')', open);
+  if (close == std::string::npos)
+    return renderer;
+  const auto digit = [](char c) { return c >= '0' && c <= '9'; };
+  const auto versioned = [&digit](const std::string& item)
+  {
+    // "7.3.5", "6.12.0-rc4"
+    if (item.size() >= 3 && digit(item[0]))
+    {
+      size_t n = 0;
+      while (n < item.size() && digit(item[n]))
+        ++n;
+      if (n < item.size() && item[n] == '.')
+        return true;
+    }
+    // "LLVM 21.1.8", "DRM 3.64", "ACO 1.0"
+    for (const char* name : {"LLVM ", "DRM ", "ACO "})
+    {
+      const size_t length = std::char_traits<char>::length(name);
+      if (item.size() > length && item.compare(0, length, name) == 0 && digit(item[length]))
+        return true;
+    }
+    return false;
+  };
+  std::string kept;
+  size_t at = open + 1;
+  while (at <= close)
+  {
+    size_t end = renderer.find(',', at);
+    if (end == std::string::npos || end > close)
+      end = close;
+    size_t from = at;
+    while (from < end && renderer[from] == ' ')
+      ++from;
+    const std::string item = renderer.substr(from, end - from);
+    if (!item.empty() && !versioned(item))
+      kept += (kept.empty() ? "" : ", ") + item;
+    at = end + 1;
+  }
+  return renderer.substr(0, open) + "(" + kept + ")" + renderer.substr(close + 1);
+}
+
 /*!
  * \brief What CDVPathChoice::Known() gives, kept for several GPUs in one text
  *
- * "<key>=<what is known of streams without an enhancement layer>/<... with one>" for each key,
- * the one put last first, ENTRIES at most, a space between them. The key is DVPathKey() of what
- * names the GPU, its driver and the build: what was found with one says nothing of another (a
- * disk that is started with one graphics card or with another keeps what it knows of each).
+ * "<key>.<gpu>=<what is known of streams without an enhancement layer>/<... with one>" for each key, the one put last
+ * first, ENTRIES at most, a space between them. The key is DVPathKey() of what names the GPU, its driver and the
+ * build: what was found with one says nothing of another (a disk that is started with one graphics card or with
+ * another keeps what it knows of each). The gpu is DVPathKey() of the GPU alone (DVPathGpu()), with what the
+ * advancedsettings.xml changes of the work: after an update of the system or of the driver, what the last build found
+ * with the same GPU is where the first video starts from (Prior()), instead of the defaults, which on some GPUs are
+ * what makes the first Dolby Vision video after an update stutter while it is measured. Hades up to 1.1 wrote
+ * "<key>=..." without a gpu: those entries are still read by their key, and are no prior for another.
  */
 class CDVPathMemory
 {
 public:
-  //! The text with what is known for that key put first, in place of what it had for it (with
-  //! nothing known: without that key). Parts of the text that are not well formed are dropped.
+  //! The text with what is known for that key put first, in place of what it had for it and for that GPU in another
+  //! driver or build (the last build's is the best prior: Prior()); with nothing known, without that key. Parts of
+  //! the text that are not well formed are dropped.
   static std::string Put(const std::string& all,
                          uint64_t key,
+                         uint64_t gpu,
                          const std::string& plain,
                          const std::string& layered)
   {
     const std::string name = Name(key);
+    const std::string machine = Name(gpu);
     std::string text;
     unsigned int entries = 0;
     if (!plain.empty() || !layered.empty())
     {
-      text = name + '=' + plain + '/' + layered;
+      text = name + '.' + machine + '=' + plain + '/' + layered;
       if (!Well(text))
         text.clear();
       else
@@ -981,7 +1044,7 @@ public:
       const size_t end = std::min(all.find(' ', at), all.size());
       const std::string entry = all.substr(at, end - at);
       at = end + 1;
-      if (!Well(entry) || entry.compare(0, name.size(), name) == 0)
+      if (!Well(entry) || entry.compare(0, name.size(), name) == 0 || GpuOf(entry) == machine)
         continue;
       if (!text.empty())
         text += ' ';
@@ -994,26 +1057,22 @@ public:
   //! What the text has for that key; false when it has nothing
   static bool Get(const std::string& all, uint64_t key, std::string& plain, std::string& layered)
   {
-    const std::string name = Name(key);
-    for (size_t at = 0; at < all.size();)
-    {
-      const size_t end = std::min(all.find(' ', at), all.size());
-      const std::string entry = all.substr(at, end - at);
-      at = end + 1;
-      if (!Well(entry) || entry.compare(0, name.size(), name) != 0)
-        continue;
-      const size_t slash = entry.find('/');
-      plain = entry.substr(name.size() + 1, slash - name.size() - 1);
-      layered = entry.substr(slash + 1);
-      return true;
-    }
-    return false;
+    return Find(all, [name = Name(key)](const std::string& entry)
+                { return entry.compare(0, name.size(), name) == 0; }, plain, layered);
+  }
+
+  //! What the text has for that GPU in another driver or build (the last put), for a key that has nothing; false when
+  //! it has nothing
+  static bool Prior(const std::string& all, uint64_t gpu, std::string& plain, std::string& layered)
+  {
+    return Find(all, [machine = Name(gpu)](const std::string& entry) { return GpuOf(entry) == machine; }, plain,
+                layered);
   }
 
 private:
   static constexpr unsigned int ENTRIES = 4;
   static constexpr size_t KEY = 16; //!< digits of a key
-  static constexpr size_t LONGEST = 600; //!< more than two texts of Known() and a key take
+  static constexpr size_t LONGEST = 600; //!< more than two texts of Known() and two keys take
 
   static std::string Name(uint64_t key)
   {
@@ -1022,23 +1081,62 @@ private:
     return name;
   }
 
-  //! "<key>=<text>/<text>", the texts of the characters that Known() writes
+  //! The gpu of an entry, "" for one without (written by Hades up to 1.1)
+  static std::string GpuOf(const std::string& entry)
+  {
+    return entry.size() > 2 * KEY + 1 && entry[KEY] == '.' ? entry.substr(KEY + 1, KEY) : std::string();
+  }
+
+  template<typename Match>
+  static bool Find(const std::string& all, Match match, std::string& plain, std::string& layered)
+  {
+    for (size_t at = 0; at < all.size();)
+    {
+      const size_t end = std::min(all.find(' ', at), all.size());
+      const std::string entry = all.substr(at, end - at);
+      at = end + 1;
+      if (!Well(entry) || !match(entry))
+        continue;
+      const size_t equals = entry.find('=');
+      const size_t slash = entry.find('/');
+      plain = entry.substr(equals + 1, slash - equals - 1);
+      layered = entry.substr(slash + 1);
+      return true;
+    }
+    return false;
+  }
+
+  //! "<key>=<text>/<text>" or "<key>.<gpu>=<text>/<text>", the texts of the characters that Known() writes
   static bool Well(const std::string& entry)
   {
-    if (entry.size() < KEY + 2 || entry.size() > LONGEST || entry[KEY] != '=')
+    if (entry.size() < KEY + 2 || entry.size() > LONGEST)
+      return false;
+    const auto hex = [](char c) { return (c >= '0' && c <= '9') || (c >= 'a' && c <= 'f'); };
+    size_t head = KEY;
+    if (entry[KEY] == '.')
+    {
+      head = 2 * KEY + 1;
+      if (entry.size() < head + 2)
+        return false;
+      for (size_t n = KEY + 1; n < head; ++n)
+      {
+        if (!hex(entry[n]))
+          return false;
+      }
+    }
+    if (entry[head] != '=')
       return false;
     size_t slashes = 0;
     for (size_t n = 0; n < entry.size(); ++n)
     {
       const char c = entry[n];
-      const bool hex = (c >= '0' && c <= '9') || (c >= 'a' && c <= 'f');
-      if (n < KEY && !hex)
+      if (n < KEY && !hex(c))
         return false;
-      if (n > KEY)
+      if (n > head)
       {
         if (c == '/')
           ++slashes;
-        else if (!hex && c != 's' && c != ',' && c != '|')
+        else if (!hex(c) && c != 's' && c != ',' && c != '|')
           return false;
       }
     }
