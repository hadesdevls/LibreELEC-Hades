From 4b67ff7aed3b7db25627636e29fbfee68366c0e5 Mon Sep 17 00:00:00 2001
From: Hades <15710513+hadesdevls@users.noreply.github.com>
Date: Wed, 18 Nov 2026 05:28:17 +0000
Subject: [PATCH] [VideoPlayer][GLES] The limited range after a conversion of
 primaries

With "Use limited colour range", the YUV to RGB matrix of the GLES renderer
also compresses the output to 16-235 (CConvertMatrix::GetYuvMat()), and the
conversion of primaries came after it: the offset of 16 went through the
gammas and the matrix as if it were light. With Kodi's gammas (2.4 in, 2.2
out) the black of an SDR or HLG video of BT.2020 drawn in BT.709 came out
at 13, below black; with one gamma on both sides greys keep their code,
but every colour is still changed by the offset, and one outside BT.709 is
clipped to 0, below black, instead of to the black of the range.

A conversion without tone mapping (KODI_RANGE_AFTER_CONVERSION) now takes
the matrix's output in full range, and the shader applies the same
compression to 16-235 after the conversion (m_rangeAfter, the scale and
the offset of GetYuvMat()): the conversion is that of full range, and its
result is put in the range, as for a picture that needs no conversion.
Brightness and contrast are applied by the matrix before the conversion,
as they are in full range. A shader file without m_rangeAfter (not the one
of this build) keeps the range in the matrix, as before, rather than
draw full range on a limited output. Kodi's tone mapping, whose output is
not changed here, keeps the order it had.

This is every conversion of primaries without tone mapping, so BT.601
video (SD), which Kodi converts to BT.709 with the same gamma on both
sides, is included: unchanged in full range, and in limited range now
the compression of its full range output, with its colours outside
BT.709 at the black of the range instead of at 0.
---
 system/shaders/GLES/2.0/gles_yuv2rgb_basic.frag   |  9 +++++++++
 system/shaders/GLES/2.0/gles_yuv2rgb_bob.frag     |  9 +++++++++
 .../shaders/GLES/3.1/gles310_yuv2rgb_filter.frag  |  9 +++++++++
 .../VideoShaders/YUV2RGBShaderGLES.cpp            | 15 ++++++++++++++-
 .../VideoShaders/YUV2RGBShaderGLES.h              |  4 +++-
 5 files changed, 44 insertions(+), 2 deletions(-)

diff --git a/system/shaders/GLES/2.0/gles_yuv2rgb_basic.frag b/system/shaders/GLES/2.0/gles_yuv2rgb_basic.frag
index b923f2b..a34a6af 100644
--- a/system/shaders/GLES/2.0/gles_yuv2rgb_basic.frag
+++ b/system/shaders/GLES/2.0/gles_yuv2rgb_basic.frag
@@ -33,6 +33,10 @@ uniform mat4 m_yuvmat;
 uniform mat3 m_primMat;
 uniform float m_gammaDstInv;
 uniform float m_gammaSrc;
+#if defined(KODI_RANGE_AFTER_CONVERSION)
+// Hades: the scale and the offset of the range of the output, applied after the conversion
+uniform vec2 m_rangeAfter;
+#endif
 uniform float m_toneP1;
 uniform float m_luminance;
 uniform vec3 m_coefsDst;
@@ -146,6 +150,11 @@ void main()
   rgb.rgb = pow(max(vec3(0), rgb.rgb), vec3(m_gammaSrc));
   rgb.rgb = max(vec3(0), m_primMat * rgb.rgb);
   rgb.rgb = pow(rgb.rgb, vec3(m_gammaDstInv));
+#if defined(KODI_RANGE_AFTER_CONVERSION)
+  // Hades: the conversion alone (no tone mapping) is made on the signal in full range, and the
+  // limited range of the output, where it is, is applied after it
+  rgb.rgb = rgb.rgb * m_rangeAfter.x + m_rangeAfter.y;
+#endif
 
 #if defined(KODI_TONE_MAPPING_REINHARD)
   float luma = dot(rgb.rgb, m_coefsDst);
diff --git a/system/shaders/GLES/2.0/gles_yuv2rgb_bob.frag b/system/shaders/GLES/2.0/gles_yuv2rgb_bob.frag
index 93dc365..ab05e40 100644
--- a/system/shaders/GLES/2.0/gles_yuv2rgb_bob.frag
+++ b/system/shaders/GLES/2.0/gles_yuv2rgb_bob.frag
@@ -35,6 +35,10 @@ uniform int m_field;
 uniform mat3 m_primMat;
 uniform float m_gammaDstInv;
 uniform float m_gammaSrc;
+#if defined(KODI_RANGE_AFTER_CONVERSION)
+// Hades: the scale and the offset of the range of the output, applied after the conversion
+uniform vec2 m_rangeAfter;
+#endif
 uniform float m_toneP1;
 uniform float m_luminance;
 uniform vec3 m_coefsDst;
@@ -87,6 +91,11 @@ void main()
   rgb.rgb = pow(max(vec3(0), rgb.rgb), vec3(m_gammaSrc));
   rgb.rgb = max(vec3(0), m_primMat * rgb.rgb);
   rgb.rgb = pow(rgb.rgb, vec3(m_gammaDstInv));
+#if defined(KODI_RANGE_AFTER_CONVERSION)
+  // Hades: the conversion alone (no tone mapping) is made on the signal in full range, and the
+  // limited range of the output, where it is, is applied after it
+  rgb.rgb = rgb.rgb * m_rangeAfter.x + m_rangeAfter.y;
+#endif
 
 #if defined(KODI_TONE_MAPPING_REINHARD)
   float luma = dot(rgb.rgb, m_coefsDst);
diff --git a/system/shaders/GLES/3.1/gles310_yuv2rgb_filter.frag b/system/shaders/GLES/3.1/gles310_yuv2rgb_filter.frag
index a9ae25d..87b027f 100644
--- a/system/shaders/GLES/3.1/gles310_yuv2rgb_filter.frag
+++ b/system/shaders/GLES/3.1/gles310_yuv2rgb_filter.frag
@@ -21,6 +21,10 @@ uniform sampler2D m_kernelTex;
 uniform mat3 m_primMat;
 uniform float m_gammaDstInv;
 uniform float m_gammaSrc;
+#if defined(KODI_RANGE_AFTER_CONVERSION)
+// Hades: the scale and the offset of the range of the output, applied after the conversion
+uniform vec2 m_rangeAfter;
+#endif
 uniform float m_toneP1;
 uniform float m_luminance;
 uniform vec3 m_coefsDst;
@@ -103,6 +107,11 @@ void main()
   rgb.rgb = pow(max(vec3(0), rgb.rgb), vec3(m_gammaSrc));
   rgb.rgb = max(vec3(0), m_primMat * rgb.rgb);
   rgb.rgb = pow(rgb.rgb, vec3(m_gammaDstInv));
+#if defined(KODI_RANGE_AFTER_CONVERSION)
+  // Hades: the conversion alone (no tone mapping) is made on the signal in full range, and the
+  // limited range of the output, where it is, is applied after it
+  rgb.rgb = rgb.rgb * m_rangeAfter.x + m_rangeAfter.y;
+#endif
 
 #if defined(KODI_TONE_MAPPING_REINHARD)
   float luma = dot(rgb.rgb, m_coefsDst);
diff --git a/xbmc/cores/VideoPlayer/VideoRenderers/VideoShaders/YUV2RGBShaderGLES.cpp b/xbmc/cores/VideoPlayer/VideoRenderers/VideoShaders/YUV2RGBShaderGLES.cpp
index df52715..ee54f5f 100644
--- a/xbmc/cores/VideoPlayer/VideoRenderers/VideoShaders/YUV2RGBShaderGLES.cpp
+++ b/xbmc/cores/VideoPlayer/VideoRenderers/VideoShaders/YUV2RGBShaderGLES.cpp
@@ -78,7 +78,10 @@ BaseYUV2RGBGLSLShader::BaseYUV2RGBGLSLShader(EShaderFormat format,
     // tone mapping is built on its own gammas of the conversion (2.4 for BT.2020, 2.2 for BT.709,
     // and the inverse PQ after them): it keeps them
     if (!toneMap)
+    {
       m_conversionAlone = true;
+      m_defines += "#define KODI_RANGE_AFTER_CONVERSION\n";
+    }
   }
 
   if (toneMap)
@@ -143,6 +146,7 @@ void BaseYUV2RGBGLSLShader::OnCompiledAndLinked()
   m_hCoefsDst = glGetUniformLocation(ProgramHandle(), "m_coefsDst");
   m_hToneP1 = glGetUniformLocation(ProgramHandle(), "m_toneP1");
   m_hLuminance = glGetUniformLocation(ProgramHandle(), "m_luminance");
+  m_hRangeAfter = glGetUniformLocation(ProgramHandle(), "m_rangeAfter");
 
   if (m_dither)
   {
@@ -163,9 +167,14 @@ bool BaseYUV2RGBGLSLShader::OnEnabled()
   glUniform1i(m_hVTex, 2);
   glUniform2f(m_hStep, 1.0 / m_width, 1.0 / m_height);
 
+  // Hades: the conversion alone takes the signal in full range, and the limited range of the output
+  // is applied after it (m_rangeAfter): applied before, as for the rest, its black of 16 went
+  // through the gammas of the conversion and came out at 13, below black. Only where the program has
+  // m_rangeAfter: a shader file without it (not the one of this build) keeps the range in the matrix
+  const bool limitedAfter = m_conversionAlone && !m_convertFullRange && m_hRangeAfter >= 0;
   m_convMatrix.SetDestinationContrast(m_contrast)
       .SetDestinationBlack(m_black)
-      .SetDestinationLimitedRange(!m_convertFullRange);
+      .SetDestinationLimitedRange(!m_convertFullRange && !limitedAfter);
 
   Matrix4 yuvMat = m_convMatrix.GetYuvMat();
   glUniformMatrix4fv(m_hYuvMat, 1, GL_FALSE, yuvMat.ToRaw());
@@ -183,6 +192,10 @@ bool BaseYUV2RGBGLSLShader::OnEnabled()
     // of a BT.2020 source at 2.4 made a grey of 128 one of 122
     glUniform1f(m_hGammaDstInv, 1 / (m_conversionAlone ? m_convMatrix.GetGammaSrc()
                                                        : m_convMatrix.GetGammaDst()));
+    // ... and the range of the output after it, as CConvertMatrix::GetYuvMat() applies it
+    if (m_hRangeAfter >= 0)
+      glUniform2f(m_hRangeAfter, limitedAfter ? (940.0f - 64.0f) / 1023.0f : 1.0f,
+                  limitedAfter ? 64.0f / 1023.0f : 0.0f);
   }
 
   if (m_toneMapping)
diff --git a/xbmc/cores/VideoPlayer/VideoRenderers/VideoShaders/YUV2RGBShaderGLES.h b/xbmc/cores/VideoPlayer/VideoRenderers/VideoShaders/YUV2RGBShaderGLES.h
index 79c4858..0a80b41 100644
--- a/xbmc/cores/VideoPlayer/VideoRenderers/VideoShaders/YUV2RGBShaderGLES.h
+++ b/xbmc/cores/VideoPlayer/VideoRenderers/VideoShaders/YUV2RGBShaderGLES.h
@@ -79,8 +79,10 @@ class BaseYUV2RGBGLSLShader : public CGLSLShaderProgram
 
     bool m_colorConversion{false};
     //! Hades: a conversion of primaries without tone mapping (an SDR or HLG picture of BT.2020 drawn
-    //! in BT.709) made as ITU-R BT.2087 case #1 asks: the same EOTF on both sides
+    //! in BT.709) made as ITU-R BT.2087 case #1 asks: the same EOTF on both sides, on the signal in
+    //! full range, and the limited range of the output applied after it (KODI_RANGE_AFTER_CONVERSION)
     bool m_conversionAlone{false};
+    GLint m_hRangeAfter{-1};
 
     float m_black;
     float m_contrast;
-- 
2.53.0

