diff --git a/xbmc/cores/AudioEngine/Engines/ActiveAE/ActiveAE.cpp b/xbmc/cores/AudioEngine/Engines/ActiveAE/ActiveAE.cpp
index 0ef029e..edd4bc3 100644
--- a/xbmc/cores/AudioEngine/Engines/ActiveAE/ActiveAE.cpp
+++ b/xbmc/cores/AudioEngine/Engines/ActiveAE/ActiveAE.cpp
@@ -4250,7 +4250,7 @@ bool CActiveAE::EncoderOpens(CAEStreamInfo::DataType type)
 // encoded to Dolby Digital (Dolby Digital Plus where that passes through) and passed through
 // (ApplySettingsToFormat()). The setting is not changed: when the display takes more again (its
 // audio data change, which is a device change, and the settings are loaded again), the setting
-// holds as it was. "Limit PCM channels to what the display declares" (audiooutput.hadespcmlimit,
+// holds as it was. "Limit PCM to what the display declares" (audiooutput.hadespcmlimit,
 // System > Audio, expert level, on by default) turns it off, for a display that takes more than it
 // says; so does <audio><pcmchannelsfromeld>false</pcmchannelsfromeld></audio> in
 // advancedsettings.xml, which came first.
@@ -4292,8 +4292,8 @@ void CActiveAE::LimitChannelsToDisplay()
 // (AE::PCM::PcmIn16Bits(): a TV that declares 16 and 20 bits stayed silent with the 32-bit format,
 // in which the HDA HDMI codec sends it 20). A display that declares 20 bits gets 16, the most that
 // every display with audio takes. By the same audio data as the channels (DisplayAudioOf(): kept
-// through a change of display mode), and turned off by the same "Limit PCM channels to what the
-// display declares" (audiooutput.hadespcmlimit), for a display that takes more than it says.
+// through a change of display mode), and turned off by the same "Limit PCM to what the display
+// declares" (audiooutput.hadespcmlimit), for a display that takes more than it says.
 void CActiveAE::LimitBitsToDisplay()
 {
   const auto component = CServiceBroker::GetSettingsComponent();
@@ -4315,8 +4315,8 @@ void CActiveAE::LimitBitsToDisplay()
       CLog::Log(LOGINFO,
                 "ActiveAE - the display of '{}' takes PCM of {} bits at most ({}): PCM goes out in "
                 "16 bits, which every display with audio takes, not in the 32-bit format of the "
-                "output (a display that declares 20 bits gets 16; \"Limit PCM channels to what the "
-                "display declares\" off sends what the output offers)",
+                "output (a display that declares 20 bits gets 16; \"Limit PCM to what the display "
+                "declares\" off sends what the output offers)",
                 m_settings.device, bits,
                 kept ? "the audio data it had last: it has none at this moment, as during a "
                        "change of display mode"
