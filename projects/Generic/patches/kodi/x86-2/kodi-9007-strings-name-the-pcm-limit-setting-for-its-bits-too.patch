From 6528345b592df9d824b860eb7024e2c0790a5b9b Mon Sep 17 00:00:00 2001
From: Hades <15710513+hadesdevls@users.noreply.github.com>
Date: Wed, 18 Nov 2026 01:33:07 +0000
Subject: [PATCH] strings: name the PCM limit setting for its bits too

"Limit PCM channels to what the display declares"
(audiooutput.hadespcmlimit) now also sends 16-bit PCM to a display that
declares fewer than 24 bits (the commit before this one), and its help
says so. The name said channels only: it is "Limit PCM to what the
display declares" now, in English and in the three Spanish translations
of Estuary ("Limitar el PCM a lo que declara la pantalla"), and in the
comments and the log line that name it. The setting, its id, its level
and its default are as they were.
---
 addons/resource.language.en_gb/resources/strings.po    |  4 ++--
 .../language/resource.language.en_gb/strings.po        |  2 +-
 .../language/resource.language.es_ar/strings.po        |  4 ++--
 .../language/resource.language.es_es/strings.po        |  4 ++--
 .../language/resource.language.es_mx/strings.po        |  4 ++--
 xbmc/cores/AudioEngine/Engines/ActiveAE/ActiveAE.cpp   | 10 +++++-----
 6 files changed, 14 insertions(+), 14 deletions(-)

diff --git a/addons/resource.language.en_gb/resources/strings.po b/addons/resource.language.en_gb/resources/strings.po
index a6c8045..b43a0ca 100644
--- a/addons/resource.language.en_gb/resources/strings.po
+++ b/addons/resource.language.en_gb/resources/strings.po
@@ -25844,10 +25844,10 @@ msgctxt "#39879"
 msgid "Some TVs from 2016 (LG OLED among them) and a few later ones ask for an older way of signalling Dolby Vision. With this on, Hades sends Dolby Vision to this TV that way instead of HDR10. Whether your TV accepts it cannot be checked from here: if the colours look wrong, turn this off. Shown only for a TV that asks for that signalling. Off by default. Takes effect from the next video."
 msgstr ""
 
-#. Hades: label of setting "audiooutput.hadespcmlimit"; translated in Estuary (#32110)
+#. Hades: label of setting "audiooutput.hadespcmlimit" (its channels and bits); translated in Estuary (#32110)
 #: system/settings/settings.xml
 msgctxt "#39880"
-msgid "Limit PCM channels to what the display declares"
+msgid "Limit PCM to what the display declares"
 msgstr ""
 
 #. Hades: help of setting "audiooutput.hadespcmlimit"; translated in Estuary (#32111)
diff --git a/addons/skin.estuary/language/resource.language.en_gb/strings.po b/addons/skin.estuary/language/resource.language.en_gb/strings.po
index 0bf4fa3..d0a4186 100644
--- a/addons/skin.estuary/language/resource.language.en_gb/strings.po
+++ b/addons/skin.estuary/language/resource.language.en_gb/strings.po
@@ -2708,7 +2708,7 @@ msgstr ""
 #: system/settings/settings.xml
 #. Setting label: the channels of PCM limited to what the display declares (core #39880)
 msgctxt "#32110"
-msgid "Limit PCM channels to what the display declares"
+msgid "Limit PCM to what the display declares"
 msgstr ""
 
 #: system/settings/settings.xml
