From 1deedec8256e9a1ae58f48b355b5bd0978c56199 Mon Sep 17 00:00:00 2001
From: Hades <15710513+hadesdevls@users.noreply.github.com>
Date: Tue, 24 Nov 2026 22:04:45 +0000
Subject: [PATCH] [Hades][dvbridge] HDR mapped to SDR into a BT.2020 or DCI-P3
 container

A projector or a TV that takes SDR in a wider gamut (BT.2020 or DCI-P3, told
by the colorimetry of the AVI InfoFrame) got HDR mapped to SDR in BT.709 only:
the mapping's SDR target was BT.709, and mapping.gamut had to be BT.709.

An SDR mapping may now have the gamut BT.2020 or DCI-P3 (D65) as well: it is
the container of the signal and the display's gamut. The picture is mapped
into it directly, by the same tone curve and perceptual gamut mapping, not
mapped into BT.709 and then put in the container (which keeps every colour
inside BT.709 while the display is told the wider gamut). The trim pass takes
that container too. BT.709 draws what it drew, to the bit.

dvbridge_sdr_primaries() gives the libplacebo primaries of an SDR target;
DVBRIDGE_SDR_CONTAINERS says the bridge has them.
---
 tools/dvbridge/dvbridge_placebo.c | 17 +++++++++++++++--
 tools/dvbridge/dvbridge_placebo.h | 20 ++++++++++++++++----
 tools/dvbridge/dvbridge_render.c  | 14 +++++++++-----
 3 files changed, 40 insertions(+), 11 deletions(-)

diff --git a/tools/dvbridge/dvbridge_placebo.c b/tools/dvbridge/dvbridge_placebo.c
index 4015dd6..3ea4849 100644
--- a/tools/dvbridge/dvbridge_placebo.c
+++ b/tools/dvbridge/dvbridge_placebo.c
@@ -364,9 +364,10 @@ bool dvbridge_hdr10_mapping_valid(const struct dvbridge_hdr10_mapping *m)
     if (m->gamma != 0.0f && (m->target != DVBRIDGE_HDR10_TARGET_SDR || m->gamma22 ||
                              dvbridge_sdr_transfer(m) == PL_COLOR_TRC_UNKNOWN))
         return false;
-    /* Hades: an SDR output is BT.709 (Kodi signals no other gamut there) */
+    /* Hades: an SDR output is BT.709, or a container that Kodi tells the display: BT.2020 or DCI-P3 (D65)
+     * (dvbridge_sdr_primaries()) */
     if (m->target != DVBRIDGE_HDR10_TARGET_HDR10 &&
-        (m->target != DVBRIDGE_HDR10_TARGET_SDR || m->gamut != DVBRIDGE_HDR10_GAMUT_BT709))
+        (m->target != DVBRIDGE_HDR10_TARGET_SDR || dvbridge_sdr_primaries(m) == PL_COLOR_PRIM_UNKNOWN))
         return false;
     if (m->source_known) {
         for (int i = 0; i < 8; ++i)
@@ -386,6 +387,18 @@ struct dvbridge_hdr10_mapping dvbridge_sdr_mapping(const float *source_xy)
     return dvbridge_sdr_mapping_for(DVBRIDGE_SDR_TARGET_REFERENCE, source_xy);
 }
 
+enum pl_color_primaries dvbridge_sdr_primaries(const struct dvbridge_hdr10_mapping *m)
+{
+    if (!m || m->target != DVBRIDGE_HDR10_TARGET_SDR)
+        return PL_COLOR_PRIM_UNKNOWN;
+    switch (m->gamut) {
+    case DVBRIDGE_HDR10_GAMUT_BT709: return PL_COLOR_PRIM_BT_709;
+    case DVBRIDGE_HDR10_GAMUT_BT2020: return PL_COLOR_PRIM_BT_2020;
+    case DVBRIDGE_HDR10_GAMUT_P3_D65: return PL_COLOR_PRIM_DISPLAY_P3;
+    default: return PL_COLOR_PRIM_UNKNOWN;
+    }
+}
+
 enum pl_color_transfer dvbridge_sdr_transfer(const struct dvbridge_hdr10_mapping *m)
 {
     if (!m || m->gamma == 0.0f)
diff --git a/tools/dvbridge/dvbridge_placebo.h b/tools/dvbridge/dvbridge_placebo.h
index a32211f..d19d970 100644
--- a/tools/dvbridge/dvbridge_placebo.h
+++ b/tools/dvbridge/dvbridge_placebo.h
@@ -97,8 +97,15 @@ static inline enum dvbridge_hdr10_curve dvbridge_hdr10_curve_of_setting(int valu
  * primaries and the BT.1886 EOTF of a reference display (black at zero, a pure 2.4 power), its
  * white at the peak, in the gamut BT.709. That is what the picture of a stream whose base layer is
  * no picture by itself (profile 5) needs there: without it, nothing but that base layer, in the
- * wrong colours. */
+ * wrong colours.
+ * Hades: or, for a display that takes SDR in a wider gamut (a projector or a TV that the output tells BT.2020 or
+ * DCI-P3 in its colorimetry), an SDR signal of BT.2020 or of DCI-P3 (D65) primaries: the gamut of the mapping is
+ * then that container (dvbridge_hdr10_mapping::gamut, DVBRIDGE_SDR_CONTAINERS), the picture is mapped into it
+ * directly, by the same perceptual gamut mapping and curve, and nothing of the source that the container holds is
+ * clipped to BT.709 on the way. */
 #define DVBRIDGE_SDR_MAPPING 1
+/* Hades: this bridge maps SDR into the containers BT.2020 and DCI-P3 (D65) as well as BT.709 */
+#define DVBRIDGE_SDR_CONTAINERS 1
 enum dvbridge_hdr10_target {
     DVBRIDGE_HDR10_TARGET_HDR10 = 0,
     DVBRIDGE_HDR10_TARGET_SDR = 1,
@@ -136,7 +143,9 @@ enum dvbridge_sdr_target {
 struct dvbridge_hdr10_mapping {
     bool enabled;
     float peak;                      /* of the display, cd/m2 (for SDR, its white) */
-    enum dvbridge_hdr10_gamut gamut; /* of the display, inside the BT.2020 signal (SDR: BT.709) */
+    /* of the display, inside the BT.2020 signal (SDR: the container of the signal, BT.709, BT.2020 or DCI-P3
+     * (D65), whose whole gamut the display is taken to show: dvbridge_sdr_primaries()) */
+    enum dvbridge_hdr10_gamut gamut;
     enum dvbridge_hdr10_curve curve;
     /* The gamut of the mastering display, when its metadata gives it (the HDR10 metadata of the
      * stream): where the colours of the picture can be at all. CIE 1931 xy of red, green, blue
@@ -183,8 +192,8 @@ enum {
 };
 #define DVBRIDGE_HDR10_BLACK_MAX 1.0f
 /* A mapping that dvbridge_render_hdr10_mapping() takes: off, or on with values it can use (an SDR
- * one in the gamut BT.709 only; Hades: one of DVBRIDGE_HDR10_GAMUT_CUSTOM to HDR10 only, with a
- * target_xy that is a gamut inside BT.2020). */
+ * one in the gamut BT.709 only; Hades: or in the container BT.2020 or DCI-P3 (D65); one of
+ * DVBRIDGE_HDR10_GAMUT_CUSTOM to HDR10 only, with a target_xy that is a gamut inside BT.2020). */
 bool dvbridge_hdr10_mapping_valid(const struct dvbridge_hdr10_mapping *m);
 /* Hades: two mappings that draw the same picture: every value that dvbridge_render_hdr10_mapping()
  * and dvbridge_render_set_low_latency() take of one, the primaries of the source where they are
@@ -234,6 +243,9 @@ struct dvbridge_hdr10_mapping dvbridge_sdr_mapping_for(int sdr_target, const flo
  * reference's (203, 2.4). The reference's white and gamma give the reference's mapping, bit for bit. */
 #define DVBRIDGE_SDR_MAPPING_CUSTOM 1
 struct dvbridge_hdr10_mapping dvbridge_sdr_mapping_custom(float white, float gamma, const float *source_xy);
+/* Hades: the libplacebo primaries of the signal of an SDR target: those of its gamut, BT.709 (as before), BT.2020 or
+ * DCI-P3 with the white of D65; PL_COLOR_PRIM_UNKNOWN for another gamut, or for a target that is not SDR */
+enum pl_color_primaries dvbridge_sdr_primaries(const struct dvbridge_hdr10_mapping *m);
 /* Hades: the libplacebo transfer of an SDR target's gamma (dvbridge_hdr10_mapping::gamma): BT.1886 for 2.4
  * (and for 0), the pure power of libplacebo for the others; PL_COLOR_TRC_UNKNOWN for a gamma it has none of */
 enum pl_color_transfer dvbridge_sdr_transfer(const struct dvbridge_hdr10_mapping *m);
diff --git a/tools/dvbridge/dvbridge_render.c b/tools/dvbridge/dvbridge_render.c
index d1f9684..33c04a5 100644
--- a/tools/dvbridge/dvbridge_render.c
+++ b/tools/dvbridge/dvbridge_render.c
@@ -2164,7 +2164,11 @@ bool dvbridge_render_hdr10_mapping(struct dvbridge_renderer *r,
  * Hades: to an SDR output (DVBRIDGE_HDR10_TARGET_SDR) the target is the signal of every SDR
  * picture there instead: BT.709, the BT.1886 EOTF with its white at the peak, black at zero
  * (the same "infinite contrast": BT.1886 is then a pure 2.4 power). The same curve and gamut
- * mapping take the picture into it. */
+ * mapping take the picture into it.
+ * Hades: or the same SDR signal in the wider container that the output tells the display, BT.2020 or DCI-P3
+ * (D65) (dvbridge_sdr_primaries()): the display's gamut is then that whole container, and the gamut mapping takes
+ * the picture into it, not into BT.709 and then into the container (which would keep every colour within BT.709).
+ * BT.709 draws what it drew, to the bit. */
 /* Hades: the sizes of the gamut mapping table (map_to_display()): the standard one, and the finer one
  * (dvbridge_render_set_gamut_table()), finer in intensity and in chroma, not in hue. Measured on Mesa's
  * software OpenGL ES against a table of 384x256x1024 entries (at 99.9 % of the pixels within 0.05 and
@@ -2272,7 +2276,7 @@ static void display_mapping(const struct dvbridge_hdr10_mapping *m, const int *s
         dvbridge_hdr10_gamut_xy(m->gamut, xy);
     const bool sdr = m->target == DVBRIDGE_HDR10_TARGET_SDR;
     *target = (struct pl_color_space){
-        .primaries = sdr ? PL_COLOR_PRIM_BT_709 : PL_COLOR_PRIM_BT_2020,
+        .primaries = sdr ? dvbridge_sdr_primaries(m) : PL_COLOR_PRIM_BT_2020,
         .transfer = sdr ? dvbridge_sdr_transfer(m) : PL_COLOR_TRC_PQ,
         .hdr = {.min_luma = PL_COLOR_HDR_BLACK, .max_luma = m->peak,
                 .prim = {.red = {xy[0], xy[1]}, .green = {xy[2], xy[3]}, .blue = {xy[4], xy[5]},
@@ -2696,15 +2700,15 @@ static bool trim_prepare(struct dvbridge_renderer *r, const struct dvbridge_hdr1
         }
         return false;
     }
-    /* The container is BT.2020 for an HDR10 output and BT.709 for an SDR one; the display's own
-       primaries are
+    /* The container is BT.2020 for an HDR10 output and BT.709 for an SDR one (Hades: or the wider one of an SDR
+       output, BT.2020 or DCI-P3, which is then the display's gamut too); the display's own primaries are
      * inside it (what the gamut mapping wrote). Where they cannot be had, no pass. */
     const bool sdr = m->target == DVBRIDGE_HDR10_TARGET_SDR;
     float display[8], container[8];
     struct dvbridge_trim_space space;
     if (!(m->gamut == DVBRIDGE_HDR10_GAMUT_CUSTOM ? dvbridge_hdr10_custom_xy(m, display)
                                                   : dvbridge_hdr10_gamut_xy(m->gamut, display)) ||
-        !dvbridge_hdr10_gamut_xy(sdr ? DVBRIDGE_HDR10_GAMUT_BT709 : DVBRIDGE_HDR10_GAMUT_BT2020, container) ||
+        !dvbridge_hdr10_gamut_xy(sdr ? m->gamut : DVBRIDGE_HDR10_GAMUT_BT2020, container) ||
         !dvbridge_trim_space(container, display, &space))
         return false;
     t->a[0] = t->trim.gain;
-- 
