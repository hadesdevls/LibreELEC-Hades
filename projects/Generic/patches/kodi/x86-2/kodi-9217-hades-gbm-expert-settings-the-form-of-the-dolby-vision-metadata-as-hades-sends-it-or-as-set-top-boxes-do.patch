+  enum class L5Form
+  {
+    PLACED = 0, //!< the default, Hades' own: the video's area where the picture is placed, the
+                //!< edges taken in while something is drawn over the bars, and a block of the
+                //!< place where Hades puts bars around the picture
+    AS_GIVEN = 1, //!< the video's block as it is, none where it has none
+    NONE = 2, //!< none, as licensed set-top boxes send Dolby Vision TV-led
+    UNMADE = 3, //!< Hades' own, but none where the video has none (as the TV's own player)
+  };
 
   static constexpr int STEP_LEVELS = 4; //!< CDVStepDown::LEVELS, DVBRIDGE_STEP_LEVELS
 
@@ -101,6 +112,13 @@ struct CDVEngineSettings
     bool trims = true;
     //! videoscreen.hadesdvgamutfine
     bool fineGamut = false;
+    //! videoscreen.hadesdvl5form, videoscreen.hadesdvlevelorder, videoscreen.hadesdvl254zero,
+    //! videoscreen.hadesdvl3neutral, videoscreen.hadesdvavibt2020
+    int l5Form = 0;
+    bool levelOrder = false;
+    bool l254Zero = false;
+    bool l3Neutral = false;
+    bool aviBt2020 = false;
   };
   //! What advancedsettings.xml says (its defaults: nothing)
   struct Advanced
@@ -132,6 +150,12 @@ struct CDVEngineSettings
   //! the finer table of the gamut mapping, for a picture mapped to the display (Low-Latency):
   //! videoscreen.hadesdvgamutfine (CDVBridgeGLES::UseGamutTable())
   bool fineGamut = false;
+  //! the form of the metadata sent, to compare with what licensed players send (Read)
+  L5Form l5Form = L5Form::PLACED;
+  bool levelOrder = false;
+  bool l254Zero = false;
+  bool l3Neutral = false;
+  bool aviBt2020 = false;
   // what advancedsettings.xml decided, for the log
