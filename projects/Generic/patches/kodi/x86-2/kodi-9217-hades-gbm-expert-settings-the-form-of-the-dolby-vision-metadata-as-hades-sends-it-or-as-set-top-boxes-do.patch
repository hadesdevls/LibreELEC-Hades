@@ -568,6 +568,16 @@ public:
   //! clause 6; 0: in IPT-PQ-c2, as licensed players are reported to send it; 1: reconstructed and
   //! converted to BT.2020) ...
   static constexpr auto SETTING_VIDEOSCREEN_HADESDVTRANSPORT = "videoscreen.hadesdvtransport";
+  //! ... the form of the metadata, to compare on a display with what licensed players send: the level
+  //! 5 block (0 Hades' own, the default; 3 the same without one made where the video has none; 1 as
+  //! the video has it; 2 none), the blocks in the order of their level (off by default), level 254
+  //! with version 0, a neutral level 3 for content mapping v2.9, and BT.2020 in the AVI InfoFrame of
+  //! the tunnel ...
+  static constexpr auto SETTING_VIDEOSCREEN_HADESDVL5FORM = "videoscreen.hadesdvl5form";
+  static constexpr auto SETTING_VIDEOSCREEN_HADESDVLEVELORDER = "videoscreen.hadesdvlevelorder";
+  static constexpr auto SETTING_VIDEOSCREEN_HADESDVL254ZERO = "videoscreen.hadesdvl254zero";
+  static constexpr auto SETTING_VIDEOSCREEN_HADESDVL3NEUTRAL = "videoscreen.hadesdvl3neutral";
+  static constexpr auto SETTING_VIDEOSCREEN_HADESDVAVIBT2020 = "videoscreen.hadesdvavibt2020";
   static constexpr auto SETTING_VIDEOSCREEN_HADESDVGAMUTFINE = "videoscreen.hadesdvgamutfine";
   //! ... and whether a picture on the screen is kept there instead of being drawn again
   static constexpr auto SETTING_VIDEOSCREEN_HADESDVKEEPREPEATS = "videoscreen.hadesdvkeeprepeats";
