diff --git a/addons/resource.language.en_gb/resources/strings.po b/addons/resource.language.en_gb/resources/strings.po
index 8509988..b35331c 100644
--- a/addons/resource.language.en_gb/resources/strings.po
+++ b/addons/resource.language.en_gb/resources/strings.po
@@ -28074,3 +28074,87 @@ msgstr ""
 msgctxt "#62341"
 msgid "This CEC adapter is on {0}, and Kodi's picture is on {1}. The TV sends the keys of its remote to the device on the input you are watching, so they do not reach Kodi through this adapter, and Kodi does not switch the TV's input through it either. For the remote, CEC has to travel on the same cable as the picture: take the picture from the output that has CEC, or put a USB CEC adapter (Pulse-Eight) between the graphics card and the TV. If you connected it this way on purpose, for an AV receiver, nothing needs to change."
 msgstr ""
+
+#. Hades: label of setting "videoscreen.hadesdvl5form"; translated in Estuary (#54370)
+#: system/settings/settings.xml
+msgctxt "#62350"
+msgid "Active area (level 5)"
+msgstr ""
+
+#. Hades: help of setting "videoscreen.hadesdvl5form"; translated in Estuary (#54371)
+#: system/settings/settings.xml
+msgctxt "#62351"
+msgid "For experts, to compare on a display (the reference is the TV's own player playing the same file). The active area tells the TV where the picture is inside the frame, without the black bars. Hades' own, the default: the video's area where the picture is placed on the screen; while menus, the on-screen display or subtitles are drawn over a bar, the area takes that edge in, so that the TV maps them with the picture; and where Hades itself puts bars around a picture, it says so. Hades' own, none where the video has none: the same, but nothing is said of the bars that Hades puts around a picture whose video has no active area (as the TV's own player). As in the video: the area exactly as the video has it (none where it has none), whatever is drawn over the bars. Not sent: no active area at all, as licensed set-top boxes send Dolby Vision TV-led whatever the video has; the TV then takes the whole frame as picture. On an LG C1 and a Hisense (measured by fandangos), a TV without an active area leaves a shadow lift of the colourist's trims aside, and with one applies it inside the area. Takes effect from the next video."
+msgstr ""
+
+#. Hades: value of setting "videoscreen.hadesdvl5form": Hades' own active area (the default); translated in Estuary (#54372)
+#: system/settings/settings.xml
+msgctxt "#62352"
+msgid "Hades' own (placement)"
+msgstr ""
+
+#. Hades: value of setting "videoscreen.hadesdvl5form": the active area of the video as it is; translated in Estuary (#54373)
+#: system/settings/settings.xml
+msgctxt "#62353"
+msgid "As in the video"
+msgstr ""
+
+#. Hades: value of setting "videoscreen.hadesdvl5form": no active area, as licensed players send; translated in Estuary (#54374)
+#: system/settings/settings.xml
+msgctxt "#62354"
+msgid "Not sent (as licensed set-top boxes)"
+msgstr ""
+
+#. Hades: label of setting "videoscreen.hadesdvlevelorder"; translated in Estuary (#54375)
+#: system/settings/settings.xml
+msgctxt "#62355"
+msgid "Metadata blocks in level order"
+msgstr ""
+
+#. Hades: help of setting "videoscreen.hadesdvlevelorder"; translated in Estuary (#54376)
+#: system/settings/settings.xml
+msgctxt "#62356"
+msgid "For experts. Off, the default: the blocks of the Dolby Vision metadata go to the TV in the order in which the video carries them (the part of content mapping v2.9 first, then that of v4.0). On: in the order of their level (1, 2, 3, 4, 5, 8...), as licensed set-top boxes send them. The values are the same either way, and the specification allows both orders. Takes effect from the next video."
+msgstr ""
+
+#. Hades: label of setting "videoscreen.hadesdvl254zero"; translated in Estuary (#54377)
+#: system/settings/settings.xml
+msgctxt "#62357"
+msgid "Level 254 as set-top boxes"
+msgstr ""
+
+#. Hades: help of setting "videoscreen.hadesdvl254zero"; translated in Estuary (#54378)
+#: system/settings/settings.xml
+msgctxt "#62358"
+msgid "For experts. On: the version field of level 254 (content mapping v4.0) goes to the TV as 0, as licensed set-top boxes were seen to send it; videos and dovi_tool carry 2. Off, the default: as the video has it. What a TV reads in it is not public. Takes effect from the next video."
+msgstr ""
+
+#. Hades: label of setting "videoscreen.hadesdvl3neutral"; translated in Estuary (#54379)
+#: system/settings/settings.xml
+msgctxt "#62359"
+msgid "Neutral level 3 for content mapping v2.9"
+msgstr ""
+
+#. Hades: help of setting "videoscreen.hadesdvl3neutral"; translated in Estuary (#54380)
+#: system/settings/settings.xml
+msgctxt "#62360"
+msgid "For experts. On: a video whose metadata are of content mapping v2.9 goes to the TV with a level 3 block of no offsets added, as licensed set-top boxes send it to a TV of Dolby Vision display management 4. Nothing is added for a TV of an older display management, nor to a video of v4.0. Off, the default: as the video has it. Takes effect from the next video."
+msgstr ""
+
+#. Hades: label of setting "videoscreen.hadesdvavibt2020"; translated in Estuary (#54381)
+#: system/settings/settings.xml
+msgctxt "#62361"
+msgid "BT.2020 in the AVI InfoFrame"
+msgstr ""
+
+#. Hades: help of setting "videoscreen.hadesdvavibt2020"; translated in Estuary (#54382)
+#: system/settings/settings.xml
+msgctxt "#62362"
+msgid "For experts. On: during native Dolby Vision TV-led, the AVI InfoFrame tells the TV BT.2020 colorimetry, as licensed set-top boxes send it. Off, the default: no colorimetry, as Hades has always sent Dolby Vision. The bytes of the picture are the same either way. Takes effect from the next video."
+msgstr ""
+
+#. Hades: value of setting "videoscreen.hadesdvl5form": Hades' own active area, none made where the video has none; translated in Estuary (#54383)
+#: system/settings/settings.xml
+msgctxt "#62363"
+msgid "Hades' own, none where the video has none"
+msgstr ""
