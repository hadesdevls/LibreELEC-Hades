@@ -85,6 +85,17 @@ struct CDVEngineSettings
     COMPOSED = 2, //!< the default: the composer's picture as it is, in the representation of its
                   //!< RPU (its own codes, bit for bit)
   };
+  //! videoscreen.hadesdvl5form: the level 5 block (the active area) of the metadata sent
