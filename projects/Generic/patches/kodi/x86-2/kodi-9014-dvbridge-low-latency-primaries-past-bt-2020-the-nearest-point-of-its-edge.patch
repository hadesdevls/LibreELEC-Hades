From cf296a195daaa0925abff9cfb466162733273a67 Mon Sep 17 00:00:00 2001
From: Hades <15710513+hadesdevls@users.noreply.github.com>
Date: Wed, 18 Nov 2026 02:54:28 +0000
Subject: [PATCH] [DVBridge] Low-Latency primaries past BT.2020: the nearest
 point of its edge

The Low-Latency target of a display is what its Dolby Vision block gives:
a peak and three primaries. The signal is BT.2020 and cannot carry a
colour past it, so a block with a primary past BT.2020 (by more than the
rounding of its 1/256 fields, DVBRIDGE_CUSTOM_SLACK) was refused, and
since 2a0c9c4 such a display falls back to Standard where it takes it.
Issue #25 is one: an RGB laser projector whose green (0.1211,0.8203) is
0.050 past BT.2020's. So are 63 of the 220 blocks of Hades' EDID corpus
that give primaries (224 unique Dolby blocks), past by 0.017 at the
most.

What such a display shows of the signal is the intersection of its
triangle and BT.2020's. The mapping takes a triangle, so three were
measured with the software bridge (zink on lavapipe, libplacebo's
perceptual gamut mapping as the bridge sets it), as Delta E ITP
(ITU-R BT.2124) of what the display shows against the ideal (the
picture with each colour it cannot show brought in by the least chroma
at the same intensity and hue): the block's primaries sent as BT.2020,
each primary past BT.2020 taken to the nearest point of its edge, and
the largest triangle inside the intersection (libplacebo's
pl_primaries_clip() gives the same one). Issue #25's block, five blocks
of the corpus and three made-up laser greens, on a colour chart and
three frames of the test videos; the 24 cases of real blocks:

                 mean   p99    worst  displayable  clipped by display
  BT.2020 sent  11.50  56.85  86.81     0.00          62.3 %
  to the edge   13.38  54.48  85.11     4.11          23.1 %
  intersection  13.58  54.85  85.99     4.56          10.2 %

Issue #25's projector: 4.21 to the edge, 5.25 for the intersection
(1.00 against 2.66 on the colours it can show). Sending BT.2020 has the
lowest mean only because nothing is mapped: 62 % of the pixels are past
what the display shows and it clips them, which is what Low-Latency is
there to avoid. The intersection, all inside the display, compresses
more of what the display can show; the edge leaves a sliver of the
target past the display's own edges (2.9 % of it for issue #25's) that
the display clips, and still measures lower in mean, 99th percentile
and worst case (the intersection lower in mean in 6 of the 24 cases,
by 0.65 at the most). On the made-up laser greens the edge is lower in
mean in all 9 cases (by 0.8 to 2.6), the intersection lower in maximum
by up to 1.3. Falling back to Standard or to HDR10 is the display's
own mapping and cannot be measured here.

So dvbridge_ll_gamut_of() takes each primary past BT.2020 to the
nearest point of its edge, and the Low-Latency target of such a block
can be used. A block within BT.2020 and its rounding is taken as given,
bit for bit as before. What no display can have is still refused, with
bounds from the blocks at hand: a primary past BT.2020 by more than
0.075 (1.5 times issue #25's; a version 2 block of zeros has its green
0.154 past it), past the spectral locus of the CIE 1931 observer by
more than 0.025 (the corpus: 0.017, LG TVs whose red is rounded past
it, plus two steps of 1/256), primaries out of order, a triangle
without D65 inside it, or one of which less than 0.40 of BT.2020 is
inside it (BT.709 is 0.53). Over the corpus: 157 blocks as given, 63
taken to the edge, none refused.

DVLowLatencyTargetUsable() logs once, at INFO, the primaries the block
gives, those the mapping takes and why; a block refused gets a WARNING
with the reason.

Host test (ll_gamut_test, both ways): against the bridge before this,
issue #25's block and the 63 blocks of the corpus are refused (2 of 3
checks fail); after it, 10 of 10 pass, the made-up blocks of no display
(fields of zeros, a green past the locus, a green 0.14 past BT.2020,
red and green swapped, a small triangle) refused.
---
 tools/dvbridge/dvbridge_placebo.c             | 197 ++++++++++++++++++
 tools/dvbridge/dvbridge_placebo.h             |  27 +++
 .../windowing/gbm/WinSystemGbmGLESContext.cpp |  33 ++-
 3 files changed, 255 insertions(+), 2 deletions(-)

diff --git a/tools/dvbridge/dvbridge_placebo.c b/tools/dvbridge/dvbridge_placebo.c
index 2c69cb8..4015dd6 100644
--- a/tools/dvbridge/dvbridge_placebo.c
+++ b/tools/dvbridge/dvbridge_placebo.c
@@ -108,6 +108,203 @@ static void nearest_on_edges(const float t[6], float px, float py, float *qx, fl
     }
 }
 
+/* Hades: the spectral locus of the CIE 1931 2-degree standard observer (CIE 015, the chromaticities of
+ * monochromatic light, 380 to 700 nm), and the line of purples back to 380 nm: the colours that light can have. The
+ * primaries of BT.2020 are on it (630, 532 and 467 nm), as the host test checks. */
+static const float LOCUS[][2] = {
+    {0.1741f, 0.0050f}, {0.1733f, 0.0048f}, {0.1714f, 0.0051f}, {0.1689f, 0.0069f}, {0.1644f, 0.0109f},
+    {0.1566f, 0.0177f}, {0.1440f, 0.0297f}, {0.1355f, 0.0399f}, {0.1241f, 0.0578f}, {0.1096f, 0.0868f},
+    {0.0913f, 0.1327f}, {0.0687f, 0.2007f}, {0.0454f, 0.2950f}, {0.0235f, 0.4127f}, {0.0082f, 0.5384f},
+    {0.0039f, 0.6548f}, {0.0139f, 0.7502f}, {0.0389f, 0.8120f}, {0.0743f, 0.8338f}, {0.1142f, 0.8262f},
+    {0.1547f, 0.8059f}, {0.1929f, 0.7816f}, {0.2296f, 0.7543f}, {0.3016f, 0.6923f}, {0.3731f, 0.6245f},
+    {0.4441f, 0.5547f}, {0.5125f, 0.4866f}, {0.5752f, 0.4242f}, {0.6270f, 0.3725f}, {0.6658f, 0.3340f},
+    {0.6915f, 0.3083f}, {0.7079f, 0.2920f}, {0.7190f, 0.2809f}, {0.7260f, 0.2740f}, {0.7300f, 0.2700f},
+    {0.7334f, 0.2666f}, {0.7347f, 0.2653f},
+};
+
+float dvbridge_xy_outside_locus(float x, float y)
+{
+    const int n = (int)(sizeof(LOCUS) / sizeof(LOCUS[0]));
+    double area = 0;
+    for (int i = 0; i < n; ++i)
+        area += (double)LOCUS[i][0] * LOCUS[(i + 1) % n][1] - (double)LOCUS[(i + 1) % n][0] * LOCUS[i][1];
+    float worst = 0;
+    for (int i = 0; i < n; ++i) {
+        const float ax = LOCUS[i][0], ay = LOCUS[i][1], bx = LOCUS[(i + 1) % n][0], by = LOCUS[(i + 1) % n][1];
+        const float len = hypotf(bx - ax, by - ay);
+        if (len <= 0)
+            continue;
+        float d = ((bx - ax) * (y - ay) - (by - ay) * (x - ax)) / len;
+        if (area < 0)
+            d = -d;
+        if (-d > worst)
+            worst = -d;
+    }
+    return worst;
+}
+
+float dvbridge_hdr10_xy_onto_bt2020(float xy[6])
+{
+    if (!xy)
+        return 0.0f;
+    const struct pl_raw_primaries *bt = pl_raw_primaries_get(PL_COLOR_PRIM_BT_2020);
+    const float t[6] = {bt->red.x, bt->red.y, bt->green.x, bt->green.y, bt->blue.x, bt->blue.y};
+    float moved = 0.0f;
+    for (int i = 0; i < 3; ++i) {
+        const float px = xy[2 * i], py = xy[2 * i + 1];
+        if (!(outside_triangle(t, px, py) > 0))
+            continue;
+        float qx = px, qy = py;
+        nearest_on_edges(t, px, py, &qx, &qy);
+        const float d = hypotf(px - qx, py - qy);
+        if (d > moved)
+            moved = d;
+        xy[2 * i] = qx;
+        xy[2 * i + 1] = qy;
+    }
+    return moved;
+}
+
+/* Hades: polygons in xy, counter-clockwise */
+struct xy_poly {
+    int n;
+    float p[16][2];
+};
+
+static float poly_area(const struct xy_poly *a)
+{
+    float s = 0;
+    for (int i = 0; i < a->n; ++i)
+        s += a->p[i][0] * a->p[(i + 1) % a->n][1] - a->p[(i + 1) % a->n][0] * a->p[i][1];
+    return s / 2;
+}
+
+static struct xy_poly tri_ccw(const float t[6])
+{
+    struct xy_poly a = {3, {{t[0], t[1]}, {t[2], t[3]}, {t[4], t[5]}}};
+    if (poly_area(&a) < 0) {
+        a.p[1][0] = t[4];
+        a.p[1][1] = t[5];
+        a.p[2][0] = t[2];
+        a.p[2][1] = t[3];
+    }
+    return a;
+}
+
+/* (Sutherland-Hodgman: a clipped by the convex b) */
+static struct xy_poly poly_clip(struct xy_poly a, const struct xy_poly *b)
+{
+    for (int e = 0; e < b->n && a.n; ++e) {
+        const float ax = b->p[e][0], ay = b->p[e][1];
+        const float bx = b->p[(e + 1) % b->n][0], by = b->p[(e + 1) % b->n][1];
+        struct xy_poly out = {0};
+        for (int i = 0; i < a.n && out.n < 15; ++i) {
+            const float *p = a.p[i], *q = a.p[(i + 1) % a.n];
+            const float dp = (bx - ax) * (p[1] - ay) - (by - ay) * (p[0] - ax);
+            const float dq = (bx - ax) * (q[1] - ay) - (by - ay) * (q[0] - ax);
+            if (dp >= 0) {
+                out.p[out.n][0] = p[0];
+                out.p[out.n][1] = p[1];
+                out.n++;
+            }
+            if ((dp >= 0) != (dq >= 0) && out.n < 15) {
+                const float k = dp / (dp - dq);
+                out.p[out.n][0] = p[0] + k * (q[0] - p[0]);
+                out.p[out.n][1] = p[1] + k * (q[1] - p[1]);
+                out.n++;
+            }
+        }
+        a = out;
+    }
+    return a;
+}
+
+enum dvbridge_ll_gamut dvbridge_ll_gamut_of(const float given[6], float out[6], const char **why)
+{
+    const char *unused;
+    if (!why)
+        why = &unused;
+    *why = NULL;
+    if (!given || !out)
+        return DVBRIDGE_LL_GAMUT_REFUSED;
+    memcpy(out, given, 6 * sizeof(float));
+    const struct pl_raw_primaries *bt = pl_raw_primaries_get(PL_COLOR_PRIM_BT_2020);
+    const float t[6] = {bt->red.x, bt->red.y, bt->green.x, bt->green.y, bt->blue.x, bt->blue.y};
+    bool past = false;
+    float farthest = 0.0f;
+    for (int i = 0; i < 3; ++i) {
+        if (!(given[2 * i] > 0.0f && given[2 * i] < 1.0f && given[2 * i + 1] > 0.0f && given[2 * i + 1] < 1.0f)) {
+            *why = "a primary that is no colour";
+            return DVBRIDGE_LL_GAMUT_REFUSED;
+        }
+        const float out_bt = outside_triangle(t, given[2 * i], given[2 * i + 1]);
+        past = past || out_bt > DVBRIDGE_CUSTOM_SLACK;
+        if (out_bt > farthest)
+            farthest = out_bt;
+    }
+    /* (within BT.2020 and the rounding of the block: as before, dvbridge_hdr10_custom_xy()) */
+    if (!past)
+        return DVBRIDGE_LL_GAMUT_AS_GIVEN;
+    /* What no display has is refused, as before. The bounds are those of the blocks at hand: Hades' EDID corpus (224
+     * unique Dolby VSVDBs) gives primaries past BT.2020 by 0.017 in xy at the most (63 of them past the rounding), and
+     * past the spectral locus by 0.017 at the most (eight LG TVs and receivers that pass their EDID on, whose red and
+     * blue are rounded past it: no light has those colours, but the displays are real); issue #25's laser projector,
+     * past BT.2020 by 0.050 (its green), within the locus. So: a primary farther past BT.2020 than
+     * DVBRIDGE_LL_MAX_PAST (1.5 times issue #25's: a version 2 block of zeros has its green 0.154 past it) or past
+     * the locus by more than DVBRIDGE_LL_LOCUS_SLACK (the corpus's 0.017 and two steps of the block's 1/256);
+     * primaries out of the order of red, green and blue; a white outside them or no triangle; and a gamut of which
+     * less than DVBRIDGE_LL_MIN_AREA of BT.2020 is inside it. */
+    if (farthest > DVBRIDGE_LL_MAX_PAST) {
+        *why = "a primary farther past BT.2020 than any display's";
+        return DVBRIDGE_LL_GAMUT_REFUSED;
+    }
+    for (int i = 0; i < 3; ++i)
+        if (dvbridge_xy_outside_locus(given[2 * i], given[2 * i + 1]) > DVBRIDGE_LL_LOCUS_SLACK) {
+            *why = "a primary past the spectral locus: no light has that colour";
+            return DVBRIDGE_LL_GAMUT_REFUSED;
+        }
+    const struct pl_raw_primaries d = {.red = {given[0], given[1]}, .green = {given[2], given[3]},
+                                       .blue = {given[4], given[5]}, .white = {0.3127f, 0.3290f}};
+    if (!pl_primaries_compatible(&d, bt)) {
+        *why = "primaries out of the order of red, green and blue";
+        return DVBRIDGE_LL_GAMUT_REFUSED;
+    }
+    if (!pl_primaries_valid(&d)) {
+        *why = "primaries whose triangle has no white (D65) inside it";
+        return DVBRIDGE_LL_GAMUT_REFUSED;
+    }
+    const struct xy_poly bt_p = tri_ccw(t), disp = tri_ccw(given);
+    const struct xy_poly inter = poly_clip(disp, &bt_p);
+    if (inter.n < 3 || poly_area(&inter) < DVBRIDGE_LL_MIN_AREA * poly_area(&bt_p)) {
+        *why = "a triangle of which too little is inside BT.2020 to be a display's";
+        return DVBRIDGE_LL_GAMUT_REFUSED;
+    }
+    /* The triangle, chosen by measurement (the software bridge; Delta E ITP, ITU-R BT.2124, of what the display shows,
+     * its own RGB clipped, against the picture with each colour that it cannot show brought in by the least chroma at
+     * its intensity and hue; issue #25's projector, five blocks of the corpus and three made-up laser greens, on a
+     * colour chart and three frames of the test videos, on a bench made for it): each primary past BT.2020
+     * taken to the nearest point of BT.2020's edge, against the largest triangle inside the intersection of the
+     * display's and BT.2020's (all of it a display can show; libplacebo's pl_primaries_clip() makes the same, to
+     * within 0.001). The edge alters what
+     * the display can show less (issue #25's: Delta E ITP 1.0 against 2.7 on those colours, 4.2 against 5.3 on the
+     * whole picture, as libplacebo's perceptual mapping compresses more of what is inside a smaller target), and what it
+     * cannot show is lost either way: the display clips the sliver of the target past its own edges (2.9 % of it for
+     * issue #25's) where the intersection maps it in (the largest error of the two within 1.3 of each other). Over the
+     * 24 cases of real blocks: a mean of 13.4 against 13.6, the 99th percentile 54.5 against 54.9. */
+    float edge[6];
+    memcpy(edge, given, sizeof(edge));
+    dvbridge_hdr10_xy_onto_bt2020(edge);
+    const struct pl_raw_primaries e = {.red = {edge[0], edge[1]}, .green = {edge[2], edge[3]},
+                                       .blue = {edge[4], edge[5]}, .white = {0.3127f, 0.3290f}};
+    if (!pl_primaries_valid(&e) || !pl_primaries_compatible(&e, bt)) {
+        *why = "primaries that taken to BT.2020's edge make no triangle with the white inside it";
+        return DVBRIDGE_LL_GAMUT_REFUSED;
+    }
+    memcpy(out, edge, sizeof(edge));
+    *why = "each primary past BT.2020 taken to the nearest point of its edge";
+    return DVBRIDGE_LL_GAMUT_EDGE;
+}
+
 bool dvbridge_hdr10_custom_xy(const struct dvbridge_hdr10_mapping *m, float xy[8])
 {
     if (!m || !xy || m->gamut != DVBRIDGE_HDR10_GAMUT_CUSTOM)
diff --git a/tools/dvbridge/dvbridge_placebo.h b/tools/dvbridge/dvbridge_placebo.h
index 581a976..a32211f 100644
--- a/tools/dvbridge/dvbridge_placebo.h
+++ b/tools/dvbridge/dvbridge_placebo.h
@@ -246,6 +246,33 @@ enum pl_color_transfer dvbridge_sdr_transfer(const struct dvbridge_hdr10_mapping
  * a primary farther out, a white outside BT.2020, or primaries that are no gamut. */
 #define DVBRIDGE_CUSTOM_SLACK 0.006f
 bool dvbridge_hdr10_custom_xy(const struct dvbridge_hdr10_mapping *m, float xy[8]);
+/* Hades: the target of Dolby Vision Low-Latency of a display whose Dolby VSVDB gives primaries past BT.2020 by more
+ * than DVBRIDGE_CUSTOM_SLACK (the signal is BT.2020 and cannot carry colours past it). What the display shows and the
+ * signal carries is the intersection of its triangle and BT.2020's; the mapping takes a triangle, and the one that
+ * measured best (dvbridge_ll_gamut_of(), in dvbridge_placebo.c) takes each primary past BT.2020 to the nearest point of
+ * its edge (dvbridge_hdr10_xy_onto_bt2020()). What no display can have is refused, as before. given: the primaries
+ * of the block (red, green, blue xy); out: the primaries to map to; returns how they were made, and *why (a fixed
+ * text, for the log) the way they were made or refused. */
+enum dvbridge_ll_gamut {
+    DVBRIDGE_LL_GAMUT_AS_GIVEN, /* within BT.2020 and its rounding: as before (dvbridge_hdr10_custom_xy()) */
+    DVBRIDGE_LL_GAMUT_EDGE,     /* primaries past BT.2020 taken to the nearest point of its edge */
+    DVBRIDGE_LL_GAMUT_REFUSED,  /* no gamut a display can have: refused, as a target past BT.2020 was */
+};
+#define DVBRIDGE_LL_GAMUT 1
+/* ... a primary may be past BT.2020 by up to (issue #25's laser projector: 0.050; Hades' EDID corpus: 0.017) */
+#define DVBRIDGE_LL_MAX_PAST 0.075f
+/* ... and past the spectral locus by up to (the corpus: 0.017, LG TVs whose red is rounded past it; the block's
+ * fields are in steps of 1/256) */
+#define DVBRIDGE_LL_LOCUS_SLACK 0.025f
+/* ... and the intersection must be at least this part of BT.2020 (BT.709 is 0.53 of it; Hades' EDID corpus: 0.53 at
+ * the least) */
+#define DVBRIDGE_LL_MIN_AREA 0.40f
+enum dvbridge_ll_gamut dvbridge_ll_gamut_of(const float given[6], float out[6], const char **why);
+/* Hades: how far the point is outside the spectral locus of the CIE 1931 standard observer (0 inside) */
+float dvbridge_xy_outside_locus(float x, float y);
+/* Hades: the primaries xy (red, green, blue) that are outside BT.2020, each taken onto the nearest point of BT.2020's
+ * edge (dvbridge_hdr10_custom_xy() does so within DVBRIDGE_CUSTOM_SLACK); returns how far the farthest moved */
+float dvbridge_hdr10_xy_onto_bt2020(float xy[6]);
 bool dvbridge_hdr10_gamut_xy(enum dvbridge_hdr10_gamut gamut, float xy[8]);
 /* What an HDR10 output is told of a picture mapped to the display (m on): the display's peak as
  * the maximum of the mastering display and as MaxCLL (nothing brighter is sent), the black of the
diff --git a/xbmc/windowing/gbm/WinSystemGbmGLESContext.cpp b/xbmc/windowing/gbm/WinSystemGbmGLESContext.cpp
index 66bb4c1..076f546 100644
--- a/xbmc/windowing/gbm/WinSystemGbmGLESContext.cpp
+++ b/xbmc/windowing/gbm/WinSystemGbmGLESContext.cpp
@@ -5037,6 +5037,12 @@ dvbridge_hdr10_mapping CWinSystemGbmGLESContext::DVLowLatencyTarget(const UTILS:
     const double xy[8] = {dv.redX, dv.redY, dv.greenX, dv.greenY, dv.blueX, dv.blueY, 0.3127, 0.3290};
     for (int i = 0; i < 8; ++i)
       mapping.target_xy[i] = static_cast<float>(xy[i]);
+    // Hades: primaries past BT.2020, which the signal cannot carry, made a target that the display can show of what it
+    // carries; those of no display left as they are, which the mapping refuses (dvbridge_ll_gamut_of(), and
+    // DVLowLatencyTargetUsable() for the log)
+    float made[6];
+    if (dvbridge_ll_gamut_of(mapping.target_xy, made, nullptr) == DVBRIDGE_LL_GAMUT_EDGE)
+      std::copy(std::begin(made), std::end(made), mapping.target_xy);
     // Hades: the peak and the gamut set by hand (videoscreen.hadesdvllmanual), for a display that
     // says more or less than it does (a projector, a display measured)
     const auto settings = SettingsNow();
@@ -5101,6 +5107,27 @@ bool CWinSystemGbmGLESContext::DVLowLatencyTargetUsable() const
   m_dvLlTargetUsable = dvbridge_hdr10_mapping_valid(&mapping);
   m_dvLlTargetKnown = true;
   m_dvLlTargetKey = key;
+  // Hades: the primaries that the block gives and those that the mapping takes, where they are not the same, and why
+  // (dvbridge_ll_gamut_of()), once
+  const float given[6] = {static_cast<float>(dv.redX),   static_cast<float>(dv.redY),
+                          static_cast<float>(dv.greenX), static_cast<float>(dv.greenY),
+                          static_cast<float>(dv.blueX),  static_cast<float>(dv.blueY)};
+  float made[6];
+  const char* how = nullptr;
+  const dvbridge_ll_gamut way = dvbridge_ll_gamut_of(given, made, &how);
+  if (!manual && way == DVBRIDGE_LL_GAMUT_EDGE)
+    CLog::Log(LOGINFO,
+              "DVBridge: the display's Dolby Vision block gives Low-Latency primaries past BT.2020, which the "
+              "signal cannot carry ({:.4f},{:.4f} {:.4f},{:.4f} {:.4f},{:.4f}): mapped to {:.4f},{:.4f} "
+              "{:.4f},{:.4f} {:.4f},{:.4f}, {} (what measured closest to the display's own gamut within the "
+              "signal: dvbridge_ll_gamut_of())",
+              given[0], given[1], given[2], given[3], given[4], given[5], made[0], made[1], made[2], made[3],
+              made[4], made[5], how ? how : "");
+  else if (!manual && way == DVBRIDGE_LL_GAMUT_REFUSED)
+    CLog::Log(LOGWARNING,
+              "DVBridge: the display's Dolby Vision block gives Low-Latency primaries that no display can have "
+              "({:.4f},{:.4f} {:.4f},{:.4f} {:.4f},{:.4f}): {}",
+              given[0], given[1], given[2], given[3], given[4], given[5], how ? how : "");
   if (!m_dvLlTargetUsable)
     CLog::Log(LOGWARNING,
               "DVBridge: the display's Dolby Vision block gives a Low-Latency target that cannot be "
@@ -5109,8 +5136,10 @@ bool CWinSystemGbmGLESContext::DVLowLatencyTargetUsable() const
               mapping.peak, dv.redX, dv.redY, dv.greenX, dv.greenY, dv.blueX, dv.blueY,
               !(mapping.peak >= DVBRIDGE_HDR10_PEAK_MIN && mapping.peak <= DVBRIDGE_HDR10_PEAK_MAX)
                   ? "a peak that the mapping does not take"
-                  : "a primary or the white outside BT.2020 by more than the rounding of the block "
-                    "(DVBRIDGE_CUSTOM_SLACK), which the signal cannot carry");
+                  : way == DVBRIDGE_LL_GAMUT_REFUSED
+                        ? "primaries that no display can have (dvbridge_ll_gamut_of(): the warning before "
+                          "this says why)"
+                        : "primaries that make no triangle with the white (D65) inside it");
   return m_dvLlTargetUsable;
 }
 
