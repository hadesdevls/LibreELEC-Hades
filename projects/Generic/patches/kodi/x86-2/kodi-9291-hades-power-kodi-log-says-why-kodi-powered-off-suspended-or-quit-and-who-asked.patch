 xbmc/application/ApplicationPowerHandling.cpp | 21 +++++++++++-----
 xbmc/interfaces/builtins/SystemBuiltins.cpp   | 16 ++++++++++++
 .../json-rpc/ApplicationOperations.cpp        |  3 +++
 xbmc/interfaces/json-rpc/SystemOperations.cpp |  9 +++++++
 .../devices/PeripheralCecAdapter.cpp          | 25 +++++++++++++++++++
 6 files changed, 84 insertions(+), 6 deletions(-)

diff --git a/xbmc/application/ApplicationMessageHandling.cpp b/xbmc/application/ApplicationMessageHandling.cpp
index 8b38e51..70e506b 100644
--- a/xbmc/application/ApplicationMessageHandling.cpp
+++ b/xbmc/application/ApplicationMessageHandling.cpp
@@ -193,8 +193,24 @@ void CApplicationMessageHandling::OnApplicationMessage(MESSAGING::ThreadMessage*
     if (CServiceBroker::GetPVRManager().Get<PVR::GUI::PowerManagement>().CanSystemPowerdown())
       msg = pMsg->param1; // perform requested shutdown action
     else
+    {
+      // Hades: said, so that a report shows why the PC stayed on
+      CLog::Log(LOGINFO, "Power: the power action that CEC asked for is not done: PVR keeps the "
+                         "system on (a recording, or one due soon)");
       return; // no shutdown
+    }
   }
+  // Hades: the power action carried out, after the line that says who asked for it
+  if (msg == TMSG_POWERDOWN || msg == TMSG_SHUTDOWN || msg == TMSG_HIBERNATE || msg == TMSG_SUSPEND ||
+      msg == TMSG_RESTART || msg == TMSG_RESET || msg == TMSG_QUIT || msg == TMSG_RESTARTAPP)
+    CLog::Log(LOGINFO, "Power: carried out: {}",
+              msg == TMSG_POWERDOWN    ? "power off"
+              : msg == TMSG_SHUTDOWN   ? "the shutdown function"
+              : msg == TMSG_HIBERNATE  ? "hibernate"
+              : msg == TMSG_SUSPEND    ? "suspend"
+              : msg == TMSG_QUIT       ? "quit Kodi"
+              : msg == TMSG_RESTARTAPP ? "restart Kodi"
+                                       : "reboot");
 
   const auto appPlayer = m_app.GetComponent<CApplicationPlayer>();
 
diff --git a/xbmc/application/ApplicationPowerHandling.cpp b/xbmc/application/ApplicationPowerHandling.cpp
index 3b9c2e0..1345a2d 100644
--- a/xbmc/application/ApplicationPowerHandling.cpp
+++ b/xbmc/application/ApplicationPowerHandling.cpp
@@ -471,8 +471,17 @@ void CApplicationPowerHandling::ResetShutdownTimers()
 
 void CApplicationPowerHandling::HandleShutdownMessage()
 {
-  switch (CServiceBroker::GetSettingsComponent()->GetSettings()->GetInt(
-      CSettings::SETTING_POWERMANAGEMENT_SHUTDOWNSTATE))
+  // Hades: what the shutdown function is set to (powermanagement.shutdownstate)
+  const int state = CServiceBroker::GetSettingsComponent()->GetSettings()->GetInt(
+      CSettings::SETTING_POWERMANAGEMENT_SHUTDOWNSTATE);
+  CLog::Log(LOGINFO, "Power: the shutdown function (powermanagement.shutdownstate {}) is: {}", state,
+            state == POWERSTATE_SHUTDOWN    ? "power off"
+            : state == POWERSTATE_SUSPEND   ? "suspend"
+            : state == POWERSTATE_HIBERNATE ? "hibernate"
+            : state == POWERSTATE_QUIT      ? "quit Kodi"
+            : state == POWERSTATE_MINIMIZE  ? "minimise"
+                                            : "a value it does not know");
+  switch (state)
   {
     case POWERSTATE_SHUTDOWN:
       CServiceBroker::GetAppMessenger()->PostMsg(TMSG_POWERDOWN);
@@ -529,10 +538,10 @@ void CApplicationPowerHandling::CheckShutdown()
     // Since it is a sleep instead of a shutdown, let's set everything to reset when we wake up.
     m_shutdownTimer.Stop();
 
-    // Sleep the box
-    CLog::LogF(LOGDEBUG, "Timer is over (shutdown function: {})",
-               CServiceBroker::GetSettingsComponent()->GetSettings()->GetInt(
-                   CSettings::SETTING_POWERMANAGEMENT_SHUTDOWNSTATE));
+    // Sleep the box (Hades: said at the level of the other origins of a power action)
+    CLog::Log(LOGINFO, "Power: the shutdown function, asked by the idle timer of {} minutes",
+              CServiceBroker::GetSettingsComponent()->GetSettings()->GetInt(
+                  CSettings::SETTING_POWERMANAGEMENT_SHUTDOWNTIME));
     CServiceBroker::GetAppMessenger()->PostMsg(TMSG_SHUTDOWN);
   }
 }
