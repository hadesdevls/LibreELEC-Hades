From c4deb4dee2a372201de71d554472ec3736d2f190 Mon Sep 17 00:00:00 2001
From: Hades <15710513+hadesdevls@users.noreply.github.com>
Date: Wed, 18 Nov 2026 02:16:17 +0000
Subject: [PATCH] windowing/gbm: no native Dolby Vision on NVIDIA through a
 passive DP++ adaptor that does not say HDMI

nvidia-open-kernel-modules-9073 and nvidia-legacy-open-9077 give a
dual-mode DisplayPort connector of nvidia-drm NV_DUAL_MODE_ADAPTOR,
read-only, which the kernel writes where it writes NV_DUAL_MODE_TMDS. While
the display is driven through the TMDS output, it is the passive DisplayPort
dual-mode adaptor (DP++) that NVIDIA's driver reports there: 0 none (the
HDMI port of a laptop wired to such an output through a level shifter, as
on the HP ZBook 17 G6 of issue #4), 1 or 2 an HDMI adaptor of type 1 or 2,
3 one that does not identify itself as an HDMI one (a DVI one, or one that
does not answer at the address of the adaptors: NVIDIA's interface says
that no HDMI should go through it), 255 where the driver did not say.
NVKMS refuses the Dolby vendor InfoFrame through 3, as i915 and amdgpu
refuse their tunnel through such an adaptor.

COutputHandover::DriverOf() no longer takes such a connector for the NVIDIA
backend where the value is 3 or one that this Kodi does not know
(NVIDIA_DUAL_MODE::AdaptorRefusesDV(), NvidiaDualMode.h): native output is
not tried there, the video plays as where native output is not available,
and kodi.log says why ("DVBridge: native Dolby Vision output unavailable:
the display is on a DisplayPort port of the NVIDIA graphics behind a
passive dual-mode adaptor (DP++) that does not identify itself as an HDMI
one ..."). The reason code stays "converter", whose advice in the player
information is an HDMI output, as for amdgpu's adaptors. Where native
output is available on such a connector, its status line says what is
behind the port (NV_DUAL_MODE_ADAPTOR 0, 1 or 2). The value is read through
the cache of CDetectedProperty, once after each look of the kernel at the
display, as NV_DUAL_MODE_TMDS is.

Unchanged: an HDMI connector, a DisplayPort connector driven through its
DisplayPort output, no adaptor reported, an HDMI adaptor, and a driver
without the property.

Host test (NvidiaDualMode.h as it is): 54 checks; six mutants each fail,
among them the rule before this change and one that refuses where no
adaptor is reported. Compiled with the commands of the build: the two
sources changed and the six that include the changed headers.
---
 xbmc/windowing/gbm/WinSystemGbm.cpp       | 16 ++++-
 xbmc/windowing/gbm/drm/NvidiaDualMode.h   | 80 +++++++++++++++++++++++
 xbmc/windowing/gbm/drm/OutputHandover.cpp | 40 ++++++++++++
 xbmc/windowing/gbm/drm/OutputHandover.h   |  6 ++
 4 files changed, 140 insertions(+), 2 deletions(-)

diff --git a/xbmc/windowing/gbm/WinSystemGbm.cpp b/xbmc/windowing/gbm/WinSystemGbm.cpp
index 72016f0..196fe80 100644
--- a/xbmc/windowing/gbm/WinSystemGbm.cpp
+++ b/xbmc/windowing/gbm/WinSystemGbm.cpp
@@ -1531,6 +1531,15 @@ bool CWinSystemGbm::SupportsNativeDVOutput(bool anyMode, bool report) const
       code = dual.code;
       reason = dual.reason;
     }
+    // Hades: ... or (nvidia-drm) the card drives it as HDMI through a passive dual-mode adaptor
+    // that does not identify itself as an HDMI one (NV_DUAL_MODE_ADAPTOR, NvidiaDualMode.h; the
+    // code stays "converter", as for amdgpu's: the advice is an HDMI output)
+    else if (const auto adaptor = COutputHandover::NvidiaAdaptorRefusal(*connector))
+    {
+      code = "converter";
+      reasonText = NVIDIA_DUAL_MODE::AdaptorReason(*adaptor);
+      reason = reasonText.c_str();
+    }
     else
     {
       code = "converter";
@@ -1665,8 +1674,11 @@ bool CWinSystemGbm::SupportsNativeDVOutput(bool anyMode, bool report) const
                    // Hades: the TMDS output of a dual-mode DP connector (NvidiaDualMode.h)
                    (backend == COutputHandover::Driver::NVIDIA_DRM && connector->GetType() == "DP"
                         ? ", on a dual-mode DisplayPort connector that the graphics card drives "
-                          "as HDMI (NV_DUAL_MODE_TMDS is 1)"
-                        : "") +
+                          "as HDMI (NV_DUAL_MODE_TMDS is 1)" +
+                              // Hades: ... and what is behind it (NV_DUAL_MODE_ADAPTOR)
+                              std::string(NVIDIA_DUAL_MODE::AdaptorWay(
+                                  COutputHandover::NvidiaAdaptorVerdict(*connector)))
+                        : std::string()) +
                    // Hades: ... and why Low-Latency: the display offers no other, or the settings
                    // ask for it where the display takes Standard too (it said "offers no other" for
                    // both: issue #25)
diff --git a/xbmc/windowing/gbm/drm/NvidiaDualMode.h b/xbmc/windowing/gbm/drm/NvidiaDualMode.h
index 3251dd0..b651269 100644
--- a/xbmc/windowing/gbm/drm/NvidiaDualMode.h
+++ b/xbmc/windowing/gbm/drm/NvidiaDualMode.h
@@ -10,6 +10,7 @@
 
 #include <cstdint>
 #include <optional>
+#include <string>
 #include <string_view>
 
 /*
@@ -37,6 +38,85 @@ inline bool DrivenAsHdmi(std::string_view type, std::optional<uint64_t> dualMode
   return type == "DP" && dualModeTmds.has_value() && *dualModeTmds == 1;
 }
 
+/*
+ * Hades: the passive DisplayPort dual-mode adaptor (DP++) behind such a connector, as NVKMS has it
+ * from the resource manager of the driver (nvidia-open-kernel-modules-9073, nvidia-legacy-open-9077):
+ * NV_DUAL_MODE_ADAPTOR, read-only, which the kernel sets on detection where it sets
+ * NV_DUAL_MODE_TMDS. While the display is driven through the TMDS output: 0 no adaptor reported (the
+ * port has no means to see one, or saw none: the HDMI port of a laptop wired to such an output
+ * through a level shifter, as on the HP ZBook 17 G6, which the card drives as a native one), 1 or 2
+ * an adaptor of type 1 or 2 that identifies itself as an HDMI one, 3 one that does not (a DVI one,
+ * or one that does not answer at the I2C address of the dual-mode adaptors: NVIDIA's interface says
+ * that no HDMI should go through it), 255 where NVKMS did not say. 0 while the display is driven
+ * through the DisplayPort output, or there is none.
+ */
+constexpr const char* ADAPTOR_PROPERTY = "NV_DUAL_MODE_ADAPTOR";
+
+enum class Adaptor : uint64_t
+{
+  NONE = 0,
+  HDMI_TYPE1 = 1,
+  HDMI_TYPE2 = 2,
+  OTHER = 3,
+};
+
+/*!
+ * Hades: whether native Dolby Vision is kept off a connector for the adaptor behind it: a
+ * DisplayPort connector that the card drives as HDMI (DrivenAsHdmi()) through an adaptor that does
+ * not identify itself as an HDMI one (3), or of a value that this Kodi does not know (fail closed;
+ * 255: NVKMS did not say). NVKMS refuses the Dolby vendor InfoFrame there too. No adaptor reported,
+ * or an HDMI one, is as before (its clock is kept by the modes that the driver lists), and so is a
+ * driver without the property (adaptor nothing), an HDMI connector, and a DisplayPort connector
+ * driven through its DisplayPort output.
+ */
+inline bool AdaptorRefusesDV(std::string_view type,
+                             std::optional<uint64_t> dualModeTmds,
+                             std::optional<uint64_t> adaptor)
+{
+  if (type != "DP" || !DrivenAsHdmi(type, dualModeTmds) || !adaptor.has_value())
+    return false;
+  return *adaptor != static_cast<uint64_t>(Adaptor::NONE) &&
+         *adaptor != static_cast<uint64_t>(Adaptor::HDMI_TYPE1) &&
+         *adaptor != static_cast<uint64_t>(Adaptor::HDMI_TYPE2);
+}
+
+//! Hades: the reason of kodi.log where AdaptorRefusesDV() keeps native output off
+inline std::string AdaptorReason(uint64_t adaptor)
+{
+  const std::string value = std::to_string(adaptor);
+  if (adaptor == static_cast<uint64_t>(Adaptor::OTHER))
+    return "the display is on a DisplayPort port of the NVIDIA graphics behind a passive "
+           "dual-mode adaptor (DP++) that does not identify itself as an HDMI one (a DVI one, or "
+           "one that does not answer as such; NV_DUAL_MODE_ADAPTOR is " +
+           value +
+           "): the driver sends no Dolby Vision through it; an HDMI port, or a passive adaptor "
+           "that identifies itself as an HDMI one, carries it";
+  return "the display is on a DisplayPort port of the NVIDIA graphics, and the driver does not say "
+         "what is behind it (NV_DUAL_MODE_ADAPTOR is " +
+         value + "): native output is not tried there";
+}
+
+//! Hades: what kodi.log says of the adaptor in the status of native output on such a connector
+inline std::string_view AdaptorWay(std::optional<uint64_t> adaptor)
+{
+  if (!adaptor.has_value())
+    return {};
+  switch (*adaptor)
+  {
+    case static_cast<uint64_t>(Adaptor::NONE):
+      return ", with no passive dual-mode adaptor reported by the driver, as on an HDMI port of "
+             "the board (NV_DUAL_MODE_ADAPTOR is 0)";
+    case static_cast<uint64_t>(Adaptor::HDMI_TYPE1):
+      return ", through a passive dual-mode adaptor of type 1 that identifies itself as an HDMI "
+             "one (NV_DUAL_MODE_ADAPTOR is 1)";
+    case static_cast<uint64_t>(Adaptor::HDMI_TYPE2):
+      return ", through a passive dual-mode adaptor of type 2 that identifies itself as an HDMI "
+             "one (NV_DUAL_MODE_ADAPTOR is 2)";
+    default:
+      return {};
+  }
+}
+
 /*!
  * Hades: whether native Dolby Vision brings the link of the connector up from scratch: a dual-mode
  * DisplayPort connector that the card drives as HDMI now (DrivenAsHdmi() for "DP"). Through the
diff --git a/xbmc/windowing/gbm/drm/OutputHandover.cpp b/xbmc/windowing/gbm/drm/OutputHandover.cpp
index e200247..123608f 100644
--- a/xbmc/windowing/gbm/drm/OutputHandover.cpp
+++ b/xbmc/windowing/gbm/drm/OutputHandover.cpp
@@ -97,6 +97,21 @@ CDetectedProperty& KernelDualModeKept()
   static CDetectedProperty kept;
   return kept;
 }
+//! Hades: NV_DUAL_MODE_ADAPTOR of the connector in use, as nvidia-drm wrote it (NvidiaDualMode.h)
+CDetectedProperty& NvidiaAdaptorKept()
+{
+  static CDetectedProperty kept;
+  return kept;
+}
+//! NV_DUAL_MODE_TMDS of a DisplayPort connector that has it, as the kernel wrote it (nothing
+//! otherwise)
+std::optional<uint64_t> NvidiaDualModeTmds(CDRMConnector& connector)
+{
+  if (connector.GetType() != "DP" || !connector.SupportsProperty(NVIDIA_DUAL_MODE::PROPERTY))
+    return std::nullopt;
+  return DualModeKept().Get(connector.GetId(), [&connector]
+                            { return connector.ReadPropertyValue(NVIDIA_DUAL_MODE::PROPERTY); });
+}
 
 bool AnySet(CDRMConnector& connector, const char* const* names, size_t count)
 {
@@ -155,6 +170,27 @@ DV_DUAL_MODE::Offer COutputHandover::DualModeOffer(CDRMConnector& connector)
   return DV_DUAL_MODE::Decide(connector.GetType() == "DP", DualModeVerdict(connector));
 }
 
+std::optional<uint64_t> COutputHandover::NvidiaAdaptorVerdict(CDRMConnector& connector)
+{
+  if (connector.GetType() != "DP" ||
+      !connector.SupportsProperty(NVIDIA_DUAL_MODE::ADAPTOR_PROPERTY))
+    return std::nullopt;
+  // (the kernel writes it when it looks at the display, with NV_DUAL_MODE_TMDS: so from the kernel,
+  // once after each of those looks, CDetectedProperty)
+  return NvidiaAdaptorKept().Get(
+      connector.GetId(),
+      [&connector] { return connector.ReadPropertyValue(NVIDIA_DUAL_MODE::ADAPTOR_PROPERTY); });
+}
+
+std::optional<uint64_t> COutputHandover::NvidiaAdaptorRefusal(CDRMConnector& connector)
+{
+  const auto adaptor = NvidiaAdaptorVerdict(connector);
+  if (NVIDIA_DUAL_MODE::AdaptorRefusesDV(connector.GetType(), NvidiaDualModeTmds(connector),
+                                         adaptor))
+    return adaptor;
+  return std::nullopt;
+}
+
 COutputHandover::Driver COutputHandover::DriverOf(CDRMConnector& connector)
 {
   if (connector.SupportsProperty(KERNEL_DV))
@@ -178,6 +214,10 @@ COutputHandover::Driver COutputHandover::DriverOf(CDRMConnector& connector)
                                   { return connector.ReadPropertyValue(NVIDIA_DUAL_MODE::PROPERTY); });
   if (!NVIDIA_DUAL_MODE::DrivenAsHdmi(type, dualMode))
     return Driver::NONE;
+  // Hades: ... and not through a passive dual-mode adaptor that does not identify itself as an
+  // HDMI one (NV_DUAL_MODE_ADAPTOR: NVKMS refuses Dolby Vision there; NvidiaDualMode.h)
+  if (NVIDIA_DUAL_MODE::AdaptorRefusesDV(type, dualMode, NvidiaAdaptorVerdict(connector)))
+    return Driver::NONE;
   const bool complete = std::ranges::all_of(NVIDIA_NEEDS, [&connector](const char* name)
                                             { return connector.SupportsProperty(name); });
   return complete ? Driver::NVIDIA_DRM : Driver::NONE;
diff --git a/xbmc/windowing/gbm/drm/OutputHandover.h b/xbmc/windowing/gbm/drm/OutputHandover.h
index b398250..a8f6fb2 100644
--- a/xbmc/windowing/gbm/drm/OutputHandover.h
+++ b/xbmc/windowing/gbm/drm/OutputHandover.h
@@ -65,6 +65,12 @@ public:
   static DV_DUAL_MODE::Offer DualModeOffer(CDRMConnector& connector);
   //! Hades: DVBRIDGE_DUAL_MODE of a DisplayPort connector that has it (nothing otherwise)
   static std::optional<uint64_t> DualModeVerdict(CDRMConnector& connector);
+  //! Hades: NV_DUAL_MODE_ADAPTOR of a DisplayPort connector of nvidia-drm that has it (nothing
+  //! otherwise): the passive dual-mode adaptor behind it (NvidiaDualMode.h)
+  static std::optional<uint64_t> NvidiaAdaptorVerdict(CDRMConnector& connector);
+  //! Hades: that value where it keeps native Dolby Vision off the connector
+  //! (NVIDIA_DUAL_MODE::AdaptorRefusesDV()), nothing otherwise
+  static std::optional<uint64_t> NvidiaAdaptorRefusal(CDRMConnector& connector);
   //! The driver of the connector can send Dolby Vision Low-Latency over its tunnel (the kernel:
   //! DVBRIDGE_DV_LOW_LATENCY_LAB, linux-9948 to 9950; nvidia-drm: NV_HDMI_DV_LOW_LATENCY,
   //! nvidia-open-kernel-modules-9030)
-- 
