diff --git a/xbmc/peripherals/devices/PeripheralCecKeys.h b/xbmc/peripherals/devices/PeripheralCecKeys.h
new file mode 100644
index 0000000..8757309
--- /dev/null
+++ b/xbmc/peripherals/devices/PeripheralCecKeys.h
@@ -0,0 +1,52 @@
+/*
+ *  Copyright (C) 2026 Hades
+ *  This file is part of LibreELEC Hades. It is not in Kodi as Team Kodi publishes it.
+ *
+ *  SPDX-License-Identifier: GPL-2.0-or-later
+ *  See LICENSES/README.md for more information.
+ */
+
+#pragma once
+
+#include <libcec/cectypes.h>
+
+/*!
+ * Hades: when the keys of the TV's remote, and the commands of the TV, are taken.
+ *
+ * Kodi took neither until the TV said, over CEC, that it is on (CPeripheralCecAdapterUpdateThread::
+ * WaitReady(): the TV, or the first device to wake, asked once a second for its power status), as
+ * Kodi has done since 2012, when the queries of the TV that follow (its menu language, its name,
+ * the amplifier) were moved after it because some TVs do not like being queried while they switch
+ * sources. The keys waited with them: a TV whose answer comes late left the remote dead for that
+ * long, 39 to 130 s after a start or a wake in the reports of issue #24, and the keys pressed
+ * meanwhile then came all at once.
+ *
+ * A key of the remote comes only from a TV that is on and sends it to Kodi's input, so nothing has
+ * to be waited for to take it: the keys, and the commands of the TV that are keys of its remote
+ * (<Play> and <Deck Control>: its play, pause and stop keys, CPeripheralCecAdapter::CecCommand()),
+ * are taken as soon as the connection to the adapter is open. Every other command of the TV is
+ * taken once it said it is on, as before: its <Standby> (a TV that is off, or being switched off,
+ * while Kodi starts does not suspend or power off the PC through "When the TV is switched off"),
+ * its menu language and the audio state of an amplifier, which the queries after the wait set.
+ */
+namespace PERIPHERALS::CEC_KEYS
+{
+//! A command of the TV that is a key of its remote
+constexpr bool IsRemoteCommand(CEC::cec_opcode opcode)
+{
+  return opcode == CEC::CEC_OPCODE_PLAY || opcode == CEC::CEC_OPCODE_DECK_CONTROL;
+}
+
+//! The keys of the remote: taken while the connection to the adapter is open
+constexpr bool KeysTaken(bool connected)
+{
+  return connected;
+}
+
+//! A command of the TV: a key of the remote while the connection is open, any other once the TV
+//! said it is on
+constexpr bool CommandTaken(CEC::cec_opcode opcode, bool connected, bool tvReady)
+{
+  return tvReady || (connected && IsRemoteCommand(opcode));
+}
+} // namespace PERIPHERALS::CEC_KEYS
