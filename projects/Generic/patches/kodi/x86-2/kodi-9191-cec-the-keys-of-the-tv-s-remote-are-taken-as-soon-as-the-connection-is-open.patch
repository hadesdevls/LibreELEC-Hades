diff --git a/xbmc/peripherals/test/TestPeripheralCecKeys.cpp b/xbmc/peripherals/test/TestPeripheralCecKeys.cpp
new file mode 100644
index 0000000..7e0a9be
--- /dev/null
+++ b/xbmc/peripherals/test/TestPeripheralCecKeys.cpp
@@ -0,0 +1,52 @@
+/*
+ *  Copyright (C) 2026 Hades
+ *  This file is part of LibreELEC Hades. It is not in Kodi as Team Kodi publishes it.
+ *
+ *  SPDX-License-Identifier: GPL-2.0-or-later
+ *  See LICENSES/README.md for more information.
+ */
+
+#include "peripherals/devices/PeripheralCecKeys.h"
+
+#include <gtest/gtest.h>
+
+using namespace PERIPHERALS::CEC_KEYS;
+
+// issue #24: the remote is dead until the TV says it is on (39 to 130 s)
+TEST(TestPeripheralCecKeys, KeysOnceConnected)
+{
+  EXPECT_FALSE(KeysTaken(false));
+  EXPECT_TRUE(KeysTaken(true));
+}
+
+TEST(TestPeripheralCecKeys, TheKeysThatComeAsCommands)
+{
+  // play, pause and stop of the remote, while Kodi waits for the TV
+  EXPECT_TRUE(CommandTaken(CEC::CEC_OPCODE_PLAY, true, false));
+  EXPECT_TRUE(CommandTaken(CEC::CEC_OPCODE_DECK_CONTROL, true, false));
+  // ... not before the connection is open
+  EXPECT_FALSE(CommandTaken(CEC::CEC_OPCODE_PLAY, false, false));
+  EXPECT_FALSE(CommandTaken(CEC::CEC_OPCODE_DECK_CONTROL, false, false));
+}
+
+TEST(TestPeripheralCecKeys, TheOtherCommandsOnceTheTvIsOn)
+{
+  // a TV that is off, or being switched off, while Kodi starts does not suspend the PC; its
+  // menu language and the audio state of an amplifier wait as they did
+  for (const auto opcode : {CEC::CEC_OPCODE_STANDBY, CEC::CEC_OPCODE_SET_MENU_LANGUAGE,
+                            CEC::CEC_OPCODE_SET_SYSTEM_AUDIO_MODE,
+                            CEC::CEC_OPCODE_SYSTEM_AUDIO_MODE_STATUS,
+                            CEC::CEC_OPCODE_REPORT_AUDIO_STATUS})
+  {
+    EXPECT_FALSE(CommandTaken(opcode, true, false)) << opcode;
+    EXPECT_FALSE(CommandTaken(opcode, false, false)) << opcode;
+    EXPECT_TRUE(CommandTaken(opcode, true, true)) << opcode;
+  }
+}
+
+TEST(TestPeripheralCecKeys, EverythingOnceTheTvIsOn)
+{
+  for (const auto opcode : {CEC::CEC_OPCODE_PLAY, CEC::CEC_OPCODE_DECK_CONTROL,
+                            CEC::CEC_OPCODE_STANDBY})
+    EXPECT_TRUE(CommandTaken(opcode, true, true)) << opcode;
+}
