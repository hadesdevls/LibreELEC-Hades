   return CGUIDialog::OnAction(action);
 }
 
+namespace
+{
+constexpr const char* HADES_FILE = "DialogPlayerProcessInfo.xml";
+constexpr const char* KODI_FILE = "DialogPlayerProcessInfoKodi.xml";
+} // namespace
+
+void CGUIDialogPlayerProcessInfo::AllocResources(bool forceLoad /* = false */)
+{
+  // Hades: the file of the skin to show. Kodi's own dialog is a file of its own in Estuary, so that
+  // the setting chooses one or the other whole, and each loads as any window does: ahead while the
+  // menus are idle (CWindowPreload), or at its first open after the setting changed (once; kodi.log
+  // says it, CGUIWindow). A skin without that file keeps its own dialog: the second press of the
+  // player information then opens the pages of Hades in their own dialog (OnAction()).
+  std::string wanted = HADES_FILE;
+  const auto settings = CServiceBroker::GetSettingsComponent()->GetSettings();
+  const auto skin = CServiceBroker::GetGUI()->GetSkinInfo();
+  if (settings && skin && settings->GetBool(CSettings::SETTING_VIDEOSCREEN_HADESKODIPLAYERINFO) &&
+      XFILE::CFile::Exists(skin->GetSkinPath(KODI_FILE)))
+    wanted = KODI_FILE;
+  if (GetProperty("xmlfile").asString() != wanted)
+  {
+    if (m_windowLoaded)
+      CLog::Log(LOGINFO,
+                "CGUIDialogPlayerProcessInfo: the player information is {} from now on ({}), "
+                "loaded again",
+                wanted == KODI_FILE ? "Kodi's own" : "that of LibreELEC Hades", wanted);
+    SetProperty("xmlfile", wanted);
+    forceLoad = true;
+  }
+  CGUIDialog::AllocResources(forceLoad);
+}
+
 void CGUIDialogPlayerProcessInfo::OnWindowLoaded()
 {
   CGUIDialog::OnWindowLoaded();
