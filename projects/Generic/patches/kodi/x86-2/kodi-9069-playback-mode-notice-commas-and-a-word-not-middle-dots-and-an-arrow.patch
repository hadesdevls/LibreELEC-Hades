diff --git a/xbmc/utils/PlaybackMode.h b/xbmc/utils/PlaybackMode.h
index d84481b..a30bf0c 100644
--- a/xbmc/utils/PlaybackMode.h
+++ b/xbmc/utils/PlaybackMode.h
@@ -84,22 +84,22 @@ inline std::string ModeText(uint32_t width,
   return text;
 }
 
-//! \brief One line that says in which mode the video plays: "Dolby Vision · FEL · 3840x2160 @
-//!        23.976 Hz"; "Dolby Vision → HDR10" where a Dolby Vision video is sent as HDR10. Empty
-//!        while the output is not known.
+//! \brief One line that says in which mode the video plays: "Dolby Vision, FEL, 3840x2160 @
+//!        23.976 Hz"; "Dolby Vision to HDR10" where a Dolby Vision video is sent as HDR10. Empty
+//!        while the output is not known. Plain characters, as the public texts of the project
+//!        write (commas and a word, no middle dots or arrows). The word between two formats is
+//!        English, as the names of the formats are: the notice has no string of its own for it.
 inline std::string DescribePlaybackMode(const PlaybackModeInfo& info)
 {
-  static const std::string DOT = "\xC2\xB7";
-  static const std::string ARROW = "\xE2\x86\x92";
   const std::string out = PlaybackModeFormatName(info.output);
   if (out.empty())
     return {};
   const std::string src = PlaybackModeFormatName(info.source);
-  std::string text = !src.empty() && src != out ? src + " " + ARROW + " " + out : out;
+  std::string text = !src.empty() && src != out ? src + " to " + out : out;
   if (info.output == "dolbyvision" && (info.layers == "FEL" || info.layers == "MEL"))
-    text += " " + DOT + " " + info.layers;
+    text += ", " + info.layers;
   if (!info.mode.empty())
-    text += " " + DOT + " " + info.mode;
+    text += ", " + info.mode;
   return text;
 }
 
diff --git a/xbmc/utils/test/TestPlaybackMode.cpp b/xbmc/utils/test/TestPlaybackMode.cpp
index 59b191b..4558556 100644
--- a/xbmc/utils/test/TestPlaybackMode.cpp
+++ b/xbmc/utils/test/TestPlaybackMode.cpp
@@ -17,21 +17,45 @@ TEST(TestPlaybackMode, Describe)
   EXPECT_EQ("", DescribePlaybackMode({}));
   EXPECT_EQ("", DescribePlaybackMode({"hdr10", "", "", "3840x2160 @ 24.000 Hz"}));
   EXPECT_EQ("HDR10", DescribePlaybackMode({"hdr10", "hdr10", "", ""}));
-  EXPECT_EQ("Dolby Vision \xC2\xB7 FEL \xC2\xB7 3840x2160 @ 23.976 Hz",
+  EXPECT_EQ("Dolby Vision, FEL, 3840x2160 @ 23.976 Hz",
             DescribePlaybackMode({"dolbyvision", "dolbyvision", "FEL", "3840x2160 @ 23.976 Hz"}));
-  EXPECT_EQ("Dolby Vision \xC2\xB7 MEL",
+  EXPECT_EQ("Dolby Vision, MEL",
             DescribePlaybackMode({"dolbyvision", "dolbyvision", "MEL", ""}));
   // layers that are not an enhancement layer that is used are not told
   EXPECT_EQ("Dolby Vision", DescribePlaybackMode({"dolbyvision", "dolbyvision", "BL", ""}));
   EXPECT_EQ("Dolby Vision", DescribePlaybackMode({"dolbyvision", "dolbyvision", "FELGAP", ""}));
   // converted: the two, and no layers (they belong to Dolby Vision sent as such)
-  EXPECT_EQ("Dolby Vision \xE2\x86\x92 HDR10",
+  EXPECT_EQ("Dolby Vision to HDR10",
             DescribePlaybackMode({"dolbyvision", "hdr10", "FEL", ""}));
-  EXPECT_EQ("HDR10 \xE2\x86\x92 Dolby Vision",
+  EXPECT_EQ("HDR10 to Dolby Vision",
             DescribePlaybackMode({"hdr10", "dolbyvision", "", ""}));
   EXPECT_EQ("HLG", DescribePlaybackMode({"", "hlg", "", ""}));
 }
 
+// the notice is written in plain characters, as the public texts of the project: commas and a word
+// between the parts, never a middle dot, an arrow or any other character outside ASCII
+TEST(TestPlaybackMode, PlainCharacters)
+{
+  const char* kinds[] = {"", "dolbyvision", "hdr10", "hdr10plus", "hlg", "sdr", "other"};
+  const char* layers[] = {"", "FEL", "MEL", "BL", "FELGAP"};
+  const char* modes[] = {"", "3840x2160 @ 23.976 Hz", "1920x1080i @ 50.000 Hz"};
+  int told = 0;
+  for (const char* source : kinds)
+    for (const char* output : kinds)
+      for (const char* layer : layers)
+        for (const char* mode : modes)
+        {
+          const std::string text = DescribePlaybackMode({source, output, layer, mode});
+          if (!text.empty())
+            told++;
+          for (const unsigned char c : text)
+            EXPECT_TRUE(c >= 0x20 && c < 0x7F) << "'" << text << "' (" << source << ", " << output
+                                               << ", " << layer << ", " << mode << ")";
+        }
+  // every combination with an output that has a name is told: 5 outputs, 7 sources, 5 layers, 3 modes
+  EXPECT_EQ(5 * 7 * 5 * 3, told);
+}
+
 TEST(TestPlaybackMode, ModeText)
 {
   // 3840x2160 at 23.976 Hz (CTA-861 VIC 93 at 1000/1001)
@@ -66,7 +90,7 @@ TEST(TestPlaybackMode, TellsOnceAfterTheOutputSettles)
