+/*!
+ * \brief Hades: the frames that Kodi lost in steady playback, and whether the loss is sustained, for
+ *        the sentence of the overview (SummaryInput::dropped, skipped, lostSustained, bufferingLost)
+ *
+ * Kodi counts, from the start of a video, the frames that its video player dropped because it was
+ * behind and those that its renderer skipped because they came too late for their refresh (the
+ * "drop" and "skip" of its debug information: CDataCacheCore::GetVideoDropped(),
+ * GetVideoSkipped()). The window system samples them while the player information is shown, twice
+ * a second, with the state of the player. Kodi loses frames by design around a start, a seek or a
+ * chapter jump, a pause and its resume, a change of the refresh rate or of a stream, and while its
+ * cache refills: those are no fault, and a person would blame Hades for what the network or a seek
+ * caused. So the loss counts only in steady playback: for SETTLE_S seconds after a new output of a
+ * video, a seek (the renderer's queue emptied) or any sample that is not playing at normal speed
+ * (Restart()), nothing is counted; what is lost while the player buffers is counted apart.
+ *
+ * The sentence changes only on sustained loss: at least MIN_LOST frames over the last WINDOW_S
+ * seconds, lost in at least MIN_PARTS of its parts of PART_S seconds, so that a one-off burst never
+ * flips it. (The case of the audit: 4 dropped and 8 skipped in 10 s at 59.94 Hz, a frame lost about
+ * every second, is past both in its second part; a burst of a few frames, or two lost a minute
+ * apart, is not.) Samples after a gap (the page was closed) or with counters that went back
+ * (another video) start again. Pure logic: a host test runs it (tools/regress of LibreELEC,
+ * kodi-host: verdict_test.cpp).
+ */
+class CLostFrames
+{
+public:
+  static constexpr double WINDOW_S = 30.0;
+  static constexpr double PART_S = 10.0;
+  static constexpr double SETTLE_S = 5.0;
+  //! the longest time between two samples of one window (seconds)
+  static constexpr double GAP_S = 2.0;
+  static constexpr int MIN_LOST = 6;
+  static constexpr int MIN_PARTS = 2;
+
+  //! What the window holds
+  struct Lost
+  {
+    int dropped = 0;
+    int skipped = 0;
+    bool sustained = false; //!< in steady playback
+    int buffering = 0; //!< lost while the player buffered
+    bool bufferingSustained = false;
+  };
+
+  //! a new output of a video (its start, a new mode), a seek or a change of stream, or a moment that
+  //! is not steady playback (paused, another speed, seeking), at now (seconds of a steady clock)
+  void Restart(double now)
+  {
+    m_settleUntil = now + SETTLE_S;
+    m_last.valid = false;
+  }
+
+  //! the counters of the video since it began at now, and whether the player is buffering
+  void Sample(double now, int dropped, int skipped, bool buffering)
+  {
+    // (another video, a gap while the page was not shown, a clock that went back: nothing of what
+    // was before is of this window)
+    if (m_last.valid && (dropped < m_last.dropped || skipped < m_last.skipped || now < m_last.when ||
+                         now - m_last.when > GAP_S))
+    {
+      m_events.clear();
+      m_last.valid = false;
+    }
+    if (m_last.valid && now >= m_settleUntil)
+    {
+      const int d = dropped - m_last.dropped;
+      const int s = skipped - m_last.skipped;
+      if (d > 0 || s > 0)
+        m_events.push_back({now, d, s, buffering});
+    }
+    m_last = {true, now, dropped, skipped};
+    while (!m_events.empty() && m_events.front().when <= now - WINDOW_S)
+      m_events.erase(m_events.begin());
+  }
+
+  Lost Window(double now) const
+  {
+    Lost lost;
+    bool steadyPart[PARTS] = {};
+    bool bufferingPart[PARTS] = {};
+    for (const Event& e : m_events)
+    {
+      const double age = now - e.when;
+      if (age < 0 || age >= WINDOW_S)
+        continue;
+      const int part = std::min(PARTS - 1, static_cast<int>(age / PART_S));
+      if (e.buffering)
+      {
+        lost.buffering += e.dropped + e.skipped;
+        bufferingPart[part] = true;
+      }
+      else
+      {
+        lost.dropped += e.dropped;
+        lost.skipped += e.skipped;
+        steadyPart[part] = true;
+      }
+    }
+    const auto parts = [](const bool* p) { return static_cast<int>(std::count(p, p + PARTS, true)); };
+    lost.sustained = lost.dropped + lost.skipped >= MIN_LOST && parts(steadyPart) >= MIN_PARTS;
+    lost.bufferingSustained = lost.buffering >= MIN_LOST && parts(bufferingPart) >= MIN_PARTS;
+    return lost;
+  }
+
+private:
+  static constexpr int PARTS = static_cast<int>(WINDOW_S / PART_S);
+  struct Event
+  {
+    double when;
+    int dropped;
+    int skipped;
+    bool buffering;
+  };
+  struct Last
+  {
+    bool valid = false;
+    double when = 0.0;
+    int dropped = 0;
+    int skipped = 0;
+  };
+  std::vector<Event> m_events;
+  Last m_last;
+  double m_settleUntil = 0.0;
+};
+
 //! The sentence: the first of the notes, and how many others there are
 inline Summary Decide(const SummaryInput& in)
 {
diff --git a/xbmc/windowing/gbm/WinSystemGbmGLESContext.cpp b/xbmc/windowing/gbm/WinSystemGbmGLESContext.cpp
