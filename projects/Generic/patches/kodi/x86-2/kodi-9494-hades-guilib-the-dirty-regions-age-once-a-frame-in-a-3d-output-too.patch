From 92f402941de753a63a8a9c0d75cd37d16155d020 Mon Sep 17 00:00:00 2001
From: Hades <15710513+hadesdevls@users.noreply.github.com>
Date: Thu, 26 Nov 2026 15:18:11 +0000
Subject: [PATCH] [Hades][guilib] The dirty regions age once a frame in a 3D
 output too

In a 3D output CGUIWindowManager::Render() is called once for each eye,
and the left eye's call says that the frame was presented: the right
eye's call aged the marked regions a second time in the same frame. A
region that the left eye still drew from could then be too old for the
right eye, which kept what the window's buffer had from an older frame.
That frame went to the screen with the GUI of a frame before in the
right eye, and stayed there while nothing else changed: the pointer of
the mouse left where it was a frame or two before, over the player
information of a paused 3D video (Ryudoadema, 1.2.1, NVIDIA). It
depends on the age of the window's buffers that EGL reports: with an
age of 2 or 4 a pointer that stops leaves it, with 3 or 5 a single step.

Only the call that starts a frame (no 3D, or the left eye) ages the
regions and forgets that the frame before was presented
(DirtyRegionAging.h): both eyes of a frame draw from the same regions,
and every buffer is drawn again for as many frames as without 3D.
---
 xbmc/guilib/CMakeLists.txt       |  1 +
 xbmc/guilib/DirtyRegionAging.h   | 36 ++++++++++++++++++++++++++++++++
 xbmc/guilib/GUIWindowManager.cpp | 13 +++++++++---
 3 files changed, 47 insertions(+), 3 deletions(-)
 create mode 100644 xbmc/guilib/DirtyRegionAging.h

diff --git a/xbmc/guilib/CMakeLists.txt b/xbmc/guilib/CMakeLists.txt
index ad8dab7..0f7c151 100644
--- a/xbmc/guilib/CMakeLists.txt
+++ b/xbmc/guilib/CMakeLists.txt
@@ -78,6 +78,7 @@ set(SOURCES DDSImage.cpp
 set(HEADERS AspectRatio.h
             DDSImage.h
             DirtyRegion.h
+            DirtyRegionAging.h
             DirtyRegionSolvers.h
             DirtyRegionTracker.h
             DispResource.h
diff --git a/xbmc/guilib/DirtyRegionAging.h b/xbmc/guilib/DirtyRegionAging.h
new file mode 100644
index 0000000..2c0dde4
--- /dev/null
+++ b/xbmc/guilib/DirtyRegionAging.h
@@ -0,0 +1,36 @@
+/*
+ *  Copyright (C) 2026 Hades
+ *  This file is part of LibreELEC Hades. It is not in Kodi as Team Kodi publishes it.
+ *
+ *  SPDX-License-Identifier: GPL-2.0-or-later
+ *  See LICENSES/README.md for more information.
+ */
+
+#pragma once
+
+#include "rendering/RenderSystemTypes.h"
+
+/*!
+ * \brief Hades: the dirty regions of the GUI age once a presented frame, also in a 3D output
+ *
+ * CGUIWindowManager::Render() ages the marked regions when the frame before was presented, and then
+ * draws where a region marked within the age of the buffer (and one more) says so. In a 3D output it
+ * is called once for each eye (KODI::RENDERING::STEREO_VIEWS::ForEachView()), and the left eye's call
+ * says the frame was presented: the right eye's call aged them a second time in the same frame. A
+ * region that the left eye still drew from could then be too old for the right eye, which kept what
+ * the buffer had from an older frame: that frame went to the screen with the GUI of the frame before
+ * in the right eye, and stayed there while nothing else changed (the pointer of the mouse left where
+ * it was a few frames before, Ryudoadema, 1.2.1). Both eyes of a frame now draw from the same regions:
+ * only the call that starts a frame ages them.
+ */
+namespace KODI::GUILIB::DIRTY_REGION_AGING
+{
+
+//! \brief Whether a call of Render() in this view starts a frame (no 3D, or the first eye): only
+//!        such a call ages the regions and forgets that the frame before was presented
+constexpr bool StartsFrame(RenderStereoView view)
+{
+  return view != RenderStereoView::RIGHT;
+}
+
+} // namespace KODI::GUILIB::DIRTY_REGION_AGING
diff --git a/xbmc/guilib/GUIWindowManager.cpp b/xbmc/guilib/GUIWindowManager.cpp
index 0ea095d..273549c 100644
--- a/xbmc/guilib/GUIWindowManager.cpp
+++ b/xbmc/guilib/GUIWindowManager.cpp
@@ -9,6 +9,7 @@
 #include "GUIWindowManager.h"
 
 #include "ClosingWatch.h"
+#include "DirtyRegionAging.h"
 #include "GUIAudioManager.h"
 #include "GUIDialog.h"
 #include "GUIInfoManager.h"
@@ -1508,9 +1509,15 @@ bool CGUIWindowManager::Render()
     bufferAge = 20;
   // the buffer age counts presented frames and varies between frames, so keep the regions
   // independently of it and only age them when a frame was presented
-  if (m_presentedFrame)
-    m_tracker.CleanMarkedRegions((visualizeDirtyRegions ? bufferAge : MAX_BUFFER_AGE) + 1);
-  m_presentedFrame = false;
+  // (Hades: once a frame, also in a 3D output, where this is called for each eye: the right eye draws
+  // from the regions the left eye drew from, DirtyRegionAging.h)
+  if (KODI::GUILIB::DIRTY_REGION_AGING::StartsFrame(
+          CServiceBroker::GetWinSystem()->GetGfxContext().GetStereoView()))
+  {
+    if (m_presentedFrame)
+      m_tracker.CleanMarkedRegions((visualizeDirtyRegions ? bufferAge : MAX_BUFFER_AGE) + 1);
+    m_presentedFrame = false;
+  }
 
   // one frame more than needed, as some platforms report a fixed buffer age
   CDirtyRegionList dirtyRegions = m_tracker.GetDirtyRegions(bufferAge + 1);
