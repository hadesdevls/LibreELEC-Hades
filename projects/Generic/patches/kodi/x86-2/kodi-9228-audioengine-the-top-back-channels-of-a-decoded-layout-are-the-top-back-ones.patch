             TestAEStreamParser.cpp
diff --git a/xbmc/cores/AudioEngine/Utils/test/TestAEChannelLayout.cpp b/xbmc/cores/AudioEngine/Utils/test/TestAEChannelLayout.cpp
new file mode 100644
index 0000000..fc94a7b
--- /dev/null
+++ b/xbmc/cores/AudioEngine/Utils/test/TestAEChannelLayout.cpp
@@ -0,0 +1,73 @@
+/*
+ *  Copyright (C) 2026 Hades
+ *  This file is part of LibreELEC Hades. It is not in Kodi as Team Kodi publishes it.
+ *
