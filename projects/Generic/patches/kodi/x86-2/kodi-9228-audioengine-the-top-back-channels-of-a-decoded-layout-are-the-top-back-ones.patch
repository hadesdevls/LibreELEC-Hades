From e06597b9763e1bb181c5f6b1aaa5c23d8d39d39e Mon Sep 17 00:00:00 2001
From: Hades <15710513+hadesdevls@users.noreply.github.com>
Date: Tue, 24 Nov 2026 20:57:54 +0000
Subject: [PATCH] AudioEngine: the top-back channels of a decoded layout are
 the top-back ones

CAEUtil::GetAEChannelLayout() and CDVDAudioCodecFFmpeg::BuildChannelMap()
translate an FFmpeg channel layout into a CAEChannelInfo, and both took
AV_CH_TOP_BACK_LEFT, _CENTER and _RIGHT for AE_CH_BL, BC and BR, the
channels that AV_CH_BACK_LEFT, _CENTER and _RIGHT give ten lines above.
A layout with both, every layout with heights behind from 5.1.2 up
(multichannel PCM, FLAC or AAC decoded by FFmpeg, or a layout of a
TrueHD or DTS-HD decoder that names its heights), came out with the back
pair twice and no top-back channel: the downmix and the speaker map put
the heights in the rears. Bitstream (Atmos passed through) is not
touched. The reverse translation, CAEUtil::GetAVChannelLayout(), already
maps AE_CH_TBL, TBC and TBR to AV_CH_TOP_BACK_*.

The top-back channels now go to AE_CH_TBL, TBC and TBR, and
BuildChannelMap() takes CAEUtil::GetAEChannelLayout() instead of its own
copy of the table (the same 18 lines in the same order), so that the
two cannot differ again.

Found by SamuriHL (SamuriHL/coreelec-xbmc commit 0820cb342c, "ae: map
the top-back channels to their own AE channels, not the back pair"),
who found it while reviewing avdvplus R10.
---
 xbmc/cores/AudioEngine/Utils/AEUtil.cpp       |  6 +-
 .../AudioEngine/Utils/test/CMakeLists.txt     |  1 +
 .../Utils/test/TestAEChannelLayout.cpp        | 73 +++++++++++++++++++
 .../DVDCodecs/Audio/DVDAudioCodecFFmpeg.cpp   | 23 +-----
 4 files changed, 80 insertions(+), 23 deletions(-)
 create mode 100644 xbmc/cores/AudioEngine/Utils/test/TestAEChannelLayout.cpp

diff --git a/xbmc/cores/AudioEngine/Utils/AEUtil.cpp b/xbmc/cores/AudioEngine/Utils/AEUtil.cpp
index 4592862..d2484a4 100644
--- a/xbmc/cores/AudioEngine/Utils/AEUtil.cpp
+++ b/xbmc/cores/AudioEngine/Utils/AEUtil.cpp
@@ -491,9 +491,9 @@ CAEChannelInfo CAEUtil::GetAEChannelLayout(uint64_t layout)
   if (layout & AV_CH_TOP_FRONT_LEFT)   channelLayout += AE_CH_TFL;
   if (layout & AV_CH_TOP_FRONT_CENTER) channelLayout += AE_CH_TFC;
   if (layout & AV_CH_TOP_FRONT_RIGHT)  channelLayout += AE_CH_TFR;
-  if (layout & AV_CH_TOP_BACK_LEFT)    channelLayout += AE_CH_BL;
-  if (layout & AV_CH_TOP_BACK_CENTER)  channelLayout += AE_CH_BC;
-  if (layout & AV_CH_TOP_BACK_RIGHT)   channelLayout += AE_CH_BR;
+  if (layout & AV_CH_TOP_BACK_LEFT)    channelLayout += AE_CH_TBL;
+  if (layout & AV_CH_TOP_BACK_CENTER)  channelLayout += AE_CH_TBC;
+  if (layout & AV_CH_TOP_BACK_RIGHT)   channelLayout += AE_CH_TBR;
 
   return channelLayout;
 }
diff --git a/xbmc/cores/AudioEngine/Utils/test/CMakeLists.txt b/xbmc/cores/AudioEngine/Utils/test/CMakeLists.txt
index b215c97..9a454f0 100644
--- a/xbmc/cores/AudioEngine/Utils/test/CMakeLists.txt
+++ b/xbmc/cores/AudioEngine/Utils/test/CMakeLists.txt
@@ -1,5 +1,6 @@
 set(SOURCES TestAEBackCentre.cpp
             TestAEBitstreamPacker.cpp
+            TestAEChannelLayout.cpp
             TestAEPackIEC61937.cpp
