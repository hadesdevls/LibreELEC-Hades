+
+#include "cores/AudioEngine/Utils/AEChannelInfo.h"
+#include "cores/AudioEngine/Utils/AEUtil.h"
+
+#include <cstdint>
+#include <set>
+
+#include <gtest/gtest.h>
+
+namespace
+{
+//! Each channel of the layout once
+bool Distinct(const CAEChannelInfo& info)
+{
+  std::set<AEChannel> seen;
+  for (unsigned int i = 0; i < info.Count(); ++i)
+    if (!seen.insert(info[i]).second)
+      return false;
+  return true;
+}
+} // namespace
+
+//! 7.1.4 with its heights behind (FFmpeg's 7.1.4 back): the rears once, and the top-back pair as
+//! the top-back pair. Before, AV_CH_TOP_BACK_* gave AE_CH_BL/BC/BR, the back channels again.
+TEST(TestAEChannelLayout, TheTopBackChannelsOf714AreTheirOwn)
+{
+  const CAEChannelInfo info = CAEUtil::GetAEChannelLayout(AV_CH_LAYOUT_7POINT1POINT4_BACK);
+
+  EXPECT_EQ(12u, info.Count());
+  EXPECT_TRUE(Distinct(info));
+  EXPECT_TRUE(info.HasChannel(AE_CH_TBL));
+  EXPECT_TRUE(info.HasChannel(AE_CH_TBR));
+  EXPECT_TRUE(info.HasChannel(AE_CH_BL));
+  EXPECT_TRUE(info.HasChannel(AE_CH_BR));
+}
+
+TEST(TestAEChannelLayout, TheTopBackCentreIsItsOwn)
+{
+  const uint64_t layout = AV_CH_LAYOUT_5POINT1_BACK | AV_CH_BACK_CENTER | AV_CH_TOP_BACK_LEFT |
+                          AV_CH_TOP_BACK_CENTER | AV_CH_TOP_BACK_RIGHT;
+  const CAEChannelInfo info = CAEUtil::GetAEChannelLayout(layout);
+
+  EXPECT_EQ(10u, info.Count());
+  EXPECT_TRUE(Distinct(info));
+  EXPECT_TRUE(info.HasChannel(AE_CH_TBC));
+  EXPECT_TRUE(info.HasChannel(AE_CH_BC));
+}
+
+//! FFmpeg's layout and back: the same channels (GetAVChannelLayout() maps AE_CH_TB* to
+//! AV_CH_TOP_BACK_*), for the layouts with heights FFmpeg names, and the plain ones as before
+TEST(TestAEChannelLayout, ALayoutGoesToTheEngineAndBackTheSame)
+{
+  for (const uint64_t layout :
+       {static_cast<uint64_t>(AV_CH_LAYOUT_STEREO), static_cast<uint64_t>(AV_CH_LAYOUT_5POINT1),
+        static_cast<uint64_t>(AV_CH_LAYOUT_5POINT1_BACK), static_cast<uint64_t>(AV_CH_LAYOUT_7POINT1),
+        static_cast<uint64_t>(AV_CH_LAYOUT_5POINT1POINT2_BACK),
+        static_cast<uint64_t>(AV_CH_LAYOUT_5POINT1POINT4_BACK),
+        static_cast<uint64_t>(AV_CH_LAYOUT_7POINT1POINT2),
+        static_cast<uint64_t>(AV_CH_LAYOUT_7POINT1POINT4_BACK),
+        static_cast<uint64_t>(AV_CH_LAYOUT_9POINT1POINT4_BACK)})
+  {
+    const CAEChannelInfo info = CAEUtil::GetAEChannelLayout(layout);
+    EXPECT_EQ(static_cast<unsigned int>(__builtin_popcountll(layout)), info.Count()) << layout;
+    EXPECT_EQ(layout, CAEUtil::GetAVChannelLayout(info)) << layout;
+  }
+}
diff --git a/xbmc/cores/VideoPlayer/DVDCodecs/Audio/DVDAudioCodecFFmpeg.cpp b/xbmc/cores/VideoPlayer/DVDCodecs/Audio/DVDAudioCodecFFmpeg.cpp
index f0ed5b9..d4418ec 100644
--- a/xbmc/cores/VideoPlayer/DVDCodecs/Audio/DVDAudioCodecFFmpeg.cpp
+++ b/xbmc/cores/VideoPlayer/DVDCodecs/Audio/DVDAudioCodecFFmpeg.cpp
@@ -451,26 +451,9 @@ void CDVDAudioCodecFFmpeg::BuildChannelMap()
     }
   }
 
-  m_channelLayout.Reset();
-
-  if (layout & AV_CH_FRONT_LEFT           ) m_channelLayout += AE_CH_FL  ;
-  if (layout & AV_CH_FRONT_RIGHT          ) m_channelLayout += AE_CH_FR  ;
-  if (layout & AV_CH_FRONT_CENTER         ) m_channelLayout += AE_CH_FC  ;
-  if (layout & AV_CH_LOW_FREQUENCY        ) m_channelLayout += AE_CH_LFE ;
-  if (layout & AV_CH_BACK_LEFT            ) m_channelLayout += AE_CH_BL  ;
-  if (layout & AV_CH_BACK_RIGHT           ) m_channelLayout += AE_CH_BR  ;
-  if (layout & AV_CH_FRONT_LEFT_OF_CENTER ) m_channelLayout += AE_CH_FLOC;
-  if (layout & AV_CH_FRONT_RIGHT_OF_CENTER) m_channelLayout += AE_CH_FROC;
-  if (layout & AV_CH_BACK_CENTER          ) m_channelLayout += AE_CH_BC  ;
-  if (layout & AV_CH_SIDE_LEFT            ) m_channelLayout += AE_CH_SL  ;
-  if (layout & AV_CH_SIDE_RIGHT           ) m_channelLayout += AE_CH_SR  ;
-  if (layout & AV_CH_TOP_CENTER           ) m_channelLayout += AE_CH_TC  ;
-  if (layout & AV_CH_TOP_FRONT_LEFT       ) m_channelLayout += AE_CH_TFL ;
-  if (layout & AV_CH_TOP_FRONT_CENTER     ) m_channelLayout += AE_CH_TFC ;
-  if (layout & AV_CH_TOP_FRONT_RIGHT      ) m_channelLayout += AE_CH_TFR ;
-  if (layout & AV_CH_TOP_BACK_LEFT        ) m_channelLayout += AE_CH_BL  ;
-  if (layout & AV_CH_TOP_BACK_CENTER      ) m_channelLayout += AE_CH_BC  ;
-  if (layout & AV_CH_TOP_BACK_RIGHT       ) m_channelLayout += AE_CH_BR  ;
+  // Hades: the one translation of an FFmpeg layout (CAEUtil::GetAEChannelLayout()), not a copy
+  // of it that took the top-back channels for the back ones
+  m_channelLayout = CAEUtil::GetAEChannelLayout(static_cast<uint64_t>(layout));
 
   m_channels = codecChannels;
 }
