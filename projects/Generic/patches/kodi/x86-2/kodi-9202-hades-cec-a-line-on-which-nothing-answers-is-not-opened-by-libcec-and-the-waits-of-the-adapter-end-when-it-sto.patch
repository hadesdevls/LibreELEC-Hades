 .../devices/PeripheralCecAdapter.cpp          | 72 +++++++++++++++-
 .../devices/PeripheralCecAdapter.h            |  6 ++
 xbmc/peripherals/devices/PeripheralCecLine.h  | 84 +++++++++++++++++++
 4 files changed, 162 insertions(+), 1 deletion(-)
 create mode 100644 xbmc/peripherals/devices/PeripheralCecLine.h

diff --git a/xbmc/peripherals/devices/CMakeLists.txt b/xbmc/peripherals/devices/CMakeLists.txt
index 5320fc0..984f31d 100644
--- a/xbmc/peripherals/devices/CMakeLists.txt
+++ b/xbmc/peripherals/devices/CMakeLists.txt
@@ -26,6 +26,7 @@ if(TARGET ${APP_NAME_LC}::CEC)
   list(APPEND SOURCES PeripheralCecAdapter.cpp)
   list(APPEND HEADERS PeripheralCecAdapter.h
                       PeripheralCecKeys.h
+                      PeripheralCecLine.h
                       PeripheralCecPicture.h)
 endif()
 
diff --git a/xbmc/peripherals/devices/PeripheralCecAdapter.cpp b/xbmc/peripherals/devices/PeripheralCecAdapter.cpp
index 699fa7c..6f9061f 100644
--- a/xbmc/peripherals/devices/PeripheralCecAdapter.cpp
+++ b/xbmc/peripherals/devices/PeripheralCecAdapter.cpp
@@ -383,9 +383,36 @@ bool CPeripheralCecAdapter::OpenConnection(void)
       CServiceBroker::GetResourcesComponent().GetLocalizeStrings().Get(36000), strMessage);
 
   bool bConnectionFailedDisplayed(false);
+  // Hades: polls of the line in a row that got no result, and whether that was told
+  int deadInRow = 0;
+  bool deadTold = false;
 
   while (!m_bStop && !bIsOpen)
   {
+    // Hades: a line on which nothing answers is not opened by libCEC, whose open waits for minutes
+    // there; it is asked again later (CEC_LINE)
+    const CEC_LINE::Line line = AskLine();
+    deadInRow = line == CEC_LINE::Line::DEAD ? deadInRow + 1 : 0;
+    if (CEC_LINE::GivenUp(deadInRow))
+    {
+      if (!deadTold)
+        CLog::Log(LOGWARNING,
+                  "CEC: nothing answers on the line of the adapter {}: polls of the TV got no result "
+                  "of the line, only timeouts or errors ({} in a row), as every message would. "
+                  "libCEC does not open it (its open would wait for minutes); the line is asked "
+                  "again every {} s. A DisplayPort output whose converter passes no CEC does this",
+                  m_strComPort, deadInRow, CEC_LINE::AGAIN_SECONDS);
+      deadTold = true;
+      WaitUnlessStopped(std::chrono::seconds(CEC_LINE::AGAIN_SECONDS));
+      continue;
+    }
+    if (deadTold && line == CEC_LINE::Line::ALIVE)
+    {
+      CLog::Log(LOGINFO, "CEC: the line of the adapter {} answers now: libCEC opens it",
+                m_strComPort);
+      deadTold = false;
+    }
+
     if ((bIsOpen = m_cecAdapter->Open(m_strComPort.c_str(), 10000)) == false)
     {
       // display warning: couldn't initialise libCEC
@@ -397,7 +424,8 @@ bool CPeripheralCecAdapter::OpenConnection(void)
             CServiceBroker::GetResourcesComponent().GetLocalizeStrings().Get(36012));
       bConnectionFailedDisplayed = true;
 
-      CThread::Sleep(10000ms);
+      // (Hades: a wait that ends when the thread is stopped, at sleep or at the end of Kodi)
+      WaitUnlessStopped(10000ms);
     }
   }
 
@@ -2064,6 +2092,48 @@ void CPeripheralCecAdapter::ProcessActivateSource(void)
   }
 }
 
+CEC_LINE::Line CPeripheralCecAdapter::AskLine()
+{
+#if defined(TARGET_LINUX)
+  if (!m_strComPort.starts_with("/dev/cec"))
+    return CEC_LINE::Line::UNKNOWN;
+  const int fd = open(m_strComPort.c_str(), O_RDWR | O_CLOEXEC);
+  if (fd < 0)
+    return CEC_LINE::Line::UNKNOWN;
+  // (an adapter that has logical addresses is in use, by libCEC or by another program: not asked)
+  struct cec_log_addrs addrs = {};
+  if (ioctl(fd, CEC_ADAP_G_LOG_ADDRS, &addrs) != 0 || addrs.log_addr_mask != 0)
+  {
+    close(fd);
+    return CEC_LINE::Line::UNKNOWN;
+  }
+  // a poll from the unregistered address to the TV, blocking: the kernel returns once the line
+  // gave a result or its retries ended
+  struct cec_msg poll = {};
+  poll.len = 1;
+  poll.msg[0] = 0xf0;
+  const bool transmitted = ioctl(fd, CEC_TRANSMIT, &poll) == 0;
+  close(fd);
+  const CEC_LINE::Line line = CEC_LINE::Of(transmitted, poll.tx_status);
+  CLog::Log(LOGDEBUG, "CEC: a poll of the TV on the line of {}: {} (tx_status 0x{:02x})",
+            m_strComPort,
+            line == CEC_LINE::Line::ALIVE  ? "a result of the line"
+            : line == CEC_LINE::Line::DEAD ? "no result of the line"
+                                           : "nothing said",
+            poll.tx_status);
+  return line;
+#else
+  return CEC_LINE::Line::UNKNOWN;
+#endif
+}
+
+void CPeripheralCecAdapter::WaitUnlessStopped(std::chrono::milliseconds duration)
+{
+  const auto until = std::chrono::steady_clock::now() + duration;
+  while (!m_bStop && std::chrono::steady_clock::now() < until)
+    CThread::Sleep(100ms);
+}
+
