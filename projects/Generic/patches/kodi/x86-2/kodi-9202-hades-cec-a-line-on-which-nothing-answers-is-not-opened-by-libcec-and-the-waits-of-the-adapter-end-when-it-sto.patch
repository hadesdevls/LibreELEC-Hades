   //! Hades: libCEC told whether a route to Kodi takes the TV's input through this adapter
diff --git a/xbmc/peripherals/devices/PeripheralCecLine.h b/xbmc/peripherals/devices/PeripheralCecLine.h
new file mode 100644
index 0000000..ed9d0b3
--- /dev/null
+++ b/xbmc/peripherals/devices/PeripheralCecLine.h
@@ -0,0 +1,84 @@
+/*
+ *  Copyright (C) 2026 Hades
+ *  This file is part of LibreELEC Hades. It is not in Kodi as Team Kodi publishes it.
+ *
+ *  SPDX-License-Identifier: GPL-2.0-or-later
+ *  See LICENSES/README.md for more information.
+ */
+
+#pragma once
+
+#include <cstdint>
+
+namespace PERIPHERALS
+{
+namespace CEC_LINE
+{
+
+/*!
+ * \brief Hades: whether the CEC line of an adapter of the kernel answers at all
+ *
+ * libCEC opens an adapter of the kernel (/dev/cecN) and, before its open returns, claims a logical
+ * address, asks the TV for its vendor and sends what a new device sends; each message that gets no
+ * result waits for the kernel's timeout, and is sent again. On a line where no message gets a
+ * result at all (issue 24: the CEC adapter of a DisplayPort output whose converter passes no CEC,
+ * every message "timed out" in the kernel log, every logical address "polling ... failed with
+ * tx_status=0x00a0"), the open did not return for minutes: Kodi did not try the adapter again,
+ * and the thread of the adapter, stopped at sleep or at the end of Kodi, held those up until it
+ * returned (11 s at the end of Kodi in that report).
+ *
+ * So before libCEC opens it, the line is asked once: a poll from the unregistered address to the
+ * TV (the message 0xf0, which the kernel sends on an adapter that has no logical address yet). A
+ * result of the line, an acknowledgement or a negative one (no TV), says that it works, and libCEC
+ * opens it as before. Neither, only a timeout, an error or lost arbitration after the retries of the
+ * kernel, says that nothing answers. Anything else (the kernel refuses the poll, the adapter goes
+ * away) says nothing, and libCEC opens it as before.
+ */
+enum class Line
+{
+  ALIVE, //!< the poll got a result of the line: an acknowledgement, or a negative one
+  DEAD, //!< it got no result of the line at all
+  UNKNOWN, //!< the poll could not be asked, or ended without saying (aborted)
+};
+
+//! The bits of tx_status of the kernel's struct cec_msg (linux/cec.h), here so that this is tested
+//! without it
+inline constexpr uint8_t TX_OK = 1u << 0;
+inline constexpr uint8_t TX_ARB_LOST = 1u << 1;
+inline constexpr uint8_t TX_NACK = 1u << 2;
+inline constexpr uint8_t TX_LOW_DRIVE = 1u << 3;
+inline constexpr uint8_t TX_ERROR = 1u << 4;
+inline constexpr uint8_t TX_MAX_RETRIES = 1u << 5;
+inline constexpr uint8_t TX_ABORTED = 1u << 6;
+inline constexpr uint8_t TX_TIMEOUT = 1u << 7;
+
+//! \param transmitted the kernel took the poll (CEC_TRANSMIT returned 0)
+//! \param status its tx_status
+constexpr Line Of(bool transmitted, uint8_t status)
+{
+  if (!transmitted)
+    return Line::UNKNOWN;
+  if (status & (TX_OK | TX_NACK))
+    return Line::ALIVE;
+  if (status & TX_ABORTED)
+    return Line::UNKNOWN;
+  if (status & (TX_TIMEOUT | TX_ERROR | TX_ARB_LOST | TX_LOW_DRIVE))
+    return Line::DEAD;
+  return Line::UNKNOWN;
+}
+
+//! A line is given up on (libCEC is not asked to open it) after this many polls in a row that got no
+//! result: one may be a line that is busy
+inline constexpr int DEAD_IN_ROW = 2;
+
+//! How long the thread of the adapter waits before it asks a line that answered nothing again, in
+//! seconds: a TV switched on, or a cable put in, is found then
+inline constexpr int AGAIN_SECONDS = 30;
+
+constexpr bool GivenUp(int deadInRow)
+{
+  return deadInRow >= DEAD_IN_ROW;
+}
+
+} // namespace CEC_LINE
+} // namespace PERIPHERALS
