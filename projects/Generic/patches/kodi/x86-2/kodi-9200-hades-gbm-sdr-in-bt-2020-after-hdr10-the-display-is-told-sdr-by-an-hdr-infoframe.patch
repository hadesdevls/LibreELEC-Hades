From c7dbc5aa468b56fc09389a8d38615ec6d999ea38 Mon Sep 17 00:00:00 2001
From: Hades <15710513+hadesdevls@users.noreply.github.com>
Date: Tue, 24 Nov 2026 18:40:00 +0000
Subject: [PATCH] [Hades][GBM] SDR in BT.2020 after HDR10: the display is told
 SDR by an HDR InfoFrame

With "Keep the wide colours of SDR videos (BT.2020)" on, an SDR picture of
BT.2020 primaries that follows an HDR10 one goes out with the colorimetry
of the output unchanged, BT.2020, and the end of the HDR signalling only
takes HDR_OUTPUT_METADATA away: i915 and amdgpu then send no HDR InfoFrame
at all. A display that keeps the gamut may stay in PQ: an LG G5 did, as
CroqueMr's build found (CroqueMr/libreelec-CB1 commit dd2c267ccd, PR #306),
where it sends an InfoFrame of SDR from the amdgpu driver.

Here the display is told SDR as CTA-861 has it, from Kodi and for every
driver that needs it: while an SDR picture goes out in BT.2020,
HDR_OUTPUT_METADATA is an InfoFrame of type 1 whose EOTF is that of SDR
(traditional gamma, 0) and whose metadata are otherwise zero, where the
display declares that EOTF and those metadata. It goes with the end of
that picture, and never takes the place of the metadata of an HDR picture.
Not with nvidia-drm, whose NVKMS tells the display SDR itself at the end of
HDR (nvkms-hdmi.c), nor where the settings have no HDR display.
CHDRSignal::SdrSignal() decides it within the state that SetHDR() keeps
(Request(), Settle(): a refused commit leaves what the kernel has), and the
link takes it for SDR, not HDR. kodi.log says when it is sent and taken
away, and why it is not sent.

On amdgpu the InfoFrame reaches the display only where the commit
reprograms the pipe, which a commit at the same timing does not: that is
Hades' linux patch for the static HDR packet of a reused pipe.
---
 xbmc/windowing/gbm/HDRSignal.h                | 68 +++++++++++++++
 xbmc/windowing/gbm/WinSystemGbm.cpp           | 87 +++++++++++++++++--
 xbmc/windowing/gbm/WinSystemGbm.h             | 26 ++++++
 .../windowing/gbm/WinSystemGbmGLESContext.cpp |  5 ++
 4 files changed, 181 insertions(+), 5 deletions(-)

diff --git a/xbmc/windowing/gbm/HDRSignal.h b/xbmc/windowing/gbm/HDRSignal.h
index f906a60..6135a66 100644
--- a/xbmc/windowing/gbm/HDRSignal.h
+++ b/xbmc/windowing/gbm/HDRSignal.h
@@ -203,6 +203,74 @@ public:
     return outcome;
   }
 
+  //! Hades: what is known of the output for the HDR InfoFrame that says SDR (SdrSignal())
+  struct SdrFacts
+  {
+    bool hdrDisplay = false; //!< the settings have an HDR display (Use HDR display capabilities)
+    bool driverTells = false; //!< the driver tells the display SDR itself at the end of HDR (NVKMS)
+  };
+
+  /*!
+   * \brief Hades: the display told SDR by an HDR InfoFrame of the EOTF of SDR while an SDR picture
+   *        goes out in BT.2020, or no longer (CWinSystemGbm::SetSdrSignal() says why)
+   * \param on an SDR picture goes out in BT.2020 now; false: it goes out no more
+   * \param eotf, blob, queued the state, as for Request()
+   * \param id the id of that HDR_OUTPUT_METADATA while it may be queued or kept by the kernel; 0
+   *        once something else has the property for good (SdrSignalSettled())
+   * \param display what the connector and the display take, as Request() reads it, for the EOTF of
+   *        SDR (TRADITIONAL_SDR): its HDR static metadata of type 1 and that EOTF
+   * \param out the request, as for Request(); its Make() makes the blob of that InfoFrame (the
+   *        metadata of type 1, EOTF 0, everything else zero)
+   * \return why it is not sent, where it is asked for and is not; nullptr otherwise
+   *
+   * Sent only where nothing has the property (an HDR picture keeps its own metadata), the settings
+   * have an HDR display and the driver does not tell the display SDR itself; taken away only where
+   * it is the one queued.
+   */
+  template<typename Blob, typename Out>
+  static const char* SdrSignal(bool on,
+                               UTILS::Eotf& eotf,
+                               Blob& blob,
+                               std::optional<uint64_t>& queued,
+                               uint64_t& id,
+                               const SdrFacts& facts,
+                               const Display& display,
+                               Out& out,
+                               std::optional<Before<Blob>>* before = nullptr,
+                               uint64_t request = 0)
+  {
+    if (!on)
+    {
+      if (id != 0 && queued.value_or(0) == id)
+        Request(eotf, blob, queued, std::nullopt, display, true, out, before, request);
+      return nullptr;
+    }
+    if (queued.value_or(0) != 0)
+      return nullptr;
+    if (!facts.hdrDisplay)
+      return "the settings have no HDR display (Use HDR display capabilities is off)";
+    if (facts.driverTells)
+      return "the driver tells the display SDR itself when HDR ends (NVKMS)";
+    const Outcome outcome = Request(eotf, blob, queued, UTILS::Eotf::TRADITIONAL_SDR, display, false,
+                                    out, before, request);
+    if (!outcome.Sent())
+    {
+      if (outcome.reason == Reason::NO_EOTF)
+        return "the display does not declare the EOTF of SDR (traditional gamma)";
+      return Why(outcome.reason);
+    }
+    id = queued.value_or(0);
+    return nullptr;
+  }
+
+  //! Hades: the id of the HDR InfoFrame that says SDR goes once neither the request nor what waits
+  //! for it (waiting: a change not settled yet) holds it
+  static void SdrSignalSettled(uint64_t& id, bool waiting, std::optional<uint64_t> queued)
+  {
+    if (id != 0 && !waiting && queued.value_or(0) != id)
+      id = 0;
+  }
+
   //! What was queued last is queued again, in another request (a modeset, or after a refused
   //! commit): a change that waits is carried by that one now
   template<typename Blob>
diff --git a/xbmc/windowing/gbm/WinSystemGbm.cpp b/xbmc/windowing/gbm/WinSystemGbm.cpp
index 6e0be3c..15b90bd 100644
--- a/xbmc/windowing/gbm/WinSystemGbm.cpp
+++ b/xbmc/windowing/gbm/WinSystemGbm.cpp
@@ -6372,8 +6372,10 @@ bool CWinSystemGbm::SetHDR(const VideoPicture* videoPicture)
     }
   } request{*this, *drm, *connector, hdr_metadata, *settings};
 
-  // (Hades: whether HDR is signalled before this request, for the depth of the link below)
-  const bool signalledBefore = m_queuedHdrMetadata.value_or(0) != 0;
+  // (Hades: whether HDR is signalled before this request, for the depth of the link below; the HDR
+  // InfoFrame that says SDR is none, SetSdrSignal())
+  const bool sdrSignalBefore = SdrSignalQueued();
+  const bool signalledBefore = m_queuedHdrMetadata.value_or(0) != 0 && !sdrSignalBefore;
   const CHDRSignal::Outcome outcome =
       CHDRSignal::Request(m_eotf, m_hdrBlob, m_queuedHdrMetadata, want, display, !videoPicture,
                           request, &m_hdrBefore, drm->RequestGeneration());
@@ -6388,7 +6390,9 @@ bool CWinSystemGbm::SetHDR(const VideoPicture* videoPicture)
   m_hdrNotSent.store(want && !outcome.Sent() ? static_cast<int>(outcome.reason) + 1 : 0,
                      std::memory_order_relaxed);
   if (outcome.cleared)
-    CLog::Log(LOGINFO, "HDR output: the HDR metadata of the video before is taken away");
+    CLog::Log(LOGINFO, "HDR output: {} is taken away",
+              sdrSignalBefore ? "the HDR InfoFrame that said SDR (SDR in BT.2020)"
+                              : "the HDR metadata of the video before");
   if (outcome.kept)
     CLog::Log(LOGWARNING, "HDR output: the HDR metadata queued before could not be taken away "
                           "(HDR_OUTPUT_METADATA was not added to the request): the output keeps "
@@ -6400,7 +6404,7 @@ bool CWinSystemGbm::SetHDR(const VideoPicture* videoPicture)
   // signalling on or off, or with the change of mode that waits for it, which set the head again
   // anyway.
   QueuePictureLinkDepth(videoPicture, outcome.Sent(), signalledBefore,
-                        m_queuedHdrMetadata.value_or(0) != 0);
+                        m_queuedHdrMetadata.value_or(0) != 0 && !SdrSignalQueued());
 
   // Hades: the metadata of the picture whose HDR this signals, for a capture mapped to SDR
   NoteOutputHdrMetadata(videoPicture, outcome.Sent());
@@ -6443,6 +6447,75 @@ bool CWinSystemGbm::FillCaptureHdrMetadata(KODI::RENDERING::CAPTURE::CaptureResu
   return true;
 }
 
+void CWinSystemGbm::SetSdrSignal(bool on)
+{
+  auto drm = std::dynamic_pointer_cast<CDRMAtomic>(m_DRM);
+  auto* connector = drm ? drm->GetConnector() : nullptr;
+  if (!connector || !connector->SupportsProperty("HDR_OUTPUT_METADATA"))
+    return;
+  // (from what the kernel has, where a change before this one is not settled yet)
+  SettleHDR();
+
+  // the request, as CHDRSignal::Request() uses it: nothing goes along with it
+  struct SdrRequest
+  {
+    CDRMAtomic& drm;
+    CDRMConnector& connector;
+    const hdr_output_metadata& metadata;
+
+    CDRMPropertyBlob Make() const
+    {
+      return CDRMPropertyBlob(drm.GetFileDescriptor(), &metadata, sizeof(metadata));
+    }
+    bool Queue(uint64_t value) const
+    {
+      return drm.AddProperty(&connector, "HDR_OUTPUT_METADATA", value);
+    }
+    void Modeset() const { drm.SetActive(true); }
+    void Along() const {}
+  };
+  hdr_output_metadata sdr = {};
+  sdr.metadata_type = KODI::UTILS::HDMI_STATIC_METADATA_TYPE1;
+  sdr.hdmi_metadata_type1.metadata_type = KODI::UTILS::HDMI_STATIC_METADATA_TYPE1;
+  sdr.hdmi_metadata_type1.eotf = static_cast<uint8_t>(KODI::UTILS::Eotf::TRADITIONAL_SDR);
+  SdrRequest request{*drm, *connector, sdr};
+
+  CHDRSignal::Display display;
+  display.property = true;
+  CHDRSignal::SdrFacts facts;
+  if (on)
+  {
+    const auto component = CServiceBroker::GetSettingsComponent();
+    const auto settings = component ? component->GetSettings() : nullptr;
+    facts.hdrDisplay = settings && settings->GetBool(SETTING_WINSYSTEM_IS_HDR_DISPLAY);
+    facts.driverTells = m_DRM->DriverName() == "nvidia-drm";
+    const auto info = DisplayInfo();
+    display.info = info != nullptr;
+    display.staticHdr = info && info->SupportsHDRStaticMetadataType1();
+    display.eotf = info && info->SupportsEOTF(KODI::UTILS::Eotf::TRADITIONAL_SDR);
+  }
+  const bool was = SdrSignalQueued();
+  const char* why =
+      CHDRSignal::SdrSignal(on, m_eotf, m_hdrBlob, m_queuedHdrMetadata, m_sdrSignalId, facts,
+                            display, request, &m_hdrBefore, drm->RequestGeneration());
+  if (why)
+  {
+    // why the display is not told SDR, once until it is
+    if (why != m_sdrSignalTold)
+      CLog::Log(LOGINFO, "SDR in BT.2020: the display is not told SDR by an HDR InfoFrame: {}", why);
+    m_sdrSignalTold = why;
+    return;
+  }
+  m_sdrSignalTold.clear();
+  if (!was && SdrSignalQueued())
+    CLog::Log(LOGINFO, "SDR in BT.2020: the display is told SDR by an HDR InfoFrame of the EOTF of "
+                       "SDR (traditional gamma), its metadata otherwise zero, while the picture goes "
+                       "out in BT.2020: a display that keeps the gamut of HDR10 is not left in PQ");
+  else if (was && !SdrSignalQueued())
+    CLog::Log(LOGINFO, "HDR output: the HDR InfoFrame that said SDR is taken away: no SDR picture "
+                       "goes out in BT.2020 now");
+}
+
 void CWinSystemGbm::QueuePictureLinkDepth(const VideoPicture* picture,
                                           bool hdrSent,
                                           bool signalledBefore,
@@ -6757,7 +6830,8 @@ void CWinSystemGbm::ReadLinkDepthOutput(CDRMConnector& connector)
 
 LinkContent CWinSystemGbm::CurrentLinkContent() const
 {
-  if (m_queuedHdrMetadata.value_or(0) != 0)
+  // (Hades: the HDR InfoFrame that says SDR is no HDR: SetSdrSignal())
+  if (m_queuedHdrMetadata.value_or(0) != 0 && !SdrSignalQueued())
     return LinkContent::HDR;
   return OutputBufferDeep() ? LinkContent::SDR_DEEP : LinkContent::SDR;
 }
@@ -7051,6 +7125,9 @@ void CWinSystemGbm::SettleHDR()
               "HDR output: the connector has other HDR metadata than Kodi asked for ({}): the state "
               "of Kodi is what it has ({})",
               name(asked), name(m_eotf));
+  // (Hades: the HDR InfoFrame that says SDR is gone for good once neither the request nor what
+  // waits for it holds it: SetSdrSignal())
+  CHDRSignal::SdrSignalSettled(m_sdrSignalId, m_hdrBefore.has_value(), m_queuedHdrMetadata);
   // Hades: the end of the HDR signalling, refused, is asked for again (AskHDREndAgain())
   switch (m_hdrEndRetry.Found(settled, askedValue, m_queuedHdrMetadata,
                               CHDRSignal::EndRetry::Clock::now()))
diff --git a/xbmc/windowing/gbm/WinSystemGbm.h b/xbmc/windowing/gbm/WinSystemGbm.h
index 8b271c4..837670a 100644
--- a/xbmc/windowing/gbm/WinSystemGbm.h
+++ b/xbmc/windowing/gbm/WinSystemGbm.h
@@ -399,6 +399,27 @@ public:
   // Hades: stereoscopic 3D over HDMI (see drm/DRMStereo.h)
   bool GetStereoOutputMode(RESOLUTION res, RenderStereoMode mode, RESOLUTION_INFO& info) override;
   RenderStereoMode GetStereoOutputArrangement(RenderStereoMode wanted) override;
+  /*!
+   * \brief Hades: whether the display is told SDR while an SDR picture goes out in BT.2020
+   *        (KODI::UTILS::SDRWIDE)
+   *
+   * An SDR picture that goes out in BT.2020 after an HDR10 one keeps the colorimetry of the
+   * output. Where the HDR signalling then only stops (HDR_OUTPUT_METADATA taken away: i915 and
+   * amdgpu send no InfoFrame of HDR any more), a display that keeps the gamut may stay in PQ: an
+   * LG G5 did (CroqueMr's build, commit dd2c267ccd). Here the display is told SDR as CTA-861 has
+   * it, by an HDR InfoFrame whose EOTF is that of SDR (0) and whose metadata of type 1 is
+   * otherwise zero, for as long as the SDR picture goes out in BT.2020, where the display declares
+   * that EOTF and those metadata; it goes with the end of that picture. Not with nvidia-drm, whose
+   * NVKMS tells the display SDR itself at the end of HDR (nvkms-hdmi.c), nor where the settings
+   * have no HDR display, nor while an HDR picture has the property.
+   * \param on an SDR picture goes out in BT.2020 now; false: it goes out no more
+   */
+  void SetSdrSignal(bool on);
+  //! Hades: the HDR_OUTPUT_METADATA queued is the one that says SDR (SetSdrSignal())
+  bool SdrSignalQueued() const
+  {
+    return m_sdrSignalId != 0 && m_queuedHdrMetadata.value_or(0) == m_sdrSignalId;
+  }
   bool HasStereoDisplay() override { return m_stereoDisplay.load(); }
   //! Hades: the 3D output as it is, for the player information (STEREO::ShownOf()): the layout of
   //! the mode that the output was last seen in, the InfoFrame that the driver has from Kodi, and how
@@ -1235,6 +1256,11 @@ private:
   void NoteOutputHdrMetadata(const VideoPicture* picture, bool sent);
   mutable std::mutex m_outputHdrLock;
   std::optional<OutputHdrMetadata> m_outputHdr;
+  //! Hades: the id of the HDR_OUTPUT_METADATA that says SDR (SetSdrSignal()) while it may be
+  //! queued or kept by the kernel; 0 once something else has the property for good (SettleHDR())
+  uint64_t m_sdrSignalId{0};
+  //! ... and why it was not sent, told once until it is
+  std::string m_sdrSignalTold;
   //! Hades: ... and the end of the HDR signalling, followed until the kernel has it, and asked for
   //! again where the driver refused it (CHDRSignal::EndRetry, AskHDREndAgain())
   CHDRSignal::EndRetry m_hdrEndRetry;
diff --git a/xbmc/windowing/gbm/WinSystemGbmGLESContext.cpp b/xbmc/windowing/gbm/WinSystemGbmGLESContext.cpp
index 6ab9c32..0e60e3d 100644
--- a/xbmc/windowing/gbm/WinSystemGbmGLESContext.cpp
+++ b/xbmc/windowing/gbm/WinSystemGbmGLESContext.cpp
@@ -2406,6 +2406,8 @@ std::string CWinSystemGbmGLESContext::SetSdrWide(const VideoPicture* picture)
   {
     if (m_guiCompositing && m_compositeSdrWide)
       SetGuiCompositing(0);
+    // (Hades: and the display is no longer told SDR by an HDR InfoFrame: SetSdrSignal())
+    SetSdrSignal(false);
     return {};
   }
 
@@ -2437,6 +2439,9 @@ std::string CWinSystemGbmGLESContext::SetSdrWide(const VideoPicture* picture)
     told.iWidth = picture->iWidth;
     told.iHeight = picture->iHeight;
     SetColorimetry(&told);
+    // ... and SDR, where an HDR10 picture before it may have left the display in PQ at the same
+    // gamut (SetSdrSignal())
+    SetSdrSignal(true);
   }
   if (f.test)
     CLog::Log(LOGWARNING,
-- 
