From 1120d452ba28c23e68dcedfc08aba54f01c05e6e Mon Sep 17 00:00:00 2001
From: Hades <15710513+hadesdevls@users.noreply.github.com>
Date: Tue, 24 Nov 2026 19:10:00 +0000
Subject: [PATCH] [Hades][VideoPlayer] The last pictures of a file are shown
 before the player ends

At the end of a file, CVideoPlayer::OnExit() closes the video stream once
its thread has drained the decoder and handed the last pictures to the
render manager, which keeps them queued until the clock reaches their times.
It then left the render loop and flushed the render manager: what was still
queued, the last pictures of the file (up to the depth of the queue and the
latency of the display), was never shown. Where the sound is longer, the
wait for its end showed them; a file without sound, or whose picture
outlasts its sound, lost them.

Now, at the end of a file that played to its end (not a stop, which sets
m_bAbortRequest), the player waits while the queue holds pictures, after
the video stream is closed and before it leaves the render loop, for at most
two seconds (KODI::VIDEOPLAYER::EOF_PRESENTATION), so that a render loop that
does not present does not hold the end of playback up; kodi.log says how
many pictures were waited for and how long. CroqueMr's build found the case
(CroqueMr/xbmc commit 2da20195f1, which waits in the loop of the player,
before the video thread has handed over the last drained pictures).
---
 xbmc/cores/VideoPlayer/CMakeLists.txt    |  1 +
 xbmc/cores/VideoPlayer/EofPresentation.h | 52 ++++++++++++++++++++++++
 xbmc/cores/VideoPlayer/VideoPlayer.cpp   | 29 +++++++++++++
 3 files changed, 82 insertions(+)
 create mode 100644 xbmc/cores/VideoPlayer/EofPresentation.h

diff --git a/xbmc/cores/VideoPlayer/CMakeLists.txt b/xbmc/cores/VideoPlayer/CMakeLists.txt
index c1d6a1d..25cc3d8 100644
--- a/xbmc/cores/VideoPlayer/CMakeLists.txt
+++ b/xbmc/cores/VideoPlayer/CMakeLists.txt
@@ -38,6 +38,7 @@ set(HEADERS AudioSinkAE.h
             DVDStreamInfo.h
             DeclaredFrameRate.h
             Edl.h
+            EofPresentation.h
             Edl/EdlParser.h
             Edl/EdlParserFactory.h
             Edl/EdlParsers/BeyondTVParser.h
diff --git a/xbmc/cores/VideoPlayer/EofPresentation.h b/xbmc/cores/VideoPlayer/EofPresentation.h
new file mode 100644
index 0000000..c8d2eb8
--- /dev/null
+++ b/xbmc/cores/VideoPlayer/EofPresentation.h
@@ -0,0 +1,52 @@
+/*
+ *  Copyright (C) 2026 Hades
+ *  This file is part of LibreELEC Hades. It is not in Kodi as Team Kodi publishes it.
+ *
+ *  SPDX-License-Identifier: GPL-2.0-or-later
+ *  See LICENSES/README.md for more information.
+ */
+
+#pragma once
+
+#include <chrono>
+
+namespace KODI
+{
+namespace VIDEOPLAYER
+{
+namespace EOF_PRESENTATION
+{
+
+/*!
+ * \brief Hades: the last pictures of a file are shown before the player ends
+ *
+ * At the end of a file the player closes its streams (CVideoPlayer::OnExit()): the video one once
+ * its thread has drained the decoder and handed the last pictures to the render manager, which
+ * keeps them in its queue until the clock reaches their times. Then the player stopped taking part
+ * in the render loop and flushed the render manager: what was still queued, the last pictures of
+ * the file, up to the depth of the queue and the latency of the display, was never shown. With the
+ * sound longer than the picture, the wait for the sound to end showed them; a file without sound,
+ * or whose picture outlasts its sound, lost them. (CroqueMr's build waits for them in the loop of
+ * the player, commit 2da20195f1 of CroqueMr/xbmc; there the last pictures that the video thread
+ * still hands over after the loop are not waited for.)
+ *
+ * Here, at the end of a file that played to its end (not a stop), once the video stream is closed,
+ * the player waits while the queue holds pictures, for at most MAX_WAIT: a render loop that does
+ * not present (the clock stopped, no display) does not hold the end of playback up.
+ */
+inline constexpr std::chrono::milliseconds MAX_WAIT{2000};
+inline constexpr std::chrono::milliseconds STEP{10};
+
+//! Whether the player waits for the queue of the render manager at the end of the file
+//! \param ended the file played to its end (not a stop, an error or another file asked for)
+//! \param video the file has a video stream
+//! \param queued pictures in the queue of the render manager, not shown yet
+//! \param waited how long it has waited for them
+constexpr bool Waits(bool ended, bool video, int queued, std::chrono::milliseconds waited)
+{
+  return ended && video && queued > 0 && waited < MAX_WAIT;
+}
+
+} // namespace EOF_PRESENTATION
+} // namespace VIDEOPLAYER
+} // namespace KODI
diff --git a/xbmc/cores/VideoPlayer/VideoPlayer.cpp b/xbmc/cores/VideoPlayer/VideoPlayer.cpp
index 50dbb96..6e7ecf1 100644
--- a/xbmc/cores/VideoPlayer/VideoPlayer.cpp
+++ b/xbmc/cores/VideoPlayer/VideoPlayer.cpp
@@ -30,6 +30,7 @@
 #include "DVDInputStreams/DVDInputStreamNavigator.h"
 #include "DVDInputStreams/InputStreamPVRBase.h"
 #include "DVDMessage.h"
+#include "EofPresentation.h"
 #include "FileItem.h"
 #include "LangInfo.h"
 #include "ServiceBroker.h"
@@ -3982,6 +3983,8 @@ void CVideoPlayer::OnExit()
     AttachPlayedVideo(fileItem);
 
   CloseStream(m_CurrentAudio, !m_bAbortRequest);
+  // Hades: whether the file has a video stream, for the wait for its last pictures below
+  const bool hadVideo = m_CurrentVideo.id >= 0;
   CloseStream(m_CurrentVideo, !m_bAbortRequest);
   CloseStream(m_CurrentTeletext,!m_bAbortRequest);
   CloseStream(m_CurrentRadioRDS, !m_bAbortRequest);
@@ -3994,6 +3997,32 @@ void CVideoPlayer::OnExit()
   m_subtitleSearch->Stop();
   m_overlayContainer.Clear();
 
+  // Hades: at the end of a file, its last pictures are shown before the render loop goes and the
+  // render manager is flushed (KODI::VIDEOPLAYER::EOF_PRESENTATION)
+  {
+    namespace EOFP = KODI::VIDEOPLAYER::EOF_PRESENTATION;
+    const auto start = std::chrono::steady_clock::now();
+    int late = 0, queued = 0, discard = 0, atStart = 0;
+    double pts = 0.0;
+    std::chrono::milliseconds waited{0};
+    m_renderManager.GetStats(late, pts, queued, discard);
+    atStart = queued;
+    while (EOFP::Waits(!m_bAbortRequest, hadVideo, queued, waited))
+    {
+      CThread::Sleep(EOFP::STEP);
+      m_renderManager.GetStats(late, pts, queued, discard);
+      waited = std::chrono::duration_cast<std::chrono::milliseconds>(
+          std::chrono::steady_clock::now() - start);
+    }
+    if (atStart > 0 && !m_bAbortRequest && hadVideo)
+      CLog::Log(queued > 0 ? LOGWARNING : LOGINFO,
+                "VideoPlayer: at the end of the file, {} of its pictures were still to be shown: {} "
+                "in {} ms{}",
+                atStart, queued > 0 ? "not all of them were" : "they were", waited.count(),
+                queued > 0 ? StringUtils::Format(" ({} left, given up after {} ms)", queued,
+                                                 EOFP::MAX_WAIT.count())
+                           : std::string());
+  }
   CServiceBroker::GetWinSystem()->UnregisterRenderLoop(this);
 
   IPlayerCallback *cb = &m_callback;
-- 
