-    "uint i_of(vec3 e)\n"                                                                         \
+    /* L'M'S' of a pixel, as hi and rest */                                                       \
+    "void pq_of(float y, vec2 c, out vec3 hi, out vec3 rest)\n"                                   \
     "{\n"                                                                                         \
-    "    return uint(clamp(floor((to_ipt * e).x * 4096.0 + 0.5), 0.0, 4095.0));\n"                \
