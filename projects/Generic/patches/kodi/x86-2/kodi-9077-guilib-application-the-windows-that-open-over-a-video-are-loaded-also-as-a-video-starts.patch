From 00aa82a3353405d0d3f6098abfe16b5e3647bddd Mon Sep 17 00:00:00 2001
From: Hades <15710513+hadesdevls@users.noreply.github.com>
Date: Wed, 18 Nov 2026 07:15:03 +0000
Subject: [PATCH] guilib, application: the windows that open over a video are
 loaded also as a video starts

The windows most often opened over a video (the OSD, the player information...) are loaded ahead
while the menus are idle (CWindowPreload::Idle(): nothing plays, no modal dialog is open, 2 s
without input). A video that starts before that (Kodi just started and a remote app or an add-on
plays at once, or a modal dialog stayed open, as the welcome wizard of the first start does) left
them to be read at their first open over it, on the thread that also presents its frames. Measured
in the test machine (the wizard left open, the player information opened over a video): 56.0 ms of
that thread at its first open, 52.3 ms of them reading its skin file, against 15.1 ms where it had
been loaded ahead. Another build reads that file at each first open and its users see about a
second of dropped frames there on slower machines.

Now they are also loaded while a video starts and draws nothing yet: the player plays a video and
its renderer is not configured (CWindowPreload::VideoStarting(); CApplicationPlayer::
IsRenderingVideo()), with the windows there and the screen awake, one a pass of the loop, as before.
No frame of the video is presented then, so a modal dialog (the busy dialog of the start) and input
do not hold it. Music does not count, and nothing is loaded once the first picture is drawn. The
line of kodi.log says how many were loaded so ("...; 2 of them as a video started, before its first
picture").

Host test (test_windowpreload): the rule in each of its conditions and the line, with four mutants
caught.
---
 xbmc/application/Application.cpp | 16 ++++++++++------
 xbmc/guilib/GUIWindowManager.cpp |  7 ++++---
 xbmc/guilib/GUIWindowManager.h   |  6 ++++--
 xbmc/guilib/WindowPreload.h      | 30 ++++++++++++++++++++++++++++--
 4 files changed, 46 insertions(+), 13 deletions(-)

diff --git a/xbmc/application/Application.cpp b/xbmc/application/Application.cpp
index 23e88c9..feaaa46 100644
--- a/xbmc/application/Application.cpp
+++ b/xbmc/application/Application.cpp
@@ -2771,17 +2771,21 @@ void CApplication::Process()
   GetComponent<CApplicationSkinHandling>()->ProcessPendingSkinReload();
 
   // Hades: one of the windows that open over a video is loaded ahead a pass while the menus are
-  // idle, so that it is not loaded on the thread that presents the video (CWindowPreload)
+  // idle, or while a video starts and draws nothing yet, so that it is not loaded on the thread
+  // that presents the video (CWindowPreload)
   CGUIWindowManager& windowManager = CServiceBroker::GetGUI()->GetWindowManager();
   if (windowManager.PreloadForVideoPending())
   {
     const auto appPlayer = GetComponent<CApplicationPlayer>();
     const auto appPower = GetComponent<CApplicationPowerHandling>();
-    windowManager.PreloadForVideo(CWindowPreload::Idle(
-        windowManager.Initialized(), appPlayer && appPlayer->IsPlaying(),
-        windowManager.HasModalDialog(true),
-        appPower && (appPower->IsDPMSActive() || appPower->IsInScreenSaver()),
-        appPower ? appPower->GlobalIdleTime() : 0));
+    const bool screenOff = appPower && (appPower->IsDPMSActive() || appPower->IsInScreenSaver());
+    windowManager.PreloadForVideo(
+        CWindowPreload::Idle(windowManager.Initialized(), appPlayer && appPlayer->IsPlaying(),
+                             windowManager.HasModalDialog(true), screenOff,
+                             appPower ? appPower->GlobalIdleTime() : 0),
+        CWindowPreload::VideoStarting(windowManager.Initialized(),
+                                      appPlayer && appPlayer->IsPlayingVideo(),
+                                      appPlayer && appPlayer->IsRenderingVideo(), screenOff));
   }
 
   // do any processing that isn't needed on each run
diff --git a/xbmc/guilib/GUIWindowManager.cpp b/xbmc/guilib/GUIWindowManager.cpp
index f2d3d9e..b49de77 100644
--- a/xbmc/guilib/GUIWindowManager.cpp
+++ b/xbmc/guilib/GUIWindowManager.cpp
@@ -1926,10 +1926,11 @@ bool CGUIWindowManager::IsWindowVisible(const std::string &xmlFile) const
   return IsWindowActive(xmlFile, false);
 }
 
-void CGUIWindowManager::PreloadForVideo(bool idle)
+void CGUIWindowManager::PreloadForVideo(bool idle, bool videoStarting)
 {
-  if (!idle || !m_preload.Pending())
+  if (!(idle || videoStarting) || !m_preload.Pending())
     return;
+  const bool atVideoStart = !idle;
   const int id = m_preload.Next();
   CGUIWindow* window = GetWindow(id);
   const std::string file = window ? window->GetProperty("xmlfile").asString() : std::string();
@@ -1948,7 +1949,7 @@ void CGUIWindowManager::PreloadForVideo(bool idle)
     const bool loaded = window->Initialize();
     const std::chrono::duration<double, std::milli> took = std::chrono::steady_clock::now() - start;
     m_preload.Took(file, loaded ? CWindowPreload::Result::LOADED : CWindowPreload::Result::FAILED,
-                   took.count());
+                   took.count(), atVideoStart);
   }
   const std::string summary = m_preload.Summary();
   if (!summary.empty())
diff --git a/xbmc/guilib/GUIWindowManager.h b/xbmc/guilib/GUIWindowManager.h
index c5e6b96..f44a31a 100644
--- a/xbmc/guilib/GUIWindowManager.h
+++ b/xbmc/guilib/GUIWindowManager.h
@@ -144,10 +144,12 @@ public:
   bool Initialized() const { return m_initialized; }
 
   /*! \brief Hades: load one of the windows that open over a video ahead, while the menus are idle
-   (CWindowPreload; application thread, once a pass of the loop)
+   or a video starts and draws nothing yet (CWindowPreload; application thread, once a pass of the
+   loop)
    \param idle CWindowPreload::Idle() of the application now
+   \param videoStarting CWindowPreload::VideoStarting() of the application now
    */
-  void PreloadForVideo(bool idle);
+  void PreloadForVideo(bool idle, bool videoStarting = false);
   //! Hades: some of those windows are still to be loaded ahead
   bool PreloadForVideoPending() const { return m_preload.Pending(); }
 
diff --git a/xbmc/guilib/WindowPreload.h b/xbmc/guilib/WindowPreload.h
index f5601ee..bec5cd2 100644
--- a/xbmc/guilib/WindowPreload.h
+++ b/xbmc/guilib/WindowPreload.h
@@ -29,6 +29,15 @@
  * its includes changed, as Kodi checks: CGUIWindow::NeedLoad()), and the textures that the load
  * allocated are those of the first open; closing it frees them, as before.
  *
+ * A video that starts before the menus were idle (Kodi just started and a remote app or an add-on
+ * plays at once, or a modal dialog stayed open, such as the welcome wizard of the first start)
+ * would read these windows at their first open over it. So they are also loaded while a video
+ * starts and draws nothing yet (its renderer is not configured: VideoStarting()), when the thread
+ * presents no frame of it; a modal dialog (the busy dialog of the start) and input do not hold
+ * that, since no frame waits for it. Measured in the test machine with the dialog not loaded ahead:
+ * its first open over the video took 56.0 ms of that thread, of which 52.3 ms reading its skin
+ * file; loaded ahead, 15.1 ms.
+ *
  * This class only keeps the list and says what was done; a test builds it on the host.
  */
 class CWindowPreload
@@ -45,6 +54,16 @@ public:
     return initialized && !playing && !modal && !screenOff && idleSeconds >= IDLE_SECONDS;
   }
 
+  //! a video starts and draws nothing yet (its renderer is not configured), the windows are there
+  //! and the screen is awake: the thread that will present its frames presents none yet
+  static constexpr bool VideoStarting(bool initialized,
+                                      bool playingVideo,
+                                      bool renderingVideo,
+                                      bool screenOff)
+  {
+    return initialized && playingVideo && !renderingVideo && !screenOff;
+  }
+
   enum class Result
   {
     LOADED, //!< loaded now
@@ -68,9 +87,10 @@ public:
   //! the next one (Pending() first)
   int Next() { return m_ids[m_next++]; }
 
-  void Took(const std::string& file, Result result, double ms)
+  //! atVideoStart: loaded while a video started (VideoStarting()), not while the menus were idle
+  void Took(const std::string& file, Result result, double ms, bool atVideoStart = false)
   {
-    m_done.push_back({file, result, ms});
+    m_done.push_back({file, result, ms, atVideoStart});
   }
 
   //! the line of the log, once, after the last one; empty before and after
@@ -84,10 +104,12 @@ public:
     double total = 0.0;
     double longest = 0.0;
     unsigned int count = 0;
+    unsigned int atVideoStart = 0;
     for (const auto& done : m_done)
     {
       if (done.result == Result::LOADED)
       {
+        atVideoStart += done.atVideoStart ? 1 : 0;
         char item[96];
         std::snprintf(item, sizeof(item), "%s%s %.1f ms", loaded.empty() ? "" : ", ",
                       done.file.c_str(), done.ms);
@@ -111,6 +133,9 @@ public:
       char tail[96];
       std::snprintf(tail, sizeof(tail), "; %.1f ms in all, the longest %.1f ms", total, longest);
       text += ": " + loaded + tail;
+      if (atVideoStart)
+        text += "; " + std::to_string(atVideoStart) +
+                " of them as a video started, before its first picture";
     }
     static const char* const names[4] = {"loaded already", "not in the skin",
                                          "not kept in memory", "failed"};
@@ -128,6 +153,7 @@ private:
     std::string file;
     Result result;
     double ms;
+    bool atVideoStart;
   };
   std::vector<int> m_ids;
   size_t m_next = 0;
-- 
2.53.0

