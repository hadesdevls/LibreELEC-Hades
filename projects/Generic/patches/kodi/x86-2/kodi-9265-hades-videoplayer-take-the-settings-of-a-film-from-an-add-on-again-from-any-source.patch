+std::optional<KODI::FILMMEMORY::Restoration> CApplicationPlayerCallback::RestoreFilmSettings(
+    const KODI::FILMMEMORY::Identity& identity,
+    const KODI::FILMMEMORY::Release& release,
+    const CVideoSettings& current,
+    const std::vector<KODI::FILMMEMORY::Track>& audio,
+    const std::vector<KODI::FILMMEMORY::Track>& subtitles)
+{
+  using namespace KODI::FILMMEMORY;
+  std::vector<StoredRecord> stored;
+  {
+    CVideoDatabase db;
+    if (!db.Open())
+      return std::nullopt;
+    db.GetFilmSettings(identity, stored);
+    db.Close();
+  }
+  const CVideoSettings& defaults = CMediaSettings::GetInstance().GetDefaultVideoSettings();
+  std::vector<Record> records;
+  size_t leftOut = 0;
+  for (const auto& row : stored)
+  {
+    Record record;
+    if (SameVideo(row.identity, identity) && Parse(row.text, defaults, record))
+      records.push_back(std::move(record));
+    else
+      ++leftOut;
+  }
+  if (leftOut > 0)
+    CLog::Log(LOGINFO,
+              "Film settings: {} records of the same kind with one of the ids of the {} are not "
+              "of it (another id of the same type differs) or could not be read: left out",
+              leftOut, identity.Describe());
+  if (records.empty())
+  {
+    CLog::Log(LOGINFO, "Film settings: none kept yet for the {} (this source: {})",
+              identity.Describe(), release.Describe());
+    return std::nullopt;
+  }
+  auto restored = Restore(records, release, current, audio, subtitles);
+  if (!restored)
+    return std::nullopt;
+  CLog::Log(LOGINFO,
+            "Film settings: the {} (this source: {}) has the settings of {} playback(s) of it "
+            "kept; what is taken again:",
+            identity.Describe(), release.Describe(), records.size());
+  for (const auto& line : restored->log)
+    CLog::Log(LOGINFO, "Film settings:   {}", line);
+
+  // a short notification of what was restored (the strings of Hades are translated in Estuary)
+  if (restored->groups != 0)
+  {
+    std::vector<std::string> what;
+    const std::pair<unsigned int, uint32_t> names[] = {
+        {GROUP_AUDIO, 62654},   {GROUP_SUBTITLES, 62655},   {GROUP_VIEW, 62656},
+        {GROUP_PICTURE, 62657}, {GROUP_AUDIO_LEVEL, 62658}, {GROUP_DELAYS, 62659}};
+    for (const auto& [group, id] : names)
+    {
+      if (restored->groups & group)
+        what.push_back(CGUIUtils::GetHadesString(id, id - 62654 + 54654));
+    }
+    std::string text = StringUtils::Join(what, ", ");
+    if (!text.empty() && text[0] >= 'a' && text[0] <= 'z')
+      text[0] = static_cast<char>(text[0] - 'a' + 'A');
+    const uint32_t heading = identity.kind == Kind::EPISODE ? 62653 : 62652;
+    CGUIDialogKaiToast::QueueNotification(CGUIDialogKaiToast::Info,
+                                          CGUIUtils::GetHadesString(heading, heading - 8000), text,
+                                          4000, false);
+  }
+  return restored;
+}
+
+void CApplicationPlayerCallback::StoreFilmSettings(const KODI::FILMMEMORY::Identity& identity,
+                                                   const KODI::FILMMEMORY::Record& record,
+                                                   const CVideoSettings& vs,
+                                                   bool restored)
+{
+  using namespace KODI::FILMMEMORY;
+  const CVideoSettings& defaults = CMediaSettings::GetInstance().GetDefaultVideoSettings();
+  // (nothing chosen and nothing taken again: nothing to keep, as for a file)
+  if (!restored && !(vs != defaults) && !record.audio && !record.subtitleChosen)
+    return;
+  CVideoDatabase db;
+  if (!db.Open())
+    return;
+  std::vector<StoredRecord> stored;
+  db.GetFilmSettings(identity, stored);
+  // the record of this release, if it played before; the ids it was kept with that this playback
+  // does not have stay with it
+  int id = -1;
+  Identity ids = identity;
+  std::vector<int> others;
+  for (const auto& row : stored)
+  {
+    Record kept;
+    if (!SameVideo(row.identity, identity) || !Parse(row.text, defaults, kept))
+      continue;
+    if (id < 0 && SameRelease(kept.release, record.release))
+    {
+      id = row.id;
+      for (const auto& [mine, theirs] :
+           {std::pair{&ids.imdb, &row.identity.imdb}, std::pair{&ids.tmdb, &row.identity.tmdb},
+            std::pair{&ids.tvdb, &row.identity.tvdb}})
+      {
+        if (mine->empty())
+          *mine = *theirs;
+      }
+    }
+    else
+      others.push_back(row.id);
+  }
+  const int kept = db.SetFilmSettings(id, ids, record.release.durationMs, Serialize(record));
+  // the least recently played records of this film past RECORDS_PER_VIDEO, and of all of them
+  // past RECORDS_IN_ALL, are forgotten
+  int forgotten = 0;
+  for (size_t i = RECORDS_PER_VIDEO - 1; i < others.size(); ++i)
+  {
+    db.DeleteFilmSettings(others[i]);
+    ++forgotten;
+  }
+  forgotten += db.TrimFilmSettings(RECORDS_IN_ALL);
+  db.Close();
+  if (kept < 0)
+    return;
+  CLog::Log(LOGINFO,
+            "Film settings: kept for the {}, for this source ({}){}{}", identity.Describe(),
+            record.release.Describe(), id < 0 ? "" : ", in place of what was kept for it before",
+            forgotten > 0 ? StringUtils::Format("; {} older records forgotten", forgotten) : "");
+}
