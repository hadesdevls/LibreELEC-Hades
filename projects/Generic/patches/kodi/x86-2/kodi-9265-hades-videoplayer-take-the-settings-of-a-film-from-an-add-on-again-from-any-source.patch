--- a/addons/resource.language.en_gb/resources/strings.po
+++ b/addons/resource.language.en_gb/resources/strings.po
@@ -28620,3 +28620,63 @@ msgstr ""
 msgctxt "#62769"
 msgid "{0} did not answer in time."
 msgstr ""
+
+#: system/settings/settings.xml
+#. Hades: label of the setting "videoplayer.hadesfilmmemory" (Player > Videos); translated in Estuary (#54650)
+msgctxt "#62650"
+msgid "Remember the settings of films from add-ons"
+msgstr ""
+
+#: system/settings/settings.xml
+#. Hades: help of the setting #62650; translated in Estuary (#54651)
+msgctxt "#62651"
+msgid "Kodi keeps the settings of a video by its file. For a film or an episode that an add-on plays, what you chose is also kept under its IMDb, TMDb or TVDb id, with its season and number for an episode, and taken again when the same film plays from another source. The audio and subtitle tracks are found again by what they are (language and its variety, forced, for the hearing impaired, commentary, name, codec, channels), never by their number, and only where the new source has them. The zoom is taken again where its picture has the same shape, the picture settings where its video has the same format, the volume for the same cut, and the audio and subtitle delays only for the same release (the same length to the second and the same video). The Dolby Vision output chosen for it is taken again too. A short notification says what was restored, and the log says why. Files on this device and on the local network, and the library, keep their settings for their file, as in Kodi. On by default."
+msgstr ""
+
+#: xbmc/application/ApplicationPlayerCallback.cpp
+#. Hades: heading of the notification when the settings kept for a film from an add-on are taken again (videoplayer.hadesfilmmemory); translated in Estuary (#54652)
+msgctxt "#62652"
+msgid "Film settings restored"
+msgstr ""
+
+#: xbmc/application/ApplicationPlayerCallback.cpp
+#. Hades: the same for an episode; translated in Estuary (#54653)
+msgctxt "#62653"
+msgid "Episode settings restored"
+msgstr ""
+
+#: xbmc/application/ApplicationPlayerCallback.cpp
+#. Hades: in the list of what was restored (#62652), in lower case, joined by commas: the audio track; translated in Estuary (#54654)
+msgctxt "#62654"
+msgid "audio track"
+msgstr ""
+
+#: xbmc/application/ApplicationPlayerCallback.cpp
+#. Hades: in the list of what was restored (#62652): the subtitles (track, on or off); translated in Estuary (#54655)
+msgctxt "#62655"
+msgid "subtitles"
+msgstr ""
+
+#: xbmc/application/ApplicationPlayerCallback.cpp
+#. Hades: in the list of what was restored (#62652): the zoom and the view mode; translated in Estuary (#54656)
+msgctxt "#62656"
+msgid "zoom"
+msgstr ""
+
+#: xbmc/application/ApplicationPlayerCallback.cpp
+#. Hades: in the list of what was restored (#62652): the picture settings (upscaler, brightness...); translated in Estuary (#54657)
+msgctxt "#62657"
+msgid "picture settings"
+msgstr ""
+
+#: xbmc/application/ApplicationPlayerCallback.cpp
+#. Hades: in the list of what was restored (#62652): the volume amplification and the level of the centre; translated in Estuary (#54658)
+msgctxt "#62658"
+msgid "volume"
+msgstr ""
+
+#: xbmc/application/ApplicationPlayerCallback.cpp
+#. Hades: in the list of what was restored (#62652): the audio and subtitle delays; translated in Estuary (#54659)
+msgctxt "#62659"
+msgid "delays"
+msgstr ""
