+//! Hades: the tracks of a type as the settings kept for films see them (FilmMemory.h)
+std::vector<KODI::FILMMEMORY::Track> FilmTracks(CSelectionStreams& streams, StreamType type)
+{
+  std::vector<KODI::FILMMEMORY::Track> tracks;
+  for (const auto& stream : streams.Get(type))
+    tracks.push_back(KODI::FILMMEMORY::TrackOf(stream));
+  KODI::FILMMEMORY::AssignPlaces(tracks);
+  return tracks;
+}
+
+std::optional<KODI::FILMMEMORY::Track> FilmTrack(const std::vector<KODI::FILMMEMORY::Track>& tracks,
+                                                 int index)
+{
+  for (const auto& track : tracks)
+  {
+    if (index >= 0 && track.index == index)
+      return track;
+  }
+  return std::nullopt;
+}
