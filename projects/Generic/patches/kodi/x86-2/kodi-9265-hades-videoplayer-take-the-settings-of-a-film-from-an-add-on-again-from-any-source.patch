+namespace
+{
+//! A unique id of the item by its type, whatever the case of the type
+std::string UniqueId(const CVideoInfoTag& tag, std::string_view type)
+{
+  for (const auto& [kind, value] : tag.GetUniqueIDs())
+  {
+    if (StringUtils::EqualsNoCase(kind, type))
+      return value;
+  }
+  return {};
+}
+} // namespace
+
+std::optional<Identity> IdentityOfItem(const CFileItem& item, std::string& why)
+{
+  why.clear();
+  const auto component = CServiceBroker::GetSettingsComponent();
+  const auto settings = component ? component->GetSettings() : nullptr;
+  if (!settings || !settings->GetBool(CSettings::SETTING_VIDEOPLAYER_HADESFILMMEMORY))
+    return std::nullopt;
+  if (!item.HasVideoInfoTag())
+    return std::nullopt;
+  const CVideoInfoTag& tag = *item.GetVideoInfoTag();
+  const std::string path = item.GetPath();
+  const std::string played = item.GetDynPath();
+  const bool fromAddon = URIUtils::IsPlugin(path) ||
+                         URIUtils::IsPlugin(item.GetProperty("original_listitem_url").asString());
+  if (!fromAddon && !URIUtils::IsInternetStream(played) && !URIUtils::IsInternetStream(path))
+    return std::nullopt;
+  const auto identity = IdentityOf(tag.m_type, UniqueId(tag, "imdb"), UniqueId(tag, "tmdb"),
+                                   UniqueId(tag, "tvdb"), tag.m_iSeason, tag.m_iEpisode);
+  if (!identity)
+  {
+    if (tag.m_type == MediaTypeMovie || tag.m_type == MediaTypeEpisode)
+      why = "it has no IMDb, TMDb or TVDb id" +
+            std::string(tag.m_type == MediaTypeEpisode ? ", or no season and number" : "");
+    return std::nullopt;
+  }
+  // (only an id of the library: a file id is also given to a stream that played before, a link of
+  // an add-on that keeps its path, as a plugin:// path does, and that is no item of the library)
+  if (tag.m_iDbId > 0)
+  {
+    why = "it is an item of the library, whose settings are kept for its file";
+    return std::nullopt;
+  }
+  return identity;
+}
+
+std::string OutputMemoryKey(const Identity& identity)
+{
+  // (one id, the same at each playback where the add-on gives it: IMDb first)
+  std::string key = std::string("hades-film:") + identity.KindText() + ":";
+  if (!identity.imdb.empty())
+    key += "imdb:" + identity.imdb;
+  else if (!identity.tmdb.empty())
+    key += "tmdb:" + identity.tmdb;
+  else
+    key += "tvdb:" + identity.tvdb;
+  if (identity.kind == Kind::EPISODE)
+    key += ":" + std::to_string(identity.season) + ":" + std::to_string(identity.episode);
+  return key;
+}
+
+Track TrackOf(const SelectionStream& stream)
+{
+  Track track;
+  if (!stream.language.IsUndetermined())
+    track.language = StringUtils::ToLower(stream.language.AsIso6392B());
+  track.variety =
+      static_cast<int>(KODI::UTILS::CLanguageVariety::OfStream(stream.language, stream.name));
+  track.name = stream.name;
+  track.codec = stream.codec;
+  track.channels = stream.channels;
+  track.flags = static_cast<int>(stream.flags);
+  const int source = STREAM_SOURCE_MASK(stream.source);
+  track.external = source == STREAM_SOURCE_DEMUX_SUB || source == STREAM_SOURCE_TEXT;
+  track.index = stream.type_index;
+  return track;
+}
+
+Picture PictureOf(const SelectionStream& stream)
+{
+  Picture picture;
+  picture.width = stream.width;
+  picture.height = stream.height;
+  picture.aspect = stream.aspect_ratio;
+  picture.hdr = static_cast<int>(stream.hdrType);
+  picture.stereo = stream.stereo_mode == "mono" ? std::string() : stream.stereo_mode;
+  return picture;
+}
+
