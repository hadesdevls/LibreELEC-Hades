+void CVideoPlayer::RestoreFilmSettings()
+{
+  if (!m_film.identity || !m_pDemuxer || !m_pInputStream)
+    return;
+  if (m_pInputStream->IsStreamType(DVDSTREAM_TYPE_DVD) ||
+      m_pInputStream->IsStreamType(DVDSTREAM_TYPE_BLURAY))
+  {
+    CLog::Log(LOGINFO, "VideoPlayer: a disc keeps its settings for its path, as in Kodi");
+    m_film.identity.reset();
+    return;
+  }
+  // the release that plays: its length and its video
+  m_film.release = {};
+  m_film.release.durationMs = m_pDemuxer->GetStreamLength();
+  const auto videos = m_SelectionStreams.Get(StreamType::VIDEO);
+  m_film.release.videoStreams = static_cast<int>(videos.size());
+  if (!videos.empty())
+    m_film.release.picture = KODI::FILMMEMORY::PictureOf(videos.front());
+  // the settings kept for its path come first (the queue of the callbacks has them: it holds
+  // nothing that waits for this thread); what is kept for the film goes over them
+  if (m_film.settingsLoaded && !m_film.settingsLoaded->Wait(5000ms))
+  {
+    CLog::Log(LOGWARNING,
+              "VideoPlayer: the settings kept for the path of this video were not read within "
+              "5 s: those kept for the {} are not taken, nor kept again at its end",
+              m_film.identity->Describe());
+    m_film.identity.reset();
+    return;
+  }
+  m_film.looked = true;
+  const auto audio = FilmTracks(m_SelectionStreams, StreamType::AUDIO);
+  const auto subtitles = FilmTracks(m_SelectionStreams, StreamType::SUBTITLE);
+  const CVideoSettings current = m_processInfo->GetVideoSettings();
+  const auto restored = m_callback.RestoreFilmSettings(*m_film.identity, m_film.release, current,
+                                                       audio, subtitles);
+  if (!restored)
+    return;
+  m_film.restored = true;
+  m_film.subtitleChosen = restored->subtitleChosen;
+  CVideoSettings settings = restored->settings;
+  SetVideoSettings(settings);
+}
+
+void CVideoPlayer::StoreFilmSettings(const CVideoSettings& vs)
+{
+  if (!m_film.identity || !m_film.looked)
+    return;
+  // (once for a file)
+  m_film.looked = false;
+  KODI::FILMMEMORY::Record record;
+  record.release = m_film.release;
+  record.settings = vs;
+  const bool visible = m_VideoPlayerVideo->IsSubtitleEnabled();
+  record.settings.m_SubtitleOn = visible;
+  // the audio track the user chose; the subtitle track chosen, or else the one open
+  record.audio =
+      FilmTrack(FilmTracks(m_SelectionStreams, StreamType::AUDIO), vs.m_AudioStream);
+  int subtitle = vs.m_SubtitleStream;
+  if (subtitle < 0 && m_CurrentSubtitle.id >= 0)
+    subtitle = m_SelectionStreams.TypeIndexOf(StreamType::SUBTITLE, m_CurrentSubtitle.source,
+                                              m_CurrentSubtitle.demuxerId, m_CurrentSubtitle.id);
+  record.subtitle = FilmTrack(FilmTracks(m_SelectionStreams, StreamType::SUBTITLE), subtitle);
+  // the user chose the subtitles: a track, or turned them off (Kodi's default has them on, and
+  // which track shows is left to the settings), or on or off from what the video started with, or
+  // a choice was taken again
+  record.subtitleChosen =
+      m_film.subtitleChosen || vs.m_SubtitleStream >= 0 ||
+      vs.m_SubtitleOn != CMediaSettings::GetInstance().GetDefaultVideoSettings().m_SubtitleOn ||
+      visible != m_film.subtitleVisibleAtStart;
+  IPlayerCallback* cb = &m_callback;
+  const KODI::FILMMEMORY::Identity identity = *m_film.identity;
+  const bool restored = m_film.restored;
+  m_outboundEvents->Submit([=]() { cb->StoreFilmSettings(identity, record, vs, restored); });
+}
