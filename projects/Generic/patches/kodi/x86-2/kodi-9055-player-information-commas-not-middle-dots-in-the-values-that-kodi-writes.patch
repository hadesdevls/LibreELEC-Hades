From f36127bb5cf66fcd1fc58b8e3cff687c49595fbc Mon Sep 17 00:00:00 2001
From: Hades <15710513+hadesdevls@users.noreply.github.com>
Date: Wed, 18 Nov 2026 04:04:42 +0000
Subject: [PATCH] player information: commas, not middle dots, in the values
 that Kodi writes
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

The values that the panel shows were joined with middle dots: "BT.2020 · PQ ·
limited range", "Dolby Vision · FEL", the ids of L8 ("1 · 16 · 18"), L10
("1: 4000 · 5: 1000"), the targets of L2, the passes of the graphics card, and
VideoPlayer.HdrDetail ("7.6 FEL · CM4 · HDMI DV"). A dot between words is not how
a list is written in English or in Spanish: they are joined with commas now
("BT.2020, PQ, limited range", "Dolby Vision, FEL", "1, 16, 18",
"1: 4000, 5: 1000", "100, 600, 1000").

VideoPlayer.HdrDetail is also in the heading of the video settings dialog,
where it reads the same. The separators that Estuary writes itself follow in
the skin.

Changed: VideoBadge() and ColourText() (HadesPlayerInfo.h), the L8 ids, L10
and the L2 targets (WinSystemGbmGLESContext.cpp), DVPassTimes::Compact() and
CDVPlaybackInfo::Detail().
---
 .../cores/VideoPlayer/DVDCodecs/Video/DVPlaybackInfo.h |  6 +++---
 xbmc/utils/HadesPlayerInfo.h                           | 10 +++++-----
 xbmc/windowing/gbm/DVPassTimes.h                       |  3 +--
 xbmc/windowing/gbm/WinSystemGbmGLESContext.cpp         |  8 ++++----
 4 files changed, 13 insertions(+), 14 deletions(-)

diff --git a/xbmc/cores/VideoPlayer/DVDCodecs/Video/DVPlaybackInfo.h b/xbmc/cores/VideoPlayer/DVDCodecs/Video/DVPlaybackInfo.h
index f023190..d6e9a18 100644
--- a/xbmc/cores/VideoPlayer/DVDCodecs/Video/DVPlaybackInfo.h
+++ b/xbmc/cores/VideoPlayer/DVDCodecs/Video/DVPlaybackInfo.h
@@ -18,13 +18,13 @@ struct CDVPlaybackInfo
     {
       if ((output & FEL) && source.find("FEL") == std::string::npos)
         source += " FEL";
-      return source + ((output & SDR) ? " · SDR" : " · HDR10");
+      return source + ((output & SDR) ? ", SDR" : ", HDR10");
     }
     if (!(output & HDMI))
       return source;
     if ((output & FEL) && source.find("FEL") == std::string::npos)
       source += " FEL";
-    source += (output & CM4) ? " · CM4" : " · CM2.9";
-    return source + " · HDMI DV";
+    source += (output & CM4) ? ", CM4" : ", CM2.9";
+    return source + ", HDMI DV";
   }
 };
diff --git a/xbmc/utils/HadesPlayerInfo.h b/xbmc/utils/HadesPlayerInfo.h
index 17de460..fdf22d3 100644
--- a/xbmc/utils/HadesPlayerInfo.h
+++ b/xbmc/utils/HadesPlayerInfo.h
@@ -371,7 +371,7 @@ inline std::string SourceHdrType(const std::string& stream,
 
 // ---- the badges
 
-//! "Dolby Vision · FEL", "Dolby Vision · P8.1", "HDR10+", "HDR10", "HLG", "SDR"
+//! "Dolby Vision, FEL", "Dolby Vision, P8.1", "HDR10+", "HDR10", "HLG", "SDR"
 inline std::string VideoBadge(const std::string& hdrType,
                               bool hdr10plus,
                               int dvProfile,
@@ -396,7 +396,7 @@ inline std::string VideoBadge(const std::string& hdrType,
       if (dvProfile == 8 && dvCompat > 0)
         detail += "." + std::to_string(dvCompat);
     }
-    return detail.empty() ? "Dolby Vision" : "Dolby Vision \xc2\xb7 " + detail; // ·
+    return detail.empty() ? "Dolby Vision" : "Dolby Vision, " + detail;
   }
   if (hdrType == "hdr10plus" || (hdrType == "hdr10" && hdr10plus))
     return "HDR10+";
@@ -675,7 +675,7 @@ struct ColourWords
 };
 
 /*!
- * \brief "BT.2020 · PQ · limited range": what the decoder gives the renderer
+ * \brief "BT.2020, PQ, limited range": what the decoder gives the renderer
  * \param primariesAssumed the stream did not say its primaries and Kodi chose them by the size of
  *        the picture (DVDVideoCodecFFmpeg.cpp): then "(assumed)" follows them. A part that the
  *        stream does not give and Kodi does not choose is "not given".
@@ -692,8 +692,8 @@ inline std::string ColourText(int primaries,
   const std::string t = transfer == 8 ? words.linear : TransferText(transfer);
   std::string out =
       p.empty() ? words.notGiven : p + (primariesAssumed ? " (" + words.assumed + ")" : "");
-  out += " \xc2\xb7 " + (t.empty() ? words.notGiven : t);
-  out += " \xc2\xb7 " + (fullRange ? words.fullRange : words.limitedRange);
+  out += ", " + (t.empty() ? words.notGiven : t);
+  out += ", " + (fullRange ? words.fullRange : words.limitedRange);
   return out;
 }
 
diff --git a/xbmc/windowing/gbm/DVPassTimes.h b/xbmc/windowing/gbm/DVPassTimes.h
index 0745bbb..a145208 100644
--- a/xbmc/windowing/gbm/DVPassTimes.h
+++ b/xbmc/windowing/gbm/DVPassTimes.h
@@ -108,8 +108,7 @@ struct CDVPassTimes
     for (const auto& p : passes)
     {
       std::snprintf(number, sizeof(number), " %.1f", Average(p));
-      const std::string part = (text.empty() ? "" : " \xc2\xb7 ") + Short(p.name) + number; // ·
-      // (the middle dot is one character of two bytes)
+      const std::string part = (text.empty() ? "" : ", ") + Short(p.name) + number;
       const size_t shown = Chars(text) + Chars(part) + 3;
       if (!text.empty() && shown > most)
         break;
diff --git a/xbmc/windowing/gbm/WinSystemGbmGLESContext.cpp b/xbmc/windowing/gbm/WinSystemGbmGLESContext.cpp
index a60a6db..df9c339 100644
--- a/xbmc/windowing/gbm/WinSystemGbmGLESContext.cpp
+++ b/xbmc/windowing/gbm/WinSystemGbmGLESContext.cpp
@@ -8575,7 +8575,7 @@ void PublishLevelValues(std::map<std::string, std::string>& info,
                         bool trims)
 {
   using namespace KODI::UTILS::PLAYERINFO;
-  const std::string dot = " \xc2\xb7 "; // ·
+  const std::string sep = ", ";
   if (lv.l3)
     info["hades.dv.l3"] = StringUtils::Format("{:+d} / {:+d} / {:+d}", lv.l3Offsets[0],
                                               lv.l3Offsets[1], lv.l3Offsets[2]);
@@ -8583,13 +8583,13 @@ void PublishLevelValues(std::map<std::string, std::string>& info,
     info["hades.dv.l4"] = StringUtils::Format("{:.0f} / {}", PQToNits(lv.l4Anchor), lv.l4Power);
   std::string text;
   for (unsigned int i = 0; i < lv.l8Count; ++i)
-    text += (i ? dot : std::string()) + std::to_string(lv.l8Ids[i]);
+    text += (i ? sep : std::string()) + std::to_string(lv.l8Ids[i]);
   info["hades.dv.l8"] = text;
   if (lv.l9)
     info["hades.dv.l9"] = lv.l9Primaries;
   text.clear();
   for (unsigned int i = 0; i < lv.l10Count; ++i)
-    text += (i ? dot : std::string()) +
+    text += (i ? sep : std::string()) +
             StringUtils::Format("{}: {:.0f}", lv.l10Ids[i], PQToNits(lv.l10MaxPq[i]));
   info["hades.dv.l10"] = text;
   if (lv.l11)
@@ -8920,7 +8920,7 @@ void CWinSystemGbmGLESContext::PublishDVInfo(bool force)
     std::string targets;
     const int trims = std::min(d.l2Trims, static_cast<int>(CDVBridgeGLES::PresentedDetail::MAX_BLOCKS));
     for (int i = 0; i < trims; ++i)
-      targets += StringUtils::Format("{}{:.0f}", i ? " \xc2\xb7 " : "", PQToNits(d.l2Targets[i])); // ·
+      targets += StringUtils::Format("{}{:.0f}", i ? ", " : "", PQToNits(d.l2Targets[i]));
     info["hades.dv.l2targets"] = targets;
     const auto rpu = CountLevels(d.levels, d.levelCount);
     info["hades.dv.blocks"] = DescribeLevels(rpu);
-- 
2.53.0

