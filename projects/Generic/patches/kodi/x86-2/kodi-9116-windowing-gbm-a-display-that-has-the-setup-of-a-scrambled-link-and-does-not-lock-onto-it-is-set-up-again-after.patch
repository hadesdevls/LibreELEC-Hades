From ef435efe898196ea67944aae5ab30001f32f3f1f Mon Sep 17 00:00:00 2001
From: Hades <15710513+hadesdevls@users.noreply.github.com>
Date: Wed, 18 Nov 2026 15:42:43 +0000
Subject: [PATCH] windowing/gbm: a display that has the setup of a scrambled
 link and does not lock onto it is set up again after a hot-plug

Issue #24: the "No Signal" after the TV was turned off and on, which 1.0 RC6
had fixed for that RTX 3050 and LG B7 (issue #11), came back with 1.0. The
code that decides (HotplugRelink.h, LookForRelink(), RelinkDecide()) is as it
was in RC6, apart from native output being told by the output handover; what
changed on the way is the NVIDIA driver, 620.70.06 in 1.0 where RC6 to RC8 had
615.78.08. A display whose SCDC TMDS_Config has the setup after the pulse made
the verdict SINK_KEPT, and nothing was done, whether or not the display read
the link. A driver that writes TMDS_Config again by itself without the display
locking onto the link leaves it so: whether 620 does is not known (its SCDC
writes are in the closed part of the driver), and the log that came with the
issue has no event of the TV.

The read of the display's SCDC already takes Status_Flags_0 (for the log, and
for HDR of more than 8 bits: HDR_MORE_BITS::LockOf()). Now it decides too: on a
link that the driver does not say is unscrambled, a display that has the setup
and has no clock, or a channel not locked, is NOT_LOCKED (SinkOf()), which
Decide() takes as one that lost the setup: the output is turned off and on
once, with the guards as before (10 s for the display's answer, 30 s between
two, not during native Dolby Vision). A display that shows the picture has the
clock and the three channels locked, and one whose flags could not be read is
as before; an FRL link is judged by FRL_Rate alone, as before. kodi.log says
it in the line of the read: "the display has the setup of the link, but not
its clock or a channel locked: it does not read it".

Host test: tools/regress/kodi-host/output/presfix/relink_test.cpp of the
LibreELEC tree (29 checks); its four mutants fail with 5, 1, 1 and 1 checks.
---
 xbmc/windowing/gbm/HotplugRelink.h            | 45 ++++++++++++++++---
 .../windowing/gbm/WinSystemGbmGLESContext.cpp |  7 ++-
 2 files changed, 43 insertions(+), 9 deletions(-)

diff --git a/xbmc/windowing/gbm/HotplugRelink.h b/xbmc/windowing/gbm/HotplugRelink.h
index 1998975..2edc1bb 100644
--- a/xbmc/windowing/gbm/HotplugRelink.h
+++ b/xbmc/windowing/gbm/HotplugRelink.h
@@ -49,7 +49,9 @@
  * - where the link is neither scrambled nor trained (TMDS at 340 MHz or less, a mode in YCbCr
  *   4:2:0 counted at its own rate: the sink needs nothing written), or is DisplayPort;
  * - where the display kept the setup (TMDS_Config with scrambling and the 1/40 ratio on; over FRL,
- *   an FRL_Rate other than 0);
+ *   an FRL_Rate other than 0) and, over TMDS, locks onto the link: a display whose TMDS_Config has
+ *   the setup while its Status_Flags_0 says no clock, or a channel not locked, does not read the
+ *   link, and is set up again (SinkOf(); issue #24 below);
  * - where the event is explained by another output of the device, which changed (connected,
  *   disconnected, or another EDID) while the one in use did not, unless the display in use is
  *   known to have lost the setup;
@@ -58,7 +60,18 @@
  * - while native Dolby Vision is on (leaving it turns the output off and on, or sets the mode of
  *   the menus, either of which sets the link up again);
  * - with video/hotplugrelink off in advancedsettings.xml.
- * Pure: a test builds it on the host.
+ * Pure: a test builds it on the host (tools/regress/kodi-host/output/presfix/relink_test.cpp).
+ *
+ * Issue #24 (2026-11-13, the RTX 3050 and LG B7 of issue #11): the "No Signal" after the TV was turned
+ * off and on came back with 1.0. What decides here is as it was in 1.0 RC6, which fixed it for that
+ * TV; the NVIDIA driver is what changed on the way (620.70.06 in 1.0, 615.78.08 in RC6 to RC8). A
+ * driver that writes TMDS_Config again by itself after the pulse, without the display locking onto
+ * the link, made the verdict SINK_KEPT and nothing was done: whether 620 does is not known (its SCDC
+ * writes are in the closed part). So the display's Status_Flags_0, which Kodi reads already (for the
+ * log, and for HDR of more than 8 bits: HDR_MORE_BITS::LockOf()), decides too: a display that has
+ * the setup and has no clock, or a channel not locked, on a scrambled link (HDMI 2.0 has the sink
+ * fill them in there) is NOT_LOCKED, and the output is set up again as for one that lost it. A
+ * display that shows the picture has the clock and the three channels locked: nothing changes there.
  */
 namespace HOTPLUG_RELINK
 {
@@ -181,19 +194,31 @@ inline int64_t TmdsKHz(int64_t clockKHz, int bpc, std::optional<Format> format =
 enum class Sink
 {
   UNKNOWN, //!< it could not be read
-  KEPT, //!< the display has the setup that the source wrote
+  KEPT, //!< the display has the setup that the source wrote (and, over TMDS, locks onto the link)
   LOST, //!< it has not (a sink that was switched off and on has 0)
+  NOT_LOCKED, //!< it has the setup of a scrambled TMDS link, but no clock, or a channel not locked
 };
 
+//! Whether the display does not read the link as the source sends it (LOST or NOT_LOCKED)
+inline bool SinkLost(Sink sink)
+{
+  return sink == Sink::LOST || sink == Sink::NOT_LOCKED;
+}
+
 /*!
  * \brief What the SCDC says: over FRL, FRL_Rate (Config_1, bits 3:0), which is 0 for TMDS and is
  *        the rate that the link was trained at otherwise; over TMDS, TMDS_Config with
  *        Scrambling_Enable and TMDS_Bit_Clock_Ratio both on (as i915 compares it:
  *        intel_hdmi_reset_link()). TMDS_Config says nothing of an FRL link. Where the link is not
  *        said, an FRL_Rate other than 0 is an FRL link that the display kept, and TMDS_Config is
- *        read as for TMDS.
+ *        read as for TMDS. Over TMDS, a display with the setup is NOT_LOCKED where its
+ *        Status_Flags_0 (statusFlags, where it was read) has Clock_Detected or a Chn_Locked off: it
+ *        is asked only of a scrambled link, where HDMI 2.0 has the sink fill them in.
  */
-inline Sink SinkOf(Link link, std::optional<uint8_t> tmdsConfig, std::optional<uint8_t> frlRate)
+inline Sink SinkOf(Link link,
+                   std::optional<uint8_t> tmdsConfig,
+                   std::optional<uint8_t> frlRate,
+                   std::optional<uint8_t> statusFlags = std::nullopt)
 {
   if (link == Link::FRL)
   {
@@ -205,7 +230,13 @@ inline Sink SinkOf(Link link, std::optional<uint8_t> tmdsConfig, std::optional<u
     return Sink::KEPT;
   if (!tmdsConfig)
     return Sink::UNKNOWN;
-  return (*tmdsConfig & 0x03) == 0x03 ? Sink::KEPT : Sink::LOST;
+  if ((*tmdsConfig & 0x03) != 0x03)
+    return Sink::LOST;
+  // (Status_Flags_0: bit 0 Clock_Detected, bits 1 to 3 Ch0 to Ch2_Locked; not asked of a link
+  // that the driver says is not scrambled, where a display need not fill them in)
+  if (link != Link::TMDS && statusFlags && (*statusFlags & 0x0f) != 0x0f)
+    return Sink::NOT_LOCKED;
+  return Sink::KEPT;
 }
 
 /*!
@@ -312,7 +343,7 @@ inline Verdict Decide(const Facts& f)
     return Verdict::SINK_KEPT;
   if (f.sinceRelinkMs >= 0 && f.sinceRelinkMs < AFTER_OWN_MS)
     return Verdict::ECHO;
-  if (f.otherOutputChanged && f.sink != Sink::LOST)
+  if (f.otherOutputChanged && !SinkLost(f.sink))
     return Verdict::OTHER_OUTPUT;
   if (f.sinceRelinkMs >= 0 && f.sinceRelinkMs < SPACING_MS)
     return Verdict::TOO_SOON;
diff --git a/xbmc/windowing/gbm/WinSystemGbmGLESContext.cpp b/xbmc/windowing/gbm/WinSystemGbmGLESContext.cpp
index b514b89..523e033 100644
--- a/xbmc/windowing/gbm/WinSystemGbmGLESContext.cpp
+++ b/xbmc/windowing/gbm/WinSystemGbmGLESContext.cpp
@@ -1722,7 +1722,8 @@ HOTPLUG_RELINK::ScdcRead ReadScdcOf(std::string device,
   const bool more = i2c.Byte(SCDC_ADDRESS, SCDC_SCRAMBLER_STATUS, status) &&
                     i2c.Byte(SCDC_ADDRESS, SCDC_STATUS_FLAGS_0, flags);
   read.sink = SinkOf(link, configRead ? std::optional<uint8_t>(config) : std::nullopt,
-                     frlRead ? std::optional<uint8_t>(frl) : std::nullopt);
+                     frlRead ? std::optional<uint8_t>(frl) : std::nullopt,
+                     more ? std::optional<uint8_t>(flags) : std::nullopt);
   if (configRead)
     read.config = config;
   if (more)
@@ -1739,7 +1740,9 @@ HOTPLUG_RELINK::ScdcRead ReadScdcOf(std::string device,
       hex(more, flags),
       read.sink == Sink::KEPT   ? "has the setup of the link"
       : read.sink == Sink::LOST ? "lost the setup of the link"
-                                : "says nothing that can be read for this link");
+      : read.sink == Sink::NOT_LOCKED
+          ? "has the setup of the link, but not its clock or a channel locked: it does not read it"
+          : "says nothing that can be read for this link");
   if (read.sink == Sink::UNKNOWN)
     read.said += StringUtils::Format(" ({}, {})", std::strerror(i2c.Error()), unknown);
   return read;
-- 
2.53.0

