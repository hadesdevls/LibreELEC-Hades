diff --git a/xbmc/utils/PlaybackMode.h b/xbmc/utils/PlaybackMode.h
index a30bf0c..e3aa1e2 100644
--- a/xbmc/utils/PlaybackMode.h
+++ b/xbmc/utils/PlaybackMode.h
@@ -87,15 +87,28 @@ inline std::string ModeText(uint32_t width,
 //! \brief One line that says in which mode the video plays: "Dolby Vision, FEL, 3840x2160 @
 //!        23.976 Hz"; "Dolby Vision to HDR10" where a Dolby Vision video is sent as HDR10. Empty
 //!        while the output is not known. Plain characters, as the public texts of the project
-//!        write (commas and a word, no middle dots or arrows). The word between two formats is
-//!        English, as the names of the formats are: the notice has no string of its own for it.
-inline std::string DescribePlaybackMode(const PlaybackModeInfo& info)
+//!        write (commas and a word, no middle dots or arrows).
+//! \param between how two formats are joined, {0} the video's and {1} the one sent: the string of
+//!        Hades in the language of the interface ("de {0} a {1}" in Spanish); "{0} to {1}" where
+//!        it lacks either of the two
+inline std::string DescribePlaybackMode(const PlaybackModeInfo& info,
+                                        const std::string& between = "{0} to {1}")
 {
   const std::string out = PlaybackModeFormatName(info.output);
   if (out.empty())
     return {};
   const std::string src = PlaybackModeFormatName(info.source);
-  std::string text = !src.empty() && src != out ? src + " to " + out : out;
+  std::string text = out;
+  if (!src.empty() && src != out)
+  {
+    const bool usable = between.find("{0}") != std::string::npos &&
+                        between.find("{1}") != std::string::npos;
+    text = usable ? between : "{0} to {1}";
+    const size_t first = text.find("{0}");
+    text.replace(first, 3, src);
+    const size_t second = text.find("{1}", first + src.size());
+    text.replace(second == std::string::npos ? text.find("{1}") : second, 3, out);
+  }
   if (info.output == "dolbyvision" && (info.layers == "FEL" || info.layers == "MEL"))
     text += ", " + info.layers;
   if (!info.mode.empty())
@@ -122,11 +135,13 @@ public:
   //! \param nowMs a clock in ms that goes forward (may wrap)
   //! \param playing whether a video plays
   //! \param started a number that changes with each video that begins (0 before the first)
+  //! \param between how two formats are joined (DescribePlaybackMode())
   //! \return the text to show, or empty if there is nothing to show now
   std::string Update(uint32_t nowMs,
                      bool playing,
                      unsigned int started,
-                     const PlaybackModeInfo& info)
+                     const PlaybackModeInfo& info,
+                     const std::string& between = "{0} to {1}")
   {
     if (started != m_started)
     {
@@ -138,7 +153,7 @@ public:
     }
     if (!playing || !m_active)
       return {};
-    const std::string text = DescribePlaybackMode(info);
+    const std::string text = DescribePlaybackMode(info, between);
     if (text.empty())
     {
       m_known = false;
diff --git a/xbmc/utils/test/TestPlaybackMode.cpp b/xbmc/utils/test/TestPlaybackMode.cpp
index 4558556..844c20e 100644
--- a/xbmc/utils/test/TestPlaybackMode.cpp
+++ b/xbmc/utils/test/TestPlaybackMode.cpp
@@ -32,6 +32,24 @@ TEST(TestPlaybackMode, Describe)
   EXPECT_EQ("HLG", DescribePlaybackMode({"", "hlg", "", ""}));
 }
 
+// the word between two formats is a string of the interface (core #62262): its translation decides the order
+TEST(TestPlaybackMode, BetweenTwoFormats)
+{
+  const PlaybackModeInfo dvAsHdr10{"dolbyvision", "hdr10", "FEL", "3840x2160 @ 23.976 Hz"};
+  EXPECT_EQ("de Dolby Vision a HDR10, 3840x2160 @ 23.976 Hz", DescribePlaybackMode(dvAsHdr10, "de {0} a {1}"));
+  EXPECT_EQ("HDR10 (Dolby Vision)", DescribePlaybackMode({"dolbyvision", "hdr10", "", ""}, "{1} ({0})"));
+  // a translation without either placeholder: the English form, never a text without a format
+  EXPECT_EQ("Dolby Vision to HDR10", DescribePlaybackMode({"dolbyvision", "hdr10", "", ""}, "de a"));
+  EXPECT_EQ("Dolby Vision to HDR10", DescribePlaybackMode({"dolbyvision", "hdr10", "", ""}, "{0} y"));
+  // one format only: the template is not used
+  EXPECT_EQ("HDR10", DescribePlaybackMode({"hdr10", "hdr10", "", ""}, "de {0} a {1}"));
+  // the announcer passes it on
+  CPlaybackModeAnnouncer a;
+  EXPECT_EQ("", a.Update(0, true, 1, dvAsHdr10, "de {0} a {1}"));
+  EXPECT_EQ("de Dolby Vision a HDR10, 3840x2160 @ 23.976 Hz",
+            a.Update(CPlaybackModeAnnouncer::SETTLE_MS, true, 1, dvAsHdr10, "de {0} a {1}"));
+}
+
 // the notice is written in plain characters, as the public texts of the project: commas and a word
 // between the parts, never a middle dot, an arrow or any other character outside ASCII
 TEST(TestPlaybackMode, PlainCharacters)
diff --git a/xbmc/windowing/gbm/WinSystemGbmGLESContext.cpp b/xbmc/windowing/gbm/WinSystemGbmGLESContext.cpp
index 566f9e6..6cee383 100644
--- a/xbmc/windowing/gbm/WinSystemGbmGLESContext.cpp
+++ b/xbmc/windowing/gbm/WinSystemGbmGLESContext.cpp
@@ -9225,8 +9225,11 @@ void CWinSystemGbmGLESContext::AnnouncePlaybackMode(const std::map<std::string,
   if (const auto* selected = m_DRM ? m_DRM->GetSelectedMode() : nullptr;
       selected && selected->htotal && selected->vtotal)
     mode.mode = ModeTextOf(*selected);
-  const std::string text = m_modeAnnouncer.Update(
-      CTimeUtils::GetFrameTime(), playing, m_playbackStarts.load(std::memory_order_relaxed), mode);
+  // (how two formats are joined, in the language of the interface: "{0} to {1}")
+  const std::string text =
+      m_modeAnnouncer.Update(CTimeUtils::GetFrameTime(), playing,
+                             m_playbackStarts.load(std::memory_order_relaxed), mode,
+                             CGUIUtils::GetHadesString(62262, 54262));
   if (text.empty() || !on)
     return;
   CLog::Log(LOGINFO, "Playback mode: {}", text);
