diff --git a/xbmc/windowing/gbm/HdmiVrrOff.h b/xbmc/windowing/gbm/HdmiVrrOff.h
index b971949..d2edc5e 100644
--- a/xbmc/windowing/gbm/HdmiVrrOff.h
+++ b/xbmc/windowing/gbm/HdmiVrrOff.h
@@ -19,40 +19,64 @@ namespace GBM
 {
 
 /*!
- * \brief Hades: HDMI VRR left off in the mode set of an HDR10+ video on Turing and Ampere
- *        (NV_HDMI_VRR_OFF of nvidia-drm, nvidia-open-kernel-modules-9051)
+ * \brief Hades: HDMI VRR left off in a mode set (NV_HDMI_VRR_OFF of nvidia-drm,
+ *        nvidia-open-kernel-modules-9051 and 9074)
  *
- * On Turing and Ampere the SOR of a head has one slot for an InfoFrame of a client next to the
- * HDR one: the generic InfoFrame slot, where HDR10+ goes (nvidia-open-kernel-modules-9020). NVKMS
- * turns HDMI VRR on in every mode set of a display that declares it, from 50 Hz and 720 lines up,
- * and then sends the EMP of HDMI VRR in that slot with every frame, whether flips use VRR or not:
- * HDR10+ is refused there (Ada sends it in a shared generic slot then; Blackwell has slots of its
- * own). Kodi never flips with VRR. nvidia-drm gives these connectors NV_HDMI_VRR_OFF (only where
- * it frees the slot for HDR10+: Turing and Ampere, not GA10x where RM keeps the slot for its ACR
- * workaround): with 1, the mode set asks NVKMS for no Adaptive-Sync, so no EMP goes out and HDR10+
- * has the slot. A change of it needs a mode set.
+ * NVKMS turns HDMI VRR on in every mode set of a display that declares it, from 50 Hz and 720 lines
+ * up and from 110 % of the display's VRR minimum, and then sends the EMP of HDMI VRR with every
+ * frame, whether flips use VRR or not. Kodi never flips with VRR (it never sets VRR_ENABLED): the
+ * refresh of the mode stays fixed, and the EMP only tells the display that VRR is on. nvidia-drm
+ * gives NV_HDMI_VRR_OFF to every connector with a TMDS output of the GPU (an HDMI connector, the
+ * TMDS output of a dual-mode DisplayPort one: nvidia-open-kernel-modules-9074; 9051 gave it only
+ * where HDR10+ needs it, Turing and Ampere): with 1, the mode set asks NVKMS for no Adaptive-Sync, so
+ * no EMP goes out. A change of it needs a mode set.
  *
- * Kodi sets it only in the mode set that the video makes anyway: the commit that the hold of the
- * change of mode of the video releases (CHDR10PlusOutput::WithMode()), and only where it is what
- * stands between the video and HDR10+ (Wanted()): never a change of mode for it. Any other mode set
- * puts it back to 0 (Stage()), the GUI's after the video among them: until then it stays as it was,
- * which changes nothing that Kodi uses (the display does not get the EMP of VRR). A test of the
- * request that fails with it is made again without it and without the HDR10+ payload (Without()):
- * the video then goes out as it would without this, as HDR10, and the log says so.
+ * Kodi asks for it (Reason()):
+ *  - in every mode set it makes while "HDMI variable refresh rate (VRR)" (System > Display,
+ *    videoscreen.hadeshdmivrr) is off. On, the default, leaves it to the driver, as before;
+ *  - in the mode set of an HDR10+ video (Wanted()): on Turing and Ampere the SOR of a head has one
+ *    slot for an InfoFrame of a client next to the HDR one, the generic InfoFrame slot, where HDR10+
+ *    goes (nvidia-open-kernel-modules-9020), and the EMP of HDMI VRR takes it. Ada sends HDR10+ in a
+ *    shared generic slot and Blackwell has slots of its own: there it changes nothing for HDR10+, and
+ *    nothing that Kodi uses. Only the mode set that the video makes anyway: the commit that the hold
+ *    of the change of mode of the video releases (CHDR10PlusOutput::WithMode()). Never a change of
+ *    mode for it.
+ * Any other mode set puts it back to 0 (Stage()), the GUI's after the video among them: until then
+ * it stays as it was, which changes nothing that Kodi uses. A test of the request that fails with it
+ * is made again without it and without the HDR10+ payload (Without()): the video then goes out as it
+ * would without this, as HDR10, and the log says so.
  *
  * Native Dolby Vision leaves it off too, with the rest of the state of its transport
  * (COutputHandover: the property is captured, set to 1 with the transport and put back with its
  * end): the EMP of HDMI VRR would go out beside the Dolby InfoFrame in every mode of 50 Hz and up
- * on
- * a display that declares HDMI VRR, and Kodi never flips with VRR. While native Dolby Vision has
- * the
- * output, nothing here stages it (Stage(): nativeDV).
+ * on a display that declares HDMI VRR. While native Dolby Vision has the output, nothing here
+ * stages it (Stage(): nativeDV).
  */
 class CHdmiVrrOff
 {
 public:
   static constexpr const char* PROPERTY = "NV_HDMI_VRR_OFF";
 
+  //! Why the mode set of a commit asks for HDMI VRR off (Reason())
+  enum class Why
+  {
+    NONE, //!< it does not: the driver decides, as before
+    SETTING, //!< "HDMI variable refresh rate (VRR)" is off (videoscreen.hadeshdmivrr)
+    HDR10PLUS, //!< the video sends HDR10+ in the commit of its mode (Wanted())
+  };
+
+  /*!
+   * \brief Why the mode set of a commit asks for HDMI VRR off: the setting first (off, it holds for
+   *        every mode set that Kodi makes), then HDR10+ (Wanted() of that commit). With the setting
+   *        on, the default, the answer is the one Kodi gave before the setting: HDR10+ or nothing.
+   * \param settingAllowsVrr videoscreen.hadeshdmivrr (true where it cannot be read)
+   * \param hdr10PlusWanted Wanted() for this commit
+   */
+  static constexpr Why Reason(bool settingAllowsVrr, bool hdr10PlusWanted)
+  {
+    return !settingAllowsVrr ? Why::SETTING : hdr10PlusWanted ? Why::HDR10PLUS : Why::NONE;
+  }
+
   /*!
    * \brief Whether the mode set of a video asks for HDMI VRR off: the connector has the property;
    *        the request is the commit of the mode of the video (withMode); the video sends HDR10+
diff --git a/xbmc/windowing/gbm/WinSystemGbm.cpp b/xbmc/windowing/gbm/WinSystemGbm.cpp
index 715ec1b..d7d07c4 100644
--- a/xbmc/windowing/gbm/WinSystemGbm.cpp
+++ b/xbmc/windowing/gbm/WinSystemGbm.cpp
@@ -4165,9 +4165,19 @@ enum HDR10PlusTold : unsigned int
 };
 } // namespace
 
+bool CWinSystemGbm::HdmiVrrAllowedBySetting() const
+{
+  const auto component = CServiceBroker::GetSettingsComponent();
+  const auto settings = component ? component->GetSettings() : nullptr;
+  // (on, the default, where the setting cannot be read: the driver decides, as before)
+  return !settings || !settings->GetSetting(CSettings::SETTING_VIDEOSCREEN_HADESHDMIVRR) ||
+         settings->GetBool(CSettings::SETTING_VIDEOSCREEN_HADESHDMIVRR);
+}
+
 void CWinSystemGbm::StageHdmiVrrOff()
 {
   m_hdmiVrrOffStaged.reset();
+  m_hdmiVrrOffBySetting = false;
   auto drm = std::dynamic_pointer_cast<CDRMAtomic>(m_DRM);
   CDRMConnector* connector = drm ? drm->GetConnector() : nullptr;
   if (!connector || !connector->SupportsProperty(CHdmiVrrOff::PROPERTY))
@@ -4175,16 +4185,25 @@ void CWinSystemGbm::StageHdmiVrrOff()
     m_hdmiVrrOffWanted = false;
     return;
   }
+  // (a change of it needs a mode set: without one there is nothing to stage, nor a setting to read)
+  if (!drm->ModesetPending())
+    return;
+  // the setting holds for every mode set that Kodi makes; HDR10+ for the commit of its video's mode
