From d6e026701b547dd414f3647bc22f691248965ea3 Mon Sep 17 00:00:00 2001
From: Hades <15710513+hadesdevls@users.noreply.github.com>
Date: Fri, 20 Nov 2026 21:34:09 +0000
Subject: [PATCH] Hades: clang-format on the lines of the Low-Latency, capture
 and CEC changes

clang-format 21 with the tree's .clang-format on the lines that the
commits before changed; and the include of CaptureTypes.h taken out of
WinSystemGbmGLESContext.cpp, which has it through CaptureService.h (an
include there made clang-format sort the whole block of includes that
the file has unsorted).
---
 .../devices/PeripheralCecAdapter.cpp          |  6 ++---
 .../test/TestPeripheralCecKeys.cpp            | 12 +++++-----
 xbmc/rendering/capture/CaptureConvert.cpp     |  9 ++++---
 xbmc/utils/Screenshot.cpp                     | 24 +++++++++----------
 .../windowing/gbm/WinSystemGbmGLESContext.cpp |  1 -
 5 files changed, 24 insertions(+), 28 deletions(-)

diff --git a/xbmc/peripherals/devices/PeripheralCecAdapter.cpp b/xbmc/peripherals/devices/PeripheralCecAdapter.cpp
index 33c2219..699fa7c 100644
--- a/xbmc/peripherals/devices/PeripheralCecAdapter.cpp
+++ b/xbmc/peripherals/devices/PeripheralCecAdapter.cpp
@@ -9,7 +9,6 @@
 #include "PeripheralCecAdapter.h"
 
 #include "PeripheralCecKeys.h"
-
 #include "ServiceBroker.h"
 #include "application/ApplicationComponents.h"
 #include "application/ApplicationEnums.h"
@@ -2182,9 +2181,8 @@ std::optional<std::pair<int, std::string>> CPeripheralCecAdapter::GetSettingsNot
   std::unique_lock lock(m_noteLock);
   if (m_noteAdapter.empty())
     return std::nullopt;
-  return std::make_pair(
-      62340, StringUtils::Format(CGUIUtils::GetHadesString(62341, 54341), m_noteAdapter,
-                                 m_notePicture));
+  return std::make_pair(62340, StringUtils::Format(CGUIUtils::GetHadesString(62341, 54341),
+                                                   m_noteAdapter, m_notePicture));
 }
 
 void CPeripheralCecAdapter::ProcessPictureChange(void)
diff --git a/xbmc/peripherals/test/TestPeripheralCecKeys.cpp b/xbmc/peripherals/test/TestPeripheralCecKeys.cpp
index 7e0a9be..2075545 100644
--- a/xbmc/peripherals/test/TestPeripheralCecKeys.cpp
+++ b/xbmc/peripherals/test/TestPeripheralCecKeys.cpp
@@ -33,10 +33,10 @@ TEST(TestPeripheralCecKeys, TheOtherCommandsOnceTheTvIsOn)
 {
   // a TV that is off, or being switched off, while Kodi starts does not suspend the PC; its
   // menu language and the audio state of an amplifier wait as they did
-  for (const auto opcode : {CEC::CEC_OPCODE_STANDBY, CEC::CEC_OPCODE_SET_MENU_LANGUAGE,
-                            CEC::CEC_OPCODE_SET_SYSTEM_AUDIO_MODE,
-                            CEC::CEC_OPCODE_SYSTEM_AUDIO_MODE_STATUS,
-                            CEC::CEC_OPCODE_REPORT_AUDIO_STATUS})
+  for (const auto opcode :
+       {CEC::CEC_OPCODE_STANDBY, CEC::CEC_OPCODE_SET_MENU_LANGUAGE,
+        CEC::CEC_OPCODE_SET_SYSTEM_AUDIO_MODE, CEC::CEC_OPCODE_SYSTEM_AUDIO_MODE_STATUS,
+        CEC::CEC_OPCODE_REPORT_AUDIO_STATUS})
   {
     EXPECT_FALSE(CommandTaken(opcode, true, false)) << opcode;
     EXPECT_FALSE(CommandTaken(opcode, false, false)) << opcode;
@@ -46,7 +46,7 @@ TEST(TestPeripheralCecKeys, TheOtherCommandsOnceTheTvIsOn)
 
 TEST(TestPeripheralCecKeys, EverythingOnceTheTvIsOn)
 {
-  for (const auto opcode : {CEC::CEC_OPCODE_PLAY, CEC::CEC_OPCODE_DECK_CONTROL,
-                            CEC::CEC_OPCODE_STANDBY})
+  for (const auto opcode :
+       {CEC::CEC_OPCODE_PLAY, CEC::CEC_OPCODE_DECK_CONTROL, CEC::CEC_OPCODE_STANDBY})
     EXPECT_TRUE(CommandTaken(opcode, true, true)) << opcode;
 }
diff --git a/xbmc/rendering/capture/CaptureConvert.cpp b/xbmc/rendering/capture/CaptureConvert.cpp
index 28a2e10..91b2c59 100644
--- a/xbmc/rendering/capture/CaptureConvert.cpp
+++ b/xbmc/rendering/capture/CaptureConvert.cpp
@@ -277,11 +277,10 @@ double CaptureSourcePeak(const CaptureResult& result, bool* assumed)
     *assumed = false;
   if (result.color.transfer != AVCOL_TRC_SMPTE2084)
     return 0.0;
-  const double mastering =
-      result.hasDisplayMetadata && result.displayMetadata.has_luminance &&
-              result.displayMetadata.max_luminance.den > 0
-          ? av_q2d(result.displayMetadata.max_luminance)
-          : 0.0;
+  const double mastering = result.hasDisplayMetadata && result.displayMetadata.has_luminance &&
+                                   result.displayMetadata.max_luminance.den > 0
+                               ? av_q2d(result.displayMetadata.max_luminance)
+                               : 0.0;
   const double maxCll = result.hasLightMetadata && result.lightMetadata.MaxCLL >= 100
                             ? static_cast<double>(result.lightMetadata.MaxCLL)
                             : 0.0;
diff --git a/xbmc/utils/Screenshot.cpp b/xbmc/utils/Screenshot.cpp
index b45bed1..a42c71b 100644
--- a/xbmc/utils/Screenshot.cpp
+++ b/xbmc/utils/Screenshot.cpp
@@ -92,8 +92,8 @@ void WriteSdrCopy(const KODI::RENDERING::CAPTURE::CaptureResult& result,
   srgb.range = AVCOL_RANGE_JPEG;
   if (!CaptureToSdrCopy(result, pixels.data()) ||
       !CPicture::CreateThumbnailFromSurface(pixels.data(), result.width, result.height,
-                                            result.width * 4, copy,
-                                            XB_FMT_A8R8G8B8 | XB_FMT_OPAQUE, srgb))
+                                            result.width * 4, copy, XB_FMT_A8R8G8B8 | XB_FMT_OPAQUE,
+                                            srgb))
   {
     CLog::Log(LOGERROR, "Screenshot: the SDR copy of {} could not be written",
               CURL::GetRedacted(filename));
@@ -102,16 +102,16 @@ void WriteSdrCopy(const KODI::RENDERING::CAPTURE::CaptureResult& result,
   const bool pq = result.color.transfer == AVCOL_TRC_SMPTE2084;
   bool assumed = false;
   const double peak = CaptureSourcePeak(result, &assumed);
-  CLog::Log(LOGINFO,
-            "Screenshot: {} is HDR as the display gets it ({}, {} primaries, tagged so with "
-            "cICP); its SDR copy, tone mapped {} and tagged sRGB, is {}",
-            CURL::GetRedacted(filename), pq ? "PQ" : "HLG",
-            result.color.primaries == AVCOL_PRI_BT2020 ? "BT.2020" : "BT.709",
-            !pq ? std::string("from HLG")
-                : StringUtils::Format("from a peak of {:.0f} cd/m2{}", peak,
-                                      assumed ? " (the picture's is not known: 1000 is taken)"
-                                              : ""),
-            CURL::GetRedacted(copy));
+  CLog::Log(
+      LOGINFO,
+      "Screenshot: {} is HDR as the display gets it ({}, {} primaries, tagged so with "
+      "cICP); its SDR copy, tone mapped {} and tagged sRGB, is {}",
+      CURL::GetRedacted(filename), pq ? "PQ" : "HLG",
+      result.color.primaries == AVCOL_PRI_BT2020 ? "BT.2020" : "BT.709",
+      !pq ? std::string("from HLG")
+          : StringUtils::Format("from a peak of {:.0f} cd/m2{}", peak,
+                                assumed ? " (the picture's is not known: 1000 is taken)" : ""),
+      CURL::GetRedacted(copy));
 }
 
 // Encode a delivered capture to the destination file; runs on the capture
