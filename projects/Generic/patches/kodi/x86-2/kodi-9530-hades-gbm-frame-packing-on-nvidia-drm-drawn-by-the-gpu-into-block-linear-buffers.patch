+// (Hades) A row of 4-byte pixels written into a buffer that may be memory of the card through a
+// write-combined mapping (a dumb buffer of nvidia-drm: drm_gem_mmap_obj(), its range reserved
+// write-combined by ioremap_wc() in nvidia-drm-gem-nvkms-memory.c): never read, written front to
+// back in whole 16-byte stores that bypass the caches (streaming stores), which the processor
+// combines into whole lines of 64 bytes for the bus. Red and blue exchanged where \p swap, four
+// pixels at a time. The same bytes as a pixel-by-pixel copy. The caller fences (StoresDone()).
+void WriteRow(uint8_t* to, const uint8_t* from, size_t bytes, bool swap)
+{
+  size_t i = 0;
+#if defined(__SSE2__)
+  if ((reinterpret_cast<uintptr_t>(to) & 15) == 0)
+  {
+    const __m128i greenAlpha = _mm_set1_epi32(static_cast<int>(0xff00ff00u));
+    const __m128i low = _mm_set1_epi32(0xff);
+    for (; i + 16 <= bytes; i += 16)
+    {
+      __m128i v = _mm_loadu_si128(reinterpret_cast<const __m128i*>(from + i));
+      if (swap)
+        // (the bytes R, G, B, A of a pixel are the 32 bits 0xAABBGGRR: B and R change places)
+        v = _mm_or_si128(_mm_and_si128(v, greenAlpha),
+                         _mm_or_si128(_mm_and_si128(_mm_srli_epi32(v, 16), low),
+                                      _mm_slli_epi32(_mm_and_si128(v, low), 16)));
+      _mm_stream_si128(reinterpret_cast<__m128i*>(to + i), v);
+    }
+  }
+#endif
+  if (!swap)
+  {
+    std::memcpy(to + i, from + i, bytes - i);
+    return;
+  }
+  for (; i + 4 <= bytes; i += 4)
+  {
+    const uint8_t pixel[4] = {from[i + 2], from[i + 1], from[i], from[i + 3]};
+    std::memcpy(to + i, pixel, 4);
+  }
+}
+
+// (Hades) What EGL says of buffers of DRM_FORMAT_MOD_LINEAR of a format
+// (EGL_EXT_image_dma_buf_import_modifiers): whether it draws into them or only samples them
+// ("external only"), for kodi.log where GL cannot draw into a dumb buffer; empty where it cannot
+// be asked
+std::string LinearSaid(EGLDisplay display, uint32_t format)
+{
+  if (!HasEGLExtension(display, "EGL_EXT_image_dma_buf_import_modifiers"))
+    return {};
+  const auto query = reinterpret_cast<PFNEGLQUERYDMABUFMODIFIERSEXTPROC>(
+      eglGetProcAddress("eglQueryDmaBufModifiersEXT"));
+  EGLint count = 0;
+  if (!query || !query(display, static_cast<EGLint>(format), 0, nullptr, nullptr, &count) ||
+      count <= 0)
+    return {};
+  std::vector<EGLuint64KHR> modifiers(static_cast<size_t>(count));
+  std::vector<EGLBoolean> externalOnly(static_cast<size_t>(count));
+  if (!query(display, static_cast<EGLint>(format), count, modifiers.data(), externalOnly.data(),
+             &count))
+    return {};
+  for (EGLint i = 0; i < count && i < static_cast<EGLint>(modifiers.size()); ++i)
+    if (modifiers[i] == DRM_FORMAT_MOD_LINEAR)
+      return externalOnly[i]
+                 ? "EGL lists DRM_FORMAT_MOD_LINEAR of " + FourCC(format) +
+                       " as external only: it samples such a buffer, and draws into "
+                       "none"
+                 : "EGL lists DRM_FORMAT_MOD_LINEAR of " + FourCC(format) + " as one it draws into";
+  return "EGL does not list DRM_FORMAT_MOD_LINEAR among the modifiers of " + FourCC(format);
+}
+
+// (Hades) The streaming stores of WriteRow() reach memory before what follows them
+void StoresDone()
+{
+#if defined(__SSE2__)
+  _mm_sfence();
+#endif
+}
+
+// (Hades) A dumb buffer made opaque black (as the probe of a buffer drawn into leaves it), in
+// streaming stores as WriteRow() writes
+void FillBlack(uint8_t* map, size_t size)
+{
+  size_t i = 0;
+#if defined(__SSE2__)
+  if ((reinterpret_cast<uintptr_t>(map) & 15) == 0)
+  {
+    const __m128i black = _mm_set1_epi32(static_cast<int>(0xff000000u));
+    for (; i + 16 <= size; i += 16)
+      _mm_stream_si128(reinterpret_cast<__m128i*>(map + i), black);
+  }
+#endif
+  const uint32_t black = 0xff000000u;
+  for (; i + 4 <= size; i += 4)
+    std::memcpy(map + i, &black, 4);
+  StoresDone();
+}
+
+// (Hades) The bands of lines that the copy of the processor reads back one by one (CopyOut()):
+// while the processor writes one, the GPU sends the next
+constexpr int COPY_BANDS = 8;
+
 // (Hades) The side of the small buffer of GBM that stands for a dumb one in Kodi's queue
 // (OwnScanout.h): it is never drawn into or shown
 constexpr uint32_t STAND_IN_SIZE = 64;
