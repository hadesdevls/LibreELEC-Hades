+/*!
+ * \brief Hades: frame packing from a block-linear buffer of NVIDIA, which the GPU draws into
+ *
+ * NVIDIA's EGL draws into no buffer whose lines lie one after another (its GBM makes none for
+ * scanout and rendering, and a dumb buffer of nvidia-drm imported into it is no target of GL:
+ * issue #33, RTX 4080 SUPER, "storage error 0x502"), so a frame drawn by the GPU is in a
+ * block-linear buffer, whose lines lie in block rows of 8 << log2GobsPerBlockY lines (the last
+ * four bits of the modifier). nvidia-drm with Hades' patch (nvidia-open-kernel-modules-9087)
+ * takes a frame-packed frame from such a buffer too, uncompressed: the left eye from its first
+ * line, the right eye from the first line at or after vtotal that begins a block row and lies
+ * a multiple of 1024 bytes into the buffer (BlockLinearRightEyeRow(), which the kernel computes
+ * the same way: nv_drm_frame_packed_block_linear_row()). The lines between the eyes are never
+ * read: the display engine makes the active space of the signal itself. Kodi draws the frame as
+ * for any frame-packed mode, the right eye from line vtotal, and the GPU puts each eye where the
+ * buffer holds it (COwnScanout::EyesBlit()).
+ */
+inline constexpr uint64_t NVIDIA_MODIFIER_VENDOR = 0x03; // DRM_FORMAT_MOD_VENDOR_NVIDIA
+inline constexpr uint32_t BLOCK_LINEAR_MAX_LOG2_GOBS = 5; // nvidia-drm offers 0 to 5
+inline constexpr uint32_t GOB_LINES = 8;
+inline constexpr uint32_t GOB_BYTES_WIDE = 64;
+
+//! \brief Whether a modifier is an uncompressed block-linear one of NVIDIA (DRM_FORMAT_MOD_NVIDIA_
+//! BLOCK_LINEAR_2D: the vendor, bit 4, no compression in bits 23-25, a block of at most 32 GOBs)
+constexpr bool IsNvidiaBlockLinear(uint64_t modifier)
+{
+  return (modifier >> 56) == NVIDIA_MODIFIER_VENDOR && (modifier & 0x10) != 0 &&
+         ((modifier >> 23) & 0x7) == 0 && (modifier & 0xf) <= BLOCK_LINEAR_MAX_LOG2_GOBS;
+}
+
+/*!
+ * \brief The first line of the right eye in a block-linear buffer of this modifier and pitch (in
+ *        bytes, a multiple of the 64 bytes of a GOB) for a frame-packed mode
+ * \return the first line at or after vtotal that begins a block row and whose offset
+ *         (pitch x line) is a multiple of alignment; 0 without one
+ */
+constexpr uint32_t BlockLinearRightEyeRow(const Mode& mode,
+                                          uint64_t modifier,
+                                          uint32_t pitch,
+                                          uint32_t alignment)
+{
+  if (!IsNvidiaBlockLinear(modifier) || pitch == 0 || pitch % GOB_BYTES_WIDE != 0 ||
+      alignment == 0 || mode.vtotal == 0 || mode.vtotal <= mode.vdisplay)
+    return 0;
+  const uint32_t blockLines = GOB_LINES << (modifier & 0xf);
+  uint32_t row = (static_cast<uint32_t>(mode.vtotal) + blockLines - 1) / blockLines * blockLines;
+  // (a pitch of 64 bytes or more puts every 16th line on 1024 bytes: two steps at most)
+  for (int step = 0; step < 64; ++step, row += blockLines)
+  {
+    if ((static_cast<uint64_t>(pitch) * row) % alignment == 0)
+      return row;
+  }
+  return 0;
+}
+
+//! \brief The lines of a block-linear buffer of a frame-packed mode: room for the right eye
+//! after the largest block row that nvidia-drm offers (32 GOBs, 256 lines); 0 for no such mode
+constexpr int BlockLinearBufferHeight(const Mode& mode)
+{
+  if (mode.vtotal == 0 || mode.vtotal <= mode.vdisplay)
+    return 0;
+  constexpr int largest = static_cast<int>(GOB_LINES << BLOCK_LINEAR_MAX_LOG2_GOBS);
+  return (mode.vtotal + largest - 1) / largest * largest + mode.vdisplay;
+}
