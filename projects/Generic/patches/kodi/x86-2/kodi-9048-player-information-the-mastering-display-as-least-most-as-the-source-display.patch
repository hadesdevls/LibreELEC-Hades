From c4d6b7d8db44925a407a708aa5cdf429e35f03d1 Mon Sep 17 00:00:00 2001
From: Hades <15710513+hadesdevls@users.noreply.github.com>
Date: Wed, 18 Nov 2026 01:30:36 +0000
Subject: [PATCH] player information: the mastering display as least / most, as
 the source display

The player information said the mastering display of an HDR10 film, and the
one sent to the display, as most / least ("1000 / 0.0050 nits"), and the source
display of a Dolby Vision film, in the same place of its overview, as least /
most ("0.0001 / 4000 nits"). The same kind of value read two ways on the same
row, depending on the film.

Both mastering displays (the film's, hades.src.mastering, and the one in the
HDR InfoFrame, hades.out.mastering) are now said least / most, as the source
display is and as the mastering display is commonly written: "0.0050 / 1000
nits". Only the player information reads these two properties.
---
 xbmc/windowing/gbm/WinSystemGbm.cpp            | 6 ++++--
 xbmc/windowing/gbm/WinSystemGbmGLESContext.cpp | 7 ++++---
 2 files changed, 8 insertions(+), 5 deletions(-)

diff --git a/xbmc/windowing/gbm/WinSystemGbm.cpp b/xbmc/windowing/gbm/WinSystemGbm.cpp
index 0c2264f..f6834ca 100644
--- a/xbmc/windowing/gbm/WinSystemGbm.cpp
+++ b/xbmc/windowing/gbm/WinSystemGbm.cpp
@@ -5130,8 +5130,10 @@ void CWinSystemGbm::NoteSourceColour(const VideoPicture* picture)
     now.transfer = static_cast<int>(picture->color_transfer);
     if (const AVMasteringDisplayMetadata* mastering = KODI::UTILS::GetMasteringDisplayMetadata(*picture);
         mastering && mastering->has_luminance)
-      now.mastering = StringUtils::Format("{} / {:.4f}", std::lround(av_q2d(mastering->max_luminance)),
-                                          av_q2d(mastering->min_luminance));
+      // (Hades: least / most, as the source display of Dolby Vision is said in the same place of the player
+      // information, and as the mastering display is commonly written)
+      now.mastering = StringUtils::Format("{:.4f} / {}", av_q2d(mastering->min_luminance),
+                                          std::lround(av_q2d(mastering->max_luminance)));
     if (const AVContentLightMetadata* light = KODI::UTILS::GetContentLightMetadata(*picture))
     {
       now.maxCll = static_cast<int>(light->MaxCLL);
diff --git a/xbmc/windowing/gbm/WinSystemGbmGLESContext.cpp b/xbmc/windowing/gbm/WinSystemGbmGLESContext.cpp
index 84c5a57..a60a6db 100644
--- a/xbmc/windowing/gbm/WinSystemGbmGLESContext.cpp
+++ b/xbmc/windowing/gbm/WinSystemGbmGLESContext.cpp
@@ -11364,11 +11364,12 @@ void CWinSystemGbmGLESContext::PublishPlayerInfo()
                   break;
               }
             }
-            // max in cd/m2, min in 0.0001 cd/m2; 0 is "not given" (CTA-861.3)
+            // max in cd/m2, min in 0.0001 cd/m2; 0 is "not given" (CTA-861.3). Said least / most, as the
+            // film's (hades.src.mastering) and the source display of Dolby Vision are
             if (frame.max_display_mastering_luminance)
               info["hades.out.mastering"] =
-                  StringUtils::Format("{} / {:.4f}", frame.max_display_mastering_luminance,
-                                      frame.min_display_mastering_luminance / 10000.0);
+                  StringUtils::Format("{:.4f} / {}", frame.min_display_mastering_luminance / 10000.0,
+                                      frame.max_display_mastering_luminance);
             info["hades.out.primaries"] = MasteringPrimaries(frame);
             info["hades.out.cll"] = KODI::UTILS::PLAYERINFO::LightLevelsText(
                 frame.max_cll, frame.max_fall, EstuaryWord(31834, "not given"));
-- 
