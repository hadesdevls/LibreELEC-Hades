From 5fd377cc62bd91da49116953ff5f7f8ae56d57c8 Mon Sep 17 00:00:00 2001
From: Hades <15710513+hadesdevls@users.noreply.github.com>
Date: Wed, 25 Nov 2026 21:27:27 +0000
Subject: [PATCH] [Hades][GBM] A change of mode sets a link that the kernel
 marked Bad to Good

Where the kernel marked the link of the connector Bad (link-status), a
modeset that does not set it Good may leave the display without pixels:
the kernel asks user space for a modeset with link-status Good. Kodi's
own changes of mode (a video at its rate, the output turned on again,
the commits of native Dolby Vision that allow a modeset) are modesets of
the whole output, so they carry it.

In CDRMAtomic::DrmAtomicCommit(), in the block of a commit that allows a
modeset, after MODE_ID and ACTIVE: for an output that the commit keeps
or turns on, link-status is read, and only where it is Bad is Good added
to the request, with one kodi.log line. Nothing is added, and nothing
written, where it is Good, where the connector has no such property, or
for an output that the commit turns off; the read is one ioctl for each
change of mode.
---
 xbmc/windowing/gbm/drm/DRMAtomic.cpp | 19 +++++++++++++++++++
 1 file changed, 19 insertions(+)

diff --git a/xbmc/windowing/gbm/drm/DRMAtomic.cpp b/xbmc/windowing/gbm/drm/DRMAtomic.cpp
index 085f5f6..6d1c9cc 100644
--- a/xbmc/windowing/gbm/drm/DRMAtomic.cpp
+++ b/xbmc/windowing/gbm/drm/DRMAtomic.cpp
@@ -10,6 +10,7 @@
 
 #include "DRMRequestQueue.h"
 #include "DVBridgeRefused.h"
+#include "LinkStatus.h"
 #include "ServiceBroker.h"
 #include "application/ApplicationComponents.h"
 #include "application/ApplicationPlayer.h"
@@ -331,6 +332,24 @@ bool CDRMAtomic::DrmAtomicCommit(int fb_id, int flags, bool rendered, bool video
 
     if (!AddProperty(m_crtc, "ACTIVE", m_active ? 1 : 0))
       return reject();
+
+    // Hades: where the kernel marked the link of the connector Bad (link-status, after a link
+    // training that failed), this change of mode sets it Good: the kernel asks that of the program
+    // that drives the display, and without it the display may still get no pixels after the
+    // modeset (LinkStatus.h). Read for a change of mode only; nothing is added where it is Good,
+    // where the connector has no such property, or for an output that this turns off.
+    if (m_active && m_connector->SupportsProperty(LINK_STATUS::PROPERTY))
+    {
+      const auto link =
+          LINK_STATUS::ValuesOf(m_connector->GetPropertyEnumValue(LINK_STATUS::PROPERTY, "Good"),
+                                m_connector->GetPropertyEnumValue(LINK_STATUS::PROPERTY, "Bad"));
+      if (LINK_STATUS::CarriesGood(link, m_connector->ReadPropertyValue(LINK_STATUS::PROPERTY)) &&
+          AddProperty(m_connector, LINK_STATUS::PROPERTY, link->good))
+        CLog::Log(LOGINFO,
+                  "Link: the kernel marks the link of {} Bad (link-status): this change of mode "
+                  "sets it Good, so that the driver trains the link again",
+                  m_connector->GetName());
+    }
   }
 
   // In Direct-To-Plane (dual plane) mode m_gui_plane is the output
