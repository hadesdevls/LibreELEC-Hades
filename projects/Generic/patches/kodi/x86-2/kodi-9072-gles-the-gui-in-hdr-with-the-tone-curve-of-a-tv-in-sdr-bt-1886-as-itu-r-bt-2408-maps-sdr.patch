+// Hades: the tone curve that makes the light of the GUI in HDR (videoscreen.hadesguicurve), as the
+// composite takes it (CGuiCompositeShaderGLES::CreateLUTs()): 0, BT.1886 (a 2.4 power with its black
+// at zero: how a TV shows the same GUI in SDR, and how ITU-R BT.2408 maps SDR into HDR); 1, a 2.2 power
+// (a TV or a monitor set to gamma 2.2); 2, the sRGB EOTF of IEC 61966-2-1, Kodi's own, whose straight
+// segment makes the darkest greys lighter than any SDR display shows them. BT.1886, the setting's
+// default, when the setting cannot be read.
+float GuiToneGamma()
+{
+  const auto component = CServiceBroker::GetSettingsComponent();
+  const auto settings = component ? component->GetSettings() : nullptr;
+  if (!settings || !settings->GetSetting(CSettings::SETTING_VIDEOSCREEN_HADESGUICURVE))
+    return 2.4f;
+  switch (settings->GetInt(CSettings::SETTING_VIDEOSCREEN_HADESGUICURVE))
+  {
+    case 1:
+      return 2.2f;
+    case 2:
+      return 0.0f;
+    default:
+      return 2.4f;
+  }
+}
