diff --git a/system/shaders/GLES/2.0/gles_gui_composite.frag b/system/shaders/GLES/2.0/gles_gui_composite.frag
index 0956f8d..b8e38b7 100644
--- a/system/shaders/GLES/2.0/gles_gui_composite.frag
+++ b/system/shaders/GLES/2.0/gles_gui_composite.frag
@@ -9,8 +9,9 @@
 #version 100
 
 // Hades: where fragment shaders have highp (every OpenGL ES 3 GPU), the GUI is converted exactly, as
-// the OpenGL composite shader does (gl_gui_composite.frag): the sRGB EOTF of IEC 61966-2-1, BT.709 to
-// BT.2020 in linear light, and the PQ or HLG signal of that light, all in highp. The LUTs of 256
+// the OpenGL composite shader does (gl_gui_composite.frag): the GUI's tone curve (u_guiGamma: BT.1886 by
+// default; the sRGB EOTF of IEC 61966-2-1 in Kodi's composite), BT.709 to BT.2020 in linear light, and
+// the PQ or HLG signal of that light, all in highp. The LUTs of 256
 // entries, linear in light and sampled off the centres of their texels, darkened the dark tones of the
 // GUI by up to a third of the PQ range (a grey of sRGB code 13 at 12-bit luma 494 where it is 746,
 // code 1 black), and the more the brighter the GUI white. Without highp the LUTs stay, as before.
@@ -23,7 +24,7 @@ precision mediump float;
 uniform sampler2D u_samp;       // GUI FBO texture (sRGB, rendered by GUI shaders)
 #endif
 varying vec2 v_tex;
-uniform sampler2D u_lutDegamma; // sRGB -> linear LUT (IEC 61966-2-1)
+uniform sampler2D u_lutDegamma; // GUI -> linear LUT (Hades: by the GUI's tone curve, as u_guiGamma)
 uniform sampler2D u_lutTF;      // linear -> PQ LUT (1024 entries, sdrPeak baked in)
 uniform float u_ootfGamma;      // HLG: OOTF gamma (1.2 for BT.2100 1000-nit ref)
                                 // PQ: 0.0 (use LUT path instead)
@@ -35,6 +36,10 @@ uniform float u_hlgWhite;
 // Hades: 1.0: the composite is into SDR of BT.2020 primaries, not into PQ or HLG (an SDR video of
 // BT.2020 sent as it is: KODI::UTILS::SDRWIDE)
 uniform float u_sdrWide;
+// Hades: the tone curve that makes the GUI's light (what the degamma LUT has baked in): the exponent of a
+// pure power, 2.4 (BT.1886 with its black at zero: how a TV shows the same GUI in SDR, and how ITU-R
+// BT.2408 maps SDR into HDR) or 2.2; 0, the sRGB EOTF of IEC 61966-2-1, Kodi's own
+uniform float u_guiGamma;
 #endif
 
 // BT.709 -> BT.2020 color space conversion matrix (applied in linear light)
@@ -61,6 +66,14 @@ vec3 srgbToLinear(vec3 c)
   return mix(c / 12.92, pow((c + 0.055) / 1.055, vec3(2.4)), step(vec3(0.04045), c));
 }
 
+// Hades: the light of a GUI pixel by its tone curve (u_guiGamma)
+vec3 guiToLinear(vec3 c)
+{
+  if (u_guiGamma > 0.0)
+    return pow(c, vec3(u_guiGamma));
+  return srgbToLinear(c);
+}
+
 // SMPTE ST 2084 inverse EOTF of linear light in units of 10000 cd/m2
 vec3 forwardPQ(vec3 L)
 {
@@ -99,11 +112,11 @@ void main()
     return;
   }
 
-  vec3 linear = srgbToLinear(clamp(gui.rgb, 0.0, 1.0));
+  vec3 linear = guiToLinear(clamp(gui.rgb, 0.0, 1.0));
   if (u_ootfGamma > 0.0)
     linear *= u_hlgWhite;
 #else
-  // sRGB -> linear via LUT (IEC 61966-2-1 EOTF, replaces inline pow)
+  // GUI -> linear via LUT (Hades: its tone curve, replaces inline pow)
   vec3 linear = vec3(
     texture2D(u_lutDegamma, vec2(gui.r, 0.5)).r,
     texture2D(u_lutDegamma, vec2(gui.g, 0.5)).r,
diff --git a/tools/dvbridge/dvbridge_render.c b/tools/dvbridge/dvbridge_render.c
index cb327b2..b424a0b 100644
--- a/tools/dvbridge/dvbridge_render.c
+++ b/tools/dvbridge/dvbridge_render.c
@@ -199,8 +199,8 @@ struct dvbridge_renderer {
     int drawn_w, drawn_h;
     uint64_t drawn_key;
     /* Hades: the GUI white for the GUI read in place by the packer, for the next frame
-     * (dvbridge_render_set_gui_in_place()); 0: not asked */
-    float inplace_peak;
+     * (dvbridge_render_set_gui_in_place()); 0: not asked. Hades: and its tone curve */
+    float inplace_peak, inplace_gamma;
     /* Hades: Dolby Vision Low-Latency (dvbridge_render_set_low_latency()): the picture mapped to
      * ll_mapping, packed without metadata; ll_pattern, the test pattern in its place */
     bool low_latency, ll_pattern;
@@ -1515,7 +1515,7 @@ static bool render_source(struct dvbridge_renderer *r, const struct pl_frame *so
         /* Hades: the GUI read in place by the packer where it is asked (then without the GUI
          * cache, which reads the picture with the GUI composited over it) */
         const float inplace = r->drawn_gui ? r->inplace_peak : 0.0f;
-        dvbridge_source_gui_in_place(r->source_packer, inplace);
+        dvbridge_source_gui_in_place(r->source_packer, inplace, r->inplace_gamma);
         /* (Hades: and the key of its composite, for the GUI cache) */
         dvbridge_source_drawn_key(r->source_packer,
                                   r->drawn_gui && inplace <= 0.0f ? r->drawn_key : 0);
@@ -3822,10 +3822,12 @@ void dvbridge_render_set_drawn(struct dvbridge_renderer *r, unsigned gui, int wi
     r->drawn_h = height;
 }
 
-void dvbridge_render_set_gui_in_place(struct dvbridge_renderer *r, float peak)
+void dvbridge_render_set_gui_in_place(struct dvbridge_renderer *r, float peak, float gamma)
 {
-    if (r)
+    if (r) {
         r->inplace_peak = peak;
+        r->inplace_gamma = gamma;
+    }
 }
 
 bool dvbridge_render_gui_in_place(const struct dvbridge_renderer *r)
