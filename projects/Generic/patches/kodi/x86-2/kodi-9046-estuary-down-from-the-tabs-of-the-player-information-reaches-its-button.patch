From a7a2d29a5cd5d8bc0ad655143b2b9b7be8dc58da Mon Sep 17 00:00:00 2001
From: Hades <15710513+hadesdevls@users.noreply.github.com>
Date: Wed, 18 Nov 2026 00:58:41 +0000
Subject: [PATCH] estuary: Down from the tabs of the player information reaches
 its button

"Change output for this video..." could not be reached with the arrow keys, a
remote or Yatse: Down on the tabs closed the panel. The tabs had two conditional
moves down to the button of the overview and of the Dolby Vision page, and a
Close without a condition after them. Kodi runs every action of a direction
whose condition holds and only then moves the focus (CGUIAction::ExecuteActions()
skips only the numeric ones; CGUIWindow::OnMove() runs them and then takes
GetNavigation()), so the Close always ran and the panel went away before the
button had the focus. A mouse reached it, nothing else did.

The Close now has the condition that neither move applies: Down still closes
the panel on a page without the button, as before. The dialog of system/hades
for other skins is made again from Estuary's file (make-playerinfo.py) and has
the same fix.
---
 addons/skin.estuary/xml/DialogPlayerProcessInfo.xml | 7 ++++++-
 system/hades/DialogHadesPlayerInfo.xml              | 2 +-
 2 files changed, 7 insertions(+), 2 deletions(-)

diff --git a/addons/skin.estuary/xml/DialogPlayerProcessInfo.xml b/addons/skin.estuary/xml/DialogPlayerProcessInfo.xml
index 39da737..1e5f19f 100644
--- a/addons/skin.estuary/xml/DialogPlayerProcessInfo.xml
+++ b/addons/skin.estuary/xml/DialogPlayerProcessInfo.xml
@@ -2186,9 +2186,14 @@
 				<orientation>horizontal</orientation>
 				<itemgap>-34</itemgap>
 				<onup>Close</onup>
+				<!-- Down goes to the button of the page where it has one, and closes the panel where it has none.
+				     Kodi runs every action of a direction whose condition holds and only then moves the focus
+				     (CGUIAction::ExecuteActions(), CGUIWindow::OnMove()): a Close without a condition next to the
+				     moves closed the panel before the button had the focus, so it was never reached with keys,
+				     a remote or Yatse. -->
 				<ondown condition="String.IsEqual(Window(Home).Property(PlayerInfoDialogFocus),5556) + Control.IsVisible(5561)">5561</ondown>
 				<ondown condition="String.IsEqual(Window(Home).Property(PlayerInfoDialogFocus),5555) + Control.IsVisible(5560)">5560</ondown>
-				<ondown>Close</ondown>
+				<ondown condition="![String.IsEqual(Window(Home).Property(PlayerInfoDialogFocus),5556) + Control.IsVisible(5561)] + ![String.IsEqual(Window(Home).Property(PlayerInfoDialogFocus),5555) + Control.IsVisible(5560)]">Close</ondown>
 				<usecontrolcoords>true</usecontrolcoords>
 				<control type="button" id="5556">
 					<width>190</width>
diff --git a/system/hades/DialogHadesPlayerInfo.xml b/system/hades/DialogHadesPlayerInfo.xml
index b10f4bf..efe2c6c 100644
--- a/system/hades/DialogHadesPlayerInfo.xml
+++ b/system/hades/DialogHadesPlayerInfo.xml
@@ -9511,7 +9511,7 @@
 				<onup>Close</onup>
 				<ondown condition="String.IsEqual(Window(Home).Property(HadesPlayerInfoPage),5556) + Control.IsVisible(5561)">5561</ondown>
 				<ondown condition="String.IsEqual(Window(Home).Property(HadesPlayerInfoPage),5555) + Control.IsVisible(5560)">5560</ondown>
-				<ondown>Close</ondown>
+				<ondown condition="![String.IsEqual(Window(Home).Property(HadesPlayerInfoPage),5556) + Control.IsVisible(5561)] + ![String.IsEqual(Window(Home).Property(HadesPlayerInfoPage),5555) + Control.IsVisible(5560)]">Close</ondown>
 				<usecontrolcoords>true</usecontrolcoords>
 				<control type="button" id="5556">
 					<width>190</width>
