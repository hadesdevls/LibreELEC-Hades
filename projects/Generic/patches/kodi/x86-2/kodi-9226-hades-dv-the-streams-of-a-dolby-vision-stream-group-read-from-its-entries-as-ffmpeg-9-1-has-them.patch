diff --git a/xbmc/cores/VideoPlayer/DVDDemuxers/StreamGroupStreams.h b/xbmc/cores/VideoPlayer/DVDDemuxers/StreamGroupStreams.h
new file mode 100644
index 0000000..26745ad
--- /dev/null
+++ b/xbmc/cores/VideoPlayer/DVDDemuxers/StreamGroupStreams.h
@@ -0,0 +1,51 @@
