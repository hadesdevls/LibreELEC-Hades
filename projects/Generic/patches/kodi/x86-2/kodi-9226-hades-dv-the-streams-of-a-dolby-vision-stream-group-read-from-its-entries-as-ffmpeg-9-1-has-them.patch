+
+#pragma once
+
+// Hades: the streams of a stream group of libavformat. FFmpeg 9.1 (libavformat 63.10) gives a group
+// its entries (AVStreamGroup.entries, nb_entries: streams or child groups) and deprecates
+// AVStreamGroup.streams and nb_streams (FF_API_STREAM_GROUP_ENTRIES, until libavformat 64). Its
+// layered video groups (the Dolby Vision ones) index the entries (AVStreamGroupLayeredVideo.el_index,
+// demux.c and dump.c of 9.1), which for a group of streams only are its streams in the same order.
+// An entry that is a child group is no stream here (nullptr).
+
+extern "C"
+{
+#include <libavformat/avformat.h>
+}
+
+namespace KODI::STREAMGROUP
+{
+
+//! The number of entries of a group (its streams, with FFmpeg before 9.1)
+inline unsigned int Size(const AVStreamGroup* group)
+{
+  if (!group)
+    return 0;
+#if LIBAVFORMAT_VERSION_INT >= AV_VERSION_INT(63, 10, 100)
+  return group->nb_entries;
+#else
+  return group->nb_streams;
+#endif
+}
+
+//! The stream of entry i of a group, or nullptr where it is none (out of range, or a child group)
+inline AVStream* Stream(const AVStreamGroup* group, unsigned int i)
+{
+  if (!group || i >= Size(group))
+    return nullptr;
+#if LIBAVFORMAT_VERSION_INT >= AV_VERSION_INT(63, 10, 100)
+  const AVStreamGroupEntry* entry = group->entries[i];
+  return entry && entry->type == AV_STREAM_GROUP_ENTRY_STREAM ? entry->stream : nullptr;
+#else
+  return group->streams[i];
+#endif
+}
+
+} // namespace KODI::STREAMGROUP
