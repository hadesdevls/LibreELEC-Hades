                    unsigned int height,
                    uint8_t* buffer);
 
+//! \brief Hades: the peak, in cd/m2, that a PQ capture is tone mapped from: the MaxCLL of its
+//! content where it is given and lower than the peak of its mastering display (a film mastered on
+//! a 4000 cd/m2 display whose brightest pixel is 1000), else that peak; where neither is given,
+//! 1000, the most usual mastering peak (swscale would take the whole range of PQ, 10000 cd/m2, and
+//! darken the whole picture). A MaxCLL under 100 is taken as not given. 0 for a capture that is
+//! not PQ.
+//! \param[out] assumed true where the peak is not given and 1000 is taken
+double CaptureSourcePeak(const CaptureResult& result, bool* assumed = nullptr);
+
+//! \brief Hades: the SDR copy of an HDR (PQ or HLG) capture: at its own size, 8-bit BGRA, tone
+//! mapped to SDR (perceptual intent, the source peak of CaptureSourcePeak()) with BT.709
+//! primaries and the sRGB transfer, the coding that picture viewers take for a picture without
+//! colour tags, as the SDR screenshots of Kodi are tagged. The buffer must hold
+//! width * height * 4 bytes. Runs on the consumer's thread, never the render thread.
+bool CaptureToSdrCopy(const CaptureResult& result, uint8_t* buffer);
+
 } // namespace CAPTURE
 } // namespace RENDERING
 } // namespace KODI
diff --git a/xbmc/rendering/capture/test/TestCaptureConvert.cpp b/xbmc/rendering/capture/test/TestCaptureConvert.cpp
index 7282262..b5b6870 100644
--- a/xbmc/rendering/capture/test/TestCaptureConvert.cpp
+++ b/xbmc/rendering/capture/test/TestCaptureConvert.cpp
@@ -11,6 +11,7 @@
 #include "rendering/capture/CaptureTypes.h"
 
 #include <cmath>
+#include <cstdio>
 #include <cstring>
 #include <memory>
 #include <vector>
@@ -186,3 +187,205 @@ TEST(TestCaptureConvert, PQRampHonorsMasteringPeak)
   EXPECT_GE(ramp[height - 1], 200);
   EXPECT_GT(ramp[7], ramp[4]);
 }
+
+// Hades: the SDR copy of an HDR screenshot (CaptureToSdrCopy(), CaptureSourcePeak())
+namespace
+{
+// a grey PQ ramp, one row per luminance, RGBA64 tagged BT.2020 + PQ
+const std::vector<double> RAMP_NITS = {0.0, 1.0, 10.0, 50.0, 100.0, 203.0, 400.0, 1000.0, 10000.0};
+
+CaptureResult MakePQRamp()
+{
+  const unsigned int width = 4;
+  const unsigned int height = RAMP_NITS.size();
+  const unsigned int stride = width * 8;
+  std::vector<uint8_t> input(stride * height);
+  for (unsigned int y = 0; y < height; y++)
+  {
+    const uint16_t code = PQCode(RAMP_NITS[y]);
+    uint16_t* row = reinterpret_cast<uint16_t*>(input.data() + y * stride);
+    for (unsigned int x = 0; x < width; x++)
+    {
+      row[x * 4 + 0] = code;
+      row[x * 4 + 1] = code;
+      row[x * 4 + 2] = code;
+      row[x * 4 + 3] = 0xFFFF;
+    }
+  }
+  CaptureResult result = MakeResult(width, height, stride, AV_PIX_FMT_RGBA64LE, input);
+  result.color.primaries = AVCOL_PRI_BT2020;
+  result.color.transfer = AVCOL_TRC_SMPTE2084;
+  return result;
+}
+
+void SetMasteringPeak(CaptureResult& result, int nits)
+{
+  result.hasDisplayMetadata = true;
+  result.displayMetadata = {};
+  result.displayMetadata.has_luminance = 1;
+  result.displayMetadata.min_luminance = AVRational{50, 10000};
+  result.displayMetadata.max_luminance = AVRational{nits, 1};
+}
+
+// the grey of each row of a BGRA8 picture 4 pixels wide
+std::vector<int> Greys(const std::vector<uint8_t>& buffer, unsigned int height)
+{
+  std::vector<int> grey(height);
+  for (unsigned int y = 0; y < height; y++)
+  {
+    const uint8_t* px = buffer.data() + y * 4 * 4;
+    grey[y] = (px[0] + px[1] + px[2]) / 3;
+  }
+  return grey;
+}
+
+std::vector<int> SdrCopyGreys(const CaptureResult& result)
+{
+  std::vector<uint8_t> buffer(result.width * result.height * 4, 0);
+  EXPECT_TRUE(CaptureToSdrCopy(result, buffer.data()));
+  for (unsigned int y = 0; y < result.height; y++)
+  {
+    const uint8_t* px = buffer.data() + y * result.width * 4;
+    EXPECT_NEAR(px[0], px[1], 3) << "row " << y << ": grey stays grey";
+    EXPECT_NEAR(px[1], px[2], 3) << "row " << y << ": grey stays grey";
+  }
+  return Greys(buffer, result.height);
+}
+} // namespace
+
+TEST(TestCaptureConvert, SourcePeakOfAPQCapture)
+{
+  CaptureResult result = MakePQRamp();
+  bool assumed = false;
+  // nothing given: 1000, said to be assumed
+  EXPECT_DOUBLE_EQ(CaptureSourcePeak(result, &assumed), 1000.0);
+  EXPECT_TRUE(assumed);
+  // the mastering display alone
+  SetMasteringPeak(result, 4000);
+  EXPECT_DOUBLE_EQ(CaptureSourcePeak(result, &assumed), 4000.0);
+  EXPECT_FALSE(assumed);
+  // with a MaxCLL under it: the MaxCLL, the brightest pixel of the content
+  result.hasLightMetadata = true;
+  result.lightMetadata.MaxCLL = 1000;
+  EXPECT_DOUBLE_EQ(CaptureSourcePeak(result), 1000.0);
+  // a MaxCLL over the mastering peak: that peak
+  result.lightMetadata.MaxCLL = 6000;
+  EXPECT_DOUBLE_EQ(CaptureSourcePeak(result), 4000.0);
+  // a MaxCLL under 100 is no peak of an HDR picture: not taken
+  result.lightMetadata.MaxCLL = 40;
+  EXPECT_DOUBLE_EQ(CaptureSourcePeak(result), 4000.0);
+  // the MaxCLL alone
+  result.hasDisplayMetadata = false;
+  result.lightMetadata.MaxCLL = 600;
+  EXPECT_DOUBLE_EQ(CaptureSourcePeak(result, &assumed), 600.0);
+  EXPECT_FALSE(assumed);
+  // not PQ: none
+  result.color.transfer = AVCOL_TRC_ARIB_STD_B67;
+  EXPECT_DOUBLE_EQ(CaptureSourcePeak(result), 0.0);
+}
+
+TEST(TestCaptureConvert, SdrCopyOfPQ)
+{
+  // mastered at 1000 cd/m2: black stays black, the peak is white, the reference white of HDR
+  // (203 cd/m2, ITU-R BT.2408) is a bright grey under it, and the ramp rises
+  CaptureResult result = MakePQRamp();
+  SetMasteringPeak(result, 1000);
+  const std::vector<int> grey = SdrCopyGreys(result);
+  for (unsigned int y = 0; y < grey.size(); y++)
+    std::printf("SDR copy, mastered at 1000 cd/m2: %7.1f cd/m2 -> %d\n", RAMP_NITS[y], grey[y]);
+  EXPECT_LE(grey[0], 3);
+  EXPECT_GE(grey[7], 250);
+  EXPECT_GE(grey[5], 150);
+  EXPECT_LE(grey[5], 240);
+  for (unsigned int y = 1; y < grey.size(); y++)
+    EXPECT_GE(grey[y] + 1, grey[y - 1]) << "row " << y;
+  EXPECT_GT(grey[5], grey[3]);
+  EXPECT_GT(grey[7], grey[5]);
+}
+
+TEST(TestCaptureConvert, SdrCopyIsSrgbNotBT709)
+{
+  // the copy is coded with the sRGB transfer (the coding viewers take), the bookmark thumbnails
+  // with BT.709 (CaptureToBGRA()): the shadows of the same picture differ
+  CaptureResult result = MakePQRamp();
+  SetMasteringPeak(result, 1000);
+  const std::vector<int> srgb = SdrCopyGreys(result);
+  std::vector<uint8_t> buffer(result.width * result.height * 4, 0);
+  ASSERT_TRUE(CaptureToBGRA(result, result.width, result.height, buffer.data()));
+  const std::vector<int> bt709 = Greys(buffer, result.height);
+  std::printf("10 cd/m2: sRGB %d, BT.709 %d; 1 cd/m2: sRGB %d, BT.709 %d\n", srgb[2], bt709[2],
+              srgb[1], bt709[1]);
+  EXPECT_NE(srgb[1], bt709[1]);
+  EXPECT_NE(srgb[2], bt709[2]);
+}
+
+TEST(TestCaptureConvert, SdrCopyWithoutMetadataTakes1000)
+{
+  // nothing known of the picture: as if mastered at 1000 cd/m2, not over the whole PQ range
+  // (10000), which darkens all of it
+  CaptureResult none = MakePQRamp();
+  CaptureResult at1000 = MakePQRamp();
+  SetMasteringPeak(at1000, 1000);
+  CaptureResult at10000 = MakePQRamp();
+  SetMasteringPeak(at10000, 10000);
+  const std::vector<int> a = SdrCopyGreys(none);
+  const std::vector<int> b = SdrCopyGreys(at1000);
+  const std::vector<int> c = SdrCopyGreys(at10000);
+  std::printf("203 cd/m2: nothing known %d, at 1000 %d, at 10000 %d\n", a[5], b[5], c[5]);
+  EXPECT_EQ(a, b);
+  EXPECT_GT(a[5], c[5]);
+}
+
+TEST(TestCaptureConvert, SdrCopyTakesMaxCll)
+{
+  // mastered at 4000 cd/m2, its brightest pixel at 1000: mapped from 1000, as the picture is
+  CaptureResult cll = MakePQRamp();
+  SetMasteringPeak(cll, 4000);
+  cll.hasLightMetadata = true;
+  cll.lightMetadata.MaxCLL = 1000;
+  CaptureResult at1000 = MakePQRamp();
+  SetMasteringPeak(at1000, 1000);
+  CaptureResult at4000 = MakePQRamp();
+  SetMasteringPeak(at4000, 4000);
+  const std::vector<int> a = SdrCopyGreys(cll);
+  EXPECT_EQ(a[7], SdrCopyGreys(at1000)[7]);
+  EXPECT_GT(a[7], SdrCopyGreys(at4000)[7]);
+}
+
+TEST(TestCaptureConvert, SdrCopyOnlyOfHDR)
+{
+  // an SDR capture has no SDR copy
+  constexpr unsigned int width = 4;
+  constexpr unsigned int height = 2;
+  std::vector<uint8_t> input(width * height * 4, 0x80);
+  CaptureResult result = MakeResult(width, height, width * 4, AV_PIX_FMT_BGRA, input);
+  result.color.transfer = AVCOL_TRC_IEC61966_2_1;
+  std::vector<uint8_t> buffer(width * height * 4, 0);
+  EXPECT_FALSE(CaptureToSdrCopy(result, buffer.data()));
+}
+
+TEST(TestCaptureConvert, SdrCopyOfHLG)
+{
+  // HLG (relative to its display): black stays black, its peak is white, the ramp rises
+  constexpr unsigned int width = 4;
+  const std::vector<double> signal = {0.0, 0.25, 0.5, 0.75, 1.0};
+  const unsigned int height = signal.size();
+  std::vector<uint8_t> input(width * 8 * height);
+  for (unsigned int y = 0; y < height; y++)
+  {
+    uint16_t* row = reinterpret_cast<uint16_t*>(input.data() + y * width * 8);
+    for (unsigned int x = 0; x < width; x++)
+      for (int c = 0; c < 4; c++)
+        row[x * 4 + c] = c == 3 ? 0xFFFF : static_cast<uint16_t>(signal[y] * 65535.0 + 0.5);
+  }
+  CaptureResult result = MakeResult(width, height, width * 8, AV_PIX_FMT_RGBA64LE, input);
+  result.color.primaries = AVCOL_PRI_BT2020;
+  result.color.transfer = AVCOL_TRC_ARIB_STD_B67;
+  const std::vector<int> grey = SdrCopyGreys(result);
+  for (unsigned int y = 0; y < height; y++)
+    std::printf("SDR copy of HLG: signal %.2f -> %d\n", signal[y], grey[y]);
+  EXPECT_LE(grey[0], 3);
+  EXPECT_GE(grey[4], 245);
+  for (unsigned int y = 1; y < height; y++)
+    EXPECT_GT(grey[y], grey[y - 1]) << "row " << y;
+}
