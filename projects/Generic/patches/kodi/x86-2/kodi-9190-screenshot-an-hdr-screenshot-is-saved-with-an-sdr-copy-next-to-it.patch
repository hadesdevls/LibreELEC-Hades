+// Hades: the name of the SDR copy of a screenshot: its own with "-sdr" before its extension
+// (screenshot00001.png: screenshot00001-sdr.png)
+std::string SdrCopyName(const std::string& filename)
+{
+  if (StringUtils::EndsWithNoCase(filename, ".png"))
+    return filename.substr(0, filename.size() - 4) + "-sdr.png";
+  return filename + "-sdr.png";
+}
+
+// Hades: a screenshot taken while the output is HDR (PQ or HLG) is the picture as the display
+// gets it, tagged so (cICP): it looks right only in a viewer that reads that tag, and dark and
+// pale in the others. Next to it goes an SDR copy, tone mapped from it (CaptureToSdrCopy()) and
+// tagged sRGB, which every viewer shows right. On the capture service's worker, after the HDR one
+// is written: the thread that draws is not held up.
+void WriteSdrCopy(const KODI::RENDERING::CAPTURE::CaptureResult& result,
+                  const std::string& filename)
+{
+  using namespace KODI::RENDERING::CAPTURE;
+  const std::string copy = SdrCopyName(filename);
+  std::vector<uint8_t> pixels(static_cast<size_t>(result.width) * result.height * 4);
+  // (sRGB: an sRGB chunk in the PNG, and no cICP)
+  ImageColorMetadata srgb;
+  srgb.primaries = AVCOL_PRI_BT709;
+  srgb.transfer = AVCOL_TRC_IEC61966_2_1;
+  srgb.range = AVCOL_RANGE_JPEG;
+  if (!CaptureToSdrCopy(result, pixels.data()) ||
+      !CPicture::CreateThumbnailFromSurface(pixels.data(), result.width, result.height,
+                                            result.width * 4, copy,
+                                            XB_FMT_A8R8G8B8 | XB_FMT_OPAQUE, srgb))
+  {
+    CLog::Log(LOGERROR, "Screenshot: the SDR copy of {} could not be written",
+              CURL::GetRedacted(filename));
+    return;
+  }
+  const bool pq = result.color.transfer == AVCOL_TRC_SMPTE2084;
+  bool assumed = false;
+  const double peak = CaptureSourcePeak(result, &assumed);
+  CLog::Log(LOGINFO,
+            "Screenshot: {} is HDR as the display gets it ({}, {} primaries, tagged so with "
+            "cICP); its SDR copy, tone mapped {} and tagged sRGB, is {}",
+            CURL::GetRedacted(filename), pq ? "PQ" : "HLG",
+            result.color.primaries == AVCOL_PRI_BT2020 ? "BT.2020" : "BT.709",
+            !pq ? std::string("from HLG")
+                : StringUtils::Format("from a peak of {:.0f} cd/m2{}", peak,
+                                      assumed ? " (the picture's is not known: 1000 is taken)"
+                                              : ""),
+            CURL::GetRedacted(copy));
+}
+
