 }
 
+double CaptureSourcePeak(const CaptureResult& result, bool* assumed)
+{
+  if (assumed)
+    *assumed = false;
+  if (result.color.transfer != AVCOL_TRC_SMPTE2084)
+    return 0.0;
+  const double mastering =
+      result.hasDisplayMetadata && result.displayMetadata.has_luminance &&
+              result.displayMetadata.max_luminance.den > 0
+          ? av_q2d(result.displayMetadata.max_luminance)
+          : 0.0;
+  const double maxCll = result.hasLightMetadata && result.lightMetadata.MaxCLL >= 100
+                            ? static_cast<double>(result.lightMetadata.MaxCLL)
+                            : 0.0;
+  if (maxCll > 0.0 && (mastering <= 0.0 || maxCll < mastering))
+    return std::min(maxCll, 10000.0);
+  if (mastering > 0.0)
+    return std::min(mastering, 10000.0);
+  if (assumed)
+    *assumed = true;
+  return 1000.0;
+}
+
+bool CaptureToSdrCopy(const CaptureResult& result, uint8_t* buffer)
+{
+  if (!result.pixels || result.width == 0 || result.height == 0 ||
+      (result.color.transfer != AVCOL_TRC_SMPTE2084 &&
+       result.color.transfer != AVCOL_TRC_ARIB_STD_B67))
+    return false;
+
+  CScopedCapturePixels lock(*result.pixels);
+  if (!lock.data())
+    return false;
+  return ConvertColorManaged(result, CaptureSrcRow0(lock.data(), result.stride, result.height),
+                             result.width, result.height, buffer, AVCOL_TRC_IEC61966_2_1);
+}
+
 } // namespace CAPTURE
 } // namespace RENDERING
 } // namespace KODI
