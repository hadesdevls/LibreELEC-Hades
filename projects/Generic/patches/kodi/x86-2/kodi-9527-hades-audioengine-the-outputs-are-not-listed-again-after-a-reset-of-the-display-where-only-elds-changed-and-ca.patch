     CLog::Log(LOGINFO,
-              "CALSAHControlMonitor - the control \"{}\" (device {}) of {} changed (for an ELD: "
-              "what the display says of its audio): the outputs are listed again",
+              "CALSAHControlMonitor - the control \"{}\" (device {}) of {} changed: the outputs "
+              "are listed again",
               name ? name : "?", snd_hctl_elem_get_device(elem), card ? card : "?");
 
     /*
@@ -131,6 +171,52 @@ int CALSAHControlMonitor::HCTLCallback(snd_hctl_elem_t *elem, unsigned int mask)
   return 0;
 }
 
+bool CALSAHControlMonitor::ReadEld(snd_hctl_elem_t* elem, std::vector<uint8_t>& bytes)
+{
+  // (as CAESinkALSA::GetELD() reads it)
+  bytes.clear();
+  snd_ctl_elem_info_t* info;
+  snd_ctl_elem_info_alloca(&info);
+  if (snd_hctl_elem_info(elem, info) < 0 || !snd_ctl_elem_info_is_readable(info) ||
+      snd_ctl_elem_info_get_type(info) != SND_CTL_ELEM_TYPE_BYTES)
+    return false;
+  snd_ctl_elem_value_t* value;
+  snd_ctl_elem_value_alloca(&value);
+  if (snd_hctl_elem_read(elem, value) < 0)
+    return false;
+  const unsigned int count = snd_ctl_elem_info_get_count(info);
+  const auto* data = static_cast<const uint8_t*>(snd_ctl_elem_value_get_bytes(value));
+  if (count && data)
+    bytes.assign(data, data + count);
+  return true;
+}
+
+std::string CALSAHControlMonitor::EldKey(snd_hctl_elem_t* elem)
+{
+  snd_hctl_t* hctl = snd_hctl_elem_get_hctl(elem);
+  snd_ctl_t* ctl = hctl ? snd_hctl_ctl(hctl) : nullptr;
+  const char* card = ctl ? snd_ctl_name(ctl) : nullptr;
+  return std::string(card ? card : "?") + "/" + std::to_string(snd_hctl_elem_get_device(elem));
+}
+
+bool CALSAHControlMonitor::EldNow(const std::string& key,
+                                  bool read,
+                                  const std::vector<uint8_t>& bytes)
+{
+  std::unique_lock lock(m_eldLock);
+  const auto it = m_elds.find(key);
+  if (it == m_elds.end())
+    return false; // (an ELD that the listing did not read: not as listed)
+  it->second.readable = it->second.readable && read;
+  it->second.now = bytes;
+  for (const auto& [eldKey, eld] : m_elds)
+  {
+    if (!eld.readable || eld.now != eld.listed)
+      return false;
+  }
+  return true;
+}
