+
+#pragma once
+
+namespace ActiveAE::INTERNAL
+{
+
+/*!
+ * \brief Hades: the device change events that came while the sink was suspended for a lost
+ *        display (AE_TOP_CONFIGURED_SUSPEND, between DISPLAYLOST and DISPLAYRESET), and whether the
+ *        outputs are listed again when the display is back
+ *
+ * A change of display mode takes the audio of an HDMI output away and brings it back: the driver
+ * clears the ELD of the output and sets it again, and ALSA tells both (CALSAHControlMonitor). Hades
+ * listed the outputs again at DISPLAYRESET after any such event (since 1.0 RC3: a listing read
+ * while the audio data were away had stayed, and the TV of 2026-10-21 got 5.1 PCM for a film). On
+ * the owner's RTX 4080 SUPER every video started that way: the ELD went away and came back with
+ * the same bytes, and the listing of every output of the PC took 530 to 550 ms, in which the audio
+ * stream could not be made. The video started without it, and its sound came 450 to 500 ms behind
+ * and was put back with that much left out: the first half second of every film was silent.
+ *
+ * Now an ELD event carries whether every ELD that the last listing read is back as it read it, by
+ * its bytes (CALSAHControlMonitor, as each event comes); the last one of them stands for all of
+ * them. The outputs are listed again when the display is back where any other device change came
+ * (the devices of a card, of a driver, the default device: their list itself may have changed), or
+ * where the last ELD event says that an ELD is not as listed (another display, other audio data,
+ * one still away: the event that brings it back comes later and is acted on as any other). Where
+ * the ELDs are all as they were listed, the listing would read the same: it is not made, and the
+ * sink is opened again on what was listed (the output the user chose, kept lit as it was: the
+ * listing that decided it is the one that stands).
+ *
+ * Pure: a test builds it on the host (TestActiveAESuspendedChanges.cpp).
+ */
+class CSuspendedChanges
+{
+public:
+  //! a device change event that is not of an ELD (or of an ELD without what its bytes are)
+  void Device() { m_device = true; }
+
+  //! an ELD event; asListed: every ELD read by the last listing is now as it was read
+  void Eld(bool asListed)
+  {
+    m_eld = true;
+    m_eldAsListed = asListed;
+  }
+
+  //! the outputs are listed again when the display is back
+  bool ListAgain() const { return m_device || (m_eld && !m_eldAsListed); }
+
+  //! only ELD events came, and they left every ELD as it was listed: the listing is not made
+  bool EldsBackAsListed() const { return !m_device && m_eld && m_eldAsListed; }
+
+  bool Any() const { return m_device || m_eld; }
+
+  //! the display is back: what came while it was away has been acted on
+  void Reset()
+  {
+    m_device = false;
+    m_eld = false;
+    m_eldAsListed = false;
+  }
+
+private:
+  bool m_device = false;
+  bool m_eld = false;
+  bool m_eldAsListed = false;
+};
+
+} // namespace ActiveAE::INTERNAL
