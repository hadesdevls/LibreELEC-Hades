+
+#include "cores/AudioEngine/Engines/ActiveAE/ActiveAESuspendedChanges.h"
+
+#include <gtest/gtest.h>
+
+using ActiveAE::INTERNAL::CSuspendedChanges;
+
+// The start of every video on the owner's RTX 4080 SUPER (1.2.3, start-52): the change of mode
+// cleared the ELD of the HDMI output and set it again, the same bytes. The outputs were listed again
+// (537 and 543 ms, the audio stream not made meanwhile); now they are not.
+TEST(TestActiveAESuspendedChanges, EldGoneAndBackAsListed)
+{
+  CSuspendedChanges changes;
+  changes.Eld(false); // cleared: not as listed
+  changes.Eld(true); // set again: every ELD as listed
+  EXPECT_FALSE(changes.ListAgain());
+  EXPECT_TRUE(changes.EldsBackAsListed());
+}
+
+// The ELD still away when the display is back: listed again (the event that brings it back comes
+// later and is acted on as any other)
+TEST(TestActiveAESuspendedChanges, EldStillAway)
+{
+  CSuspendedChanges changes;
+  changes.Eld(false);
+  EXPECT_TRUE(changes.ListAgain());
+  EXPECT_FALSE(changes.EldsBackAsListed());
+}
+
+// Another display, or other audio data (the TV of 2026-10-21, a receiver switched on): listed again
+TEST(TestActiveAESuspendedChanges, EldChanged)
+{
+  CSuspendedChanges changes;
+  changes.Eld(true);
+  changes.Eld(false);
+  EXPECT_TRUE(changes.ListAgain());
+}
+
+// Any other device change (a card, a driver, the default device): listed again, whatever the ELDs
+TEST(TestActiveAESuspendedChanges, OtherDeviceChange)
+{
+  CSuspendedChanges changes;
+  changes.Eld(true);
+  changes.Device();
+  EXPECT_TRUE(changes.ListAgain());
+  EXPECT_FALSE(changes.EldsBackAsListed());
+
+  CSuspendedChanges before;
+  before.Device();
+  before.Eld(true);
+  EXPECT_TRUE(before.ListAgain());
+}
+
+// Nothing came: nothing listed, and nothing said
+TEST(TestActiveAESuspendedChanges, Nothing)
+{
+  CSuspendedChanges changes;
+  EXPECT_FALSE(changes.ListAgain());
+  EXPECT_FALSE(changes.EldsBackAsListed());
+  EXPECT_FALSE(changes.Any());
+}
+
+// The display is back: what came is acted on and forgotten
+TEST(TestActiveAESuspendedChanges, Reset)
+{
+  CSuspendedChanges changes;
+  changes.Device();
+  changes.Eld(false);
+  changes.Reset();
+  EXPECT_FALSE(changes.Any());
+  EXPECT_FALSE(changes.ListAgain());
+  changes.Eld(true);
+  EXPECT_FALSE(changes.ListAgain());
+}
