From 93deb2abeddc0210014868ee3950144c3e91c9c5 Mon Sep 17 00:00:00 2001
From: Hades <15710513+hadesdevls@users.noreply.github.com>
Date: Tue, 24 Nov 2026 18:00:27 +0000
Subject: [PATCH] [Hades][GBM] The engine of native Dolby Vision reads as all
 automatic with its defaults

CDVEngineSettings had ipt true by default, from when the IPT tunnel was the
default transport; the setting's default is "as composed" since, so Resolve()
of the default settings gave false, and Automatic() never held: the log never
said "(all automatic)". The member now has the setting's default.
---
 xbmc/windowing/gbm/DVEngineSettings.h | 6 ++++--
 1 file changed, 4 insertions(+), 2 deletions(-)

diff --git a/xbmc/windowing/gbm/DVEngineSettings.h b/xbmc/windowing/gbm/DVEngineSettings.h
index 5834688..c988b8c 100644
--- a/xbmc/windowing/gbm/DVEngineSettings.h
+++ b/xbmc/windowing/gbm/DVEngineSettings.h
@@ -120,8 +120,10 @@ struct CDVEngineSettings
   bool ccmComposer = true;
   //! the pictures that the source transport covers go out so (else all converted)
   bool sourceTransport = true;
-  //! ... and those in YCbCr with the RGBtoLMS of BT.2020 (profiles 7 and 8) in IPT-PQ-c2
-  bool ipt = true;
+  //! ... and in IPT-PQ-c2 with the matrices of a licensed core. (Hades: false, as the setting is
+  //! by default; it was true, so that the settings as they are by default never read as
+  //! "all automatic" in the log.)
+  bool ipt = false;
   bool keepRepeats = true;
   //! the display is sent the trims of the metadata (levels 2 and 8, and 10, the targets of level
   //! 8): a setting of the Dolby Vision group (videoscreen.hadesdvnotrims), not of the engine, that
-- 
2.53.0

