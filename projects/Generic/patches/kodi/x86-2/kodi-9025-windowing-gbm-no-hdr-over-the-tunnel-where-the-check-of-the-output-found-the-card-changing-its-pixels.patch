+ */
+
+#pragma once
+
+#include <algorithm>
+#include <cstddef>
+#include <fstream>
+#include <iterator>
+#include <optional>
+#include <string>
+#include <string_view>
+#include <utility>
+#include <vector>
+
+namespace KODI::WINDOWING::GBM
+{
+
+/*!
+ * \brief Hades: what the last check of the Dolby Vision output (hades-output-check) said of the card
+ *
+ * The check (LibreELEC settings > System > Submit Log, "Check the Dolby Vision output") runs before
+ * Kodi starts, sets the kernel's tunnel on the HDMI output that has it, and measures with the card's
+ * own CRC of its output whether the card passes the bytes through unchanged. It writes its report
+ * to RESULT_FILE: "result: exact" or "result: not-exact", the device, driver and output it used, the
+ * kernel it ran on ("system:") and the parameters of that driver that decide the tunnel and its pipe
+ * ("parameters:", module.name=value). Where the card changes the bytes, nothing that goes over the
+ * tunnel reaches the display as Hades drew it: HDR over the tunnel (HDR10Tunnel.h) is not used on
+ * that output then, and the ordinary output, which works, carries the HDR video.
+ *
+ * Fail closed both ways: the report holds for the output only while the driver, the output, the
+ * kernel and each of those parameters are what they were when it was made (a new kernel or another
+ * value of a parameter may change the pipe: a new check is needed); a report without the kernel
+ * line (made before it said it) holds for nothing. A result other than "not-exact" leaves things as
+ * they are without the check. Pure but for the reading of files: a test runs it on the host.
+ */
+namespace OUTPUT_CHECK
+{
+
+inline constexpr const char* RESULT_FILE = "/storage/.cache/hades-output-check/result.txt";
+
+struct Report
+{
+  std::string result; //!< "exact", "not-exact", "not-judged", "unavailable", "ready"
+  std::string driver; //!< of "device: <node>, driver <name>, output <name>, ..."
+  std::string output;
+  std::optional<std::string> system; //!< "system: <release> <version>"
+  //! "parameters: module.name=value ...", in the order of the report
+  std::vector<std::pair<std::string, std::string>> parameters;
+};
+
+inline std::string_view TrimEnd(std::string_view s)
+{
+  while (!s.empty() && (s.back() == ' ' || s.back() == '\r' || s.back() == '\t'))
+    s.remove_suffix(1);
+  return s;
+}
+
+//! The text after "<key> " in a list of "key value, key value" ("driver amdgpu, output HDMI-A-1, ...")
+inline std::string FieldOf(std::string_view line, std::string_view key)
+{
+  const std::string marker = ", " + std::string(key) + " ";
+  const size_t at = line.find(marker);
+  if (at == std::string_view::npos)
+    return {};
+  std::string_view rest = line.substr(at + marker.size());
+  return std::string(TrimEnd(rest.substr(0, rest.find(','))));
+}
+
+inline Report Parse(std::string_view text)
+{
+  Report report;
+  bool resultSeen = false;
+  size_t pos = 0;
+  while (pos < text.size())
+  {
+    size_t end = text.find('\n', pos);
+    if (end == std::string_view::npos)
+      end = text.size();
+    const std::string_view line = TrimEnd(text.substr(pos, end - pos));
+    pos = end + 1;
+    if (!resultSeen && line.rfind("result: ", 0) == 0)
+    {
+      resultSeen = true;
+      report.result = std::string(line.substr(8));
+    }
+    else if (line.rfind("device: ", 0) == 0)
+    {
+      report.driver = FieldOf(line, "driver");
+      report.output = FieldOf(line, "output");
+    }
+    else if (line.rfind("system: ", 0) == 0)
+      report.system = std::string(line.substr(8));
+    else if (line.rfind("parameters:", 0) == 0)
+    {
+      std::string_view rest = line.substr(11);
+      while (!rest.empty())
+      {
+        const size_t start = rest.find_first_not_of(' ');
+        if (start == std::string_view::npos)
+          break;
+        rest.remove_prefix(start);
+        const size_t stop = std::min(rest.find(' '), rest.size());
+        const std::string_view token = rest.substr(0, stop);
+        rest.remove_prefix(stop);
+        const size_t eq = token.find('=');
+        if (eq != std::string_view::npos && eq > 0)
+          report.parameters.emplace_back(std::string(token.substr(0, eq)),
+                                         std::string(token.substr(eq + 1)));
+      }
+    }
+  }
+  return report;
+}
+
+enum class Verdict
+{
+  NONE, //!< no report
+  NOT_NOT_EXACT, //!< a report whose result is not "not-exact"
+  OTHER_OUTPUT, //!< made with another driver or output
+  OTHER_SYSTEM, //!< made with another kernel, or before the report said it
+  OTHER_PARAMETERS, //!< a parameter of the driver is not what it was
+  NOT_EXACT, //!< this card changes the bytes on this output, as things are now
+};
+
+//! What holds now, to compare the report with
+struct Now
+{
+  std::string driver;
+  std::string output;
+  std::string system;
+};
+
+/*!
+ * \param current the value of a parameter ("module.name") now, nothing where it cannot be read
+ */
+template<typename Lookup>
+Verdict Judge(const std::optional<Report>& report, const Now& now, Lookup&& current)
+{
+  if (!report || report->result.empty())
+    return Verdict::NONE;
+  if (report->result != "not-exact")
+    return Verdict::NOT_NOT_EXACT;
+  if (report->driver.empty() || report->driver != now.driver || report->output != now.output)
+    return Verdict::OTHER_OUTPUT;
+  if (!report->system || now.system.empty() || *report->system != now.system)
+    return Verdict::OTHER_SYSTEM;
+  for (const auto& [name, value] : report->parameters)
+  {
+    const std::optional<std::string> nowValue = current(name);
+    if (!nowValue || *nowValue != value)
+      return Verdict::OTHER_PARAMETERS;
+  }
+  return Verdict::NOT_EXACT;
+}
+
+//! What kodi.log says of a verdict, after "the last check of the Dolby Vision output"
+inline const char* Says(Verdict verdict)
+{
+  switch (verdict)
+  {
+    case Verdict::NONE:
+      return "was never made";
+    case Verdict::NOT_NOT_EXACT:
+      return "did not find that the card changes the pixels";
+    case Verdict::OTHER_OUTPUT:
+      return "said not-exact, for another output or driver: not taken for this one";
+    case Verdict::OTHER_SYSTEM:
+      return "said not-exact, with another kernel (or before the report named it): not taken; "
+             "a new check says how this one does";
+    case Verdict::OTHER_PARAMETERS:
+      return "said not-exact, with other values of the driver's parameters of the tunnel: not "
+             "taken; a new check says how these do";
+    case Verdict::NOT_EXACT:
+      return "said not-exact: this graphics card changes the pixels of the tunnel on their way out "
+             "on this output";
+  }
+  return "";
+}
+
+//! A small text file, whole (nothing where it cannot be read or is larger than limit)
+inline std::optional<std::string> ReadFile(const std::string& path, size_t limit = 65536)
+{
+  std::ifstream in(path, std::ios::binary);
+  if (!in)
+    return std::nullopt;
+  std::string text;
+  char buffer[4096];
+  while (in.read(buffer, sizeof(buffer)) || in.gcount() > 0)
+  {
+    text.append(buffer, static_cast<size_t>(in.gcount()));
+    if (text.size() > limit)
+      return std::nullopt;
+  }
+  return text;
+}
+
+inline std::string FirstLine(const std::string& path)
+{
+  const auto text = ReadFile(path, 4096);
+  if (!text)
+    return {};
+  return std::string(TrimEnd(std::string_view(*text).substr(0, text->find('\n'))));
+}
+
+//! The running kernel as the report names it ("system: <release> <version>")
+inline std::string SystemNow()
+{
+  const std::string release = FirstLine("/proc/sys/kernel/osrelease");
+  const std::string version = FirstLine("/proc/sys/kernel/version");
+  if (release.empty() && version.empty())
+    return {};
+  return release + " " + version;
+}
+
+//! A parameter of a module now ("amdgpu.dvbridge_dce": /sys/module/amdgpu/parameters/dvbridge_dce)
+inline std::optional<std::string> ParameterNow(const std::string& name)
+{
+  const size_t dot = name.find('.');
+  if (dot == std::string::npos || dot == 0 || dot + 1 >= name.size() ||
+      name.find('/') != std::string::npos)
+    return std::nullopt;
+  const auto text =
+      ReadFile("/sys/module/" + name.substr(0, dot) + "/parameters/" + name.substr(dot + 1), 4096);
+  if (!text)
+    return std::nullopt;
+  return std::string(TrimEnd(std::string_view(*text).substr(0, text->find('\n'))));
+}
+
+} // namespace OUTPUT_CHECK
+} // namespace KODI::WINDOWING::GBM
