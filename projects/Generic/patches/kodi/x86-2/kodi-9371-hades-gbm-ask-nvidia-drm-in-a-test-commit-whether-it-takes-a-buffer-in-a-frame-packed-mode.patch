From f5a3f32ef9cffc4c2c09b02b50760c454310be2b Mon Sep 17 00:00:00 2001
From: Hades <15710513+hadesdevls@users.noreply.github.com>
Date: Wed, 25 Nov 2026 19:26:15 +0000
Subject: [PATCH] [Hades][GBM] Ask nvidia-drm in a test commit whether it takes
 a buffer in a frame-packed mode

CDRMUtils::TestFramePacked(): whether the driver takes a buffer in the
selected HDMI 3D frame-packed mode of nvidia-drm (FramePackedByOffsets(),
now public), asked in a commit with DRM_MODE_ATOMIC_TEST_ONLY: a copy of
the request that the next commit carries, with the mode (the connector on
the CRTC, MODE_ID, ACTIVE) and the buffer on the output plane as that
commit sets them (the frame of both eyes, ScanoutHeight() lines), the
rotation where the frames say it, and no fence. Nothing changes on the
output. Only CDRMAtomic asks; nothing is answered for another mode or
driver, for an output that is meant to be off, or where the request
cannot be made, and a buffer of which no framebuffer of the kernel can
be made is refused, with the error of the kernel.

nvidia-drm refuses, in a 2D mode as in a frame-packed one, a framebuffer
that has no NVKMS surface, which is one whose memory is not video memory
(nvidia-drm-fb.c, nv_drm_framebuffer_init(); nvidia-drm-crtc.c,
plane_req_config_update()). The next commit asks this of the window's
buffer of a frame-packed mode, and of Kodi's own where it refuses that
one (issue #33).
---
 xbmc/windowing/gbm/drm/DRMAtomic.cpp | 60 ++++++++++++++++++++++++++++
 xbmc/windowing/gbm/drm/DRMAtomic.h   |  1 +
 xbmc/windowing/gbm/drm/DRMUtils.h    | 19 +++++++--
 3 files changed, 77 insertions(+), 3 deletions(-)

diff --git a/xbmc/windowing/gbm/drm/DRMAtomic.cpp b/xbmc/windowing/gbm/drm/DRMAtomic.cpp
index 11b3cdd..085f5f6 100644
--- a/xbmc/windowing/gbm/drm/DRMAtomic.cpp
+++ b/xbmc/windowing/gbm/drm/DRMAtomic.cpp
@@ -1233,6 +1233,66 @@ bool CDRMAtomic::TestFramebuffer(struct gbm_bo* bo)
   return true;
 }
 
+std::optional<bool> CDRMAtomic::TestFramePacked(struct gbm_bo* bo, std::string& why)
+{
+  // Hades: (issue #33, FramePackedOwn.h) only a frame-packed mode of nvidia-drm is asked, and only
+  // while the output is meant to be on: a mode that is not lit shows no buffer
+  CDRMPlane* plane = m_gui_plane ? m_gui_plane : m_video_plane;
+  if (!FramePackedByOffsets() || !bo || !plane || !m_crtc || !m_connector || !m_mode || !m_active)
+    return std::nullopt;
+  struct drm_fb* fb = DrmFbGetFromBo(bo);
+  if (!fb)
+  {
+    why = std::string("no framebuffer of the kernel could be made of it: ") + strerror(errno);
+    return false;
+  }
+  CDRMPropertyBlob mode(m_fd, m_mode, sizeof(*m_mode));
+  if (!mode.IsValid())
+    return std::nullopt;
+
+  // What the next commit carries (the request that is being made, which a commit of the mode takes
+  // with it: CDRMAtomic::DrmAtomicCommit()), on a copy, with the mode and the buffer as that commit
+  // sets them; a property that a request names twice goes with the value it was added with last
+  // (drmModeAtomicCommit()). No fence: those are of a commit, not of a test.
+  std::unique_ptr<drmModeAtomicReq, AtomicReqFree> request(
+      m_req ? drmModeAtomicDuplicate(m_req->Get()) : drmModeAtomicAlloc());
+  if (!request)
+    return std::nullopt;
+  bool made = true;
+  const auto add = [&](CDRMObject* object, const char* name, uint64_t value)
+  {
+    const uint32_t id = object->GetPropertyId(name);
+    made = made && id && drmModeAtomicAddProperty(request.get(), object->GetId(), id, value) >= 0;
+  };
+  add(m_connector, "CRTC_ID", m_crtc->GetCrtcId());
+  add(m_crtc, "MODE_ID", mode.Get());
+  add(m_crtc, "ACTIVE", 1);
+  add(plane, "FB_ID", fb->fb_id);
+  add(plane, "CRTC_ID", m_crtc->GetCrtcId());
+  add(plane, "SRC_X", 0);
+  add(plane, "SRC_Y", 0);
+  add(plane, "SRC_W", static_cast<uint64_t>(m_width) << 16);
+  add(plane, "SRC_H", static_cast<uint64_t>(m_height) << 16);
+  add(plane, "CRTC_X", 0);
+  add(plane, "CRTC_Y", 0);
+  add(plane, "CRTC_W", m_mode->hdisplay);
+  add(plane, "CRTC_H", ScanoutHeight());
+  if (m_reflectSaid && plane->SupportsProperty("rotation"))
+    add(plane, "rotation", PlaneRotation());
+  if (plane->SupportsProperty("IN_FENCE_FD"))
+    add(plane, "IN_FENCE_FD", static_cast<uint64_t>(-1));
+  if (m_crtc->SupportsProperty("OUT_FENCE_PTR"))
+    add(m_crtc, "OUT_FENCE_PTR", 0);
+  if (!made)
+    return std::nullopt;
+
+  if (drmModeAtomicCommit(m_fd, request.get(),
+                          DRM_MODE_ATOMIC_TEST_ONLY | DRM_MODE_ATOMIC_ALLOW_MODESET, nullptr) == 0)
+    return true;
+  why = strerror(errno);
+  return false;
+}
+
 bool CDRMAtomic::TestOutputMove(const OutputMove& move, struct gbm_bo* bo, std::string& why)
 {
   struct drm_fb* fb = bo ? DrmFbGetFromBo(bo) : nullptr;
diff --git a/xbmc/windowing/gbm/drm/DRMAtomic.h b/xbmc/windowing/gbm/drm/DRMAtomic.h
index 247e2fd..c78ae9b 100644
--- a/xbmc/windowing/gbm/drm/DRMAtomic.h
+++ b/xbmc/windowing/gbm/drm/DRMAtomic.h
@@ -58,6 +58,7 @@ public:
   // does not wait.
   bool FlipPageTransactional(struct gbm_bo* bo, bool modeset, bool* ahead = nullptr);
   bool TestFramebuffer(struct gbm_bo* bo) override;
+  std::optional<bool> TestFramePacked(struct gbm_bo* bo, std::string& why) override;
   //! Hades: a frame alone, in a request of its own: this buffer on the output plane, as every
   //! frame sets it, and nothing else. What is queued, and a modeset that is pending, stay for the
   //! next commit. The commit waits for its flip. False when it cannot be made, or the driver
diff --git a/xbmc/windowing/gbm/drm/DRMUtils.h b/xbmc/windowing/gbm/drm/DRMUtils.h
index 6e1b9ad..210be6d 100644
--- a/xbmc/windowing/gbm/drm/DRMUtils.h
+++ b/xbmc/windowing/gbm/drm/DRMUtils.h
@@ -317,6 +317,22 @@ public:
   //!        size, pitch, modifier and where the second eye begins; empty where nothing is asked
   //!        (FramePackedBufferDemands())
   std::string DescribeFramePackedBuffer(struct gbm_bo* bo) const;
+  //! \brief The selected mode is frame packed, and the driver makes the eyes out of the lines of
+  //!        the one buffer (nvidia-drm; see FramePackedBufferDemands()). The mode is looked at
+  //!        first: no other mode asks the driver for its name.
+  bool FramePackedByOffsets() const;
+  /*!
+   * \brief Hades: whether the driver takes this buffer in the selected frame-packed mode
+   *        (FramePackedByOffsets()), asked in a test commit of that mode with what the next
+   *        commit carries; nothing changes on the output (issue #33, FramePackedOwn.h)
+   * \param[out] why what the driver answered, where it refused it
+   * \return nothing where it cannot be asked: another mode or driver, an output that is off,
+   *         no atomic modesetting
+   */
+  virtual std::optional<bool> TestFramePacked(struct gbm_bo* bo, std::string& why)
+  {
+    return std::nullopt;
+  }
 
   void SetInFenceFd(int fd) { m_inFenceFd = fd; }
   //! Hades: the out-fence of the last commit, still Kodi's (TakeOutFenceFd() takes it); -1: none
@@ -467,9 +483,6 @@ protected:
   std::optional<bool> m_moveResult;
 
 private:
-  //! The selected mode is frame packed, and the driver makes the eyes out of the lines of the
-  //! one buffer (see FramePackedBufferDemands())
-  bool FramePackedByOffsets() const;
   bool FindConnector();
   bool FindEncoder();
   bool FindCrtc();
