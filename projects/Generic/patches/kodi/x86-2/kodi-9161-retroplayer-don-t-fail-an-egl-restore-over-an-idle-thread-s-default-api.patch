From 6c88495c5aeb6c4a14b09d1b4f0672317e9ea138 Mon Sep 17 00:00:00 2001
From: Chris <meischris39@hotmail.com>
Date: Tue, 10 Nov 2026 03:47:10 +0000
Subject: [PATCH] RetroPlayer: don't fail an EGL restore over an idle thread's
 default API

On a thread that never bound an EGL API, glvnd reports OpenGL ES even
when no driver supports it, as with LibreELEC's desktop GL Mesa build.
Binding that back after the first frame failed with EGL_BAD_PARAMETER,
so every hardware-rendered game logged a restore error once. With no
previous context there is nothing to restore but the release.

(cherry picked from commit 9bdc6c429cacdaf76e6e4e1cd5274d41a02671f9)
---
 .../rendering/contexts/EGLClientContext.cpp       | 10 ++++++----
 .../rendering/test/TestHwRenderingContextEGL.cpp  | 15 +++++++++++++++
 2 files changed, 21 insertions(+), 4 deletions(-)

diff --git a/xbmc/cores/RetroPlayer/rendering/contexts/EGLClientContext.cpp b/xbmc/cores/RetroPlayer/rendering/contexts/EGLClientContext.cpp
index c568d6b..0efdf01 100644
--- a/xbmc/cores/RetroPlayer/rendering/contexts/EGLClientContext.cpp
+++ b/xbmc/cores/RetroPlayer/rendering/contexts/EGLClientContext.cpp
@@ -108,11 +108,13 @@ bool CEGLClientContext::RestoreCurrent()
 
   if (m_prevAPI != m_api)
     ReleaseCurrent();
+  // glvnd reports OpenGL ES for a thread that never bound an API, even when no driver supports
+  // it. With no previous context to restore, failing to bind that back leaves nothing wrong.
+  const bool apiRestored = m_egl.bindAPI(m_prevAPI) == EGL_TRUE;
   const bool restored =
-      m_egl.bindAPI(m_prevAPI) &&
-      (m_prevContext != EGL_NO_CONTEXT
-           ? m_egl.makeCurrent(m_prevDisplay, m_prevDraw, m_prevRead, m_prevContext)
-           : m_egl.makeCurrent(m_display, EGL_NO_SURFACE, EGL_NO_SURFACE, EGL_NO_CONTEXT));
+      m_prevContext != EGL_NO_CONTEXT
+          ? apiRestored && m_egl.makeCurrent(m_prevDisplay, m_prevDraw, m_prevRead, m_prevContext)
+          : m_egl.makeCurrent(m_display, EGL_NO_SURFACE, EGL_NO_SURFACE, EGL_NO_CONTEXT);
   if (!restored)
   {
     CLog::Log(LOGERROR, "RetroPlayer[RENDER]: Failed to restore EGL context (error {:#x})",
diff --git a/xbmc/cores/RetroPlayer/rendering/test/TestHwRenderingContextEGL.cpp b/xbmc/cores/RetroPlayer/rendering/test/TestHwRenderingContextEGL.cpp
index c07a664..0138acc 100644
--- a/xbmc/cores/RetroPlayer/rendering/test/TestHwRenderingContextEGL.cpp
+++ b/xbmc/cores/RetroPlayer/rendering/test/TestHwRenderingContextEGL.cpp
@@ -340,6 +340,7 @@ struct FakeEGL
   EGLContext clientContext{reinterpret_cast<EGLContext>(6)};
   bool failSurface{false}, failContext{false}, failBind{false}, failRestore{false};
   bool failDestroy{false}, failUnbind{false};
+  EGLenum unsupportedAPI{EGL_NONE};
   EGLConfig failSurfaceConfig{}, failContextConfig{};
   int surfaces{0}, contexts{0}, releases{0};
   std::vector<char> destroyed;
@@ -352,6 +353,8 @@ struct FakeEGL
         []() -> EGLenum { return current->api; },
         [](EGLenum api) -> EGLBoolean
         {
+          if (api == current->unsupportedAPI)
+            return EGL_FALSE;
           current->api = api;
           return EGL_TRUE;
         },
@@ -621,6 +624,18 @@ TEST_F(TestEGLClientContext, ThreadWithoutPreviousContextIsUnboundAfterRestore)
   EXPECT_EQ(egl.api, EGL_OPENGL_API);
 }
 
+TEST_F(TestEGLClientContext, UnsupportedDefaultAPIOfIdleThreadDoesNotFailRestore)
+{
+  egl.context = EGL_NO_CONTEXT;
+  egl.display = EGL_NO_DISPLAY;
+  egl.draw = egl.read = EGL_NO_SURFACE;
+  ASSERT_TRUE(Create());
+  egl.unsupportedAPI = EGL_OPENGL_API;
+  ASSERT_TRUE(client.MakeCurrent());
+  EXPECT_TRUE(client.RestoreCurrent());
+  EXPECT_EQ(egl.context, EGL_NO_CONTEXT);
+}
+
 TEST_F(TestEGLClientContext, InvalidSharedContextNeverCreatesSurface)
 {
   const EGLint attributes[]{EGL_NONE};
-- 
2.53.0

