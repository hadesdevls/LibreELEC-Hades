From 7acaab2df3a2d3db453f963966c9f8d34779f6db Mon Sep 17 00:00:00 2001
From: Hades <15710513+hadesdevls@users.noreply.github.com>
Date: Thu, 19 Nov 2026 18:31:14 +0000
Subject: [PATCH] [Hades][GBM] A video at its own rate in the mode of its size
 keeps it when Kodi asks again

With "Adjust display resolution" and "Video at its own rate with VRR" at
"Where the display has no mode at the video's rate", a 1080p film at 23.976
fps on a monitor without modes at the rate of films (a Samsung Odyssey G60SD,
menus at 2560x1440 at 359.999 Hz) went to 1920x1080 at 359.986 Hz with VRR
when it opened. Kodi asks again once its first picture comes
(CRenderManager::GetResolution()), from the mode on the output; from 1920x1080
its whitelist takes the 3:2 pulldown of 1920x1080 at 59.940 Hz, which is not
the mode of the menus, so VRR_VIDEO::Automatic() said no: the film went out at
59.940 Hz with a fixed refresh and 3:2 pulldown, after a second change of mode.

VRR_VIDEO::KodiStays(): Kodi's choice counts as the mode of the menus also
where the video goes in the mode of its size (VIDEO_SIZE::ChooseForVrr()) and
the output is in that mode now, so that the second answer is the first one.
Nothing else changes: without a mode of the video's size, or with the output in
another mode, only the menus count, as before; "Always" asks before Kodi's
choice and is not touched; with VRR off the size stays (the monitor has no
1920x1080 within 0.01 Hz of 359.999 Hz).
---
 xbmc/windowing/gbm/VrrVideo.h       | 16 ++++++++++++++++
 xbmc/windowing/gbm/WinSystemGbm.cpp |  6 +++++-
 2 files changed, 21 insertions(+), 1 deletion(-)

diff --git a/xbmc/windowing/gbm/VrrVideo.h b/xbmc/windowing/gbm/VrrVideo.h
index b71649b..1ee2541 100644
--- a/xbmc/windowing/gbm/VrrVideo.h
+++ b/xbmc/windowing/gbm/VrrVideo.h
@@ -235,6 +235,22 @@ inline bool Automatic(bool setting, bool kodiStays, double menusRefresh, double
   return setting && kodiStays && !hasMode && !WholeMultipleOf(menusRefresh, fps);
 }
 
+/*!
+ * \brief Whether Kodi's choice counts as staying in the mode of the menus for Automatic() (kodiStays):
+ *        it is the mode of the menus, or the video goes at its own rate in the mode of its size
+ *        ("Adjust display resolution", VIDEO_SIZE::ChooseForVrr()) and the output is in that mode now.
+ *        Kodi asks again once the first picture comes (CRenderManager::GetResolution()), from the mode
+ *        on the output: from 1920x1080 at 359.986 Hz, on a monitor without modes at the rate of films
+ *        (a Samsung Odyssey G60SD), its whitelist takes the 3:2 pulldown of 1920x1080 at 59.940 Hz,
+ *        which is not the mode of the menus. Asked from the menus, the answer was VRR in the mode of
+ *        the video's size; asked again, it was 1920x1080 at 59.940 Hz with a fixed refresh, a second
+ *        change of mode, and 3:2 pulldown. Now the second answer is the first one.
+ */
+constexpr bool KodiStays(bool choiceIsMenus, bool sizedMode, bool outputInSizedMode)
+{
+  return choiceIsMenus || (sizedMode && outputInSizedMode);
+}
+
 /*!
  * \brief Whether CResolutionUtils::ChooseBestResolution() asks again after Kodi's choice (Automatic()):
  *        never for native Dolby Vision, whose mode is its transport mode at the rate Kodi chose
diff --git a/xbmc/windowing/gbm/WinSystemGbm.cpp b/xbmc/windowing/gbm/WinSystemGbm.cpp
index d979ad3..fd26465 100644
--- a/xbmc/windowing/gbm/WinSystemGbm.cpp
+++ b/xbmc/windowing/gbm/WinSystemGbm.cpp
@@ -4418,7 +4418,11 @@ bool CWinSystemGbm::TakeVideoAtOwnRate(float fps,
   // the video's rate at any resolution (Automatic()); "Always" takes any display (Decide())
   const std::vector<double> refreshes = DisplayRefreshes();
   const bool hasMode = DisplayHasModeFor(refreshes, fps);
-  if (automatic && !Automatic(true, gui == menus, menusInfo.fRefreshRate, fps, hasMode))
+  // (Kodi's choice from the mode of the video's size, where a first answer put the output: KodiStays())
+  const bool kodiStays =
+      KodiStays(gui == menus, sized > RES_INVALID,
+                sized > RES_INVALID && GetGfxContext().GetVideoResolution() == sized);
+  if (automatic && !Automatic(true, kodiStays, menusInfo.fRefreshRate, fps, hasMode))
   {
     bool tellMode = false;
     {
