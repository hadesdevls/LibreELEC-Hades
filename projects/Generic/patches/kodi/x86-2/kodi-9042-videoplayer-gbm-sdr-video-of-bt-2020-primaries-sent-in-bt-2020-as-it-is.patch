+
+#pragma once
+
+extern "C"
+{
+#include <libavutil/pixfmt.h>
+}
+
+#include <algorithm>
+#include <array>
+#include <cmath>
+
+namespace KODI
+{
+namespace UTILS
+{
+namespace SDRWIDE
+{
+
+/*!
+ * \brief Hades: an SDR video whose primaries are BT.2020 sent in BT.2020 as it is
+ *        (videoscreen.hadessdrbt2020, off by default)
+ *
+ * Without HDR passed through, Kodi's renderer draws every picture in BT.709: an SDR video of
+ * BT.2020 primaries (a few Ultra HD Blu-rays, some streams) is converted, and its colours outside
+ * BT.709 are clipped (CLinuxRendererGLES::LoadShaders(); the display is told BT.709,
+ * KODI::UTILS::DrawnColorSpace()). To send it as it is, the display must be told BT.2020 (the
+ * Colorspace property of the connector, BT2020_RGB in the AVI InfoFrame: only where the EDID
+ * declares BT2020_RGB and the driver offers it), and whatever is drawn over the picture must be in
+ * BT.2020 too: Kodi's GUI and its subtitles are made in sRGB, of BT.709 primaries, and taken as
+ * BT.2020 they would be shown too saturated (a yellow subtitle drawn towards green). So the GUI is
+ * drawn into the FBO of the GUI composite and converted over the picture by the composite
+ * (gles_gui_composite.frag, its SDR mode), as it is for HDR.
+ *
+ * The conversion is that of ITU-R BT.2087 case #1, made to keep the colours that a BT.709 display
+ * shows on a BT.2020 display: the non-linear signal to linear light by the reference EOTF of ITU-R
+ * BT.1886 (L_B = 0: E = E'^2.40), the BT.709 to BT.2020 matrix in linear light, and back by its
+ * inverse. An SDR display applies its own EOTF to both, so what it shows of the GUI is what it
+ * showed in BT.709. Grey stays grey (the rows of the matrix sum to 1): white, black and every grey
+ * of the GUI are the codes they are without the setting. The GUI is mixed over the picture as Kodi
+ * mixes it in SDR, in the non-linear signal by its coverage: the FBO holds the GUI's colour
+ * premultiplied by its coverage (the blend functions of the GUI: CGUITextureGLES::DrawQuad(),
+ * CGUIFontTTFGLES), which is divided out, converted and mixed (not the squared alpha that the
+ * composite into PQ and HLG uses).
+ */
+
+//! ITU-R BT.2087: BT.709 to BT.2020 in linear light, by rows of BT.2020's R, G and B (the same
+//! numbers as gles_gui_composite.frag, which has them by columns)
+constexpr std::array<std::array<double, 3>, 3> BT709_TO_BT2020{{
+    {0.627403896, 0.329283038, 0.043313066},
+    {0.069097289, 0.919540395, 0.011362316},
+    {0.016391439, 0.088013308, 0.895595253},
+}};
+
+//! The exponent of the reference EOTF of ITU-R BT.1886 with a black of 0 (BT.2087 case #1)
+constexpr double BT1886_GAMMA = 2.40;
+
+//! A colour of the GUI (the non-linear signal of BT.709, 0 to 1) in BT.2020, as the SDR mode of
+//! the composite converts it
+inline std::array<double, 3> ToBt2020(const std::array<double, 3>& colour)
+{
+  std::array<double, 3> linear{};
+  for (int i = 0; i < 3; ++i)
+    linear[i] = std::pow(std::clamp(colour[i], 0.0, 1.0), BT1886_GAMMA);
+  std::array<double, 3> out{};
+  for (int r = 0; r < 3; ++r)
+  {
+    double v = 0.0;
+    for (int c = 0; c < 3; ++c)
+      v += BT709_TO_BT2020[r][c] * linear[c];
+    out[r] = std::pow(std::max(v, 0.0), 1.0 / BT1886_GAMMA);
+  }
+  return out;
+}
+
+//! A pixel of the SDR mode of the composite: the FBO's colour (premultiplied by its coverage) and
+//! coverage, over the picture's pixel; all of them the non-linear signal, 0 to 1. A coverage of 0
+//! leaves the picture (the composite discards such a pixel).
+inline std::array<double, 3> Composite(const std::array<double, 3>& premultiplied,
+                                       double coverage,
+                                       const std::array<double, 3>& picture)
+{
+  if (coverage <= 0.0)
+    return picture;
+  std::array<double, 3> colour{};
+  for (int i = 0; i < 3; ++i)
+    colour[i] = std::clamp(premultiplied[i] / coverage, 0.0, 1.0);
+  const std::array<double, 3> wide = ToBt2020(colour);
+  std::array<double, 3> out{};
+  for (int i = 0; i < 3; ++i)
+    out[i] = wide[i] * coverage + picture[i] * (1.0 - coverage);
+  return out;
+}
+
+//! Whether the setting is about a picture: SDR (not PQ, not HLG) of BT.2020 primaries
+constexpr bool Candidate(int primaries, int transfer)
+{
+  return primaries == AVCOL_PRI_BT2020 && transfer != AVCOL_TRC_SMPTE2084 &&
+         transfer != AVCOL_TRC_ARIB_STD_B67;
+}
+
+//! Why such a picture is drawn in BT.709, as without the setting
+enum class Why
+{
+  NONE, //!< it goes out in BT.2020
+  SETTING, //!< the setting is off
+  DOLBY_VISION, //!< native Dolby Vision output, or its menus, hold the output
+  STEREO, //!< a 3D output
+  DISPLAY, //!< the EDID does not declare BT2020_RGB
+  DRIVER, //!< the connector has no Colorspace property with BT2020_RGB
+};
+
+//! What the window system knows when a renderer asks for it
+struct Facts
+{
+  bool setting = false; //!< videoscreen.hadessdrbt2020
+  //! advancedsettings.xml <video><sdrbt2020test>: for a test where the display or the driver
+  //! cannot take it (a virtual GPU): neither is asked, and the display is told nothing
+  bool test = false;
+  bool display = false; //!< the EDID declares BT2020_RGB (its CTA colorimetry data block)
+  bool driver = false; //!< the connector has Colorspace, with the value BT2020_RGB
+  bool nativeDV = false; //!< native Dolby Vision output, or its menus, hold the output
+  bool stereo = false; //!< the output is in a 3D mode
+};
+
+constexpr Why Check(const Facts& f)
+{
+  if (!f.setting)
+    return Why::SETTING;
+  if (f.nativeDV)
+    return Why::DOLBY_VISION;
+  if (f.stereo)
+    return Why::STEREO;
+  if (f.test)
+    return Why::NONE;
+  if (!f.display)
+    return Why::DISPLAY;
+  if (!f.driver)
+    return Why::DRIVER;
+  return Why::NONE;
+}
+
+constexpr const char* Text(Why why)
+{
+  switch (why)
+  {
+    case Why::NONE:
+      return "it goes out in BT.2020";
+    case Why::SETTING:
+      return "the setting \"Keep the wide colours of SDR videos (BT.2020)\" is off "
+             "(videoscreen.hadessdrbt2020)";
+    case Why::DOLBY_VISION:
+      return "native Dolby Vision output holds the output";
+    case Why::STEREO:
+      return "the output is in a 3D mode";
+    case Why::DISPLAY:
+      return "the display does not declare BT.2020 RGB in its EDID (CTA colorimetry data block)";
+    case Why::DRIVER:
+      return "the driver offers no BT2020_RGB for the Colorspace of this connector";
+  }
+  return "unknown";
+}
+
+} // namespace SDRWIDE
+} // namespace UTILS
+} // namespace KODI
