             inferred ? " (inferred)" : "", picture.colorBits,
             picture.color_range == 1 ? "full" : "limited");
   m_format = picture.videoBuffer->GetFormat();
+  // Hades: SDR in BT.2020 is decided again for this configuration (SdrWideConfigure()); a native
+  // Dolby Vision output, which returns before that, has the GUI composite set up for itself
+  const bool sdrWideWas = std::exchange(m_sdrWide, false);
 #ifdef HAVE_DVBRIDGE
   // Hades: the line of the log on the HDR10+ tone curve, once a video (TellHdr10Plus())
   m_hdr10PlusTold = false;
@@ -515,9 +521,65 @@ bool CLinuxRendererGLES::Configure(const VideoPicture &picture, float fps, unsig
     CLog::Log(LOGWARNING, "LinuxRendererGLES::Configure: HDR passthrough active but GUI "
                           "compositing not supported by windowing system");
 
+  // Hades: an SDR picture of BT.2020 primaries that goes out as Kodi's ordinary output (not one
+  // rebuilt from Dolby Vision or mapped by the bridge, which is another picture) may go out in
+  // BT.2020 as it is (KODI::UTILS::SDRWIDE)
+#ifdef HAVE_DVBRIDGE
+  const bool ordinaryOutput = !convert && !plain;
+#else
+  const bool ordinaryOutput = true;
+#endif
+  SdrWideConfigure(picture, ordinaryOutput && !m_passthroughHDR && !m_hdrFboActive, sdrWideWas);
+
   return true;
 }
 
+AVColorPrimaries CLinuxRendererGLES::DrawnPrimaries() const
+{
+  return m_passthroughHDR || m_sdrWide ? m_srcPrimaries : AVColorPrimaries::AVCOL_PRI_BT709;
+}
+
+void CLinuxRendererGLES::SdrWideConfigure(const VideoPicture& picture, bool ordinary, bool wasOn)
+{
+  m_sdrWide = false;
+  if (ordinary &&
+      KODI::UTILS::SDRWIDE::Candidate(picture.color_primaries, picture.color_transfer))
+  {
+    const std::string why = CServiceBroker::GetWinSystem()->SetSdrWide(&picture);
+    m_sdrWide = why.empty();
+    if (m_sdrWide)
+      CLog::Log(LOGINFO,
+                "SDR in BT.2020: this video ({}x{}, SDR of BT.2020 primaries) goes out in BT.2020 "
+                "as it is: drawn in its own primaries, the display told BT.2020, and the GUI and "
+                "the subtitles converted to BT.2020 over it (ITU-R BT.2087)",
+                picture.iWidth, picture.iHeight);
+    else
+      CLog::Log(LOGINFO,
+                "SDR in BT.2020: this video ({}x{}, SDR of BT.2020 primaries) is drawn in BT.709, "
+                "as Kodi draws it: {}",
+                picture.iWidth, picture.iHeight, why);
+  }
+  // the composite of the configuration before ends, where this one does not take it over
+  if (wasOn && !m_sdrWide && !m_hdrFboActive)
+    CServiceBroker::GetWinSystem()->SetSdrWide(nullptr);
+}
+
+void CLinuxRendererGLES::SdrWideEnd(const char* why, AVColorSpace colSpace)
+{
+  m_sdrWide = false;
+  m_reloadShaders = true;
+  CServiceBroker::GetWinSystem()->SetSdrWide(nullptr);
+  VideoPicture drawn{};
+  drawn.color_space = KODI::UTILS::DrawnColorSpace(colSpace, m_passthroughHDR);
+  drawn.iWidth = m_sourceWidth;
+  drawn.iHeight = m_sourceHeight;
+  CServiceBroker::GetWinSystem()->SetColorimetry(&drawn);
+  CLog::Log(LOGWARNING,
+            "SDR in BT.2020: {}: the video is drawn in BT.709 from the next frame, and the display "
+            "is told so",
+            why);
+}
