+bool CWinSystemGbm::DisplayDeclaresBt2020Rgb() const
+{
+  const auto info = DisplayInfo();
+  return info && info->SupportsColorimetry(KODI::UTILS::Colorimetry::BT2020_RGB);
+}
+
+bool CWinSystemGbm::ConnectorOffersBt2020Rgb() const
+{
+  // (atomic modesetting, which SetColorimetry() needs to tell the display)
+  auto drm = std::dynamic_pointer_cast<CDRMAtomic>(m_DRM);
+  CDRMConnector* connector = drm ? drm->GetConnector() : nullptr;
+  return connector && connector->SupportsProperty("Colorspace") &&
+         connector->GetPropertyEnumValue("Colorspace", "BT2020_RGB").has_value();
+}
