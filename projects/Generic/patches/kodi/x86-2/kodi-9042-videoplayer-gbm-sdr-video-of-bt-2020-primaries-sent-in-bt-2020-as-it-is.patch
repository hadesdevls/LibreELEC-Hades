+std::string CWinSystemGbmGLESContext::SetSdrWide(const VideoPicture* picture)
+{
+  namespace SDRWIDE = KODI::UTILS::SDRWIDE;
+  if (!picture)
+  {
+    if (m_guiCompositing && m_compositeSdrWide)
+      SetGuiCompositing(0);
+    return {};
+  }
+
+  SDRWIDE::Facts f;
+  const auto component = CServiceBroker::GetSettingsComponent();
+  const auto settings = component ? component->GetSettings() : nullptr;
+  f.setting = settings && settings->GetBool(CSettings::SETTING_VIDEOSCREEN_HADESSDRBT2020);
+  const auto advanced = component ? component->GetAdvancedSettings() : nullptr;
+  f.test = advanced && advanced->m_videoSdrBt2020Test;
+  f.display = DisplayDeclaresBt2020Rgb();
+  f.driver = ConnectorOffersBt2020Rgb();
+#ifdef HAVE_DVBRIDGE
+  f.nativeDV = m_outputHandover.HoldsOutput() || m_dvMenus;
+#endif
+  f.stereo = GetGfxContext().GetStereoMode() != RenderStereoMode::OFF;
+
+  const SDRWIDE::Why why = SDRWIDE::Check(f);
+  if (why != SDRWIDE::Why::NONE)
+    return SDRWIDE::Text(why);
+  if (!SetGuiCompositing(CGuiCompositeShaderGLES::SDR_BT2020))
+    return "the GUI composite into BT.2020 could not be set up (the line of the log before says why)";
+  // the display is told BT.2020 (GetColorimetry(): BT2020_YCC, sent as BT2020_RGB: Kodi scans out
+  // RGB), where the driver can tell it (a test may go on without)
+  if (f.driver)
+  {
+    VideoPicture told{};
+    told.color_space = AVCOL_SPC_BT2020_NCL;
+    told.iWidth = picture->iWidth;
+    told.iHeight = picture->iHeight;
+    SetColorimetry(&told);
+  }
+  if (f.test)
+    CLog::Log(LOGWARNING,
+              "SDR in BT.2020: for a test (advancedsettings.xml <video><sdrbt2020test>): the "
+              "display ({}) and the driver ({}) were not asked{}",
+              f.display ? "declares BT.2020 RGB" : "does not declare BT.2020 RGB",
+              f.driver ? "offers BT2020_RGB" : "offers no BT2020_RGB",
+              f.driver ? "" : ", and the display is told nothing");
+  return {};
+}
