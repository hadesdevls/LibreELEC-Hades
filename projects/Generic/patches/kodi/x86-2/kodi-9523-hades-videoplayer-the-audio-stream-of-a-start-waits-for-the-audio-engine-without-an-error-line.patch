From 0efbfce430a33180581a165b7666541c84e26960 Mon Sep 17 00:00:00 2001
From: Hades <15710513+hadesdevls@users.noreply.github.com>
Date: Fri, 27 Nov 2026 07:05:10 +0000
Subject: [PATCH] [Hades][VideoPlayer] The audio stream of a start waits for
 the audio engine without an error line

At every start of a video that changes the display mode kodi.log had
"CVideoPlayerAudio: display reset occurred, checking for passthrough",
"Creating audio stream (... pass-through)" and "error
ProcessDecoderOutput - failed to create audio renderer", and the sound
came all the same, a retry later (also in 1.1).

After the reset of the display the audio engine is suspended while it
lists its outputs again (the ELD of the HDMI output changed with the
mode) and opens its sink: about half a second ("ActiveAE - the outputs
changed while the display was being reset: they are listed again",
00:04:43.005, its sink open at 00:04:43.557). MakeStream() refuses a
stream meanwhile (IsSuspended()), and VideoPlayerAudio tried again
500 ms later: no fault, and an ERROR line that was none. The stream of
a start came up to 500 ms after the engine was back, and the engine
then left that much more of the sound out to put it in sync with the
video (TrueHD 935 ms behind, 46 packets; E-AC-3 938 ms, 29 packets).

Where the engine is suspended, the stream is tried again every 25 ms
(OUTPUT_RETRY_SUSPENDED: MakeStream() refuses it at once, without a
message to the engine) and made as soon as the engine is back; kodi.log
says once that the engine is setting its outputs up again, and how long
after the first try the stream was made. A failure of an engine that is
not suspended is the error it was.
---
 xbmc/cores/VideoPlayer/VideoPlayerAudio.cpp | 29 +++++++++++++++++++--
 xbmc/cores/VideoPlayer/VideoPlayerAudio.h   |  3 +++
 2 files changed, 30 insertions(+), 2 deletions(-)

diff --git a/xbmc/cores/VideoPlayer/VideoPlayerAudio.cpp b/xbmc/cores/VideoPlayer/VideoPlayerAudio.cpp
index 66e857c..5f838f7 100644
--- a/xbmc/cores/VideoPlayer/VideoPlayerAudio.cpp
+++ b/xbmc/cores/VideoPlayer/VideoPlayerAudio.cpp
@@ -46,6 +46,9 @@ namespace
 // back within this time: longer than its own first retries (after 0.5, 1 and 2 seconds).
 constexpr auto OUTPUT_GRACE = 5s;
 constexpr auto OUTPUT_RETRY = 500ms;
+// Hades: ... while the audio engine is suspended, setting its outputs up again: a stream is refused
+// at once (CActiveAE::MakeStream()), and the stream is made as soon as the engine is back
+constexpr auto OUTPUT_RETRY_SUSPENDED = 25ms;
 // An engine that is without its sink for less than this (it opens it again after a change of
 // the display mode) serves the stream when it has it back: nothing is dropped for it.
 constexpr auto NO_SINK_SETTLE = 1500ms;
@@ -1027,10 +1030,32 @@ void CVideoPlayerAudio::SetupOutput(const DVDAudioFrame& audioframe)
 
   if (!m_audioSink.Create(audioframe, m_streaminfo.codec, m_synctype == SYNC_RESAMPLE))
   {
+    // Hades: an engine that is suspended sets its outputs up again (after a reset of the display,
+    // as every change of mode makes, it lists them again and opens its sink: half a second): no
+    // stream can be made meanwhile, and it is made as soon as the engine is back, tried again every
+    // OUTPUT_RETRY_SUSPENDED. Not a fault: said once as what it is. Any other failure as before.
+    const bool suspended = CServiceBroker::GetActiveAE()->IsSuspended();
     if (!m_outputFailingSince)
-      CLog::Log(LOGERROR, "ProcessDecoderOutput - failed to create audio renderer");
+    {
+      if (suspended)
+        CLog::Log(LOGINFO, "CVideoPlayerAudio: the audio engine is setting its outputs up again "
+                           "(after a reset of the display): the audio stream is made as soon as it "
+                           "is back");
+      else
+        CLog::Log(LOGERROR, "ProcessDecoderOutput - failed to create audio renderer");
+    }
+    m_outputSuspendedWait = suspended;
     OutputNotWorking();
   }
+  else if (m_outputFailingSince)
+  {
+    CLog::Log(LOGINFO, "CVideoPlayerAudio: the audio stream was made {} ms after the first try{}",
+              std::chrono::duration_cast<std::chrono::milliseconds>(
+                  std::chrono::steady_clock::now() - *m_outputFailingSince)
+                  .count(),
+              m_outputSuspendedWait ? " (the audio engine was setting its outputs up again)" : "");
+    m_outputSuspendedWait = false;
+  }
 
   m_prevsynctype = -1;
 
@@ -1051,7 +1076,7 @@ void CVideoPlayerAudio::OutputNotWorking()
   const auto now = std::chrono::steady_clock::now();
   if (!m_outputFailingSince)
     m_outputFailingSince = now;
-  m_outputRetry = now + OUTPUT_RETRY;
+  m_outputRetry = now + (m_outputSuspendedWait ? OUTPUT_RETRY_SUSPENDED : OUTPUT_RETRY);
 
   // An engine that is suspended, or busy, gets its output in the end. Only one without a sink
   // leaves nothing to wait for.
diff --git a/xbmc/cores/VideoPlayer/VideoPlayerAudio.h b/xbmc/cores/VideoPlayer/VideoPlayerAudio.h
index 6af3d89..9759f87 100644
--- a/xbmc/cores/VideoPlayer/VideoPlayerAudio.h
+++ b/xbmc/cores/VideoPlayer/VideoPlayerAudio.h
@@ -173,6 +173,9 @@ protected:
   //! its format) that it cannot play
   bool m_outputAccepted = false;
   std::optional<std::chrono::steady_clock::time_point> m_outputFailingSince; //!< no output since
+  //! Hades: the output failed because the audio engine was suspended, setting its outputs up again:
+  //! it is tried again sooner (OUTPUT_RETRY_SUSPENDED), and its failure was no error
+  bool m_outputSuspendedWait = false;
   //! the engine says without interruption that it has no sink since
   std::optional<std::chrono::steady_clock::time_point> m_noSinkSeen;
   //! the output fails for want of a sink since (an engine that has a sink only until it gets
