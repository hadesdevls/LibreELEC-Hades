From 15bd761d8b00f084c0e71e2e429e028eb80e49bb Mon Sep 17 00:00:00 2001
From: Portisch <hugo.portisch@yahoo.de>
Date: Mon, 23 Nov 2026 11:58:24 +0000
Subject: [PATCH] AdvancedSettings: full side by side and top and bottom in 3D
 file names

Files named .3D.FSBS. or .3D.FTAB. are common for 3D encodes in full
side by side or full top and bottom, but the default patterns of the
stereoscopic mode of a file name took only an optional H before SBS or
TAB. Such a file without a stereo mode in its container played in 2D.
The patterns now take F as well (an advancedsettings.xml that sets its
own keeps it).

From Portisch's change for CoreELEC (CoreELEC/xbmc commit ae5090539e,
"AdvancedSettings: detect full SBS and TAB in 3D file names").
---
 xbmc/settings/AdvancedSettings.cpp | 5 +++--
 1 file changed, 3 insertions(+), 2 deletions(-)

diff --git a/xbmc/settings/AdvancedSettings.cpp b/xbmc/settings/AdvancedSettings.cpp
index 9e98e55..baa74b5 100644
--- a/xbmc/settings/AdvancedSettings.cpp
+++ b/xbmc/settings/AdvancedSettings.cpp
@@ -564,8 +564,9 @@ void CAdvancedSettings::Initialize()
   m_videoExtensions += "|.pvr";
 
   m_stereoscopicregex_3d = "[-. _]3d[-. _]";
-  m_stereoscopicregex_sbs = "[-. _]h?sbs[-. _]";
-  m_stereoscopicregex_tab = "[-. _]h?tab[-. _]";
+  // (Hades: F for a full side by side or top and bottom frame, H for a half one)
+  m_stereoscopicregex_sbs = "[-. _][fh]?sbs[-. _]";
+  m_stereoscopicregex_tab = "[-. _][fh]?tab[-. _]";
 
   m_logLevelHint = m_logLevel = LOG_LEVEL_NORMAL;
 
