     struct dvbridge_dv d;
     memset(&d, 0, sizeof(d));
     const double s = fmin(1.0, fmin(3840.0 / width, 2160.0 / height));
@@ -52,9 +58,9 @@ const char *dvbridge_l5_area(const void *metadata, size_t bytes, int width, int
     d.source_h = height;
     d.dest_w = s < 1.0 ? (int)fmin(3840.0, (double)lround(width * s)) : width;
     d.dest_h = s < 1.0 ? (int)fmin(2160.0, (double)lround(height * s)) : height;
+    dvbridge_dv_l5_of_picture(&d, 0, of_picture);
     unsigned v[4];
-    if (!dvbridge_dv_margins(&d, l5->l5.left_offset, l5->l5.right_offset, l5->l5.top_offset,
