diff --git a/tools/dvbridge/dvbridge_l5check.h b/tools/dvbridge/dvbridge_l5check.h
index 304659e..06f29a8 100644
--- a/tools/dvbridge/dvbridge_l5check.h
+++ b/tools/dvbridge/dvbridge_l5check.h
@@ -31,7 +31,28 @@
  * (the opening second by second), at least DVBRIDGE_L5CHECK_NEEDED contradict them, the first and the last of those at
  * least DVBRIDGE_L5CHECK_SPAN seconds apart, and they are more than half of the measured ones. The count goes on at the
  * low rate after that, and the offsets are taken again when the contradicting pictures are half or fewer (opening
- * logos of 16:9 under the film's offsets: the film that follows outvotes them). Plain C, no GL: the caller measures. */
+ * logos of 16:9 under the film's offsets: the film that follows outvotes them). Plain C, no GL: the caller measures.
+ *
+ * Hades: the band between the two readings of the offsets (dvbridge_dv_margins() in dvbridge_metadata.h). Where a
+ * picture is not 3840x2160 and its offsets fit it both as offsets of the picture (as ETSI GS CCM 001 counts them) and
+ * as those of a 3840x2160 master that it was scaled or cropped from, the serializer takes the smaller margin of the two
+ * on each side. The bars between the two (the band) are either bars (an RPU of the picture's own size: an HD stream
+ * made with its own) or picture (an encode that kept the RPU of its master), and the metadata do not say which: the
+ * pictures do. A picture whose rows (columns) of blocks next to the band, inside the larger reading, are of the picture
+ * across it (as dvbridge_l5_band_contradicted() counts them) has the band black where it is bars (no block above the
+ * black level of the measurement on any side that has one), and picture across it where it is picture (more than half
+ * of its rows, on a side). A dark picture says neither. The row (column) of blocks at the edge of the larger reading is
+ * left out of both, for a scaled edge that rings into the bar (dvbridge_l5_band_between()).
+ *
+ * The offsets of a video are read as offsets of its picture once DVBRIDGE_L5BAND_NEEDED pictures, the first and the last
+ * at least DVBRIDGE_L5BAND_SPAN seconds apart, found the band black with picture next to it and none found picture across
+ * it; one that finds picture across it takes that back for the rest of the video (fail-closed: the smaller reading
+ * never takes picture out). What the offsets are counted in is the RPU's: the decision is of the video, for every value
+ * of its offsets (a film whose scenes change shape changes its offsets, not their unit). Until it is made, a picture a
+ * second is measured in the first DVBRIDGE_L5BAND_SEEK seconds of the video that have a band; while the offsets are
+ * read so, a picture at each cut of the RPU at most every DVBRIDGE_L5BAND_WATCH_CUT seconds and one every
+ * DVBRIDGE_L5BAND_WATCH_STEP seconds without one. Nothing is measured for it in a 3840x2160 picture, nor in one whose two
+ * readings are one. */
 #include <math.h>
 #include <stdbool.h>
 #include <string.h>
@@ -48,6 +69,82 @@
 #define DVBRIDGE_L5CHECK_WIDE_BANDS 12     /* of DVBRIDGE_MEASURED_BANDS */
 #define DVBRIDGE_L5CHECK_WIDE_ROW_BANDS 6  /* of DVBRIDGE_MEASURED_COLUMN_BANDS */
 #define DVBRIDGE_L5CHECK_PENDING 8
+#define DVBRIDGE_L5BAND_MIN 8 /* samples: a narrower band is not measured */
+#define DVBRIDGE_L5BAND_NEEDED 4
+#define DVBRIDGE_L5BAND_SPAN 3.0
+#define DVBRIDGE_L5BAND_SEEK 60.0
+#define DVBRIDGE_L5BAND_WATCH_CUT 1.0
+#define DVBRIDGE_L5BAND_WATCH_STEP 5.0
+
+/* Hades: how many bands of the measurement a row of blocks (rows) or a column of blocks is above the black level in */
+static inline unsigned dvbridge_l5_lit(const struct dvbridge_measured_raw *raw, bool rows, int k)
+{
+    unsigned lit = 0;
+    if (rows)
+        for (int b = 0; b < DVBRIDGE_MEASURED_BANDS; b++)
+            lit += raw->rows[(k * DVBRIDGE_MEASURED_BANDS + b) * 4 + 3] > DVBRIDGE_MEASURED_BLACK;
+    else
+        for (int b = 0; b < DVBRIDGE_MEASURED_COLUMN_BANDS; b++)
+            lit += raw->columns[k * DVBRIDGE_MEASURED_COLUMN_BANDS + b] > DVBRIDGE_MEASURED_BLACK;
+    return lit;
+}
+
+/* Hades: what a measured picture says of the band between the two readings of its level 5 offsets (smaller: the bars of
+ * the reading that the serializer takes without a measurement; given: those of the offsets read as offsets of the
+ * picture; left, right, top, bottom, in samples of the w x h picture): 1 it is bars, -1 it is picture, 0 the picture
+ * does not tell (see the top of this file) */
+static inline int dvbridge_l5_band_between(const struct dvbridge_measured_raw *raw, const unsigned smaller[4],
+                                           const unsigned given[4], int w, int h)
+{
+    if (!raw || !raw->rows || !raw->columns || !smaller || !given || w <= 0 || h <= 0)
+        return 0;
+    bool any = false, black = true, lit = false;
+    for (int i = 0; i < 4; i++) {
+        if (given[i] < smaller[i] + DVBRIDGE_L5BAND_MIN)
+            continue;
+        const bool rows = i >= 2;
+        const int size = rows ? h : w, blocks = rows ? raw->blocks_h : raw->blocks_w;
+        const int s = (int)smaller[i], g = (int)given[i], other = (int)given[i ^ 1];
+        /* the band in samples [from, to) and the picture next to it [nfrom, nto), as deep as the band, without the two
+         * samples on either side of the edge of the larger reading */
+        int from, to, nfrom, nto;
+        if (i % 2 == 0) {
+            from = s;
+            to = g - 2;
+            nfrom = g + 2;
+            nto = g + 2 + (g - s);
+            if (nto > size - other)
+                nto = size - other;
+        } else {
+            from = size - g + 2;
+            to = size - s;
+            nto = size - g - 2;
+            nfrom = nto - (g - s);
+            if (nfrom < other)
+                nfrom = other;
+        }
+        /* (the rows or columns of blocks wholly within them) */
+        const int a = from < 0 ? 0 : (from + 1) / 2, b = to / 2 < blocks ? to / 2 : blocks;
+        const int na = nfrom < 0 ? 0 : (nfrom + 1) / 2, nb = nto / 2 < blocks ? nto / 2 : blocks;
+        const unsigned wide_at = rows ? DVBRIDGE_L5CHECK_WIDE_BANDS : DVBRIDGE_L5CHECK_WIDE_ROW_BANDS;
+        unsigned wide = 0, dark = 0, all = 0, next_wide = 0, next_all = 0;
+        for (int k = a; k < b; k++, all++) {
+            const unsigned n = dvbridge_l5_lit(raw, rows, k);
+            wide += n >= wide_at;
+            dark += n == 0;
+        }
+        for (int k = na; k < nb; k++, next_all++)
+            next_wide += dvbridge_l5_lit(raw, rows, k) >= wide_at;
+        if (!all)
+            continue;
+        any = true;
+        if (2 * wide > all)
+            return -1;
+        black = black && dark == all;
+        lit = lit || (next_all && 2 * next_wide > next_all);
+    }
+    return any && black && lit ? 1 : 0;
+}
 
 /* Hades: whether a measured picture has picture across a band that its offsets make (bars: left, right, top, bottom, in
  * samples of the w x h picture; dvbridge_dv_picture_bars()). rows[4]: the rows (columns) of each band that are of the
@@ -87,6 +184,24 @@ static inline bool dvbridge_l5_band_contradicted(const struct dvbridge_measured_
     return contradicted;
 }
 
+/* Hades: the band between the two readings of the offsets, of a video (not of a value of its offsets: see the top of this
+ * file). now: the picture given last has one (dvbridge_l5check_band()), of these bars; said: the caller told of the first
+ * one; said_picture: ... and of the first picture that found picture across it; first: the time of the first picture
+ * with one; bars and picture: the pictures that found it bars, and picture; bars_first and bars_last: the first and the
+ * last of the former; decided: the offsets are read as offsets of the picture. at: the time of the last picture
+ * counted, and its bars and size, for the log. */
+struct dvbridge_l5band {
+    bool now, said, said_picture, started;
+    unsigned smaller[4], given[4];
+    double first;
+    unsigned bars, picture;
+    double bars_first, bars_last;
+    bool decided;
+    double at;
+    unsigned at_smaller[4], at_given[4];
+    int at_w, at_h;
+};
+
 struct dvbridge_l5check {
     unsigned video;      /* the video this is of (0: none yet) */
     unsigned offsets[4]; /* the value of the level 5 offsets counted now (as the RPU gives them) */
@@ -99,13 +214,18 @@ struct dvbridge_l5check {
     /* what the last contradicting picture showed: its bars, and the rows (columns) of each band of the picture */
     unsigned last_bars[4], last_rows[8];
     int width, height;
-    /* the pictures given to the measurement and not measured yet: their time (as given), offsets and bars */
+    /* the pictures given to the measurement and not measured yet: their time (as given), offsets and bars (Hades: and
+     * the bars of the two readings, where they have a band between them) */
     struct {
         bool used;
         double pts;
         unsigned offsets[4], bars[4];
         int w, h;
+        bool band;
+        unsigned smaller[4], given[4];
     } pending[DVBRIDGE_L5CHECK_PENDING];
+    /* Hades: the band between the two readings, of the video (struct dvbridge_l5band) */
+    struct dvbridge_l5band band;
 };
 
 /* Hades: the pictures from now on are of video: another one than before starts the check again (true) */
@@ -126,12 +246,48 @@ static inline bool dvbridge_l5check_value(struct dvbridge_l5check *c, const unsi
         return false;
     const bool ended = c->decided;
     const unsigned video = c->video;
+    /* (Hades: the band is of the video, and stays) */
+    const struct dvbridge_l5band band = c->band;
     memset(c, 0, sizeof(*c));
     c->video = video;
+    c->band = band;
     memcpy(c->offsets, offsets, sizeof(c->offsets));
     return ended;
 }
 
+/* Hades: the bars of the two readings of the offsets of the picture given now (left, right, top, bottom, in its samples:
+ * smaller, the reading taken without a measurement; given, the offsets read as offsets of the picture), or NULL where
+ * it has no level 5 block. It has a band where they differ by DVBRIDGE_L5BAND_MIN samples on a side. */
+static inline void dvbridge_l5check_band(struct dvbridge_l5check *c, const unsigned smaller[4], const unsigned given[4])
+{
+    c->band.now = false;
+    if (!smaller || !given)
+        return;
+    for (int i = 0; i < 4; i++)
+        c->band.now = c->band.now || given[i] >= smaller[i] + DVBRIDGE_L5BAND_MIN;
+    memcpy(c->band.smaller, smaller, sizeof(c->band.smaller));
+    memcpy(c->band.given, given, sizeof(c->band.given));
+}
+
+/* Hades: whether the picture at t (seconds of the video), a cut of its RPU where refresh, is given to the measurement for
+ * the band (the caller asks dvbridge_l5check_wanted() as well, and measures it for either); never once a picture found
+ * picture across it */
+static inline bool dvbridge_l5check_band_wanted(struct dvbridge_l5check *c, double t, bool refresh)
+{
+    if (!isfinite(t) || !c->band.now || c->band.picture)
+        return false;
+    if (!c->band.started) {
+        c->band.started = true;
+        c->band.first = t;
+    }
+    if (t < c->band.first)
+        c->band.first = t;
+    const double since = c->any && t >= c->last ? t - c->last : (double)INFINITY;
+    if (c->band.decided)
+        return since >= (refresh ? DVBRIDGE_L5BAND_WATCH_CUT : DVBRIDGE_L5BAND_WATCH_STEP);
+    return t - c->band.first < DVBRIDGE_L5BAND_SEEK && since >= DVBRIDGE_L5CHECK_OPENING_STEP;
+}
+
 /* Hades: whether the picture at t (seconds of the video), a cut of its RPU where refresh, whose level 5 offsets (of the
  * value counted: dvbridge_l5check_value()) make bars inside it (bars: dvbridge_dv_picture_bars()), is given to the
  * measurement. A jump back (a seek) measures the next picture. */
@@ -170,13 +326,21 @@ static inline void dvbridge_l5check_submitted(struct dvbridge_l5check *c, double
     memcpy(c->pending[slot].bars, bars, sizeof(c->pending[slot].bars));
     c->pending[slot].w = w;
     c->pending[slot].h = h;
