 void dvbridge_ignore_l5(struct dvbridge_context *context, unsigned video, const unsigned offsets[4],
                         const char *why);
+/* Hades: the level 5 offsets of video (dvbridge_cm40_video_of()) are read as offsets of its picture from its next frame
+ * on (on), where they fit it and the reading of a 3840x2160 master would make smaller margins, or as before (off):
+ * dvbridge_dv_l5_of_picture() in dvbridge_metadata.h; a measurement decides (dvbridge_l5check.h) */
+#define DVBRIDGE_DV_L5_OF_PICTURE 1
+void dvbridge_l5_of_picture(struct dvbridge_context *context, unsigned video, bool on);
 /* Hades: the bars inside the picture that the level 5 offsets of the candidate's frame made (left, right, top,
  * bottom, in samples of the picture: dvbridge_dv_picture_bars()); false where it was drawn through a view, or where
  * its offsets were left aside. All 0: no bars inside the picture. offsets: its level 5 offsets, as the RPU gives
@@ -184,6 +189,9 @@ struct dvbridge_reading {
      * or scaled from: the margins are smaller than as_given, the offsets read in the units of the
      * picture (see dvbridge_dv_margins() in dvbridge_metadata.h) */
     bool l5_master;
+    /* Hades: they were read as offsets of the picture, measured for the video, where the other reading made smaller
+     * margins (dvbridge_l5_of_picture()) */
+    bool l5_picture;
     unsigned l5[4];       /* left, right, top, bottom offsets of the level 5 block (0: none) */
     unsigned as_given[4]; /* ... as offsets of the picture, in the raster; 0 when they do not fit */
     unsigned margins[4];  /* the margins taken */
