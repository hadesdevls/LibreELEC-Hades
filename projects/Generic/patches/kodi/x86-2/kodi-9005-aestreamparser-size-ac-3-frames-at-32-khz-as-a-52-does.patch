diff --git a/xbmc/cores/AudioEngine/Utils/test/TestAEStreamParser.cpp b/xbmc/cores/AudioEngine/Utils/test/TestAEStreamParser.cpp
index 1c4025c..387c910 100644
--- a/xbmc/cores/AudioEngine/Utils/test/TestAEStreamParser.cpp
+++ b/xbmc/cores/AudioEngine/Utils/test/TestAEStreamParser.cpp
@@ -128,6 +128,58 @@ std::vector<uint8_t> Eac3Frame()
   return frame;
 }
 
+//! The CRC of A/52 (x^16 + x^15 + x^2 + 1, most significant bit first, from 0): what av_crc() with
+//! AV_CRC_16_ANSI says is 0 or not
+uint16_t Ac3Crc(const uint8_t* data, size_t size)
+{
+  uint16_t crc = 0;
+  for (size_t i = 0; i < size; ++i)
+  {
+    crc ^= static_cast<uint16_t>(data[i] << 8);
+    for (int bit = 0; bit < 8; ++bit)
+      crc = static_cast<uint16_t>((crc & 0x8000) ? (crc << 1) ^ 0x8005 : crc << 1);
+  }
+  return crc;
+}
+
+//! An AC-3 syncframe of 2/0 (bsid 8, dialnorm -27 dB) at the sample rate of \p fscod and the bit
+//! rate of \p frmsizecod, \p words 16-bit words long, as A/52 table 5.18 gives them. Its two CRCs
+//! hold: the CRC of its first 5/8 after the syncword is 0, and so is the CRC of the whole frame
+//! after it (the last word of the 5/8 and of the frame are set for that, as crc1 and crc2 do). The
+//! other bytes are not silence, so that a frame size that is not right fails the CRC.
+std::vector<uint8_t> Ac3Frame(unsigned int fscod,
+                              unsigned int frmsizecod,
+                              unsigned int words,
+                              unsigned int seed)
+{
+  std::vector<uint8_t> frame(2 * words);
+  uint32_t x = 2463534242u + seed;
+  for (uint8_t& b : frame)
+  {
+    x ^= x << 13;
+    x ^= x >> 17;
+    x ^= x << 5;
+    b = static_cast<uint8_t>(x);
+  }
+  const uint8_t header[] = {0x0B,
+                            0x77,
+                            0x00,
+                            0x00,
+                            static_cast<uint8_t>((fscod << 6) | frmsizecod),
+                            8 << 3,
+                            0x43,
+                            0x60};
+  std::copy(std::begin(header), std::end(header), frame.begin());
+  const size_t fiveEighths = 2 * ((words >> 1) + (words >> 3));
+  const uint16_t first = Ac3Crc(frame.data() + 2, fiveEighths - 4);
+  frame[fiveEighths - 2] = static_cast<uint8_t>(first >> 8);
+  frame[fiveEighths - 1] = static_cast<uint8_t>(first);
+  const uint16_t rest = Ac3Crc(frame.data() + fiveEighths, frame.size() - fiveEighths - 2);
+  frame[frame.size() - 2] = static_cast<uint8_t>(rest >> 8);
+  frame[frame.size() - 1] = static_cast<uint8_t>(rest);
+  return frame;
+}
+
 //! The types of the frames a parser that expects \p expected hands out
 std::vector<CAEStreamInfo::DataType> ParseExpecting(const std::vector<uint8_t>& stream,
                                                     CAEStreamInfo::DataType expected)
@@ -322,6 +374,55 @@ TEST(TestAEStreamParser, TheDtsFamilyIsOnlyDts)
   EXPECT_TRUE(ParseExpecting(stream, CAEStreamInfo::STREAM_TYPE_EAC3).empty());
 }
 
+//! An AC-3 stream is found, and handed out frame by frame, at each of its three sample rates: at
+//! 32 kHz the parser took every frame for a third longer than it is (4 words for each kb/s, where
+//! A/52 has 3), so that no frame passed its CRC and the stream was never found.
+TEST(TestAEStreamParser, Ac3FramesAreTheirSizeAtEachSampleRate)
+{
+  struct Case
+  {
+    unsigned int fscod;
+    unsigned int frmsizecod;
+    unsigned int words; // A/52 table 5.18
+    unsigned int rate;
+  };
+  const Case cases[] = {{0, 0, 64, 48000},    {1, 0, 69, 44100},     {2, 0, 96, 32000},
+                        {0, 21, 384, 48000},  {1, 21, 418, 44100},   {2, 21, 576, 32000},
+                        {0, 37, 1280, 48000}, {1, 37, 1394, 44100},  {2, 37, 1920, 32000}};
+  for (const Case& c : cases)
+  {
+    // (one frame for each packet, as the demuxer hands them to the passthrough codec, which keeps
+    // what the parser did not take for the next call)
+    CAEStreamParser parser;
+    std::vector<unsigned int> sizes;
+    std::vector<uint8_t> backlog;
+    for (unsigned int i = 0; i < 6; ++i)
+    {
+      const std::vector<uint8_t> frame = Ac3Frame(c.fscod, c.frmsizecod, c.words, i);
+      // the frame of the test as A/52 has it
+      ASSERT_EQ(0, Ac3Crc(frame.data() + 2, frame.size() - 2));
+      Append(backlog, frame);
+      uint8_t* out = nullptr;
+      unsigned int outSize = 0;
+      const int used = parser.AddData(backlog.data(), static_cast<unsigned int>(backlog.size()),
+                                      &out, &outSize);
+      delete[] out;
+      if (outSize > 0)
+      {
+        sizes.push_back(outSize);
+        EXPECT_EQ(CAEStreamInfo::STREAM_TYPE_AC3, parser.GetDataType());
+        EXPECT_EQ(c.rate, parser.GetSampleRate());
+      }
+      ASSERT_GE(used, 0);
+      backlog.erase(backlog.begin(), backlog.begin() + used);
+    }
+    // (the last frame waits for the bytes after it, where an E-AC-3 dependent frame could be)
+    EXPECT_GE(sizes.size(), 5u) << "fscod " << c.fscod << ", frmsizecod " << c.frmsizecod;
+    for (const unsigned int size : sizes)
+      EXPECT_EQ(2 * c.words, size) << "fscod " << c.fscod << ", frmsizecod " << c.frmsizecod;
+  }
+}
+
 //! A frame whose header says it is larger than the parser can hold is not waited for: the frames
 //! after it are found, and every byte handed to the parser is taken.
 TEST(TestAEStreamParser, AFrameLargerThanTheParserIsNotWaitedFor)
