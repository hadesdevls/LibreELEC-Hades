+#include "cores/AudioEngine/Utils/AudioPresentation.h"
+
+#include <cstdint>
+#include <vector>
+
+#include <gtest/gtest.h>
+
+using namespace KODI::AE::PRESENTATION::DETAIL;
+
+namespace
+{
+// An AC-3 syncframe of 2/0 (bsid 8, dialnorm code 27) at the sample rate of fscod and the bit rate
+// of frmsizecod, words 16-bit words long as A/52 table 5.18 gives them, with both CRCs right (the
+// last word of its first 5/8, and of the frame, set for them), the rest not silence
+std::vector<uint8_t> Ac3Frame(unsigned int fscod, unsigned int frmsizecod, unsigned int words)
+{
+  std::vector<uint8_t> frame(2 * words);
+  uint32_t x = 2463534242u;
+  for (uint8_t& b : frame)
+  {
+    x ^= x << 13;
+    x ^= x >> 17;
+    x ^= x << 5;
+    b = static_cast<uint8_t>(x);
+  }
+  const uint8_t header[] = {0x0B, 0x77, 0x00, 0x00, static_cast<uint8_t>((fscod << 6) | frmsizecod),
+                            8 << 3, 0x43, 0x60};
+  std::copy(std::begin(header), std::end(header), frame.begin());
+  const size_t fiveEighths = 2 * ((words >> 1) + (words >> 3));
+  const uint16_t first = CrcAC3(frame.data() + 2, fiveEighths - 4);
+  frame[fiveEighths - 2] = static_cast<uint8_t>(first >> 8);
+  frame[fiveEighths - 1] = static_cast<uint8_t>(first);
+  const uint16_t rest = CrcAC3(frame.data() + fiveEighths, frame.size() - fiveEighths - 2);
+  frame[frame.size() - 2] = static_cast<uint8_t>(rest >> 8);
+  frame[frame.size() - 1] = static_cast<uint8_t>(rest);
+  return frame;
+}
+} // namespace
+
+TEST(TestAudioPresentationAC3, TheSizeOfAFrameAtEachSampleRate)
+{
+  // A/52 table 5.18, in bytes: 32, 192 and 640 kb/s at 48, 44.1 and 32 kHz
+  EXPECT_EQ(128u, AC3FrameBytes(0, 0));
+  EXPECT_EQ(138u, AC3FrameBytes(1, 0));
+  EXPECT_EQ(192u, AC3FrameBytes(2, 0));
+  EXPECT_EQ(768u, AC3FrameBytes(0, 21));
+  EXPECT_EQ(836u, AC3FrameBytes(1, 21));
+  EXPECT_EQ(1152u, AC3FrameBytes(2, 21));
+  EXPECT_EQ(2560u, AC3FrameBytes(0, 37));
+  EXPECT_EQ(2788u, AC3FrameBytes(1, 37));
+  EXPECT_EQ(3840u, AC3FrameBytes(2, 37));
+  // reserved: none
+  EXPECT_EQ(0u, AC3FrameBytes(3, 0));
+  EXPECT_EQ(0u, AC3FrameBytes(0, 38));
+}
+
+TEST(TestAudioPresentationAC3, AFrameIsReadAtEachSampleRate)
+{
+  struct Case
+  {
+    unsigned int fscod;
+    unsigned int frmsizecod;
+    unsigned int words;
+  };
+  for (const Case c : {Case{0, 21, 384}, Case{1, 21, 418}, Case{2, 21, 576}, Case{2, 0, 96},
+                       Case{2, 37, 1920}})
+  {
+    std::vector<uint8_t> stream = Ac3Frame(c.fscod, c.frmsizecod, c.words);
+    ASSERT_EQ(0, CrcAC3(stream.data() + 2, stream.size() - 2));
+    const std::vector<uint8_t> next = Ac3Frame(c.fscod, c.frmsizecod, c.words);
+    stream.insert(stream.end(), next.begin(), next.end());
+    const SAC3Frame frame = ReadAC3Frame(stream.data(), stream.size());
+    EXPECT_EQ(2u * c.words, frame.bytes) << "fscod " << c.fscod << ", frmsizecod " << c.frmsizecod;
+    EXPECT_FALSE(frame.eac3);
+    EXPECT_TRUE(frame.independent0);
+    ASSERT_TRUE(frame.dialnorm.has_value()) << "fscod " << c.fscod;
+    EXPECT_EQ(-27, *frame.dialnorm);
+  }
+}
