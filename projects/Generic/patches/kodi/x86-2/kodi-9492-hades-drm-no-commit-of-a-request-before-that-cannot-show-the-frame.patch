     static void LogAtomicRequest(
diff --git a/xbmc/windowing/gbm/drm/FallbackFrame.h b/xbmc/windowing/gbm/drm/FallbackFrame.h
new file mode 100644
index 0000000..d56aa06
--- /dev/null
+++ b/xbmc/windowing/gbm/drm/FallbackFrame.h
@@ -0,0 +1,77 @@
+/*
+ *  Copyright (C) 2026 Hades
+ *  This file is part of LibreELEC Hades. It is not in Kodi as Team Kodi publishes it.
+ *
+ *  SPDX-License-Identifier: GPL-2.0-or-later
+ *  See LICENSES/README.md for more information.
+ */
+
+#pragma once
+
+#include <cstdint>
+#include <optional>
+#include <utility>
+
+/*!
+ * \brief Hades: the request that goes out in place of one whose test the driver refused
+ *        (CDRMAtomic::DrmAtomicCommit())
+ *
+ * Kodi then commits the request that the driver took last, with the frame of the refused one in
+ * its plane (so that the picture does not tear). Where that frame's buffer is smaller than what
+ * the plane of the request before it shows of a buffer (its source rectangle), the kernel refuses
+ * the request before it checks anything else (drm_atomic_plane_check() ->
+ * drm_framebuffer_check_src_coords(): -ENOSPC, "No space left on device"). That is what happened
+ * after each refused change to an HDMI 3D frame-packed mode on nvidia-drm (issue #33): the frame
+ * of 2048x2205 in the plane of a 2D mode of 3840x2160. Such a request is not made: nothing goes
+ * out, the screen keeps what it shows, and Kodi goes on as after a refused commit, which is what
+ * the kernel would have answered.
+ */
+namespace KODI::WINDOWING::GBM::FALLBACK_FRAME
+{
+
+//! The source rectangle of a plane, in the 16.16 fixed point of DRM
+struct Source
+{
+  uint64_t x{0};
+  uint64_t y{0};
+  uint64_t w{0};
+  uint64_t h{0};
+};
+
+/*!
+ * \brief Whether a buffer of this size holds the source rectangle, as the kernel checks it
+ *        (drm_framebuffer_check_src_coords(), drivers/gpu/drm/drm_framebuffer.c)
+ */
+constexpr bool Holds(const Source& source, uint32_t width, uint32_t height)
+{
+  const uint64_t w = static_cast<uint64_t>(width) << 16;
+  const uint64_t h = static_cast<uint64_t>(height) << 16;
+  return !(source.w > w || source.x > w - source.w || source.h > h || source.y > h - source.h);
+}
+
+/*!
+ * \brief Whether the request before goes out with the frame of the refused one
+ * \param source the source rectangle that the request before gives its plane (nothing where it
+ *        is not known: as before, it goes out)
+ * \param size the size of the frame's buffer (nothing where it is not known: it goes out)
+ */
+constexpr bool GoesOut(std::optional<Source> source,
+                       std::optional<std::pair<uint32_t, uint32_t>> size)
+{
+  return !source || !size || Holds(*source, size->first, size->second);
+}
+
+/*!
+ * \brief Whether a refused test is that of a change to a mode with HDMI 3D frame packing: Kodi
+ *        takes the 3D layout that comes next after it (CWinSystemGbm::CheckStereoOutput()), so the
+ *        refusal is said as a warning, not as an error. Any other refused test is an error, as
+ *        before.
+ * \param modeset the request changes the mode
+ * \param framePacked the mode it sets is frame packed
+ */
+constexpr bool FramePackingRefusal(bool modeset, bool framePacked)
+{
+  return modeset && framePacked;
+}
+
+} // namespace KODI::WINDOWING::GBM::FALLBACK_FRAME
