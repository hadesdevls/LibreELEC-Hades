index c78ae9b..40c2270 100644
--- a/xbmc/windowing/gbm/drm/DRMAtomic.h
+++ b/xbmc/windowing/gbm/drm/DRMAtomic.h
@@ -383,7 +383,10 @@ private:
     void LogAtomicRequest();
     void LogAtomicRequest(uint8_t logLevel) { LogAtomicRequest(logLevel, m_atomicRequestItems); }
 
-    static void LogAtomicDiff(CDRMAtomicRequest* current, CDRMAtomicRequest* old);
+    //! (Hades: \p logLevel of the lines; an error, as before, where nothing else is said)
+    static void LogAtomicDiff(CDRMAtomicRequest* current,
+                              CDRMAtomicRequest* old,
+                              int logLevel = LOGERROR);
 
