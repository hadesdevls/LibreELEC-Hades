             DetectedProperty.h
+            FallbackFrame.h
             LinkStatus.h
             OffScreenModeSetting.h)
 
diff --git a/xbmc/windowing/gbm/drm/DRMAtomic.cpp b/xbmc/windowing/gbm/drm/DRMAtomic.cpp
index 6d1c9cc..6dfd0df 100644
--- a/xbmc/windowing/gbm/drm/DRMAtomic.cpp
+++ b/xbmc/windowing/gbm/drm/DRMAtomic.cpp
@@ -10,6 +10,7 @@
 
 #include "DRMRequestQueue.h"
 #include "DVBridgeRefused.h"
+#include "FallbackFrame.h"
 #include "LinkStatus.h"
 #include "ServiceBroker.h"
 #include "application/ApplicationComponents.h"
@@ -138,6 +139,8 @@ bool CDRMAtomic::DrmAtomicCommit(int fb_id, int flags, bool rendered, bool video
   };
   m_lastCommitRefused = false;
   bool fellBack = false; // (Hades: the request before this one went out in its place)
+  // Hades: ... or would have, but cannot show the frame: nothing is committed (FALLBACK_FRAME)
+  bool notMade = false;
   // Declared at function scope so the blob outlives drmModeAtomicCommit.
   // DRM requires the blob to remain alive for the duration of the commit;
   // destroying it before the commit returns leaves the atomic request
@@ -521,10 +524,23 @@ bool CDRMAtomic::DrmAtomicCommit(int fb_id, int flags, bool rendered, bool video
       return reject();
     }
     const int refused = errno; // (Hades)
-    CLog::LogF(LOGERROR,
-               "test commit failed: ({}) - falling back to last successful atomic "
-               "request",
-               strerror(refused));
+    // Hades: a change to a mode with HDMI 3D frame packing that the driver refuses is followed by the
+    // 3D layout that comes next (CWinSystemGbm::CheckStereoOutput()): a warning that says so, not an
+    // error (FALLBACK_FRAME::FramePackingRefusal()); every other refused test as before
+    const bool framePacking = FALLBACK_FRAME::FramePackingRefusal(
+        modeset, m_mode && STEREO::LayoutOf(m_mode->flags) == STEREO::Layout::FRAME_PACKING);
+    if (framePacking)
+      CLog::LogF(LOGWARNING,
+                 "test commit of the change to the frame-packed mode {}x{} failed: ({}) - the "
+                 "request before it is the one that goes out, and Kodi takes the 3D layout that "
+                 "comes next (the kernel log says why the driver refused it, in its lines \"Hades: "
+                 "HDMI 3D frame packing refused\")",
+                 m_mode->hdisplay, m_mode->vdisplay, strerror(refused));
+    else
+      CLog::LogF(LOGERROR,
+                 "test commit failed: ({}) - falling back to last successful atomic "
+                 "request",
+                 strerror(refused));
     // (Hades: the outputs that it turned off stay on: asked for again later)
     if (othersOff)
       OtherOutputsOffRefused(refused);
@@ -563,14 +579,45 @@ bool CDRMAtomic::DrmAtomicCommit(int fb_id, int flags, bool rendered, bool video
       m_refusedFlags = flags;
     }
     auto oldRequest = m_atomicRequestQueue.front().get();
-    CDRMAtomicRequest::LogAtomicDiff(m_req, oldRequest);
+    CDRMAtomicRequest::LogAtomicDiff(m_req, oldRequest, framePacking ? LOGWARNING : LOGERROR);
     // Hades: where the refused request changes the colour tag of the output to BT.2020, kodi.log
     // says whether that tag is what the driver refused (TellBt2020Refused())
     TellBt2020Refused(refused, flags);
     m_req = oldRequest;
 
-    // update the old atomic request with the new fb id to avoid tearing
+    // Hades: ... where its plane can show the frame's buffer: one that is smaller than what it shows
+    // of a buffer (a frame of a mode that it does not set) the kernel refuses ("No space left on
+    // device"), and that commit is not made (FALLBACK_FRAME::GoesOut())
     if (rendered)
+    {
+      std::optional<FALLBACK_FRAME::Source> source;
+      const auto value = [&](const char* name)
+      {
+        const std::optional<uint64_t> asked = m_req->Value(outputPlane, name);
+        return asked ? asked : outputPlane->GetPropertyValue(name);
+      };
+      if (const auto w = value("SRC_W"), h = value("SRC_H"); w && h)
+        source =
+            FALLBACK_FRAME::Source{value("SRC_X").value_or(0), value("SRC_Y").value_or(0), *w, *h};
+      std::optional<std::pair<uint32_t, uint32_t>> size;
+      if (drmModeFBPtr info = drmModeGetFB(m_fd, static_cast<uint32_t>(fb_id)))
+      {
+        size = std::make_pair(info->width, info->height);
+        drmModeFreeFB(info);
+      }
+      if (!FALLBACK_FRAME::GoesOut(source, size))
+      {
+        notMade = true;
+        CLog::LogF(framePacking ? LOGINFO : LOGWARNING,
+                   "the request before it cannot show this frame (its plane shows {}x{} of a "
+                   "buffer, the frame's buffer is {}x{}): it is not committed, as the driver "
+                   "would refuse it; the screen keeps what it shows",
+                   source->w >> 16, source->h >> 16, size->first, size->second);
+      }
+    }
+
+    // update the old atomic request with the new fb id to avoid tearing
+    if (rendered && !notMade)
     {
       AddProperty(outputPlane, "FB_ID", fb_id);
       // Hades: with the rotation of that buffer (SetReflectY())
@@ -579,7 +626,7 @@ bool CDRMAtomic::DrmAtomicCommit(int fb_id, int flags, bool rendered, bool video
     }
     // Hades: ... and with the fences of the frame: those it names are of its own commit, its
     // in-fence closed since (FenceFallback())
-    const bool fenced = rendered && m_inFenceFd != -1;
+    const bool fenced = rendered && !notMade && m_inFenceFd != -1;
     FenceFallback(*m_req, static_cast<CDRMObject*>(outputPlane), static_cast<CDRMObject*>(m_crtc),
                   fenced ? std::optional<std::pair<uint64_t, uint64_t>>(
                                {static_cast<uint64_t>(m_inFenceFd),
@@ -602,7 +649,14 @@ bool CDRMAtomic::DrmAtomicCommit(int fb_id, int flags, bool rendered, bool video
       FRL_MODE_CHANGE::OffFirst(linkBefore, m_mode ? m_mode->clock : 0, m_active, moving))
     CommitOutputOffFirst(linkBefore);
   const auto commitStart = std::chrono::steady_clock::now();
-  ret = drmModeAtomicCommit(m_fd, m_req->Get(), flags, nullptr);
+  // Hades: (a request before that cannot show the frame is not made: what the kernel answers it)
+  if (notMade)
+  {
+    ret = -1;
+    errno = ENOSPC;
+  }
+  else
+    ret = drmModeAtomicCommit(m_fd, m_req->Get(), flags, nullptr);
   // Hades: how long a commit that changes the mode took, for the report of a slow pass of the GUI
   if (modeset)
     CModeChangeTime::Add(commitStart);
@@ -670,7 +724,9 @@ bool CDRMAtomic::DrmAtomicCommit(int fb_id, int flags, bool rendered, bool video
     }
     else
     {
-      CLog::LogF(LOGERROR, "atomic commit failed: {}", strerror(error));
+      // Hades: (a commit not made is said where it is not: above)
+      if (!notMade)
+        CLog::LogF(LOGERROR, "atomic commit failed: {}", strerror(error));
       // (Hades: the outputs that it turned off stay on: asked for again later)
       if (othersOff)
         OtherOutputsOffRefused(error);
@@ -2001,7 +2057,8 @@ void CDRMAtomic::CDRMAtomicRequest::CacheProperties()
 }
 
 void CDRMAtomic::CDRMAtomicRequest::LogAtomicDiff(CDRMAtomicRequest* current,
-                                                  CDRMAtomicRequest* old)
+                                                  CDRMAtomicRequest* old,
+                                                  int logLevel)
 {
   std::map<CDRMObject*, std::map<uint32_t, uint64_t>> atomicDiff;
 
@@ -2026,7 +2083,7 @@ void CDRMAtomic::CDRMAtomicRequest::LogAtomicDiff(CDRMAtomicRequest* current,
 
   CLog::LogF(LOGDEBUG, "DRM Atomic Request Diff:");
 
-  LogAtomicRequest(LOGERROR, atomicDiff);
+  LogAtomicRequest(static_cast<uint8_t>(logLevel), atomicDiff);
 }
 
 void CDRMAtomic::CDRMAtomicRequest::LogAtomicRequest()
