From 4fe0b901aeedf490dc33666d26dd496727183b95 Mon Sep 17 00:00:00 2001
From: Hades <15710513+hadesdevls@users.noreply.github.com>
Date: Wed, 25 Nov 2026 03:56:23 +0000
Subject: [PATCH] [Hades][Network] Projector control: the SDCP community in no
 detail of a failure

A Sony projector on SDCP says the community back in the header of its
answer (bytes 2 to 5), and the community is the password field of the
protocol. The log of each request and answer already said it as
"(community)", but the detail of a failure did not: an answer that names
another item gave the whole header, and an answer cut short or closed
within its header gave what had come of it. That detail goes to kodi.log
(the lines of the control and of its test), to the notice of a test of the
connection, and from kodi.log into the diagnostics people share.

The bytes of SDCP are now said through one function that puts
"(community)" in the place of bytes 2 to 5, also of a header that came only
in part, in the request, the answer and the details of both failures.
---
 xbmc/network/ProjectorLink.cpp | 32 +++++++++++++++++++++++++++-----
 1 file changed, 27 insertions(+), 5 deletions(-)

diff --git a/xbmc/network/ProjectorLink.cpp b/xbmc/network/ProjectorLink.cpp
index b082a35..3fe3541 100644
--- a/xbmc/network/ProjectorLink.cpp
+++ b/xbmc/network/ProjectorLink.cpp
@@ -818,6 +818,20 @@ Result CSession::AdcpCommand(const std::string& command, int timeoutMs, std::str
 
 // ------------------------------------------------------------------------------------- Sony SDCP
 
+namespace
+{
+//! the bytes of a request or an answer of SDCP as the log says them: the community, bytes 2 to 5 of
+//! the header (the password field, which the projector says back), as "(community)", also where
+//! only a part of the header came
+std::string SdcpPrintable(const std::string& bytes)
+{
+  if (bytes.size() <= 2)
+    return Printable(bytes);
+  return Printable(bytes.substr(0, 2)) + "(community)" +
+         (bytes.size() > 6 ? Printable(bytes.substr(6)) : std::string());
+}
+} // namespace
+
 Result CSession::SdcpRequest(
     bool set, uint16_t item, uint16_t data, int timeoutMs, uint16_t& answer)
 {
@@ -840,23 +854,31 @@ Result CSession::SdcpRequest(
   }
   else
     request += static_cast<char>(0);
-  std::string said = Printable(request.substr(0, 2)) + "(community)" + Printable(request.substr(6));
-  result = Send(request, said);
+  result = Send(request, SdcpPrintable(request));
   std::string head;
   if (result.Ok())
     result = ReadExact(10, timeoutMs, head);
   std::string body;
   if (result.Ok())
     result = ReadExact(static_cast<unsigned char>(head[9]), m_timeouts.answerMs, body);
+  // the projector says the community back in its header: a header that came only in part (an
+  // answer cut short, a connection closed) is said in the detail of the failure without it, as the
+  // log of the control and its notices show that detail
+  if (!result.Ok() && head.empty() && !m_buffer.empty())
+  {
+    const std::string plain = Printable(m_buffer);
+    const size_t at = result.detail.find(plain);
+    if (at != std::string::npos)
+      result.detail.replace(at, plain.size(), SdcpPrintable(m_buffer));
+  }
   Disconnect();
   m_nextSendMs = NowMs() + m_timeouts.gapMs / 2;
   if (!result.Ok())
     return result;
-  Say("received: " + Printable(head.substr(0, 2)) + "(community)" +
-      Printable(head.substr(6) + body));
+  Say("received: " + SdcpPrintable(head + body));
   if (head[0] != 0x02 || head[1] != 0x0A || static_cast<unsigned char>(head[7]) != (item >> 8) ||
       static_cast<unsigned char>(head[8]) != (item & 0xFF))
-    return {Failure::PROTOCOL, Printable(head + body)};
+    return {Failure::PROTOCOL, SdcpPrintable(head + body)};
   if (body.size() >= 2)
     answer = static_cast<uint16_t>((static_cast<unsigned char>(body[0]) << 8) |
                                    static_cast<unsigned char>(body[1]));
