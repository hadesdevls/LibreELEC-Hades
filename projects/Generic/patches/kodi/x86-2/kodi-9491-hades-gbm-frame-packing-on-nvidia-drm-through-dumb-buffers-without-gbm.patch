+
+#pragma once
+
+#include <cstdint>
+#include <optional>
+
+#include <gbm.h>
+
+namespace KODI
+{
+namespace WINDOWING
+{
+namespace GBM
+{
+
+/*!
+ * \brief The framebuffer of the kernel made of a buffer that goes to the screen, kept as the user
+ *        data of its buffer of GBM (CDRMUtils::DrmFbGetFromBo())
+ */
+struct drm_fb
+{
+  struct gbm_bo* bo = nullptr;
+  uint32_t fb_id;
+  uint32_t format;
+  uint32_t opaque_fb_id = 0;
+
+  /*!
+   * \brief Hades: what a framebuffer is made of where it is not the memory of its buffer of GBM:
+   *        a dumb buffer of the driver (COwnScanout, Memory::DUMB; issue #33). NVIDIA's GBM
+   *        imports no dumb buffer, and Kodi's queue holds buffers of GBM (IOwnBuffers): a small
+   *        buffer of GBM stands for the dumb one there, and its user data is this framebuffer,
+   *        made of the dumb buffer's handle. Nothing reads the small buffer: what the framebuffer
+   *        is made of is asked here, never of it (CDRMUtils::FramePackedBufferUsable(),
+   *        DescribeFramePackedBuffer(), DrmOpaqueFbGetFromBo()).
+   */
+  struct Own
+  {
+    uint32_t handle{0}; //!< of the dumb buffer, on the DRM file of the GBM device
+    uint32_t width{0};
+    uint32_t height{0};
+    uint32_t pitch{0};
+    uint64_t modifier{0};
+  };
+  std::optional<Own> own;
+};
+
+//! \brief Hades: what the framebuffer of a buffer of GBM is made of, where that is not the buffer
+//!        itself (drm_fb::own); nothing for any other buffer, or one that has no framebuffer yet
+inline const drm_fb::Own* OwnFramebufferOf(struct gbm_bo* bo)
+{
+  const auto* fb = bo ? static_cast<const drm_fb*>(gbm_bo_get_user_data(bo)) : nullptr;
+  return fb && fb->own ? &*fb->own : nullptr;
+}
+
+} // namespace GBM
+} // namespace WINDOWING
+} // namespace KODI
