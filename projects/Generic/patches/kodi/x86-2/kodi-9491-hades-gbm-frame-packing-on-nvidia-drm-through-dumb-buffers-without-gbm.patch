+bool COwnScanout::RowHolds(
+    const uint8_t* row, uint32_t format, bool probe, const char* where, std::string& failed)
+{
+  const std::optional<bool> bgra = MemoryIsBgra(format);
+  if (!bgra || !row)
+  {
+    failed = "the format " + FourCC(format) + " is not one of 8 bits";
+    return false;
+  }
+  for (int pixel = 0; pixel < 4; ++pixel)
+    for (int c = 0; c < 3; ++c)
+    {
+      // (the bytes of a pixel as the format lays them: B, G, R, A or R, G, B, A)
+      const unsigned int value = row[pixel * 4 + (*bgra ? 2 - c : c)];
+      const unsigned int expected = probe ? PROBE_BYTES[pixel][c] : 0;
+      if (value != expected)
+      {
+        char text[200];
+        snprintf(text, sizeof(text),
+                 "the buffer did not hold the values written (%u for %u in its %s row, pixel %d "
+                 "component %d)",
+                 value, expected, where, pixel, c);
+        failed = text;
+        return false;
+      }
+    }
+  return true;
+}
