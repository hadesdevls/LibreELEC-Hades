From b91d01a610d1e2303cf525fbe322cd078b13c7a3 Mon Sep 17 00:00:00 2001
From: Hades <15710513+hadesdevls@users.noreply.github.com>
Date: Thu, 26 Nov 2026 04:27:38 +0000
Subject: [PATCH] [Hades][Subtitles] Subtitles of a 3D output side by side or
 top and bottom keep their shape

In a 3D output side by side the subtitles went out twice as wide as
they should, and in top and bottom stretched: "HUGE and distorted",
since Kodi 20.

Kodi's pixel ratio of a resolution is the width of a pixel over its
height as it is shown (CResolutionInfo: the aspect of the display over
that of its pixels); for each eye of a 3D output it is 2 side by side
and 0.5 top and bottom (CGraphicContext::ResInfo()). libass takes the
same: its pixel aspect ratio is 1 for square pixels and more than 1 for
wider ones, whose glyphs it draws that much narrower, and 0 for its own
default (ass_set_pixel_aspect(), libass 0.17.5). Kodi turned the ratio
around as 2 - ratio, which is right for square pixels only: side by
side it gave 0, libass's default, and each eye's glyphs were drawn as
on square pixels and shown twice as wide; top and bottom it gave 1.5
for 2.

libass is now given Kodi's ratio as it is (LibassPixelAspect(), with a
ratio that is not known taken as square). In 2D on square pixels
nothing changes; a resolution whose pixels are not square (4096x2160
on a 16:9 display) gets its glyphs the right way round too.
---
 .../DVDSubtitles/DVDSubtitlesLibass.cpp        |  9 ++++-----
 .../VideoPlayer/DVDSubtitles/SubtitlesStyle.h  | 18 ++++++++++++++++++
 2 files changed, 22 insertions(+), 5 deletions(-)

diff --git a/xbmc/cores/VideoPlayer/DVDSubtitles/DVDSubtitlesLibass.cpp b/xbmc/cores/VideoPlayer/DVDSubtitles/DVDSubtitlesLibass.cpp
index acc1722..4e723e1 100644
--- a/xbmc/cores/VideoPlayer/DVDSubtitles/DVDSubtitlesLibass.cpp
+++ b/xbmc/cores/VideoPlayer/DVDSubtitles/DVDSubtitlesLibass.cpp
@@ -348,11 +348,10 @@ ASS_Image* CDVDSubtitlesLibass::RenderImage(double pts,
     m_appliedStyle = subStyle;
   }
 
-  // Reversed par value
-  // from: >1 tighter pixels, <1 wider pixels
-  // to: <1 tighter pixels, >1 wider pixels
-  float par = (opts.m_par - 2.0f) * -1;
-  ass_set_pixel_aspect(m_renderer, static_cast<double>(par));
+  // Hades: the pixel aspect ratio as Kodi has it, which libass takes as it is: turned around as
+  // 2 - ratio, the subtitles of a 3D output side by side went out twice as wide, and those of top
+  // and bottom stretched (LibassPixelAspect())
+  ass_set_pixel_aspect(m_renderer, LibassPixelAspect(opts.m_par));
 
   ass_set_frame_size(m_renderer, static_cast<int>(opts.frameWidth),
                      static_cast<int>(opts.frameHeight));
diff --git a/xbmc/cores/VideoPlayer/DVDSubtitles/SubtitlesStyle.h b/xbmc/cores/VideoPlayer/DVDSubtitles/SubtitlesStyle.h
index cf0c53d..a325681 100644
--- a/xbmc/cores/VideoPlayer/DVDSubtitles/SubtitlesStyle.h
+++ b/xbmc/cores/VideoPlayer/DVDSubtitles/SubtitlesStyle.h
@@ -130,6 +130,24 @@ struct renderOpts
   HorizontalAlign horizontalAlignment = HorizontalAlign::DISABLED;
 };
 
+/*!
+ * \brief Hades: the pixel aspect ratio that libass is given (ass_set_pixel_aspect()) for Kodi's
+ *        pixel ratio of the resolution (renderOpts::m_par, RESOLUTION_INFO::fPixelRatio)
+ *
+ * Both are the width of a pixel over its height as it is shown: Kodi's is the aspect of the
+ * display over that of its pixels (CResolutionInfo), more than 1 where they are shown wider than
+ * tall; libass draws its glyphs that much narrower (1 square, 0 its own default). In a 3D output
+ * the pixels of each eye are shown twice as wide (side by side: 2) or twice as tall (top and
+ * bottom: 0.5), CGraphicContext::GetResInfo(). The ratio was turned around as 2 - ratio, which is
+ * right for square pixels only: side by side it gave 0, libass's default, and the subtitles went
+ * out twice as wide; top and bottom 1.5 for 2, subtitles stretched. A ratio that is not known (0
+ * or less) is square.
+ */
+constexpr double LibassPixelAspect(float pixelRatio)
+{
+  return pixelRatio > 0.0f ? static_cast<double>(pixelRatio) : 1.0;
+}
+
 } // namespace STYLE
 } // namespace SUBTITLES
 } // namespace KODI
