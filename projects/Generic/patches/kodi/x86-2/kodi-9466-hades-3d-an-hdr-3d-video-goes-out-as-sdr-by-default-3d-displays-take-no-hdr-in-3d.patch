@@ -37,9 +37,13 @@ namespace STEREO3D
  * is no picture by itself, goes out in 3D so, rebuilt as HDR10 or mapped to SDR.
  *
  * Choice: videoscreen.hades3dcolour, how a 3D video goes out, for those who try what a 3D TV or
- * projector takes. Automatic (the default) is what Hades sends without the setting: HDR where the
- * display takes the HDR of the video, SDR otherwise, in the gamut of "HDR to SDR: gamut of the
- * output". The others ask for HDR, SDR in BT.2020 or SDR in BT.709 for every HDR video in 3D.
+ * projector takes. Automatic (the default): SDR, in the gamut of "HDR to SDR: gamut of the output"
+ * (Hades, 1.2.2: before, HDR where the display takes the HDR of the video). 3D TVs and projectors
+ * take no HDR in 3D, whatever their EDID says of HDR, which it says of 2D only: a projector that
+ * takes HDR10 refused the 3D mode of an HDR10 picture with "3D settings are not supported in HDR
+ * video", and nothing the display sends tells that beforehand. SDR is what every 3D display shows,
+ * as 3D Blu-ray discs are. The others ask for HDR (for a display that takes HDR in 3D), SDR in
+ * BT.2020 or SDR in BT.709 for every HDR video in 3D.
  */
 
 //! The values of videoscreen.hades3dcolour
@@ -70,26 +74,26 @@ constexpr const char* ChoiceName(Choice choice)
     case Choice::SDR_BT709:
       return "SDR in BT.709";
     default:
-      return "Automatic";
+      return "Automatic: SDR, which every 3D display shows (3D displays take no HDR in 3D)";
   }
 }
 
+//! The choice sends HDR 3D video as SDR: every choice but HDR (Hades, 1.2.2: Automatic too)
 constexpr bool ChoosesSdr(Choice choice)
 {
-  return choice == Choice::SDR_BT2020 || choice == Choice::SDR_BT709;
+  return choice != Choice::HDR;
 }
 
 /*!
  * \brief Whether an HDR picture of a 3D video goes out as SDR on an output that takes its HDR
- * \param settingSaysSdr what "Play HDR videos as SDR" says of it (DVBRIDGE::HdrAsSdrFor())
  *
- * The choice for 3D is about 3D video, so it stands for that setting there; Automatic leaves it to
- * the setting. (The user's choice for the video itself, "As SDR", stands for both: the caller asks
- * it first.)
+ * The choice for 3D is about 3D video, so it stands for "Play HDR videos as SDR" there, Automatic
+ * included (ChoosesSdr()). (The user's choice for the video itself, "As SDR", stands for both: the
+ * caller asks it first.)
  */
-constexpr bool AsSdr(Choice choice, bool settingSaysSdr)
+constexpr bool AsSdr(Choice choice)
 {
-  return choice == Choice::AUTOMATIC ? settingSaysSdr : ChoosesSdr(choice);
+  return ChoosesSdr(choice);
 }
 
