From 29a23cf298fe3b9a0b21a8a78157c9aceaf78d71 Mon Sep 17 00:00:00 2001
From: Hades <15710513+hadesdevls@users.noreply.github.com>
Date: Wed, 25 Nov 2026 06:38:54 +0000
Subject: [PATCH] [Hades][GBM] 3D: a picture where the eyes are split is mapped
 by the rules of 2D, in Automatic too

The bridge draws a 3D picture a view at a time, each eye value for value
the same picture as in 2D. With "How 3D video goes out" at Automatic and
SDR in BT.709 (the defaults), it took only the pictures whose base
layer is no picture by itself; an HDR10 or HLG 3D video that went out as
SDR was then tone mapped by Kodi's own shaders (Hable), while the same
video in 2D is mapped by the bridge with the tone mapping method of the
video, the reference method (BT.2390) by default. 3D was mapped worse
than 2D by default.

BridgeTakes() now takes every picture where the eyes are split, as the
same picture in 2D, and the rules of 2D decide how it goes out: HDR
passed through where the display takes it; mapped to SDR by the method
of the video, by the bridge with the reference methods and by Kodi's
shaders with Kodi's own; Dolby Vision rebuilt where 2D rebuilds it. The
choice for 3D and the gamut of SDR decide what the picture goes out as,
not who draws it, so StereoBridgeTakes() no longer reads them. Where
the eyes are put into one picture (anaglyph, interlaced, checkerboard),
Kodi's own way, which draws through the masks, as before.
---
 xbmc/utils/Stereo3DVideo.h                     | 18 ++++++++----------
 xbmc/windowing/gbm/WinSystemGbmGLESContext.cpp |  4 ++--
 xbmc/windowing/gbm/WinSystemGbmGLESStereo.cpp  | 13 +++----------
 3 files changed, 13 insertions(+), 22 deletions(-)

diff --git a/xbmc/utils/Stereo3DVideo.h b/xbmc/utils/Stereo3DVideo.h
index e0cfe7f..f54b346 100644
--- a/xbmc/utils/Stereo3DVideo.h
+++ b/xbmc/utils/Stereo3DVideo.h
@@ -123,19 +123,17 @@ constexpr bool SplitsEyes(RenderStereoMode mode)
  *        compatibility 0): shown as it is its colours are wrong, so the bridge draws it whatever
  *        the way of showing it (in a way that mixes the eyes, the view of the left eye alone, in
  *        2D: the bridge's copy into the window takes no mask)
- * \param container what Container() gives for it
  *
- * Any other picture only where the eyes are not mixed, and where the user asked for it: SDR chosen
- * for 3D, or a gamut of SDR wider than BT.709. Automatic with BT.709, the default, keeps the 3D
- * that Hades drew before: HDR passed through, or Kodi's own tone mapping.
+ * Any other picture where the eyes are not mixed, as the same picture in 2D is: the rules of 2D then
+ * decide whether and how it is drawn (HDR passed through where the display takes it; mapped to SDR
+ * by the tone mapping method of the video, the reference method of the bridge by default, by Kodi's
+ * shaders with Kodi's own methods), in Automatic too, so that a 3D video is never mapped otherwise
+ * than in 2D. (Automatic with BT.709 kept Kodi's own tone mapping for 3D at first, which is not the
+ * default of 2D.) Where the eyes are mixed, Kodi's own way, which draws through the masks.
  */
-constexpr bool BridgeTakes(bool noPicture, Choice choice, int container, RenderStereoMode mode)
+constexpr bool BridgeTakes(bool noPicture, RenderStereoMode mode)
 {
-  if (noPicture)
-    return true;
-  if (MixesEyes(mode))
-    return false;
-  return ChoosesSdr(choice) || container != 0;
+  return noPicture || !MixesEyes(mode);
 }
 
 //! How the two views of a 3D picture lie in it: the layouts that Kodi draws each eye from a half
diff --git a/xbmc/windowing/gbm/WinSystemGbmGLESContext.cpp b/xbmc/windowing/gbm/WinSystemGbmGLESContext.cpp
index 8f4a099..07d9cc7 100644
--- a/xbmc/windowing/gbm/WinSystemGbmGLESContext.cpp
+++ b/xbmc/windowing/gbm/WinSystemGbmGLESContext.cpp
@@ -3745,8 +3745,8 @@ DVBRIDGE::ConversionTarget DVBRIDGE::ConversionTargetOf(const CDVDStreamInfo& st
   // Hades: a 3D video (KODI::UTILS::STEREO3D): mapped to SDR where the choice for 3D video asks for SDR and none was
   // made for the video itself (as the user's choice of SDR for a video does), and reconstructed where the bridge
   // draws its pictures a view at a time (StereoBridgeTakes(): one whose base layer is no picture by itself, a Dolby
-  // Vision 3D film of profile 20; another only where SDR was asked for). Every other 3D video as before: not
-  // reconstructed. Its two views decoded (MV-HEVC) come side by side, each of the stream's own size.
+  // Vision 3D film of profile 20, in any way of showing 3D; another where the eyes are not mixed, by the rules of 2D).
+  // Its two views decoded (MV-HEVC) come side by side, each of the stream's own size.
   const bool stereo = !stream.stereo_mode.empty() && stream.stereo_mode != "mono";
   bool stereoKept = stereo;
   if (stereo)
diff --git a/xbmc/windowing/gbm/WinSystemGbmGLESStereo.cpp b/xbmc/windowing/gbm/WinSystemGbmGLESStereo.cpp
index fb941a9..d1bd80c 100644
--- a/xbmc/windowing/gbm/WinSystemGbmGLESStereo.cpp
+++ b/xbmc/windowing/gbm/WinSystemGbmGLESStereo.cpp
@@ -66,16 +66,9 @@ bool CWinSystemGbmGLESContext::StereoBridgeTakes(bool noPicture,
       viewWidth > DVBRIDGE::SOURCE_MAX_WIDTH || viewHeight > DVBRIDGE::SOURCE_MAX_HEIGHT ||
       !PartCopyAvailable())
     return false;
-  const S::Choice choice = Stereo3DChoice();
-  const auto component = CServiceBroker::GetSettingsComponent();
-  const auto settings = component ? component->GetSettings() : nullptr;
-  const int gamut =
-      settings && settings->GetSetting(CSettings::SETTING_VIDEOSCREEN_HADESSDRHDRGAMUT)
-          ? settings->GetInt(CSettings::SETTING_VIDEOSCREEN_HADESSDRHDRGAMUT)
-          : 0;
-  return S::BridgeTakes(
-      noPicture, choice, S::Container(choice, gamut),
-      const_cast<CWinSystemGbmGLESContext*>(this)->GetGfxContext().GetStereoMode());
+  // (the choice for 3D video and the gamut of SDR decide what the picture goes out as, as in 2D, not who draws it)
+  return S::BridgeTakes(noPicture,
+                        const_cast<CWinSystemGbmGLESContext*>(this)->GetGfxContext().GetStereoMode());
 }
 
 bool CWinSystemGbmGLESContext::StereoPictureTaken(const VideoPicture& picture, bool noPicture) const
