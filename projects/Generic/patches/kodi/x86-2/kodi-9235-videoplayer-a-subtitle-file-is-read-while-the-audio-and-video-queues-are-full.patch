From 8c3e32502f93cd37b714b3edb6943697200b6410 Mon Sep 17 00:00:00 2001
From: matthane <matthan.evans@icloud.com>
Date: Fri, 13 Nov 2026 17:29:36 +0000
Subject: [PATCH] VideoPlayer: a subtitle file is read while the audio and
 video queues are full

The packets of a subtitle file are read in ReadPacket(), before those of
the video, and only when the loop gets there: while the audio or video
queue is full, it waits and reads nothing. With the queues full most of
the time, a file of dense subtitles (external PGS or VobSub, a picture of
tens of kilobytes each) was fed slower than it was shown, and fell
seconds behind.

While the queues are full, the subtitle file is now read as long as the
subtitle player takes its packets, the queues stay full and no message
waits for the player (a seek, a stop, a change of stream), and each
packet goes where ReadPacket() sends it. DVDMessageQueue gets IsEmpty()
for that.

From matthane's change for CoreELEC (CoreELEC/xbmc commit 54a4a3f213,
"VideoPlayer: read external subtitles while the queues are full"), here
in a function of its own.
---
 xbmc/cores/VideoPlayer/DVDMessageQueue.cpp |  7 ++++
 xbmc/cores/VideoPlayer/DVDMessageQueue.h   |  2 +
 xbmc/cores/VideoPlayer/VideoPlayer.cpp     | 49 ++++++++++++++++++++--
 xbmc/cores/VideoPlayer/VideoPlayer.h       |  3 ++
 4 files changed, 58 insertions(+), 3 deletions(-)

diff --git a/xbmc/cores/VideoPlayer/DVDMessageQueue.cpp b/xbmc/cores/VideoPlayer/DVDMessageQueue.cpp
index 7fe0fa4..e2df765 100644
--- a/xbmc/cores/VideoPlayer/DVDMessageQueue.cpp
+++ b/xbmc/cores/VideoPlayer/DVDMessageQueue.cpp
@@ -301,6 +301,13 @@ unsigned CDVDMessageQueue::GetPacketCount(CDVDMsg::Message type)
   return count;
 }
 
+bool CDVDMessageQueue::IsEmpty() const
+{
+  std::unique_lock lock(m_section);
+
+  return m_messages.empty() && m_prioMessages.empty();
+}
+
 void CDVDMessageQueue::WaitUntilEmpty()
 {
   {
diff --git a/xbmc/cores/VideoPlayer/DVDMessageQueue.h b/xbmc/cores/VideoPlayer/DVDMessageQueue.h
index da83562..617489b 100644
--- a/xbmc/cores/VideoPlayer/DVDMessageQueue.h
+++ b/xbmc/cores/VideoPlayer/DVDMessageQueue.h
@@ -76,6 +76,8 @@ public:
   int GetDataSize() const { return m_iDataSize; }
   double GetTimeSize() const;
   unsigned GetPacketCount(CDVDMsg::Message type);
+  //! Hades: no message is queued (of any priority)
+  bool IsEmpty() const;
   bool ReceivedAbortRequest() { return m_bAbortRequest; }
   void WaitUntilEmpty();
 
diff --git a/xbmc/cores/VideoPlayer/VideoPlayer.cpp b/xbmc/cores/VideoPlayer/VideoPlayer.cpp
index 31fbd3f..35bf3fb 100644
--- a/xbmc/cores/VideoPlayer/VideoPlayer.cpp
+++ b/xbmc/cores/VideoPlayer/VideoPlayer.cpp
@@ -1600,6 +1600,40 @@ void CVideoPlayer::OpenDefaultStreams(bool reset)
   }
 }
 
+void CVideoPlayer::ReadSubtitleFileWhileFull(const std::function<bool()>& queuesFull)
+{
+  // as long as the queues stay full and no message waits (a seek, a stop, another stream)
+  while (m_pSubtitleDemuxer && !m_bAbortRequest && m_VideoPlayerSubtitle->AcceptsData() &&
+         m_messenger.IsEmpty() && queuesFull())
+  {
+    DemuxPacket* packet = m_pSubtitleDemuxer->Read();
+    if (!packet)
+      return;
+
+    UpdateCorrection(packet, m_offset_pts);
+    CDemuxStream* stream = nullptr;
+    if (packet->iStreamId >= 0)
+    {
+      stream = m_pSubtitleDemuxer->GetStream(packet->demuxerId, packet->iStreamId);
+      if (!stream)
+        CLog::Log(LOGERROR, "{} - Error demux packet doesn't belong to a valid stream",
+                  __FUNCTION__);
+    }
+    if (!stream)
+    {
+      CDVDDemuxUtils::FreeDemuxPacket(packet);
+      return;
+    }
+    if (stream->source == STREAM_SOURCE_NONE)
+    {
+      m_SelectionStreams.Clear(StreamType::NONE, STREAM_SOURCE_DEMUX_SUB);
+      m_SelectionStreams.Update(nullptr, m_pSubtitleDemuxer.get());
+      UpdateContent();
+    }
+    ProcessPacket(stream, packet);
+  }
+}
+
 bool CVideoPlayer::ReadPacket(DemuxPacket*& packet, CDemuxStream*& stream)
 {
 
@@ -2229,9 +2263,14 @@ void CVideoPlayer::Process()
 
     // If the queues are full, no need to read more, unless the full queue belongs
     // to a stream that replays: its replayed packets are dropped and never reach it
-    if ((!m_VideoPlayerAudio->AcceptsData() && m_CurrentAudio.id >= 0 &&
-         !m_CurrentAudio.replaying) ||
-        (!m_VideoPlayerVideo->AcceptsData() && m_CurrentVideo.id >= 0 && !m_CurrentVideo.replaying))
+    const auto queuesFull = [this]
+    {
+      return (!m_VideoPlayerAudio->AcceptsData() && m_CurrentAudio.id >= 0 &&
+              !m_CurrentAudio.replaying) ||
+             (!m_VideoPlayerVideo->AcceptsData() && m_CurrentVideo.id >= 0 &&
+              !m_CurrentVideo.replaying);
+    };
+    if (queuesFull())
     {
       if (m_playSpeed == DVD_PLAYSPEED_PAUSE &&
           m_demuxerSpeed != DVD_PLAYSPEED_PAUSE)
@@ -2241,6 +2280,10 @@ void CVideoPlayer::Process()
         m_demuxerSpeed = DVD_PLAYSPEED_PAUSE;
       }
       emptySince.reset();
+      // Hades: ... except a subtitle file, which is read only here (ReadPacket()) and otherwise
+      // only when the queues have room: with them full most of the time, dense PGS and VobSub fell
+      // seconds behind what was shown
+      ReadSubtitleFileWhileFull(queuesFull);
       CThread::Sleep(10ms);
       continue;
     }
diff --git a/xbmc/cores/VideoPlayer/VideoPlayer.h b/xbmc/cores/VideoPlayer/VideoPlayer.h
index b2448c4..6cd045e 100644
--- a/xbmc/cores/VideoPlayer/VideoPlayer.h
+++ b/xbmc/cores/VideoPlayer/VideoPlayer.h
@@ -582,6 +582,9 @@ protected:
   void SendPlayerMessage(std::shared_ptr<CDVDMsg> pMsg, unsigned int target);
 
   bool ReadPacket(DemuxPacket*& packet, CDemuxStream*& stream);
+  //! Hades: the packets of the subtitle file while the audio and video queues are full
+  //! (queuesFull()), as long as the subtitle player takes them and no message waits
+  void ReadSubtitleFileWhileFull(const std::function<bool()>& queuesFull);
   bool IsValidStream(const CCurrentStream& stream);
   bool IsBetterStream(const CCurrentStream& current, CDemuxStream* stream);
   void CheckBetterStream(CCurrentStream& current, CDemuxStream* stream);
