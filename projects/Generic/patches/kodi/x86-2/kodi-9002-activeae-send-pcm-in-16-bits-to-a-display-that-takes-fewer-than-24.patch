index 50ed459..bff9d7b 100644
--- a/xbmc/cores/AudioEngine/Engines/ActiveAE/ActiveAE.cpp
+++ b/xbmc/cores/AudioEngine/Engines/ActiveAE/ActiveAE.cpp
@@ -2522,6 +2522,11 @@ void CActiveAE::ApplySettingsToFormat(AEAudioFormat& format,
                 format.m_sampleRate);
     }
 
+    // Hades: 16 bits for a display that takes PCM of fewer than 24 bits (LimitBitsToDisplay()):
+    // the sink is asked for them, and does not fall back to more (CAESinkALSA::InitializeHW())
+    if (settings.pcmIn16Bits)
+      format.m_dataFormat = AE_FMT_S16NE;
+
     // sinks may not support mono
     if (format.m_channelLayout.Count() == 1)
     {
@@ -3829,6 +3834,7 @@ void CActiveAE::LoadSettings()
   m_settings.config = settings->GetInt(CSettings::SETTING_AUDIOOUTPUT_CONFIG);
   m_settings.channels = (m_sink.GetDeviceType(m_settings.device) == AE_DEVTYPE_IEC958) ? AE_CH_LAYOUT_2_0 : settings->GetInt(CSettings::SETTING_AUDIOOUTPUT_CHANNELS);
   LimitChannelsToDisplay();
+  LimitBitsToDisplay();
   m_settings.samplerate = settings->GetInt(CSettings::SETTING_AUDIOOUTPUT_SAMPLERATE);
 
   m_settings.stereoupmix = IsSettingVisible(CSettings::SETTING_AUDIOOUTPUT_STEREOUPMIX) ? settings->GetBool(CSettings::SETTING_AUDIOOUTPUT_STEREOUPMIX) : false;
@@ -4194,6 +4200,42 @@ void CActiveAE::LimitChannelsToDisplay()
   m_settings.channels = limited;
 }
 
+// Hades: PCM goes out in 16 bits to a display that declares PCM of fewer than 24 bits
+// (AE::PCM::PcmIn16Bits(): a TV that declares 16 and 20 bits stayed silent with the 32-bit format,
+// in which the HDA HDMI codec sends it 20). A display that declares 20 bits gets 16, the most that
+// every display with audio takes. By the same audio data as the channels (DisplayAudioOf(): kept
+// through a change of display mode), and turned off by the same "Limit PCM channels to what the
+// display declares" (audiooutput.hadespcmlimit), for a display that takes more than it says.
+void CActiveAE::LimitBitsToDisplay()
+{
+  const auto component = CServiceBroker::GetSettingsComponent();
+  const auto advanced = component ? component->GetAdvancedSettings() : nullptr;
+  const auto settings = component ? component->GetSettings() : nullptr;
+  const bool fromDisplay = (!advanced || advanced->m_audioPcmChannelsFromEld) &&
+                           (!settings || settings->GetBool(CSettings::SETTING_AUDIOOUTPUT_HADESPCMLIMIT));
+  bool kept = false;
+  const unsigned int bits = fromDisplay ? DisplayAudioOf(m_settings.device, &kept).pcmBits : 0;
+  m_settings.pcmIn16Bits = AE::PCM::PcmIn16Bits(bits);
+  // in the log when it changes
+  const std::string told = m_settings.pcmIn16Bits ? m_settings.device + '|' +
+                                                        std::to_string(bits) + (kept ? "|kept" : "")
+                                                  : std::string();
+  if (told != m_bitsLimitTold)
+  {
+    m_bitsLimitTold = told;
+    if (!told.empty())
+      CLog::Log(LOGINFO,
+                "ActiveAE - the display of '{}' takes PCM of {} bits at most ({}): PCM goes out in "
+                "16 bits, which every display with audio takes, not in the 32-bit format of the "
+                "output (a display that declares 20 bits gets 16; \"Limit PCM channels to what the "
+                "display declares\" off sends what the output offers)",
+                m_settings.device, bits,
+                kept ? "the audio data it had last: it has none at this moment, as during a "
+                       "change of display mode"
+                     : "its audio data");
+  }
+}
+
 AE::PCM::DisplayAudio CActiveAE::DisplayAudioOf(const std::string& device, bool* kept)
 {
   if (kept)
