   CAEStreamInfo::DataType dolbyForDisplay{CAEStreamInfo::STREAM_TYPE_NULL};
+  //! Hades: PCM goes out in 16 bits: the display of the device takes PCM of fewer than 24 bits
+  //! (CActiveAE::LimitBitsToDisplay())
+  bool pcmIn16Bits{false};
 };
 
