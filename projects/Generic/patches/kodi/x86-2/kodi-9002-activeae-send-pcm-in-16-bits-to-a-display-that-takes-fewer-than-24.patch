+/*!
+ * \brief The most bits per sample of linear PCM that short audio descriptors declare, as the HDA
+ * HDMI codec of Linux takes them (snd_hdmi_eld_update_pcm_info(), sound/hda/codecs/hdmi/eld.c):
+ * 16, which every display with audio takes, raised to 20 or 24 by an LPCM descriptor that declares
+ * them (its third byte: bit 0 16 bits, bit 1 20, bit 2 24)
+ * \return 16, 20 or 24; 0 when there are no descriptors (not known)
+ */
+constexpr unsigned int MaxBitsOfSads(const uint8_t* sads, size_t count)
+{
+  if (!sads || count == 0)
+    return 0;
+
+  unsigned int most = 16;
+  for (size_t i = 0; i < count; ++i)
+  {
+    if (((sads[3 * i] >> 3) & 0xF) != FORMAT_LPCM)
+      continue;
+    const uint8_t sizes = sads[3 * i + 2];
+    if ((sizes & 0x4) && most < 24)
+      most = 24;
+    else if ((sizes & 0x2) && most < 20)
+      most = 20;
+  }
+  return most;
+}
+
+/*!
+ * \brief Whether decoded sound goes out as PCM of 16 bits to a display, by the most bits per sample
+ * of linear PCM that it declares (MaxBitsOfSads())
+ *
+ * The HDA HDMI codec offers a 32-bit format (S32_LE) wherever an LPCM descriptor declares 20 or 24
+ * bits, and sends the display as many bits of it as the descriptors declare at most: 20 for a
+ * display that declares 16 and 20 (snd_hdac_stream_format_bits()). Kodi took the widest format
+ * that the output offers. A Philips TV that declares PCM of 16 and 20 bits stayed silent with it,
+ * and the controller of the PC logged "stream 7 dma error: 0x28" (FIFO errors) while it played;
+ * 16 bits played (issue #23, 2026-11-13: speaker-test with S16_LE sounded, with S32_LE not). A
+ * display that declares 24 bits is as before, and so is one whose audio data are not known.
+ * \return true for a display that declares 16 or 20 bits at most
+ */
+constexpr bool PcmIn16Bits(unsigned int displayBits)
+{
+  return displayBits > 0 && displayBits < 24;
+}
+
+/*!
+ * \brief Whether an output offers a sample format of PCM to a display (CAESinkALSA::EnumerateDevice())
+ * \param formatBits the bits of the format (CAEUtil::DataFormatToBits())
+ * \param displayBits the most bits per sample that the display declares (MaxBitsOfSads()); 0, not
+ *        known
+ */
+constexpr bool FormatFitsDisplay(unsigned int formatBits, unsigned int displayBits)
+{
+  return !PcmIn16Bits(displayBits) || formatBits <= 16;
+}
+
 /*!
  * \brief Where the short audio descriptors of an ELD are (version 2, CEA-861-D, as the HDA HDMI
  * codec reads it)
@@ -146,6 +201,8 @@ struct DisplayAudio
