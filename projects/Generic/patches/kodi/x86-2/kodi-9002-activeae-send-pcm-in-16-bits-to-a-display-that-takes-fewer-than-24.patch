+TEST(TestAEPcmChannels, TheMostBitsOfTheLpcmDescriptors)
+{
+  EXPECT_EQ(20u, MaxBitsOfSads(PHILIPS_23.data(), PHILIPS_23.size() / 3));
+  EXPECT_EQ(24u, MaxBitsOfSads(LG_C5_32.data(), LG_C5_32.size() / 3));
+  EXPECT_EQ(24u, MaxBitsOfSads(ULTRAGEAR.data(), ULTRAGEAR.size() / 3));
+  EXPECT_EQ(24u, MaxBitsOfSads(LG_2.data(), LG_2.size() / 3));
+  // 16 bits only, and no LPCM descriptor (basic audio): 16, which the codec offers alone then
+  const std::vector<uint8_t> only16 = {0x09, 0x07, 0x01, 0x15, 0x07, 0x50};
+  EXPECT_EQ(16u, MaxBitsOfSads(only16.data(), 2));
+  const std::vector<uint8_t> compressed = {0x15, 0x07, 0x50, 0x57, 0x04, 0x03};
+  EXPECT_EQ(16u, MaxBitsOfSads(compressed.data(), 2));
+  // the third byte of a descriptor of another format is not a sample size (an AC-3 of 640 kb/s
+  // has 0x50 there): not counted
+  const std::vector<uint8_t> ac3After16 = {0x09, 0x07, 0x01, 0x15, 0x07, 0x54};
+  EXPECT_EQ(16u, MaxBitsOfSads(ac3After16.data(), 2));
+  // the most of several LPCM descriptors
+  const std::vector<uint8_t> two = {0x09, 0x07, 0x03, 0x0f, 0x07, 0x07};
+  EXPECT_EQ(24u, MaxBitsOfSads(two.data(), 2));
+  // not known
+  EXPECT_EQ(0u, MaxBitsOfSads(nullptr, 2));
+  EXPECT_EQ(0u, MaxBitsOfSads(PHILIPS_23.data(), 0));
+  const std::vector<uint8_t> none = Eld("TV", {});
+  EXPECT_EQ(0u, DisplayAudioOfEld(none.data(), none.size()).pcmBits);
+}
+
+TEST(TestAEPcmChannels, PcmIn16BitsOnlyForADisplayOfFewerThan24)
+{
+  // issue #23: the Philips TV (16 and 20 bits) gets 16
+  const std::vector<uint8_t> philips = Eld("PHILIPS FTV", PHILIPS_23);
+  EXPECT_TRUE(PcmIn16Bits(DisplayAudioOfEld(philips.data(), philips.size()).pcmBits));
+  // the LG C5 and every other display of the reports, which declare 24, as before
+  for (const auto& sads : {LG_C5_32, ULTRAGEAR, LG_2, LG_8, BAR, HISENSE})
+  {
+    const std::vector<uint8_t> eld = Eld("TV", sads);
+    EXPECT_FALSE(PcmIn16Bits(DisplayAudioOfEld(eld.data(), eld.size()).pcmBits));
+  }
+  // 16 only: 16 (the codec offers nothing else then); not known: as before
+  EXPECT_TRUE(PcmIn16Bits(16));
+  EXPECT_FALSE(PcmIn16Bits(0));
+  EXPECT_FALSE(PcmIn16Bits(24));
+}
+
+TEST(TestAEPcmChannels, TheFormatsOfferedToADisplay)
+{
+  // the bits of CAEUtil::DataFormatToBits(): U8 8, S16 16, S24 in 3 or 4 bytes 24, S32 and float 32
+  for (const unsigned int display : {0u, 24u})
+  {
+    for (const unsigned int format : {8u, 16u, 24u, 32u})
+      EXPECT_TRUE(FormatFitsDisplay(format, display)) << format << " to " << display;
+  }
+  for (const unsigned int display : {16u, 20u})
+  {
+    EXPECT_TRUE(FormatFitsDisplay(8, display));
+    EXPECT_TRUE(FormatFitsDisplay(16, display));
+    EXPECT_FALSE(FormatFitsDisplay(24, display));
+    EXPECT_FALSE(FormatFitsDisplay(32, display));
+  }
+}
+
+TEST(TestAEPcmChannels, TheBitsKeptWhileTheDisplayIsAway)
+{
+  // the bits go with the rest of the audio data through a change of display mode
+  DisplayAudio kept;
+  const std::vector<uint8_t> eld = Eld("PHILIPS FTV", PHILIPS_23);
+  KeepWhileAway(DisplayAudioOfEld(eld.data(), eld.size()), true, kept);
+  EXPECT_TRUE(PcmIn16Bits(KeepWhileAway({}, false, kept).pcmBits));
+  const std::vector<uint8_t> lg = Eld("LG TV SSCR2", LG_C5_32);
+  EXPECT_FALSE(PcmIn16Bits(KeepWhileAway(DisplayAudioOfEld(lg.data(), lg.size()), true, kept).pcmBits));
+}
