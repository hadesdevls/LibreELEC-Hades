+  void LimitBitsToDisplay();
   //! Hades: the audio data of the display of an output (AE::PCM::KeepWhileAway()): those of the
   //! last listing of the outputs, or, while its display is away (a change of display mode), the
   //! last ones read from it in this run
@@ -446,6 +452,8 @@ protected:
   //! What LimitChannelsToDisplay() last logged (device, setting and channels), empty when it did
   //! not limit anything
   std::string m_channelsLimitTold;
+  //! What LimitBitsToDisplay() last logged (device and bits), empty when it did not limit anything
+  std::string m_bitsLimitTold;
   //! The audio data of the display of each output, the last ones read from a display of it in this
   //! run (DisplayAudioOf()), by "driver:name"
   std::map<std::string, AE::PCM::DisplayAudio> m_keptDisplayAudio;
