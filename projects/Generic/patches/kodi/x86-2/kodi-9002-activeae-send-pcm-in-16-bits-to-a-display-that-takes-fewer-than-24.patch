@@ -812,6 +813,11 @@ bool CAESinkALSA::InitializeHW(const ALSAConfig &inconfig, ALSAConfig &outconfig
       if (m_passthrough && i != AE_FMT_S16BE && i != AE_FMT_S16LE)
 	continue;
 
