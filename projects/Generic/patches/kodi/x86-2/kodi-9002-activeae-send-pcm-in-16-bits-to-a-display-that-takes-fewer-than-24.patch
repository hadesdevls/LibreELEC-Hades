+        continue;
+
       fmt = AEFormatToALSAFormat(i);
       if (fmt == SND_PCM_FORMAT_UNKNOWN)
         continue;
@@ -1765,7 +1771,10 @@ void CAESinkALSA::EnumerateDevice(AEDeviceInfoList &list, const std::string &dev
     if (fmt == SND_PCM_FORMAT_UNKNOWN)
       continue;
 
-    if (snd_pcm_hw_params_test_format(pcmhandle, hwparams, fmt) >= 0)
+    // Hades: none of more than 16 bits for a display that takes PCM of fewer than 24 bits (its
+    // ELD, read above: AE::PCM::FormatFitsDisplay())
+    if (snd_pcm_hw_params_test_format(pcmhandle, hwparams, fmt) >= 0 &&
+        AE::PCM::FormatFitsDisplay(CAEUtil::DataFormatToBits(i), info.m_maxPcmBits))
       info.m_dataFormats.push_back(i);
   }
 
