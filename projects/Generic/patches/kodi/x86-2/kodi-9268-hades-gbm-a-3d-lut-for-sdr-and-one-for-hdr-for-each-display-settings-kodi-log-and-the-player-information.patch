+#pragma once
+
+#include <algorithm>
+#include <cstddef>
+#include <sstream>
+#include <string>
+#include <tuple>
+#include <vector>
+
+/*!
+ * \file
+ * \brief Hades: the 3D LUT of a display (videoscreen.hadeslut3d*): which LUT, if any, a picture takes, and why not.
+ *
+ * A calibration is of one display in one mode: a LUT for SDR and one for HDR are kept for each display, by the make
+ * and model of its EDID (DISPLAY_MODES::Key()), in special://profile/hades-display-luts.txt (CDisplayLutMemory). The
+ * settings show the LUTs of the display that Kodi shows on; a LUT chosen there is that display's.
+ *
+ * The bridge applies the LUT as the last step of the colour of what Hades maps to the display, where the signal that
+ * goes out is the one the LUT corrects (dvbridge_render_set_lut()):
+ *   - SDR: HDR10, HDR10+, HLG and Dolby Vision mapped to SDR (a projector, a display without HDR, "Play HDR videos as
+ *     SDR"), and the SDR videos that the bridge draws with an upscaler;
+ *   - HDR: HDR10 and HDR10+ adapted to the display, Dolby Vision as HDR10 mapped to the display (both the projector's
+ *     way), and Dolby Vision Low-Latency (the player maps it to the display).
+ * Never: native Dolby Vision that the TV maps (TV-led: the tunnel is bit-exact and the TV's own processing comes after
+ * it), HDR that goes out for the display to map itself (passthrough, Dolby Vision as HDR10 not mapped, HDR over the
+ * tunnel: the display's tone mapping comes after the LUT and changes with each film's metadata, so that no LUT made for
+ * the display holds there; "adapt to my display" is the way for a calibrated HDR display), and the pictures that
+ * Kodi's own renderer draws (SDR videos without an upscaler): each is said, never passed over in silence.
+ *
+ * A LUT whose file says what it was made for (madVR's: its transfer and primaries) is refused for another kind of
+ * picture (a LUT of PQ for SDR, of SDR for HDR; SDR of another gamut than the SDR output's); a .cube or .3dl, which
+ * say nothing, is taken to be made for the kind it is chosen for, and an SDR one for the gamut that
+ * videoscreen.hadeslut3dsdrgamut says (BT.709 by default). Pure logic: a host test runs it (tools/regress of
+ * LibreELEC, kodi-host: display_lut_test.cpp).
+ */
+namespace KODI::WINDOWING::GBM::DISPLAY_LUT
+{
+
+//! The two LUTs of a display
+enum class Kind
+{
+  SDR = 0,
+  HDR = 1,
+};
+
+inline const char* KindName(Kind kind)
+{
+  return kind == Kind::SDR ? "sdr" : "hdr";
+}
+
+//! What a picture goes out as, and who maps it
+enum class Output
+{
+  NONE, //!< no video (nothing to say)
+  SDR_MAPPED, //!< HDR or Dolby Vision mapped to SDR by the bridge
+  SDR_AS_IS, //!< an SDR video drawn by the bridge (an upscaler)
+  HDR_MAPPED, //!< HDR10 adapted, or Dolby Vision as HDR10 mapped, to the display by the bridge
+  DV_LOW_LATENCY, //!< Dolby Vision Low-Latency (the bridge maps it to the display)
+  DV_TV_LED, //!< native Dolby Vision that the TV maps
+  HDR_DISPLAY_MAPS, //!< HDR that the display maps itself (passthrough, not mapped, over the tunnel)
+  KODI_SDR, //!< an SDR video drawn by Kodi's own renderer
+  KODI_HDR, //!< an HDR video drawn by Kodi's own renderer (passthrough or Kodi's tone mapping)
+};
+
+//! Why a LUT is not applied (NONE: it is, or there is nothing to say)
+enum class Reason
+{
+  NONE = 0,
+  APPLIED, //!< applied
+  OFF, //!< the setting is off, or no LUT of this kind is chosen for this display (nothing is said on screen)
+  TV_LED, //!< native Dolby Vision that the TV maps
+  DISPLAY_MAPS, //!< HDR that the display maps itself
+  KODI_RENDERER, //!< drawn by Kodi's own renderer
+  OTHER_KIND, //!< the file says it was made for another kind of picture (or the SDR LUT for another gamut)
+  UNREADABLE, //!< the file could not be read (its reason in kodi.log)
+  GPU_FAILED, //!< this GPU could not draw it
+};
+
+//! The kind of LUT that an output takes, and whether the bridge draws it at all
+struct Take
+{
+  bool lut = false; //!< a LUT of this kind is applied to it (where one is chosen)
+  Kind kind = Kind::SDR;
+  Reason why = Reason::NONE; //!< where lut is false: why none is
+};
+
+inline Take TakeOf(Output output)
+{
+  switch (output)
+  {
+    case Output::SDR_MAPPED:
+    case Output::SDR_AS_IS:
+      return {true, Kind::SDR, Reason::NONE};
+    case Output::HDR_MAPPED:
+    case Output::DV_LOW_LATENCY:
+      return {true, Kind::HDR, Reason::NONE};
+    case Output::DV_TV_LED:
+      return {false, Kind::HDR, Reason::TV_LED};
+    case Output::HDR_DISPLAY_MAPS:
+      return {false, Kind::HDR, Reason::DISPLAY_MAPS};
+    case Output::KODI_SDR:
+      return {false, Kind::SDR, Reason::KODI_RENDERER};
+    case Output::KODI_HDR:
+      return {false, Kind::HDR, Reason::KODI_RENDERER};
+    case Output::NONE:
+    default:
+      return {false, Kind::SDR, Reason::NONE};
+  }
+}
+
+//! What a LUT file says it was made for (dvbridge_lut.h: DVBRIDGE_LUT_SIGNAL_*, DVBRIDGE_LUT_GAMUT_*)
+enum Signal
+{
+  SIGNAL_UNKNOWN = 0,
+  SIGNAL_SDR = 1,
+  SIGNAL_PQ = 2,
+  SIGNAL_HLG = 3,
+};
+enum Gamut
+{
+  GAMUT_UNKNOWN = 0,
+  GAMUT_BT709 = 1,
+  GAMUT_P3_D65 = 2,
+  GAMUT_BT2020 = 3,
+};
+
+//! The gamut of an SDR output, as videoscreen.hadessdrhdrgamut and videoscreen.hadeslut3dsdrgamut number it
+//! (0 BT.709, 1 BT.2020, 2 DCI-P3 (D65))
+inline Gamut GamutOfSetting(int value)
+{
+  return value == 1 ? GAMUT_BT2020 : value == 2 ? GAMUT_P3_D65 : GAMUT_BT709;
+}
+
+/*!
+ * \brief Whether a LUT fits the output of a kind (Reason::NONE) or not (Reason::OTHER_KIND, and what it is said
+ *        for, in English, into why)
+ * \param signal, gamut what the file says (SIGNAL_UNKNOWN, GAMUT_UNKNOWN: it says nothing)
+ * \param sdrMadeFor of an SDR LUT whose file says nothing: the gamut that videoscreen.hadeslut3dsdrgamut says
+ * \param sdrOutput the gamut of the SDR output (the container of HDR mapped to SDR; BT.709 for any other SDR)
+ */
+inline Reason Fits(Kind kind, int signal, int gamut, Gamut sdrMadeFor, Gamut sdrOutput, std::string* why = nullptr)
+{
+  const auto say = [why](const std::string& text) {
+    if (why)
+      *why = text;
+    return Reason::OTHER_KIND;
+  };
+  if (kind == Kind::HDR)
+  {
+    // the HDR output that the bridge maps is PQ in BT.2020 (HDR10, Low-Latency)
+    if (signal == SIGNAL_SDR)
+      return say("the file says it is a LUT of SDR, and the picture goes out as HDR (PQ)");
+    if (signal == SIGNAL_HLG)
+      return say("the file says it is a LUT of HLG, and the picture goes out as HDR10 (PQ)");
+    if (gamut != GAMUT_UNKNOWN && gamut != GAMUT_BT2020)
+      return say("the file says its primaries are not BT.2020, the container of HDR10");
+    return Reason::NONE;
+  }
+  if (signal == SIGNAL_PQ || signal == SIGNAL_HLG)
+    return say(signal == SIGNAL_PQ ? "the file says it is a LUT of PQ (HDR), and the picture goes out as SDR"
+                                   : "the file says it is a LUT of HLG, and the picture goes out as SDR");
+  const Gamut madeFor = gamut != GAMUT_UNKNOWN ? static_cast<Gamut>(gamut) : sdrMadeFor;
+  if (madeFor != sdrOutput)
+  {
+    static const char* const names[4] = {"?", "BT.709", "DCI-P3", "BT.2020"};
+    return say(std::string("the LUT is made for SDR in ") + names[madeFor] + (gamut != GAMUT_UNKNOWN ? " (its file says so)" : " (the setting says so)") +
+               ", and the SDR picture goes out in " + names[sdrOutput]);
+  }
+  return Reason::NONE;
+}
+
+//! The name of a file without its folders (what the player information says)
+inline std::string FileName(const std::string& path)
+{
+  const size_t slash = path.find_last_of("/\\");
+  return slash == std::string::npos ? path : path.substr(slash + 1);
+}
+
+/*!
+ * \brief The LUTs of each display: lines of "key<TAB>sdr|hdr<TAB>path"; anything else is left out. The displays used
+ *        last are kept, LIMIT of them.
+ */
+class CDisplayLutMemory
+{
+public:
+  static constexpr size_t LIMIT = 32;
+
+  void Parse(const std::string& text)
+  {
+    m_luts.clear();
+    std::istringstream lines(text);
+    std::string line;
+    while (std::getline(lines, line))
+    {
+      if (!line.empty() && line.back() == '\r')
+        line.pop_back();
+      const size_t a = line.find('\t');
+      const size_t b = a == std::string::npos ? a : line.find('\t', a + 1);
+      if (a == std::string::npos || b == std::string::npos || a == 0 || b + 1 >= line.size() ||
+          line.find('\t', b + 1) != std::string::npos)
+        continue;
+      const std::string kind = line.substr(a + 1, b - a - 1);
+      if (kind != "sdr" && kind != "hdr")
+        continue;
+      Put(line.substr(0, a), kind == "sdr" ? Kind::SDR : Kind::HDR, line.substr(b + 1));
+    }
+  }
+
+  std::string Text() const
+  {
+    std::string text;
+    for (const auto& [key, kind, path] : m_luts)
+      text += key + '\t' + KindName(kind) + '\t' + path + '\n';
+    return text;
+  }
+
+  //! The LUT of a kind of a display; empty where it has none
+  std::string Of(const std::string& key, Kind kind) const
+  {
+    for (const auto& [k, n, path] : m_luts)
+      if (k == key && n == kind)
+        return path;
+    return {};
+  }
+
+  //! Whether the display has an entry at all (a display not seen keeps no LUT of another)
+  bool Knows(const std::string& key) const
+  {
+    return std::any_of(m_luts.begin(), m_luts.end(),
+                       [&key](const auto& e) { return std::get<0>(e) == key; });
+  }
+
+  /*!
+   * \brief Notes the LUT of a kind of a display (an empty path: none); whether anything changed
+   */
+  bool Remember(const std::string& key, Kind kind, const std::string& path)
+  {
+    if (key.empty() || key.find('\t') != std::string::npos || key.find('\n') != std::string::npos ||
+        path.find('\t') != std::string::npos || path.find('\n') != std::string::npos)
+      return false;
+    if (Of(key, kind) == path && (Knows(key) || path.empty()))
+      return false;
+    m_luts.erase(std::remove_if(m_luts.begin(), m_luts.end(),
+                                [&](const auto& e)
+                                { return std::get<0>(e) == key && std::get<1>(e) == kind; }),
+                 m_luts.end());
+    if (!path.empty())
+      Put(key, kind, path);
+    return true;
+  }
+
+private:
+  void Put(const std::string& key, Kind kind, const std::string& path)
+  {
+    m_luts.erase(std::remove_if(m_luts.begin(), m_luts.end(),
+                                [&](const auto& e)
+                                { return std::get<0>(e) == key && std::get<1>(e) == kind; }),
+                 m_luts.end());
+    m_luts.emplace_back(key, kind, path);
+    // (the displays used last: one whose entries are the oldest goes, both of its LUTs)
+    while (Displays() > LIMIT)
+    {
+      const std::string oldest = std::get<0>(m_luts.front());
+      m_luts.erase(std::remove_if(m_luts.begin(), m_luts.end(),
+                                  [&](const auto& e) { return std::get<0>(e) == oldest; }),
+                   m_luts.end());
+    }
+  }
+  size_t Displays() const
+  {
+    std::vector<std::string> keys;
+    for (const auto& e : m_luts)
+      if (std::find(keys.begin(), keys.end(), std::get<0>(e)) == keys.end())
+        keys.push_back(std::get<0>(e));
+    return keys.size();
+  }
+  std::vector<std::tuple<std::string, Kind, std::string>> m_luts;
+};
+
+/*!
+ * \brief The LUT of a kind for the display that Kodi shows on: that display's (memory), or, where the display is not
+ *        known by its EDID (no key), the setting's
+ */
+inline std::string PathFor(const CDisplayLutMemory& memory,
+                           const std::string& key,
+                           Kind kind,
+                           const std::string& setting)
+{
+  return key.empty() ? setting : memory.Of(key, kind);
+}
+
+//! The longest name of a file that the player information says whole (one line of its row); a longer one keeps its
+//! first and last characters, with "..." between them (the whole path is in kodi.log)
+constexpr size_t LINE_NAME = 32;
+
+//! A name of at most LINE_NAME bytes: a longer one cut in the middle, between whole UTF-8 characters
+inline std::string ShortName(const std::string& name)
+{
+  if (name.size() <= LINE_NAME)
+    return name;
+  const auto lead = [&name](size_t at) { return at >= name.size() || (name[at] & 0xC0) != 0x80; };
+  size_t head = (LINE_NAME - 3) / 2, tail = name.size() - (LINE_NAME - 3 - head);
+  while (head > 0 && !lead(head))
+    --head;
+  while (tail < name.size() && !lead(tail))
+    ++tail;
+  return name.substr(0, head) + "..." + name.substr(tail);
+}
+
+//! What the player information says of the LUT, in one line: the name of its file where it is applied, why it is not
+//! where it is not (the caller gives the words of a reason, Estuary's; the file is in kodi.log); empty where nothing is
+//! to be said (off, or no LUT of the kind for this display)
+inline std::string Line(const std::string& path, Reason why, const std::string& words)
+{
+  if (path.empty() || why == Reason::NONE || why == Reason::OFF)
+    return {};
+  if (why == Reason::APPLIED)
+    return ShortName(FileName(path));
+  return words;
+}
