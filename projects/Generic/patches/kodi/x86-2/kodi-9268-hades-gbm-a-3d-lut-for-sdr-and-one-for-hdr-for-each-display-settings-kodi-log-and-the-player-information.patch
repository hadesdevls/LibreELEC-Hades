+std::string CWinSystemGbmGLESContext::LutWords(DISPLAY_LUT::Reason why)
+{
+  using DISPLAY_LUT::Reason;
+  switch (why)
+  {
+    case Reason::TV_LED:
+      return CGUIUtils::GetHadesString(62814, 54814);
+    case Reason::DISPLAY_MAPS:
+      return CGUIUtils::GetHadesString(62815, 54815);
+    case Reason::KODI_RENDERER:
+      return CGUIUtils::GetHadesString(62816, 54816);
+    case Reason::OTHER_KIND:
+      return CGUIUtils::GetHadesString(62817, 54817);
+    case Reason::UNREADABLE:
+      return CGUIUtils::GetHadesString(62818, 54818);
+    case Reason::GPU_FAILED:
+      return CGUIUtils::GetHadesString(62819, 54819);
+    default:
+      return {};
+  }
+}
+
+void CWinSystemGbmGLESContext::LutSay(const LutDecision& d)
+{
+  using namespace DISPLAY_LUT;
+  if (d.why == Reason::OFF || d.why == Reason::NONE)
+  {
+    m_lutTold.clear();
+    return;
+  }
+  static const char* const outputs[] = {"no video", "HDR or Dolby Vision mapped to SDR", "an SDR video drawn by the bridge",
+                                        "HDR mapped to the display", "Dolby Vision Low-Latency",
+                                        "native Dolby Vision (TV-led)", "HDR that the display maps itself",
+                                        "an SDR video drawn by Kodi's renderer", "an HDR video drawn by Kodi's renderer"};
+  static const char* const reasons[] = {"", "applied", "off", "native Dolby Vision is mapped by the TV, and its tunnel is bit-exact",
+                                        "the display maps this HDR itself, after anything the player does",
+                                        "Kodi's own renderer draws it", "the file was made for another kind of picture",
+                                        "the file could not be read", "this GPU could not draw it"};
+  const std::string told = StringUtils::Format("{}|{}|{}|{}", d.path, static_cast<int>(d.why),
+                                               static_cast<int>(d.output), d.key);
+  if (told == m_lutTold)
+    return;
+  m_lutTold = told;
+  const Kind kind = TakeOf(d.output).kind;
+  if (d.why == Reason::APPLIED)
+    CLog::Log(LOGINFO, "3D LUT: {} applied, the display's LUT for {} ({}), to {}", d.path,
+              kind == Kind::SDR ? "SDR" : "HDR", d.key.empty() ? "a display not known by its EDID" : d.key,
+              outputs[static_cast<int>(d.output)]);
+  else
+    CLog::Log(d.why == Reason::OTHER_KIND || d.why == Reason::UNREADABLE || d.why == Reason::GPU_FAILED ? LOGWARNING
+                                                                                                        : LOGINFO,
+              "3D LUT: {}, the display's LUT for {} ({}), not applied to {}: {}{}{}", d.path,
+              kind == Kind::SDR ? "SDR" : "HDR", d.key.empty() ? "a display not known by its EDID" : d.key,
+              outputs[static_cast<int>(d.output)], reasons[static_cast<int>(d.why)], d.detail.empty() ? "" : ": ",
+              d.detail);
+  // a LUT that is chosen and cannot be applied for a fault (not by design): said on the screen, once
+  if ((d.why == Reason::OTHER_KIND || d.why == Reason::UNREADABLE || d.why == Reason::GPU_FAILED) &&
+      m_lutNoticed.insert(d.path + '|' + std::to_string(static_cast<int>(d.why))).second)
+    CGUIDialogKaiToast::QueueNotification(CGUIDialogKaiToast::Warning, CGUIUtils::GetHadesString(62813, 54813),
+                                          FileName(d.path) + ": " + LutWords(d.why), 8000, false);
+}
+
+std::string CWinSystemGbmGLESContext::LutLine(const std::string& signal)
+{
+  using namespace DISPLAY_LUT;
+  LutDecision d;
+  {
+    std::unique_lock lock(m_lutLock);
+    d = m_lutNow;
+  }
+  if (d.made)
+    return Line(d.path, d.why, LutWords(d.why));
+  // no bridge drew a picture of this video: Kodi's own renderer draws it; said where a LUT of its kind is chosen
+  if (signal.empty())
+    return {};
+  const auto settings = CServiceBroker::GetSettingsComponent()->GetSettings();
+  if (!settings || !settings->GetSetting(CSettings::SETTING_VIDEOSCREEN_HADESLUT3D) ||
+      !settings->GetBool(CSettings::SETTING_VIDEOSCREEN_HADESLUT3D))
+    return {};
+  const Kind kind = signal == "sdr" ? Kind::SDR : Kind::HDR;
+  const std::string path = DisplayLutPath(
+      kind, settings->GetString(kind == Kind::SDR ? CSettings::SETTING_VIDEOSCREEN_HADESLUT3DSDR
+                                                  : CSettings::SETTING_VIDEOSCREEN_HADESLUT3DHDR));
+  return Line(path, Reason::KODI_RENDERER, LutWords(Reason::KODI_RENDERER));
+}
