+msgstr ""
+
+#. Hades: value of setting "videoscreen.hadeslut3drange": full range; translated in Estuary (#54809)
+#: system/settings/settings.xml
+msgctxt "#62809"
+msgid "Full (0-255)"
+msgstr ""
+
+#. Hades: value of setting "videoscreen.hadeslut3drange": video levels; translated in Estuary (#54810)
+#: system/settings/settings.xml
+msgctxt "#62810"
+msgid "Video levels (16-235)"
+msgstr ""
+
+#. Hades: label of setting "videoscreen.hadeslut3dsdrgamut"; translated in Estuary (#54811)
+#: system/settings/settings.xml
+msgctxt "#62811"
+msgid "SDR LUT made for"
+msgstr ""
+
+#. Hades: help of setting "videoscreen.hadeslut3dsdrgamut"; translated in Estuary (#54812)
