+
+void CWinSystemGbm::ReadDisplayLuts()
+{
+  if (m_displayLutsRead)
+    return;
+  m_displayLutsRead = true;
+  XFILE::CFile file;
+  std::vector<uint8_t> data;
+  if (XFILE::CFile::Exists(DISPLAY_LUTS_FILE, false) && file.LoadFile(DISPLAY_LUTS_FILE, data) >= 0 &&
+      data.size() < 256 * 1024)
+    m_displayLuts.Parse(std::string(data.begin(), data.end()));
+}
+
+void CWinSystemGbm::WriteDisplayLuts()
+{
+  const std::string text = m_displayLuts.Text();
+  const std::string temporary = std::string(DISPLAY_LUTS_FILE) + ".new";
+  XFILE::CFile file;
+  if (!file.OpenForWrite(temporary, true) ||
+      file.Write(text.data(), text.size()) != static_cast<ssize_t>(text.size()))
+  {
+    CLog::Log(LOGWARNING, "3D LUT: the LUTs of each display could not be written ({})", DISPLAY_LUTS_FILE);
+    return;
+  }
+  file.Close();
+  if (!XFILE::CFile::Rename(temporary, DISPLAY_LUTS_FILE))
+    CLog::Log(LOGWARNING, "3D LUT: the LUTs of each display could not be written ({})", DISPLAY_LUTS_FILE);
+}
+
+std::string CWinSystemGbm::DisplayLutPath(KODI::WINDOWING::GBM::DISPLAY_LUT::Kind kind,
+                                          const std::string& setting)
+{
+  const std::string key = DisplayModeKey();
+  std::unique_lock lock(m_displayLutsLock);
+  ReadDisplayLuts();
+  return KODI::WINDOWING::GBM::DISPLAY_LUT::PathFor(m_displayLuts, key, kind, setting);
+}
+
+std::string CWinSystemGbm::DisplayLutKey() const
+{
+  return DisplayModeKey();
+}
+
+void CWinSystemGbm::DisplayLutsFollow(const std::string& key)
+{
+  if (key.empty())
+    return;
+  {
+    std::unique_lock lock(m_displayLutsLock);
+    if (key == m_displayLutsShown || key == m_displayLutsNext)
+      return;
+    m_displayLutsNext = key;
+  }
+  // (posted: this runs while the settings of the display are applied, whose lock setting a value needs)
+  CServiceBroker::GetAppMessenger()->PostMsg(TMSG_CALLBACK, -1, -1, &m_displayLutsCallback);
+}
+
+void CWinSystemGbm::ShowDisplayLuts(void* userptr)
+{
+  using KODI::WINDOWING::GBM::DISPLAY_LUT::Kind;
+  auto* winSystem = static_cast<CWinSystemGbm*>(userptr);
+  const auto settings = CServiceBroker::GetSettingsComponent()->GetSettings();
+  const std::string settingSdr = settings->GetString(CSettings::SETTING_VIDEOSCREEN_HADESLUT3DSDR);
+  const std::string settingHdr = settings->GetString(CSettings::SETTING_VIDEOSCREEN_HADESLUT3DHDR);
+  std::string key, sdr, hdr;
+  {
+    std::unique_lock lock(winSystem->m_displayLutsLock);
+    key = winSystem->m_displayLutsNext;
+    winSystem->m_displayLutsNext.clear();
+    if (key.empty() || key == winSystem->m_displayLutsShown)
+      return;
+    winSystem->ReadDisplayLuts();
+    // (nothing noted of any display yet: the LUTs of the settings are this display's, as a display takes the mode of
+    // the settings where Kodi has only ever shown on one, DisplayModeMemory.h)
+    if (winSystem->m_displayLuts.Text().empty())
+    {
+      const bool a = winSystem->m_displayLuts.Remember(key, Kind::SDR, settingSdr);
+      const bool b = winSystem->m_displayLuts.Remember(key, Kind::HDR, settingHdr);
+      if (a || b)
+        winSystem->WriteDisplayLuts();
+      winSystem->m_displayLutsShown = key;
+      return;
+    }
+    sdr = winSystem->m_displayLuts.Of(key, Kind::SDR);
+    hdr = winSystem->m_displayLuts.Of(key, Kind::HDR);
+    winSystem->m_displayLutsShowing = true;
+  }
+  if (sdr != settingSdr || hdr != settingHdr)
+    CLog::Log(LOGINFO, "3D LUT: the settings show the LUTs of {}: for SDR {}, for HDR {}", key,
+              sdr.empty() ? "none" : sdr, hdr.empty() ? "none" : hdr);
+  settings->SetString(CSettings::SETTING_VIDEOSCREEN_HADESLUT3DSDR, sdr);
+  settings->SetString(CSettings::SETTING_VIDEOSCREEN_HADESLUT3DHDR, hdr);
+  std::unique_lock lock(winSystem->m_displayLutsLock);
+  winSystem->m_displayLutsShowing = false;
+  winSystem->m_displayLutsShown = key;
+}
