+DISPLAY_LUT::Gamut CWinSystemGbmGLESContext::ConversionSdrGamut() const
+{
+  // (the container of HDR mapped to SDR: videoscreen.hadessdrhdrgamut, as the mapping took it)
+  switch (m_dvConvertMapping.gamut)
+  {
+    case DVBRIDGE_HDR10_GAMUT_BT2020:
+      return DISPLAY_LUT::GAMUT_BT2020;
+    case DVBRIDGE_HDR10_GAMUT_P3_D65:
+      return DISPLAY_LUT::GAMUT_P3_D65;
+    default:
+      return DISPLAY_LUT::GAMUT_BT709;
+  }
