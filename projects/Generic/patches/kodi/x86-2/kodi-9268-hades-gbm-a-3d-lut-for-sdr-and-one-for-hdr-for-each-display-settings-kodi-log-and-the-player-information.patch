+#: system/settings/settings.xml
+msgctxt "#62800"
+msgid "3D LUT (display calibration)"
+msgstr ""
+
+#. Hades: label of setting "videoscreen.hadeslut3d"; translated in Estuary (#54801)
+#: system/settings/settings.xml
+msgctxt "#62801"
+msgid "Correct the picture with a 3D LUT"
+msgstr ""
+
