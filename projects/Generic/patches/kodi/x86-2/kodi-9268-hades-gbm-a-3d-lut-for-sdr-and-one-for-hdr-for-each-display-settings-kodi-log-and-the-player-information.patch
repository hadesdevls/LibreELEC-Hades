+void CWinSystemGbmGLESContext::LoadLut(LoadedLut& l, const std::string& path, int range)
+{
+  // (the bridges let go of the LUT that is replaced: they are given the new one, or none, as they draw)
+  if (m_dvBridge)
+    m_dvBridge->SetLut(nullptr);
+  if (m_dvConvertBridge)
+    m_dvConvertBridge->SetLut(nullptr);
+  l.lut.reset();
+  l.path = path;
+  l.range = range;
+  l.why.clear();
+  const auto start = std::chrono::steady_clock::now();
+  XFILE::CFile file;
+  std::vector<uint8_t> data;
+  struct __stat64 st{};
+  if (XFILE::CFile::Stat(path, &st) != 0 || st.st_size <= 0)
+    l.why = "the file is not there, or is empty";
+  else if (static_cast<uint64_t>(st.st_size) > DVBRIDGE_LUT_MAX_BYTES)
+    l.why = StringUtils::Format("the file is larger than {} MB", DVBRIDGE_LUT_MAX_BYTES >> 20);
+  else if (file.LoadFile(path, data) < 0 || data.empty())
+    l.why = "the file could not be read";
+  else
+  {
+    char why[256] = {};
+    const dvbridge_lut_range values = range == 1 ? dvbridge_lut_range{16.0f, 235.0f} : dvbridge_lut_range{0.0f, 255.0f};
+    l.lut.reset(dvbridge_lut_parse(data.data(), data.size(), path.c_str(), values, why, sizeof(why)));
+    if (!l.lut)
+      l.why = why;
+  }
+  const double ms =
+      std::chrono::duration<double, std::milli>(std::chrono::steady_clock::now() - start).count();
+  if (!l.lut)
+  {
+    CLog::Log(LOGWARNING, "3D LUT: {} could not be read: {}", path, l.why);
+    return;
+  }
+  const dvbridge_lut& lut = *l.lut;
+  CLog::Log(LOGINFO,
+            "3D LUT: {} read in {:.0f} ms: {}, {} points a side{}{}, input {:.0f}-{:.0f}{}, output {:.0f}-{:.0f}, "
+            "made for {} in {}{}",
+            path, ms, dvbridge_lut_format_name(lut.format), lut.size,
+            lut.title[0] ? StringUtils::Format(", '{}'", lut.title) : std::string(),
+            lut.shaper_two ? ", Nuke's shaper" : "", lut.in.lo, lut.in.hi,
+            lut.range_declared ? " (as the file says)" : (range == 1 ? " (the setting: video levels)" : " (the setting: full)"),
+            lut.out.lo, lut.out.hi, dvbridge_lut_signal_name(lut.signal), dvbridge_lut_gamut_name(lut.gamut),
+            lut.signal == DVBRIDGE_LUT_SIGNAL_UNKNOWN ? " (the file does not say: the kind it is chosen for)" : "");
+}
+
+const dvbridge_lut* CWinSystemGbmGLESContext::LutFor(DISPLAY_LUT::Output output, DISPLAY_LUT::Gamut sdrOutput)
+{
+  using namespace DISPLAY_LUT;
+  const auto now = std::chrono::steady_clock::now();
+  {
+    // (decided again twice a second at most for the same output: the settings and the display are read then)
+    std::unique_lock lock(m_lutLock);
+    if (m_lutNow.made && m_lutNow.output == output && now - m_lutNow.when < std::chrono::milliseconds(500))
+    {
+      if (m_lutNow.why != Reason::APPLIED && m_lutNow.why != Reason::GPU_FAILED)
+        return nullptr;
+      const LoadedLut& l = m_luts[static_cast<int>(TakeOf(output).kind)];
+      return l.path == m_lutNow.path ? l.lut.get() : nullptr;
+    }
+  }
+  const Take take = TakeOf(output);
+  const auto settings = CServiceBroker::GetSettingsComponent()->GetSettings();
+  LutDecision d;
+  d.made = true;
+  d.output = output;
+  d.when = now;
+  d.key = DisplayLutKey();
+  const bool on = settings && settings->GetSetting(CSettings::SETTING_VIDEOSCREEN_HADESLUT3D) &&
+                  settings->GetBool(CSettings::SETTING_VIDEOSCREEN_HADESLUT3D);
+  if (on && output != Output::NONE)
+    d.path = DisplayLutPath(take.kind, settings->GetString(take.kind == Kind::SDR
+                                                               ? CSettings::SETTING_VIDEOSCREEN_HADESLUT3DSDR
+                                                               : CSettings::SETTING_VIDEOSCREEN_HADESLUT3DHDR));
+  const dvbridge_lut* lut = nullptr;
+  // (the LUTs read are let go while the setting is off: a madVR LUT is 200 MB of floats)
+  if (!on && (m_luts[0].lut || m_luts[1].lut))
+  {
+    if (m_dvBridge)
+      m_dvBridge->SetLut(nullptr);
+    if (m_dvConvertBridge)
+      m_dvConvertBridge->SetLut(nullptr);
+    for (LoadedLut& l : m_luts)
+      l = {};
+    CLog::Log(LOGINFO, "3D LUT: turned off; the LUTs read are let go");
+  }
+  if (!on || d.path.empty() || output == Output::NONE)
+    d.why = Reason::OFF;
+  else if (!take.lut)
+    d.why = take.why;
+  else
+  {
+    LoadedLut& l = m_luts[static_cast<int>(take.kind)];
+    const int range = settings->GetInt(CSettings::SETTING_VIDEOSCREEN_HADESLUT3DRANGE);
+    if (l.path != d.path || l.range != range)
+      LoadLut(l, d.path, range);
+    if (!l.lut)
+    {
+      d.why = Reason::UNREADABLE;
+      d.detail = l.why;
+    }
+    else
+    {
+      d.why = Fits(take.kind, l.lut->signal, l.lut->gamut,
+                   GamutOfSetting(settings->GetInt(CSettings::SETTING_VIDEOSCREEN_HADESLUT3DSDRGAMUT)), sdrOutput,
+                   &d.detail);
+      if (d.why == Reason::NONE)
+      {
+        d.why = Reason::APPLIED;
+        lut = l.lut.get();
+      }
+    }
+  }
+  std::unique_lock lock(m_lutLock);
+  m_lutNow = d;
+  return lut;
+}
+
+void CWinSystemGbmGLESContext::LutDrawn(bool drawn, bool applied, bool failed)
+{
+  using DISPLAY_LUT::Reason;
+  LutDecision d;
+  {
+    std::unique_lock lock(m_lutLock);
+    if (!drawn || !m_lutNow.made)
+      return;
+    // (a LUT that the bridge did not apply is never said to be: a GPU that could not draw it, or a bridge that did
+    // not take it)
+    if (m_lutNow.why == Reason::APPLIED && (failed || !applied))
+    {
+      m_lutNow.why = Reason::GPU_FAILED;
+      m_lutNow.detail = failed ? "a render with it failed on this GPU; the picture is drawn without it"
+                               : "the bridge did not apply it";
+    }
+    d = m_lutNow;
+  }
+  LutSay(d);
+}
