+DISPLAY_LUT::Output CWinSystemGbmGLESContext::ConversionLutOutput() const
+{
+  // what the conversion bridge draws now goes out as: mapped to SDR, mapped to the display as HDR10, or HDR10 that
+  // the display maps itself (m_dvConvertMapping, as the output was told when the renderer was configured)
+  if (!m_dvConvertMapping.enabled)
+    return DISPLAY_LUT::Output::HDR_DISPLAY_MAPS;
