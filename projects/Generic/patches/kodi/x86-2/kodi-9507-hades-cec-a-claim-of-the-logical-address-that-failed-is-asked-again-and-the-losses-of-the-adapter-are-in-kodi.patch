+
+#pragma once
+
+#include <algorithm>
+#include <chrono>
+#include <cstdint>
+#include <cstdio>
+#include <string>
+
+namespace PERIPHERALS
+{
+namespace CEC_STATE
+{
+
+/*!
+ * \brief Hades: the state of a CEC adapter of the kernel while libCEC uses it, as the thread of
+ *        the adapter watches it (CPeripheralCecAdapter::ProcessAdapterState(), issue #24)
+ *
+ * The CEC adapter of a DisplayPort output (drm_dp_cec.c) has a physical address only while the
+ * display behind the output is there, and the kernel takes its logical addresses away whenever
+ * that address goes (CEC_CAP_NEEDS_HPD): at every hot-plug of the display (an AV receiver or a TV
+ * behind a DisplayPort to HDMI converter does one at many changes of the display mode, for HDR or
+ * a refresh rate), and at every detection of the output by i915 (intel_dp_set_edid() drops the
+ * address before it sets it again). When the address comes back, the kernel claims the logical
+ * addresses again by itself, with polls on the line; where none of them gets an answer (the
+ * interrupts of the output are polled after a storm of hot-plugs, so the converter's answers are
+ * not read; or the line is busy at that moment), the claim fails (CEC_LOG_ADDRS_FL_CONFIG_FAILED)
+ * and nothing asks again until the address goes and comes once more: libCEC does not handle it
+ * (its "TODO: handle ev.state_change.log_addr_mask change"), and the TV's remote did nothing from
+ * then on (issue #24: "when I switch to playing a different video (HLG or HDR), the CEC service
+ * stops working"). Nothing of it was in kodi.log.
+ *
+ * So the adapter is asked once a second: a claim that failed is asked again by the same request
+ * (CEC_ADAP_S_LOG_ADDRS with the logical addresses libCEC set), 2, 4, 8, 16 and then every 30 s;
+ * a loss of more than LONG_LOSS is said in kodi.log, and so is its end, and the shorter ones are
+ * counted in the next line. Once the logical address is back, the kernel says the physical address
+ * of the PC on the line again (<Report Physical Address>), as at the claim of libCEC's open, and the
+ * TV sends the keys of its remote to the device on the input it shows. Kodi is not made the active
+ * source again by itself: while the adapter has no logical address the kernel drops what it
+ * receives, so a change of input on the TV or a receiver meanwhile is not known, and Kodi would
+ * take the input back from what the user chose.
+ */
+
+//! What one look at the adapter found (CEC_ADAP_G_PHYS_ADDR, CEC_ADAP_G_LOG_ADDRS)
+struct Observation
+{
+  bool asked{false}; //!< the adapter could be opened and asked
+  uint16_t physicalAddress{0xffff}; //!< CEC_PHYS_ADDR_INVALID: none
+  unsigned int logicalAddresses{0}; //!< num_log_addrs: how many the user of the adapter set
+  uint16_t claimed{0}; //!< log_addr_mask: the ones claimed now
+  bool claimFailed{false}; //!< CEC_LOG_ADDRS_FL_CONFIG_FAILED
+};
+
+enum class Phase
+{
+  WORKING, //!< logical addresses claimed
+  GONE, //!< the adapter could not be opened (its output went, or it is being made again)
+  UNUSED, //!< no logical address was set on it (libCEC closed it)
+  NO_ADDRESS, //!< no physical address: the display behind its output is not there
+  CLAIMING, //!< a physical address, the claim of the logical addresses under way
+  FAILED, //!< the claim failed: nothing asks again by itself
+};
+
+constexpr Phase PhaseOf(const Observation& o)
+{
+  if (!o.asked)
+    return Phase::GONE;
+  if (o.logicalAddresses == 0)
+    return Phase::UNUSED;
+  if (o.claimed != 0)
+    return Phase::WORKING;
+  if (o.physicalAddress == 0xffff)
+    return Phase::NO_ADDRESS;
+  return o.claimFailed ? Phase::FAILED : Phase::CLAIMING;
+}
+
+//! A loss of the logical addresses shorter than this is not said by itself (an instant of every
+//! detection of the output), only counted
+inline constexpr std::chrono::milliseconds LONG_LOSS{2000};
+
+//! The waits before a claim that failed is asked again, the last one repeated
+inline constexpr int RECLAIM_SECONDS[] = {2, 4, 8, 16, 30};
+
+//! The lowest logical address of a mask; 0xff for none
+constexpr uint8_t FirstAddress(uint16_t mask)
+{
+  for (uint8_t a = 0; a < 16; ++a)
+  {
+    if (mask & (1u << a))
+      return a;
+  }
+  return 0xff;
+}
+
+//! What the caller does after a look
+struct Action
+{
+  bool reclaim{false}; //!< ask the kernel to claim the logical addresses again
+  //! the logical address is another one than before the loss: libCEC sends from the one it had,
+  //! which the kernel refuses; the connection is opened again
+  bool reopen{false};
+  std::string log; //!< a line for kodi.log (LOGINFO); empty for none
+};
+
+//! The physical address as CEC writes it ("1.0.0.0"); "none" for the invalid one
+inline std::string AddressText(uint16_t pa)
+{
+  if (pa == 0xffff)
+    return "none";
+  char text[16];
+  std::snprintf(text, sizeof(text), "%u.%u.%u.%u", (pa >> 12) & 0xf, (pa >> 8) & 0xf,
+                (pa >> 4) & 0xf, pa & 0xf);
+  return text;
+}
+
+class CWatch
+{
+public:
+  using Clock = std::chrono::steady_clock;
+
+  /*!
+   * \param o what the adapter says now
+   * \param now the time of the look
+   * \param name the adapter, for the log ("/dev/cec0 (DP-1)")
+   */
+  Action Next(const Observation& o, Clock::time_point now, const std::string& name)
+  {
+    Action action;
+    const Phase phase = PhaseOf(o);
+
+    if (phase == Phase::UNUSED)
+    {
+      // (libCEC is not using it: nothing is judged, and a loss under way is forgotten)
+      m_lost = false;
+      m_said = false;
+      m_saidPhases = 0;
+      m_failedSeen = false;
+      m_reclaims = 0;
+      return action;
+    }
+
+    if (phase == Phase::WORKING)
+    {
+      const uint8_t address = FirstAddress(o.claimed);
+      if (m_lost)
+      {
+        const auto lasted =
+            std::chrono::duration_cast<std::chrono::milliseconds>(now - m_lostSince).count();
+        action.reopen = m_working != 0xff && address != m_working;
+        if (m_said || m_failedSeen || action.reopen)
+        {
+          char head[256];
+          std::snprintf(head, sizeof(head),
+                        "CEC: the adapter %s has its logical address again (%u, physical address "
+                        "%s) after %lld.%01lld s without it",
+                        name.c_str(), static_cast<unsigned int>(address),
+                        AddressText(o.physicalAddress).c_str(),
+                        static_cast<long long>(lasted / 1000),
+                        static_cast<long long>((lasted % 1000) / 100));
+          action.log = head;
+          if (m_reclaims)
+            action.log += ", by a claim that Kodi asked again (" + std::to_string(m_reclaims) +
+                          (m_reclaims == 1 ? " time)" : " times)");
+          if (m_short)
+            action.log += ", and " + std::to_string(m_short) + " shorter losses before it";
+          if (action.reopen)
+            action.log += ": it had " + std::to_string(m_working) +
+                          ", which libCEC still sends from: the connection is opened again";
+          m_short = 0;
+        }
+        else
+          ++m_short;
+      }
+      m_working = address;
+      m_lost = false;
+      m_said = false;
+      m_saidPhases = 0;
+      m_failedSeen = false;
+      m_reclaims = 0;
+      m_phase = phase;
+      return action;
+    }
+
+    if (!m_lost)
+    {
+      m_lost = true;
+      m_lostSince = now;
+      m_said = false;
+      m_saidPhases = 0;
+      m_failedSeen = false;
+      m_reclaims = 0;
+    }
+
+    if (phase == Phase::FAILED)
+    {
+      if (!m_failedSeen)
+      {
+        m_failedSeen = true;
+        m_nextReclaim = now + std::chrono::seconds(RECLAIM_SECONDS[0]);
+      }
+      else if (now >= m_nextReclaim)
+      {
+        action.reclaim = true;
+        const int last = static_cast<int>(std::size(RECLAIM_SECONDS)) - 1;
+        ++m_reclaims;
+        m_nextReclaim = now + std::chrono::seconds(RECLAIM_SECONDS[std::min(m_reclaims, last)]);
+      }
+    }
+
+    // said once a loss lasts, and again when the claim fails, or the adapter goes, meanwhile
+    const bool longNow = now - m_lostSince >= LONG_LOSS;
+    const unsigned int bit = 1u << static_cast<unsigned int>(phase);
+    const bool worse = (phase == Phase::FAILED || phase == Phase::GONE) && !(m_saidPhases & bit);
+    if (longNow && (!m_said || worse))
+    {
+      const char* why = "";
+      switch (phase)
+      {
+        case Phase::GONE:
+          why = "the adapter is gone (its output went away, or the kernel is making it again)";
+          break;
+        case Phase::NO_ADDRESS:
+          why = "it has no physical address: the display behind its output is not there, or is "
+                "being detected again";
+          break;
+        case Phase::CLAIMING:
+          why = "it has its physical address, and the kernel claims its logical address on the "
+                "line";
+          break;
+        case Phase::FAILED:
+          why = "the kernel's claim of its logical address got no answer on the line (the "
+                "interrupts of its output may be polled after a storm of hot-plugs, or the device "
+                "behind it is off), and nothing asks again by itself: Kodi asks again, after 2, 4, "
+                "8, 16 and then every 30 s";
+          break;
+        default:
+          break;
+      }
+      char text[640];
+      std::snprintf(
+          text, sizeof(text),
+          "CEC: the adapter %s has had no logical address for %lld s (physical address "
+          "%s): %s; the TV's remote does not reach Kodi through it meanwhile",
+          name.c_str(),
+          static_cast<long long>(
+              std::chrono::duration_cast<std::chrono::seconds>(now - m_lostSince).count()),
+          AddressText(o.physicalAddress).c_str(), why);
+      action.log = text;
+      m_said = true;
+      m_saidPhases |= bit;
+    }
+    m_phase = phase;
+    return action;
+  }
+
+  int Reclaims() const { return m_reclaims; }
+
+private:
+  Phase m_phase{Phase::UNUSED};
+  bool m_lost{false};
+  bool m_said{false};
+  unsigned int m_saidPhases{0};
+  bool m_failedSeen{false};
+  int m_reclaims{0};
+  int m_short{0};
+  uint8_t m_working{0xff};
+  Clock::time_point m_lostSince{};
+  Clock::time_point m_nextReclaim{};
+};
+
+} // namespace CEC_STATE
+} // namespace PERIPHERALS
