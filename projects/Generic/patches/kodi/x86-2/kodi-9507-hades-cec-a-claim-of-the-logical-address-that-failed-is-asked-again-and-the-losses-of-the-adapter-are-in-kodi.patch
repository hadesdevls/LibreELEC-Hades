@@ -0,0 +1,202 @@
+/*
+ *  Copyright (C) 2026 Hades
+ *  This file is part of LibreELEC Hades. It is not in Kodi as Team Kodi publishes it.
+ *
+ *  SPDX-License-Identifier: GPL-2.0-or-later
+ *  See LICENSES/README.md for more information.
+ */
+
+#include "peripherals/devices/PeripheralCecState.h"
+
+#include <chrono>
+#include <string>
+
+#include <gtest/gtest.h>
+
+using namespace PERIPHERALS;
+using CEC_STATE::Action;
+using CEC_STATE::CWatch;
+using CEC_STATE::Observation;
+using CEC_STATE::Phase;
+
+namespace
+{
+// The adapter of a DisplayPort output of issue #24 while libCEC uses it: logical address 1
+// (recording device 1), physical address 1.0.0.0
+Observation Working(uint16_t claimed = 1u << 1)
+{
+  Observation o;
+  o.asked = true;
+  o.physicalAddress = 0x1000;
+  o.logicalAddresses = 1;
+  o.claimed = claimed;
+  return o;
+}
+Observation NoAddress()
+{
+  Observation o = Working(0);
+  o.physicalAddress = 0xffff;
+  return o;
+}
+Observation Claiming()
+{
+  return Working(0);
+}
+Observation Failed()
+{
+  Observation o = Working(0);
+  o.claimFailed = true;
+  return o;
+}
+
+struct Watching
+{
+  CWatch watch;
+  CWatch::Clock::time_point now{std::chrono::seconds(1000)};
+  Action Look(const Observation& o, std::chrono::milliseconds after = std::chrono::seconds(1))
+  {
+    now += after;
+    return watch.Next(o, now, "/dev/cec0 (DP-1)");
+  }
+};
+} // namespace
+
+TEST(TestPeripheralCecState, ThePhaseOfAnAdapter)
+{
+  EXPECT_TRUE(CEC_STATE::PhaseOf(Working()) == Phase::WORKING);
+  EXPECT_TRUE(CEC_STATE::PhaseOf(NoAddress()) == Phase::NO_ADDRESS);
+  EXPECT_TRUE(CEC_STATE::PhaseOf(Claiming()) == Phase::CLAIMING);
+  EXPECT_TRUE(CEC_STATE::PhaseOf(Failed()) == Phase::FAILED);
+  EXPECT_TRUE(CEC_STATE::PhaseOf(Observation{}) == Phase::GONE);
+  Observation closed = Working(0);
+  closed.logicalAddresses = 0;
+  EXPECT_TRUE(CEC_STATE::PhaseOf(closed) == Phase::UNUSED);
+  EXPECT_EQ(1, CEC_STATE::FirstAddress(1u << 1));
+  EXPECT_EQ(4, CEC_STATE::FirstAddress((1u << 4) | (1u << 8)));
+  EXPECT_EQ(0xff, CEC_STATE::FirstAddress(0));
+  EXPECT_EQ(std::string("1.0.0.0"), CEC_STATE::AddressText(0x1000));
+  EXPECT_EQ(std::string("3.4.0.0"), CEC_STATE::AddressText(0x3400));
+  EXPECT_EQ(std::string("none"), CEC_STATE::AddressText(0xffff));
+}
+
+TEST(TestPeripheralCecState, AShortLossIsOnlyCounted)
+{
+  // a detection of the output by i915: the address goes and comes in a fraction of a second
+  Watching run;
+  EXPECT_TRUE(run.Look(Working()).log.empty());
+  EXPECT_TRUE(run.Look(NoAddress(), std::chrono::milliseconds(100)).log.empty());
+  EXPECT_TRUE(run.Look(Claiming(), std::chrono::milliseconds(300)).log.empty());
+  const Action back = run.Look(Working(), std::chrono::milliseconds(400));
+  EXPECT_TRUE(back.log.empty());
+  EXPECT_FALSE(back.reclaim);
+  EXPECT_FALSE(back.reopen);
+  // ... and said with the next loss that is said
+  run.Look(NoAddress());
+  const Action said = run.Look(NoAddress(), std::chrono::seconds(2));
+  EXPECT_NE(std::string::npos, said.log.find("has had no logical address for 2 s"));
+  EXPECT_NE(std::string::npos, said.log.find("/dev/cec0 (DP-1)"));
+  EXPECT_NE(std::string::npos, said.log.find("no physical address"));
+  const Action again = run.Look(Working());
+  EXPECT_NE(std::string::npos, again.log.find("has its logical address again (1, physical address "
+                                              "1.0.0.0) after 3.0 s"));
+  EXPECT_NE(std::string::npos, again.log.find("1 shorter losses before it"));
+}
+
+TEST(TestPeripheralCecState, AFailedClaimIsAskedAgain)
+{
+  // issue #24: after an HDR video the claim of the logical address got no answer on the line
+  Watching run;
+  run.Look(Working());
+  run.Look(NoAddress());
+  run.Look(Claiming());
+  // the claim failed: not asked at once (the line may still be busy)
+  Action a = run.Look(Failed());
+  EXPECT_FALSE(a.reclaim);
+  EXPECT_NE(std::string::npos, a.log.find("got no answer on the line"));
+  a = run.Look(Failed());
+  EXPECT_FALSE(a.reclaim);
+  a = run.Look(Failed());
+  EXPECT_TRUE(a.reclaim);
+  EXPECT_EQ(1, run.watch.Reclaims());
+  // said once: the claim under way, and failed again, says nothing more
+  EXPECT_TRUE(run.Look(Claiming()).log.empty());
+  a = run.Look(Failed());
+  EXPECT_TRUE(a.log.empty());
+  EXPECT_FALSE(a.reclaim);
+  // then 4 s after the first (two looks of it above), 8 s, 16 s and every 30 s
+  // (each wait at most a minute of looks: a test that never ends finds nothing)
+  int looks = 2;
+  do
+    ++looks;
+  while (!run.Look(Failed()).reclaim && looks < 60);
+  EXPECT_EQ(4, looks);
+  EXPECT_EQ(2, run.watch.Reclaims());
+  for (const int wait : {8, 16, 30, 30})
+  {
+    looks = 0;
+    do
+      ++looks;
+    while (!run.Look(Failed()).reclaim && looks < 60);
+    EXPECT_EQ(wait, looks);
+  }
+  // the claim works: said, with the number of times it was asked
+  const Action back = run.Look(Working());
+  EXPECT_FALSE(back.reopen);
+  EXPECT_NE(std::string::npos, back.log.find("has its logical address again (1"));
+  EXPECT_NE(std::string::npos, back.log.find("by a claim that Kodi asked again (6 times)"));
+  EXPECT_EQ(0, run.watch.Reclaims());
+}
+
+TEST(TestPeripheralCecState, AnotherLogicalAddressOpensTheConnectionAgain)
+{
+  Watching run;
+  run.Look(Working(1u << 1));
+  run.Look(Failed());
+  run.Look(Failed());
+  run.Look(Failed());
+  // the kernel claimed 2: libCEC sends from 1, which the kernel refuses
+  const Action back = run.Look(Working(1u << 2));
+  EXPECT_TRUE(back.reopen);
+  EXPECT_NE(std::string::npos, back.log.find("it had 1, which libCEC still sends from"));
+  // ... also after a short loss
+  Watching quick;
+  quick.Look(Working(1u << 1));
+  quick.Look(NoAddress(), std::chrono::milliseconds(200));
+  const Action other = quick.Look(Working(1u << 2), std::chrono::milliseconds(300));
+  EXPECT_TRUE(other.reopen);
+  EXPECT_FALSE(other.log.empty());
+}
+
+TEST(TestPeripheralCecState, AnAdapterThatLibCecDoesNotUseIsLeftAlone)
+{
+  Watching run;
+  Observation closed = Working(0);
+  closed.logicalAddresses = 0;
+  closed.claimFailed = true;
+  for (int i = 0; i < 40; ++i)
+  {
+    const Action a = run.Look(closed);
+    EXPECT_FALSE(a.reclaim);
+    EXPECT_TRUE(a.log.empty());
+  }
+  // the adapter that goes is said, once; libCEC opens it again by itself (CEC_ALERT_CONNECTION_LOST)
+  run.Look(Working());
+  run.Look(Observation{});
+  const Action gone = run.Look(Observation{}, std::chrono::seconds(2));
+  EXPECT_NE(std::string::npos, gone.log.find("the adapter is gone"));
+  EXPECT_FALSE(gone.reclaim);
+  EXPECT_TRUE(run.Look(Observation{}).log.empty());
+}
+
+TEST(TestPeripheralCecState, ALongLossWithoutAFailedClaimIsNotAskedAgain)
+{
+  // the receiver or the TV is off: no physical address; nothing is asked of the kernel
+  Watching run;
+  run.Look(Working());
+  for (int i = 0; i < 100; ++i)
+    EXPECT_FALSE(run.Look(NoAddress()).reclaim);
+  // a claim under way for long (every poll times out) is waited for
+  for (int i = 0; i < 30; ++i)
+    EXPECT_FALSE(run.Look(Claiming()).reclaim);
+}
