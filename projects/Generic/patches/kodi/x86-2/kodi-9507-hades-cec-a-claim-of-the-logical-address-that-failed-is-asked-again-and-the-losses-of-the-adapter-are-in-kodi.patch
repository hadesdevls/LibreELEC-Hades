+void CPeripheralCecAdapter::ProcessAdapterState(void)
+{
+#if defined(TARGET_LINUX)
+  if (!m_strComPort.starts_with("/dev/cec"))
+    return;
+  const auto now = std::chrono::steady_clock::now();
+  if (now < m_stateNext)
+    return;
+  m_stateNext = now + std::chrono::seconds(1);
+
+  CEC_STATE::Observation seen;
+  struct cec_log_addrs addrs = {};
+  const int fd = open(m_strComPort.c_str(), O_RDWR | O_NONBLOCK | O_CLOEXEC);
+  if (fd >= 0)
+  {
+    uint16_t physicalAddress = CEC_PHYS_ADDR_INVALID;
+    if (ioctl(fd, CEC_ADAP_G_PHYS_ADDR, &physicalAddress) == 0 &&
+        ioctl(fd, CEC_ADAP_G_LOG_ADDRS, &addrs) == 0)
+    {
+      seen.asked = true;
+      seen.physicalAddress = physicalAddress;
+      seen.logicalAddresses = addrs.num_log_addrs;
+      seen.claimed = addrs.log_addr_mask;
+      seen.claimFailed = (addrs.flags & CEC_LOG_ADDRS_FL_CONFIG_FAILED) != 0;
+    }
+  }
+  std::string name = m_strComPort;
+  {
+    std::unique_lock lock(m_noteLock);
+    if (!m_noteAdapter.empty())
+      name += " (" + m_noteAdapter + ")";
+  }
+  const CEC_STATE::Action action = m_stateWatch.Next(seen, now, name);
+  if (action.reclaim && fd >= 0 && seen.asked)
+  {
+    // the logical addresses that libCEC set, asked again as they are (the kernel claims them in
+    // the background on this file, which is not blocking)
+    struct cec_log_addrs again = addrs;
+    again.flags &= CEC_LOG_ADDRS_FL_ALLOW_UNREG_FALLBACK | CEC_LOG_ADDRS_FL_ALLOW_RC_PASSTHRU |
+                   CEC_LOG_ADDRS_FL_CDC_ONLY;
+    if (ioctl(fd, CEC_ADAP_S_LOG_ADDRS, &again) != 0)
+      CLog::Log(LOGDEBUG,
+                "CEC: the claim of the logical address of {} could not be asked again: {}",
+                m_strComPort, strerror(errno));
+    else
+      CLog::Log(m_stateWatch.Reclaims() == 1 ? LOGINFO : LOGDEBUG,
+                "CEC: the claim of the logical address of {} is asked again (time {})",
+                m_strComPort, m_stateWatch.Reclaims());
+  }
+  if (fd >= 0)
+    close(fd);
+  if (!action.log.empty())
+    CLog::Log(LOGINFO, "{}", action.log);
+  if (action.reopen)
+  {
+    ReopenConnection(true);
+    return;
+  }
+#endif
+}
+
