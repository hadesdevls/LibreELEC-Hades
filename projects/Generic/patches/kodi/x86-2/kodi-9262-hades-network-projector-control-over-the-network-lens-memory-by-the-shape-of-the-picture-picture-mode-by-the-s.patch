+#. Hades, the projector control: power state of the projector (core #62765)
+msgctxt "#54765"
+msgid "warming up"
+msgstr "calentando"
+
+#: xbmc/network/ProjectorControl.cpp
+#. Hades, the projector control: power state of the projector (core #62766)
+msgctxt "#54766"
+msgid "cooling down"
+msgstr "enfriándose"
+
+#: xbmc/network/ProjectorControl.cpp
+#. Hades, the projector control: power state of the projector (core #62767)
+msgctxt "#54767"
+msgid "in error"
+msgstr "con un error"
+
+#: xbmc/network/ProjectorControl.cpp
+#. Hades, the projector control: power state of the projector (core #62768)
+msgctxt "#54768"
+msgid "unknown"
+msgstr "desconocido"
+
+#: xbmc/network/ProjectorControl.cpp
+#. Hades, the projector control: {0} the protocol (core #62769)
+msgctxt "#54769"
+msgid "{0} did not answer in time."
+msgstr "{0} no respondió a tiempo."
+
+#: xbmc/network/ProjectorControl.cpp
+#. Hades, the projector control: label of the row of the projector control
+msgctxt "#54780"
+msgid "Projector"
+msgstr "Proyector"
+
+#: xbmc/network/ProjectorControl.cpp
+#. Hades, the projector control: the lens memory: {0} its number, {1} the shape of the picture it was taken for, as 2.39, {2} where the shape comes from
+msgctxt "#54781"
+msgid "memory {0} for {1}:1 ({2})"
+msgstr "memoria {0} para {1}:1 ({2})"
+
+#: xbmc/network/ProjectorControl.cpp
+#. Hades, the projector control: the shape comes from the Dolby Vision metadata
+msgctxt "#54782"
+msgid "level 5"
+msgstr "nivel 5"
+
+#: xbmc/network/ProjectorControl.cpp
+#. Hades, the projector control: the shape was measured on the picture
+msgctxt "#54783"
+msgid "measured"
+msgstr "medida"
+
+#: xbmc/network/ProjectorControl.cpp
+#. Hades, the projector control: no bar: the shape of the frame
+msgctxt "#54784"
+msgid "frame"
+msgstr "fotograma"
+
+#: xbmc/network/ProjectorControl.cpp
+#. Hades, the projector control: the picture mode: {0} its name on the projector
+msgctxt "#54785"
+msgid "mode {0}"
+msgstr "modo {0}"
+
+#: xbmc/network/ProjectorControl.cpp
+#. Hades, the projector control: state of the projector
+msgctxt "#54786"
+msgid "not answering"
+msgstr "no responde"
+
+#: xbmc/network/ProjectorControl.cpp
+#. Hades, the projector control: state of the projector
+msgctxt "#54787"
+msgid "password refused"
+msgstr "contraseña rechazada"
+
+#: xbmc/network/ProjectorControl.cpp
+#. Hades, the projector control: state of the projector
+msgctxt "#54788"
+msgid "asks for a password"
+msgstr "pide una contraseña"
+
+#: xbmc/network/ProjectorControl.cpp
+#. Hades, the projector control: state of the projector
+msgctxt "#54789"
+msgid "off or warming up"
+msgstr "apagado o calentando"
+
