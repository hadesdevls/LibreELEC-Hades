+// the core strings of the control (English), translated in Estuary at the same place from 54700
+// (GUIDialogSettingsBase::GetLocalizedString() for the settings, CGUIUtils::GetHadesString())
+constexpr uint32_t CORE = 62700;
+constexpr uint32_t ESTUARY = 54700;
+std::string Text(uint32_t core)
+{
+  return CGUIUtils::GetHadesString(core, ESTUARY + (core - CORE));
+}
+std::string Trimmed(std::string text)
+{
+  StringUtils::Trim(text);
+  return text;
+}
+std::string Fill(std::string text,
+                 const std::string& a,
+                 const std::string& b = "",
+                 const std::string& c = "")
+{
+  StringUtils::Replace(text, "{0}", a);
+  StringUtils::Replace(text, "{1}", b);
+  StringUtils::Replace(text, "{2}", c);
+  return text;
+}
+// a word of the player information: Estuary's string, as $ADDON[skin.estuary n] takes it for the
+// rows of the page in every skin; English where there is none (as WinSystemGbmGLESContext does)
+std::string Word(uint32_t id, const char* english)
+{
+  const std::string& text =
+      CServiceBroker::GetResourcesComponent().GetLocalizeStrings().GetAddonString("skin.estuary",
+                                                                                  id);
+  return text.empty() ? std::string(english) : text;
+}
+
+std::string PowerText(Power power)
+{
+  switch (power)
+  {
+    case Power::ON:
+      return Text(62763);
+    case Power::STANDBY:
+      return Text(62764);
+    case Power::WARMING:
+      return Text(62765);
+    case Power::COOLING:
+      return Text(62766);
+    case Power::ERROR:
+      return Text(62767);
+    case Power::UNKNOWN:
+      break;
+  }
+  return Text(62768);
+}
+
+//! the settings of the picture mode of each kind of signal (Signal)
+const char* ModeSetting(Signal signal)
+{
+  switch (signal)
+  {
+    case Signal::SDR:
+      return CSettings::SETTING_VIDEOSCREEN_HADESPROJECTORMODESDR;
+    case Signal::HDR10:
+      return CSettings::SETTING_VIDEOSCREEN_HADESPROJECTORMODEHDR10;
+    case Signal::HLG:
+      return CSettings::SETTING_VIDEOSCREEN_HADESPROJECTORMODEHLG;
+    case Signal::DOLBY_VISION:
+      return CSettings::SETTING_VIDEOSCREEN_HADESPROJECTORMODEDV;
+    case Signal::THREE_D:
+      return CSettings::SETTING_VIDEOSCREEN_HADESPROJECTORMODE3D;
+    case Signal::NONE:
+      break;
+  }
+  return nullptr;
+}
+constexpr Signal KINDS[] = {Signal::SDR, Signal::HDR10, Signal::HLG, Signal::DOLBY_VISION,
+                            Signal::THREE_D};
+
+std::shared_ptr<CSettings> SettingsNow()
+{
+  const auto component = CServiceBroker::GetSettingsComponent();
+  return component ? component->GetSettings() : nullptr;
+}
+
+Brand BrandSet()
+{
+  const auto settings = SettingsNow();
+  return settings ? BrandOf(settings->GetInt(CSettings::SETTING_VIDEOSCREEN_HADESPROJECTOR))
+                  : Brand::NONE;
+}
+
+// what the player information shows (PlayerInfoText()), set by the thread of the control
+struct Status
+{
+  Brand brand = Brand::NONE;
+  bool lens = false;
+  int memory = 0;
+  Signal signal = Signal::NONE;
+  int code = -1;
+  Failure problem = Failure::NONE;
+  bool off = false;
+  bool blockedAddress = false;
+};
+std::mutex g_statusLock;
+Status g_status;
+} // namespace
+
+CProjectorControl::CProjectorControl() : CThread("ProjectorControl")
+{
+  if (const auto settings = SettingsNow())
+    settings->GetSettingsManager()->RegisterCallback(
+        this, {CSettings::SETTING_VIDEOSCREEN_HADESPROJECTOR,
+               CSettings::SETTING_VIDEOSCREEN_HADESPROJECTORADDRESS,
+               CSettings::SETTING_VIDEOSCREEN_HADESPROJECTORTEST});
+  Create();
+}
+
+CProjectorControl::~CProjectorControl()
+{
+  if (const auto settings = SettingsNow())
+    settings->GetSettingsManager()->UnregisterCallback(this);
+  m_bStop = true;
+  m_wake.Set();
+  StopThread(true);
+  SetBarsWanted(false);
+  std::lock_guard lock(g_statusLock);
+  g_status = {};
+}
+
+double CProjectorControl::Now() const
+{
+  return std::chrono::duration<double>(std::chrono::steady_clock::now().time_since_epoch()).count();
+}
+
+CProjectorControl::Config CProjectorControl::ReadConfig()
+{
+  Config config;
+  const auto settings = SettingsNow();
+  if (!settings)
+    return config;
+  config.brand = BrandOf(settings->GetInt(CSettings::SETTING_VIDEOSCREEN_HADESPROJECTOR));
+  if (config.brand == Brand::NONE)
+    return config;
+  config.address =
+      Trimmed(settings->GetString(CSettings::SETTING_VIDEOSCREEN_HADESPROJECTORADDRESS));
+  config.password = settings->GetString(CSettings::SETTING_VIDEOSCREEN_HADESPROJECTORPASSWORD);
+  config.confirmed = settings->GetString(CSettings::SETTING_VIDEOSCREEN_HADESPROJECTORCONFIRMED);
+  config.lens = settings->GetBool(CSettings::SETTING_VIDEOSCREEN_HADESPROJECTORLENS);
+  LensSettings& s = config.lensSettings;
+  s.narrowMemory = settings->GetInt(CSettings::SETTING_VIDEOSCREEN_HADESPROJECTORLENSNARROW);
+  s.wideFrom = settings->GetNumber(CSettings::SETTING_VIDEOSCREEN_HADESPROJECTORLENSWIDEFROM);
+  s.wideMemory = settings->GetInt(CSettings::SETTING_VIDEOSCREEN_HADESPROJECTORLENSWIDE);
+  s.widestMemory = settings->GetInt(CSettings::SETTING_VIDEOSCREEN_HADESPROJECTORLENSWIDEST);
+  s.widestFrom = settings->GetNumber(CSettings::SETTING_VIDEOSCREEN_HADESPROJECTORLENSWIDESTFROM);
+  s.holdSeconds = settings->GetInt(CSettings::SETTING_VIDEOSCREEN_HADESPROJECTORLENSHOLD);
+  s.backAtStop = settings->GetBool(CSettings::SETTING_VIDEOSCREEN_HADESPROJECTORLENSSTOP);
+  for (const Signal kind : KINDS)
+    config.modes[static_cast<int>(kind)] = settings->GetInt(ModeSetting(kind));
+  return config;
+}
+
+void CProjectorControl::Process()
+{
+  while (!m_bStop)
+  {
+    m_wake.Wait(250ms);
+    if (m_bStop)
+      break;
+    Tick();
+  }
+}
+
+std::unique_ptr<CSession> CProjectorControl::MakeSession(const Config& config)
+{
+  const std::string prefix =
+      StringUtils::Format("Projector: {} {}: ", BrandName(config.brand), config.address);
+  auto session = std::make_unique<CSession>(
+      config.brand, config.address, DefaultPort(config.brand), config.password,
+      [](const std::string& data)
+      { return KODI::UTILITY::CDigest::Calculate(KODI::UTILITY::CDigest::Type::SHA256, data); },
+      [prefix](const std::string& line) { CLog::Log(LOGINFO, "{}{}", prefix, line); }, &m_bStop);
+  session->PreferHashedPassword(m_hashed);
+  return session;
+}
+
+void CProjectorControl::Tick()
+{
+  const Config config = ReadConfig();
+  if (!m_configRead || !config.SameLink(m_config))
+  {
+    // another projector, address or password: everything is asked again
+    m_sentMemory = 0;
+    m_sentSignal = Signal::NONE;
+    m_sentCode = -1;
+    m_modeSignal = Signal::NONE;
+    m_modeCode = -1;
+    m_failures = 0;
+    m_retryAt = 0.0;
+    m_lensQuietUntil = 0.0;
+    m_blocked = false;
+    m_addressSaid = false;
+    m_noticeGiven = false;
+    m_hashed = false;
+    m_model.clear();
+    m_problem = Failure::NONE;
+    m_off = false;
+    m_lens.Reset();
+    m_signal.Reset();
+    if (m_configRead || config.brand != Brand::NONE)
+      CLog::Log(LOGINFO, "Projector: control {}{}{}",
+                config.brand == Brand::NONE ? "off" : BrandName(config.brand),
+                config.brand == Brand::NONE ? "" : " at ",
+                config.brand == Brand::NONE ? "" : config.address);
+  }
+  else if (m_signal.Taken() != Signal::NONE)
+  {
+    // the user chose another mode for the kind of signal of now: it is sent
+    const int index = static_cast<int>(m_signal.Taken());
+    if (config.modes[index] != m_config.modes[index])
+    {
+      m_modeSignal = m_signal.Taken();
+      m_modeCode = config.modes[index];
+    }
+  }
+  if (config.lens != m_config.lens || config.brand == Brand::NONE)
+    m_lens.Reset();
+  m_config = config;
+  m_configRead = true;
+  SetBarsWanted(config.brand != Brand::NONE && config.lens);
+
+  const bool testAsked = m_testAsked.exchange(false);
+  const Address address = ReadAddress(config.address);
+  const bool allowed = config.brand != Brand::NONE && address.valid &&
+                       (address.home || config.address == config.confirmed);
+  if (testAsked)
+  {
+    if (!allowed)
+    {
+      std::lock_guard lock(m_testLock);
+      m_testText = config.brand == Brand::NONE || !address.valid
+                       ? Text(62761)
+                       : Fill(Text(62760), config.address);
+    }
+    else
+      RunTest(config);
+    m_testDone.Set();
+  }
+  if (!allowed)
+  {
+    if (config.brand != Brand::NONE && !m_addressSaid)
+    {
+      m_addressSaid = true;
+      CLog::Log(LOGWARNING, "Projector: nothing is sent: {}",
+                !address.valid ? "the address is not an IP address"
+                               : "the address is not of a home network, and was not confirmed");
+    }
+    Publish();
+    return;
+  }
+
+  const auto player = CServiceBroker::GetAppComponents().GetComponent<CApplicationPlayer>();
+  const bool playing = player && player->IsPlayingVideo();
+  const double now = Now();
+  const Fed fed = Read();
+
+  LensWanted lens;
+  if (config.lens)
+  {
+    // (no picture presented in the last second, or a video in 3D, whose frame holds two pictures: the
+    // lens stays where it is)
+    Shape shape = fed.shape;
+    if (fed.pictureAge > 1.0 || fed.signal == Signal::THREE_D)
+      shape.valid = false;
+    lens = m_lens.Update(now, playing, shape, config.lensSettings);
+    if (lens.changed)
+    {
+      if (lens.why == WHY_STOP)
+        CLog::Log(LOGINFO, "Projector: lens memory {} wanted: {}", lens.memory, lens.why);
+      else
+        CLog::Log(LOGINFO, "Projector: lens memory {} wanted: {} ({:.2f}:1, {})", lens.memory,
+                  lens.why, lens.ratio, fed.how);
+    }
+  }
+  const Signal taken = m_signal.Update(now, fed.signalAge < 2.0 ? fed.signal : Signal::NONE);
+  if (taken != Signal::NONE)
+  {
+    m_modeSignal = taken;
+    m_modeCode = config.modes[static_cast<int>(taken)];
+    const char* name = m_modeCode >= 0 ? ModeNameOf(config.brand, m_modeCode) : nullptr;
+    CLog::Log(LOGINFO, "Projector: the signal is {}: picture mode {}", SignalName(taken),
+              name ? name : "left as it is");
+  }
+
+  const bool lensDue =
+      config.lens && lens.memory > 0 && lens.memory != m_sentMemory && now >= m_lensQuietUntil;
+  const bool modeDue = m_modeSignal != Signal::NONE && m_modeCode >= 0 &&
+                       !(m_modeSignal == m_sentSignal && m_modeCode == m_sentCode);
+  if ((lensDue || modeDue) && !m_blocked && now >= m_retryAt)
+    Send(config, playing, lensDue ? lens.memory : 0, modeDue ? m_modeSignal : Signal::NONE,
+         modeDue ? m_modeCode : -1);
+  Publish();
+}
+
+void CProjectorControl::RunTest(const Config& config)
+{
+  CLog::Log(LOGINFO, "Projector: test of the connection");
+  auto session = MakeSession(config);
+  Result result = session->Open();
+  Power power = Power::UNKNOWN;
+  std::string model;
+  if (result.Ok())
+    result = session->GetPower(power);
+  if (result.Ok())
+  {
+    const Result read = session->GetModel(model);
+    if (!read.Ok() && read.failure != Failure::NOT_AVAILABLE)
+      result = read;
+  }
+  session->Close();
+  std::string text;
+  const std::string name = BrandName(config.brand);
+  switch (result.failure)
+  {
+    case Failure::NONE:
+      m_hashed = session->UsedHashedPassword();
+      m_model = model;
+      text = model.empty() ? Fill(Text(62752), name, PowerText(power))
+                           : Fill(Text(62751), name, model, PowerText(power));
+      // (the settings may have been fixed: what waited is tried again now)
+      m_blocked = false;
+      m_failures = 0;
+      m_retryAt = 0.0;
+      m_problem = Failure::NONE;
+      break;
+    case Failure::PASSWORD_REFUSED:
+      text = Fill(Text(62754), name);
+      break;
+    case Failure::PASSWORD_NEEDED:
+      text = Fill(Text(62755), name);
+      break;
+    case Failure::BUSY:
+      text = Fill(Text(62756), name);
+      break;
+    case Failure::NO_ANSWER:
+      text = Fill(Text(62769), name);
+      break;
+    case Failure::PROTOCOL:
+    case Failure::REJECTED:
+      text = Fill(Text(62762), name, result.detail);
+      break;
+    default:
+      text = Fill(Text(62753), name, config.address);
+      break;
+  }
+  CLog::Log(LOGINFO, "Projector: test: {}{}{}", FailureName(result.failure),
+            result.detail.empty() ? "" : ": ", result.detail);
+  std::lock_guard lock(m_testLock);
+  m_testText = text;
+}
+
+void CProjectorControl::Send(
+    const Config& config, bool playing, int memory, Signal signal, int mode)
+{
+  auto session = MakeSession(config);
+  Result result = session->Open();
+  if (!result.Ok())
+  {
+    Failed(config, result, playing, "connecting");
+    return;
+  }
+  m_hashed = session->UsedHashedPassword();
+  Power power = Power::UNKNOWN;
+  result = session->GetPower(power);
+  if (!result.Ok())
+  {
+    session->Close();
+    Failed(config, result, playing, "reading its power");
+    return;
+  }
+  if (power != Power::ON)
+  {
+    session->Close();
+    m_off = true;
+    m_failures++;
+    m_retryAt = Now() + RetryAfter(m_failures);
+    CLog::Log(LOGINFO, "Projector: it is {}: nothing sent; asked again in {:.0f} s",
+              PowerName(power), RetryAfter(m_failures));
+    if (playing && !m_noticeGiven)
+    {
+      m_noticeGiven = true;
+      Notify(Fill(Text(62758), BrandName(config.brand)));
+    }
+    return;
+  }
+  m_off = false;
+  // a command that the projector refuses, or that it took without saying so in time, is not sent
+  // again (it may have been done: a lens that moved); one whose connection was lost is
+  const auto refused = [](const Result& r)
+  {
+    return r.failure == Failure::REJECTED || r.failure == Failure::NOT_AVAILABLE ||
+           r.failure == Failure::PROTOCOL || r.failure == Failure::NO_ANSWER;
+  };
+  bool clean = true;
+  if (signal != Signal::NONE)
+  {
+    result = session->SetPictureMode(mode);
+    const char* name = ModeNameOf(config.brand, mode);
+    CLog::Log(LOGINFO, "Projector: picture mode {} for {}: {}{}{}", name ? name : "?",
+              SignalName(signal), FailureName(result.failure), result.detail.empty() ? "" : ": ",
+              result.detail);
+    if (result.Ok() || refused(result))
+    {
+      m_sentSignal = signal;
+      m_sentCode = mode;
+    }
+    if (!result.Ok())
+    {
+      if (!refused(result))
+      {
+        session->Close();
+        Failed(config, result, playing, "selecting the picture mode");
+        return;
+      }
+      clean = false;
+      m_problem = Failure::REJECTED;
+      Notify(Fill(Text(62757), BrandName(config.brand),
+                  std::string("picture mode ") + (name ? name : "?")));
+    }
+  }
+  if (memory > 0)
+  {
+    result = session->SetLensMemory(memory);
+    m_lensQuietUntil = Now() + LENS_QUIET_SECONDS;
+    CLog::Log(LOGINFO, "Projector: lens memory {}: {}{}{}", memory, FailureName(result.failure),
+              result.detail.empty() ? "" : ": ", result.detail);
+    if (result.Ok() || refused(result))
+      m_sentMemory = memory;
+    if (!result.Ok())
+    {
+      if (!refused(result))
+      {
+        session->Close();
+        Failed(config, result, playing, "selecting the lens memory");
+        return;
+      }
+      clean = false;
+      m_problem = Failure::REJECTED;
+      Notify(Fill(Text(62757), BrandName(config.brand), "lens memory " + std::to_string(memory)));
+    }
+  }
+  session->Close();
+  m_failures = 0;
+  m_retryAt = 0.0;
+  if (clean)
+  {
+    m_problem = Failure::NONE;
+    m_noticeGiven = false;
+  }
+}
+
+void CProjectorControl::Failed(const Config& config,
+                               const Result& result,
+                               bool playing,
+                               const char* doing)
+{
+  if (result.failure == Failure::STOPPED)
+    return;
+  m_problem = result.failure;
+  const std::string name = BrandName(config.brand);
+  std::string notice;
+  switch (result.failure)
+  {
+    case Failure::PASSWORD_REFUSED:
+    case Failure::PASSWORD_NEEDED:
+    case Failure::ADDRESS:
+      // (nothing more is tried until the settings change, or a test of the connection works)
+      m_blocked = true;
+      CLog::Log(LOGWARNING, "Projector: {}: {}{}{}; nothing more is sent until its settings change",
+                doing, FailureName(result.failure), result.detail.empty() ? "" : ": ",
+                result.detail);
+      Notify(result.failure == Failure::PASSWORD_NEEDED ? Fill(Text(62755), name)
+             : result.failure == Failure::ADDRESS       ? Text(62759)
+                                                        : Fill(Text(62754), name));
+      return;
+    case Failure::BUSY:
+      notice = Fill(Text(62756), name);
+      break;
+    case Failure::PROTOCOL:
+      notice = Fill(Text(62762), name, result.detail);
+      break;
+    case Failure::NO_ANSWER:
+      notice = Fill(Text(62769), name);
+      break;
+    default:
+      notice = Fill(Text(62753), name, config.address);
+      break;
+  }
+  m_failures++;
+  m_retryAt = Now() + RetryAfter(m_failures);
+  CLog::Log(LOGWARNING, "Projector: {}: {}{}{}; asked again in {:.0f} s", doing,
+            FailureName(result.failure), result.detail.empty() ? "" : ": ", result.detail,
+            RetryAfter(m_failures));
+  if (playing && !m_noticeGiven)
+  {
+    m_noticeGiven = true;
+    Notify(notice);
+  }
+}
+
+void CProjectorControl::Notify(const std::string& text)
+{
+  CGUIDialogKaiToast::QueueNotification(CGUIDialogKaiToast::Warning, Text(62750), text, 8000);
+}
+
+void CProjectorControl::Publish()
+{
+  Status status;
+  status.brand = m_config.brand;
+  status.lens = m_config.lens;
+  status.memory = m_sentMemory;
+  status.signal = m_sentSignal;
+  status.code = m_sentCode;
+  status.problem = m_blocked || m_failures > 0 ? m_problem : Failure::NONE;
+  status.off = m_off;
+  status.blockedAddress = m_addressSaid;
+  std::lock_guard lock(g_statusLock);
+  g_status = status;
+}
+
+bool CProjectorControl::OnSettingChanging(const std::shared_ptr<const CSetting>& setting)
+{
+  if (!setting || setting->GetId() != CSettings::SETTING_VIDEOSCREEN_HADESPROJECTORADDRESS)
+    return true;
+  const auto text = std::static_pointer_cast<const CSettingString>(setting);
+  const std::string value = Trimmed(text->GetValue());
+  if (value.empty())
+    return true;
+  const Address address = ReadAddress(value);
+  if (!address.valid)
+  {
+    KODI::MESSAGING::HELPERS::ShowOKDialogText(CVariant{Text(62750)}, CVariant{Text(62759)});
+    return false;
+  }
+  if (address.home)
+    return true;
+  // an address outside the home networks: only once the user says so
+  if (KODI::MESSAGING::HELPERS::ShowYesNoDialogText(CVariant{Text(62750)},
+                                                    CVariant{Fill(Text(62760), value)}) !=
+      KODI::MESSAGING::HELPERS::DialogResponse::CHOICE_YES)
+    return false;
+  std::lock_guard lock(m_confirmLock);
+  m_confirming = value;
+  return true;
+}
+
+void CProjectorControl::OnSettingChanged(const std::shared_ptr<const CSetting>& setting)
+{
+  if (!setting)
+    return;
+  const auto settings = SettingsNow();
+  if (!settings)
+    return;
+  const std::string& id = setting->GetId();
+  if (id == CSettings::SETTING_VIDEOSCREEN_HADESPROJECTORADDRESS)
+  {
+    const std::string value =
+        Trimmed(settings->GetString(CSettings::SETTING_VIDEOSCREEN_HADESPROJECTORADDRESS));
+    std::string confirmed;
+    {
+      std::lock_guard lock(m_confirmLock);
+      if (m_confirming == value)
+        confirmed = value;
+      m_confirming.clear();
+    }
+    // (an address of a home network needs no confirmation: one kept from before goes)
+    settings->SetString(CSettings::SETTING_VIDEOSCREEN_HADESPROJECTORCONFIRMED, confirmed);
+  }
+  else if (id == CSettings::SETTING_VIDEOSCREEN_HADESPROJECTOR)
+  {
+    // the modes and memories of another protocol are other numbers: those that it does not have
+    // go back to their defaults
+    const Brand brand = BrandSet();
+    for (const Signal kind : KINDS)
+    {
+      const int code = settings->GetInt(ModeSetting(kind));
+      if (code >= 0 && !ModeNameOf(brand, code))
+        settings->SetInt(ModeSetting(kind), -1);
+    }
+    const int memories = MemoriesOf(brand);
+    if (memories > 0)
+    {
+      if (settings->GetInt(CSettings::SETTING_VIDEOSCREEN_HADESPROJECTORLENSNARROW) > memories)
+        settings->SetInt(CSettings::SETTING_VIDEOSCREEN_HADESPROJECTORLENSNARROW, 1);
+      if (settings->GetInt(CSettings::SETTING_VIDEOSCREEN_HADESPROJECTORLENSWIDE) > memories)
+        settings->SetInt(CSettings::SETTING_VIDEOSCREEN_HADESPROJECTORLENSWIDE, 2);
+      if (settings->GetInt(CSettings::SETTING_VIDEOSCREEN_HADESPROJECTORLENSWIDEST) > memories)
+        settings->SetInt(CSettings::SETTING_VIDEOSCREEN_HADESPROJECTORLENSWIDEST, 0);
+    }
+  }
+  m_wake.Set();
+}
+
+void CProjectorControl::OnSettingAction(const std::shared_ptr<const CSetting>& setting)
+{
+  if (!setting || setting->GetId() != CSettings::SETTING_VIDEOSCREEN_HADESPROJECTORTEST)
+    return;
+  // the test runs on the thread of the control, which is the only one that talks to the projector
+  // (a JVC takes one connection at a time); the settings wait for it under the busy dialog
+  m_testDone.Reset();
+  m_testAsked = true;
+  m_wake.Set();
+  CGUIDialogBusy::WaitOnEvent(m_testDone, 100, false);
+  std::string text;
+  {
+    std::lock_guard lock(m_testLock);
+    text = m_testText;
+  }
+  KODI::MESSAGING::HELPERS::ShowOKDialogText(CVariant{Text(62750)}, CVariant{text});
+}
+
+void CProjectorControl::ModesFiller(const std::shared_ptr<const CSetting>& setting,
+                                    IntegerSettingOptions& list,
+                                    int& current)
+{
+  list.emplace_back(Text(62738), -1);
+  bool found = current == -1;
+  for (const auto& mode : ModesOf(BrandSet()))
+  {
+    list.emplace_back(mode.name, mode.code);
+    found = found || mode.code == current;
+  }
+  if (!found)
+    current = -1;
+}
+
+namespace
+{
+void Memories(IntegerSettingOptions& list, int& current, bool none)
+{
+  const Brand brand = BrandSet();
+  const int count = brand == Brand::NONE ? 10 : MemoriesOf(brand);
+  bool found = false;
+  if (none)
+  {
+    list.emplace_back(Text(62740), 0);
+    found = current == 0;
+  }
+  for (int memory = 1; memory <= count; memory++)
+  {
+    std::string label = Fill(Text(62739), std::to_string(memory));
+    const char* own = MemoryOwnName(brand, memory);
+    if (*own)
+      label += StringUtils::Format(" ({})", own);
+    list.emplace_back(label, memory);
+    found = found || memory == current;
+  }
+  if (!found && !list.empty())
+    current = list.front().value;
+}
+} // namespace
+
+void CProjectorControl::MemoriesFiller(const std::shared_ptr<const CSetting>& setting,
+                                       IntegerSettingOptions& list,
+                                       int& current)
+{
+  Memories(list, current, false);
+}
+
+void CProjectorControl::MemoriesOrNoneFiller(const std::shared_ptr<const CSetting>& setting,
+                                             IntegerSettingOptions& list,
+                                             int& current)
+{
+  Memories(list, current, true);
+}
+
+std::string PlayerInfoText()
+{
+  Status status;
+  {
+    std::lock_guard lock(g_statusLock);
+    status = g_status;
+  }
+  if (status.brand == Brand::NONE)
+    return "";
+  std::vector<std::string> parts;
+  if (status.blockedAddress)
+    parts.push_back(Word(54793, "nothing sent: the address is not allowed"));
+  else if (status.off)
+    parts.push_back(Word(54789, "off or warming up"));
+  else
+    switch (status.problem)
+    {
+      case Failure::NONE:
+        break;
+      case Failure::PASSWORD_REFUSED:
+        parts.push_back(Word(54787, "password refused"));
+        break;
+      case Failure::PASSWORD_NEEDED:
+        parts.push_back(Word(54788, "asks for a password"));
+        break;
+      case Failure::BUSY:
+        parts.push_back(Word(54791, "busy with another connection"));
+        break;
+      case Failure::REJECTED:
+        parts.push_back(Word(54792, "refused a command"));
+        break;
+      default:
+        parts.push_back(Word(54786, "not answering"));
+        break;
+    }
+  // (what stands in the way is what the row says then; otherwise what was selected)
+  if (!parts.empty())
+    return std::string(BrandName(status.brand)) + ": " + parts.front();
+  if (status.lens && status.memory > 0)
+  {
+    const Fed fed = Read();
+    std::string how = Word(54784, "frame");
+    if (fed.howKind == HowKind::LEVEL5)
+      how = Word(54782, "level 5");
+    else if (fed.howKind == HowKind::MEASURED)
+      how = Word(54783, "measured");
+    if (fed.shape.valid && fed.pictureAge < 2.0)
+      parts.push_back(Fill(Word(54781, "memory {0} for {1}:1 ({2})"), std::to_string(status.memory),
+                           StringUtils::Format("{:.2f}", fed.shape.ratio), how));
+    else
+      parts.push_back(Fill(Word(54794, "memory {0}"), std::to_string(status.memory)));
+  }
+  if (status.code >= 0)
+  {
+    // (the name of the mode without what the list of the settings adds in brackets)
+    const char* name = ModeNameOf(status.brand, status.code);
+    std::string shown = name ? name : "?";
+    if (const size_t at = shown.find(" ("); at != std::string::npos)
+      shown.erase(at);
+    parts.push_back(Fill(Word(54785, "mode {0}"), shown));
+  }
+  if (parts.empty())
+    parts.push_back(Word(54790, "nothing sent yet"));
+  std::string text = std::string(BrandName(status.brand)) + ": ";
+  for (size_t i = 0; i < parts.size(); i++)
+    text += (i ? ", " : "") + parts[i];
+  return text;
+}
+
+} // namespace PROJECTOR
diff --git a/xbmc/network/ProjectorControl.h b/xbmc/network/ProjectorControl.h
new file mode 100644
index 0000000..af7917d
--- /dev/null
+++ b/xbmc/network/ProjectorControl.h
@@ -0,0 +1,156 @@
+/*
+ *  Copyright (C) 2026 Hades
+ *  This file is part of LibreELEC Hades. It is not in Kodi as Team Kodi publishes it.
+ *
+ *  SPDX-License-Identifier: GPL-2.0-or-later
+ *  See LICENSES/README.md for more information.
+ */
+
+#pragma once
+
+/*!
+ * \file
+ * \brief Hades: network control of a home-cinema projector (System > Display, "Projector control
+ *        over the network", off by default).
+ *
+ * The user chooses the protocol of the projector (JVC D-ILA, Sony ADCP or SDCP, Epson ESC/VP.net),
+ * writes its IP address and, where it has one, its network password. Hades then:
+ *  - selects the lens memory of the shape of the picture (constant image height: the user maps up to
+ *    three classes of shape to memories), at the start of a video and when the shape changes and
+ *    lasts, and, if the user wants it, the memory of narrower pictures when the video ends;
+ *  - selects the picture mode that the user chose for the kind of signal (SDR, HDR10, HLG, Dolby
+ *    Vision, 3D), when the kind changes.
+ * What to ask of it: ProjectorPolicy.h; the protocols: ProjectorLink.h; what the player tells it:
+ * ProjectorFeed.h.
+ *
+ * Safety: Hades only connects, over TCP, to the address the user wrote (an IP address: no name is
+ * looked up), on the port of the protocol; it never listens. An address outside the home networks
+ * (RFC 1918, link-local, IPv6 unique local) is refused unless the user confirmed it when writing it
+ * (videoscreen.hadesprojectorconfirmed holds the address confirmed). The password is kept as Kodi
+ * keeps the password of its web server (guisettings.xml, shown hidden), and never written to the
+ * log: what is sent of it is said as "(password)".
+ *
+ * Robustness: everything runs on a thread of its own, which the player never waits for. A talk with
+ * the projector has timeouts on every step; one command at a time; after a lens memory, no other one
+ * for LENS_QUIET_SECONDS (a lens takes many seconds to move, and a JVC answers only once it has). A
+ * projector that does not answer, or is off, is asked again after 5 s, then twice as long each time
+ * up to 5 minutes, and the user is told once (only while a video plays), not at every try. A command
+ * that the projector refuses is not repeated: it is said once, and in kodi.log with its answer.
+ * kodi.log has every byte sent and received (the password aside), and the player information a row
+ * while it is on.
+ */
+
+#include "ProjectorLink.h"
+#include "ProjectorPolicy.h"
+#include "settings/lib/ISettingCallback.h"
+#include "settings/lib/SettingDefinitions.h"
+#include "threads/CriticalSection.h"
+#include "threads/Event.h"
+#include "threads/Thread.h"
+
+#include <memory>
+#include <string>
+#include <vector>
+
+class CSetting;
+
+namespace PROJECTOR
+{
+
+class CProjectorControl : public CThread, public ISettingCallback
+{
+public:
+  CProjectorControl();
+  ~CProjectorControl() override;
+
+  // ISettingCallback
+  bool OnSettingChanging(const std::shared_ptr<const CSetting>& setting) override;
+  void OnSettingChanged(const std::shared_ptr<const CSetting>& setting) override;
+  void OnSettingAction(const std::shared_ptr<const CSetting>& setting) override;
+
+  //! the picture modes of the protocol chosen ("hadesprojectormodes")
+  static void ModesFiller(const std::shared_ptr<const CSetting>& setting,
+                          IntegerSettingOptions& list,
+                          int& current);
+  //! its lens memories ("hadesprojectormemories"), and the same with "None" first
+  //! ("hadesprojectormemoriesornone")
+  static void MemoriesFiller(const std::shared_ptr<const CSetting>& setting,
+                             IntegerSettingOptions& list,
+                             int& current);
+  static void MemoriesOrNoneFiller(const std::shared_ptr<const CSetting>& setting,
+                                   IntegerSettingOptions& list,
+                                   int& current);
+
+  //! a lens memory is left alone for this long after one was selected
+  static constexpr double LENS_QUIET_SECONDS = 10.0;
+
+protected:
+  void Process() override;
+
+private:
+  struct Config
+  {
+    Brand brand = Brand::NONE;
+    std::string address;
+    std::string password;
+    std::string confirmed;
+    bool lens = false;
+    LensSettings lensSettings;
+    //! the picture mode of each kind of signal (Signal), -1: leave it
+    int modes[6] = {-1, -1, -1, -1, -1, -1};
+    bool SameLink(const Config& o) const
+    {
+      return brand == o.brand && address == o.address && password == o.password &&
+             confirmed == o.confirmed;
+    }
+  };
+  static Config ReadConfig();
+  void Tick();
+  //! a talk: the test, or what is due; true where something was tried
+  void RunTest(const Config& config);
+  void Send(const Config& config, bool playing, int memory, Signal signal, int mode);
+  std::unique_ptr<CSession> MakeSession(const Config& config);
+  //! a failure of a talk: its retry, its notice (once), its line in the player information
+  void Failed(const Config& config, const Result& result, bool playing, const char* doing);
+  void Notify(const std::string& text);
+  void Publish();
+  double Now() const;
+
+  CEvent m_wake;
+  // (the thread's own state)
+  Config m_config;
+  bool m_configRead = false;
+  CLensFollow m_lens;
+  CSignalFollow m_signal;
+  int m_sentMemory = 0;
+  double m_lensQuietUntil = 0.0;
+  Signal m_modeSignal = Signal::NONE; //!< the kind whose mode is to be sent
+  int m_modeCode = -1;
+  Signal m_sentSignal = Signal::NONE;
+  int m_sentCode = -1;
+  int m_failures = 0;
+  double m_retryAt = 0.0;
+  bool m_blocked = false; //!< the password: nothing more until the settings change
+  bool m_addressSaid = false;
+  bool m_noticeGiven = false;
+  bool m_hashed = false;
+  std::string m_model;
+  // (what the player information shows: PlayerInfoText())
+  Failure m_problem = Failure::NONE;
+  bool m_off = false;
+
+  // the test of the connection, asked by the settings (OnSettingAction)
+  std::atomic<bool> m_testAsked{false};
+  CEvent m_testDone;
+  CCriticalSection m_testLock;
+  std::string m_testText;
+
+  // an address outside the home networks that the user confirmed while writing it
+  CCriticalSection m_confirmLock;
+  std::string m_confirming;
+};
+
+//! The row of the player information: "" while the control is off
+std::string PlayerInfoText();
+
+} // namespace PROJECTOR
