+
+#: xbmc/network/ProjectorControl.cpp
+#. Hades: the projector control: value of videoscreen.hadesprojector; translated in Estuary (#54703)
+msgctxt "#62703"
+msgid "Off"
+msgstr ""
+
+#: xbmc/network/ProjectorControl.cpp
+#. Hades: the projector control: value of videoscreen.hadesprojector; translated in Estuary (#54704)
+msgctxt "#62704"
+msgid "JVC D-ILA"
+msgstr ""
+
+#: xbmc/network/ProjectorControl.cpp
+#. Hades: the projector control: value of videoscreen.hadesprojector; translated in Estuary (#54705)
+msgctxt "#62705"
+msgid "Sony, ADCP (VPL-XW and some VPL-VW)"
+msgstr ""
+
+#: xbmc/network/ProjectorControl.cpp
+#. Hades: the projector control: value of videoscreen.hadesprojector; translated in Estuary (#54706)
+msgctxt "#62706"
+msgid "Sony, SDCP (VPL-VW)"
+msgstr ""
+
+#: xbmc/network/ProjectorControl.cpp
+#. Hades: the projector control: value of videoscreen.hadesprojector; translated in Estuary (#54707)
+msgctxt "#62707"
+msgid "Epson, ESC/VP.net"
+msgstr ""
+
+#: xbmc/network/ProjectorControl.cpp
