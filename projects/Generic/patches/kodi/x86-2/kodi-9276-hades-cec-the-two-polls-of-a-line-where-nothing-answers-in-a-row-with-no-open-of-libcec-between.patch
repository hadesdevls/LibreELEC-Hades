From 2f25d1f66638e5594ca5dd1e05902d4523c87333 Mon Sep 17 00:00:00 2001
From: Hades <15710513+hadesdevls@users.noreply.github.com>
Date: Wed, 25 Nov 2026 04:10:33 +0000
Subject: [PATCH] [Hades][CEC] The two polls of a line where nothing answers in
 a row, with no open of libCEC between

Before libCEC opens an adapter of the kernel, the line is polled; two
polls in a row without a result give it up (libCEC is not asked to open
it, and it is asked again every 30 s). But each turn of the loop of
OpenConnection() polled once: after the first poll without a result
libCEC was asked to open the line, and the second poll came only after
that open. On the line of issue 24 the first open ended after 12 s and
the second did not return; where the first open is the one that does
not return, the line was never given up and the thread of the adapter
held sleep and the end of Kodi as before.

One look at the line (CEC_LINE::AskInRow()) now makes its polls one
after the other, a second apart, at most two, and libCEC is asked to
open the line only after a look that got a result or said nothing; a
thread stopped between two polls ends the look without asking libCEC.
The log says how many polls the look made.
---
 .../devices/PeripheralCecAdapter.cpp          | 23 +++++++++----
 xbmc/peripherals/devices/PeripheralCecLine.h  | 34 ++++++++++++++++++-
 2 files changed, 49 insertions(+), 8 deletions(-)

diff --git a/xbmc/peripherals/devices/PeripheralCecAdapter.cpp b/xbmc/peripherals/devices/PeripheralCecAdapter.cpp
index 6f9061f..cd8e310 100644
--- a/xbmc/peripherals/devices/PeripheralCecAdapter.cpp
+++ b/xbmc/peripherals/devices/PeripheralCecAdapter.cpp
@@ -383,17 +383,26 @@ bool CPeripheralCecAdapter::OpenConnection(void)
       CServiceBroker::GetResourcesComponent().GetLocalizeStrings().Get(36000), strMessage);
 
   bool bConnectionFailedDisplayed(false);
-  // Hades: polls of the line in a row that got no result, and whether that was told
-  int deadInRow = 0;
+  // Hades: whether the log said that nothing answers on the line
   bool deadTold = false;
 
   while (!m_bStop && !bIsOpen)
   {
     // Hades: a line on which nothing answers is not opened by libCEC, whose open waits for minutes
-    // there; it is asked again later (CEC_LINE)
-    const CEC_LINE::Line line = AskLine();
-    deadInRow = line == CEC_LINE::Line::DEAD ? deadInRow + 1 : 0;
-    if (CEC_LINE::GivenUp(deadInRow))
+    // there; it is asked again later (CEC_LINE). The polls of one look are made in a row, with no
+    // open of libCEC between them (CEC_LINE::AskInRow())
+    int asked = 0;
+    const CEC_LINE::Line line = CEC_LINE::AskInRow(
+        [this] { return AskLine(); },
+        [this]
+        {
+          WaitUnlessStopped(std::chrono::seconds(CEC_LINE::BETWEEN_SECONDS));
+          return !m_bStop;
+        },
+        asked);
+    if (m_bStop)
+      continue;
+    if (line == CEC_LINE::Line::DEAD)
     {
       if (!deadTold)
         CLog::Log(LOGWARNING,
@@ -401,7 +410,7 @@ bool CPeripheralCecAdapter::OpenConnection(void)
                   "of the line, only timeouts or errors ({} in a row), as every message would. "
                   "libCEC does not open it (its open would wait for minutes); the line is asked "
                   "again every {} s. A DisplayPort output whose converter passes no CEC does this",
-                  m_strComPort, deadInRow, CEC_LINE::AGAIN_SECONDS);
+                  m_strComPort, asked, CEC_LINE::AGAIN_SECONDS);
       deadTold = true;
       WaitUnlessStopped(std::chrono::seconds(CEC_LINE::AGAIN_SECONDS));
       continue;
diff --git a/xbmc/peripherals/devices/PeripheralCecLine.h b/xbmc/peripherals/devices/PeripheralCecLine.h
index ed9d0b3..3c2a0ba 100644
--- a/xbmc/peripherals/devices/PeripheralCecLine.h
+++ b/xbmc/peripherals/devices/PeripheralCecLine.h
@@ -27,7 +27,7 @@ namespace CEC_LINE
  * and the thread of the adapter, stopped at sleep or at the end of Kodi, held those up until it
  * returned (11 s at the end of Kodi in that report).
  *
- * So before libCEC opens it, the line is asked once: a poll from the unregistered address to the
+ * So before libCEC opens it, the line is asked: a poll from the unregistered address to the
  * TV (the message 0xf0, which the kernel sends on an adapter that has no logical address yet). A
  * result of the line, an acknowledgement or a negative one (no TV), says that it works, and libCEC
  * opens it as before. Neither, only a timeout, an error or lost arbitration after the retries of the
@@ -80,5 +80,37 @@ constexpr bool GivenUp(int deadInRow)
   return deadInRow >= DEAD_IN_ROW;
 }
 
+//! How long the thread of the adapter waits between two polls of one look at a line, in seconds
+inline constexpr int BETWEEN_SECONDS = 1;
+
+/*!
+ * \brief One look at the line before libCEC is asked to open it: polls in a row (\p ask), until one
+ *        gets anything but no result, and at most DEAD_IN_ROW of them (GivenUp()), with \p pause
+ *        between two
+ *
+ * The polls of one look are made one after the other, and libCEC is asked to open the line only
+ * after a look that is not DEAD: never between two of its polls. An open of libCEC on a line where
+ * nothing answers is what did not return in issue 24 (the second open there; the first ended after
+ * 12 s), so a line given up only after a poll, an open and another poll was not given up at all
+ * where the first open was the one that did not return.
+ * \param pause waits between two polls; false where the thread stops meanwhile, and the look then
+ *        ends DEAD, so that libCEC is not asked to open the line on the way out
+ * \param[out] asked the polls made
+ */
+template<typename Ask, typename Pause>
+Line AskInRow(Ask ask, Pause pause, int& asked)
+{
+  asked = 0;
+  while (true)
+  {
+    const Line line = ask();
+    ++asked;
+    if (line != Line::DEAD || GivenUp(asked))
+      return line;
+    if (!pause())
+      return Line::DEAD;
+  }
+}
+
 } // namespace CEC_LINE
 } // namespace PERIPHERALS
