+  // offset, different for each start, seek and resume, until the next correction (at 100 ms).
+  const double packet{stream->m_format.m_streamInfo.GetDuration() * scale};
+  const auto landed = [&](double e)
+  {
+    if (m_mode != MODE_RAW)
+      return fabs(e) < 30 * scale;
+    return AE::SYNC::RawLanded(e, packet, scale);
+  };
