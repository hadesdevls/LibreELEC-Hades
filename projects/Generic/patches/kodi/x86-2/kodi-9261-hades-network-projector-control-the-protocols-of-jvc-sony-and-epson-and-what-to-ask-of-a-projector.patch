+#include "ProjectorFeed.h"
+
+#include "cores/VideoPlayer/VideoRenderers/SubtitleBars.h"
+
+#include <atomic>
+#include <chrono>
+#include <cmath>
+#include <cstring>
+#include <mutex>
+
+namespace PROJECTOR
+{
+
+namespace
+{
+using Clock = std::chrono::steady_clock;
+
+std::atomic<bool> g_barsWanted{false};
+std::atomic<unsigned int> g_video{1};
+
+std::mutex g_lock;
+struct
+{
+  Shape shape;
+  std::string how;
+  HowKind howKind = HowKind::FRAME;
+  Clock::time_point pictureAt{};
+  bool pictureSeen = false;
+  Signal signal = Signal::NONE;
+  Clock::time_point signalAt{};
+  bool signalSeen = false;
+} g_fed;
+} // namespace
+
+void SetBarsWanted(bool wanted)
+{
+  g_barsWanted.store(wanted, std::memory_order_relaxed);
+}
+
+bool BarsWanted()
+{
+  return g_barsWanted.load(std::memory_order_relaxed);
+}
+
+void FeedNewVideo()
+{
+  g_video.fetch_add(1, std::memory_order_relaxed);
+}
+
+Shape ShapeOf(double frameRatio, int height, int barRows, bool barTaken)
+{
+  Shape shape;
+  if (!(frameRatio > 0.0) || !std::isfinite(frameRatio) || height <= 0)
+    return shape;
+  shape.valid = true;
+  shape.ratio = frameRatio;
+  const bool bar = barTaken && barRows > 0 && 2 * barRows < height;
+  if (bar)
+    shape.ratio = frameRatio * height / static_cast<double>(height - 2 * barRows);
+  shape.known = bar || std::abs(frameRatio - 16.0 / 9.0) > SIXTEEN_NINE_TOLERANCE;
+  return shape;
+}
+
+void FeedPicture(double frameRatio, int height, int barRows, const char* barHow, bool measured)
+{
+  Shape shape = ShapeOf(frameRatio, height, barRows, barHow != nullptr);
+  shape.video = g_video.load(std::memory_order_relaxed);
+  std::lock_guard lock(g_lock);
+  g_fed.shape = shape;
+  // (the texts are fixed ones of SubtitleBars.h: copied only when they change)
+  const char* how = barHow && barRows > 0 ? barHow
+                    : measured            ? "the shape of the frame (no bar seen)"
+                                          : "the shape of the frame (bars not measured here)";
+  if (g_fed.how != how)
+    g_fed.how = how;
+  g_fed.howKind = !(barHow && barRows > 0)                                  ? HowKind::FRAME
+                  : std::strcmp(barHow, KODI::SUBTITLES::BARS::HOW_L5) == 0 ? HowKind::LEVEL5
+                                                                            : HowKind::MEASURED;
+  g_fed.pictureAt = Clock::now();
+  g_fed.pictureSeen = true;
+}
+
+void FeedSignal(const std::string& source, const std::string& output, bool stereo)
+{
+  const Signal signal = SignalOf(source, output, stereo);
+  std::lock_guard lock(g_lock);
+  g_fed.signal = signal;
+  g_fed.signalAt = Clock::now();
+  g_fed.signalSeen = true;
+}
+
+Fed Read()
+{
+  const auto now = Clock::now();
+  std::lock_guard lock(g_lock);
+  Fed fed;
+  fed.shape = g_fed.shape;
+  fed.how = g_fed.how;
+  fed.howKind = g_fed.howKind;
+  fed.signal = g_fed.signal;
+  if (g_fed.pictureSeen)
+    fed.pictureAge = std::chrono::duration<double>(now - g_fed.pictureAt).count();
+  if (g_fed.signalSeen)
+    fed.signalAge = std::chrono::duration<double>(now - g_fed.signalAt).count();
+  return fed;
+}
+
+} // namespace PROJECTOR
