+int MemoriesOf(Brand brand)
+{
+  switch (brand)
+  {
+    case Brand::JVC:
+    case Brand::EPSON:
+      return 10;
+    case Brand::SONY_ADCP:
+      return 7;
+    case Brand::SONY_SDCP:
