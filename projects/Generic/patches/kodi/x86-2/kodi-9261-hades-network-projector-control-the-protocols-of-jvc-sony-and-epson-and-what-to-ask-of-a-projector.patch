+Address ReadAddress(const std::string& text)
+{
+  Address address;
+  if (text.empty() || text.size() > 64)
+    return address;
+  addrinfo hints{};
+  hints.ai_family = AF_UNSPEC;
+  hints.ai_flags = AI_NUMERICHOST;
+  hints.ai_socktype = SOCK_STREAM;
+  addrinfo* found = nullptr;
+  if (getaddrinfo(text.c_str(), nullptr, &hints, &found) != 0 || !found)
+    return address;
+  address.valid = true;
+  const auto v4home = [](uint32_t a)
+  {
+    return (a >> 24) == 10 || (a >> 20) == ((172u << 4) | 1u) ||
+           (a >> 16) == ((192u << 8) | 168u) || (a >> 16) == ((169u << 8) | 254u);
+  };
+  if (found->ai_family == AF_INET)
+  {
+    const auto* in = reinterpret_cast<const sockaddr_in*>(found->ai_addr);
+    address.home = v4home(ntohl(in->sin_addr.s_addr));
+  }
+  else if (found->ai_family == AF_INET6)
+  {
+    const auto* in6 = reinterpret_cast<const sockaddr_in6*>(found->ai_addr);
+    const uint8_t* b = in6->sin6_addr.s6_addr;
+    // fc00::/7 (unique local), fe80::/10 (link-local), and an IPv4 address in IPv6 (::ffff:a.b.c.d)
+    if ((b[0] & 0xFE) == 0xFC || (b[0] == 0xFE && (b[1] & 0xC0) == 0x80))
+      address.home = true;
+    else if (IN6_IS_ADDR_V4MAPPED(&in6->sin6_addr))
+      address.home = v4home((uint32_t(b[12]) << 24) | (uint32_t(b[13]) << 16) |
+                            (uint32_t(b[14]) << 8) | b[15]);
+  }
+  else
+    address.valid = false;
+  freeaddrinfo(found);
+  return address;
+}
+
+std::string Printable(const std::string& bytes)
+{
+  std::string text;
+  for (const unsigned char c : bytes)
+  {
+    if (c == '\\')
+      text += "\\\\";
+    else if (c >= 0x20 && c < 0x7F)
+      text += static_cast<char>(c);
+    else if (c == '\n')
+      text += "\\n";
+    else if (c == '\r')
+      text += "\\r";
+    else
+    {
+      char hex[8];
+      std::snprintf(hex, sizeof(hex), "\\x%02X", c);
+      text += hex;
+    }
+  }
+  return text;
+}
