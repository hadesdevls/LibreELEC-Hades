+#pragma once
+
+/*!
+ * \file
+ * \brief Hades: network control of a home-cinema projector (ProjectorControl.h): what the player and
+ *        the window system tell it, read by its own thread. Cheap where it is called: a store under a
+ *        lock of its own. Nothing here uses Kodi.
+ */
+
+#include "ProjectorPolicy.h"
+
+#include <string>
+
+namespace PROJECTOR
+{
+
+//! The control wants the bars of the picture measured (subtitles in the black bars measures them
+//! too): set by the control, read by the renderer (any thread)
+void SetBarsWanted(bool wanted);
+bool BarsWanted();
+
+//! A stream starts (CRenderManager::Configure()): what comes next is of another video
+void FeedNewVideo();
+
+/*!
+ * \brief The picture presented (render thread, with BarsWanted()): the shape of its frame as Kodi
+ *        shows it, its height in rows, the bar under its active picture (SubtitleBars.h: 0 none
+ *        seen), how that bar was taken (nullptr: no bar), and whether the renderer measures bars at all
+ */
+void FeedPicture(double frameRatio, int height, int barRows, const char* barHow, bool measured);
+
+//! The signal (the window system, twice a second): hades.src.hdrtype, hades.out.hdrtype, 3D output
+void FeedSignal(const std::string& source, const std::string& output, bool stereo);
+
+//! where the shape comes from
+enum class HowKind
+{
+  FRAME, //!< the shape of the frame: no bar
+  LEVEL5, //!< a bar from the active area of Dolby Vision metadata
+  MEASURED, //!< a bar measured on the pictures
+};
+
+struct Fed
+{
+  Shape shape;
+  //! how the shape was found, for the log
+  std::string how;
+  HowKind howKind = HowKind::FRAME;
+  Signal signal = Signal::NONE;
+  //! seconds since the picture and the signal were last told (a large value: never)
+  double pictureAge = 1e9;
+  double signalAge = 1e9;
+};
+Fed Read();
+
+/*!
+ * \brief The shape of a picture: its frame's shape, and a bar of barRows under it taken as one of
+ *        the same height above it (a letterboxed picture is centred); known where a bar was taken,
+ *        or where the frame is not 16:9 (ProjectorPolicy.h)
+ */
+Shape ShapeOf(double frameRatio, int height, int barRows, bool barTaken);
+
+} // namespace PROJECTOR
