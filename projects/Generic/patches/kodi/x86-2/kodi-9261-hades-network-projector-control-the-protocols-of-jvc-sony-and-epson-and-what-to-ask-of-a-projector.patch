+const std::vector<ModeName>& ModesOf(Brand brand)
+{
+  static const std::vector<ModeName> none;
+  static const std::vector<ModeName> adcp = AdcpModes();
+  switch (brand)
+  {
+    case Brand::JVC:
+      return JVC_MODES;
+    case Brand::SONY_ADCP:
+      return adcp;
+    case Brand::SONY_SDCP:
+      return SDCP_MODES;
+    case Brand::EPSON:
+      return EPSON_MODES;
+    case Brand::NONE:
+      break;
