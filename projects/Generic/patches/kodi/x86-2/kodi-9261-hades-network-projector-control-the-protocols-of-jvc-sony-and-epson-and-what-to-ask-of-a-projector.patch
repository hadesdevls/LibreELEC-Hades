+
+const char* MemoryOwnName(Brand brand, int memory)
+{
+  if (memory < 1 || memory > MemoriesOf(brand))
+    return "";
+  if (brand == Brand::SONY_ADCP)
+    return ADCP_POSITION_NAMES[memory - 1];
+  if (brand == Brand::SONY_SDCP)
+    return SDCP_POSITION_NAMES[memory - 1];
+  return "";
+}
