From 463fb84b3c1084c0cd717aae9ddd9d0b8ed82344 Mon Sep 17 00:00:00 2001
From: Hades <15710513+hadesdevls@users.noreply.github.com>
Date: Fri, 27 Nov 2026 10:22:15 +0000
Subject: [PATCH] [Hades][AudioEngine] A correction of the sync of passthrough
 sound lands within a millisecond either way

The owner's E-AC-3 film started 495 ms behind its video and was put
back with 15 packets left out, "-15 ms off", and kept those 15 ms for
the whole film; DTS-HD kept -4 ms, TrueHD up to -10 ms.

A passthrough stream is put in sync by pauses (ahead: a pause as long
as the error, in whole milliseconds) or by packets left out (behind: a
packet at a time, TrueHD 20 ms, E-AC-3 32 ms, DTS 10.7 ms). Behind, a
correction stopped once the stream was within half a packet, since one
more packet would leave it as far ahead. But ahead is where a pause
puts it back exactly: so behind, packets are left out until the stream
is no longer behind, and the pause that follows takes what that left
ahead, in the same cut of the sound (the pause stands where the last
packet would have played, and is shorter than it).

ActiveAESyncLanding.h: RawLanded() is within a millisecond either way
(scaled as the errors of TrueHD are, TRUEHD_SYNC_ERROR_SCALE),
RawLeaveOut() leaves the packet in hand out while the stream is behind
and has not landed, and RAW_RESUME_CHECK_MS (10 ms, the noise of the
average) is where a resume from a pause is put back, ahead or behind
alike. PCM and transcoded sound keep their 30 ms.

Where a correction lands is reckoned (the packets left out and the
pauses counted, not measured). The first average after it, a second of
fresh readings, is now said once in kodi.log against that ("measured
after its correction"), so that a log shows where the sound really is;
nothing is done for it there.
---
 .../AudioEngine/Engines/ActiveAE/ActiveAE.cpp | 52 ++++++++++++-------
 .../Engines/ActiveAE/ActiveAEStream.h         |  3 ++
 .../Engines/ActiveAE/ActiveAESyncLanding.h    | 51 ++++++++++--------
 3 files changed, 67 insertions(+), 39 deletions(-)

diff --git a/xbmc/cores/AudioEngine/Engines/ActiveAE/ActiveAE.cpp b/xbmc/cores/AudioEngine/Engines/ActiveAE/ActiveAE.cpp
index d71d944..a3d9b4e 100644
--- a/xbmc/cores/AudioEngine/Engines/ActiveAE/ActiveAE.cpp
+++ b/xbmc/cores/AudioEngine/Engines/ActiveAE/ActiveAE.cpp
@@ -2188,6 +2188,7 @@ bool CActiveAE::HoldRawStream(CActiveAEStream* stream)
   hold.at = now;
   stream->m_rawHold = std::move(hold);
   stream->m_rawResumeCheck = false;
+  stream->m_rawLandedAt.reset();
 
   const double scale{IsTrueHDPassthrough() ? TRUEHD_SYNC_ERROR_SCALE : 1.0};
   CLog::Log(LOGINFO,
@@ -2338,6 +2339,7 @@ bool CActiveAE::ResumeRawStream(CActiveAEStream* stream)
 void CActiveAE::DropRawHold(CActiveAEStream* stream, const char* why)
 {
   stream->m_rawResumeCheck = false;
+  stream->m_rawLandedAt.reset();
   // the pools of copies go with the stream's buffers: deleted once the last of them is back, as
   // those of a stream (ClearDiscardedBuffers())
   for (auto& copies : stream->m_rawCopyPools)
@@ -3308,6 +3310,7 @@ CSampleBuffer* CActiveAE::SyncStream(CActiveAEStream *stream)
     stream->m_resampleIntegral = 0;
     stream->m_lateStartHandedOver = false;
     stream->m_rawMuted = 0; // (Hades)
+    stream->m_rawLandedAt.reset(); // (Hades)
     CLog::Log(LOGDEBUG,"ActiveAE - start sync of audio stream");
   }
 
@@ -3358,37 +3361,50 @@ CSampleBuffer* CActiveAE::SyncStream(CActiveAEStream *stream)
            (clockFollowsAudio && syncError < 0 && -syncError <= MAX_LATE_START_MS);
   };
 
-  // Hades: where a correction of a passthrough stream lands (RawLanded(), RawLandingMs()): as close
-  // to the video as its sound can be put: a pause is as long as the error, so ahead it lands within a
-  // millisecond; a packet is left out whole, so behind it lands within half a packet (TrueHD 10 ms,
-  // E-AC-3 16 ms, DTS 5 ms). Up to 1.2.3 it stopped at 30 ms either way, and the stream kept that
-  // offset, different for each start, seek and resume, until the next correction (at 100 ms).
-  const double packet{stream->m_format.m_streamInfo.GetDuration() * scale};
+  // Hades: where a correction of a passthrough stream lands (ActiveAESyncLanding.h): within a
+  // millisecond of the video, ahead or behind: a pause is as long as the error, and behind, packets
+  // are left out until the stream is no longer behind, the pause then taking what that left ahead
+  // (RawLeaveOut()). Up to 1.2.3 it stopped at 30 ms either way, and the stream kept that offset,
+  // different for each start, seek and resume, until the next correction (at 100 ms); the 1.2.3 test
+  // builds kept up to half a packet behind (TrueHD 10 ms, E-AC-3 16 ms, DTS 5 ms) for the whole film.
   const auto landed = [&](double e)
   {
     if (m_mode != MODE_RAW)
       return fabs(e) < 30 * scale;
-    return AE::SYNC::RawLanded(e, packet, scale);
+    return AE::SYNC::RawLanded(e, scale);
   };
 
   // Hades: the first average of a passthrough stream that resumed in sync from a pause
-  // (ResumeRawStream()) is said, and held to where a correction lands (at least 10 ms, the noise of
-  // the average) rather than to the threshold: a resume that the reckoning got wrong is put back
-  // once, late or ahead (the player's clock does not follow passthrough sound, see
-  // clockFollowsAudio above).
+  // (ResumeRawStream()) is said, and held to 10 ms (the noise of the average) rather than to the
+  // threshold: a resume that the reckoning got wrong is put back once, late or ahead (the player's
+  // clock does not follow passthrough sound, see clockFollowsAudio above).
+  // Hades: the first average after a correction of a passthrough stream landed, measured, against
+  // where its reckoning put it (the packets left out and the pauses counted): said once, so that
+  // kodi.log shows where the sound really is (nothing is done for it here)
+  if (newerror && stream->m_rawLandedAt &&
+      stream->m_syncState == CAESyncInfo::AESyncState::SYNC_INSYNC)
+  {
+    CLog::Log(LOGINFO,
+              "ActiveAE::SyncStream - the passthrough stream ({}) measured after its correction: "
+              "{:+.1f} ms against the video (reckoned at {:+.0f} ms; positive: the sound ahead)",
+              CAEUtil::StreamTypeToStr(stream->m_format.m_streamInfo.m_type), error / scale,
+              *stream->m_rawLandedAt);
+    stream->m_rawLandedAt.reset();
+  }
+
   bool resumeOff{false};
   if (newerror && stream->m_rawResumeCheck &&
       stream->m_syncState == CAESyncInfo::AESyncState::SYNC_INSYNC)
   {
     stream->m_rawResumeCheck = false;
-    resumeOff = fabs(error) >= AE::SYNC::RawResumeCheckMs(error, packet, scale) * scale;
+    resumeOff = fabs(error) >= AE::SYNC::RAW_RESUME_CHECK_MS * scale;
     CLog::Log(LOGINFO,
               "ActiveAE::SyncStream - the passthrough stream ({}) that resumed from a pause is "
               "{:.0f} ms {} the video{}",
               CAEUtil::StreamTypeToStr(stream->m_format.m_streamInfo.m_type), fabs(error) / scale,
               error > 0 ? "ahead of" : "behind",
-              resumeOff ? StringUtils::Format(", more than the {:.0f} ms a correction lands in",
-                                              AE::SYNC::RawResumeCheckMs(error, packet, scale))
+              resumeOff ? StringUtils::Format(", {:.0f} ms or more: it is put back",
+                                              AE::SYNC::RAW_RESUME_CHECK_MS)
                         : std::string());
   }
 
@@ -3417,9 +3433,7 @@ CSampleBuffer* CActiveAE::SyncStream(CActiveAEStream *stream)
                 "more than the {:.0f} ms allowed: it is put back with {}, each a cut in the sound",
                 CAEUtil::StreamTypeToStr(stream->m_format.m_streamInfo.m_type), fabs(error) / scale,
                 error > 0 ? "ahead of" : "behind",
-                (fabs(error) > threshold ? threshold
-                                         : AE::SYNC::RawResumeCheckMs(error, packet, scale) * scale) /
-                    scale,
+                (fabs(error) > threshold ? threshold : AE::SYNC::RAW_RESUME_CHECK_MS * scale) / scale,
                 error > 0 ? "pauses" : "packets left out");
     }
   }
@@ -3583,7 +3597,8 @@ CSampleBuffer* CActiveAE::SyncStream(CActiveAEStream *stream)
       }
       if (m_mode == MODE_RAW)
       {
-        if (-error > stream->m_format.m_streamInfo.GetDuration() * scale / 2)
+        // (Hades: until it is no longer behind; a pause then takes what this leaves ahead)
+        if (AE::SYNC::RawLeaveOut(error, scale))
         {
           stream->m_syncError.Correction(stream->m_format.m_streamInfo.GetDuration() * scale);
           // Hades: the readings summed so far for the next average were taken before the packet was
@@ -3618,6 +3633,7 @@ CSampleBuffer* CActiveAE::SyncStream(CActiveAEStream *stream)
       if (stream->m_rawAdjusting)
       {
         stream->m_rawAdjusting = false;
+        stream->m_rawLandedAt = error / scale;
         CLog::Log(LOGINFO,
                   "ActiveAE::SyncStream - the passthrough stream is in sync with the video again "
                   "after {} ms: {:.0f} ms of pauses, {} packets left out, {:+.0f} ms off{}",
diff --git a/xbmc/cores/AudioEngine/Engines/ActiveAE/ActiveAEStream.h b/xbmc/cores/AudioEngine/Engines/ActiveAE/ActiveAEStream.h
index 47b17da..f44a570 100644
--- a/xbmc/cores/AudioEngine/Engines/ActiveAE/ActiveAEStream.h
+++ b/xbmc/cores/AudioEngine/Engines/ActiveAE/ActiveAEStream.h
@@ -315,6 +315,9 @@ protected:
   //! Hades: resumed in sync from a pause: the first average is held to the band of a correction
   //! (CActiveAE::SyncStream())
   bool m_rawResumeCheck{false};
+  //! Hades: a correction of a passthrough stream landed where its reckoning says (ms, unscaled;
+  //! positive: ahead): the first average after it is said against that (CActiveAE::SyncStream())
+  std::optional<double> m_rawLandedAt;
 };
 }
 
diff --git a/xbmc/cores/AudioEngine/Engines/ActiveAE/ActiveAESyncLanding.h b/xbmc/cores/AudioEngine/Engines/ActiveAE/ActiveAESyncLanding.h
index f973cc5..c9f0058 100644
--- a/xbmc/cores/AudioEngine/Engines/ActiveAE/ActiveAESyncLanding.h
+++ b/xbmc/cores/AudioEngine/Engines/ActiveAE/ActiveAESyncLanding.h
@@ -8,7 +8,6 @@
 
 #pragma once
 
-#include <algorithm>
 #include <cmath>
 
 /*!
@@ -16,35 +15,45 @@
  * \brief Hades: where a correction of the sync of a passthrough stream lands (CActiveAE::SyncStream())
  *
  * A passthrough stream cannot be resampled: it is put back in sync with the video by pauses (the
- * stream is ahead: a pause as long as the error, IEC 61937 pause bursts) or by packets left out (it
- * is behind: a packet at a time, TrueHD 20 ms, E-AC-3 32 ms, DTS 10.7 ms). Up to 1.2.3 a correction
- * stopped as soon as the error was within 30 ms, and the stream kept what was left, different for
- * each start, seek and resume (the owner's TrueHD: -26 ms after one start, -15 after another, -13
- * after a resume), until the error passed the threshold of 100 ms. Now it goes on to where the sound
- * can be put: ahead, within a millisecond; behind, within half a packet (one more packet would leave
- * it as far ahead). The errors of TrueHD are measured scaled (TRUEHD_SYNC_ERROR_SCALE), and every
- * length here is scaled as they are (scale).
+ * stream is ahead: a pause as long as the error, IEC 61937 pause bursts, in whole milliseconds) or by
+ * packets left out (it is behind: a packet at a time, TrueHD 20 ms, E-AC-3 32 ms, DTS 10.7 ms). Up to
+ * 1.2.3 a correction stopped as soon as the error was within 30 ms, and the stream kept what was
+ * left, different for each start, seek and resume (the owner's TrueHD: -26 ms after one start, -15
+ * after another, -13 after a resume). The 1.2.3 test builds landed behind within half a packet (one
+ * more packet, it was reasoned, would leave the stream as far ahead), and the stream kept up to that
+ * behind for the whole film: the owner's E-AC-3 started 495 ms behind and kept -15 ms, DTS-HD up to
+ * -5 and TrueHD up to -10. But a stream left ahead is put back by a pause as long as the error, so
+ * the packet that leaves it ahead is followed by such a pause: behind, packets are left out until the
+ * stream is no longer behind, and the pause takes what that left ahead. Either way it lands within a
+ * millisecond of the video, in the same cut of the sound (the pause stands where the last packet
+ * left out would have played, and is shorter than it). The errors of TrueHD are measured scaled
+ * (TRUEHD_SYNC_ERROR_SCALE), and every length here is scaled as they are (scale).
  */
 namespace AE::SYNC
 {
 
-//! a correction has landed: error and packet scaled as the measure is (ms times scale)
-inline bool RawLanded(double error, double packet, double scale)
+//! within a millisecond of real time, scaled as the measure is (ms times scale)
+constexpr double LANDING_MS = 1.0;
+
+//! a correction has landed: error scaled as the measure is (ms times scale)
+inline bool RawLanded(double error, double scale)
+{
+  return std::fabs(error) < LANDING_MS * scale;
+}
+
+//! the packet in hand is left out: the stream is behind and not where a correction lands; what
+//! that leaves ahead (less than a packet) is put back by a pause
+inline bool RawLeaveOut(double error, double scale)
 {
-  if (error >= 0)
-    return error < 1.0 * scale;
-  return -error <= packet / 2;
+  return error < 0 && !RawLanded(error, scale);
 }
 
 /*!
  * \brief The error (unscaled, ms) from which a passthrough stream that resumed from a pause is put
- *        back: where a correction lands, and at least 10 ms (an average of the error moves by a few
- *        ms from one to the next: a resume within that is left alone)
+ *        back: 10 ms, the noise of the average (an average of the error moves by a few ms from one
+ *        to the next: a resume within that is left alone), ahead or behind alike now that a
+ *        correction lands within a millisecond either way
  */
-inline double RawResumeCheckMs(double error, double packet, double scale)
-{
-  const double landing = error >= 0 ? 1.0 : packet / scale / 2;
-  return std::max(10.0, landing);
-}
+constexpr double RAW_RESUME_CHECK_MS = 10.0;
 
 } // namespace AE::SYNC
