+//! Hades: what Dolby Vision Low-Latency comes to for a video, where it is offered and asked for
+enum class LowLatencyWay
+{
+  NOT_ASKED, //!< not offered, or not asked for: the signal is as SignalOf() says
+  LOW_LATENCY, //!< Low-Latency, mapped to the display's target
+  //! asked also where the display takes Standard (videoscreen.hadesdvllalways), and the display's
+  //! Low-Latency target cannot be used: Standard, which the display takes (issue #25: it was
+  //! Low-Latency, refused with its first picture, and the base layer played as HDR10)
+  STANDARD,
+  //! the display offers Low-Latency only, and its target cannot be used: no native output (the
+  //! reason "lltarget"), and Dolby Vision plays as on a display without it
+  NO_TARGET,
+};
+
+/*!
+ * \brief Hades: what Dolby Vision Low-Latency comes to for a video
+ * \param takesStandard the display takes Dolby Vision Standard
+ * \param offersLowLatency it offers Low-Latency (a valid Dolby Vision block that gives it)
+ * \param lowLatencyOn Low-Latency is turned on (videoscreen.hadesdvlowlatency, as read for the
+ *        video)
+ * \param always ... also where the display takes Standard (videoscreen.hadesdvllalways)
+ * \param targetUsable whether the display's Low-Latency target can be mapped to: asked only where
+ *        Low-Latency is offered and asked for
+ */
+template<typename TargetUsable>
+LowLatencyWay LowLatencyWayOf(bool takesStandard,
+                              bool offersLowLatency,
+                              bool lowLatencyOn,
+                              bool always,
+                              TargetUsable targetUsable)
+{
+  if (!offersLowLatency || !lowLatencyOn || (takesStandard && !always))
+    return LowLatencyWay::NOT_ASKED;
+  if (targetUsable())
+    return LowLatencyWay::LOW_LATENCY;
+  return takesStandard ? LowLatencyWay::STANDARD : LowLatencyWay::NO_TARGET;
+}
