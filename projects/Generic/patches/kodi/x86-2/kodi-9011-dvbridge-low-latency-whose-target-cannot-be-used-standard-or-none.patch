+bool CWinSystemGbmGLESContext::DVLowLatencyTargetUsable() const
+{
+  const UTILS::DolbyVideoBlock dv = DVDolbyVideoBlock();
+  // (no target of Low-Latency to judge: Low-Latency is not what the display takes)
+  if (!dv.valid || !dv.lowLatency)
+    return true;
+  const std::array<double, 10> key = {static_cast<double>(DVVideoGeneration()),
+                                      static_cast<double>(dv.version * 10000 + dv.targetMaxPq),
+                                      dv.targetMaxNits,
+                                      dv.redX,
+                                      dv.redY,
+                                      dv.greenX,
+                                      dv.greenY,
+                                      dv.blueX,
+                                      dv.blueY,
+                                      static_cast<double>(dv.targetMinPq) + dv.targetMinNits};
+  std::unique_lock lock(m_dvLlTargetLock);
+  if (m_dvLlTargetKnown && key == m_dvLlTargetKey)
+    return m_dvLlTargetUsable;
+  bool manual = false;
+  const dvbridge_hdr10_mapping mapping = DVLowLatencyTarget(dv, manual);
+  m_dvLlTargetUsable = dvbridge_hdr10_mapping_valid(&mapping);
+  m_dvLlTargetKnown = true;
+  m_dvLlTargetKey = key;
+  if (!m_dvLlTargetUsable)
+    CLog::Log(LOGWARNING,
+              "DVBridge: the display's Dolby Vision block gives a Low-Latency target that cannot be "
+              "used (peak {:.0f} cd/m2, primaries {:.4f},{:.4f} {:.4f},{:.4f} {:.4f},{:.4f}: {}): no "
+              "Low-Latency to this display",
+              mapping.peak, dv.redX, dv.redY, dv.greenX, dv.greenY, dv.blueX, dv.blueY,
+              !(mapping.peak >= DVBRIDGE_HDR10_PEAK_MIN && mapping.peak <= DVBRIDGE_HDR10_PEAK_MAX)
+                  ? "a peak that the mapping does not take"
+                  : "a primary or the white outside BT.2020 by more than the rounding of the block "
+                    "(DVBRIDGE_CUSTOM_SLACK), which the signal cannot carry");
+  return m_dvLlTargetUsable;
+}
