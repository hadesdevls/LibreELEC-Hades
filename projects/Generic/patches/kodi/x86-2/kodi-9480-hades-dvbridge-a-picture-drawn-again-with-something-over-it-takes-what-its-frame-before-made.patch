 };
 
+/* Hades: everything that a render of render() draws from (reuse_key_of()): the GL textures of the
+ * planes of the picture and of its layer, with their offsets and depth, the times of both, the size
+ * of the metadata (whose bytes are compared apart), the place and the part of the picture drawn,
+ * the target of the direct way, and every setting of the renderer that render() reads to make the
+ * composed planes, their rows, the codes of the IPT tunnel or the converted picture. Made whole with
+ * memset, so that two keys of the same values compare equal byte for byte. */
+struct reuse_key {
+    double pts, el_pts;
+    unsigned textures[8];
+    float shifts[16];
+    int planes, el_planes;
+    struct pl_bit_encoding bits, el_bits;
+    int comps[8];
+    int mapping[8][4];
+    struct dvbridge_geometry geometry;
+    unsigned margins[4]; /* the active area of the prepared metadata (render() fills it in) */
+    size_t bytes;
+    uintptr_t target;
+    int step, base_transfer, gui_level, gamut_asked;
+    bool el_known, flip, early, legacy, mmr, identity_off, all_rows, ipt_wanted, source_wanted,
+        compute, ipt_compute, serializer, tunnel, low_latency, ll_pattern, ll_curve_failed,
+        trim_failed, lut_failed, gamut_fine_failed;
+    uintptr_t lut;
+    uint64_t lut_signature;
+    struct dvbridge_hdr10_mapping ll_mapping;
+    struct dvbridge_plain_hdr10plus ll_hdr10plus;
+};
+
+/* Hades: what the last render left that a render of the same picture takes (dvbridge_render_reused()):
+ * nothing; the composed planes with their rows and the codes of the IPT tunnel (the source
+ * transport); or the converted picture (rgb) */
+enum { REUSE_NONE, REUSE_SOURCE, REUSE_CONVERTED };
+
 struct dvbridge_renderer {
     pl_gpu gpu;
     pl_renderer renderer;
@@ -262,6 +295,27 @@ struct dvbridge_renderer {
     const struct dvbridge_lut *lut;
     struct dvbridge_lut_state lut_state;
     bool lut_tried, lut_applied, lut_failed;
+    /* Hades: a render that draws the picture of the render before it again, the same way (a pause
+     * with the OSD or a menu over it, a picture shown for more than one refresh with subtitles),
+     * takes what that render made instead of making it again: the same inputs give the same bytes.
+     * reuse_kind: what the last render left (REUSE_*), drawn from reuse_key and the reuse_bytes of
+     * metadata in reuse_meta (of reuse_meta_size); reuse_luma, reuse_w, reuse_h: the luma that its
+     * transport took and its size (render_source()). rgb_drawn: the caller drew into rgb since the
+     * last render (the GUI composited over a converted picture, dvbridge_render_texture_drawn()):
+     * the converted picture is then taken from rgb_kept, a copy of it made by the first render
+     * that drew it again (rgb_kept_valid: it holds the picture of reuse_key). reused: the last
+     * render took it. reuse_off: dvbridge_render_allow_reuse() */
+    struct reuse_key reuse_key;
+    void *reuse_meta;
+    size_t reuse_meta_size;
+    int reuse_kind;
+    unsigned reuse_luma;
+    int reuse_w, reuse_h;
+    bool rgb_drawn;
+    pl_tex rgb_kept;
+    bool rgb_kept_valid;
+    bool reused, reuse_off;
+    bool reuse_ccm; /* (the converted render that left it composed as ETSI GS CCM 001 does) */
 };
 
 /* Hades: the alpha of the picture of the composed way, that Kodi draws over: its blend functions
@@ -768,7 +822,7 @@ static struct dvbridge_renderer *create_renderer(pl_gpu gpu, pl_log log, bool tr
                              PL_FMT_CAP_RENDERABLE | PL_FMT_CAP_SAMPLEABLE);
     if (fmt && transport)
         r->rgb = pl_tex_create(gpu, pl_tex_params(.w = 3840, .h = 2160, .format = fmt,
-            .sampleable = true, .renderable = true, .blit_dst = true));
+            .sampleable = true, .renderable = true, .blit_dst = true, .blit_src = true));
     if (!r->renderer || !r->context || (transport ? !r->rgb : !fmt)) {
         dvbridge_renderer_destroy(r);
         return NULL;
@@ -796,6 +850,10 @@ void dvbridge_renderer_recover(struct dvbridge_renderer *r)
     r->hdr10_ready = false;
     r->tunnel_frame = false;
