+        luma = r->reuse_luma;
+        r->pack_w = r->reuse_w;
+        r->pack_h = r->reuse_h;
+        ok = ok && luma;
+    } else if (composed_luma && chroma && scaled(geometry)) {
         ok = dvbridge_source_scale(r->source_packer, &r->source_params, composed_luma, chroma,
                                    geometry.source_width, geometry.source_height,
                                    view_of(&geometry, view), geometry.width, geometry.height,
@@ -1525,7 +1715,7 @@ static bool render_source(struct dvbridge_renderer *r, const struct pl_frame *so
                                   geometry.source_width, geometry.source_height, geometry.x,
                                   geometry.y, margins, r->all_rows);
     /* Hades: the codes of the IPT tunnel (pass 9 of dvbridge_source.c), timed with the rows */
-    if (ok && r->ipt) {
+    if (ok && r->ipt && !reuse) {
         unsigned ipt_luma = 0;
         ok = dvbridge_source_to_ipt(r->source_packer, &r->source_params, luma, r->pack_w,
                                     r->pack_h, geometry.x, geometry.y, margins, &ipt_luma);
@@ -1534,8 +1724,13 @@ static bool render_source(struct dvbridge_renderer *r, const struct pl_frame *so
             r->source_why = "the codes of the IPT tunnel could not be made";
     }
     timer_end(r, TIMER_ROWS);
-    if (ok)
+    if (ok) {
         r->pack_luma = luma;
+        r->reuse_luma = luma;
+        r->reuse_w = r->pack_w;
+        r->reuse_h = r->pack_h;
+    }
+    r->reused = ok && reuse;
     unsigned fbo = 0;
     if (ok && target) {
         /* the framebuffer of the target. Hades: the window, the default framebuffer that Kodi wraps
@@ -1568,6 +1763,7 @@ static bool render_source(struct dvbridge_renderer *r, const struct pl_frame *so
         /* it writes the whole raster, and outside the place of the picture the alpha is 2: not
          * the black that a converted picture at that place leaves */
         r->rgb_clean = false;
+        r->rgb_drawn = true;
     }
     if (!ok && !r->source_why)
         r->source_why = !*composed ? "the picture was not composed as ETSI GS CCM 001 composes it"
@@ -1642,6 +1838,11 @@ static bool render(struct dvbridge_renderer *r, const struct pl_frame *source,
     /* Hades: the picture that a composed render of the source transport made in the tiles of what
      * was drawn over it is another frame's */
     dvbridge_source_forget(r->source_packer);
+    /* Hades: what the render before left (struct reuse_key): taken where this one draws the same
+     * picture the same way, and left again only by a render that succeeds */
+    const int left = r->reuse_kind;
+    r->reuse_kind = REUSE_NONE;
+    r->reused = false;
     if (!source || !isfinite(pts) || source->num_planes < 1 || source->num_planes > 4 || source->rotation ||
         source->crop.x0 != 0 || source->crop.y0 != 0 ||
         source->crop.x1 != geometry.source_width || source->crop.y1 != geometry.source_height) {
@@ -1665,6 +1866,16 @@ static bool render(struct dvbridge_renderer *r, const struct pl_frame *source,
                 return false;
             }
     }
+    /* (Hades: only for a frame with something drawn over it, the GUI or subtitles (the caller said
+     * so: dvbridge_render_set_drawn()). A frame with nothing over it that draws the same picture
+     * again is kept on the screen by the caller, and where it is not, it is drawn whole as before:
+     * the caller measures the time of such frames as that of a picture) */
+    struct reuse_key key_store;
+    struct reuse_key *key = !r->reuse_off && r->drawn_gui &&
+                                    reuse_key_of(r, source, bytes, pts, el_pts, geometry, packed,
+                                                 flip, early, &key_store)
+                                ? &key_store
+                                : NULL;
     bool paired = source->enhancement_layer && isfinite(el_pts) && fabs(pts - el_pts) < 0.00001;
     /* Hades: HLG sent as Dolby Vision is a single layer: one with an enhancement layer is not drawn
         */
@@ -1698,11 +1909,13 @@ static bool render(struct dvbridge_renderer *r, const struct pl_frame *source,
         !gui_converts(r, packed) && source_planes(r, source)) {
         bool composed = false;
         if (render_source(r, source, metadata, bytes, pts, geometry, mapped, packed, flip, early,
-                          &composed)) {
+                          &composed, key, left)) {
             r->source = true;
             r->ready = true;
+            reuse_leave(r, REUSE_SOURCE, key, metadata, bytes);
             return true;
         }
+        r->reused = false;
         /* converted then, as without the source transport: what that composition left goes, but
          * a failure of the composer, which stays until a reset as libplacebo has it (the converted
          * picture is then composed by its reshaping) */
@@ -1857,16 +2070,45 @@ static bool render(struct dvbridge_renderer *r, const struct pl_frame *source,
      * texture by the caller (the GUI and the subtitles: dvbridge_render_texture_drawn()). It was
      * cleared for every frame, 132 MB written for each. */
     const bool whole = !geometry.x && !geometry.y && geometry.width == 3840 && geometry.height == 2160;
-    if (!packed && !whole && (!r->rgb_clean || !same_place(r->clean_place, geometry))) {
-        pl_tex_clear(r->gpu, r->rgb, (float[4]){0, 0, 0, 2});
-        r->rgb_clean = true;
-        r->clean_place[0] = geometry.x;
-        r->clean_place[1] = geometry.y;
-        r->clean_place[2] = geometry.width;
-        r->clean_place[3] = geometry.height;
+    /* Hades: the converted picture of the render before, where this one draws the same picture the
+     * same way (a pause with the OSD over it, a picture drawn again for another refresh): rgb as that
+     * render left it, where nothing was drawn into it since; else the copy of it that the first render
+     * of the same picture again kept (rgb_kept), where the caller composited the GUI into it. The
+     * same inputs, the same bytes: it is not drawn again. */
+    if (key)
+        memcpy(key->margins, margins, sizeof(key->margins));
+    const bool repeat = !packed && reuse_same(r, left, REUSE_CONVERTED, key, metadata, bytes);
+    bool rendered = false, reused = false;
+    if (repeat && !r->rgb_drawn) {
+        reused = rendered = true;
+    } else if (repeat && r->rgb_kept && r->rgb_kept_valid) {
+        dvbridge_gl_drain_errors();
+        pl_tex_blit(r->gpu, pl_tex_blit_params(.src = r->rgb_kept, .dst = r->rgb));
+        reused = rendered = glGetError() == GL_NO_ERROR;
+        /* (as the render left it: black around a picture that does not fill the raster) */
+        r->rgb_clean = reused && !whole;
+        memcpy(r->clean_place, (int[4]){geometry.x, geometry.y, geometry.width, geometry.height},
+               sizeof(r->clean_place));
+    }
+    if (reused) {
+        /* (what the hooks of that render found, which it succeeded with) */
+        mask.called = true;
+        mask.early_called = mask.early_mask;
+        mask.lut_called = mask.lut != NULL;
+        trim.called = trim.on;
