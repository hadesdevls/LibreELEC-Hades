+    r->rgb_kept_valid = false;
+    r->reused = false;
     if (r->renderer)
         pl_renderer_reset_errors(r->renderer, NULL);
 }
@@ -805,6 +863,8 @@ void dvbridge_renderer_reset(struct dvbridge_renderer *r)
     if (!r)
         return;
