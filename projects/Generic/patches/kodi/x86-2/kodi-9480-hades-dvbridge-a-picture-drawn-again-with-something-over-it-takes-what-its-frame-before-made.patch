     dvbridge_lut_state_destroy(r->gpu, &r->lut_state);
     pl_renderer_destroy(&r->renderer);
     for (int i = 0; i < PASS_TIMERS; ++i)
@@ -1421,6 +1486,112 @@ static bool identity_planes(const struct dvbridge_renderer *r, const struct pl_f
     return true;
 }
 
+/* Hades: the key of a render of render() (struct reuse_key), but its margins, which render() takes
+ * from the metadata it prepares. false where a texture of the picture is not a GL one: then nothing
+ * of the render before is taken. */
+static bool reuse_key_of(const struct dvbridge_renderer *r, const struct pl_frame *source,
+                         size_t bytes, double pts, double el_pts, struct dvbridge_geometry geometry,
+                         pl_tex packed, bool flip, bool early, struct reuse_key *k)
+{
+    memset(k, 0, sizeof(*k));
+    const struct pl_frame *frames[2] = {source, source->enhancement_layer};
+    for (int f = 0; f < 2; ++f) {
+        const struct pl_frame *fr = frames[f];
+        if (!fr)
+            continue;
+        if (f) {
+            k->el_planes = fr->num_planes;
+            k->el_bits = fr->repr.bits;
+        } else {
+            k->planes = fr->num_planes;
+            k->bits = fr->repr.bits;
+        }
+        for (int p = 0; p < fr->num_planes && p < 4; ++p) {
+            const struct pl_plane *plane = &fr->planes[p];
+            const int i = 4 * f + p;
+            k->textures[i] = pl_opengl_unwrap(r->gpu, plane->texture, NULL, NULL, NULL);
+            if (!k->textures[i])
+                return false;
+            k->shifts[2 * i] = plane->shift_x;
+            k->shifts[2 * i + 1] = plane->shift_y;
+            k->comps[i] = plane->components;
+            for (int c = 0; c < 4; ++c)
+                k->mapping[i][c] = plane->component_mapping[c];
+        }
+    }
+    k->pts = pts;
+    k->el_known = isfinite(el_pts);
+    k->el_pts = k->el_known ? el_pts : 0.0;
+    k->geometry = geometry;
+    k->bytes = bytes;
+    k->target = (uintptr_t)packed;
+    k->flip = flip;
+    k->early = early;
+    k->step = r->step;
+    k->base_transfer = r->base_transfer;
+    k->gui_level = r->gui_level;
+    k->gamut_asked = r->gamut_asked;
+    k->legacy = r->legacy_composer;
+    k->mmr = r->mmr_table;
+    k->identity_off = r->identity_off;
+    k->all_rows = r->all_rows;
+    k->ipt_wanted = r->ipt_wanted;
+    k->source_wanted = r->source_wanted;
+    k->compute = dvbridge_source_compute_rows_usable(r->source_packer);
+    k->ipt_compute = dvbridge_source_ipt_compute_usable(r->source_packer);
+    k->serializer = r->serializer != NULL;
+    k->tunnel = r->tunnel;
+    k->low_latency = r->low_latency;
+    k->ll_pattern = r->ll_pattern;
+    k->ll_curve_failed = r->ll_curve_failed;
+    k->trim_failed = r->trim_failed;
+    k->lut_failed = r->lut_failed;
+    k->gamut_fine_failed = r->gamut_fine_failed;
+    k->lut = (uintptr_t)r->lut;
+    k->lut_signature = r->lut ? r->lut->pl.signature : 0;
+    k->ll_mapping = r->ll_mapping;
+    k->ll_hdr10plus = r->ll_hdr10plus;
+    return true;
+}
+
+/* Hades: what the render before left (left, REUSE_*) is of the picture that this render draws, the
+ * same way: the same key (its margins filled in) and the same bytes of metadata */
+static bool reuse_same(const struct dvbridge_renderer *r, int left, int kind,
+                       const struct reuse_key *key, const void *metadata, size_t bytes)
+{
+    return left == kind && key && r->reuse_meta && r->reuse_meta_size == bytes && metadata &&
+           !memcmp(key, &r->reuse_key, sizeof(*key)) && !memcmp(metadata, r->reuse_meta, bytes);
+}
+
+/* Hades: this render left kind (REUSE_*) for the next one, from key and the metadata (nothing where
+ * they cannot be kept) */
+static void reuse_leave(struct dvbridge_renderer *r, int kind, const struct reuse_key *key,
+                        const void *metadata, size_t bytes)
+{
+    r->reuse_kind = REUSE_NONE;
+    if (!key || !metadata || !bytes)
+        return;
+    if (r->reuse_meta_size != bytes) {
+        void *m = realloc(r->reuse_meta, bytes);
+        if (!m)
+            return;
+        r->reuse_meta = m;
+        r->reuse_meta_size = bytes;
+    }
+    memcpy(r->reuse_meta, metadata, bytes);
+    r->reuse_key = *key;
+    r->reuse_kind = kind;
+}
+
+/* Hades: nothing of the last render is taken by the next one (another kind of render drew into what
+ * it left) */
+static void reuse_forget(struct dvbridge_renderer *r)
+{
+    r->reuse_kind = REUSE_NONE;
+    r->rgb_kept_valid = false;
+    r->reused = false;
+}
+
 /* Hades: the source transport (dvbridge_source.h). libplacebo composes the planes into ours and
  * draws nothing else (pl_render_params.dovi_ccm_only: no scaling of the chroma to 4:4:4, no
  * decoding, nothing written to the target), with the filters of the step-down level (step_down():
@@ -1432,7 +1603,8 @@ static bool identity_planes(const struct dvbridge_renderer *r, const struct pl_f
 static bool render_source(struct dvbridge_renderer *r, const struct pl_frame *source,
                           const void *metadata, size_t bytes, double pts,
                           struct dvbridge_geometry geometry, struct dvbridge_color mapped,
-                          pl_tex target, bool flip, bool active_rows, bool *composed)
+                          pl_tex target, bool flip, bool active_rows, bool *composed,
+                          struct reuse_key *key, int left)
 {
     *composed = false;
     const char *why = NULL;
@@ -1482,8 +1654,20 @@ static bool render_source(struct dvbridge_renderer *r, const struct pl_frame *so
     }
     /* Hades: the decoder's planes where they are the composer's (identity_planes()) */
     r->identity_taken = identity_planes(r, source, metadata, bytes, geometry);
+    /* Hades: the picture that the render before composed, the same way (a pause with the OSD over
+     * it, a picture drawn again for another refresh): its composed planes, their rows of 4:2:2 and
+     * the codes of the IPT tunnel are as it left them (the GUI is composited into rgb, which pass 3
+     * makes again below), so they are not made again: the same inputs, the same bytes */
+    if (key)
+        memcpy(key->margins, margins, sizeof(key->margins));
+    const bool reuse = reuse_same(r, left, REUSE_SOURCE, key, metadata, bytes);
     bool ok;
-    if (r->identity_taken) {
