         pl_renderer_flush_cache(r->renderer);
     dvbridge_reset(r->context);
@@ -829,8 +889,11 @@ void dvbridge_render_set_display_management(struct dvbridge_renderer *r, unsigne
 
 void dvbridge_render_texture_drawn(struct dvbridge_renderer *r)
 {
-    if (r)
+    if (r) {
