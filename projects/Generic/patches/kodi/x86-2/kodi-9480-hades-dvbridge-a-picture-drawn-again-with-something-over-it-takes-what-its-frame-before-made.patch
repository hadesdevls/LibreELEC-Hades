@@ -895,6 +958,8 @@ void dvbridge_renderer_destroy(struct dvbridge_renderer *r)
     pl_tex_destroy(r->gpu, &r->hdr10[0]);
     pl_tex_destroy(r->gpu, &r->hdr10[1]);
     pl_tex_destroy(r->gpu, &r->rgb);
+    pl_tex_destroy(r->gpu, &r->rgb_kept);
