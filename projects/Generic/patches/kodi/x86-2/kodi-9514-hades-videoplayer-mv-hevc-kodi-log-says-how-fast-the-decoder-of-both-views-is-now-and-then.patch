From d0f69e3e9ebce8d73d2c0cabcfb64c71625990be Mon Sep 17 00:00:00 2001
From: Hades <15710513+hadesdevls@users.noreply.github.com>
Date: Thu, 26 Nov 2026 21:12:22 +0000
Subject: [PATCH] [Hades][VideoPlayer] MV-HEVC: kodi.log says how fast the
 decoder of both views is, now and then

The work of the decoder of both views (KODI::MULTIVIEW::Worked(): pictures
of two views a second of its own work, over windows of 48 pictures) was said
only when the processor was taken not to keep up. It is now said for the
first three windows after a start or a seek and every 30th after that, so
that a log tells how much room there is, with the processor alone or with the
graphics card decoding the base view.
---
 .../DVDCodecs/Video/MultiviewPacker.cpp            | 14 +++++++++++++-
 .../VideoPlayer/DVDCodecs/Video/MultiviewPacker.h  |  3 +++
 2 files changed, 16 insertions(+), 1 deletion(-)

diff --git a/xbmc/cores/VideoPlayer/DVDCodecs/Video/MultiviewPacker.cpp b/xbmc/cores/VideoPlayer/DVDCodecs/Video/MultiviewPacker.cpp
index 9a4956b..147355d 100644
--- a/xbmc/cores/VideoPlayer/DVDCodecs/Video/MultiviewPacker.cpp
+++ b/xbmc/cores/VideoPlayer/DVDCodecs/Video/MultiviewPacker.cpp
@@ -516,13 +516,25 @@ void CMultiviewPacker::Reset()
   // (the pace is judged anew after a seek, from its grace on)
   m_pace = {};
   m_work = {};
+  m_workWindows = 0;
 }
 
 void CMultiviewPacker::Paced(bool late, bool judged, double busyMs, double fps)
 {
   if (m_slow)
     return;
-  if (KODI::MULTIVIEW::Worked(m_work, busyMs, fps, judged))
+  const unsigned int inWindow = m_work.inWindow;
+  const bool slow = KODI::MULTIVIEW::Worked(m_work, busyMs, fps, judged);
+  // Hades: how fast the decoder of both views is, said now and then (where its base view comes
+  // from the graphics card too: KODI::MULTIVIEW::HybridBase)
+  if (inWindow + 1 == KODI::MULTIVIEW::WORK_WINDOW && m_work.inWindow == 0 &&
+      (++m_workWindows <= 3 || m_workWindows % 30 == 0))
+    CLog::Log(LOGINFO,
+              "CMultiviewPacker: the decoder of both views gives {:.1f} pictures of two views a "
+              "second of its work (window {} of {} pictures since the start or a seek); the "
+              "video has {:.3f}",
+              m_work.rate, m_workWindows, KODI::MULTIVIEW::WORK_WINDOW, fps);
+  if (slow)
   {
     m_slow = true;
     char text[320];
diff --git a/xbmc/cores/VideoPlayer/DVDCodecs/Video/MultiviewPacker.h b/xbmc/cores/VideoPlayer/DVDCodecs/Video/MultiviewPacker.h
index 9a6605a..33449f6 100644
--- a/xbmc/cores/VideoPlayer/DVDCodecs/Video/MultiviewPacker.h
+++ b/xbmc/cores/VideoPlayer/DVDCodecs/Video/MultiviewPacker.h
@@ -140,6 +140,9 @@ private:
   bool m_sizeTold{false}; //!< what the eyes are was said in the log
   KODI::MULTIVIEW::Pace m_pace;
   KODI::MULTIVIEW::Work m_work;
+  //! (Hades) the windows of the work of the decoder measured since the start or a seek (its rate
+  //! is said in the log for the first three and every 30th)
+  unsigned int m_workWindows{0};
   //! (Hades) why the processor was taken not to keep up, where it was by the work of the decoder
   std::string m_slowText;
   bool m_slow{false};
-- 
2.53.0

