From c66d0269baf4c9ca7762e267d8a11cba2531d54f Mon Sep 17 00:00:00 2001
From: SamuriHL <samurihl@msn.com>
Date: Mon, 7 Sep 2026 00:07:27 +0000
Subject: [PATCH] CThread: a thread that ends by an exception is an error in
 the log

A thread that left Action() by an exception was said at LOGDEBUG: in a
normal kodi.log, nothing at all; in a debug one, one line among
hundreds of thousands. Nothing starts such a thread again, and whatever
waits for it waits on: a player thread that died left playback frozen
with no other trace. It is an error now, with the name of the thread,
which is kept outside the try because an auto-deleting thread frees
itself inside it.

From SamuriHL's change (SamuriHL/coreelec-xbmc commit 32a1fb009b,
"CThread: report a thread that dies on an exception as an error").
---
 xbmc/threads/Thread.cpp | 11 +++++++++--
 1 file changed, 9 insertions(+), 2 deletions(-)

diff --git a/xbmc/threads/Thread.cpp b/xbmc/threads/Thread.cpp
index b1872e9..cd1e03a 100644
--- a/xbmc/threads/Thread.cpp
+++ b/xbmc/threads/Thread.cpp
@@ -118,6 +118,9 @@ void CThread::Create(bool bAutoDelete)
     ++m_threadGeneration;
     m_thread = new std::thread([](CThread* pThread, std::promise<bool> promise)
     {
+      // Hades: the name of the thread, for its end by an exception (the handlers below): kept
+      // here, as an auto-deleting thread frees pThread inside the try
+      std::string threadName;
       try
       {
 
@@ -143,6 +146,7 @@ void CThread::Create(bool bAutoDelete)
 
         pThread->m_impl = IThreadImpl::CreateThreadImpl(pThread->m_thread->native_handle());
         pThread->m_impl->SetThreadInfo(pThread->m_ThreadName);
+        threadName = pThread->m_ThreadName;
 
         CLog::Log(LOGDEBUG, "Thread {} start, auto delete: {}", pThread->m_ThreadName,
                   (pThread->m_bAutoDelete ? "true" : "false"));
@@ -162,13 +166,16 @@ void CThread::Create(bool bAutoDelete)
           CLog::Log(LOGDEBUG, "Thread {} {} terminating", pThread->m_ThreadName,
                     std::this_thread::get_id());
       }
+      // Hades: an error, said in a log at its normal level: nothing starts such a thread again,
+      // and whatever waits for it waits on (a player thread that died left playback frozen and
+      // one line in a debug log)
       catch (const std::exception& e)
       {
-        CLog::Log(LOGDEBUG, "Thread Terminating with Exception: {}", e.what());
+        CLog::Log(LOGERROR, "Thread {} ended by an exception: {}", threadName, e.what());
       }
       catch (...)
       {
-        CLog::Log(LOGDEBUG,"Thread Terminating with Exception");
+        CLog::Log(LOGERROR, "Thread {} ended by an unknown exception", threadName);
       }
 
       promise.set_value(true);
-- 
