@@ -0,0 +1,64 @@
+/*
+ *  Copyright (C) 2026 Hades
+ *  This file is part of LibreELEC Hades. It is not in Kodi as Team Kodi publishes it.
+ *
+ *  SPDX-License-Identifier: GPL-2.0-or-later
+ *  See LICENSES/README.md for more information.
+ */
+
+#include "cores/VideoPlayer/StereoEyeSize.h"
+
+#include <gtest/gtest.h>
+
+using KODI::STEREO_EYE::FullFrameEye;
+
+namespace
+{
+struct Size
+{
+  unsigned int w;
+  unsigned int h;
+  bool operator==(const Size&) const = default;
+};
+
+Size Eye(const char* mode, Size s)
+{
+  FullFrameEye(mode, s.w, s.h);
+  return s;
+}
+} // namespace
+
+//! A full frame given the size of the whole frame: one eye
+TEST(TestStereoEyeSize, AFullFrameGivenAsAWholeIsHalved)
+{
+  EXPECT_EQ((Size{1920, 1080}), Eye("left_right", {3840, 1080}));
+  EXPECT_EQ((Size{1920, 1080}), Eye("right_left", {3840, 1080}));
+  EXPECT_EQ((Size{1920, 803}), Eye("left_right", {3840, 803})); // 2.39:1
+  EXPECT_EQ((Size{1920, 1080}), Eye("top_bottom", {1920, 2160}));
+  EXPECT_EQ((Size{1920, 1080}), Eye("bottom_top", {1920, 2160}));
+  EXPECT_EQ((Size{1440, 1080}), Eye("top_bottom", {1440, 2160})); // 4:3
+}
+
+//! The size of one eye already (a half frame shown at the aspect of the film, a container that
+//! gives it, the views Hades packs itself): unchanged, at every aspect of the 3D films released
+TEST(TestStereoEyeSize, TheSizeOfOneEyeStays)
+{
+  for (const char* mode : {"left_right", "right_left", "top_bottom", "bottom_top"})
+  {
+    EXPECT_EQ((Size{1920, 1080}), Eye(mode, {1920, 1080})) << mode; // 1.78:1
+    EXPECT_EQ((Size{1920, 803}), Eye(mode, {1920, 803})) << mode; // 2.39:1
+    EXPECT_EQ((Size{1920, 1038}), Eye(mode, {1920, 1038})) << mode; // 1.85:1
+    EXPECT_EQ((Size{1544, 1080}), Eye(mode, {1544, 1080})) << mode; // 1.43:1, IMAX
+  }
+}
+
+//! Not a 3D picture, or no size: unchanged
+TEST(TestStereoEyeSize, OtherPicturesStay)
+{
+  EXPECT_EQ((Size{3840, 1080}), Eye("", {3840, 1080}));
+  EXPECT_EQ((Size{3840, 1080}), Eye("mono", {3840, 1080}));
+  EXPECT_EQ((Size{1920, 2160}), Eye("left_right", {1920, 2160}));
+  EXPECT_EQ((Size{3840, 1080}), Eye("top_bottom", {3840, 1080}));
+  EXPECT_EQ((Size{0, 1080}), Eye("left_right", {0, 1080}));
+  EXPECT_EQ((Size{3840, 0}), Eye("left_right", {3840, 0}));
+}
