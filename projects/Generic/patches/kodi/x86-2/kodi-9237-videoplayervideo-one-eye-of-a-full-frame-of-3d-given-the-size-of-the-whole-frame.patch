+#pragma once
+
+#include <string_view>
+
+namespace KODI::STEREO_EYE
+{
+//! The widest and the narrowest picture of one eye of the 3D films released, at any resolution:
+//! 2.39:1 and 1.43:1 (IMAX) are within these, with room
+inline constexpr double MAX_SIDE_BY_SIDE_EYE = 2.6;
+inline constexpr double MIN_TOP_AND_BOTTOM_EYE = 1.3;
+
+inline bool SideBySide(std::string_view mode)
+{
+  return mode == "left_right" || mode == "right_left";
+}
+
+inline bool TopAndBottom(std::string_view mode)
+{
+  return mode == "top_bottom" || mode == "bottom_top";
+}
+
+/*!
+ * \brief The display size of a picture of two views is the size of one eye: the renderer takes its
+ *        aspect for the eye's (CBaseRenderer::ManageRenderArea()). That holds for a half frame of
+ *        side by side or top and bottom, for a container that gives the size of one eye, and for
+ *        the views that Hades puts side by side itself (a sample aspect halved, MultiviewChoice.h).
+ *        A full frame given the size of the whole frame made each eye twice as wide (side by side)
+ *        or half as wide (top and bottom) as it is. An eye wider or narrower than any 3D film is
+ *        such a frame: its size is halved, in the direction of the two views.
+ * \return true where the size was changed
+ */
+inline bool FullFrameEye(std::string_view stereoMode,
+                         unsigned int& displayWidth,
+                         unsigned int& displayHeight)
+{
+  if (displayWidth == 0 || displayHeight == 0)
+    return false;
+  const double eye = static_cast<double>(displayWidth) / displayHeight;
+  if (SideBySide(stereoMode) && eye > MAX_SIDE_BY_SIDE_EYE)
+  {
+    displayWidth /= 2;
+    return true;
+  }
+  if (TopAndBottom(stereoMode) && eye < MIN_TOP_AND_BOTTOM_EYE)
+  {
+    displayHeight /= 2;
+    return true;
+  }
+  return false;
+}
+} // namespace KODI::STEREO_EYE
