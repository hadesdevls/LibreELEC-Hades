From 7742925d711646f77aaf463dc16531095d5723bf Mon Sep 17 00:00:00 2001
From: matthane <matthan.evans@icloud.com>
Date: Wed, 11 Nov 2026 18:39:54 +0000
Subject: [PATCH] VideoPlayer: only audio and video move the start of a seek
 back

CheckPlayerInit() moves the start of every stream back to the first
packet of a stream when that packet is more than 20 s before the target
of a seek: decoding 20 s to reach the start would take too long. A
subtitle file seeks to its last set before the target, which is often
that far back, and the seek then started early, at a subtitle. Embedded
subtitles, teletext, RDS and ID3 could move it the same way. Their
players keep the packets before the start and decode nothing to reach
it, so the rule is for audio and video alone now.

From matthane's change for CoreELEC (CoreELEC/xbmc commit ea33584d44,
"VideoPlayer: let only audio and video move the start of a seek").
---
 xbmc/cores/VideoPlayer/VideoPlayer.cpp | 7 ++++++-
 1 file changed, 6 insertions(+), 1 deletion(-)

diff --git a/xbmc/cores/VideoPlayer/VideoPlayer.cpp b/xbmc/cores/VideoPlayer/VideoPlayer.cpp
index d521aca..d24c1d2 100644
--- a/xbmc/cores/VideoPlayer/VideoPlayer.cpp
+++ b/xbmc/cores/VideoPlayer/VideoPlayer.cpp
@@ -3388,7 +3388,12 @@ bool CVideoPlayer::CheckPlayerInit(CCurrentStream& current)
       return true;
     }
 
-    if ((current.startpts - current.dts) > DVD_SEC_TO_TIME(20))
+    // Hades: only audio and video, which decode from their first packet on to reach the start;
+    // the other players keep their early packets, so nothing has to be decoded for them. A
+    // subtitle file seeks to its last set before the target, often more than 20 s back, and moved
+    // the start of every stream back to it (as could embedded subtitles, teletext, RDS and ID3)
+    if ((current.type == StreamType::AUDIO || current.type == StreamType::VIDEO) &&
+        (current.startpts - current.dts) > DVD_SEC_TO_TIME(20))
     {
       CLog::Log(LOGDEBUG, "{} - too far to decode before finishing seek", __FUNCTION__);
       if(m_CurrentAudio.startpts != DVD_NOPTS_VALUE)
