From 1b8c74255c0473dd7cdfa22f4f8ed3a457e74c8f Mon Sep 17 00:00:00 2001
From: Chris <meischris39@hotmail.com>
Date: Tue, 10 Nov 2026 20:42:39 +0000
Subject: [PATCH] [RetroPlayer] Don't open the game OSD when the mouse moves

The game OSD pauses play, so opening it on mouse movement paused the
game whenever the mouse was nudged, and closing the OSD with a right
click reopened it straight away. A left click still opens it.

(cherry picked from commit bb32fd04b4465cbeb2afa0635d8b60098bf79235)
---
 .../RetroPlayer/guiwindows/GameWindowFullScreen.cpp    | 10 +---------
 1 file changed, 1 insertion(+), 9 deletions(-)

diff --git a/xbmc/cores/RetroPlayer/guiwindows/GameWindowFullScreen.cpp b/xbmc/cores/RetroPlayer/guiwindows/GameWindowFullScreen.cpp
index 67ac0dc..1f0dc9e 100644
--- a/xbmc/cores/RetroPlayer/guiwindows/GameWindowFullScreen.cpp
+++ b/xbmc/cores/RetroPlayer/guiwindows/GameWindowFullScreen.cpp
@@ -92,15 +92,7 @@ bool CGameWindowFullScreen::OnAction(const CAction& action)
       TriggerOSD();
       return true;
     }
-    case ACTION_MOUSE_MOVE:
-    {
-      if (action.GetAmount(2) || action.GetAmount(3))
-      {
-        TriggerOSD();
-        return true;
-      }
-      break;
-    }
+    // A click, not a move: the OSD pauses the game, and a mouse gets nudged
     case ACTION_MOUSE_LEFT_CLICK:
     {
       TriggerOSD();
-- 
2.53.0

