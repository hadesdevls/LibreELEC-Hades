+void CVideoPlayerAudio::PublishStreamInfo(const DVDAudioFrame& audioframe)
+{
+  m_streaminfo.channels = audioframe.format.m_channelLayout.Count();
+  // Hades: passed through, the sink's layout is that of the IEC 61937 carrier ("RAW"): the
+  // player information's "Layout" gives the stream's own, as its demuxer says it
+  if (audioframe.format.m_dataFormat == AE_FMT_RAW && m_streaminfo.channellayout)
+    m_processInfo.SetAudioChannels(CAEUtil::GetAEChannelLayout(m_streaminfo.channellayout));
+  else
+    m_processInfo.SetAudioChannels(audioframe.format.m_channelLayout);
+  m_processInfo.SetAudioSampleRate(audioframe.format.m_sampleRate);
+  m_processInfo.SetAudioBitsPerSample(audioframe.bits_per_sample);
+  m_processInfo.SetAudioDecoderName(m_pAudioCodec->GetName());
+  m_streamInfoSaid = true;
+  m_messageParent.Put(std::make_shared<CDVDMsg>(CDVDMsg::PLAYER_AVCHANGE));
+}
+
+void CVideoPlayerAudio::KeepStreamInfo()
+{
+  if (!KODI::UTILS::PLAYERINFO::StreamInfoCleared(
+          m_streamInfoSaid, CServiceBroker::GetDataCacheCore().GetAudioChannels()))
+    return;
+  // The engine changed its own format and cleared what this player had told of the stream: its
+  // layout, rate, bits and decoder, and its presentation (the bed of Dolby Atmos). Without them
+  // the player information said that the speakers were not known, for the rest of the video.
+  // This player's own copies (CProcessInfo, m_presentation) are told again.
+  const std::string channels = m_processInfo.GetAudioChannels();
+  m_processInfo.SetAudioChannels(channels);
+  m_processInfo.SetAudioSampleRate(m_processInfo.GetAudioSampleRate());
+  m_processInfo.SetAudioBitsPerSample(m_processInfo.GetAudioBitsPerSample());
+  m_processInfo.SetAudioDecoderName(m_processInfo.GetAudioDecoderName());
+  PublishPresentation(m_presentation.Get());
+  if (!m_streamInfoSaidAgain)
+  {
+    m_streamInfoSaidAgain = true;
+    CLog::Log(LOGINFO,
+              "CVideoPlayerAudio: the audio engine changed its format and cleared what the player "
+              "information said of the stream ({}): told again",
+              channels);
+  }
+}
