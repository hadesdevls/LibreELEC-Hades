 }
 
+/*!
+ * \brief The usual layout of a number of channels, in the names of Kodi's audio engine: the
+ *        standard layout that CAEUtil::GuessChLayout() gives it (AE_CH_LAYOUT_1_0 to
+ *        AE_CH_LAYOUT_7_1), without the warning that it writes to the log; empty for any other
+ *        number. It is a guess: six channels may as well have their surrounds at the sides
+ */
+inline std::string UsualLayout(int channels)
+{
+  switch (channels)
+  {
+    case 1:
+      return "FC";
+    case 2:
+      return "FL,FR";
+    case 3:
+      return "FL,FR,FC";
+    case 4:
+      return "FL,FR,BL,BR";
+    case 5:
+      return "FL,FR,FC,BL,BR";
+    case 6:
+      return "FL,FR,FC,LFE,BL,BR";
+    case 7:
+      return "FL,FR,FC,BL,BR,SL,SR";
+    case 8:
+      return "FL,FR,FC,LFE,BL,BR,SL,SR";
+    default:
+      return "";
+  }
+}
+
+//! What the plane of the speakers shows
+struct SpeakersShown
+{
+  std::string lit; //!< as Speakers() gives it; empty where nothing is known
+  //! it is the usual layout of the stream's number of channels (UsualLayout()), not what the
+  //! player said: the page says so
+  bool fromCount = false;
+};
+
+/*!
+ * \brief The speakers of the plane: what the player said of the stream (Speakers()); where that
+ *        names none (nothing said yet, or "unknown", or what was said was cleared), the usual
+ *        layout of the number of channels that its demuxer gives the stream, said as such
+ * \param streamChannels the stream's number of channels (AudioStreamInfo::channels; 0 where it is
+ *        not known)
+ */
+inline SpeakersShown SpeakersOrUsual(const std::string& channels,
+                                     const std::string& bed,
+                                     int streamChannels)
+{
+  SpeakersShown shown;
+  shown.lit = Speakers(channels, bed);
+  if (shown.lit.empty())
+  {
+    shown.lit = Speakers(UsualLayout(streamChannels), "");
+    shown.fromCount = !shown.lit.empty();
+  }
+  return shown;
+}
+
+/*!
+ * \brief Whether what the player told of its stream for the player information has been cleared
+ *        since: the audio engine clears it whenever its own format changes
+ *        (CDataCacheCore::ResetAudioCache(), from ActiveAE::Configure()), and the player then
+ *        tells it again (CVideoPlayerAudio::KeepStreamInfo())
+ * \param told the player has told it for this stream
+ * \param channelsNow the layout that the data cache has now (CDataCacheCore::GetAudioChannels())
+ */
+inline bool StreamInfoCleared(bool told, const std::string& channelsNow)
+{
+  return told && channelsNow.empty();
+}
