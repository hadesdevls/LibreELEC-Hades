From 6a3c560a089937e58120d21b5b97b077408f1d9c Mon Sep 17 00:00:00 2001
From: Hades <15710513+hadesdevls@users.noreply.github.com>
Date: Thu, 19 Nov 2026 00:29:36 +0000
Subject: [PATCH] comments: name what a thing is, not a service, an add-on, a
 site or a film

Comments of Hades named the services and the site whose streams showed a
fault, and the films that a measurement was made on. They now say what
these are: a streaming add-on and its resolver, a CDN, an HLG stream of an
add-on, an open test film, three Ultra HD discs. The numbers and what was
measured stay as they were. Only comments change: the code that the
compiler reads, and the XML without its comments, are the same before and
after.
---
 addons/skin.estuary/xml/Variables.xml                       | 2 +-
 tools/dvbridge/dvbridge_dvplus.c                            | 6 +++---
 tools/dvbridge/dvbridge_dvplus.h                            | 2 +-
 tools/dvbridge/dvbridge_dvplus_gl.h                         | 2 +-
 tools/dvbridge/dvbridge_measured.h                          | 6 +++---
 tools/dvbridge/dvbridge_trims.h                             | 4 ++--
 xbmc/Util.cpp                                               | 2 +-
 xbmc/application/ApplicationPlay.cpp                        | 6 +++---
 .../cores/VideoPlayer/DVDInputStreams/BlurayGraphicsRange.h | 2 +-
 xbmc/cores/VideoPlayer/SubtitleSeekMemory.h                 | 2 +-
 xbmc/filesystem/CurlFile.cpp                                | 2 +-
 xbmc/filesystem/HttpSourceMemory.h                          | 2 +-
 xbmc/utils/HadesPlayerInfo.h                                | 2 +-
 13 files changed, 20 insertions(+), 20 deletions(-)

diff --git a/addons/skin.estuary/xml/Variables.xml b/addons/skin.estuary/xml/Variables.xml
index 56527ac..98242b2 100644
--- a/addons/skin.estuary/xml/Variables.xml
+++ b/addons/skin.estuary/xml/Variables.xml
@@ -883,7 +883,7 @@
 	<!-- (Hades: an HDR10 stream whose frames carry HDR10+ metadata, hades.video.hdr10plus, is HDR10+:
 	     VideoPlayer.HdrType is the stream's, as the demuxer says it) -->
 	<!-- (Hades: a stream that says nothing of HDR, whose decoded picture is HLG or PQ, as an add-on's
-	     stream of YouTube in HLG may be: hades.src.hdrtype, from its picture) -->
+	     HLG stream may be: hades.src.hdrtype, from its picture) -->
 	<variable name="HadesSourceFormatVar">
 		<value condition="String.IsEqual(VideoPlayer.HdrType,hdr10) + String.IsEqual(Window(Home).Property(hades.video.hdr10plus),yes)">HDR10+</value>
 		<value condition="!String.IsEmpty(VideoPlayer.HdrType)">$MAP[DefaultHdrMap, VideoPlayer.HdrType]</value>
