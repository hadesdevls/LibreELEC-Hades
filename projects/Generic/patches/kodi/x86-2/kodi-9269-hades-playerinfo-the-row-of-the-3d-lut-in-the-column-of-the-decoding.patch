From 9ce9282aae96c3e9eddb3636c2eccc98f3ce2f07 Mon Sep 17 00:00:00 2001
From: Hades <15710513+hadesdevls@users.noreply.github.com>
Date: Wed, 25 Nov 2026 02:59:29 +0000
Subject: [PATCH] [Hades][PlayerInfo] The row of the 3D LUT in the column of
 the decoding

The column of the video output of the Video page has both the row of
the content type of the AVI InfoFrame and the row of the 3D LUT now. Where
both and the button of the upscaler are shown, the column took 524 px of
its 564 and reached y 792 of the panel, under the top of that button
(y 776), so its last row lay under the button (skin_check). The row of
the 3D LUT, which says the processing of the picture and not what goes
out, moves under the rows of the decoding (pixel format, decoder,
deinterlacing) in the third column, which then reaches y 763 at most.
The row, its values and when it is shown do not change.
---
 .../xml/DialogPlayerProcessInfo.xml           | 29 +++---
 system/hades/DialogHadesPlayerInfo.xml        | 96 +++++++++----------
 2 files changed, 63 insertions(+), 62 deletions(-)

diff --git a/addons/skin.estuary/xml/DialogPlayerProcessInfo.xml b/addons/skin.estuary/xml/DialogPlayerProcessInfo.xml
index 792ac17..b3d3602 100644
--- a/addons/skin.estuary/xml/DialogPlayerProcessInfo.xml
+++ b/addons/skin.estuary/xml/DialogPlayerProcessInfo.xml
@@ -1287,20 +1287,6 @@
 						<param name="ruletop" value="-2"/>
 						<param name="valuemax" value="96"/>
 					</include>
-					<!-- Hades: the 3D LUT of the display (videoscreen.hadeslut3d), where one is chosen for what this video goes out as: the name of its file where it is applied, or why it is not (DisplayLut.h, read by the window system; the file in kodi.log) -->
-					<include content="HadesPanelRowWide">
-						<param name="name" value="$ADDON[skin.estuary 54813]"/>
-						<param name="value" value="$INFO[Window(Home).Property(hades.video.lut)]"/>
-						<param name="visible" value="!String.IsEmpty(Window(Home).Property(hades.video.lut))"/>
-						<param name="font" value="font10"/>
-						<param name="width" value="530"/>
-						<param name="namewidth" value="90"/>
-						<param name="valuewidth" value="440"/>
-						<param name="rowheight" value="32"/>
-						<param name="valuetop" value="-1"/>
-						<param name="ruletop" value="-2"/>
-						<param name="valuemax" value="32"/>
-					</include>
 				</control>
 				<control type="grouplist">
 					<left>1186</left>
@@ -1337,6 +1323,21 @@
 						<param name="width" value="530"/>
 						<param name="height" value="32"/>
 					</include>
+					<!-- Hades: in the column of the decoding, the processing of the picture (here and not under the video output, whose
+					     column with the content type would reach the button of the upscaler: skin_check): the 3D LUT of the display (videoscreen.hadeslut3d), where one is chosen for what this video goes out as: the name of its file where it is applied, or why it is not (DisplayLut.h, read by the window system; the file in kodi.log) -->
+					<include content="HadesPanelRowWide">
+						<param name="name" value="$ADDON[skin.estuary 54813]"/>
+						<param name="value" value="$INFO[Window(Home).Property(hades.video.lut)]"/>
+						<param name="visible" value="!String.IsEmpty(Window(Home).Property(hades.video.lut))"/>
+						<param name="font" value="font10"/>
+						<param name="width" value="530"/>
+						<param name="namewidth" value="90"/>
+						<param name="valuewidth" value="440"/>
+						<param name="rowheight" value="32"/>
+						<param name="valuetop" value="-1"/>
+						<param name="ruletop" value="-2"/>
+						<param name="valuemax" value="32"/>
+					</include>
 					<control type="group">
 						<width>530</width>
 						<height>16</height>
