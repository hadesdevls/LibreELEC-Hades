-								<width>90</width>
-								<height>32</height>
-								<aligny>center</aligny>
-								<font>font10</font>
-								<textcolor>FF8C93A1</textcolor>
-								<label>$ADDON[skin.estuary 54813]</label>
-								<align>left</align>
-								<disabledcolor>40FFFFFF</disabledcolor>
-								<selectedcolor>FFFFB70F</selectedcolor>
