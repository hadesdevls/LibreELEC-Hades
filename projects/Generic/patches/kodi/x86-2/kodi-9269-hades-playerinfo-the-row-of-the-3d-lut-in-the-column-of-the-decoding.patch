-								<scrollspeed>40</scrollspeed>
-							</control>
-						</control>
-						<control type="textbox">
-							<left>90</left>
-							<top>-1</top>
-							<width>440</width>
-							<height min="1" max="32">auto</height>
-							<align>right</align>
-							<font>font10</font>
-							<textcolor>FFEEF1F6</textcolor>
-							<label>$INFO[Window(Home).Property(hades.video.lut)]</label>
-						</control>
-						<control type="image">
-							<left>0</left>
-							<top>-2</top>
-							<width>530</width>
-							<height>1</height>
-							<texture colordiffuse="FF1E2128">special://xbmc/system/hades/colors-white.png</texture>
-							<aspectratio>stretch</aspectratio>
-						</control>
-						<align>left</align>
-					</control>
 					<align>left</align>
 				</control>
 				<control type="grouplist">
@@ -4133,6 +4085,54 @@
 							<aspectratio>stretch</aspectratio>
 						</control>
 					</control>
+					<control type="grouplist">
+						<width>530</width>
+						<height min="32" max="400">auto</height>
+						<orientation>vertical</orientation>
+						<itemgap>0</itemgap>
+						<usecontrolcoords>true</usecontrolcoords>
+						<visible>!String.IsEmpty(Window(Home).Property(hades.video.lut))</visible>
+						<control type="group">
+							<left>0</left>
+							<top>0</top>
+							<width>90</width>
+							<height>0</height>
+							<control type="label">
