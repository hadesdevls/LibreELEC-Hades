diff --git a/xbmc/cores/VideoPlayer/DVDCodecs/Video/DVOutputMemory.h b/xbmc/cores/VideoPlayer/DVDCodecs/Video/DVOutputMemory.h
index b6e3401..e91e209 100644
--- a/xbmc/cores/VideoPlayer/DVDCodecs/Video/DVOutputMemory.h
+++ b/xbmc/cores/VideoPlayer/DVDCodecs/Video/DVOutputMemory.h
@@ -26,8 +26,9 @@ public:
   //! (Hades: 5, OutputChoice::HDR10PLUS, for a video with both Dolby Vision and HDR10+; from 1.0
   //! RC7, 7, OutputChoice::REBUILT_HDR10PLUS. A text written by 1.0 RC6 reads as it was written,
   //! its 1 (HDR10) as well: what that does is told in OutputChoice. Read by 1.0 RC6, a line of 6 or
