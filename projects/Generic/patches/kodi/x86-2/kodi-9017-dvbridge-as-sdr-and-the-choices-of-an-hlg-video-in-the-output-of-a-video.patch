@@ -72,6 +72,7 @@ void VideoPicture::Reset()
   doviBaseRefused = false;
   doviConvertSdr = false;
   doviNoNative = false;
+  hdrAsSdrChosen = false;
   doviEnhancement.reset();
   doviLayerNotDecoded = false;
   doviRpuRepeated = false;
diff --git a/xbmc/cores/VideoPlayer/DVDCodecs/Video/DVDVideoCodec.h b/xbmc/cores/VideoPlayer/DVDCodecs/Video/DVDVideoCodec.h
index 0631275..ccdad71 100644
--- a/xbmc/cores/VideoPlayer/DVDCodecs/Video/DVDVideoCodec.h
+++ b/xbmc/cores/VideoPlayer/DVDCodecs/Video/DVDVideoCodec.h
@@ -134,6 +134,12 @@ public:
   //! decoder when it opens, so that the pictures decoded before a change keep the output they had
   //! until the first one after it comes
   bool doviNoNative = false;
+  //! Hades: the picture is of a stream for which the user chose to send the video as SDR
+  //! (DVBRIDGE::OutputChoice::SDR): an HDR picture of it goes out without HDR signalling, mapped
+  //! to SDR. Set by the decoder when it opens, as doviNoNative, so that the pictures decoded before
+  //! a change keep the output they had until the first one after it comes. Of any HDR picture, not
+  //! only of Dolby Vision
+  bool hdrAsSdrChosen = false;
   std::shared_ptr<AVFrame> doviEnhancement;
   //! Hades: the picture has an enhancement picture that was not decoded, because the RPUs of the
   //! stream say that the layer carries no residual (MEL): it is drawn as a picture whose
diff --git a/xbmc/cores/VideoPlayer/DVDCodecs/Video/DVDVideoCodecFFmpeg.cpp b/xbmc/cores/VideoPlayer/DVDCodecs/Video/DVDVideoCodecFFmpeg.cpp
index 1cf596c..c3190ac 100644
--- a/xbmc/cores/VideoPlayer/DVDCodecs/Video/DVDVideoCodecFFmpeg.cpp
+++ b/xbmc/cores/VideoPlayer/DVDCodecs/Video/DVDVideoCodecFFmpeg.cpp
@@ -419,6 +419,9 @@ bool CDVDVideoCodecFFmpeg::Open(CDVDStreamInfo &hints, CDVDCodecOptions &options
   // Hades: ... or the stream is sent as the HDR10+ it also is (CDVDStreamInfo::doviHdr10PlusWins,
   // videoscreen.hadesdualhdr): its pictures go to the ordinary output, with their own HDR10+ metadata
   m_dvNoNative = m_dvNoNative || hints.doviHdr10PlusWins;
+  // Hades: and the pictures of any stream, HDR or not, say whether the user chose to send this video
+  // as SDR (OutputChoice::SDR; what an SDR picture does with it is nothing)
+  m_hdrAsSdrChosen = DVBRIDGE::GetOutputChoice() == DVBRIDGE::OutputChoice::SDR;
   // Hades: a stream made Dolby Vision from its HDR10+ metadata (CDVDStreamInfo::doviFromHdr10Plus) is
   // that for native output only: elsewhere it plays as the HDR10+ stream it is, never rebuilt as HDR10
   // (it is HDR10)
@@ -481,6 +484,9 @@ bool CDVDVideoCodecFFmpeg::Open(CDVDStreamInfo &hints, CDVDCodecOptions &options
                     "own HDR10+ metadata, its Dolby Vision left aside (videoscreen.hadesdualhdr, or the "
                     "output chosen for this video)"
               : m_dvNativeOutput ? "decoded for native output, where an output mode can carry it"
+              : m_dvConvertSdr && m_hdrAsSdrChosen
+                  ? "decoded to be rebuilt and mapped to SDR, as the user chose for this video "
+                    "(on an output that takes HDR)"
               : m_dvConvertSdr && DVBRIDGE::BaseLayerIsNoPicture(
                                       hints.dovi.dv_profile,
                                       hints.dovi.dv_bl_signal_compatibility_id)
@@ -489,6 +495,10 @@ bool CDVDVideoCodecFFmpeg::Open(CDVDStreamInfo &hints, CDVDCodecOptions &options
               : m_dvConvertSdr ? "decoded to be rebuilt and mapped to SDR with the metadata of "
                                  "each picture (the output takes no HDR10, and the tone mapping "
                                  "method of the video is that of a reference display)"
+              : m_hdrAsSdrChosen
+                  ? "decoded for the ordinary output, its base layer sent as SDR, as the user chose "
+                    "for this video (it is not rebuilt for SDR here: the tone mapping method of the "
+                    "video is not that of a reference display, or this output cannot draw it)"
               : m_dvConvert && m_dvNoNative ? "decoded for output as HDR10, as the user chose "
                                               "for this video"
               : m_dvConvert && DVBRIDGE::BaseLayerIsNoPicture(
@@ -968,6 +978,7 @@ void CDVDVideoCodecFFmpeg::Dispose()
   m_dvConvert = false;
   m_dvConvertSdr = false;
   m_dvNoNative = false;
+  m_hdrAsSdrChosen = false;
   m_dvFromHdr10Plus = false;
   m_dvHdr10PlusFill = false;
   dvbridge_hdr10plus_scene_destroy(m_dvHdr10PlusScene);
@@ -2660,6 +2671,7 @@ bool CDVDVideoCodecFFmpeg::GetPictureCommon(VideoPicture* pVideoPicture)
   pVideoPicture->doviBaseRefused = false;
   pVideoPicture->doviConvertSdr = m_dvConvertSdr;
   pVideoPicture->doviNoNative = m_dvNoNative;
+  pVideoPicture->hdrAsSdrChosen = m_hdrAsSdrChosen;
   pVideoPicture->doviRpuRepeated = false;
   pVideoPicture->doviHdr10Plus = 0;
   pVideoPicture->doviFromCpu = false;
