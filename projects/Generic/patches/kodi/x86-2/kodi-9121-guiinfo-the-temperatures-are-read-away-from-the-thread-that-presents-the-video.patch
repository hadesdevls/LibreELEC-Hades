+
+#pragma once
+
+#include <chrono>
+#include <functional>
+#include <memory>
+#include <mutex>
+#include <optional>
+#include <utility>
+
+namespace KODI::UTILS
+{
+
+/*!
+ * \brief A value that can be slow to read (a command that is run, a sensor of a driver), kept as
+ *        its last reading, so that the thread that draws the GUI never waits for it.
+ *
+ * The thread that draws Kodi's GUI also presents the frames of a video. A label that runs a
+ * command each time it is read again holds that thread for as long as the command runs: the
+ * temperature that LibreELEC's gputemp gives runs nvidia-smi on an NVIDIA card, and the frames
+ * stood still for that time.
+ *
+ * Get() with \a wait false (the GUI's thread) never waits: it gives the last reading (none before
+ * the first one has ended) and, where there is none or the last one began \a interval ago or
+ * earlier, starts a new one on the runner (Kodi's job manager), one at a time; a later call has
+ * it once it has ended. Get() with \a wait true (an add-on, JSON-RPC: threads that waited before)
+ * reads where the last reading is that old, there and then, as Kodi did.
+ *
+ * The state is shared with the reading that runs: one that ends after its owner is gone writes
+ * only into that state. The function that reads must not refer to the owner either.
+ */
+template<typename T>
+class CBackgroundReading
+{
+public:
+  using Clock = std::chrono::steady_clock;
+  //! runs a task away from the caller; false where it cannot (the task is then not run)
+  using Runner = std::function<bool(std::function<void()>)>;
+  //! said after each reading: what it gave and how long it took, on the thread that read
+  using Done = std::function<void(const T& value, Clock::duration took, bool waited)>;
+
+  CBackgroundReading(std::function<T()> read,
+                     Clock::duration interval,
+                     Runner runner,
+                     Done done = nullptr)
+    : m_state(std::make_shared<State>()),
+      m_read(std::move(read)),
+      m_interval(interval),
+      m_runner(std::move(runner)),
+      m_done(std::move(done))
+  {
+  }
+
+  /*!
+   * \brief The last reading, or nothing before a first one has ended.
+   * \param wait false: never waits (a reading that is due runs on the runner); true: a reading
+   *        that is due is made here before this returns
+   * \param now the time of the call (a clock that only goes forward)
+   */
+  std::optional<T> Get(bool wait, Clock::time_point now = Clock::now())
+  {
+    std::unique_lock lock(m_state->mutex);
+    if (m_state->value && now - m_state->begun < m_interval)
+      return m_state->value;
+    if (wait)
+    {
+      // not under the lock: a reading in the background may end meanwhile
+      lock.unlock();
+      const auto start = Clock::now();
+      T value = m_read();
+      const auto took = Clock::now() - start;
+      if (m_done)
+        m_done(value, took, true);
+      lock.lock();
+      m_state->Store(std::move(value), now);
+      return m_state->value;
+    }
+    if (!m_state->running)
+    {
+      m_state->running = true;
+      lock.unlock();
+      // a copy of what the task needs: it may outlive this object
+      std::shared_ptr<State> state = m_state;
+      std::function<T()> read = m_read;
+      Done done = m_done;
+      const bool started = m_runner && m_runner(
+                                           [state, read, done, now]
+                                           {
+                                             const auto start = Clock::now();
+                                             T value = read();
+                                             const auto took = Clock::now() - start;
+                                             if (done)
+                                               done(value, took, false);
+                                             std::unique_lock taskLock(state->mutex);
+                                             state->Store(std::move(value), now);
+                                             state->running = false;
+                                           });
+      lock.lock();
+      if (!started)
+        m_state->running = false;
+    }
+    return m_state->value;
+  }
+
+  //! \brief Whether a reading runs in the background now.
+  bool Running() const
+  {
+    std::unique_lock lock(m_state->mutex);
+    return m_state->running;
+  }
+
+private:
+  struct State
+  {
+    std::mutex mutex;
+    std::optional<T> value; //!< the last reading
+    Clock::time_point begun; //!< when it began
+    bool running = false; //!< a reading runs in the background
+
+    //! a reading that began at \a when, unless one that began later is already in
+    void Store(T reading, Clock::time_point when)
+    {
+      if (value && when < begun)
+        return;
+      value = std::move(reading);
+      begun = when;
+    }
+  };
+
+  const std::shared_ptr<State> m_state;
+  const std::function<T()> m_read;
+  const Clock::duration m_interval;
+  const Runner m_runner;
+  const Done m_done;
+};
+
+} // namespace KODI::UTILS
