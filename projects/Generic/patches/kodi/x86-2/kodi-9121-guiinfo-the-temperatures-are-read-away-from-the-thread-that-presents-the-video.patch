diff --git a/xbmc/utils/test/TestBackgroundReading.cpp b/xbmc/utils/test/TestBackgroundReading.cpp
new file mode 100644
index 0000000..28174f6
--- /dev/null
+++ b/xbmc/utils/test/TestBackgroundReading.cpp
@@ -0,0 +1,232 @@
+/*
+ *  Copyright (C) 2026 Hades
+ *  This file is part of LibreELEC Hades. It is not in Kodi as Team Kodi publishes it.
+ *
+ *  SPDX-License-Identifier: GPL-2.0-or-later
+ *  See LICENSES/README.md for more information.
+ */
+
+#include "utils/BackgroundReading.h"
+
+#include <atomic>
+#include <chrono>
+#include <functional>
+#include <memory>
+#include <thread>
+#include <vector>
+
+#include <gtest/gtest.h>
+
+using namespace KODI::UTILS;
+using namespace std::chrono_literals;
+
+namespace
+{
+using Reading = CBackgroundReading<int>;
+using Clock = Reading::Clock;
+
+//! runs each task on a thread of its own, joined when it goes
+class CThreads
+{
+public:
+  ~CThreads()
+  {
+    for (auto& thread : m_threads)
+      thread.join();
+  }
+  Reading::Runner Runner()
+  {
+    return [this](std::function<void()> task)
+    {
+      m_threads.emplace_back(std::move(task));
+      return true;
+    };
+  }
+
+private:
+  std::vector<std::thread> m_threads;
+};
+
+//! keeps the tasks, run when the test says
+class CHeld
+{
+public:
+  Reading::Runner Runner()
+  {
+    return [this](std::function<void()> task)
+    {
+      m_tasks.push_back(std::move(task));
+      return true;
+    };
+  }
+  size_t Count() const { return m_tasks.size(); }
+  void RunAll()
+  {
+    auto tasks = std::move(m_tasks);
+    m_tasks.clear();
+    for (auto& task : tasks)
+      task();
+  }
+
+private:
+  std::vector<std::function<void()>> m_tasks;
+};
+
+bool WaitUntilDone(const Reading& reading)
+{
+  for (int i = 0; i < 400 && reading.Running(); ++i)
+    std::this_thread::sleep_for(5ms);
+  return !reading.Running();
+}
+} // namespace
+
+// The GUI's thread does not wait for a reading that takes long (a command such as nvidia-smi):
+// nothing before the first one has ended, then its value
+TEST(TestBackgroundReading, NeverWaitsWithoutWait)
+{
+  std::atomic<int> reads{0};
+  CThreads threads; // (joined before reads goes)
+  Reading reading(
+      [&reads]
+      {
+        std::this_thread::sleep_for(150ms);
+        return ++reads;
+      },
+      60s, threads.Runner());
+  const auto start = Clock::now();
+  const auto first = reading.Get(false);
+  const auto took = Clock::now() - start;
+  EXPECT_FALSE(first.has_value());
+  EXPECT_LT(took, 50ms) << "the caller waited for the reading";
+  ASSERT_TRUE(WaitUntilDone(reading));
+  const auto second = reading.Get(false);
+  ASSERT_TRUE(second.has_value());
+  EXPECT_EQ(1, *second);
+}
+
+// One reading at a time, however often it is asked for while it runs, and none while it is fresh
+TEST(TestBackgroundReading, OneReadingAtATime)
+{
+  std::atomic<int> reads{0};
+  CThreads threads; // (joined before reads goes)
+  Reading reading(
+      [&reads]
+      {
+        std::this_thread::sleep_for(60ms);
+        return ++reads;
+      },
+      60s, threads.Runner());
+  for (int i = 0; i < 100; ++i)
+    reading.Get(false);
+  ASSERT_TRUE(WaitUntilDone(reading));
+  for (int i = 0; i < 100; ++i)
+    EXPECT_EQ(1, reading.Get(false).value_or(-1));
+  EXPECT_FALSE(reading.Running());
+  EXPECT_EQ(1, reads.load());
+}
+
+// A reading that is due is started, and the last one is given until it has ended
+TEST(TestBackgroundReading, TheLastReadingWhileTheNextRuns)
+{
+  CHeld held;
+  int reads = 0;
+  Reading reading([&reads] { return ++reads; }, 60s, held.Runner());
+  const auto t0 = Clock::now();
+  EXPECT_FALSE(reading.Get(false, t0).has_value());
+  EXPECT_EQ(1u, held.Count());
+  held.RunAll();
+  EXPECT_EQ(1, reading.Get(false, t0 + 1s).value_or(-1));
+  EXPECT_EQ(1, reading.Get(false, t0 + 59s).value_or(-1));
+  EXPECT_EQ(0u, held.Count()) << "a fresh reading was read again";
+  // due: the old value, and a new reading started
+  EXPECT_EQ(1, reading.Get(false, t0 + 60s).value_or(-1));
+  EXPECT_EQ(1u, held.Count());
+  EXPECT_EQ(1, reading.Get(false, t0 + 61s).value_or(-1));
+  EXPECT_EQ(1u, held.Count()) << "a second reading was started while one runs";
+  held.RunAll();
+  EXPECT_EQ(2, reading.Get(false, t0 + 62s).value_or(-1));
+  // its interval runs from when it began (60 s)
+  EXPECT_EQ(2, reading.Get(false, t0 + 119s).value_or(-1));
+  EXPECT_EQ(0u, held.Count());
+  reading.Get(false, t0 + 120s);
+  EXPECT_EQ(1u, held.Count());
+}
+
+// A caller that may wait reads there and then where the reading is due, as Kodi did
+TEST(TestBackgroundReading, WaitReadsThere)
+{
+  CHeld held;
+  int reads = 0;
+  Reading reading([&reads] { return ++reads; }, 60s, held.Runner());
+  const auto t0 = Clock::now();
+  EXPECT_EQ(1, reading.Get(true, t0).value_or(-1));
+  EXPECT_EQ(1, reading.Get(true, t0 + 59s).value_or(-1));
+  EXPECT_EQ(2, reading.Get(true, t0 + 60s).value_or(-1));
+  EXPECT_EQ(0u, held.Count()) << "a caller that waits used the runner";
+  EXPECT_EQ(2, reads);
+}
+
+// A runner that cannot run the task: nothing runs, and the next call tries again
+TEST(TestBackgroundReading, RunnerThatCannotRun)
+{
+  int asked = 0;
+  Reading reading([] { return 7; }, 60s,
+                  [&asked](std::function<void()>)
+                  {
+                    ++asked;
+                    return false;
+                  });
+  EXPECT_FALSE(reading.Get(false).has_value());
+  EXPECT_FALSE(reading.Running());
+  EXPECT_FALSE(reading.Get(false).has_value());
+  EXPECT_EQ(2, asked);
+  Reading none([] { return 7; }, 60s, nullptr);
+  EXPECT_FALSE(none.Get(false).has_value());
+  EXPECT_FALSE(none.Running());
+}
+
+// A reading that ends after its owner is gone (Kodi stops while a command runs) writes nowhere
+// else (AddressSanitizer would see it)
+TEST(TestBackgroundReading, OutlivesItsOwner)
+{
+  CHeld held;
+  auto reading = std::make_unique<Reading>([] { return 3; }, 60s, held.Runner());
+  reading->Get(false);
+  reading.reset();
+  held.RunAll();
+  SUCCEED();
+}
+
+// A reading in the background that began before one that a waiting caller made does not replace it
+TEST(TestBackgroundReading, TheLaterReadingIsKept)
+{
+  CHeld held;
+  int reads = 0;
+  Reading reading([&reads] { return ++reads; }, 60s, held.Runner());
+  const auto t0 = Clock::now();
+  EXPECT_FALSE(reading.Get(false, t0).has_value()); // started, held
+  EXPECT_EQ(1, reading.Get(true, t0 + 1s).value_or(-1)); // read there: 1, begun at t0 + 1 s
+  held.RunAll(); // the held one reads 2, but it began at t0
+  EXPECT_EQ(1, reading.Get(false, t0 + 2s).value_or(-1));
+  EXPECT_FALSE(reading.Running());
+}
+
+// What each reading gave, how long it took and for whom
+TEST(TestBackgroundReading, Done)
+{
+  CHeld held;
+  std::vector<std::pair<int, bool>> said;
+  Reading reading([] { return 5; }, 60s, held.Runner(),
+                  [&said](const int& value, Clock::duration took, bool waited)
+                  {
+                    EXPECT_GE(took.count(), 0);
+                    said.emplace_back(value, waited);
+                  });
+  const auto t0 = Clock::now();
+  reading.Get(false, t0);
+  held.RunAll();
+  reading.Get(true, t0 + 60s);
+  ASSERT_EQ(2u, said.size());
+  EXPECT_EQ(std::make_pair(5, false), said[0]);
+  EXPECT_EQ(std::make_pair(5, true), said[1]);
+}
