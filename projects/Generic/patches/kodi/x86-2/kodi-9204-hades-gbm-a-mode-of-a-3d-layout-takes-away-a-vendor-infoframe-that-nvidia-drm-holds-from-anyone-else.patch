From 98faf24ad840b7988ae3dd7a7e5f293f122946a6 Mon Sep 17 00:00:00 2001
From: Hades <15710513+hadesdevls@users.noreply.github.com>
Date: Tue, 24 Nov 2026 16:51:14 +0000
Subject: [PATCH] [Hades][GBM] A mode of a 3D layout takes away a vendor
 InfoFrame that nvidia-drm holds from anyone else

nvidia-drm refuses a mode with a 3D layout while the connector holds a
vendor InfoFrame (NV_HDMI_VSIF_METADATA, or HDR10PLUS_VSIF): the driver tells
the display of the layout with one of its own, which the one from the
property would take the place of (nv_drm_crtc_atomic_check_frame_packed() of
nvidia-open-kernel-modules-9001). PrepareStereoInfoFrame() takes away Kodi's
own InfoFrame of a 3D layout (NextInfoFrameStep()), but left one of anyone
else in place: one left by a Dolby Vision output, or by a Kodi before this
one. Issue #33: the frame-packed mode of 1080p24 was refused on five NVIDIA
cards; whether such an InfoFrame was there is not in those logs, and this is
one of the reasons the driver gives.

With a mode of a 3D layout, any vendor InfoFrame that the driver holds and
that is not Kodi's own now goes with the commit
(STEREO::TakeAwayHeldInfoFrame()), and kodi.log says so. A 2D mode keeps
what it holds, as before.

Test: tools/regress/mvc/kodi (stereo_rate_test.cpp), six cases and three
mutants of the rule.
---
 xbmc/windowing/gbm/WinSystemGbm.cpp | 16 ++++++++++++++++
 xbmc/windowing/gbm/drm/DRMStereo.h  | 18 ++++++++++++++++++
 2 files changed, 34 insertions(+)

diff --git a/xbmc/windowing/gbm/WinSystemGbm.cpp b/xbmc/windowing/gbm/WinSystemGbm.cpp
index 15b90bd..94dd2c9 100644
--- a/xbmc/windowing/gbm/WinSystemGbm.cpp
+++ b/xbmc/windowing/gbm/WinSystemGbm.cpp
@@ -1150,6 +1150,22 @@ void CWinSystemGbm::PrepareStereoInfoFrame(const RESOLUTION_INFO& res)
   const STEREO::Mode mode = m_DRM->GetSelectedStereoMode();
   const bool plain =
       m_DRM->GetSelectedMode() && STEREO::LayoutOf(mode.flags) == STEREO::Layout::NONE;
+
+  // Hades: nvidia-drm refuses a mode with a 3D layout while the connector holds a vendor InfoFrame
+  // of anyone, which would take the place of the one it tells the display of that layout with
+  // (nv_drm_crtc_atomic_check_frame_packed(), issue #33). Kodi's own 3D one is taken away by the
+  // step below; one that is not Kodi's own (left there by a Dolby Vision output, or by a Kodi
+  // before this one) goes with this commit too.
+  if (!plain && m_DRM->GetSelectedMode())
+  {
+    const uint64_t held = connector->GetPropertyValue("NV_HDMI_VSIF_METADATA").value_or(0);
+    if (STEREO::TakeAwayHeldInfoFrame(true, held,
+                                      m_stereoInfoFrame.IsValid() ? m_stereoInfoFrame.Get() : 0) &&
+        drm->AddProperty(connector, "NV_HDMI_VSIF_METADATA", 0))
+      CLog::Log(LOGINFO, "3D output: the HDMI vendor InfoFrame that the driver holds, which is not "
+                         "Kodi's own 3D one, is taken away with the mode of a 3D layout: the "
+                         "driver tells the display of that layout itself");
+  }
   STEREO::Layout wanted = STEREO::Layout::NONE;
   if (split && plain && !res.strId.empty())
   {
diff --git a/xbmc/windowing/gbm/drm/DRMStereo.h b/xbmc/windowing/gbm/drm/DRMStereo.h
index 1c5a608..470687b 100644
--- a/xbmc/windowing/gbm/drm/DRMStereo.h
+++ b/xbmc/windowing/gbm/drm/DRMStereo.h
@@ -951,6 +951,24 @@ constexpr Shown ShownOf(Layout output, Layout infoFrame, bool split, bool topAnd
   return topAndBottom ? Shown::OVER_UNDER_UNTOLD : Shown::SIDE_BY_SIDE_UNTOLD;
 }
 
+/*!
+ * \brief Hades: whether a vendor InfoFrame that the driver holds, which is not Kodi's own one of a
+ *        3D layout, is taken away with the commit of a mode (issue #33)
+ *
+ * nvidia-drm refuses a mode with a 3D layout while the connector holds a vendor InfoFrame
+ * (nv_drm_crtc_atomic_check_frame_packed()): the driver tells the display of the layout with one
+ * of its own, which the one from the property would take the place of. Kodi's own one is taken
+ * away by NextInfoFrameStep(); one of anyone else (left by a Dolby Vision output, or by a Kodi
+ * before this one) only here, and only with such a mode.
+ * \param layoutMode the mode has a 3D layout
+ * \param held the blob that the driver holds (0: none)
+ * \param own the blob of Kodi's own InfoFrame of a 3D layout (0: none)
+ */
+constexpr bool TakeAwayHeldInfoFrame(bool layoutMode, uint64_t held, uint64_t own)
+{
+  return layoutMode && held != 0 && held != own;
+}
+
 } // namespace STEREO
 } // namespace GBM
 } // namespace WINDOWING
