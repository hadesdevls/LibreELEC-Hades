diff --git a/addons/resource.language.en_gb/resources/strings.po b/addons/resource.language.en_gb/resources/strings.po
index 3c35771..d140a69 100644
--- a/addons/resource.language.en_gb/resources/strings.po
+++ b/addons/resource.language.en_gb/resources/strings.po
@@ -28699,6 +28699,30 @@ msgctxt "#62773"
 msgid "JVC: the anamorphic mode that Hades sets on the projector for these pictures, for an anamorphic lens. It goes with their lens memory, after it (a lens memory recalls an anamorphic mode of its own). A and C stretch a 2.35:1 picture vertically; B and D compress a 16:9 picture horizontally, for a lens that stays in place; C and D are for the DCR lens of Panamorph. Off: for a lens that moves out of the way. Leave it as it is: Hades does not touch it (the default). The models of 2015 have A and B, those of 2018 A to C, the NZ500, NZ700, NZ800 and NZ900 A to D (JVC's command references); a model ignores a mode it does not have, and kodi.log says so."
 msgstr ""
 
+#: xbmc/network/ProjectorControl.cpp
+#. Hades: the projector control: label of videoscreen.hadesprojectorosd; translated in Estuary (#54774)
+msgctxt "#62774"
+msgid "Player controls inside a scope picture"
+msgstr ""
+
+#: xbmc/network/ProjectorControl.cpp
+#. Hades: the projector control: help of videoscreen.hadesprojectorosd; translated in Estuary (#54775)
+msgctxt "#62775"
+msgid "Where a projector shows a scope film (2.35:1 to 2.40:1) by zooming or stretching the 16:9 picture, what is drawn above and below the film falls outside the screen: the player controls, the seek bar, the clock, the notices, and subtitles in the black bars. This keeps them inside the picture of the film (a band of 2.40:1, or narrower for a wider film). While the projector shows a scope picture: once the projector control above has selected the lens memory or the anamorphic mode of wide pictures (the default; without the projector control nothing changes). Always while a video plays: for a projector that is zoomed or set for scope by hand. In the band, subtitles are drawn a quarter smaller, and the zoom or stretch of the projector gives them back their usual size."
+msgstr ""
+
+#: xbmc/network/ProjectorControl.cpp
+#. Hades: the projector control: value of videoscreen.hadesprojectorosd; translated in Estuary (#54776)
+msgctxt "#62776"
+msgid "While the projector shows a scope picture"
+msgstr ""
+
+#: xbmc/network/ProjectorControl.cpp
+#. Hades: the projector control: value of videoscreen.hadesprojectorosd; translated in Estuary (#54777)
+msgctxt "#62777"
+msgid "Always while a video plays"
+msgstr ""
+
 #: system/settings/settings.xml
 #. Hades: label of the setting "videoplayer.hadesfilmmemory" (Player > Videos); translated in Estuary (#54650)
 msgctxt "#62650"
