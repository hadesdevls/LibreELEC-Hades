 using namespace std::chrono_literals;
 
+namespace
+{
+/*!
+ * \brief Hades: the view of the subtitles kept inside the band of a scope picture (network/ProjectorFeed.h,
+ *        SafeBand()): the projector zooms or stretches the 16:9 frame beyond a scope screen above and below it, and
+ *        what is drawn there is not seen. Of a fullscreen video in 2D only (each eye of a 3D video has its own place
+ *        and depth); the view is left as it is elsewhere. True where it was narrowed.
+ */
+bool SubtitleBand(CRect& view)
+{
+  const double band = PROJECTOR::SafeBand();
+  if (!(band > 0.0) || view.Height() <= 0.0f)
+    return false;
+  auto& gfx = CServiceBroker::GetWinSystem()->GetGfxContext();
+  const RenderStereoMode stereo = gfx.GetStereoMode();
+  if (!gfx.IsFullScreenVideo() ||
+      (stereo != RenderStereoMode::OFF && stereo != RenderStereoMode::MONO))
+    return false;
+  // (the shape of the view as the display shows it: its pixels may not be square)
+  const double height = static_cast<double>(view.Height());
+  const double frame = static_cast<double>(view.Width()) *
+                       static_cast<double>(gfx.GetResInfo().fPixelRatio) / height;
+  const float inset = static_cast<float>(PROJECTOR::InsetOf(band, frame) * height);
+  if (inset < 1.0f)
+    return false;
+  view.y1 += inset;
+  view.y2 -= inset;
+  return true;
+}
