+void CProjectorControl::FollowOsd(const Config& config, bool playing, bool scope)
+{
+  const double band = SafeBand(config.osd, playing, scope, m_lens.Now().ratio);
+  SetSafeBand(band);
+  // the skin: its frame is 16:9, 1080 high (Estuary), whatever the output's size
+  const int units = InsetSkinUnits(InsetOf(band, 16.0 / 9.0));
+  const std::string steps = InsetSteps(units);
+  const double now = Now();
+  if (steps == m_osdSteps && (steps.empty() || now - m_osdToldAt < OSD_RETELL_SECONDS))
+    return;
+  if (steps != m_osdSteps)
+    CLog::Log(LOGINFO, "Projector: the player controls {}",
+              steps.empty() ? std::string("as the skin places them")
+                            : StringUtils::Format("inside a band of {:.2f}:1 ({} of 1080 above and "
+                                                  "below)",
+                                                  band, units));
+  m_osdSteps = steps;
+  m_osdToldAt = now;
+  // (on the thread of the interface, which owns the windows: a builtin, as Kodi's own code posts one)
+  const auto messenger = CServiceBroker::GetAppMessenger();
+  if (!messenger)
+    return;
+  if (steps.empty())
+  {
+    messenger->PostMsg(TMSG_EXECUTE_BUILT_IN, -1, -1, nullptr,
+                       "ClearProperty(hades.osd.inset,home)");
+    messenger->PostMsg(TMSG_EXECUTE_BUILT_IN, -1, -1, nullptr,
+                       "ClearProperty(hades.osd.insetsteps,home)");
+  }
+  else
+  {
+    messenger->PostMsg(TMSG_EXECUTE_BUILT_IN, -1, -1, nullptr,
+                       StringUtils::Format("SetProperty(hades.osd.inset,{},home)", units));
+    messenger->PostMsg(TMSG_EXECUTE_BUILT_IN, -1, -1, nullptr,
+                       StringUtils::Format("SetProperty(hades.osd.insetsteps,{},home)", steps));
+  }
+}
