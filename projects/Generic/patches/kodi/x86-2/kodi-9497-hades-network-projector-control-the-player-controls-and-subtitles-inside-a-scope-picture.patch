+      (mode == static_cast<int>(OsdSafe::SCOPE) && !scope))
+    return 0.0;
+  return scope && ratio > SCOPE_SCREEN ? ratio : SCOPE_SCREEN;
+}
+
+//! the share of the height of a frame of shape frame (width to a height of 1) above, and below, a
+//! band of shape band centred in it (0: the band is not narrower than the frame)
+inline double InsetOf(double band, double frame)
+{
+  return band > frame && frame > 0.0 ? (1.0 - frame / band) / 2.0 : 0.0;
+}
+
+//! ... in the units of a skin 1080 high (Estuary), rounded up to the step of the skin's slides (4),
+//! at most the sum of its steps (252)
+constexpr int INSET_STEP = 4;
+constexpr int INSET_MOST = 252;
+inline int InsetSkinUnits(double inset)
+{
+  if (!(inset > 0.0))
+    return 0;
+  // (a hair under a step is that step: 2.40:1 in 16:9 is 140, not 144)
+  int units = static_cast<int>(inset * 1080.0 / INSET_STEP - 1e-6) * INSET_STEP;
+  if (units < inset * 1080.0 - 1e-6)
+    units += INSET_STEP;
+  return units > INSET_MOST ? INSET_MOST : units;
+}
+
+//! ... as the skin takes it: the steps of its slides in the units, "_4_8_128_" for 140 ("" for 0;
+//! the skin looks for "_4_" and the like: no character of its conditions or of a builtin's commas)
+inline std::string InsetSteps(int units)
+{
+  std::string steps;
+  for (int step = INSET_STEP; step <= 128; step *= 2)
+    if (units & step)
+      steps += "_" + std::to_string(step);
+  return steps.empty() ? steps : steps + "_";
+}
