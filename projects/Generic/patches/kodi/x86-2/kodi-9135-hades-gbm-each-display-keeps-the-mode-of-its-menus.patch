+#pragma once
+
+#include <algorithm>
+#include <cstddef>
+#include <optional>
+#include <sstream>
+#include <string>
+#include <utility>
+#include <vector>
+
+namespace KODI::WINDOWING::GBM::DISPLAY_MODES
+{
+
+/*!
+ * \brief Hades: the mode of the menus of each display (videoscreen.screenmode, as it was set while
+ *        that display showed Kodi), kept in special://profile/hades-display-modes.txt.
+ *
+ * Kodi keeps one mode of the menus, of whatever display it was set on, and a start or a move of
+ * Kodi to another display takes it there where that display has the mode: on 2026-11-18 the LG C5
+ * of the tests started in the 2560x1440 at 120 Hz of the Samsung Odyssey G60SD that Kodi had shown on
+ * before, and kept it for a video of 1920x1080, whose mode of 3840x2160 at 23.976 Hz Kodi's
+ * default whitelist does not take from the menus' resolution. Each display gets the mode it had,
+ * a display not seen before the mode it prefers (DESKTOP), and nothing changes where Kodi has only
+ * ever shown on one display: there the mode of the settings is taken and noted for it.
+ *
+ * A display is known by the make and model of its EDID (Key()). Pure: a test runs it on the host
+ * (display_modes_test.cpp).
+ */
+
+//! The mode of the settings that names the mode a display prefers
+constexpr const char* DESKTOP = "DESKTOP";
+//! The displays kept, the ones used last
+constexpr size_t LIMIT = 32;
+
+//! The key of a display: its make and model, a tab or a line break in them made a space
+inline std::string Key(const std::string& make, const std::string& model)
+{
+  if (make.empty() && model.empty())
+    return {};
+  std::string key = make + " / " + model;
+  std::replace_if(
+      key.begin(), key.end(), [](char c) { return c == '\t' || c == '\n' || c == '\r'; }, ' ');
+  return key;
+}
+
+class CDisplayModeMemory
+{
+public:
+  //! Lines of "key<TAB>mode"; anything else is left out
+  void Parse(const std::string& text)
+  {
+    m_modes.clear();
+    std::istringstream lines(text);
+    std::string line;
+    while (std::getline(lines, line))
+    {
+      if (!line.empty() && line.back() == '\r')
+        line.pop_back();
+      const size_t tab = line.find('\t');
+      if (tab == std::string::npos || tab == 0 || tab + 1 >= line.size() ||
+          line.find('\t', tab + 1) != std::string::npos)
+        continue;
+      Put(line.substr(0, tab), line.substr(tab + 1));
+    }
+  }
+  std::string Text() const
+  {
+    std::string text;
+    for (const auto& [key, mode] : m_modes)
+      text += key + '\t' + mode + '\n';
+    return text;
+  }
+  bool Empty() const { return m_modes.empty(); }
+  std::optional<std::string> Of(const std::string& key) const
+  {
+    for (const auto& [k, mode] : m_modes)
+      if (k == key)
+        return mode;
+    return std::nullopt;
+  }
+  /*!
+   * \brief The mode of the menus for a display: the one it had; for one not seen, the mode of the
+   *        settings where no display is known yet (nothing changes for Kodi on one display), else
+   *        the mode it prefers. A display not known (no key): the mode of the settings.
+   */
+  std::string Choose(const std::string& key, const std::string& setting) const
+  {
+    if (key.empty())
+      return setting;
+    if (const auto mode = Of(key))
+      return *mode;
+    return m_modes.empty() ? setting : std::string(DESKTOP);
+  }
+  //! Notes the mode of a display (the last LIMIT displays used are kept); whether anything changed
+  bool Remember(const std::string& key, const std::string& mode)
+  {
+    if (key.empty() || mode.empty() || key.find('\t') != std::string::npos ||
+        mode.find('\t') != std::string::npos || mode.find('\n') != std::string::npos)
+      return false;
+    if (!m_modes.empty() && m_modes.back().first == key && m_modes.back().second == mode)
+      return false;
+    Put(key, mode);
+    return true;
+  }
+
+private:
+  void Put(const std::string& key, const std::string& mode)
+  {
+    m_modes.erase(std::remove_if(m_modes.begin(), m_modes.end(),
+                                 [&key](const auto& entry) { return entry.first == key; }),
+                  m_modes.end());
+    m_modes.emplace_back(key, mode);
+    if (m_modes.size() > LIMIT)
+      m_modes.erase(m_modes.begin());
+  }
+  std::vector<std::pair<std::string, std::string>> m_modes;
+};
+
+} // namespace KODI::WINDOWING::GBM::DISPLAY_MODES
