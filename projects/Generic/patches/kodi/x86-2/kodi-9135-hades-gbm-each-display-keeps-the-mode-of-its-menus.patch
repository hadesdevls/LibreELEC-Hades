+namespace
+{
+constexpr const char* DISPLAY_MODES_FILE = "special://profile/hades-display-modes.txt";
+} // namespace
+
+std::string CWinSystemGbm::DisplayModeKey() const
+{
+  const auto info = DisplayInfo();
+  return info ? DISPLAY_MODES::Key(info->GetMake(), info->GetModel()) : std::string();
+}
+
+void CWinSystemGbm::WriteDisplayModes()
+{
+  const std::string text = m_displayModes.Text();
+  const std::string temporary = std::string(DISPLAY_MODES_FILE) + ".new";
+  XFILE::CFile file;
+  if (!file.OpenForWrite(temporary, true) ||
+      file.Write(text.data(), text.size()) != static_cast<ssize_t>(text.size()))
+  {
+    CLog::Log(LOGWARNING,
+              "Display modes: the mode of the menus of each display could not be "
+              "written ({})",
+              DISPLAY_MODES_FILE);
+    return;
+  }
+  file.Close();
+  if (!XFILE::CFile::Rename(temporary, DISPLAY_MODES_FILE))
+    CLog::Log(LOGWARNING,
+              "Display modes: the mode of the menus of each display could not be "
+              "written ({})",
+              DISPLAY_MODES_FILE);
+}
+
+std::string CWinSystemGbm::ScreenModeFor(const std::string& setting)
+{
+  const std::string key = DisplayModeKey();
+  if (key.empty())
+    return setting;
+  std::unique_lock lock(m_displayModesLock);
+  if (!m_displayModesRead)
+  {
+    m_displayModesRead = true;
+    XFILE::CFile file;
+    std::vector<uint8_t> data;
+    if (XFILE::CFile::Exists(DISPLAY_MODES_FILE, false) &&
+        file.LoadFile(DISPLAY_MODES_FILE, data) >= 0 && data.size() < 64 * 1024)
+      m_displayModes.Parse(std::string(data.begin(), data.end()));
+  }
+  // (Kodi on one display only, so far: the mode of the settings is that display's, as always)
+  if (m_displayModes.Empty())
+  {
+    if (m_displayModes.Remember(key, setting))
+      WriteDisplayModes();
+    return setting;
+  }
+  const std::string mode = m_displayModes.Choose(key, setting);
+  const std::string told = key + '\t' + mode + '\t' + setting;
+  if (mode != setting && told != m_displayModesTold)
+  {
+    m_displayModesTold = told;
+    CLog::Log(LOGINFO,
+              "Display modes: the menus of {} go in {} ({}), not in {} of the settings, which was "
+              "set on another display",
+              key, mode == DISPLAY_MODES::DESKTOP ? "the mode it prefers" : mode,
+              m_displayModes.Of(key) ? "the mode they had on it" : "it is new to Kodi", setting);
+  }
+  return mode;
+}
+
+void CWinSystemGbm::ScreenModeChosen(const std::string& mode)
+{
+  const std::string key = DisplayModeKey();
+  if (key.empty())
+    return;
+  std::unique_lock lock(m_displayModesLock);
+  if (m_displayModes.Remember(key, mode))
+    WriteDisplayModes();
+}
+
 void CWinSystemGbm::SetResolutionAfterMove()
 {
   // The modes of this output; and of them, the resolution that a start sets (that of the settings,
@@ -4075,6 +4155,12 @@ void CWinSystemGbm::SetResolutionAfterMove()
     res = RES_DESKTOP;
   display.SetCurrentResolution(res, false);
   GetGfxContext().SetVideoResolution(res, true);
+  // Hades: the mode of the menus of this display in the settings, where they held another display's
+  // (ScreenModeFor()); saving the resolution set asks nothing
+  const std::string setting = CServiceBroker::GetSettingsComponent()->GetSettings()->GetString(
+      CSettings::SETTING_VIDEOSCREEN_SCREENMODE);
+  if (ScreenModeFor(setting) != setting)
+    display.SetCurrentResolution(res, true);
 }
 
