@@ -524,6 +528,8 @@ protected:
   //! once when the bound allows (ActiveAEDeviceChangePace.h), with the wake-up for them
   INTERNAL::CDeviceChangePace m_extDeviceChangePace;
   CTimer m_extDeviceChangeTimer{[this] { DeviceChangeWakeUp(); }};
+  //! Hades: the device change events that came while the engine drained to reconfigure
+  INTERNAL::CKeptDeviceChanges m_extReconfigureDeviceChanges;
   bool m_extSuspended = false;
   bool m_isWinSysReg = false;
 
diff --git a/xbmc/cores/AudioEngine/Engines/ActiveAE/ActiveAEDeviceChangePace.h b/xbmc/cores/AudioEngine/Engines/ActiveAE/ActiveAEDeviceChangePace.h
index b23a1d6..a0b2fe8 100644
--- a/xbmc/cores/AudioEngine/Engines/ActiveAE/ActiveAEDeviceChangePace.h
+++ b/xbmc/cores/AudioEngine/Engines/ActiveAE/ActiveAEDeviceChangePace.h
@@ -13,6 +13,9 @@
 #include <cstddef>
 #include <deque>
 #include <optional>
+#include <string>
+#include <utility>
+#include <vector>
 
 /*!
  * Hades: the device change events that ActiveAE acts on now, and those it keeps to act on once,
@@ -33,7 +36,8 @@
  * allows (Due(): the oldest listing of the window is WINDOW old). ActiveAE sets a wake-up for that
  * time with the first event kept (KEEP_FIRST), which comes back as a device change event of its
  * own. An event acted on before then covers what was kept: the wake-up then does nothing (NOTHING),
- * so that no listing is made twice for the same events.
+ * so that no listing is made twice for the same events. CKeptDeviceChanges keeps those that come
+ * while the engine cannot act on them at all (it drains to reconfigure).
  *
  * Nothing of ActiveAE is here: a test runs it on the host (TestActiveAEDeviceChangePace.cpp).
  */
@@ -100,4 +104,49 @@ private:
   std::optional<Clock::time_point> m_due;
 };
 
+/*!
+ * \brief Hades: the device change events that come while the engine drains to reconfigure
+ *        (AE_TOP_RECONFIGURING), kept to be sent again once it is configured, each kind once
+ *
+ * That state had no handler of its own for them, and its parent, AE_TOP, dropped them ("not
+ * handled"): the outputs stayed as they were listed before the drain until another event came.
+ */
+class CKeptDeviceChanges
+{
+public:
+  //! Keeps a device change event (DEVICECHANGE); false where one is kept already
+  bool Device() { return !std::exchange(m_device, true); }
+  //! Keeps a change of the default device (DEFAULTDEVICECHANGE); false where one is kept already
+  bool DefaultDevice() { return !std::exchange(m_defaultDevice, true); }
+  //! Keeps a change of the devices of a driver (DEVICECOUNTCHANGE); false where one of that driver
+  //! is kept already
+  bool CountOf(const std::string& driver)
+  {
+    if (std::find(m_drivers.begin(), m_drivers.end(), driver) != m_drivers.end())
+      return false;
+    m_drivers.push_back(driver);
+    return true;
+  }
+  bool Empty() const { return !m_device && !m_defaultDevice && m_drivers.empty(); }
+
+  struct Kept
+  {
+    bool device{false};
+    bool defaultDevice{false};
+    std::vector<std::string> drivers; //!< in the order they came
+  };
+  //! What is kept, which is not kept any more after it
+  Kept Take()
+  {
+    Kept kept{std::exchange(m_device, false), std::exchange(m_defaultDevice, false),
+              std::exchange(m_drivers, {})};
+    return kept;
+  }
+
+private:
+  bool m_device{false};
+  bool m_defaultDevice{false};
+  std::vector<std::string> m_drivers;
+};
+
 } // namespace ActiveAE::INTERNAL
diff --git a/xbmc/cores/AudioEngine/Sinks/test/TestActiveAEDeviceChangePace.cpp b/xbmc/cores/AudioEngine/Sinks/test/TestActiveAEDeviceChangePace.cpp
index 2dc9423..f06bba6 100644
--- a/xbmc/cores/AudioEngine/Sinks/test/TestActiveAEDeviceChangePace.cpp
+++ b/xbmc/cores/AudioEngine/Sinks/test/TestActiveAEDeviceChangePace.cpp
@@ -11,6 +11,7 @@
 #include <algorithm>
 #include <chrono>
 #include <optional>
+#include <string>
 #include <utility>
 #include <vector>
 
@@ -210,3 +211,31 @@ TEST(TestActiveAEDeviceChangePace, TheWaitIsInWholeMillisecondsAndNeverNone)
   EXPECT_EQ(CDeviceChangePace::Wait(T0, T0), 1ms);
   EXPECT_EQ(CDeviceChangePace::Wait(T0, T0 + 1s), 1ms);
 }
+
+// While the engine drains to reconfigure, each kind of event is kept once, and given back once
+TEST(TestActiveAEDeviceChangePace, EventsWhileReconfiguringAreKeptOnceEach)
+{
+  CKeptDeviceChanges kept;
+  EXPECT_TRUE(kept.Empty());
+  EXPECT_TRUE(kept.Device());
+  EXPECT_FALSE(kept.Device());
+  EXPECT_TRUE(kept.DefaultDevice());
+  EXPECT_FALSE(kept.DefaultDevice());
+  EXPECT_TRUE(kept.CountOf("PIPEWIRE"));
+  EXPECT_TRUE(kept.CountOf("PULSE"));
+  EXPECT_FALSE(kept.CountOf("PIPEWIRE"));
+  EXPECT_FALSE(kept.Empty());
+
+  const CKeptDeviceChanges::Kept taken = kept.Take();
+  EXPECT_TRUE(taken.device);
+  EXPECT_TRUE(taken.defaultDevice);
+  EXPECT_EQ(taken.drivers, (std::vector<std::string>{"PIPEWIRE", "PULSE"}));
+  // nothing is given back twice
+  EXPECT_TRUE(kept.Empty());
+  const CKeptDeviceChanges::Kept again = kept.Take();
+  EXPECT_FALSE(again.device);
+  EXPECT_FALSE(again.defaultDevice);
+  EXPECT_TRUE(again.drivers.empty());
+  // and it keeps again after it
+  EXPECT_TRUE(kept.Device());
+}
