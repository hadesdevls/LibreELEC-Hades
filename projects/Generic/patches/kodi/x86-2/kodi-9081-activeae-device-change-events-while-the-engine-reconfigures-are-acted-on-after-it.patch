From 32dccfd8c03213a4707c5f2b8ef38b5e200dadb1 Mon Sep 17 00:00:00 2001
From: Hades <15710513+hadesdevls@users.noreply.github.com>
Date: Wed, 18 Nov 2026 06:32:03 +0000
Subject: [PATCH] ActiveAE: device change events while the engine reconfigures
 are acted on after it

AE_TOP_RECONFIGURING, the state in which the engine drains its buffers to
take a change of the audio settings, has no handler for the device change
events, and its parent state, AE_TOP, dropped them ("signal ... not handled
for state: 4"): the engine went on with the outputs as they were listed
before the drain until another event came.

Now they are kept, each kind once (CKeptDeviceChanges in
ActiveAEDeviceChangePace.h: a device change, a change of the default
device, a change of the devices of each driver), and sent again when the
engine leaves that state, configured or in error, so that the state they
reach acts on them as on any other (the bound of a second of the device
changes included). kodi.log says when one is kept and when the ones kept
are acted on.

TestActiveAEDeviceChangePace.cpp: each kind kept once, given back once, and
kept again after it.
---
 .../AudioEngine/Engines/ActiveAE/ActiveAE.cpp | 64 ++++++++++++++++++-
 .../AudioEngine/Engines/ActiveAE/ActiveAE.h   |  6 ++
 .../ActiveAE/ActiveAEDeviceChangePace.h       | 51 ++++++++++++++-
 .../test/TestActiveAEDeviceChangePace.cpp     | 29 +++++++++
 4 files changed, 148 insertions(+), 2 deletions(-)

diff --git a/xbmc/cores/AudioEngine/Engines/ActiveAE/ActiveAE.cpp b/xbmc/cores/AudioEngine/Engines/ActiveAE/ActiveAE.cpp
index a5c9f88..8c6d393 100644
--- a/xbmc/cores/AudioEngine/Engines/ActiveAE/ActiveAE.cpp
+++ b/xbmc/cores/AudioEngine/Engines/ActiveAE/ActiveAE.cpp
@@ -750,7 +750,24 @@ void CActiveAE::StateMachine(int signal, Protocol *port, Message *msg)
       break;
 
     case AE_TOP_RECONFIGURING:
-      if (port == NULL) // timeout
+      // Hades: a device change event is not acted on while the engine drains to reconfigure,
+      // and AE_TOP, the parent of this state, dropped it ("not handled"): the outputs stayed as
+      // listed before the drain. It is kept, each kind once, and sent again once the engine is
+      // configured, or in error (SendKeptDeviceChanges()).
+      if (port == &m_controlPort)
+      {
+        switch (signal)
+        {
+          case CActiveAEControlProtocol::DEVICECHANGE:
+          case CActiveAEControlProtocol::DEFAULTDEVICECHANGE:
+          case CActiveAEControlProtocol::DEVICECOUNTCHANGE:
+            KeepDeviceChangeWhileReconfiguring(signal, msg);
+            return;
+          default:
+            break;
+        }
+      }
+      else if (port == NULL) // timeout
       {
         switch (signal)
         {
@@ -761,6 +778,7 @@ void CActiveAE::StateMachine(int signal, Protocol *port, Message *msg)
             m_state = AE_TOP_ERROR;
             m_extTimeout = 500ms;
             m_extDeferData = false;
+            SendKeptDeviceChanges();
             return;
           }
           // drain
@@ -790,6 +808,7 @@ void CActiveAE::StateMachine(int signal, Protocol *port, Message *msg)
             m_extTimeout = 500ms;
           }
           m_extDeferData = false;
+          SendKeptDeviceChanges();
           return;
         default:
           break;
@@ -4951,6 +4970,49 @@ void CActiveAE::DeviceChangeWakeUp()
                                sizeof(DEVICE_CHANGE_WAKE_UP));
 }
 
+void CActiveAE::KeepDeviceChangeWhileReconfiguring(int signal, const Message* msg)
+{
+  bool kept = false;
+  const char* what = "a device change event";
+  switch (signal)
+  {
+    case CActiveAEControlProtocol::DEVICECHANGE:
+      kept = m_extReconfigureDeviceChanges.Device();
+      break;
+    case CActiveAEControlProtocol::DEFAULTDEVICECHANGE:
+      kept = m_extReconfigureDeviceChanges.DefaultDevice();
+      what = "a change of the default device";
+      break;
+    case CActiveAEControlProtocol::DEVICECOUNTCHANGE:
+      kept = m_extReconfigureDeviceChanges.CountOf(
+          msg && msg->data ? reinterpret_cast<const char*>(msg->data) : "");
+      what = "a change of the devices of a driver";
+      break;
+    default:
+      return;
+  }
+  if (kept)
+    CLog::Log(LOGINFO,
+              "CActiveAE - {} while the engine reconfigures: kept, and acted on once that is "
+              "done",
+              what);
+}
+
+void CActiveAE::SendKeptDeviceChanges()
+{
+  if (m_extReconfigureDeviceChanges.Empty())
+    return;
+  const auto kept = m_extReconfigureDeviceChanges.Take();
+  CLog::Log(LOGINFO, "CActiveAE - the device change events kept while the engine reconfigured "
+                     "are acted on now");
+  if (kept.device)
+    DeviceChange();
+  if (kept.defaultDevice)
+    DefaultDeviceChange();
+  for (const std::string& driver : kept.drivers)
+    DeviceCountChange(driver);
+}
