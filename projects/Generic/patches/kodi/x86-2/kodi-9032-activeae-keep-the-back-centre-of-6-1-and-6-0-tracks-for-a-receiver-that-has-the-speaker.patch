diff --git a/xbmc/cores/AudioEngine/Utils/AEBackCentre.h b/xbmc/cores/AudioEngine/Utils/AEBackCentre.h
new file mode 100644
index 0000000..dc1b318
--- /dev/null
+++ b/xbmc/cores/AudioEngine/Utils/AEBackCentre.h
@@ -0,0 +1,126 @@
+/*
+ *  Copyright (C) 2026 Hades
+ *  This file is part of LibreELEC Hades. It is not in Kodi as Team Kodi publishes it.
+ *
+ *  SPDX-License-Identifier: GPL-2.0-or-later
+ *  See LICENSES/README.md for more information.
+ */
+
+#pragma once
+
+#include "cores/AudioEngine/Utils/AEChannelInfo.h"
+
+#include <string>
+
+/*!
+ * Hades: the back centre of a 6.1 or 6.0 track, for a receiver that has a back centre speaker.
+ *
+ * The engine resolves a multichannel track to the speakers of "Number of channels"
+ * (CActiveAE::ApplySettingsToFormat()). None of those layouts has a back centre (AE_CH_BC), so
+ * CAEChannelInfo::ResolveChannels() mixes the back centre of a 6.1 track (FL FR FC LFE BC SL SR:
+ * Dolby Digital EX, DTS-ES) into the two back speakers, and with 7.1 set 8 channels go out. Where
+ * the receiver has one speaker behind the listener and says so in its ELD (the speaker RC of
+ * CTA-861), the HDMI codec of the kernel offers the channel maps whose speakers are those of the
+ * ELD (sound/hda/core/hdmi_chmap.c): 6.1 is allocation 0x0f (FL FR LFE FC RL RR RC) and 6.0 is
+ * 0x0e, and there is no 7.1 (RLC and RRC) unless the receiver declares those too. Kodi's ALSA sink
+ * then takes the nearest map for 8 channels, 5.1 (CAESinkALSA::SelectALSAChannelMap(): a map with
+ * a speaker more than asked costs more than one without), and the back centre speaker of the
+ * receiver plays nothing; the back centre of the track is heard from the two surround speakers.
+ *
+ * Here the back centre is kept where the receiver declares the speaker: the track goes out in its
+ * own layout (6.1 in 7 channels, 6.0 in 6), which the ALSA sink gives the allocation with RC
+ * (its side speakers taken as the RL and RR of CTA-861, as for 5.1: GetAlternateLayoutForm()).
+ *
+ * Only then:
+ * - the track has a back centre beside one pair of surrounds (6.1, 6.0). A back centre with no
+ *   surrounds (3/1: FL FR FC BC, with or without LFE) is the one surround channel of the mix,
+ *   meant for both surround speakers, and stays as it goes today; a track with both side and back
+ *   pairs and a back centre (9 or more channels) stays too: no allocation of CTA-861 carries it;
+ * - "Number of channels" has speakers both at the sides and at the back (7.0 or 7.1): the user
+ *   has speakers behind; with 5.1 or less set, the track is mixed down as set;
+ * - the output declares the speaker (CAEDeviceInfo::m_channels: the speakers of its ELD that the
+ *   channel maps of the driver can carry);
+ * - the track then needs no more channels than the setting may send (limited to what the
+ *   display takes: CActiveAE::LimitChannelsToDisplay()).
+ */
+namespace AE::PCM
+{
+
+//! What SpeakersForBackCentre() decided, for the log
+enum class BackCentre
+{
+  NOT_THE_CASE, //!< the track has no back centre beside one pair of surrounds
+  KEPT, //!< sent to the back centre speaker of the output
+  NO_SPEAKER, //!< the output declares no back centre speaker: mixed into the back speakers
+  NOT_SET, //!< "Number of channels" has no speakers both at the sides and at the back
+  TOO_MANY, //!< with its back centre the track would need more channels than may go out
+};
+
+/*!
+ * \brief The speakers that a track is resolved to (CAEChannelInfo::ResolveChannels())
+ * \param track the channels of the track
+ * \param speakers the speakers of "Number of channels" as the engine uses them (limited to what
+ *        the display takes)
+ * \param wanted the speakers of "Number of channels" as the user set it
+ * \param output the speakers that the output declares (CAEDeviceInfo::m_channels)
+ * \param why set to what was decided
+ * \return the wanted speakers with the back centre, where it is kept; else the speakers
+ */
+inline CAEChannelInfo SpeakersForBackCentre(const CAEChannelInfo& track,
+                                            const CAEChannelInfo& speakers,
+                                            const CAEChannelInfo& wanted,
+                                            const CAEChannelInfo& output,
+                                            BackCentre& why)
+{
+  why = BackCentre::NOT_THE_CASE;
+  const bool sides = track.HasChannel(AE_CH_SL) && track.HasChannel(AE_CH_SR);
+  const bool backs = track.HasChannel(AE_CH_BL) && track.HasChannel(AE_CH_BR);
+  if (!track.HasChannel(AE_CH_BC) || sides == backs || speakers.HasChannel(AE_CH_BC))
+    return speakers;
+
+  if (!output.HasChannel(AE_CH_BC))
+  {
+    why = BackCentre::NO_SPEAKER;
+    return speakers;
+  }
+  if (!(wanted.HasChannel(AE_CH_SL) && wanted.HasChannel(AE_CH_SR) && wanted.HasChannel(AE_CH_BL) &&
+        wanted.HasChannel(AE_CH_BR)))
+  {
+    why = BackCentre::NOT_SET;
+    return speakers;
+  }
+
+  CAEChannelInfo withCentre(wanted);
+  withCentre += AE_CH_BC;
+  CAEChannelInfo resolved(track);
+  resolved.ResolveChannels(withCentre);
+  if (resolved.Count() > speakers.Count() || resolved.Count() > 8)
+  {
+    why = BackCentre::TOO_MANY;
+    return speakers;
+  }
+  why = BackCentre::KEPT;
+  return withCentre;
+}
+
+//! For the log
+inline const char* BackCentreText(BackCentre why)
+{
+  switch (why)
+  {
+    case BackCentre::KEPT:
+      return "goes to the back centre speaker that the output declares";
+    case BackCentre::NO_SPEAKER:
+      return "is mixed into the back speakers: the output declares no back centre speaker";
+    case BackCentre::NOT_SET:
+      return "is mixed into the surround speakers: \"Number of channels\" is not 7.0 or 7.1";
+    case BackCentre::TOO_MANY:
+      return "is mixed into the back speakers: with it the track would need more channels than "
+             "go out";
+    case BackCentre::NOT_THE_CASE:
+    default:
+      return "";
+  }
+}
+
+} // namespace AE::PCM
