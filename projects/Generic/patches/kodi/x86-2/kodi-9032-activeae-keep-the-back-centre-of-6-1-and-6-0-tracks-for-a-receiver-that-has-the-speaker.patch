+CAEChannelInfo CActiveAESink::GetDeviceChannels(const std::string& device) const
+{
+  const AESinkDevice dev = CAESinkFactory::ParseDevice(device);
+  const auto sinks = SinkInfo();
+
+  for (const auto& sink : *sinks)
+  {
+    if (sink.m_sinkName != dev.driver)
+      continue;
+
+    for (const auto& info : sink.m_deviceInfoList)
+    {
+      if (info.m_deviceName == dev.name)
+        return info.m_channels;
+    }
+  }
+  return {};
+}
