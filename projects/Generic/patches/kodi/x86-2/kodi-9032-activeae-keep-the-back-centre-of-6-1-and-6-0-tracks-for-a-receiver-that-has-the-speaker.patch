+        SayBackCentre(backCentre, track, format.m_channelLayout, settings.device);
       }
     }
     // don't change from multi to stereo in AUTO mode
@@ -2537,6 +2547,26 @@ void CActiveAE::ApplySettingsToFormat(AEAudioFormat& format,
   }
 }
 
+void CActiveAE::SayBackCentre(AE::PCM::BackCentre why,
+                              const CAEChannelInfo& track,
+                              const CAEChannelInfo& sent,
+                              const std::string& device)
+{
+  const std::string told = why == AE::PCM::BackCentre::NOT_THE_CASE
+                               ? std::string()
+                               : device + '|' + std::string(track) + '|' + std::string(sent) + '|' +
+                                     std::to_string(static_cast<int>(why));
+  if (told == m_backCentreTold)
+    return;
+  m_backCentreTold = told;
+  if (!told.empty())
+    CLog::Log(LOGINFO,
+              "ActiveAE - the back centre of a track in {} channels ({}) {} ('{}'): it goes out in "
+              "{} channels ({})",
+              track.Count(), std::string(track), AE::PCM::BackCentreText(why), device, sent.Count(),
+              std::string(sent));
+}
