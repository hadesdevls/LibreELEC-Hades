new file mode 100644
index 0000000..1359b2e
--- /dev/null
+++ b/xbmc/cores/AudioEngine/Utils/test/TestAEBackCentre.cpp
@@ -0,0 +1,209 @@
+/*
+ *  Copyright (C) 2026 Hades
+ *  This file is part of LibreELEC Hades. It is not in Kodi as Team Kodi publishes it.
+ *
+ *  SPDX-License-Identifier: GPL-2.0-or-later
+ *  See LICENSES/README.md for more information.
+ */
+
+#include "cores/AudioEngine/Utils/AEBackCentre.h"
+
+#include <initializer_list>
+
+#include <gtest/gtest.h>
+
+using namespace AE::PCM;
+
+namespace
+{
+
+CAEChannelInfo Layout(std::initializer_list<AEChannel> channels)
+{
+  CAEChannelInfo info;
+  for (AEChannel c : channels)
+    info += c;
+  return info;
+}
+
+CAEChannelInfo Std(AEStdChLayout layout)
+{
+  CAEChannelInfo info;
+  info = layout;
+  return info;
+}
+
+bool SameSpeakers(const CAEChannelInfo& a, const CAEChannelInfo& b)
+{
+  return a.Count() == b.Count() && a.ContainsChannels(b) && b.ContainsChannels(a);
+}
+
+// What the engine sends: the track resolved to the speakers that SpeakersForBackCentre() gives
+CAEChannelInfo Sent(const CAEChannelInfo& track,
+                    const CAEChannelInfo& speakers,
+                    const CAEChannelInfo& wanted,
+                    const CAEChannelInfo& output,
+                    BackCentre& why)
+{
+  CAEChannelInfo sent(track);
+  sent.ResolveChannels(SpeakersForBackCentre(track, speakers, wanted, output, why));
+  return sent;
+}
+
+// The tracks, as FFmpeg's layouts name their channels
+const CAEChannelInfo track61 =
+    Layout({AE_CH_FL, AE_CH_FR, AE_CH_FC, AE_CH_LFE, AE_CH_BC, AE_CH_SL, AE_CH_SR});
+const CAEChannelInfo track61back =
+    Layout({AE_CH_FL, AE_CH_FR, AE_CH_FC, AE_CH_LFE, AE_CH_BL, AE_CH_BR, AE_CH_BC});
+const CAEChannelInfo track60 = Layout({AE_CH_FL, AE_CH_FR, AE_CH_FC, AE_CH_BC, AE_CH_SL, AE_CH_SR});
+const CAEChannelInfo track40 = Layout({AE_CH_FL, AE_CH_FR, AE_CH_FC, AE_CH_BC});
+const CAEChannelInfo track41 = Layout({AE_CH_FL, AE_CH_FR, AE_CH_FC, AE_CH_LFE, AE_CH_BC});
+const CAEChannelInfo track51 =
+    Layout({AE_CH_FL, AE_CH_FR, AE_CH_FC, AE_CH_LFE, AE_CH_SL, AE_CH_SR});
+const CAEChannelInfo track71 = Std(AE_CH_LAYOUT_7_1);
+// a back centre beside both pairs (FFmpeg's octagonal)
+const CAEChannelInfo track80 =
+    Layout({AE_CH_FL, AE_CH_FR, AE_CH_FC, AE_CH_BL, AE_CH_BC, AE_CH_BR, AE_CH_SL, AE_CH_SR});
+
+// The speakers that outputs declare (CAEDeviceInfo::m_channels): a receiver set up for 6.1 (ELD
+// speakers FL/FR, LFE, FC, RL/RR, RC), one for 7.1 (RLC/RRC instead of RC), and one with both
+const CAEChannelInfo receiver61 =
+    Layout({AE_CH_FL, AE_CH_FR, AE_CH_LFE, AE_CH_FC, AE_CH_BL, AE_CH_BR, AE_CH_BC});
+const CAEChannelInfo receiver71 =
+    Layout({AE_CH_FL, AE_CH_FR, AE_CH_LFE, AE_CH_FC, AE_CH_BL, AE_CH_BR, AE_CH_BLOC, AE_CH_BROC});
+const CAEChannelInfo receiver91 = Layout({AE_CH_FL, AE_CH_FR, AE_CH_LFE, AE_CH_FC, AE_CH_BL,
+                                          AE_CH_BR, AE_CH_BC, AE_CH_BLOC, AE_CH_BROC});
+
+// The channel maps that the HDMI codec of the kernel makes of CTA-861 allocations
+// (sound/hda/core/hdmi_chmap.c), named as CAESinkALSA::ALSAChannelToAEChannel() names them (RL and
+// RR are AE_CH_BL and AE_CH_BR, RC is AE_CH_BC)
+const CAEChannelInfo cta0x0f =
+    Layout({AE_CH_FL, AE_CH_FR, AE_CH_BL, AE_CH_BR, AE_CH_FC, AE_CH_LFE, AE_CH_BC});
+const CAEChannelInfo cta0x0e = Layout({AE_CH_FL, AE_CH_FR, AE_CH_BL, AE_CH_BR, AE_CH_FC, AE_CH_BC});
+
+// As the ALSA sink matches a layout to a map of the kernel: side speakers as CTA-861's RL and RR
+// when there are no back ones (CAESinkALSA::GetAlternateLayoutForm())
+CAEChannelInfo AsCta(const CAEChannelInfo& layout)
+{
+  CAEChannelInfo c(layout);
+  if (!c.HasChannel(AE_CH_BL) && c.HasChannel(AE_CH_SL))
+  {
+    c.ReplaceChannel(AE_CH_SL, AE_CH_BL);
+    c.ReplaceChannel(AE_CH_SR, AE_CH_BR);
+  }
+  return c;
+}
+
+} // namespace
+
+TEST(TestAEBackCentre, SixOneKeptForAReceiverWithABackCentre)
+{
+  for (AEStdChLayout set : {AE_CH_LAYOUT_7_1, AE_CH_LAYOUT_7_0})
+  {
+    for (const CAEChannelInfo* output : {&receiver61, &receiver91})
+    {
+      BackCentre why;
+      const CAEChannelInfo sent = Sent(track61, Std(set), Std(set), *output, why);
+      EXPECT_EQ(why, BackCentre::KEPT);
+      if (set == AE_CH_LAYOUT_7_1)
+      {
+        // 7 channels, the track's own, which the kernel carries as allocation 0x0f
+        EXPECT_TRUE(SameSpeakers(sent, track61)) << std::string(sent);
+        EXPECT_TRUE(SameSpeakers(AsCta(sent), cta0x0f)) << std::string(sent);
+      }
+      else
+      {
+        // 7.0 has no LFE: as today, without it, and with the back centre (allocation 0x0e)
+        EXPECT_TRUE(SameSpeakers(sent, track60)) << std::string(sent);
+        EXPECT_TRUE(SameSpeakers(AsCta(sent), cta0x0e)) << std::string(sent);
+      }
+    }
+  }
+  // the back centre beside back speakers (FFmpeg's 6.1(back)): 0x0f as it is
+  BackCentre why;
+  const CAEChannelInfo sent =
+      Sent(track61back, Std(AE_CH_LAYOUT_7_1), Std(AE_CH_LAYOUT_7_1), receiver61, why);
+  EXPECT_EQ(why, BackCentre::KEPT);
+  EXPECT_TRUE(SameSpeakers(sent, cta0x0f)) << std::string(sent);
+}
+
+TEST(TestAEBackCentre, SixZeroKept)
+{
+  BackCentre why;
+  const CAEChannelInfo sent =
+      Sent(track60, Std(AE_CH_LAYOUT_7_1), Std(AE_CH_LAYOUT_7_1), receiver61, why);
+  EXPECT_EQ(why, BackCentre::KEPT);
+  EXPECT_TRUE(SameSpeakers(sent, track60)) << std::string(sent);
+  EXPECT_TRUE(SameSpeakers(AsCta(sent), cta0x0e)) << std::string(sent);
+}
+
+TEST(TestAEBackCentre, AsTodayWithoutABackCentreSpeaker)
+{
+  // a 7.1 receiver: the back centre mixed into the back speakers, 8 channels, as Kodi does
+  BackCentre why;
+  const CAEChannelInfo sent =
+      Sent(track61, Std(AE_CH_LAYOUT_7_1), Std(AE_CH_LAYOUT_7_1), receiver71, why);
+  EXPECT_EQ(why, BackCentre::NO_SPEAKER);
+  CAEChannelInfo today(track61);
+  today.ResolveChannels(Std(AE_CH_LAYOUT_7_1));
+  EXPECT_TRUE(today == sent) << std::string(sent);
+  EXPECT_EQ(sent.Count(), 8u);
+  EXPECT_FALSE(sent.HasChannel(AE_CH_BC));
+}
+
+TEST(TestAEBackCentre, AsTodayWithFiveOneOrLessSet)
+{
+  for (AEStdChLayout set : {AE_CH_LAYOUT_5_1, AE_CH_LAYOUT_5_0, AE_CH_LAYOUT_2_0})
+  {
+    BackCentre why;
+    const CAEChannelInfo sent = Sent(track61, Std(set), Std(set), receiver61, why);
+    EXPECT_EQ(why, BackCentre::NOT_SET);
+    CAEChannelInfo today(track61);
+    today.ResolveChannels(Std(set));
+    EXPECT_TRUE(today == sent) << std::string(sent);
+  }
+}
+
+TEST(TestAEBackCentre, AsTodayForTracksWhoseBackCentreIsNotBesideSurrounds)
+{
+  // 3/1, 3/1 with LFE: the back centre is the one surround channel; a back centre beside both
+  // pairs; and tracks without one
+  for (const CAEChannelInfo* track : {&track40, &track41, &track80, &track51, &track71})
+  {
+    BackCentre why;
+    const CAEChannelInfo sent =
+        Sent(*track, Std(AE_CH_LAYOUT_7_1), Std(AE_CH_LAYOUT_7_1), receiver61, why);
+    EXPECT_EQ(why, BackCentre::NOT_THE_CASE) << std::string(*track);
+    CAEChannelInfo today(*track);
+    today.ResolveChannels(Std(AE_CH_LAYOUT_7_1));
+    EXPECT_TRUE(today == sent) << std::string(*track);
+  }
+}
+
+TEST(TestAEBackCentre, WithinTheChannelsThatGoOut)
+{
+  // "Number of channels" 7.1, limited to a display that takes 7 channels (7.0): 6.1 fits, LFE
+  // included, as the user set speakers with an LFE
+  BackCentre why;
+  CAEChannelInfo sent =
+      Sent(track61, Std(AE_CH_LAYOUT_7_0), Std(AE_CH_LAYOUT_7_1), receiver61, why);
+  EXPECT_EQ(why, BackCentre::KEPT);
+  EXPECT_TRUE(SameSpeakers(sent, track61)) << std::string(sent);
+  // limited to 6 channels (5.1): 6.1 does not fit, the track goes out as today in 5.1
+  sent = Sent(track61, Std(AE_CH_LAYOUT_5_1), Std(AE_CH_LAYOUT_7_1), receiver61, why);
+  EXPECT_EQ(why, BackCentre::TOO_MANY);
+  CAEChannelInfo today(track61);
+  today.ResolveChannels(Std(AE_CH_LAYOUT_5_1));
+  EXPECT_TRUE(today == sent) << std::string(sent);
+  // but 6.0 fits in 6
+  sent = Sent(track60, Std(AE_CH_LAYOUT_5_1), Std(AE_CH_LAYOUT_7_1), receiver61, why);
+  EXPECT_EQ(why, BackCentre::KEPT);
+  EXPECT_TRUE(SameSpeakers(sent, track60)) << std::string(sent);
+}
+
+TEST(TestAEBackCentre, TextForEachDecision)
+{
+  EXPECT_STREQ(BackCentreText(BackCentre::NOT_THE_CASE), "");
+  for (BackCentre why :
+       {BackCentre::KEPT, BackCentre::NO_SPEAKER, BackCentre::NOT_SET, BackCentre::TOO_MANY})
+    EXPECT_STRNE(BackCentreText(why), "");
+}
