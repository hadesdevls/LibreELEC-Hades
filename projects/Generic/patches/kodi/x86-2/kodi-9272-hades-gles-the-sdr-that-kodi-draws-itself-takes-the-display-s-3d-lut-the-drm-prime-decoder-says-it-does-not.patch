+// Hades: the 3D LUT of the display for the pictures that this renderer draws itself (windowing/gbm/DisplayLut.h,
+// VideoShaders/Lut3dGLES.h)
+void CLinuxRendererGLES::Lut3dTake()
+{
+  m_lut3dTaken = false;
+  m_lut3dRefused = false;
+  auto* window =
+      dynamic_cast<KODI::WINDOWING::GBM::CWinSystemGbmGLESContext*>(CServiceBroker::GetWinSystem());
+  // a picture drawn elsewhere than into the window (a capture: a screenshot, a measure of the picture) takes no LUT,
+  // as the bridges draw none there (they draw into the window alone), and nothing is said of it
+  GLint target = 0;
+  glGetIntegerv(GL_DRAW_FRAMEBUFFER_BINDING, &target);
+  if (!window || target != 0)
+  {
+    m_lut3d.SetSignal(!m_fullRange, false);
+    return;
+  }
+  m_lut3dTaken = true;
+  // what the picture goes out as: HDR passed through to the display, which maps it (none); anything else that this
+  // renderer draws goes out as SDR (an SDR video, HDR tone mapped by Kodi's shaders, HLG drawn as SDR), in the
+  // primaries that the shaders draw it in (BT.709, or the BT.2020 or wider container of an SDR output)
+  namespace LUT = KODI::WINDOWING::GBM::DISPLAY_LUT;
+  LUT::Gamut gamut = LUT::GAMUT_BT709;
+  switch (DrawnPrimaries())
+  {
+    case AVCOL_PRI_BT2020:
+      gamut = LUT::GAMUT_BT2020;
+      break;
+    case AVCOL_PRI_SMPTE432:
+      gamut = LUT::GAMUT_P3_D65;
+      break;
+    default:
+      break;
+  }
+  const dvbridge_lut* lut =
+      window->LutFor(m_passthroughHDR ? LUT::Output::KODI_HDR : LUT::Output::KODI_SDR, gamut);
+  // (one that this GPU did not take is not tried again until another one is chosen: drawn without it, and said)
+  if (lut && lut == m_lut3dFailedOf && lut->pl.signature == m_lut3dFailedSig)
+  {
+    m_lut3dRefused = true;
+    lut = nullptr;
+  }
+  // its table on the GPU, once for each LUT
+  if (lut && !(m_lut3d.Valid() && lut == m_lut3dOf && lut->pl.signature == m_lut3dSig))
+  {
+    const auto start = std::chrono::steady_clock::now();
+    GLint maxSize = 0;
+    glGetIntegerv(GL_MAX_TEXTURE_SIZE, &maxSize);
+    dvbridge_lut_atlas atlas{};
+    char atlasWhy[256] = {};
+    std::string why;
+    if (!dvbridge_lut_atlas_make(lut, maxSize, &atlas, atlasWhy, sizeof(atlasWhy)))
+      why = atlasWhy;
+    else if (m_lut3d.Upload(atlas.rgb, atlas.width, atlas.height, why))
+    {
+      std::copy(std::begin(atlas.grid), std::end(atlas.grid), m_lut3d.m_grid);
+      std::copy(std::begin(atlas.in), std::end(atlas.in), m_lut3d.m_in);
+      std::copy(std::begin(atlas.shaper), std::end(atlas.shaper), m_lut3d.m_shaper);
+      std::copy(std::begin(atlas.out), std::end(atlas.out), m_lut3d.m_out);
+      m_lut3dOf = lut;
+      m_lut3dSig = lut->pl.signature;
+      CLog::Log(LOGINFO,
+                "3D LUT: the table of {} points a side on the GPU for Kodi's renderer in {:.0f} ms: {}x{} texels of "
+                "32-bit floats ({} MB), {} slices a row",
+                atlas.size,
+                std::chrono::duration<double, std::milli>(std::chrono::steady_clock::now() - start).count(),
+                atlas.width, atlas.height, m_lut3d.Bytes() >> 20, atlas.cols);
+    }
+    dvbridge_lut_atlas_free(&atlas);
+    if (!m_lut3d.Valid())
+    {
+      CLog::Log(LOGWARNING, "3D LUT: Kodi's renderer cannot apply it: {}; the pictures are drawn without it", why);
+      m_lut3dFailedOf = lut;
+      m_lut3dFailedSig = lut->pl.signature;
+      m_lut3dRefused = true;
+      lut = nullptr;
+    }
+  }
+  const bool want = lut != nullptr;
+  if (!want && m_lut3d.Valid())
+  {
+    m_lut3d.Release();
+    m_lut3dOf = nullptr;
+    m_lut3dSig = 0;
+  }
+  // the shaders made again with it or without it where it comes or goes (the setting, the LUT of another display, the
+  // video going out as HDR), the scaler of a second pass too: once, as for a change of the scaling method
+  if (want != m_lut3dShaders)
+  {
+    m_lut3dShaders = want;
+    m_reloadShaders = true;
+    m_scalingMethodGui = VS_SCALINGMETHOD_MAX;
+    CLog::Log(LOGDEBUG, "3D LUT: the shaders of Kodi's renderer are made again {} it", want ? "with" : "without");
+  }
+  m_lut3d.SetSignal(!m_fullRange, want);
+}
+
+void CLinuxRendererGLES::Lut3dDrawn()
+{
+  if (!m_lut3dTaken)
+    return;
+  auto* window =
+      dynamic_cast<KODI::WINDOWING::GBM::CWinSystemGbmGLESContext*>(CServiceBroker::GetWinSystem());
+  if (!window)
+    return;
+  // the shader that wrote the picture to the window: the scaler of a second pass, or the YUV shader of the picture
+  // or of its field
+  bool applied = false;
+  if (m_lut3dShaders && m_lut3d.Valid())
+  {
+    if (m_renderQuality == RQ_MULTIPASS)
+      applied = m_pVideoFilterShader && m_pVideoFilterShader->HasLut3d();
+    else
+    {
+      const BaseYUV2RGBGLSLShader* shader =
+          m_currentField == FIELD_FULL ? m_pYUVProgShader : m_pYUVBobShader;
+      applied = shader && shader->HasLut3d();
+    }
+  }
+  // (a LUT that the window system gave and that is not applied: this GPU did not take it)
+  bool failed = m_lut3dRefused;
+  if (m_lut3dShaders && !applied && !failed)
+  {
+    Lut3dShaderFailed("the shader that drew the picture");
+    failed = true;
+  }
+  window->LutDrawn(true, applied, failed);
+}
+
+const CLut3dGLES* CLinuxRendererGLES::Lut3dShaders() const
+{
+  return m_lut3dShaders && m_lut3d.Valid() ? &m_lut3d : nullptr;
+}
+
+void CLinuxRendererGLES::Lut3dShaderFailed(const char* which)
+{
+  // once for each LUT: drawn without it from the next picture on, until another one is chosen (Lut3dTake())
+  if (m_lut3dFailedOf == m_lut3dOf && m_lut3dFailedSig == m_lut3dSig)
+    return;
+  m_lut3dFailedOf = m_lut3dOf;
+  m_lut3dFailedSig = m_lut3dSig;
+  CLog::Log(LOGWARNING,
+            "3D LUT: {} could not be made with it on this GPU (the log of the shader is above): the pictures are "
+            "drawn without it",
+            which);
+}
 #endif
 
