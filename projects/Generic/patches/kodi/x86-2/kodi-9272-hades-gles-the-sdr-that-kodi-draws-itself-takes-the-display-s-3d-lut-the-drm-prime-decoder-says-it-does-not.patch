diff --git a/addons/resource.language.en_gb/resources/strings.po b/addons/resource.language.en_gb/resources/strings.po
index 9cc641d..6941d7c 100644
--- a/addons/resource.language.en_gb/resources/strings.po
+++ b/addons/resource.language.en_gb/resources/strings.po
@@ -28696,7 +28696,7 @@ msgstr ""
 #. Hades: help of setting "videoscreen.hadeslut3d"; translated in Estuary (#54802)
 #: system/settings/settings.xml
 msgctxt "#62802"
-msgid "A 3D LUT made by a calibration program (Calman, ColourSpace, DisplayCAL, madVR) for this display corrects its colours: Hades applies it as the last step of the picture that it maps to the display itself. A LUT for SDR goes on HDR, HDR10+, HLG and Dolby Vision videos converted to SDR (a projector, a display without HDR, \"Play HDR videos as SDR\") and on SDR videos drawn with an upscaler; a LUT for HDR goes on HDR10 and Dolby Vision adapted to the display (\"HDR10 and HDR10+ adapted to the display\", \"Adapt Dolby Vision to my display (projectors)\") and on Dolby Vision Low-Latency. It is never applied to Dolby Vision that the TV maps itself, to HDR that the display maps itself (its own tone mapping comes after the LUT), nor to SDR videos that Kodi draws itself: the player information says so. The menus and subtitles are not corrected. Each display keeps its own LUTs. A LUT that is wrong for the display spoils the picture: off by default. Applies from the next picture."
+msgid "A 3D LUT made by a calibration program (Calman, ColourSpace, DisplayCAL, madVR) for this display corrects its colours: Hades applies it as the last step of the colour of the video. A LUT for SDR goes on SDR videos and on HDR, HDR10+, HLG and Dolby Vision videos converted to SDR (a projector, a display without HDR, \"Play HDR videos as SDR\"); a LUT for HDR goes on HDR10 and Dolby Vision adapted to the display (\"HDR10 and HDR10+ adapted to the display\", \"Adapt Dolby Vision to my display (projectors)\") and on Dolby Vision Low-Latency. It is never applied to Dolby Vision that the TV maps itself, nor to HDR that the display maps itself (its own tone mapping comes after the LUT): the player information says so. The menus and subtitles are not corrected, as with Kodi's own colour management on a desktop. Each display keeps its own LUTs. A LUT that is wrong for the display spoils the picture: off by default. Applies from the next picture."
 msgstr ""
 
 #. Hades: label of setting "videoscreen.hadeslut3dsdr"; translated in Estuary (#54803)
@@ -28780,7 +28780,7 @@ msgstr ""
 #. Hades: the 3D LUT in the player information: why it is not applied; translated in Estuary (#54816)
 #: system/settings/settings.xml
 msgctxt "#62816"
-msgid "not applied: drawn by Kodi"
+msgid "not applied: DRM PRIME decoder"
 msgstr ""
 
 #. Hades: the 3D LUT in the player information: why it is not applied; translated in Estuary (#54817)
@@ -28800,3 +28800,9 @@ msgstr ""
 msgctxt "#62819"
 msgid "not applied: fails on this GPU"
 msgstr ""
+
+#. Hades: the 3D LUT: the question whether to turn the DRM PRIME decoder off (videoplayer.useprimedecoder), whose videos do not take it; translated in Estuary (#54820)
+#: system/settings/settings.xml
+msgctxt "#62820"
+msgid "The 3D LUT for SDR is not applied to the videos of the DRM PRIME decoder: their pictures go on a plane of the display, or through a renderer of their own, without Kodi's video shaders, which apply it. Turn the DRM PRIME decoder off, so that the LUT is applied from the next video?"
+msgstr ""
