From cff69708b4465caf1f313ad70c59613e243221a2 Mon Sep 17 00:00:00 2001
From: Hades <15710513+hadesdevls@users.noreply.github.com>
Date: Wed, 18 Nov 2026 04:19:13 +0000
Subject: [PATCH] windowing/gbm: say why a display that takes 3D gets no 3D
 mode on a DisplayPort output

A display that takes 3D on a DisplayPort output gets HDMI 3D modes only where
a passive dual-mode (DP++) adaptor carries HDMI to it: amdgpu lists them only
then (amdgpu_dm_stereo_layout(), stereo_allowed), and nvidia-drm only where it
drives the port as HDMI. Through an active DisplayPort to HDMI converter
(issue 26 of LibreELEC Hades: an A10-8730B, an LG passive 3D TV) kodi.log said
"the display has no 3D mode for it at this refresh rate", and the 3D video
went out as the two halves side by side at 3840x2160, which reads as a fault
of the display.

Where the display says it takes 3D and the output is a DisplayPort one, the
reason now comes from what the driver says is behind it (DVBRIDGE_DUAL_MODE of
amdgpu, which the kernel now gives every DisplayPort connector, linux-9860;
NV_DUAL_MODE_TMDS of nvidia-drm): no passive adaptor (an active converter or a
DisplayPort display), an adaptor that does not say HDMI, or a port that the
NVIDIA card drives as DisplayPort. kodi.log says it when the display is read
and when a 3D video finds no 3D mode (DV_DUAL_MODE::WhyNoStereo()). Through an
adaptor that says HDMI, or where nothing is known, the reason of before stands.
Nothing that goes out changes.
---
 xbmc/windowing/gbm/WinSystemGbm.cpp | 27 +++++++++++++++++++++
 xbmc/windowing/gbm/WinSystemGbm.h   |  3 +++
 xbmc/windowing/gbm/drm/DVDualMode.h | 37 +++++++++++++++++++++++++++++
 3 files changed, 67 insertions(+)

diff --git a/xbmc/windowing/gbm/WinSystemGbm.cpp b/xbmc/windowing/gbm/WinSystemGbm.cpp
index 1746726..e6af37f 100644
--- a/xbmc/windowing/gbm/WinSystemGbm.cpp
+++ b/xbmc/windowing/gbm/WinSystemGbm.cpp
@@ -478,6 +478,28 @@ void CWinSystemGbm::MakeResolutions(const RESOLUTION_INFO* desktop)
   }
   CLog::Log(LOGINFO, "3D output: the display {} that it takes stereoscopic 3D",
             stereoDisplay ? "says" : "does not say");
+  // Hades: ... and where it does, on a DisplayPort output, what is behind it (DV_DUAL_MODE)
+  if (const char* why = stereoDisplay ? StereoAdaptorReason() : nullptr)
+    CLog::Log(LOGINFO, "3D output: no 3D mode on {}: {}", m_DRM->GetConnector()->GetName(), why);
+}
+
+// Hades: why a display that takes 3D gets no 3D mode on this output, where it is a DisplayPort one
+// and what is behind it is the reason (DV_DUAL_MODE::WhyNoStereo()); nothing otherwise
+const char* CWinSystemGbm::StereoAdaptorReason() const
+{
+  CDRMConnector* connector = m_DRM ? m_DRM->GetConnector() : nullptr;
+  if (!connector || connector->GetType() != "DP")
+    return nullptr;
+  {
+    std::unique_lock lock(m_infoLock);
+    if (!m_stereoDisplay)
+      return nullptr;
+  }
+  const std::optional<uint64_t> nvidia =
+      connector->SupportsProperty(NVIDIA_DUAL_MODE::PROPERTY)
+          ? connector->ReadPropertyValue(NVIDIA_DUAL_MODE::PROPERTY)
+          : std::nullopt;
+  return DV_DUAL_MODE::WhyNoStereo(COutputHandover::DualModeVerdict(*connector), nvidia);
 }
 
 bool CWinSystemGbm::ResizeWindow(int newWidth, int newHeight, int newLeft, int newTop)
@@ -869,9 +891,14 @@ bool CWinSystemGbm::GetStereoOutputMode(RESOLUTION res,
   {
     choice = STEREO::Choose(offers, base, ArrangementOf(mode), allowed);
     if (choice.layout == STEREO::Layout::NONE)
+    {
       reason = allowed.framePacking && allowed.halfModes && allowed.infoFrame
                    ? "the display has no 3D mode for it at this refresh rate"
                    : "the driver did not take what the display has for it";
+      // Hades: ... or, on a DisplayPort output, what is behind it (issue 26: an active converter)
+      if (const char* adaptor = StereoAdaptorReason())
+        reason = adaptor;
+    }
     else
       reason = "its modes cannot be read";
   }
diff --git a/xbmc/windowing/gbm/WinSystemGbm.h b/xbmc/windowing/gbm/WinSystemGbm.h
index b5896d3..58fc570 100644
--- a/xbmc/windowing/gbm/WinSystemGbm.h
+++ b/xbmc/windowing/gbm/WinSystemGbm.h
@@ -889,6 +889,9 @@ private:
                        STEREO::Allowed& allowed,
                        const char*& reason,
                        bool drawing) const;
+  //! Hades: why a display that takes 3D gets no 3D mode on this DisplayPort output, by what is
+  //! behind it (DV_DUAL_MODE::WhyNoStereo()); nothing where that is not the reason
+  const char* StereoAdaptorReason() const;
   //! After the commit of a mode: whether the output is in the 3D mode that was asked for, or
   //! has left the one it was in
   void CheckStereoOutput();
diff --git a/xbmc/windowing/gbm/drm/DVDualMode.h b/xbmc/windowing/gbm/drm/DVDualMode.h
index 257c40f..4c09724 100644
--- a/xbmc/windowing/gbm/drm/DVDualMode.h
+++ b/xbmc/windowing/gbm/drm/DVDualMode.h
@@ -105,6 +105,43 @@ inline bool KernelOffered(bool converterApplies, bool converterOffered, const Of
   return !dual.applies || dual.offered;
 }
 
+/*!
+ * \brief Why a display that takes 3D gets no 3D mode on a DisplayPort connector: what is behind it,
+ *        as the driver says (amdgpu: DVBRIDGE_DUAL_MODE, on every DisplayPort connector since
+ *        linux-9860; nvidia-drm: NV_DUAL_MODE_TMDS). The drivers list HDMI 3D modes on such a
+ *        connector only where a passive dual-mode (DP++) adaptor carries HDMI to the display
+ *        (amdgpu_dm_stereo_layout()). Nothing where such an adaptor is there, or nothing is known:
+ *        the reason of before stands ("no 3D mode for it at this refresh rate").
+ * \param amdgpu DVBRIDGE_DUAL_MODE, nothing where the connector has no such property
+ * \param nvidiaTmds NV_DUAL_MODE_TMDS, nothing where the connector has no such property
+ */
+inline const char* WhyNoStereo(const std::optional<uint64_t>& amdgpu,
+                               const std::optional<uint64_t>& nvidiaTmds)
+{
+  if (amdgpu)
+  {
+    if (*amdgpu == static_cast<uint64_t>(Adaptor::HDMI))
+      return nullptr;
+    if (*amdgpu == static_cast<uint64_t>(Adaptor::OTHER))
+      return "the display takes 3D, but the passive dual-mode adaptor on this DisplayPort output "
+             "does not identify itself as an HDMI one (or the display takes DVI only): the "
+             "graphics card sends HDMI 3D only through an adaptor that says HDMI";
+    // (none, or a value this Kodi does not know)
+    return "the display takes 3D, but no passive dual-mode (DP++) adaptor is behind this "
+           "DisplayPort output: an active DisplayPort or USB-C to HDMI converter, or a DisplayPort "
+           "display, gets no HDMI 3D from this graphics card; a passive DP++ adaptor that says "
+           "HDMI, or an HDMI port, carries it";
+  }
+  if (nvidiaTmds)
+    return *nvidiaTmds == 1
+               ? nullptr
+               : "the display takes 3D, but this DisplayPort output of the NVIDIA card drives it "
+                 "as DisplayPort (an active converter, or a DisplayPort display): HDMI 3D goes "
+                 "out only where the card drives it as HDMI, a dual-mode port with a passive "
+                 "adaptor";
+  return nullptr;
+}
+
 //! What kodi.log says of the way in, for the status of native output
 inline std::string_view Way(const std::optional<uint64_t>& value)
 {
-- 
