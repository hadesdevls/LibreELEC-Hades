+std::optional<bool> COwnScanout::MemoryIsBgra(uint32_t format)
+{
+  switch (format)
+  {
+    case DRM_FORMAT_ARGB8888:
+    case DRM_FORMAT_XRGB8888:
+      return true;
+    case DRM_FORMAT_ABGR8888:
+    case DRM_FORMAT_XBGR8888:
+      return false;
+    default:
+      return std::nullopt;
+  }
+}
+
+bool COwnScanout::CopyRowsFlipped(const uint8_t* rows,
+                                  int width,
+                                  int height,
+                                  bool rowsBgra,
+                                  uint32_t format,
+                                  uint8_t* target,
+                                  uint32_t pitch)
+{
+  const std::optional<bool> bgra = MemoryIsBgra(format);
+  const size_t rowBytes = static_cast<size_t>(width) * 4;
+  if (!bgra || !rows || !target || width <= 0 || height <= 0 || pitch < rowBytes)
+    return false;
+  const bool swap = *bgra != rowsBgra;
+  std::vector<uint8_t> row(swap ? rowBytes : 0);
+  for (int r = 0; r < height; ++r)
+  {
+    // (row 0 of what glReadPixels() gives is the bottom row of the picture)
+    const uint8_t* from = rows + static_cast<size_t>(r) * rowBytes;
+    uint8_t* to = target + static_cast<size_t>(height - 1 - r) * pitch;
+    if (!swap)
+    {
+      std::memcpy(to, from, rowBytes);
+      continue;
+    }
+    // (red and blue exchanged in a row of its own, then written whole: the buffer may be memory
+    // of the card, written through a write-combined mapping)
+    for (size_t i = 0; i < rowBytes; i += 4)
+    {
+      row[i] = from[i + 2];
+      row[i + 1] = from[i + 1];
+      row[i + 2] = from[i];
+      row[i + 3] = from[i + 3];
+    }
+    std::memcpy(to, row.data(), rowBytes);
+  }
+  return true;
+}
