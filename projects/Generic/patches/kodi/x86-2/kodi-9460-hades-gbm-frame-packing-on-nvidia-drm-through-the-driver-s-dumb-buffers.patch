+// (Hades) A dumb buffer of the driver, of 32 bits a pixel, as a buffer of GBM: made on the DRM file
+// of the GBM device, given a dma-buf, its handle closed at once (the dma-buf holds the memory:
+// drm_gem_prime_export() takes a reference of the object), and imported into GBM by the dma-buf, so
+// that the buffer of GBM holds the only handle of it on that file and gbm_bo_destroy() closes nothing
+// else. Its pitch is the driver's (DRM_IOCTL_MODE_CREATE_DUMB).
+gbm_bo* MakeDumb(gbm_device* device,
+                 int drmFd,
+                 int width,
+                 int height,
+                 uint32_t format,
+                 uint32_t& pitch,
+                 std::string& failed)
+{
+  drm_mode_create_dumb create{};
+  create.width = static_cast<uint32_t>(width);
+  create.height = static_cast<uint32_t>(height);
+  create.bpp = 32;
+  if (drmIoctl(drmFd, DRM_IOCTL_MODE_CREATE_DUMB, &create) != 0)
+  {
+    failed = "the driver could not make a dumb buffer of " + std::to_string(width) + "x" +
+             std::to_string(height) + " (" + std::strerror(errno) + ")";
+    return nullptr;
+  }
+  int fd = -1;
+  const int exported = drmPrimeHandleToFD(drmFd, create.handle, DRM_CLOEXEC | DRM_RDWR, &fd);
+  const int exportError = errno;
+  drm_mode_destroy_dumb destroy{};
+  destroy.handle = create.handle;
+  drmIoctl(drmFd, DRM_IOCTL_MODE_DESTROY_DUMB, &destroy);
+  if (exported != 0 || fd < 0)
+  {
+    failed = std::string("the dumb buffer has no dma-buf (") + std::strerror(exportError) + ")";
+    return nullptr;
+  }
+
+  gbm_bo* bo = nullptr;
+#if defined(HAS_GBM_MODIFIERS)
+  gbm_import_fd_modifier_data data{};
+  data.width = create.width;
+  data.height = create.height;
+  data.format = format;
+  data.num_fds = 1;
+  data.fds[0] = fd;
+  data.strides[0] = static_cast<int>(create.pitch);
+  data.offsets[0] = 0;
+  data.modifier = DRM_FORMAT_MOD_LINEAR;
+  bo = gbm_bo_import(device, GBM_BO_IMPORT_FD_MODIFIER, &data,
+                     GBM_BO_USE_SCANOUT | GBM_BO_USE_RENDERING);
+#else
+  gbm_import_fd_data data{};
+  data.fd = fd;
+  data.width = create.width;
+  data.height = create.height;
+  data.stride = create.pitch;
+  data.format = format;
+  bo = gbm_bo_import(device, GBM_BO_IMPORT_FD, &data, GBM_BO_USE_SCANOUT | GBM_BO_USE_RENDERING);
+#endif
+  const int importError = errno;
+  // (GBM holds the buffer by its own handle now: the descriptor is not needed any more)
+  close(fd);
+  if (!bo)
+  {
+    failed =
+        std::string("GBM could not import the dumb buffer (") + std::strerror(importError) + ")";
+    return nullptr;
+  }
+  pitch = create.pitch;
+  return bo;
+}
+
+// (Hades) The buffer of GBM made of a dumb buffer, mapped for the processor to write into
+uint8_t* MapDumb(int drmFd, gbm_bo* bo, size_t size, std::string& failed)
+{
+  drm_mode_map_dumb map{};
+  map.handle = gbm_bo_get_handle(bo).u32;
+  if (drmIoctl(drmFd, DRM_IOCTL_MODE_MAP_DUMB, &map) != 0)
+  {
+    failed = std::string("the dumb buffer cannot be mapped (") + std::strerror(errno) + ")";
+    return nullptr;
+  }
+  void* address = mmap(nullptr, size, PROT_READ | PROT_WRITE, MAP_SHARED, drmFd,
+                       static_cast<off_t>(map.offset));
+  if (address == MAP_FAILED)
+  {
+    failed = std::string("the dumb buffer cannot be mapped (") + std::strerror(errno) + ")";
+    return nullptr;
+  }
+  return static_cast<uint8_t*>(address);
+}
+
+bool HasGLExtension(const char* name)
+{
+  const char* list = reinterpret_cast<const char*>(glGetString(GL_EXTENSIONS));
+  if (!list)
+    return false;
+  const size_t length = std::strlen(name);
+  for (const char* at = std::strstr(list, name); at; at = std::strstr(at + length, name))
+    if ((at == list || at[-1] == ' ') && (at[length] == ' ' || at[length] == '\0'))
+      return true;
+  return false;
+}
