                                                 static_cast<unsigned int>(modifiers.size()),
                                                 GBM_BO_USE_SCANOUT | GBM_BO_USE_RENDERING);
@@ -637,14 +819,49 @@ std::shared_ptr<COwnScanout> COwnScanout::Create(gbm_device* device,
       own->m_modifier = dmabuf.modifier;
 
     // (EGL keeps what it needs of the buffer: the descriptor is closed after the import)
-    buffer.image = ImportDmaBuf(display, dmabuf, failed);
