--- a/addons/resource.language.en_gb/resources/strings.po
+++ b/addons/resource.language.en_gb/resources/strings.po
@@ -28210,7 +28210,7 @@ msgstr ""
 #. Hades: help of setting "videoscreen.hadessdrhdrgamut"; translated in Estuary (#54471)
 #: system/settings/settings.xml
 msgctxt "#62471"
-msgid "When an HDR video is converted to SDR (Dolby Vision, HDR10, HDR10+ or HLG, on a display without HDR or with \"Play HDR videos as SDR\"), the SDR picture goes out in the ordinary colours of BT.709 (the default), as every SDR picture. Some projectors and TVs take SDR in a wider gamut, and then show more of the colours of the video: choose BT.2020 or DCI-P3 if your display is set to take SDR in it. The video is mapped into that gamut, the display is told so, and the menus and subtitles are converted to match. Only on a display whose EDID says it takes that gamut, and where the graphics driver can tell it (not every driver offers DCI-P3); elsewhere, and in 3D, it goes out in BT.709, and kodi.log says why. The white and the gamma are those of \"HDR to SDR: the display it is made for\". Applies from the next video."
+msgid "When an HDR video is converted to SDR (Dolby Vision, HDR10, HDR10+ or HLG, on a display without HDR or with \"Play HDR videos as SDR\"), the SDR picture goes out in the ordinary colours of BT.709 (the default), as every SDR picture. Some projectors and TVs take SDR in a wider gamut, and then show more of the colours of the video: choose BT.2020 or DCI-P3 if your display is set to take SDR in it. The video is mapped into that gamut, the display is told so, and the menus and subtitles are converted to match. Only on a display whose EDID says it takes that gamut, and where the graphics driver can tell it (not every driver offers DCI-P3); elsewhere, and in a 3D mode that puts both eyes into one picture (anaglyph, interlaced or checkerboard), it goes out in BT.709, and kodi.log says why. For 3D video, see also \"How 3D video goes out\". The white and the gamma are those of \"HDR to SDR: the display it is made for\". Applies from the next video."
 msgstr ""
 
