 #: system/settings/settings.xml
 #. Hades: heading of the group of the settings that make Dolby Vision of other videos (System > Display) (core #62500)
diff --git a/xbmc/cores/VideoPlayer/VideoRenderers/LinuxRendererGLES.cpp b/xbmc/cores/VideoPlayer/VideoRenderers/LinuxRendererGLES.cpp
index 97322aa..dba40bd 100644
--- a/xbmc/cores/VideoPlayer/VideoRenderers/LinuxRendererGLES.cpp
+++ b/xbmc/cores/VideoPlayer/VideoRenderers/LinuxRendererGLES.cpp
@@ -4089,9 +4089,12 @@ void CLinuxRendererGLES::CheckVideoParameters(int index)
       SdrWideEnd("the primaries or the transfer of the video changed", buf.m_srcColSpace);
     else if (!CServiceBroker::GetWinSystem()->IsSdrWide())
       SdrWideEnd("the GUI composite into BT.2020 is not on any more", buf.m_srcColSpace);
-    else if (CServiceBroker::GetWinSystem()->GetGfxContext().GetStereoMode() !=
-             RenderStereoMode::OFF)
-      SdrWideEnd("the output went into a 3D mode", buf.m_srcColSpace);
+    // (Hades: a 3D mode that puts both eyes into one picture; the eyes split side by side or one above the
+    // other are drawn into it as a 2D picture is: SDRWIDE::Facts::stereo)
+    else if (KODI::UTILS::STEREO3D::MixesEyes(
+                 CServiceBroker::GetWinSystem()->GetGfxContext().GetStereoMode()))
+      SdrWideEnd("the output went into a 3D mode that puts both eyes into one picture",
+                 buf.m_srcColSpace);
   }
 
   if (buf.m_srcPrimaries != m_srcPrimaries)
diff --git a/xbmc/utils/SdrWide.h b/xbmc/utils/SdrWide.h
index daa3f73..bb84349 100644
--- a/xbmc/utils/SdrWide.h
+++ b/xbmc/utils/SdrWide.h
@@ -189,7 +189,7 @@ enum class Why
   NONE, //!< it goes out in BT.2020 (Hades: or in the container asked for)
   SETTING, //!< the setting is off
   DOLBY_VISION, //!< native Dolby Vision output, or its menus, hold the output
-  STEREO, //!< a 3D output
+  STEREO, //!< a 3D output that puts both eyes into one picture (Hades: anaglyph, interlaced, checkerboard)
   DISPLAY, //!< the EDID does not declare BT2020_RGB
   DRIVER, //!< the connector has no Colorspace property with BT2020_RGB
   DISPLAY_P3, //!< Hades: the EDID does not declare DCI-P3 RGB (SMPTE ST 2113 RGB)
@@ -214,7 +214,9 @@ struct Facts
   bool display = false; //!< the EDID declares BT2020_RGB (its CTA colorimetry data block)
   bool driver = false; //!< the connector has Colorspace, with the value BT2020_RGB
   bool nativeDV = false; //!< native Dolby Vision output, or its menus, hold the output
-  bool stereo = false; //!< the output is in a 3D mode
+  //! the output is in a 3D mode that puts both eyes into one picture (Hades: anaglyph, interlaced, checkerboard;
+  //! the eyes split side by side or one above the other, as a 2D picture: KODI::UTILS::STEREO3D::MixesEyes())
+  bool stereo = false;
 };
 
 constexpr Why Check(const Facts& f)
@@ -249,7 +251,8 @@ constexpr const char* Text(Why why, bool mapped = false)
     case Why::DOLBY_VISION:
       return "native Dolby Vision output holds the output";
     case Why::STEREO:
-      return "the output is in a 3D mode";
+      return "the output is in a 3D mode that puts both eyes into one picture (anaglyph, "
+             "interlaced or checkerboard)";
     case Why::DISPLAY:
       return "the display does not declare BT.2020 RGB in its EDID (CTA colorimetry data block)";
     case Why::DRIVER:
diff --git a/xbmc/windowing/gbm/WinSystemGbmGLESContext.cpp b/xbmc/windowing/gbm/WinSystemGbmGLESContext.cpp
index b11a22f..8f4a099 100644
--- a/xbmc/windowing/gbm/WinSystemGbmGLESContext.cpp
+++ b/xbmc/windowing/gbm/WinSystemGbmGLESContext.cpp
@@ -2457,8 +2457,11 @@ KODI::UTILS::SDRWIDE::Facts CWinSystemGbmGLESContext::SdrWideFacts(bool mapped,
 #ifdef HAVE_DVBRIDGE
   f.nativeDV = m_outputHandover.HoldsOutput() || m_dvMenus;
 #endif
-  f.stereo = const_cast<CWinSystemGbmGLESContext*>(this)->GetGfxContext().GetStereoMode() !=
-             RenderStereoMode::OFF;
+  // (Hades: a 3D output that puts both eyes into one picture: anaglyph, interlaced, checkerboard. The eyes of a 3D
+  // output split side by side or one above the other, and 2D of a 3D video, are drawn into BT.2020 or DCI-P3 as a
+  // 2D picture is: the composite of the GUI covers the whole frame, and each eye has its own view, WholeBuffer.h)
+  f.stereo = KODI::UTILS::STEREO3D::MixesEyes(
+      const_cast<CWinSystemGbmGLESContext*>(this)->GetGfxContext().GetStereoMode());
   return f;
 }
 
