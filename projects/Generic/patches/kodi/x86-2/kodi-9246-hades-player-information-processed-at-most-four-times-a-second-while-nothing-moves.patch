+
+bool CGUIDialogHadesPlayerInfo::ProcessDue(unsigned int currentTime)
+{
+  return m_refresh.Due(currentTime, m_moves || m_closing || IsAnimating(ANIM_TYPE_WINDOW_OPEN) ||
+                                        IsAnimating(ANIM_TYPE_WINDOW_CLOSE));
+}
+
+void CGUIDialogHadesPlayerInfo::DoProcess(unsigned int currentTime, CDirtyRegionList& dirtyregions)
+{
+  const unsigned int processed = m_refresh.Processed();
+  CGUIDialog::DoProcess(currentTime, dirtyregions);
+  // (what moves by itself is known once its controls were processed: their texts are those shown)
+  if (m_refresh.Processed() != processed)
+    m_moves = CGUIDialogPlayerProcessInfo::Moves(*this);
+}
+
+bool CGUIDialogHadesPlayerInfo::OnMessage(CGUIMessage& message)
+{
+  // (a key, the focus, the window opening: the panel answers in the next frame)
+  m_refresh.Now();
+  if (message.GetMessage() == GUI_MSG_WINDOW_INIT)
+  {
+    m_refresh.Reset();
+    m_moves = false;
+  }
+  else if (message.GetMessage() == GUI_MSG_WINDOW_DEINIT && m_refresh.Frames() > 0)
+    CLog::Log(LOGDEBUG, "Hades: the player information was processed in {} of the {} frames it was "
+                        "shown in (at most four times a second while nothing moved)",
+              m_refresh.Processed(), m_refresh.Frames());
+  return CGUIDialog::OnMessage(message);
+}
