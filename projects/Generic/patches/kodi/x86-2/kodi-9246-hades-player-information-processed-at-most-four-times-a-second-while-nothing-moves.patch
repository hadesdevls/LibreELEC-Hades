+}
+
+bool CGUIDialogPlayerProcessInfo::Moves(const CGUIControlGroup& group)
+{
+  for (const CGUIControl* control : group.Children())
+  {
+    if (!control || !control->IsVisible())
+      continue;
+    if (control->IsGroup())
+    {
+      if (Moves(*static_cast<const CGUIControlGroup*>(control)))
+        return true;
+      continue;
+    }
+    switch (control->GetControlType())
+    {
+      case CGUIControl::GUICONTROL_LABEL:
+        if (static_cast<const CGUILabelControl*>(control)->Scrolls())
+          return true;
+        break;
+      case CGUIControl::GUICONTROL_BUTTON:
+        if (static_cast<const CGUIButtonControl*>(control)->Scrolls())
+          return true;
+        break;
+      case CGUIControl::GUICONTROL_TEXTBOX:
+        if (static_cast<const CGUITextBox*>(control)->AutoScrolls())
+          return true;
+        break;
+      case CGUIControl::GUICONTROL_FADELABEL:
+      case CGUIControl::GUICONTROL_MULTI_IMAGE:
+      case CGUIControl::GUICONTROL_RSS:
+        return true;
+      default:
+        break;
+    }
+  }
+  return false;
+}
