diff --git a/xbmc/dialogs/PlayerInfoRefresh.h b/xbmc/dialogs/PlayerInfoRefresh.h
new file mode 100644
index 0000000..128f38b
--- /dev/null
+++ b/xbmc/dialogs/PlayerInfoRefresh.h
@@ -0,0 +1,68 @@
+/*
+ *  Copyright (C) 2026 Hades
+ *  This file is part of LibreELEC Hades. It is not in Kodi as Team Kodi publishes it.
+ *
+ *  SPDX-License-Identifier: GPL-2.0-or-later
+ *  See LICENSES/README.md for more information.
+ */
+
+#pragma once
+
+/*!
+ * \brief Hades: how often the controls of the player information are processed while it is open over
+ *        a video (CGUIDialogPlayerProcessInfo, CGUIDialogHadesPlayerInfo; CGUIWindow::ProcessDue())
+ *
+ * The panel is an opaque plate over most of the picture, and many of its values change in almost every
+ * frame (the queues of the player, its cache, the rate of the frames): each change dirtied it, and with
+ * it the whole GUI pass of that frame was drawn again. Where the GUI is composited over the picture
+ * from its FBO (native Dolby Vision, the HDR10/HLG composite, Dolby Vision rebuilt as HDR10), a frame
+ * whose GUI is not dirty is composited from the FBO of the frame before and its GUI pass is left out
+ * (CDVGuiReuse): on an AMD iGPU with the panel open, kodi.log of the 1.0 diagnostics had 0 to 129 of
+ * 240 frames so (24 fps), at 11.3 ms of GPU time a frame with none and 6 to 7.7 ms with half of them.
+ *
+ * Its values come from the hades.* properties, which the window system publishes at most twice a second
+ * (CWinSystemGbmGLESContext::PublishDVInfo()), and from Kodi's labels. Processed at most PERIOD_MS
+ * apart, it shows the same values, each at most PERIOD_MS later, and its GUI pass is drawn at most
+ * four times a second for it. It is processed at once when something is asked of it (a key, a message:
+ * Now()), and in every frame while something of it moves by itself (busy: its window opening or
+ * closing, a text that scrolls), so that what it shows moves as before.
+ *
+ * Only the thread of the GUI calls it. This header only decides and counts; a test builds it on the
+ * host (tools/regress/kodi-host).
+ */
+class CPlayerInfoRefresh
+{
+public:
+  //! at most four times a second while nothing is asked and nothing moves
+  static constexpr unsigned int PERIOD_MS = 250;
+
+  //! something was asked of the panel: it is processed in the next frame
+  void Now() { m_now = true; }
+
+  //! Whether the panel is processed in this frame (currentTime: the time of the frame, ms)
+  bool Due(unsigned int currentTime, bool busy)
+  {
+    ++m_frames;
+    if (!m_now && !busy && m_processed && currentTime >= m_last && currentTime - m_last < PERIOD_MS)
+      return false;
+    m_now = false;
+    m_processed = true;
+    m_last = currentTime;
+    ++m_done;
+    return true;
+  }
+
+  //! the frames counted since Reset(), and those processed of them
+  unsigned int Frames() const { return m_frames; }
+  unsigned int Processed() const { return m_done; }
+
+  //! the panel opens: its first frame is processed, and the counts begin again
+  void Reset() { *this = CPlayerInfoRefresh(); }
+
+private:
+  bool m_now = true;
+  bool m_processed = false;
+  unsigned int m_last = 0;
+  unsigned int m_frames = 0;
+  unsigned int m_done = 0;
+};
