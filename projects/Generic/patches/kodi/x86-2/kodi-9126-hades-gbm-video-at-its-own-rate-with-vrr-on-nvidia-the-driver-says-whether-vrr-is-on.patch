+//! nvidia-drm, read-only: whether the last flip of the head went out with VRR active in NVKMS (bit 0),
+//! and the VRR of the timings of its mode set (bits 8-15: 0 none, 1 gaming, 2 media)
+//! (nvidia-open-kernel-modules-9079)
+constexpr const char* VRR_ACTIVE = "NV_VRR_ACTIVE";
 //! The rate is at least this much above the display's VRR minimum, so that no refresh comes as late
 //! as the display's longest frame, where the driver would repeat the picture by itself
 constexpr double MIN_MARGIN = 1.05;
@@ -109,6 +113,20 @@ inline unsigned int MediaTarget(double rate)
   return 0;
 }
 
+/*!
+ * \brief Whether a refresh rate is a whole multiple (1 to 16 times) of a frame rate, within 200 ppm:
+ *        a mode that shows each picture the same number of refreshes. 1000/1001 apart is 999 ppm,
+ *        so 119.999 Hz is no multiple of 23.976 fps (it is of 24), and the few ppm of a mode's own
+ *        clock (23.975758 Hz for 23.976) are.
+ */
+inline bool WholeMultipleOf(double refresh, double fps)
+{
+  if (!(refresh > 0.0) || !(fps > 0.0) || !std::isfinite(refresh) || !std::isfinite(fps))
+    return false;
+  const double k = std::round(refresh / fps);
+  return k >= 1.0 && k <= 16.0 && std::fabs(refresh - k * fps) <= refresh * 200e-6;
+}
+
 //! What Decide() is told
 struct Query
 {
@@ -366,6 +384,7 @@ enum class Applied
   FIXED, //!< the refreshes stayed at the mode's rate: the mode changes to the video's as before
   NOT_KEPT, //!< the driver read VRR_ENABLED back as 0: the mode changes to the video's as before
   UNMEASURED, //!< no interval could be measured in UNMEASURED_NS: the mode changes as before
+  DRIVER_OFF, //!< the driver says that VRR is not active on the head (NV_VRR_ACTIVE): as before
 };
 
 constexpr const char* AppliedName(Applied applied)
@@ -381,6 +400,7 @@ constexpr const char* AppliedName(Applied applied)
     case Applied::FIXED:
     case Applied::NOT_KEPT:
     case Applied::UNMEASURED:
+    case Applied::DRIVER_OFF:
       return "fixed";
     case Applied::NONE:
       break;
@@ -413,6 +433,16 @@ constexpr const char* AppliedName(Applied applied)
  * MIN_INTERVALS could be measured in UNMEASURED_NS. Whether the display shows
  * each picture at the time it comes is not seen from here: that is the display's own setting.
  *
+ * nvidia-drm has no vblanks with its defaults (its parameter vblank is off: drm_crtc_get_sequence
+ * fails with EOPNOTSUPP), so on NVIDIA nothing above can be measured and every video at its own rate
+ * ended UNMEASURED (the RTX 4080 SUPER of the test of 2026-11-18, with the VRR packet of the output
+ * saying "VRR on"). There the driver says it instead (DriverSays(), NV_VRR_ACTIVE,
+ * nvidia-open-kernel-modules-9079): what NVKMS did with the flip, VRR active on the head in its
+ * hardware state or not, read after each flip of the first DRIVER_FLIPS. The first DRIVER_SKIP flips
+ * are left out (the commit that asks for VRR_ENABLED, whose flip NVKMS activates VRR with); then
+ * DRIVER_OFF at the first one that says 0, FOLLOWS once DRIVER_FLIPS said 1. Where the driver says
+ * it, the vblanks are not needed: it decides.
+ *
  * Pure: a test runs it on the host (vrr_video_test.cpp).
  */
 class CStartCheck
@@ -428,6 +458,9 @@ public:
   static constexpr int64_t OFF_NS = 1000000;
   static constexpr double MAX_OFF_SHARE = 0.25;
   static constexpr double MIN_FIXED_EXTRA = 0.1;
+  //! NV_VRR_ACTIVE: the flips left out, and those that must say 1 after them
+  static constexpr uint64_t DRIVER_SKIP = 1;
+  static constexpr uint64_t DRIVER_FLIPS = 3;
 
   void Start(int64_t nowNs, double rate, double modeRefresh)
   {
@@ -440,6 +473,22 @@ public:
   //! VRR_ENABLED as the kernel reads it back after the first commit that asked for it (nothing:
   //! not read)
   void KernelSays(std::optional<uint64_t> vrrEnabled) { m_readBack = vrrEnabled; }
+  /*!
+   * \brief NV_VRR_ACTIVE after a flip that went out (nothing: the driver has no such property, or it
+   *        could not be read). Bit 0: VRR active on the head for that flip.
+   */
+  void DriverSays(std::optional<uint64_t> active)
+  {
+    if (!m_started || !active)
+      return;
+    m_driverKnown = true;
+    if (m_driverSeen++ < DRIVER_SKIP)
+      return;
+    if ((*active & 1) == 0)
+      m_driverOff = true;
+    else
+      ++m_driverOn;
+  }
   //! An interval between two flips that each showed: the vblanks between them (1: none of the
   //! display's own) and its time against the one asked for
   void Interval(uint64_t vblanks, int64_t errorNs)
@@ -461,6 +510,13 @@ public:
       return Applied::NOT_KEPT;
     if (std::fabs(m_rate - m_modeRefresh) <= SAME_RATE_HZ)
       return Applied::SAME_RATE;
+    // (the driver says it: NV_VRR_ACTIVE)
+    if (m_driverOff)
+      return Applied::DRIVER_OFF;
+    if (m_driverOn >= DRIVER_FLIPS)
+      return Applied::FOLLOWS;
+    if (m_driverKnown && nowNs - m_startNs < UNMEASURED_NS)
+      return Applied::CHECKING;
     if (m_count < MIN_INTERVALS && nowNs - m_startNs >= UNMEASURED_NS)
       return Applied::UNMEASURED;
     if (m_count < MIN_INTERVALS || nowNs - m_startNs < WINDOW_NS)
@@ -482,8 +538,15 @@ public:
   //! the display's own refreshes a flip that a fixed refresh at the mode's rate makes
   double FixedExtra() const { return m_rate > 0.0 ? std::max(0.0, m_modeRefresh / m_rate - 1.0) : 0.0; }
   std::optional<uint64_t> ReadBack() const { return m_readBack; }
+  //! whether the driver said anything of VRR on the head (NV_VRR_ACTIVE), and how many flips said 1
+  bool DriverKnown() const { return m_driverKnown; }
+  uint64_t DriverOn() const { return m_driverOn; }
 
 private:
+  bool m_driverKnown = false;
+  bool m_driverOff = false;
+  uint64_t m_driverSeen = 0;
+  uint64_t m_driverOn = 0;
   bool m_started = false;
   int64_t m_startNs = 0;
   double m_rate = 0.0;
