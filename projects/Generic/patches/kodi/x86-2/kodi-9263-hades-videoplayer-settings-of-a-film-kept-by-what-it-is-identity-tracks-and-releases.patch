+TEST(TestFilmMemory, ATextOfAnotherVersionKeepsWhatIsValidHere)
+{
+  CVideoSettings defaults;
+  defaults.m_ViewMode = ViewModeZoom;
+  Record r;
+  // (no "v": not a record)
+  EXPECT_FALSE(Parse("duration=5\n", defaults, r));
+  EXPECT_FALSE(Parse("", defaults, r));
+  // a later version: its new keys and values not valid here are left out
+  ASSERT_TRUE(Parse("v=7\nduration=7980000\nviewmode=99\nzoom=nan\nscaling=1000\n"
+                    "tonemapmethod=-1\norientation=45\nnewsetting=3\nbrightness=55\n"
+                    "audiodelay=0.5x\nsubtitledelay=-0.25\n",
+                    defaults, r));
+  EXPECT_EQ(7980000, r.release.durationMs);
+  EXPECT_EQ(ViewModeZoom, r.settings.m_ViewMode);
+  EXPECT_EQ(1.0f, r.settings.m_CustomZoomAmount);
+  EXPECT_EQ(defaults.m_ScalingMethod, r.settings.m_ScalingMethod);
+  EXPECT_EQ(defaults.m_ToneMapMethod, r.settings.m_ToneMapMethod);
+  EXPECT_EQ(0, r.settings.m_Orientation);
+  EXPECT_EQ(55.0f, r.settings.m_Brightness);
+  EXPECT_EQ(0.0f, r.settings.m_AudioDelay);
+  EXPECT_EQ(-0.25f, r.settings.m_SubtitleDelay);
+  EXPECT_FALSE(r.audio.has_value());
+  EXPECT_FALSE(r.subtitle.has_value());
+  // (a track number of the text is never a choice: the stream numbers are not taken from it)
+  EXPECT_EQ(-1, r.settings.m_AudioStream);
+  EXPECT_EQ(-1, r.settings.m_SubtitleStream);
+}
