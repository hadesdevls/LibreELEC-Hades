+// ---- what a release takes from the records of its film
+
+namespace
+{
+Record Kept(Release release)
+{
+  Record r;
+  r.release = release;
+  r.settings.m_AudioDelay = 0.2f;
+  r.settings.m_SubtitleDelay = -1.5f;
+  r.settings.m_ViewMode = ViewModeCustom;
+  r.settings.m_CustomZoomAmount = 1.33f;
+  r.settings.m_ScalingMethod = VS_SCALINGMETHOD_SPLINE36;
+  r.settings.m_Sharpness = 0.3f;
+  r.settings.m_VolumeAmplification = 4.0f;
+  r.audio = T("spa", "Castellano", "truehd", 8);
+  r.subtitle = T("spa", "Forzados", "hdmv_pgs_subtitle", 0, FLAG_FORCED);
+  r.subtitleChosen = true;
+  return r;
+}
+
+const std::vector<Track> AUDIO = Placed({T("eng", "", "eac3", 6), T("spa", "Castellano", "eac3", 6)});
+const std::vector<Track> SUBTITLES =
+    Placed({T("eng", "", "subrip", 0), T("spa", "", "subrip", 0), T("spa", "Forced", "subrip", 0)});
+} // namespace
+
+TEST(TestFilmMemory, TheSameReleaseTakesEverything)
+{
+  const auto r = Restore({Kept(R(FILM))}, R(FILM + 400), CVideoSettings(), AUDIO, SUBTITLES);
+  ASSERT_TRUE(r.has_value());
+  EXPECT_EQ(0.2f, r->settings.m_AudioDelay);
+  EXPECT_EQ(-1.5f, r->settings.m_SubtitleDelay);
+  EXPECT_EQ(1, r->settings.m_AudioStream);
+  EXPECT_EQ(2, r->settings.m_SubtitleStream);
+  EXPECT_TRUE(r->settings.m_SubtitleOn);
+  EXPECT_EQ(std::optional<bool>(false), r->settings.m_isDefaultVideoSettings);
+  EXPECT_EQ(ViewModeCustom, r->settings.m_ViewMode);
+  EXPECT_EQ(VS_SCALINGMETHOD_SPLINE36, r->settings.m_ScalingMethod);
+  EXPECT_EQ(4.0f, r->settings.m_VolumeAmplification);
+  EXPECT_EQ(GROUP_AUDIO | GROUP_SUBTITLES | GROUP_VIEW | GROUP_PICTURE | GROUP_AUDIO_LEVEL |
+                GROUP_DELAYS,
+            r->groups);
+}
+
+TEST(TestFilmMemory, AnotherReleaseOfTheSameCutIsTimedOtherwise)
+{
+  // 12 s longer (another distributor's logos): not its delays
+  const auto r = Restore({Kept(R(FILM))}, R(FILM + 12000), CVideoSettings(), AUDIO, SUBTITLES);
+  ASSERT_TRUE(r.has_value());
+  EXPECT_EQ(0.0f, r->settings.m_AudioDelay);
+  EXPECT_EQ(0.0f, r->settings.m_SubtitleDelay);
+  EXPECT_EQ(0u, r->groups & GROUP_DELAYS);
+  EXPECT_EQ(4.0f, r->settings.m_VolumeAmplification);
+  EXPECT_EQ(1, r->settings.m_AudioStream);
+  EXPECT_EQ(2, r->settings.m_SubtitleStream);
+}
+
+TEST(TestFilmMemory, AnotherCutTakesTheTracksButNotItsTiming)
+{
+  // the extended cut, 20 minutes longer, in the same format
+  const auto r =
+      Restore({Kept(R(FILM))}, R(FILM + 20 * 60 * 1000), CVideoSettings(), AUDIO, SUBTITLES);
+  ASSERT_TRUE(r.has_value());
+  EXPECT_EQ(0.0f, r->settings.m_AudioDelay);
+  EXPECT_EQ(0.0f, r->settings.m_SubtitleDelay);
+  EXPECT_EQ(0.0f, r->settings.m_VolumeAmplification);
+  EXPECT_EQ(1, r->settings.m_AudioStream);
+  EXPECT_EQ(2, r->settings.m_SubtitleStream);
+  // the zoom is of the shape of the picture, the picture settings of its format
+  EXPECT_EQ(ViewModeCustom, r->settings.m_ViewMode);
+  EXPECT_EQ(VS_SCALINGMETHOD_SPLINE36, r->settings.m_ScalingMethod);
+  // a cut within 30 s is the same cut; 44 s apart (the final cut of Blade Runner) is not
+  EXPECT_TRUE(SameCut(R(FILM), R(FILM + 30000)));
+  EXPECT_FALSE(SameCut(R(FILM), R(FILM + 44000)));
+  // (an episode of 22 minutes: 6.6 s)
+  EXPECT_TRUE(SameCut(R(22 * 60 * 1000), R(22 * 60 * 1000 + 6000)));
+  EXPECT_FALSE(SameCut(R(22 * 60 * 1000), R(22 * 60 * 1000 + 8000)));
+  // a length not known is no release and no cut
+  EXPECT_FALSE(SameCut(R(0), R(0)));
+  EXPECT_FALSE(SameRelease(R(0), R(0)));
+}
+
+TEST(TestFilmMemory, TheZoomOnlyForAPictureOfTheSameShape)
+{
+  // the IMAX release, 1.90:1, of the same length
