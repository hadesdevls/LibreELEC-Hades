+                         SUBTITLES);
+  ASSERT_TRUE(r.has_value());
+  EXPECT_EQ(VS_SCALINGMETHOD_LINEAR, r->settings.m_ScalingMethod);
+  EXPECT_EQ(0.0f, r->settings.m_Sharpness);
+  EXPECT_EQ(0u, r->groups & GROUP_PICTURE);
+  EXPECT_EQ(ViewModeCustom, r->settings.m_ViewMode);
+  EXPECT_EQ(0.0f, r->settings.m_SubtitleDelay);
+}
