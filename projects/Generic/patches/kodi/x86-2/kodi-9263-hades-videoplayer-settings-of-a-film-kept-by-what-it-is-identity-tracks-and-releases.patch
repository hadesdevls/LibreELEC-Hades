+namespace KODI::FILMMEMORY
+{
+namespace
+{
+constexpr int VERSION = 1;
+
+std::string Trimmed(std::string_view text)
+{
+  const auto first = text.find_first_not_of(" \t\r\n");
+  if (first == std::string_view::npos)
+    return {};
+  const auto last = text.find_last_not_of(" \t\r\n");
+  return std::string(text.substr(first, last - first + 1));
+}
+
+std::string Lower(std::string_view text)
+{
+  std::string lower(text);
+  for (char& c : lower)
+  {
+    if (c >= 'A' && c <= 'Z')
+      c = static_cast<char>(c - 'A' + 'a');
+  }
+  return lower;
+}
+
+bool AllDigits(std::string_view text)
+{
+  return !text.empty() &&
+         std::all_of(text.begin(), text.end(), [](char c) { return c >= '0' && c <= '9'; });
+}
+
+//! "tt" and 7 to 10 digits
+std::string ImdbId(std::string_view text)
+{
+  const std::string id = Lower(Trimmed(text));
+  if (id.size() < 9 || id.size() > 12 || id.compare(0, 2, "tt") != 0 ||
+      !AllDigits(std::string_view(id).substr(2)))
+    return {};
+  return id;
+}
+
+//! 1 to 10 digits, not all of them 0 (a number without its leading zeros)
+std::string NumericId(std::string_view text)
+{
+  std::string id = Trimmed(text);
+  if (!AllDigits(id) || id.size() > 10)
+    return {};
+  const auto first = id.find_first_not_of('0');
+  if (first == std::string::npos)
+    return {};
+  return id.substr(first);
+}
+
+std::string Duration(int64_t ms)
+{
+  if (ms <= 0)
+    return "length not known";
+  const int64_t s = (ms + 500) / 1000;
+  char text[32];
+  std::snprintf(text, sizeof(text), "%lld:%02lld:%02lld", static_cast<long long>(s / 3600),
+                static_cast<long long>(s / 60 % 60), static_cast<long long>(s % 60));
+  return text;
+}
+
+const char* HdrName(int hdr)
+{
+  switch (static_cast<StreamHdrType>(hdr))
+  {
+    case StreamHdrType::HDR_TYPE_NONE:
+      return "SDR";
+    case StreamHdrType::HDR_TYPE_HDR10:
+      return "HDR10";
+    case StreamHdrType::HDR_TYPE_DOLBYVISION:
+      return "Dolby Vision";
+    case StreamHdrType::HDR_TYPE_HLG:
+      return "HLG";
+    case StreamHdrType::HDR_TYPE_HDR10PLUS:
+      return "HDR10+";
+    default:
+      return "HDR";
+  }
+}
+
+// ---- the text of a record
+
+std::string Escaped(std::string_view value)
+{
+  std::string text;
+  for (const char c : value)
+  {
+    if (c == '\\')
+      text += "\\\\";
+    else if (c == '\n')
+      text += "\\n";
+    else if (c == '\r')
+      text += "\\r";
+    else
+      text += c;
+  }
+  return text;
+}
+
+std::string Unescaped(std::string_view value)
+{
+  std::string text;
+  for (size_t i = 0; i < value.size(); ++i)
+  {
+    if (value[i] == '\\' && i + 1 < value.size())
+    {
+      ++i;
+      text += value[i] == 'n' ? '\n' : value[i] == 'r' ? '\r' : value[i];
+    }
+    else
+      text += value[i];
+  }
+  return text;
+}
+
+std::string Number(float value)
+{
+  char text[64];
+  const auto result = std::to_chars(text, text + sizeof(text), value);
+  return std::string(text, result.ptr);
+}
+
+std::optional<float> FloatOf(std::string_view text)
+{
+  float value = 0.0f;
+  const auto result = std::from_chars(text.data(), text.data() + text.size(), value);
+  if (result.ec != std::errc() || result.ptr != text.data() + text.size() || !std::isfinite(value))
+    return std::nullopt;
+  return value;
+}
+
+std::optional<int64_t> IntOf(std::string_view text)
+{
+  int64_t value = 0;
+  const auto result = std::from_chars(text.data(), text.data() + text.size(), value);
+  if (result.ec != std::errc() || result.ptr != text.data() + text.size())
+    return std::nullopt;
+  return value;
+}
+
+void Line(std::string& text, std::string_view key, std::string_view value)
+{
+  text += key;
+  text += '=';
+  text += Escaped(value);
+  text += '\n';
+}
+
+void Line(std::string& text, std::string_view key, int64_t value)
+{
+  Line(text, key, std::to_string(value));
+}
+
+void Line(std::string& text, std::string_view key, float value)
+{
+  Line(text, key, Number(value));
+}
+
+void TrackLines(std::string& text, std::string_view prefix, const Track& track)
+{
+  const std::string p(prefix);
+  Line(text, p, int64_t{1});
+  Line(text, p + ".lang", track.language);
+  Line(text, p + ".variety", int64_t{track.variety});
+  Line(text, p + ".name", track.name);
+  Line(text, p + ".codec", track.codec);
+  Line(text, p + ".channels", int64_t{track.channels});
+  Line(text, p + ".flags", int64_t{track.flags});
+  Line(text, p + ".external", int64_t{track.external ? 1 : 0});
+  Line(text, p + ".index", int64_t{track.index});
+  Line(text, p + ".ordinal", int64_t{track.ordinal});
+}
+
+// A value of the text in its place, where it is valid (anything else keeps what is there)
+struct Reader
+{
+  std::string_view value;
+
+  bool Int(int& to, int64_t low, int64_t high) const
+  {
+    const auto v = IntOf(value);
+    if (!v || *v < low || *v > high)
+      return false;
+    to = static_cast<int>(*v);
+    return true;
+  }
+  bool Int64(int64_t& to, int64_t low, int64_t high) const
+  {
+    const auto v = IntOf(value);
+    if (!v || *v < low || *v > high)
+      return false;
+    to = *v;
+    return true;
+  }
+  bool Bool(bool& to) const
+  {
+    int v = 0;
+    if (!Int(v, 0, 1))
+      return false;
+    to = v != 0;
+    return true;
+  }
+  bool Float(float& to) const
+  {
+    const auto v = FloatOf(value);
+    if (!v)
+      return false;
+    to = *v;
+    return true;
+  }
+  template<typename E>
+  bool Enum(E& to, int high) const
+  {
+    int v = 0;
+    if (!Int(v, 0, high - 1))
+      return false;
+    to = static_cast<E>(v);
+    return true;
+  }
+};
+
+bool TrackValue(Track& track, std::string_view key, const Reader& r)
+{
+  if (key == "lang")
+    track.language = Lower(Unescaped(r.value));
+  else if (key == "variety")
+    r.Int(track.variety, 0, 255);
+  else if (key == "name")
+    track.name = Unescaped(r.value);
+  else if (key == "codec")
+    track.codec = Unescaped(r.value);
+  else if (key == "channels")
+    r.Int(track.channels, 0, 64);
+  else if (key == "flags")
+    r.Int(track.flags, 0, 0x7fffffff);
+  else if (key == "external")
+    r.Bool(track.external);
+  else if (key == "index")
+    r.Int(track.index, -1, 100000);
+  else if (key == "ordinal")
+    r.Int(track.ordinal, -1, 100000);
+  else
+    return false;
+  return true;
+}
+
+// ---- tracks
+
+//! What kind of track it is, by its flags and by the words of its title
+struct TrackKinds
+{
+  bool forced{false};
+  bool hearingImpaired{false};
+  bool commentary{false};
+  bool description{false};
+};
+
+bool NameHas(const std::string& lowerName, std::initializer_list<const char*> words)
+{
+  return std::any_of(words.begin(), words.end(), [&lowerName](const char* word)
+                     { return lowerName.find(word) != std::string::npos; });
+}
+
+TrackKinds KindsOf(const Track& track)
+{
+  const std::string name = Lower(track.name);
+  TrackKinds kinds;
+  kinds.forced = (track.flags & FLAG_FORCED) || NameHas(name, {"forced", "forzad", "forcé"});
+  kinds.hearingImpaired = (track.flags & FLAG_HEARING_IMPAIRED) ||
+                          NameHas(name, {"sdh", "hearing impaired", "hard of hearing"});
+  kinds.commentary = (track.flags & FLAG_COMMENT) || NameHas(name, {"comment", "comentario"});
+  kinds.description = (track.flags & FLAG_VISUAL_IMPAIRED) ||
+                      NameHas(name, {"audio description", "descriptive", "audiodescrip"});
+  return kinds;
+}
+
+//! A subtitle drawn from text (as opposed to pictures)
+bool TextSubtitle(const std::string& codec)
+{
+  const std::string c = Lower(codec);
+  return !(c.find("pgs") != std::string::npos || c.find("dvd_sub") != std::string::npos ||
+           c.find("dvb_sub") != std::string::npos || c.find("vobsub") != std::string::npos ||
+           c.find("xsub") != std::string::npos);
+}
+
+std::string Join(const std::vector<std::string>& parts, const char* separator)
+{
+  std::string text;
+  for (const auto& part : parts)
+  {
+    if (!text.empty())
+      text += separator;
+    text += part;
+  }
+  return text;
+}
+
+const Record* First(const std::vector<Record>& records, const std::function<bool(const Record&)>& f)
+{
+  for (const auto& record : records)
+  {
+    if (f(record))
+      return &record;
+  }
+  return nullptr;
+}
+
+std::string Seconds(float value)
+{
+  char text[32];
+  std::snprintf(text, sizeof(text), "%+.3f s", static_cast<double>(value));
+  return text;
+}
+} // namespace
+
+std::string Identity::Describe() const
+{
+  std::vector<std::string> ids;
+  if (!imdb.empty())
+    ids.push_back("imdb " + imdb);
+  if (!tmdb.empty())
+    ids.push_back("tmdb " + tmdb);
+  if (!tvdb.empty())
+    ids.push_back("tvdb " + tvdb);
+  if (kind == Kind::EPISODE)
+  {
+    char se[48];
+    std::snprintf(se, sizeof(se), "episode S%02dE%02d of ", season, episode);
+    return se + Join(ids, " ");
+  }
+  return "film " + Join(ids, " ");
+}
+
+std::optional<Identity> IdentityOf(std::string_view mediaType,
+                                   std::string_view imdb,
+                                   std::string_view tmdb,
+                                   std::string_view tvdb,
+                                   int season,
+                                   int episode)
+{
+  Identity identity;
+  const std::string type = Lower(Trimmed(mediaType));
+  if (type == "movie")
+    identity.kind = Kind::MOVIE;
+  else if (type == "episode")
+  {
+    if (season < 0 || episode < 0)
+      return std::nullopt;
+    identity.kind = Kind::EPISODE;
+    identity.season = season;
+    identity.episode = episode;
+  }
+  else
+    return std::nullopt;
+  identity.imdb = ImdbId(imdb);
+  identity.tmdb = NumericId(tmdb);
+  identity.tvdb = NumericId(tvdb);
+  if (identity.imdb.empty() && identity.tmdb.empty() && identity.tvdb.empty())
+    return std::nullopt;
+  return identity;
+}
+
+bool SameVideo(const Identity& a, const Identity& b)
+{
+  if (a.kind != b.kind || a.season != b.season || a.episode != b.episode)
+    return false;
+  int common = 0;
+  for (const auto& [x, y] : {std::pair{&a.imdb, &b.imdb}, std::pair{&a.tmdb, &b.tmdb},
+                             std::pair{&a.tvdb, &b.tvdb}})
+  {
+    if (x->empty() || y->empty())
+      continue;
+    if (*x != *y)
+      return false;
+    ++common;
+  }
+  return common > 0;
+}
+
+std::string Track::Describe() const
+{
+  std::vector<std::string> parts;
+  parts.push_back(language.empty() ? std::string("no language") : language);
+  if (!name.empty())
+    parts.push_back("\"" + name + "\"");
+  if (!codec.empty())
+    parts.push_back(codec);
+  if (channels > 0)
+    parts.push_back(std::to_string(channels) + " channels");
+  const TrackKinds kinds = KindsOf(*this);
+  if (kinds.forced)
+    parts.push_back("forced");
+  if (kinds.hearingImpaired)
+    parts.push_back("hearing impaired");
+  if (kinds.commentary)
+    parts.push_back("commentary");
+  if (kinds.description)
+    parts.push_back("audio description");
+  if (external)
+    parts.push_back("a file beside the video");
+  return Join(parts, ", ");
+}
+
+std::string Release::Describe() const
+{
+  std::string text = Duration(durationMs);
+  if (picture.width > 0 && picture.height > 0)
+    text += ", " + std::to_string(picture.width) + "x" + std::to_string(picture.height) + " " +
+            HdrName(picture.hdr);
+  if (!picture.stereo.empty())
+    text += " 3D " + picture.stereo;
+  return text;
+}
+
+int64_t SameCutToleranceMs(int64_t durationMs)
+{
+  return std::clamp<int64_t>(durationMs / 200, 5000, 30000);
+}
+
+bool SameFormat(const Picture& a, const Picture& b)
+{
+  return a.width > 0 && a.height > 0 && a.width == b.width && a.height == b.height &&
+         a.hdr == b.hdr && a.stereo == b.stereo;
+}
+
+bool SameShape(const Picture& a, const Picture& b)
+{
+  if (!(a.aspect > 0.0f) || !(b.aspect > 0.0f))
+    return false;
+  return std::fabs(a.aspect - b.aspect) <= 0.01f * b.aspect;
+}
+
+bool SameRelease(const Release& a, const Release& b)
+{
+  return a.durationMs > 0 && b.durationMs > 0 &&
+         std::llabs(a.durationMs - b.durationMs) <= SAME_RELEASE_MS &&
+         SameFormat(a.picture, b.picture) && a.videoStreams == b.videoStreams;
+}
+
+bool SameCut(const Release& a, const Release& b)
+{
+  return a.durationMs > 0 && b.durationMs > 0 &&
+         std::llabs(a.durationMs - b.durationMs) <=
+             SameCutToleranceMs(std::max(a.durationMs, b.durationMs));
+}
+
+std::string Serialize(const Record& record)
+{
+  std::string text;
+  const CVideoSettings& s = record.settings;
+  Line(text, "v", int64_t{VERSION});
+  Line(text, "duration", record.release.durationMs);
+  Line(text, "width", int64_t{record.release.picture.width});
+  Line(text, "height", int64_t{record.release.picture.height});
+  Line(text, "aspect", record.release.picture.aspect);
+  Line(text, "hdr", int64_t{record.release.picture.hdr});
+  Line(text, "stereo", record.release.picture.stereo);
+  Line(text, "videostreams", int64_t{record.release.videoStreams});
+  Line(text, "deinterlace", int64_t{s.m_InterlaceMethod});
+  Line(text, "scaling", int64_t{s.m_ScalingMethod});
+  Line(text, "viewmode", int64_t{s.m_ViewMode});
+  Line(text, "zoom", s.m_CustomZoomAmount);
+  Line(text, "pixelratio", s.m_CustomPixelRatio);
+  Line(text, "verticalshift", s.m_CustomVerticalShift);
+  Line(text, "nonlinstretch", int64_t{s.m_CustomNonLinStretch ? 1 : 0});
+  Line(text, "volumeamplification", s.m_VolumeAmplification);
+  Line(text, "subtitledelay", s.m_SubtitleDelay);
+  Line(text, "subtitleson", int64_t{s.m_SubtitleOn ? 1 : 0});
+  Line(text, "brightness", s.m_Brightness);
+  Line(text, "contrast", s.m_Contrast);
+  Line(text, "gamma", s.m_Gamma);
+  Line(text, "noisereduction", s.m_NoiseReduction);
+  Line(text, "postprocess", int64_t{s.m_PostProcess ? 1 : 0});
+  Line(text, "sharpness", s.m_Sharpness);
+  Line(text, "audiodelay", s.m_AudioDelay);
+  Line(text, "stereomode", int64_t{s.m_StereoMode});
+  Line(text, "stereoinvert", int64_t{s.m_StereoInvert ? 1 : 0});
+  Line(text, "videostream", int64_t{s.m_VideoStream});
+  Line(text, "tonemapmethod", int64_t{s.m_ToneMapMethod});
+  Line(text, "tonemapparam", s.m_ToneMapParam);
+  Line(text, "orientation", int64_t{s.m_Orientation});
+  Line(text, "centermixlevel", int64_t{s.m_CenterMixLevel});
+  if (record.audio)
+    TrackLines(text, "audio", *record.audio);
+  if (record.subtitle)
+    TrackLines(text, "sub", *record.subtitle);
+  Line(text, "subchosen", int64_t{record.subtitleChosen ? 1 : 0});
+  return text;
+}
+
+bool Parse(std::string_view text, const CVideoSettings& defaults, Record& record)
+{
+  record = Record{};
+  record.settings = defaults;
+  record.settings.m_AudioStream = -1;
+  record.settings.m_SubtitleStream = -1;
+  bool versioned = false;
+  Track audio;
+  Track subtitle;
+  bool hasAudio = false;
+  bool hasSubtitle = false;
+  CVideoSettings& s = record.settings;
+  size_t start = 0;
+  while (start < text.size())
+  {
+    size_t end = text.find('\n', start);
+    if (end == std::string_view::npos)
+      end = text.size();
+    const std::string_view line = text.substr(start, end - start);
+    start = end + 1;
+    const size_t eq = line.find('=');
+    if (eq == std::string_view::npos)
+      continue;
+    const std::string_view key = line.substr(0, eq);
+    const Reader r{line.substr(eq + 1)};
+    if (key == "v")
+    {
+      int version = 0;
+      if (!r.Int(version, 1, 1000000))
+        return false;
+      versioned = true;
+    }
+    else if (key == "duration")
+      r.Int64(record.release.durationMs, 0, int64_t{1000} * 3600 * 1000);
+    else if (key == "width")
+      r.Int(record.release.picture.width, 0, 65535);
+    else if (key == "height")
+      r.Int(record.release.picture.height, 0, 65535);
+    else if (key == "aspect")
+    {
+      float aspect = 0.0f;
+      if (r.Float(aspect) && aspect >= 0.0f && aspect < 100.0f)
+        record.release.picture.aspect = aspect;
+    }
+    else if (key == "hdr")
+      r.Int(record.release.picture.hdr, 0, 255);
+    else if (key == "stereo")
+      record.release.picture.stereo = Unescaped(r.value);
+    else if (key == "videostreams")
+      r.Int(record.release.videoStreams, 0, 1000);
+    else if (key == "deinterlace")
+      r.Enum(s.m_InterlaceMethod, VS_INTERLACEMETHOD_MAX);
+    else if (key == "scaling")
+      r.Enum(s.m_ScalingMethod, VS_SCALINGMETHOD_MAX);
+    else if (key == "viewmode")
+      r.Int(s.m_ViewMode, ViewModeNormal, ViewModeZoom110Width);
+    else if (key == "zoom")
+      r.Float(s.m_CustomZoomAmount);
+    else if (key == "pixelratio")
+      r.Float(s.m_CustomPixelRatio);
+    else if (key == "verticalshift")
+      r.Float(s.m_CustomVerticalShift);
+    else if (key == "nonlinstretch")
+      r.Bool(s.m_CustomNonLinStretch);
+    else if (key == "volumeamplification")
+      r.Float(s.m_VolumeAmplification);
+    else if (key == "subtitledelay")
+      r.Float(s.m_SubtitleDelay);
+    else if (key == "subtitleson")
+      r.Bool(s.m_SubtitleOn);
+    else if (key == "brightness")
+      r.Float(s.m_Brightness);
+    else if (key == "contrast")
+      r.Float(s.m_Contrast);
+    else if (key == "gamma")
+      r.Float(s.m_Gamma);
+    else if (key == "noisereduction")
+      r.Float(s.m_NoiseReduction);
+    else if (key == "postprocess")
+      r.Bool(s.m_PostProcess);
+    else if (key == "sharpness")
+      r.Float(s.m_Sharpness);
+    else if (key == "audiodelay")
+      r.Float(s.m_AudioDelay);
+    else if (key == "stereomode")
+      r.Int(s.m_StereoMode, 0, 1000);
+    else if (key == "stereoinvert")
+      r.Bool(s.m_StereoInvert);
+    else if (key == "videostream")
+      r.Int(s.m_VideoStream, -1, 1000);
+    else if (key == "tonemapmethod")
+      r.Enum(s.m_ToneMapMethod, VS_TONEMAPMETHOD_MAX);
+    else if (key == "tonemapparam")
+      r.Float(s.m_ToneMapParam);
+    else if (key == "orientation")
+    {
+      int orientation = 0;
+      if (r.Int(orientation, 0, 359) && orientation % 90 == 0)
+        s.m_Orientation = orientation;
+    }
+    else if (key == "centermixlevel")
+      r.Int(s.m_CenterMixLevel, -1000, 1000);
+    else if (key == "audio")
+      hasAudio = true;
+    else if (key == "sub")
+      hasSubtitle = true;
+    else if (key.substr(0, 6) == "audio.")
+      TrackValue(audio, key.substr(6), r);
+    else if (key.substr(0, 4) == "sub.")
+      TrackValue(subtitle, key.substr(4), r);
+    else if (key == "subchosen")
+      r.Bool(record.subtitleChosen);
+    // (a key of a later version is left out)
+  }
+  if (!versioned)
+    return false;
+  if (hasAudio)
+    record.audio = audio;
+  if (hasSubtitle)
+    record.subtitle = subtitle;
+  return true;
+}
+
+TrackMatch FindTrack(const Track& kept, const std::vector<Track>& streams, bool subtitle)
+{
+  TrackMatch match;
+  if (kept.external)
+  {
+    match.why = "it was a subtitle file beside the video, not a track of it";
+    return match;
+  }
+  const TrackKinds want = KindsOf(kept);
+  int best = -1;
+  int bestScore = -1;
+  std::vector<std::string> bestNotes;
+  size_t sameLanguage = 0;
+  std::vector<Track> placed = streams;
+  AssignPlaces(placed);
+  for (size_t i = 0; i < placed.size(); ++i)
+  {
+    const Track& t = placed[i];
+    if (t.language != kept.language)
+      continue;
+    ++sameLanguage;
+    if (kept.variety != 0 && t.variety != 0 && kept.variety != t.variety)
+      continue;
+    const TrackKinds kinds = KindsOf(t);
+    if (kinds.commentary != want.commentary)
+      continue;
+    if (subtitle ? kinds.forced != want.forced : kinds.description != want.description)
+      continue;
+    int score = 0;
+    std::vector<std::string> notes;
+    if (!kept.name.empty() && Lower(Trimmed(kept.name)) == Lower(Trimmed(t.name)))
+    {
+      score += 16;
+      notes.emplace_back("the same name");
+    }
+    if (kept.variety != 0 && kept.variety == t.variety)
+    {
+      score += 8;
+      notes.emplace_back("the same variety");
+    }
+    if (!kept.codec.empty() && Lower(kept.codec) == Lower(t.codec))
+    {
+      score += 8;
+      notes.emplace_back("the same codec");
+    }
+    if (!subtitle && kept.channels > 0 && kept.channels == t.channels)
+    {
+      score += 4;
+      notes.emplace_back("the same channels");
+    }
+    if (subtitle && kinds.hearingImpaired == want.hearingImpaired)
+    {
+      score += 4;
+      if (want.hearingImpaired)
+        notes.emplace_back("for the hearing impaired");
+    }
+    if (subtitle && TextSubtitle(kept.codec) == TextSubtitle(t.codec))
+      score += 2;
+    if (kept.ordinal >= 0 && kept.ordinal == t.ordinal)
+    {
+      score += 2;
+      notes.emplace_back("the same place among the tracks of its language");
+    }
+    if ((kept.flags & FLAG_ORIGINAL) == (t.flags & FLAG_ORIGINAL))
+      score += 1;
+    if ((kept.flags & FLAG_DUB) == (t.flags & FLAG_DUB))
+      score += 1;
+    if (score > bestScore)
+    {
+      bestScore = score;
+      best = static_cast<int>(i);
+      bestNotes = std::move(notes);
+    }
+  }
+  if (best < 0)
+  {
+    match.why = sameLanguage == 0
+                    ? std::string("this source has no track in that language")
+                    : "this source has " + std::to_string(sameLanguage) +
+                          " in that language, none of the same kind or variety";
+    return match;
+  }
+  match.position = best;
+  match.index = placed[static_cast<size_t>(best)].index;
+  match.why = "the same language" + std::string(bestNotes.empty() ? "" : ", ") +
+              Join(bestNotes, ", ");
+  return match;
+}
+
+void AssignPlaces(std::vector<Track>& tracks)
+{
+  for (size_t i = 0; i < tracks.size(); ++i)
+  {
+    if (tracks[i].index < 0)
+      tracks[i].index = static_cast<int>(i);
+    int ordinal = 0;
+    for (size_t j = 0; j < i; ++j)
+    {
+      if (tracks[j].language == tracks[i].language)
+        ++ordinal;
+    }
+    tracks[i].ordinal = ordinal;
+  }
+}
+
+std::optional<Restoration> Restore(const std::vector<Record>& records,
+                                   const Release& now,
+                                   const CVideoSettings& current,
+                                   const std::vector<Track>& audio,
+                                   const std::vector<Track>& subtitles)
+{
+  if (records.empty())
+    return std::nullopt;
+  Restoration r;
+  r.settings = current;
+  CVideoSettings& s = r.settings;
+  auto& log = r.log;
+  const auto from = [](const Record& record)
+  { return "kept from its playback of " + record.release.Describe(); };
+
+  // the audio track: the last one chosen, by what it is
+  if (const Record* rec = First(records, [](const Record& x) { return x.audio.has_value(); }))
+  {
+    const TrackMatch m = FindTrack(*rec->audio, audio, false);
+    if (m.index >= 0)
+    {
+      s.m_AudioStream = m.index;
+      r.groups |= GROUP_AUDIO;
+      log.push_back("audio: track " + std::to_string(m.index) + " (" +
+                    audio[static_cast<size_t>(m.position)].Describe() + ") for " +
+                    rec->audio->Describe() + " " + from(*rec) + ": " + m.why);
+    }
+    else
+      log.push_back("audio: " + rec->audio->Describe() + " " + from(*rec) +
+                    " is not taken: " + m.why + "; the track is chosen as the settings say");
+  }
+
+  // the subtitles: the last choice of them
+  if (const Record* rec = First(records, [](const Record& x) { return x.subtitleChosen; }))
+  {
+    TrackMatch m;
+    if (rec->subtitle)
+      m = FindTrack(*rec->subtitle, subtitles, true);
+    const bool off = !rec->settings.m_SubtitleOn;
+    if (off || m.index >= 0)
+    {
+      if (m.index >= 0)
+        s.m_SubtitleStream = m.index;
+      s.m_SubtitleOn = !off;
+      s.m_isDefaultVideoSettings = false;
+      r.subtitleChosen = true;
+      r.groups |= GROUP_SUBTITLES;
+      std::string text = off ? "subtitles: off" : "subtitles: on";
+      if (rec->subtitle)
+        text += m.index >= 0 ? ", track " + std::to_string(m.index) + " (" +
+                                   subtitles[static_cast<size_t>(m.position)].Describe() +
+                                   ") for " + rec->subtitle->Describe() + " (" + m.why + ")"
+                             : ", " + rec->subtitle->Describe() + " not in this source (" +
+                                   m.why + ")";
+      log.push_back(text + ", " + from(*rec));
+    }
+    else if (rec->subtitle)
+      log.push_back("subtitles: " + rec->subtitle->Describe() + " " + from(*rec) +
+                    " are not taken: " + m.why + "; they are chosen as the settings say");
+    else
+      log.push_back("subtitles: shown " + from(*rec) +
+                    " with no track to show: they are chosen as the settings say");
+  }
+
+  // the zoom and the view mode: from a picture of the same shape
+  if (const Record* rec =
+          First(records, [&now](const Record& x)
+                { return SameShape(x.release.picture, now.picture); }))
+  {
+    const CVideoSettings& k = rec->settings;
+    if (s.m_ViewMode != k.m_ViewMode || s.m_CustomZoomAmount != k.m_CustomZoomAmount ||
+        s.m_CustomPixelRatio != k.m_CustomPixelRatio ||
+        s.m_CustomVerticalShift != k.m_CustomVerticalShift ||
+        s.m_CustomNonLinStretch != k.m_CustomNonLinStretch)
+    {
+      s.m_ViewMode = k.m_ViewMode;
+      s.m_CustomZoomAmount = k.m_CustomZoomAmount;
+      s.m_CustomPixelRatio = k.m_CustomPixelRatio;
+      s.m_CustomVerticalShift = k.m_CustomVerticalShift;
+      s.m_CustomNonLinStretch = k.m_CustomNonLinStretch;
+      r.groups |= GROUP_VIEW;
+      log.push_back("view mode " + std::to_string(k.m_ViewMode) + ", zoom " +
+                    Number(k.m_CustomZoomAmount) + ", pixel ratio " +
+                    Number(k.m_CustomPixelRatio) + ", vertical shift " +
+                    Number(k.m_CustomVerticalShift) + ", " + from(*rec) +
+                    " (a picture of the same shape)");
+    }
+  }
+  else
+    log.push_back("view mode and zoom: none kept for a picture of this shape");
+
+  // the picture settings: from a video of the same format
+  if (const Record* rec =
+          First(records, [&now](const Record& x)
+                { return SameFormat(x.release.picture, now.picture); }))
+  {
+    const CVideoSettings& k = rec->settings;
+    const CVideoSettings before = s;
+    s.m_InterlaceMethod = k.m_InterlaceMethod;
+    s.m_ScalingMethod = k.m_ScalingMethod;
+    s.m_Brightness = k.m_Brightness;
+    s.m_Contrast = k.m_Contrast;
+    s.m_Gamma = k.m_Gamma;
+    s.m_Sharpness = k.m_Sharpness;
+    s.m_NoiseReduction = k.m_NoiseReduction;
+    s.m_PostProcess = k.m_PostProcess;
+    s.m_ToneMapMethod = k.m_ToneMapMethod;
+    s.m_ToneMapParam = k.m_ToneMapParam;
+    s.m_Orientation = k.m_Orientation;
+    s.m_StereoMode = k.m_StereoMode;
+    s.m_StereoInvert = k.m_StereoInvert;
+    if (before != s)
+    {
+      r.groups |= GROUP_PICTURE;
+      log.push_back("picture settings (upscaler " + std::to_string(k.m_ScalingMethod) +
+                    ", deinterlacing " + std::to_string(k.m_InterlaceMethod) + ", tone mapping " +
+                    std::to_string(k.m_ToneMapMethod) + ", brightness " + Number(k.m_Brightness) +
+                    ", contrast " + Number(k.m_Contrast) + "...), " + from(*rec) +
+                    " (a video of the same format)");
+    }
+  }
+  else
+    log.push_back("picture settings: none kept for a video of this format");
+
+  // the volume amplification and the level of the centre: from the same cut
+  if (const Record* rec =
+          First(records, [&now](const Record& x) { return SameCut(x.release, now); }))
+  {
+    const CVideoSettings& k = rec->settings;
+    if (s.m_VolumeAmplification != k.m_VolumeAmplification ||
+        s.m_CenterMixLevel != k.m_CenterMixLevel)
+    {
+      s.m_VolumeAmplification = k.m_VolumeAmplification;
+      s.m_CenterMixLevel = k.m_CenterMixLevel;
+      r.groups |= GROUP_AUDIO_LEVEL;
+      log.push_back("volume amplification " + Number(k.m_VolumeAmplification) +
+                    " dB, centre level " + std::to_string(k.m_CenterMixLevel) + ", " + from(*rec) +
+                    " (the same cut)");
+    }
+  }
+  else
+    log.push_back("volume amplification and centre level: none kept for this cut (a length "
+                  "within " +
+                  std::to_string(SameCutToleranceMs(now.durationMs) / 1000) + " s)");
+
+  // the delays and the video stream: only from the same release
+  if (const Record* rec =
+          First(records, [&now](const Record& x) { return SameRelease(x.release, now); }))
+  {
+    const CVideoSettings& k = rec->settings;
+    const bool delays =
+        s.m_AudioDelay != k.m_AudioDelay || s.m_SubtitleDelay != k.m_SubtitleDelay;
+    s.m_AudioDelay = k.m_AudioDelay;
+    s.m_SubtitleDelay = k.m_SubtitleDelay;
+    if (delays)
+    {
+      r.groups |= GROUP_DELAYS;
+      log.push_back("audio delay " + Seconds(k.m_AudioDelay) + ", subtitle delay " +
+                    Seconds(k.m_SubtitleDelay) + ", " + from(*rec) + " (the same release)");
+    }
+    if (k.m_VideoStream >= 0 && k.m_VideoStream < now.videoStreams &&
+        s.m_VideoStream != k.m_VideoStream)
+    {
+      s.m_VideoStream = k.m_VideoStream;
+      log.push_back("video stream " + std::to_string(k.m_VideoStream) + ", " + from(*rec) +
+                    " (the same release)");
+    }
+  }
+  else
+    log.push_back("audio and subtitle delays: kept only for the same release (the same length "
+                  "to the second and the same video), and none was kept for this one");
+
+  return r;
+}
+
+} // namespace KODI::FILMMEMORY
