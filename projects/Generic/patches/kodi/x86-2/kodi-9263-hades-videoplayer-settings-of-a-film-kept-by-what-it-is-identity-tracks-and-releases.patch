+// ---- the text of a record
+
+TEST(TestFilmMemory, ARecordReadsAsItWasWritten)
+{
+  Record r;
+  r.release = R(FILM);
+  r.release.picture.stereo = "left_right";
+  r.release.videoStreams = 2;
+  r.settings.m_InterlaceMethod = VS_INTERLACEMETHOD_RENDER_BOB;
+  r.settings.m_ScalingMethod = VS_SCALINGMETHOD_LANCZOS3;
+  r.settings.m_ViewMode = ViewModeCustom;
+  r.settings.m_CustomZoomAmount = 1.3333334f;
+  r.settings.m_CustomPixelRatio = 0.97f;
+  r.settings.m_CustomVerticalShift = -0.125f;
+  r.settings.m_CustomNonLinStretch = true;
+  r.settings.m_VolumeAmplification = 6.5f;
+  r.settings.m_SubtitleDelay = -1.25f;
+  r.settings.m_SubtitleOn = false;
+  r.settings.m_Brightness = 52.0f;
+  r.settings.m_Contrast = 48.5f;
+  r.settings.m_Gamma = 21.0f;
+  r.settings.m_NoiseReduction = 0.1f;
+  r.settings.m_PostProcess = true;
+  r.settings.m_Sharpness = 0.25f;
+  r.settings.m_AudioDelay = 0.075f;
+  r.settings.m_StereoMode = 3;
+  r.settings.m_StereoInvert = true;
+  r.settings.m_VideoStream = 1;
+  r.settings.m_ToneMapMethod = VS_TONEMAPMETHOD_BT2390;
+  r.settings.m_ToneMapParam = 1.5f;
+  r.settings.m_Orientation = 180;
+  r.settings.m_CenterMixLevel = 3;
+  r.audio = T("spa", "Castellano \\ \"DTS-HD\"\nline", "truehd", 8, FLAG_DEFAULT);
+  r.audio->variety = SPAIN;
+  r.audio->index = 3;
+  r.audio->ordinal = 1;
+  r.subtitle = T("eng", "Forced", "subrip", 0, FLAG_FORCED);
+  r.subtitle->external = true;
+  r.subtitleChosen = true;
+
+  Record back;
+  ASSERT_TRUE(Parse(Serialize(r), CVideoSettings(), back));
+  EXPECT_FALSE(back.settings != r.settings) << Serialize(back);
+  EXPECT_EQ(r.release.durationMs, back.release.durationMs);
+  EXPECT_EQ(3840, back.release.picture.width);
+  EXPECT_EQ(1600, back.release.picture.height);
+  EXPECT_FLOAT_EQ(2.4f, back.release.picture.aspect);
+  EXPECT_EQ(1, back.release.picture.hdr);
+  EXPECT_EQ("left_right", back.release.picture.stereo);
+  EXPECT_EQ(2, back.release.videoStreams);
+  ASSERT_TRUE(back.audio.has_value());
+  EXPECT_EQ(r.audio->name, back.audio->name);
+  EXPECT_EQ("spa", back.audio->language);
+  EXPECT_EQ(SPAIN, back.audio->variety);
+  EXPECT_EQ("truehd", back.audio->codec);
+  EXPECT_EQ(8, back.audio->channels);
+  EXPECT_EQ(FLAG_DEFAULT, back.audio->flags);
+  EXPECT_EQ(3, back.audio->index);
+  EXPECT_EQ(1, back.audio->ordinal);
+  ASSERT_TRUE(back.subtitle.has_value());
+  EXPECT_TRUE(back.subtitle->external);
+  EXPECT_EQ(FLAG_FORCED, back.subtitle->flags);
+  EXPECT_TRUE(back.subtitleChosen);
+}
