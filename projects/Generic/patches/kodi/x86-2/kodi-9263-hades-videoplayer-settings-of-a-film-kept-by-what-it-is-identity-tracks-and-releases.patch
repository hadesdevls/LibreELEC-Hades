+TEST(TestFilmMemory, SubtitlesNotInThisSourceAreLeftToTheSettings)
+{
+  CVideoSettings current;
+  current.m_isDefaultVideoSettings = true;
+  const auto noSpanish = Placed({T("eng", "", "subrip", 0), T("fre", "", "subrip", 0)});
+  const auto r = Restore({Kept(R(FILM))}, R(FILM), current, AUDIO, noSpanish);
+  ASSERT_TRUE(r.has_value());
+  EXPECT_EQ(-1, r->settings.m_SubtitleStream);
+  EXPECT_TRUE(r->settings.m_SubtitleOn);
+  EXPECT_EQ(std::optional<bool>(true), r->settings.m_isDefaultVideoSettings);
+  EXPECT_FALSE(r->subtitleChosen);
+  EXPECT_EQ(0u, r->groups & GROUP_SUBTITLES);
+  // but subtitles turned off stay off, in any source
+  Record off = Kept(R(FILM));
+  off.settings.m_SubtitleOn = false;
+  const auto o = Restore({off}, R(FILM), current, AUDIO, noSpanish);
+  ASSERT_TRUE(o.has_value());
+  EXPECT_FALSE(o->settings.m_SubtitleOn);
+  EXPECT_EQ(-1, o->settings.m_SubtitleStream);
+  EXPECT_EQ(std::optional<bool>(false), o->settings.m_isDefaultVideoSettings);
+  EXPECT_NE(0u, o->groups & GROUP_SUBTITLES);
+}
+
+TEST(TestFilmMemory, EachSettingFromTheLastPlaybackItAppliesTo)
+{
+  // the last playback, of another cut in 1080p, chose English; the one before, of this release,
+  // Spanish and its delays
+  Record last = Kept(R(FILM + 20 * 60 * 1000, 1920, 800, 2.4f, 0));
+  last.audio = T("eng", "", "ac3", 6);
+  last.settings.m_AudioDelay = 0.9f;
+  last.settings.m_ScalingMethod = VS_SCALINGMETHOD_LANCZOS3;
+  const auto r = Restore({last, Kept(R(FILM))}, R(FILM), CVideoSettings(), AUDIO, SUBTITLES);
+  ASSERT_TRUE(r.has_value());
+  EXPECT_EQ(0, r->settings.m_AudioStream);
+  EXPECT_EQ(0.2f, r->settings.m_AudioDelay);
+  EXPECT_EQ(VS_SCALINGMETHOD_SPLINE36, r->settings.m_ScalingMethod);
+  EXPECT_FALSE(r->log.empty());
+}
+
+TEST(TestFilmMemory, NothingKeptNothingRestored)
+{
+  EXPECT_FALSE(Restore({}, R(FILM), CVideoSettings(), AUDIO, SUBTITLES).has_value());
+  // a record with Kodi's defaults and no choice changes nothing
+  Record plain;
+  plain.release = R(FILM);
+  const auto r = Restore({plain}, R(FILM), CVideoSettings(), AUDIO, SUBTITLES);
+  ASSERT_TRUE(r.has_value());
+  EXPECT_EQ(0u, r->groups);
+  EXPECT_FALSE(r->settings != CVideoSettings());
+}
