+// ---- tracks by what they are
+
+TEST(TestFilmMemory, AnAudioTrackIsFoundByWhatItIsNotByItsNumber)
+{
+  Track kept = T("spa", "Castellano", "truehd", 8);
+  kept.index = 3;
+  kept.ordinal = 1;
+  // another release: other order, the Spanish of Spain in another codec
+  const auto streams = Placed({T("spa", "Latino", "ac3", 6), T("spa", "Castellano", "ac3", 6),
+                               T("eng", "", "truehd", 8)});
+  const TrackMatch m = FindTrack(kept, streams, false);
+  EXPECT_EQ(1, m.index) << m.why;
+  EXPECT_EQ(1, m.position);
+}
+
+TEST(TestFilmMemory, TheNumberOfATrackInAnotherReleaseIsNotTaken)
+{
+  // the Spanish track was the first of the release kept; this one has the English one first
+  Track kept = T("spa", "Castellano", "ac3", 6);
+  kept.index = 0;
+  kept.ordinal = 0;
+  const auto streams = Placed({T("eng", "", "ac3", 6), T("spa", "Castellano", "ac3", 6)});
+  EXPECT_EQ(1, FindTrack(kept, streams, false).index);
+  // the forced subtitles were the second track; here the second is the full one
+  Track forced = T("eng", "", "subrip", 0, FLAG_FORCED);
+  forced.index = 1;
+  const auto subtitles = Placed({T("eng", "", "subrip", 0, FLAG_FORCED), T("eng", "", "subrip", 0)});
+  EXPECT_EQ(0, FindTrack(forced, subtitles, true).index);
+  // and where the language is not there at all, no other track is taken by its number
+  EXPECT_EQ(-1, FindTrack(kept, Placed({T("eng", "", "ac3", 6), T("fre", "", "ac3", 6)}), false).index);
+}
+
+TEST(TestFilmMemory, AnotherVarietyIsNotTheTrackKept)
+{
+  Track kept = T("spa", "", "eac3", 6);
+  kept.variety = SPAIN;
+  auto latino = T("spa", "", "eac3", 6);
+  latino.variety = LATIN_AMERICA;
+  EXPECT_EQ(-1, FindTrack(kept, Placed({latino}), false).index);
+  // where the variety of one of them is not known, the language decides
+  EXPECT_EQ(0, FindTrack(kept, Placed({T("spa", "", "ac3", 2)}), false).index);
+}
+
+TEST(TestFilmMemory, ACommentaryIsNeverTakenForTheFilm)
+{
+  const Track kept = T("eng", "", "truehd", 8);
+  const auto streams = Placed({T("eng", "Director's commentary", "ac3", 2),
+                               T("eng", "", "ac3", 2, FLAG_COMMENT)});
+  const TrackMatch m = FindTrack(kept, streams, false);
+  EXPECT_EQ(-1, m.index);
+  EXPECT_FALSE(m.why.empty());
+  // nor an audio description
+  EXPECT_EQ(-1, FindTrack(kept, Placed({T("eng", "", "eac3", 6, FLAG_VISUAL_IMPAIRED)}), false).index);
+  // and the other way round
+  EXPECT_EQ(-1, FindTrack(T("eng", "Commentary", "ac3", 2), Placed({kept}), false).index);
+}
+
+TEST(TestFilmMemory, AForcedSubtitleIsNotTheFullOne)
+{
+  const Track forced = T("eng", "", "hdmv_pgs_subtitle", 0, FLAG_FORCED);
+  // (one release flags it, another only names it)
+  const auto streams = Placed({T("eng", "English", "subrip", 0), T("eng", "English Forced", "subrip", 0),
+                               T("eng", "SDH", "subrip", 0, FLAG_HEARING_IMPAIRED)});
+  EXPECT_EQ(1, FindTrack(forced, streams, true).index);
+  // the full ones: the one for the hearing impaired where that was kept
+  EXPECT_EQ(2, FindTrack(T("eng", "", "subrip", 0, FLAG_HEARING_IMPAIRED), streams, true).index);
+  EXPECT_EQ(0, FindTrack(T("eng", "", "subrip", 0), streams, true).index);
+  // a release with only the full ones has no forced subtitles
+  EXPECT_EQ(-1, FindTrack(forced, Placed({T("eng", "", "subrip", 0)}), true).index);
+}
+
+TEST(TestFilmMemory, NoTrackOfAnotherLanguageOrBesideTheVideo)
+{
+  const TrackMatch m = FindTrack(T("fre", "", "ac3", 6), Placed({T("eng", "", "ac3", 6)}), false);
+  EXPECT_EQ(-1, m.index);
+  EXPECT_NE(std::string::npos, m.why.find("no track in that language"));
+  Track external = T("spa", "", "subrip", 0);
+  external.external = true;
+  EXPECT_EQ(-1, FindTrack(external, Placed({T("spa", "", "subrip", 0)}), true).index);
+  EXPECT_EQ(-1, FindTrack(T("eng", "", "ac3", 6), {}, false).index);
+}
+
+TEST(TestFilmMemory, TheSamePlaceAmongTheTracksOfItsLanguage)
+{
+  // two English tracks that tell nothing apart: the second one kept is the second one
+  Track kept = T("eng", "", "ac3", 6);
+  kept.ordinal = 1;
+  const auto streams = Placed({T("ger", "", "ac3", 6), T("eng", "", "ac3", 6), T("eng", "", "ac3", 6)});
+  EXPECT_EQ(2, FindTrack(kept, streams, false).index);
+}
