+#pragma once
+
+#include "cores/VideoSettings.h"
+
+#include <cstdint>
+#include <optional>
+#include <string>
+#include <string_view>
+#include <vector>
+
+/*!
+ * \brief Hades: the settings of a film or an episode that an add-on plays, kept by what it is and
+ *        not by its path ("Remember the settings of films from add-ons", videoplayer.hadesfilmmemory)
+ *
+ * Kodi keeps the settings of a video (its audio and subtitle tracks, their delays, the zoom, the
+ * picture settings) for its file, by its path. An add-on can play the same film from another source
+ * each time, often another release of it, and those settings were lost every time. Here they are
+ * kept for the film or episode itself, named by
+ * the ids its add-on gives it (IMDb, TMDb, TVDb; season and episode for an episode), one record
+ * for each release of it that played (its length and the format of its video), and each setting is
+ * taken from the most recent record where it applies to the release that plays now:
+ *  - the audio and subtitle tracks: from any release, matched by what they are (language and its
+ *    variety, the kind of track, name, codec, channels), never by their number, and only where the
+ *    release that plays has such a track (FindTrack());
+ *  - the zoom and the rest of the view mode: from a release whose picture has the same shape;
+ *  - the picture settings (upscaler, deinterlacing, brightness, contrast, gamma, sharpness, noise
+ *    reduction, tone mapping, orientation, stereoscopic mode): from one whose video has the same
+ *    format (size, HDR type, stereoscopic layout);
+ *  - the volume amplification and the level of the centre: from the same cut (a length within
+ *    SameCutToleranceMs());
+ *  - the audio and subtitle delays and the video stream chosen: only from the same release (the same
+ *    length to the second and the same video): another release, or another cut of the film, is
+ *    timed otherwise.
+ * Only pure logic here, no state: the player (FilmMemoryItem.h) gives the facts of what plays, the
+ * application keeps the records in the video database (CVideoDatabase::GetFilmSettings()).
+ */
+namespace KODI::FILMMEMORY
+{
+
+enum class Kind
+{
+  MOVIE,
+  EPISODE,
+};
+
+//! What a video is, by the ids its add-on gave it
+struct Identity
+{
+  Kind kind{Kind::MOVIE};
+  std::string imdb; //!< "tt" and 7 to 10 digits, lower case; empty when not given
+  std::string tmdb; //!< 1 to 10 digits, not 0; empty when not given
+  std::string tvdb; //!< 1 to 10 digits, not 0; empty when not given
+  int season{-1}; //!< of an episode (0 for its specials)
+  int episode{-1}; //!< of an episode
+
+  //! For the log: "film imdb tt0111161 tmdb 278", "episode S01E02 of tvdb 81189"
+  std::string Describe() const;
+  //! The text of its kind in the database ("movie", "episode")
+  const char* KindText() const { return kind == Kind::EPISODE ? "episode" : "movie"; }
+};
+
+/*!
+ * \brief The identity of a video from what its add-on said of it: its media type ("movie" or
+ *        "episode"; nothing else is named here), its unique ids, and, for an episode, its season and
+ *        number. Ids that are not of their form are left out ("None", "0", an empty text...).
+ * \return nothing when no id is left, or for an episode without a season and a number
+ */
+std::optional<Identity> IdentityOf(std::string_view mediaType,
+                                   std::string_view imdb,
+                                   std::string_view tmdb,
+                                   std::string_view tvdb,
+                                   int season,
+                                   int episode);
+
+/*!
+ * \brief Whether two identities are the same film or episode: the same kind (and season and
+ *        number), at least one id in common, and no id of the same type that differs (an add-on that
+ *        gives another IMDb id for the same TMDb id is not trusted with either).
+ */
+bool SameVideo(const Identity& a, const Identity& b);
+
+//! An audio or subtitle track, by what it is
+struct Track
+{
+  std::string language; //!< ISO 639-2/B, lower case; empty when none or undetermined
+  int variety{0}; //!< KODI::UTILS::LanguageVariety (castellano or latino...); 0 when not known
+  std::string name; //!< its title in the file
+  std::string codec;
+  int channels{0};
+  int flags{0}; //!< StreamFlags
+  bool external{false}; //!< a subtitle file beside the video, not a stream of it
+  int index{-1}; //!< its number among the tracks of its type (for the log)
+  int ordinal{-1}; //!< its place among the tracks of its type in its language (0 the first)
+
+  //! For the log: "spa (es), \"Castellano\", truehd, 8 channels, forced"
+  std::string Describe() const;
+};
+
+//! The video of a release
+struct Picture
+{
+  int width{0};
+  int height{0};
+  float aspect{0.0f}; //!< display aspect ratio; 0 when not known
+  int hdr{0}; //!< StreamHdrType
+  std::string stereo; //!< stereoscopic layout; empty for 2D
+};
+
+//! A release of a film or an episode: what tells one from another
+struct Release
+{
+  int64_t durationMs{0}; //!< 0 when not known
+  Picture picture;
+  int videoStreams{0};
+
+  //! For the log: "2:01:13, 3840x1600 HDR10"
+  std::string Describe() const;
+};
+
+constexpr int64_t SAME_RELEASE_MS = 1000;
+/*!
+ * \brief How far apart the lengths of two releases of the same cut can be: 0.5 % of the length,
+ *        5 s at least and 30 s at most. Releases of one cut differ by the logos of a distributor or
+ *        a studio (seconds); another cut (extended, director's, unrated) adds or takes minutes, and
+ *        the closest ones seen, such as the final cut of Blade Runner, 44 s.
+ */
+int64_t SameCutToleranceMs(int64_t durationMs);
+bool SameRelease(const Release& a, const Release& b);
+bool SameCut(const Release& a, const Release& b);
+bool SameFormat(const Picture& a, const Picture& b);
+bool SameShape(const Picture& a, const Picture& b);
+
+//! What is kept of one playback of a release
+struct Record
+{
+  Release release;
+  CVideoSettings settings; //!< as the video was left (its track numbers are not used)
+  std::optional<Track> audio; //!< the audio track the user chose
+  std::optional<Track> subtitle; //!< the subtitle track chosen or shown
+  bool subtitleChosen{false}; //!< the user chose the subtitles (a track, or on or off)
+};
+
+//! A record as the video database keeps it (CVideoDatabase::GetFilmSettings())
+struct StoredRecord
+{
+  int id{-1};
+  Identity identity; //!< the ids it was kept with
+  std::string text; //!< Serialize()
+};
+
+//! The text of a record in the database: "key=value" lines, a version first
+std::string Serialize(const Record& record);
+/*!
+ * \brief A record from its text; what it does not say, or says with a value that is not valid
+ *        here (a later version's), is taken from \p defaults; keys not known are left out
+ * \return false where the text is not a record
+ */
+bool Parse(std::string_view text, const CVideoSettings& defaults, Record& record);
+
+struct TrackMatch
+{
+  int index{-1}; //!< the number (Track::index) of the track that is the one kept; -1 when none is
+  int position{-1}; //!< its place in the list given
+  std::string why; //!< for the log
+};
+
+//! Numbers the tracks of a list by their place where they have none, and gives each its place
+//! among those of its language (Track::ordinal)
+void AssignPlaces(std::vector<Track>& tracks);
+
+/*!
+ * \brief The track that is the one kept, among the tracks of the release that plays: the same
+ *        language (and variety, where both are known), the same kind (forced or not, commentary or
+ *        not, audio description or not), then the closest by name, codec, channels, hearing impaired,
+ *        and the same place among the tracks of that language. A subtitle file beside the video
+ *        that was kept is not looked for: the release that plays has its own.
+ */
+TrackMatch FindTrack(const Track& kept, const std::vector<Track>& streams, bool subtitle);
+
+//! The settings restored
+enum Group : unsigned
+{
+  GROUP_AUDIO = 1u << 0,
+  GROUP_SUBTITLES = 1u << 1,
+  GROUP_VIEW = 1u << 2,
+  GROUP_PICTURE = 1u << 3,
+  GROUP_AUDIO_LEVEL = 1u << 4,
+  GROUP_DELAYS = 1u << 5,
+};
+
+struct Restoration
+{
+  CVideoSettings settings; //!< what the video starts with
+  unsigned groups{0}; //!< Group: what was restored (and changed something)
+  bool subtitleChosen{false}; //!< a choice of subtitles was taken again
+  std::vector<std::string> log; //!< what was taken, from which playback, and what was not and why
+};
+
+/*!
+ * \brief What a video starts with, from the records kept for it (the most recently played first)
+ * \param current what it starts with otherwise (Kodi's default, or what was kept for its path)
+ * \param audio, subtitles the tracks of the release that plays, in their order
+ * \return nothing where no record is given
+ */
+std::optional<Restoration> Restore(const std::vector<Record>& records,
+                                   const Release& now,
+                                   const CVideoSettings& current,
+                                   const std::vector<Track>& audio,
+                                   const std::vector<Track>& subtitles);
+
+//! At most this many records for a film or an episode (the least recently played go first) ...
+constexpr int RECORDS_PER_VIDEO = 8;
+//! ... and this many in all
+constexpr int RECORDS_IN_ALL = 4000;
+
+} // namespace KODI::FILMMEMORY
