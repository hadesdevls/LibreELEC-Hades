+namespace
+{
+// (as KODI::UTILS::LanguageVariety numbers them)
+constexpr int SPAIN = 1;
+constexpr int LATIN_AMERICA = 2;
+
+Track T(std::string language, std::string name, std::string codec, int channels, int flags = 0)
+{
+  Track t;
+  t.language = std::move(language);
+  t.name = std::move(name);
+  t.codec = std::move(codec);
+  t.channels = channels;
+  t.flags = flags;
+  return t;
+}
+
+std::vector<Track> Placed(std::vector<Track> tracks)
+{
+  AssignPlaces(tracks);
+  return tracks;
+}
+
+Release R(int64_t ms, int w = 3840, int h = 1600, float aspect = 2.4f, int hdr = 1)
+{
+  Release r;
+  r.durationMs = ms;
+  r.picture.width = w;
+  r.picture.height = h;
+  r.picture.aspect = aspect;
+  r.picture.hdr = hdr;
+  r.videoStreams = 1;
+  return r;
+}
+
+constexpr int64_t FILM = 2 * 3600 * 1000 + 13 * 60 * 1000; // 2:13:00
+} // namespace
+
+// ---- what a video is
+
+TEST(TestFilmMemory, IdentityOfAFilm)
+{
+  const auto id = IdentityOf("movie", "tt0111161", "278", "", -1, -1);
+  ASSERT_TRUE(id.has_value());
+  EXPECT_EQ(Kind::MOVIE, id->kind);
+  EXPECT_EQ("tt0111161", id->imdb);
+  EXPECT_EQ("278", id->tmdb);
+  EXPECT_TRUE(id->tvdb.empty());
+  // (as an add-on writes ids it does not have: Python's str(None), a 0)
+  const auto partial = IdentityOf("Movie", " TT0111161 ", "None", "0", -1, -1);
+  ASSERT_TRUE(partial.has_value());
+  EXPECT_EQ("tt0111161", partial->imdb);
+  EXPECT_TRUE(partial->tmdb.empty());
+  EXPECT_TRUE(partial->tvdb.empty());
+}
+
+TEST(TestFilmMemory, NoIdentityWithoutIdsOrOfOtherVideos)
+{
+  EXPECT_FALSE(IdentityOf("movie", "", "None", "0", -1, -1).has_value());
+  EXPECT_FALSE(IdentityOf("movie", "tt12", "abc", "", -1, -1).has_value());
+  // (a generic video, a show, a music video: no film nor episode is named)
+  EXPECT_FALSE(IdentityOf("video", "tt0111161", "278", "", -1, -1).has_value());
+  EXPECT_FALSE(IdentityOf("tvshow", "tt0944947", "1399", "121361", -1, -1).has_value());
+  EXPECT_FALSE(IdentityOf("", "tt0111161", "", "", -1, -1).has_value());
+  // an episode needs its season and its number
+  EXPECT_FALSE(IdentityOf("episode", "tt0944947", "1399", "121361", -1, 3).has_value());
+  EXPECT_FALSE(IdentityOf("episode", "tt0944947", "1399", "121361", 1, -1).has_value());
+}
+
+TEST(TestFilmMemory, AnEpisodeIsNamedByItsShowSeasonAndNumber)
+{
+  // (add-ons give the ids of the show with the season and the number of the episode)
+  const auto e = IdentityOf("episode", "tt0944947", "1399", "121361", 1, 2);
+  ASSERT_TRUE(e.has_value());
+  EXPECT_EQ(Kind::EPISODE, e->kind);
+  const auto same = IdentityOf("episode", "tt0944947", "", "", 1, 2);
+  const auto next = IdentityOf("episode", "tt0944947", "1399", "121361", 1, 3);
+  const auto otherSeason = IdentityOf("episode", "tt0944947", "1399", "121361", 2, 2);
+  ASSERT_TRUE(same && next && otherSeason);
+  EXPECT_TRUE(SameVideo(*e, *same));
+  EXPECT_FALSE(SameVideo(*e, *next));
+  EXPECT_FALSE(SameVideo(*e, *otherSeason));
+}
+
+TEST(TestFilmMemory, TwoFilmsAreNeverMixed)
+{
+  const auto a = IdentityOf("movie", "tt0111161", "278", "", -1, -1);
+  const auto byTmdb = IdentityOf("movie", "", "278", "", -1, -1);
+  const auto other = IdentityOf("movie", "tt0068646", "238", "", -1, -1);
+  // the same TMDb id with another IMDb id: one of the two is wrong, neither is trusted
+  const auto conflict = IdentityOf("movie", "tt0068646", "278", "", -1, -1);
+  // no id of the same type in common
+  const auto unrelated = IdentityOf("movie", "", "", "81189", -1, -1);
+  // an episode with the ids of a film
+  const auto episode = IdentityOf("episode", "tt0111161", "278", "", 1, 1);
+  ASSERT_TRUE(a && byTmdb && other && conflict && unrelated && episode);
+  EXPECT_TRUE(SameVideo(*a, *byTmdb));
+  EXPECT_FALSE(SameVideo(*a, *other));
+  EXPECT_FALSE(SameVideo(*a, *conflict));
+  EXPECT_FALSE(SameVideo(*a, *unrelated));
+  EXPECT_FALSE(SameVideo(*a, *episode));
+}
