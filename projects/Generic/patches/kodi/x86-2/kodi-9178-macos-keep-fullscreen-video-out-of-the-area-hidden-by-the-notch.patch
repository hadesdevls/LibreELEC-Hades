From 6036860cc9c385fe2ae3475e487b2ce1b6e03b66 Mon Sep 17 00:00:00 2001
From: ksooo <kai.sommerfeld@gmx.com>
Date: Mon, 9 Nov 2026 15:13:05 +0100
Subject: [PATCH] [macOS] Keep fullscreen video out of the area hidden by the
 notch

On displays with a notch, macOS reports the hidden strip as GUI inset and
Kodi's window does not cover it. The GUI keeps out of the inset, but the
fullscreen video rectangle spans the whole resolution, so the video ends
up shifted by half the inset and its bottom is cut off.

(cherry picked from commit 89a31c59dad02b89d4fb46aaf1c9303cbcccfe59)
---
 xbmc/windowing/GraphicContext.cpp | 7 +++++++
 1 file changed, 7 insertions(+)

diff --git a/xbmc/windowing/GraphicContext.cpp b/xbmc/windowing/GraphicContext.cpp
index 2c0cf69..8c6e12d 100644
--- a/xbmc/windowing/GraphicContext.cpp
+++ b/xbmc/windowing/GraphicContext.cpp
@@ -306,6 +306,13 @@ const CRect CGraphicContext::GetViewWindow() const
     rect.y1 = (float)info.Overscan.top;
     rect.x2 = (float)info.Overscan.right;
     rect.y2 = (float)info.Overscan.bottom;
+#if defined(TARGET_DARWIN_OSX)
+    // The area macOS reports as inset (the notch) is outside of the window there.
+    rect.x1 += info.guiInsets.left;
+    rect.y1 += info.guiInsets.top;
+    rect.x2 -= info.guiInsets.right;
+    rect.y2 -= info.guiInsets.bottom;
+#endif
     return rect;
   }
   return m_videoRect;
-- 
