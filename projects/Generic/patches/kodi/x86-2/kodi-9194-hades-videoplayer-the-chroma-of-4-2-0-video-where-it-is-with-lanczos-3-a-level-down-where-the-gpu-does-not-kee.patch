+bool CLinuxRendererGLES::Chroma420()
+{
+  const EShaderFormat format = GetShaderFormat();
+  if (format == SHADER_NV12 || format == SHADER_NV12_RRG)
+    return true;
+  if (format < SHADER_YV12 || format > SHADER_YV12_16)
+    return false;
+  const AVPixFmtDescriptor* desc = av_pix_fmt_desc_get(m_format);
+  return desc && desc->log2_chroma_w == 1 && desc->log2_chroma_h == 1;
+}
+
+KODI::CHROMA::Filter CLinuxRendererGLES::ChromaFilter()
+{
+  if (!Chroma420())
+    return KODI::CHROMA::Filter::KODI;
+  // (the scaling method Nearest takes the chroma as it takes the luma: the sample nearest to each
+  // pixel, now where the video places it)
+  if (m_scalingMethod == VS_SCALINGMETHOD_NEAREST)
+    return KODI::CHROMA::Filter::SITED;
+  return m_chroma.Current();
+}
+
+void CLinuxRendererGLES::SetChroma(BaseYUV2RGBGLSLShader* shader, int width, int height) const
+{
+  shader->SetChroma(std::max(width, 1), std::max(height, 1),
+                    KODI::CHROMA::ShiftOf(m_chromaLocation));
+  // the filters of more than one sample read each sample at the centre of its texel, where a
+  // bilinear filter of fixed-point weights may weigh a neighbour in by a step where the centre falls
+  // a hair short of it: their chroma textures, bound to units 1 and 2, are read GL_NEAREST (the
+  // others keep the filter that UpdateVideoFilter() or the renderer of the decoder gave them,
+  // GL_LINEAR)
+  // (SITED: the filter Kodi gives them, as UpdateVideoFilter() sets it, back where a level of more
+  // samples set GL_NEAREST before a step down)
+  const KODI::CHROMA::Filter filter = shader->ChromaFilter();
+  if (filter == KODI::CHROMA::Filter::KODI)
+    return;
+  const GLint wanted = filter == KODI::CHROMA::Filter::LANCZOS3 ||
+                               filter == KODI::CHROMA::Filter::SPLINE16 ||
+                               (m_renderQuality == RQ_SINGLEPASS &&
+                                m_scalingMethod == VS_SCALINGMETHOD_NEAREST)
+                           ? GL_NEAREST
+                           : GL_LINEAR;
+  for (GLenum unit : {GL_TEXTURE1, GL_TEXTURE2})
+  {
+    glActiveTexture(unit);
+    glTexParameteri(m_textureTarget, GL_TEXTURE_MIN_FILTER, wanted);
+    glTexParameteri(m_textureTarget, GL_TEXTURE_MAG_FILTER, wanted);
+  }
+  glActiveTexture(GL_TEXTURE0);
+}
+
+void CLinuxRendererGLES::TellChroma(KODI::CHROMA::Filter filter)
+{
+  if (m_chromaTold)
+    return;
+  m_chromaTold = true;
+  if (filter == KODI::CHROMA::Filter::KODI && !m_chroma.Forced())
+  {
+    CLog::Log(LOGINFO,
+              "Chroma: the chroma of this {}x{} video is not 4:2:0 in a format whose chroma the "
+              "shaders take ({}): Kodi's own sampling",
+              m_sourceWidth, m_sourceHeight,
+              fmt::formatter<EShaderFormat>::ToString(GetShaderFormat()));
+    return;
+  }
+  const bool nearest = filter == KODI::CHROMA::Filter::SITED && m_scalingMethod == VS_SCALINGMETHOD_NEAREST;
+  CLog::Log(LOGINFO,
+            "Chroma: the 4:2:0 chroma of this {}x{} video (its samples {}) is drawn with {}{}",
+            m_sourceWidth, m_sourceHeight, KODI::CHROMA::LocationName(m_chromaLocation),
+            nearest ? "the sample nearest to each pixel (scaling method Nearest)"
+                    : KODI::CHROMA::Name(filter),
+            m_chroma.Forced() ? ", as advancedsettings.xml asks (chromastep)"
+            : !m_chroma.Timing() ? ""
+            : ChromaQueries().Usable()
+                ? ", a level down where the GPU time of its pictures says it does not keep up"
+                : "; its pictures are not timed (no GL_EXT_disjoint_timer_query): no step-down");
+}
+
+void CLinuxRendererGLES::ChromaTimerMark(bool begin)
+{
+  const ChromaTimerQueries& q = ChromaQueries();
+  if (!q.Usable())
+    return;
+  if (!m_chromaTimersMade)
+  {
+    m_chromaTimersMade = true;
+    for (auto& timer : m_chromaTimers)
+    {
+      q.gen(1, &timer.begin);
+      q.gen(1, &timer.end);
+    }
+  }
+  auto& timer = m_chromaTimers[m_chromaTimerIndex];
+  if (!timer.begin || !timer.end)
+    return;
+  if (begin)
+  {
+    if (timer.pending)
+      return; // (its result is not back yet: this picture is not timed)
+    q.counter(timer.begin, GL_TIMESTAMP_EXT);
+    timer.begun = true;
+  }
+  else if (timer.begun)
+  {
+    q.counter(timer.end, GL_TIMESTAMP_EXT);
+    timer.begun = false;
+    timer.pending = true;
+    m_chromaTimerIndex = (m_chromaTimerIndex + 1) % m_chromaTimers.size();
+  }
+}
+
+void CLinuxRendererGLES::ChromaTimerCollect()
+{
+  const ChromaTimerQueries& q = ChromaQueries();
+  if (!q.Usable() || !m_chromaTimersMade)
+    return;
+  // (reading the disjoint state clears it; a disjoint period makes the results in flight useless)
+  GLint disjoint = 0;
+  glGetIntegerv(GL_GPU_DISJOINT_EXT, &disjoint);
+  const float fps = CServiceBroker::GetWinSystem()->GetGfxContext().GetFPS();
+  const double periodMs = fps > 0 ? 1000.0 / static_cast<double>(fps) : 0;
+  for (size_t n = 0; n < m_chromaTimers.size(); ++n)
+  {
+    auto& timer = m_chromaTimers[(m_chromaTimerIndex + n) % m_chromaTimers.size()];
+    if (!timer.pending)
+      continue;
+    GLuint available = 0;
+    q.getUiv(timer.end, GL_QUERY_RESULT_AVAILABLE_EXT, &available);
+    if (!available)
+      break;
+    timer.pending = false;
+    GLuint64 start = 0;
+    GLuint64 finish = 0;
+    q.getUi64v(timer.begin, GL_QUERY_RESULT_EXT, &start);
+    q.getUi64v(timer.end, GL_QUERY_RESULT_EXT, &finish);
+    if (disjoint || finish <= start || !m_chroma.Timing())
+      continue;
+    const double ms = static_cast<double>(finish - start) / 1e6;
+    const KODI::CHROMA::Filter was = m_chroma.Current();
+    const unsigned int windows = m_chroma.Windows();
+    ++m_chromaTimed;
+    m_chromaSumMs += ms;
+    if (m_chroma.Timed(ms, periodMs))
+    {
+      const auto& w = m_chroma.Last();
+      CLog::Log(LOGWARNING,
+                "Chroma: the chroma of this video is drawn with {} from now on, in place of {}: of "
+                "{} pictures, {} took more than {:.0f} % of a refresh of {:.1f} ms of GPU time "
+                "({:.1f} ms on average, {:.1f} at most)",
+                KODI::CHROMA::Name(m_chroma.Current()), KODI::CHROMA::Name(was), w.frames, w.over,
+                KODI::CHROMA::CStepDown::LOADED * 100, w.periodMs, w.averageMs, w.maxMs);
+      m_reloadShaders = true;
+      m_chromaTimed = 0;
+      m_chromaSumMs = 0;
+      // (the results still in flight are of the level before)
+      for (auto& other : m_chromaTimers)
+        other.pending = other.begun = false;
+      break;
+    }
+    if (windows == 0 && m_chroma.Windows() == 1)
+    {
+      const auto& w = m_chroma.Last();
+      CLog::Log(LOGINFO,
+                "Chroma: with {}, the first {} pictures measured took {:.2f} ms of GPU time on "
+                "average ({:.2f} at most, {} over {:.0f} % of the refresh) for a refresh of {:.1f} ms",
+                KODI::CHROMA::Name(m_chroma.Current()), w.frames, w.averageMs, w.maxMs, w.over,
+                KODI::CHROMA::CStepDown::LOADED * 100, w.periodMs);
+    }
+  }
+}
+
+void CLinuxRendererGLES::ReleaseChromaTimers()
+{
+  const ChromaTimerQueries& q = ChromaQueries();
+  if (!m_chromaTimersMade || !q.Usable())
+    return;
+  for (auto& timer : m_chromaTimers)
+  {
+    if (timer.begin)
+      q.del(1, &timer.begin);
+    if (timer.end)
+      q.del(1, &timer.end);
+    timer = {};
+  }
+  m_chromaTimersMade = false;
+}
