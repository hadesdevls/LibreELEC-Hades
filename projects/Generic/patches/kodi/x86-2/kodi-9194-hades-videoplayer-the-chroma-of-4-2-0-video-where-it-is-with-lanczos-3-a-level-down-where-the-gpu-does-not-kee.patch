diff --git a/xbmc/cores/VideoPlayer/VideoRenderers/ChromaStepDown.h b/xbmc/cores/VideoPlayer/VideoRenderers/ChromaStepDown.h
new file mode 100644
index 0000000..b463b05
--- /dev/null
+++ b/xbmc/cores/VideoPlayer/VideoRenderers/ChromaStepDown.h
@@ -0,0 +1,252 @@
+/*
+ *  Copyright (C) 2026 LibreELEC Hades
+ *  This file is part of Kodi - https://kodi.tv
+ *
+ *  SPDX-License-Identifier: GPL-2.0-or-later
+ *  See LICENSES/README.md for more information.
+ */
+
+#pragma once
+
+// Hades: the chroma of a 4:2:0 picture that Kodi's GLES renderer draws itself (its YUV shaders,
+// gles_yuv2rgb_chroma.frag), and the step-down of its filter where the GPU does not keep up.
+//
+// Kodi's YUV shaders read the chroma planes with the texture's bilinear filter at the place of each
+// output pixel, and take every video's chroma samples as centred between the luma samples. Most video
+// has them elsewhere: MPEG-2, H.264 and HEVC on the left (co-sited with the first luma sample of each
+// pair), UHD Blu-ray top-left. Measured against 4:4:4 references made from the luma of 4K and 1080p
+// masters (measured on 2026-11-20), with Kodi's own shaders on a software GPU: the samples taken
+// where the video places them (SITED, as cheap as before) bring Delta E ITP down by 6 % (animation)
+// to 21 % (film, PQ) on average; with Lanczos 3 over 6 x 6 samples, by 13 % to 26 %, and its 99th
+// percentile by 18 % to 26 %; Spline16 over 4 x 4, 12 % to 25 %, with less than half the samples of
+// Lanczos 3. The bridge draws its pictures with Lanczos 3 at the video's siting (libplacebo).
+//
+// No GL here: the policy is a plain class, so that the host tests build it alone
+// (tools/regress/kodi-host, chroma).
+
+#include <algorithm>
+#include <cstddef>
+
+namespace KODI
+{
+namespace CHROMA
+{
+
+//! How the YUV shaders take the chroma of a 4:2:0 picture, from the most faithful down. KODI is
+//! Kodi's own way, which pictures of other formats keep; the renderer uses it only where
+//! advancedsettings.xml asks for it (<video><chromastep>3</chromastep>).
+enum class Filter
+{
+  LANCZOS3 = 0, //!< Lanczos 3 over 6 x 6 samples, where the video places them
+  SPLINE16 = 1, //!< Spline16 over 4 x 4 samples, where the video places them
+  SITED = 2, //!< the texture's bilinear filter, where the video places them
+  KODI = 3, //!< the texture's bilinear filter, every video taken as centred
+};
+
+constexpr int FILTERS = 4;
+
+inline const char* Name(Filter filter)
+{
+  switch (filter)
+  {
+    case Filter::LANCZOS3:
+      return "Lanczos 3";
+    case Filter::SPLINE16:
+      return "Spline16";
+    case Filter::SITED:
+      return "bilinear";
+    case Filter::KODI:
+      return "bilinear, taken as centred (Kodi's own)";
+  }
+  return "?";
+}
+
+//! Where the chroma samples are from the centres of their texels, in texels of the chroma plane, as
+//! the shaders take it (m_chromaShift): 0.25 on an axis where the samples are co-sited with the first
+//! luma sample of their pair, 0 where they are centred, -0.25 at the bottom.
+struct Shift
+{
+  float x = 0.25f;
+  float y = 0.0f;
+};
+
+//! The shift of a chroma location as FFmpeg gives it (AVChromaLocation: 0 unspecified, 1 left,
+//! 2 centre, 3 top-left, 4 top, 5 bottom-left, 6 bottom). An unspecified one is taken as left, the
+//! siting of MPEG-2, H.264 and HEVC when the stream says nothing, as libplacebo takes it
+//! (pl_chroma_location_offset()) for the pictures that the bridge draws.
+inline Shift ShiftOf(int location)
+{
+  switch (location)
+  {
+    case 2:
+      return {0.0f, 0.0f};
+    case 3:
+      return {0.25f, 0.25f};
+    case 4:
+      return {0.0f, 0.25f};
+    case 5:
+      return {0.25f, -0.25f};
+    case 6:
+      return {0.0f, -0.25f};
+    default:
+      return {0.25f, 0.0f};
+  }
+}
+
+//! The name of a chroma location, for the log
+inline const char* LocationName(int location)
+{
+  switch (location)
+  {
+    case 1:
+      return "left";
+    case 2:
+      return "centre";
+    case 3:
+      return "top-left";
+    case 4:
+      return "top";
+    case 5:
+      return "bottom-left";
+    case 6:
+      return "bottom";
+    default:
+      return "not given, taken as left";
+  }
+}
+
+/*!
+ * \brief The step-down of the chroma filter of a video, by the GPU time of its pictures
+ *
+ * The renderer times each picture that it draws itself with a filter of more than one sample
+ * (LANCZOS3, SPLINE16) and gives the time here with the refresh period. The first SKIP timed
+ * pictures after the start of a video or a change of level are left out (the shaders are built,
+ * the clocks of the GPU rise). The rest are counted in windows of WINDOW pictures of one refresh
+ * period, as CDVStepDown counts the frames of native Dolby Vision that are presented the way that
+ * waits: a picture over LOADED of the period leaves too little of it for the rest of the frame.
+ * A window is behind when PART of its pictures, MIN_OVER at least, are over that mark; two
+ * windows behind in a row, or one whose pictures take more than the whole period on average
+ * (without its slowest picture: the GPU cannot keep up whatever comes), take the filter one level
+ * down: LANCZOS3, SPLINE16, SITED. SITED costs what Kodi's own sampling cost, and is the last
+ * level. A level is not taken back up within a video (the frames would stutter at each trial),
+ * and each video starts again from LANCZOS3 (what was found for the last one may not hold for this
+ * one: its size, its rate and the refresh rate are its own). A forced level (advancedsettings.xml)
+ * never changes.
+ */
+class CStepDown
+{
+public:
+  static constexpr unsigned int SKIP = 48;
+  static constexpr unsigned int WINDOW = 48;
+  static constexpr double LOADED = 0.8; //!< CDVStepDown::LOADED_WAITING
+  static constexpr double PART = 0.05; //!< CDVStepDown::LOST_PART
+  static constexpr unsigned int MIN_OVER = 3;
+
+  //! What a window found, for the log
+  struct Window
+  {
+    unsigned int frames = 0;
+    unsigned int over = 0; //!< pictures over LOADED of the period
+    double averageMs = 0; //!< without the slowest picture
+    double maxMs = 0;
+    double periodMs = 0;
+    bool behind = false;
+  };
+
+  //! A new video: from the most faithful level, or from the level that advancedsettings.xml forces
+  //! (0 to 3; any other value: none)
+  void Start(int forced = -1)
+  {
+    m_forced = forced >= 0 && forced < FILTERS;
+    m_filter = m_forced ? static_cast<Filter>(forced) : Filter::LANCZOS3;
+    m_windows = 0;
+    m_last = {};
+    Restart();
+  }
+
+  Filter Current() const { return m_filter; }
+  bool Forced() const { return m_forced; }
+  //! Whether the pictures are timed at this level: it can still go down
+  bool Timing() const
+  {
+    return !m_forced && (m_filter == Filter::LANCZOS3 || m_filter == Filter::SPLINE16);
+  }
+  //! Windows measured since the start of the video
+  unsigned int Windows() const { return m_windows; }
+  const Window& Last() const { return m_last; }
+
+  /*!
+   * \brief A timed picture
+   * \param ms its GPU time
+   * \param periodMs the refresh period of the display
+   * \return true when the level changed with it (Current() is the new one, Last() the window that
+   *         decided it); false otherwise, also when a window ended (Windows() counts it)
+   */
+  bool Timed(double ms, double periodMs)
+  {
+    if (!Timing() || !(ms >= 0) || !(periodMs > 0))
+      return false;
+    if (m_skip > 0)
+    {
+      --m_skip;
+      return false;
+    }
+    if (m_frames > 0 && periodMs != m_periodMs)
+      m_frames = 0; // (another refresh rate: a window of its own)
+    if (m_frames == 0)
+    {
+      m_periodMs = periodMs;
+      m_sumMs = m_maxMs = 0;
+      m_over = 0;
+    }
+    ++m_frames;
+    m_sumMs += ms;
+    m_maxMs = std::max(m_maxMs, ms);
+    m_over += ms > LOADED * periodMs ? 1 : 0;
+    if (m_frames < WINDOW)
+      return false;
+
+    Window w;
+    w.frames = m_frames;
+    w.over = m_over;
+    w.averageMs = (m_sumMs - m_maxMs) / (m_frames - 1);
+    w.maxMs = m_maxMs;
+    w.periodMs = m_periodMs;
+    const unsigned int part = static_cast<unsigned int>(PART * m_frames + 0.999);
+    w.behind = m_over >= std::max(MIN_OVER, part);
+    const bool cannot = w.averageMs > m_periodMs;
+    m_last = w;
+    m_frames = 0;
+    ++m_windows;
+    const bool down = cannot || (w.behind && m_behindBefore);
+    m_behindBefore = w.behind;
+    if (!down)
+      return false;
+    m_filter = m_filter == Filter::LANCZOS3 ? Filter::SPLINE16 : Filter::SITED;
+    Restart();
+    return true;
+  }
+
+private:
+  void Restart()
+  {
+    m_skip = SKIP;
+    m_frames = 0;
+    m_behindBefore = false;
+  }
+
+  Filter m_filter = Filter::LANCZOS3;
+  bool m_forced = false;
+  unsigned int m_skip = SKIP;
+  unsigned int m_frames = 0;
+  unsigned int m_over = 0;
+  double m_sumMs = 0;
+  double m_maxMs = 0;
+  double m_periodMs = 0;
+  bool m_behindBefore = false;
+  unsigned int m_windows = 0;
+  Window m_last;
+};
+
+} // namespace CHROMA
+} // namespace KODI
