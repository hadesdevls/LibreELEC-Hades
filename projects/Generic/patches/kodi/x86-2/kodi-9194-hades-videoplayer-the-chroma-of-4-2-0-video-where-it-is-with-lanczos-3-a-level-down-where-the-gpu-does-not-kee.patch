diff --git a/system/shaders/GLES/2.0/gles_yuv2rgb_chroma.frag b/system/shaders/GLES/2.0/gles_yuv2rgb_chroma.frag
new file mode 100644
index 0000000..ef62de0
--- /dev/null
+++ b/system/shaders/GLES/2.0/gles_yuv2rgb_chroma.frag
@@ -0,0 +1,125 @@
+/*
+ *  Copyright (C) 2026 LibreELEC Hades
+ *  This file is part of Kodi - https://kodi.tv
+ *
+ *  SPDX-License-Identifier: GPL-2.0-or-later
+ *  See LICENSES/README.md for more information.
+ */
+
+// Hades: the chroma of a 4:2:0 picture, taken where the video says its samples are and, with a filter,
+// resampled with it (BaseYUV2RGBGLSLShader, KODI_CHROMA_*). Inserted before main() of the YUV shaders
+// of the 4:2:0 formats; KODI_CHROMA_TEXTURE is their texture function (texture2D or texture).
+//
+// The texture coordinates of the chroma planes are those of the luma halved: they take chroma texel i
+// to be centred between luma samples 2i and 2i + 1. A video whose chroma samples are co-sited with
+// luma sample 2i (left, top-left, top) has them half a luma sample, a quarter of a chroma texel,
+// before that: m_chromaShift is that quarter (0.25) on each axis where the samples are co-sited, 0
+// where they are centred, -0.25 at the bottom. The sample index of a texture coordinate is then
+// coord * size - 0.5 + m_chromaShift. Kodi's own sampling took every video as centred: a quarter of
+// a chroma sample off on the left for MPEG-2, H.264 and HEVC video, and up as well on UHD Blu-ray.
+
+#ifdef GL_FRAGMENT_PRECISION_HIGH
+#define KODI_CHROMA_P highp
+#else
+#define KODI_CHROMA_P mediump
+#endif
+
+uniform KODI_CHROMA_P vec4 m_chromaSize;  // the size of the chroma textures in texels, and its inverse
+uniform KODI_CHROMA_P vec2 m_chromaShift; // where the samples are from the centres of their texels
+
+// both chroma samples at a texture coordinate. NV12_RRG (VAAPI, DRM PRIME) and NV12 (an NV12 software
+// frame) bind their one chroma texture to both samplers (RendererVAAPIGLES.cpp, RendererDRMPRIMEGLES.cpp,
+// CreateNV12Texture()): one fetch takes both.
+#if defined(XBMC_NV12_RRG)
+#define KODI_CHROMA_FETCH(p) KODI_CHROMA_TEXTURE(m_sampU, p).rg
+#elif defined(XBMC_NV12)
+#define KODI_CHROMA_FETCH(p) KODI_CHROMA_TEXTURE(m_sampU, p).ga
+#elif defined(XBMC_YV12)
+#define KODI_CHROMA_FETCH(p) vec2(KODI_CHROMA_TEXTURE(m_sampU, p).g, KODI_CHROMA_TEXTURE(m_sampV, p).a)
+#else
+#define KODI_CHROMA_FETCH(p) vec2(KODI_CHROMA_TEXTURE(m_sampU, p).r, KODI_CHROMA_TEXTURE(m_sampV, p).r)
+#endif
+
+#if defined(KODI_CHROMA_LANCZOS3)
+#define KODI_CHROMA_TAPS 6
+// Lanczos 3 at the six taps k = -2..3 of a fraction f: sinc(x) sinc(x / 3), x = k - f, from one sin(pi f)
+// and one sin/cos of pi f / 3 (sin(pi (k - f)) = (-1)^(k + 1) sin(pi f), and the angle sum for pi (k - f) / 3);
+// at x = 0 the limit, 1. Normalised: the taps of a Lanczos window do not add up to 1 exactly.
+void KodiChromaWeights(KODI_CHROMA_P float f, out KODI_CHROMA_P float w[6])
+{
+  const KODI_CHROMA_P float pi = 3.14159265358979;
+  const KODI_CHROMA_P float s3 = 0.866025403784439;
+  KODI_CHROMA_P float a = sin(pi * f);
+  KODI_CHROMA_P float c = cos(pi * f / 3.0);
+  KODI_CHROMA_P float s = sin(pi * f / 3.0);
+  // sin(pi k / 3) and cos(pi k / 3), k = -2..3
+  KODI_CHROMA_P vec3 sk0 = vec3(-s3, -s3, 0.0), ck0 = vec3(-0.5, 0.5, 1.0);
+  KODI_CHROMA_P vec3 sk1 = vec3(s3, s3, 0.0), ck1 = vec3(0.5, -0.5, -1.0);
+  KODI_CHROMA_P vec3 x0 = vec3(-2.0, -1.0, 0.0) - f, x1 = vec3(1.0, 2.0, 3.0) - f;
+  KODI_CHROMA_P vec3 sg0 = vec3(-a, a, -a), sg1 = vec3(a, -a, a); // (-1)^(k + 1) sin(pi f)
+  KODI_CHROMA_P vec3 n0 = sg0 * (sk0 * c - ck0 * s), n1 = sg1 * (sk1 * c - ck1 * s);
+  KODI_CHROMA_P vec3 d0 = (pi * pi / 3.0) * x0 * x0, d1 = (pi * pi / 3.0) * x1 * x1;
+  KODI_CHROMA_P vec3 w0 = n0 / max(d0, 1e-12), w1 = n1 / max(d1, 1e-12);
+  // the tap at x = 0 (f = 0 only)
+  if (f < 1e-6)
+  {
+    w0 = vec3(0.0, 0.0, 1.0);
+    w1 = vec3(0.0);
+  }
+  KODI_CHROMA_P float sum = w0.x + w0.y + w0.z + w1.x + w1.y + w1.z;
+  w[0] = w0.x / sum;
+  w[1] = w0.y / sum;
+  w[2] = w0.z / sum;
+  w[3] = w1.x / sum;
+  w[4] = w1.y / sum;
+  w[5] = w1.z / sum;
+}
+#elif defined(KODI_CHROMA_SPLINE16)
+#define KODI_CHROMA_TAPS 4
+// Spline16 (Helmut Dersch's cubic spline through 4 points) at the taps k = -1..2 of a fraction f;
+// they add up to 1
+void KodiChromaWeights(KODI_CHROMA_P float f, out KODI_CHROMA_P float w[4])
+{
+  KODI_CHROMA_P float g = 1.0 - f;
+  w[0] = ((-1.0 / 3.0 * f + 4.0 / 5.0) * f - 7.0 / 15.0) * f;
+  w[1] = ((f - 9.0 / 5.0) * f - 1.0 / 5.0) * f + 1.0;
+  w[2] = ((g - 9.0 / 5.0) * g - 1.0 / 5.0) * g + 1.0;
+  w[3] = ((-1.0 / 3.0 * g + 4.0 / 5.0) * g - 7.0 / 15.0) * g;
+}
+#endif
+
+#if defined(KODI_CHROMA_TAPS)
+// the chroma at the place of a texture coordinate, from KODI_CHROMA_TAPS x KODI_CHROMA_TAPS samples
+// around it, each read at the centre of its texel (the renderer gives the chroma textures the
+// filter GL_NEAREST for these filters: a bilinear one may weigh a neighbour in by a step of its
+// fixed-point weights where the centre falls a hair short of it) and outside the picture the sample
+// at its edge (CLAMP_TO_EDGE)
+KODI_CHROMA_P vec2 KodiChroma(KODI_CHROMA_P vec2 coord)
+{
+  KODI_CHROMA_P vec2 pos = coord * m_chromaSize.xy - 0.5 + m_chromaShift;
+  KODI_CHROMA_P vec2 base = floor(pos);
+  KODI_CHROMA_P vec2 f = pos - base;
+  KODI_CHROMA_P float wx[KODI_CHROMA_TAPS];
+  KODI_CHROMA_P float wy[KODI_CHROMA_TAPS];
+  KodiChromaWeights(f.x, wx);
+  KodiChromaWeights(f.y, wy);
+  // the centre of the first texel of the window
+  KODI_CHROMA_P vec2 first = (base - float(KODI_CHROMA_TAPS / 2 - 1) + 0.5) * m_chromaSize.zw;
+  KODI_CHROMA_P vec2 sum = vec2(0.0);
+  for (int j = 0; j < KODI_CHROMA_TAPS; ++j)
+  {
+    KODI_CHROMA_P vec2 row = vec2(0.0);
+    KODI_CHROMA_P float y = first.y + float(j) * m_chromaSize.w;
+    for (int i = 0; i < KODI_CHROMA_TAPS; ++i)
+      row += wx[i] * KODI_CHROMA_FETCH(vec2(first.x + float(i) * m_chromaSize.z, y));
+    sum += wy[j] * row;
+  }
+  return sum;
+}
+#else
+// the chroma at the place of a texture coordinate, the texture's filter (bilinear) between its samples
+KODI_CHROMA_P vec2 KodiChroma(KODI_CHROMA_P vec2 coord)
+{
+  return KODI_CHROMA_FETCH(coord + m_chromaShift * m_chromaSize.zw);
+}
+#endif
