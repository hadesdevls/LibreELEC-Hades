+// Hades: GL_EXT_disjoint_timer_query, for the GPU time of the pictures drawn with a chroma filter of
+// more than one sample (CLinuxRendererGLES::ChromaTimerMark()); null where the GL has none
+struct ChromaTimerQueries
+{
+  PFNGLGENQUERIESEXTPROC gen = nullptr;
+  PFNGLDELETEQUERIESEXTPROC del = nullptr;
+  PFNGLQUERYCOUNTEREXTPROC counter = nullptr;
+  PFNGLGETQUERYOBJECTUIVEXTPROC getUiv = nullptr;
+  PFNGLGETQUERYOBJECTUI64VEXTPROC getUi64v = nullptr;
+  bool Usable() const { return gen && del && counter && getUiv && getUi64v; }
+};
+
+const ChromaTimerQueries& ChromaQueries()
+{
+  static const ChromaTimerQueries queries = []
+  {
+    ChromaTimerQueries q;
+#if defined(HAS_EGL) && defined(GL_TIMESTAMP_EXT)
+    if (const auto* renderSystem = CServiceBroker::GetRenderSystem();
+        renderSystem && renderSystem->IsExtSupported("GL_EXT_disjoint_timer_query"))
+    {
+      q.gen = reinterpret_cast<PFNGLGENQUERIESEXTPROC>(eglGetProcAddress("glGenQueriesEXT"));
+      q.del = reinterpret_cast<PFNGLDELETEQUERIESEXTPROC>(eglGetProcAddress("glDeleteQueriesEXT"));
+      q.counter =
+          reinterpret_cast<PFNGLQUERYCOUNTEREXTPROC>(eglGetProcAddress("glQueryCounterEXT"));
+      q.getUiv = reinterpret_cast<PFNGLGETQUERYOBJECTUIVEXTPROC>(
+          eglGetProcAddress("glGetQueryObjectuivEXT"));
+      q.getUi64v = reinterpret_cast<PFNGLGETQUERYOBJECTUI64VEXTPROC>(
+          eglGetProcAddress("glGetQueryObjectui64vEXT"));
+    }
+#endif
+    return q;
+  }();
+  return queries;
+}
