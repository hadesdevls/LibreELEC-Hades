From 9277450e25b093b17b4826fe43c64e751a2cbc22 Mon Sep 17 00:00:00 2001
From: Hades <15710513+hadesdevls@users.noreply.github.com>
Date: Wed, 25 Nov 2026 01:11:00 +0000
Subject: [PATCH] [Hades][DVBridge] The 3D LUT of the display given to the
 bridge

CDVBridgeGLES::SetLut() gives a bridge the 3D LUT of the display
(dvbridge_render_set_lut()) from the next picture on, keeps it for a
renderer made again (native output, conversion), and has a picture that is
asked for again drawn again with it or without it (a paused video shows
the change). LutApplied() and LutFailed() say whether the last picture had
it, and whether a render with it failed on this GPU. Nothing changes where
no LUT is set.
---
 .../VideoPlayer/VideoRenderers/DVBridgeGLES.cpp | 17 +++++++++++++++++
 .../VideoPlayer/VideoRenderers/DVBridgeGLES.h   | 12 ++++++++++++
 2 files changed, 29 insertions(+)

diff --git a/xbmc/cores/VideoPlayer/VideoRenderers/DVBridgeGLES.cpp b/xbmc/cores/VideoPlayer/VideoRenderers/DVBridgeGLES.cpp
index 855e33f..50283e6 100644
--- a/xbmc/cores/VideoPlayer/VideoRenderers/DVBridgeGLES.cpp
+++ b/xbmc/cores/VideoPlayer/VideoRenderers/DVBridgeGLES.cpp
@@ -585,6 +585,9 @@ bool CDVBridgeGLES::Initialize(bool allowSoftware)
   UseGamutAheadSetting();
   if (m_renderer)
     TimePasses(everyFrame);
+  // Hades: the 3D LUT of the display, where one is set (SetLut(); Low-Latency only)
+  if (m_renderer)
+    dvbridge_render_set_lut(m_renderer, m_lut);
   // To measure on hardware what it saves, advancedsettings.xml can turn off the writing of the
   // bars before the reconstruction: <video><dvearlymask>false</dvearlymask></video>
   if (const auto settings = CServiceBroker::GetSettingsComponent();
@@ -2535,6 +2538,9 @@ bool CDVBridgeGLES::InitializeConversion(bool allowSoftware)
   m_renderer = dvbridge_renderer_create_hdr10(m_gl->gpu, m_log);
   if (m_renderer)
     TimePasses(everyFrame);
+  // Hades: the 3D LUT of the display, where one is set (SetLut())
+  if (m_renderer)
+    dvbridge_render_set_lut(m_renderer, m_lut);
   UseGamutAheadSetting();
   UseComposerSetting();
   UseGamutSetting();
@@ -2778,6 +2784,17 @@ bool CDVBridgeGLES::PreparePlain(const Layer& base,
   return true;
 }
 
+void CDVBridgeGLES::SetLut(const dvbridge_lut* lut)
+{
+  if (lut == m_lut)
+    return;
+  m_lut = lut;
+  if (m_renderer)
+    dvbridge_render_set_lut(m_renderer, lut);
+  // a picture that is asked for again is drawn again, with it or without it
+  m_convertSerial = 0;
+}
+
 bool CDVBridgeGLES::SetUpscaler(int method, std::string& why)
 {
   why.clear();
diff --git a/xbmc/cores/VideoPlayer/VideoRenderers/DVBridgeGLES.h b/xbmc/cores/VideoPlayer/VideoRenderers/DVBridgeGLES.h
index 151ba80..6c8db5c 100644
--- a/xbmc/cores/VideoPlayer/VideoRenderers/DVBridgeGLES.h
+++ b/xbmc/cores/VideoPlayer/VideoRenderers/DVBridgeGLES.h
@@ -537,6 +537,16 @@ public:
   //! folder for this bridge's GPU, once, and kept until another one is asked for. 0 (OFF): none, and
   //! every picture is drawn as before. false: it could not be loaded (why says why), and there is none.
   bool SetUpscaler(int method, std::string& why);
+  //! Hades: the 3D LUT of the display (dvbridge_lut.h; DisplayLut.h chooses which), the last step of the colour of the
+  //! pictures that this bridge maps to the display or draws as they are, from the next picture on (one that is asked
+  //! for again is drawn again); nullptr: none, every picture as before, bit for bit. The caller keeps it while it is
+  //! set, and a renderer made again takes it. Never applied to native Dolby Vision that the TV maps, nor to HDR over
+  //! the tunnel, whatever is set (dvbridge_render_set_lut()).
+  void SetLut(const dvbridge_lut* lut);
+  //! Hades: ... the last picture drawn had it
+  bool LutApplied() const { return m_renderer && dvbridge_render_lut_applied(m_renderer); }
+  //! Hades: ... a render with it failed on this GPU: the pictures are drawn without it until another one is set
+  bool LutFailed() const { return m_renderer && dvbridge_render_lut_failed(m_renderer); }
   //! Hades: the last picture of PreparePlain() was drawn with the upscaler's shaders
   bool Upscaled() const { return m_renderer && dvbridge_render_upscaled(m_renderer); }
   //! Hades: libplacebo could not draw them on this GPU (the picture was drawn without them)
@@ -707,6 +717,8 @@ private:
   dvbridge_renderer* m_renderer = nullptr;
   //! Hades: the upscaler of PreparePlain() (SetUpscaler()), freed before the GPU it is of
   dvbridge_upscaler m_upscaler{};
+  //! Hades: the 3D LUT of the display (SetLut()); the caller's
+  const dvbridge_lut* m_lut = nullptr;
   dvbridge_gl_packer* m_packer = nullptr;
   //! Hades: a pack that composites the GUI (Low-Latency) failed on this GPU (said once in the log)
   bool m_lowLatencyGuiFailedSaid = false;
-- 
