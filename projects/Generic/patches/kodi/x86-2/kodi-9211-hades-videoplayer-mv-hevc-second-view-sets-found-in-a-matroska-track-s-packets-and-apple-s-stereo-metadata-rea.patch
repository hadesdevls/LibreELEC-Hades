+
+/*!
+ * \name The parameter sets of the second view in the stream
+ *
+ * A Matroska track of MV-HEVC carries the parameter sets of its base layer in its private data,
+ * and those of the second layer only where its muxer kept them there, which FFmpeg's and
+ * mkvmerge's do not (MvHevcSecondLayer()). Where the stream it was made of had them in band
+ * (an elementary stream, an MP4 file of the sample entry 'hev1'), they are in the packets too,
+ * before the first picture of their layer: the demuxer looks for them in the first packets, and
+ * where they come before that picture, the track is opened again as one of two views, with them
+ * added to its private data as 'lhvC' would have added them (HvccWithSets()). That happens
+ * before the first picture is shown, so the display switches to 3D once. Where the first
+ * picture of the second layer comes without them, the track stays the 2D stream it was: its
+ * second view would not be decoded there, and a later switch to 3D is what is avoided.
+ * @{
+ */
+
+//! The packets of the track that are looked through before the search is given up
+inline constexpr unsigned int IN_BAND_PACKETS = 120;
+//! The parameter sets of the layer that are kept at most (ITU-T H.265: 16 sequence parameter
+//! sets, 64 picture parameter sets)
+inline constexpr size_t IN_BAND_SPS_MAX = 16;
+inline constexpr size_t IN_BAND_PPS_MAX = 64;
+
+//! What a search through the packets of a track has seen
+struct InBandSearch
+{
+  int layer{1}; //!< the nuh_layer_id of the second view (MvHevcDeclaredLayer())
+  unsigned int lengthSize{4}; //!< the bytes of the length of each NAL unit of a packet
+  unsigned int packets{0};
+  std::vector<std::vector<uint8_t>> sps; //!< the sequence parameter sets of the layer, each once
+  std::vector<std::vector<uint8_t>> pps; //!< ... and its picture parameter sets
+};
+
+enum class InBand
+{
+  LOOKING, //!< nothing decided yet
+  FOUND, //!< the sets came before the first picture of the layer
+  NOT_THERE, //!< they did not: the track stays 2D
+};
+
+/*!
+ * \brief The bytes of the length of a NAL unit in the samples of a track whose private data is a
+ *        record of the form of 'hvcC' (lengthSizeMinusOne + 1: 1, 2 or 4); nothing for any other
+ */
+inline std::optional<unsigned int> HvccLengthSize(const uint8_t* data, size_t size)
+{
+  if (!data || size < 23 || data[0] != 1)
+    return std::nullopt;
+  const unsigned int length = (data[21] & 3u) + 1;
+  if (length == 3)
+    return std::nullopt;
+  return length;
+}
+
+/*!
+ * \brief Looks through one packet of the track, its NAL units in their order
+ *
+ * A packet that does not hold together (a length beyond its end) ends the search: nothing that
+ * follows in it can be read as the decoder reads it.
+ */
+inline InBand LookInPacket(InBandSearch& search, const uint8_t* data, size_t size)
+{
+  if (search.lengthSize < 1 || search.lengthSize > 4)
+    return InBand::NOT_THERE;
+  ++search.packets;
+  const auto addOnce =
+      [](std::vector<std::vector<uint8_t>>& sets, const uint8_t* nal, size_t length, size_t most)
+  {
+    for (const auto& set : sets)
+      if (set.size() == length && std::equal(set.begin(), set.end(), nal))
+        return;
+    if (sets.size() < most)
+      sets.emplace_back(nal, nal + length);
+  };
+  size_t pos = 0;
+  while (data && size - pos >= search.lengthSize)
+  {
+    size_t length = 0;
+    for (unsigned int i = 0; i < search.lengthSize; ++i)
+      length = length << 8 | data[pos + i];
+    pos += search.lengthSize;
+    if (length > size - pos)
+      return InBand::NOT_THERE;
+    const DETAIL::HevcNal header = DETAIL::HevcNalHeader(data + pos, length);
+    if (header.layer == search.layer)
+    {
+      if (header.type == DETAIL::HEVC_NAL_SPS)
+        addOnce(search.sps, data + pos, length, IN_BAND_SPS_MAX);
+      else if (header.type == DETAIL::HEVC_NAL_PPS)
+        addOnce(search.pps, data + pos, length, IN_BAND_PPS_MAX);
+      else if (header.type >= 0 && header.type < 32) // a slice of the layer (VCL)
+        return !search.sps.empty() && !search.pps.empty() ? InBand::FOUND : InBand::NOT_THERE;
+    }
+    pos += length;
+  }
+  return search.packets >= IN_BAND_PACKETS ? InBand::NOT_THERE : InBand::LOOKING;
+}
+
+/*!
+ * \brief A record of the form of 'hvcC' with the sets that a search found appended to it, as
+ *        FFmpeg appends those of 'lhvC' (one array of each type, numOfArrays counting them)
+ * \return nothing where it cannot be made: not such a record, or too many arrays
+ */
+inline std::vector<uint8_t> HvccWithSets(const uint8_t* record,
+                                         size_t size,
+                                         const InBandSearch& search)
+{
+  std::vector<uint8_t> out;
+  if (!HvccLengthSize(record, size) || search.sps.empty() || search.pps.empty() || record[22] > 253)
+    return out;
+  out.assign(record, record + size);
+  for (const auto* sets : {&search.sps, &search.pps})
+  {
+    const int type = sets == &search.sps ? DETAIL::HEVC_NAL_SPS : DETAIL::HEVC_NAL_PPS;
+    out.push_back(static_cast<uint8_t>(type)); // array_completeness 0: they may come in band too
+    out.push_back(static_cast<uint8_t>(sets->size() >> 8));
+    out.push_back(static_cast<uint8_t>(sets->size() & 0xff));
+    for (const auto& set : *sets)
+    {
+      if (set.size() > 0xffff)
+        return {};
+      out.push_back(static_cast<uint8_t>(set.size() >> 8));
+      out.push_back(static_cast<uint8_t>(set.size() & 0xff));
+      out.insert(out.end(), set.begin(), set.end());
+    }
+  }
+  out[22] = static_cast<uint8_t>(out[22] + 2);
+  return out;
 }
