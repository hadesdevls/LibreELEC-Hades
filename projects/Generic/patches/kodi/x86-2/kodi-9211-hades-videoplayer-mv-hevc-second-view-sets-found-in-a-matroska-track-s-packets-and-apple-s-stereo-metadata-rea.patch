@@ -4628,6 +4530,223 @@ void CDVDDemuxFFmpeg::ConfigureOffsetMetadata(const AVStream* pStream,
   m_offsetFrameDuration = DVD_TIME_BASE * static_cast<double>(stream->iFpsScale) / stream->iFpsRate;
 }
 
+void CDVDDemuxFFmpeg::ChooseTwoViews(AVStream* pStream, CDemuxStreamVideo* st, bool inBand)
+{
+  // Hades: a track whose two eyes are coded as two views (H.264 MVC, as a Matroska file made of a
+  // 3D Blu-ray has it; MV-HEVC, as MP4 files of spatial video and 3D films for the Vision Pro
+  // have it) is announced as what its decoder gives, one picture with both eyes side by side, and
+  // marked for that decoder. Only when the private data of the codec says that there is a second
+  // view (and for HEVC carries what decodes it, or its packets show it: inBand), the setting
+  // allows it, this build has that decoder and the container names no layout within the picture
+  // (KODI::MULTIVIEW::TwoViews): any other track is the stream it always was.
+  const bool h264Views = pStream->codecpar->codec_id == AV_CODEC_ID_H264 &&
+                         pStream->codecpar->extradata_size > 0 &&
+                         KODI::MULTIVIEW::HasMvcConfiguration(pStream->codecpar->extradata,
+                                                              pStream->codecpar->extradata_size);
+  const bool hevcViews = pStream->codecpar->codec_id == AV_CODEC_ID_HEVC &&
+                         pStream->codecpar->extradata_size > 0 &&
+                         KODI::MULTIVIEW::MvHevcDeclared(pStream->codecpar->extradata,
+                                                         pStream->codecpar->extradata_size);
+  if (!h264Views && !hevcViews)
+    return;
+
+  const std::string containerMode = st->stereo_mode;
+  // (H.264: where the file declares the second view, as FFmpeg says it: Hades' ffmpeg-9953 reads a
+  // block addition mapping of Matroska and a stream that declares it nowhere else)
+  const AVDictionaryEntry* const mvcDeclared =
+      av_dict_get(pStream->metadata, "mvc_configuration", nullptr, 0);
+  const std::string declaredBy =
+      !h264Views ? ""
+      : !mvcDeclared || std::string_view(mvcDeclared->value) == "codec private"
+          ? ", declared by its codec data"
+      : std::string_view(mvcDeclared->value) == "block addition mapping"
+          ? ", declared by a block addition mapping of the file (its codec data has no box 'mvcC')"
+      : std::string_view(mvcDeclared->value) == "stream"
+          ? ", declared by its stream only (a subset sequence parameter set; nothing in its codec "
+            "data or the file)"
+          : std::string(", declared by ") + mvcDeclared->value;
+  const char* const kind =
+      h264Views ? "H.264 with a second view (MVC)" : "HEVC with a second view (MV-HEVC)";
+  KODI::MULTIVIEW::Track track;
+  track.h264 = h264Views;
+  track.hevc = hevcViews;
+  const int setting = CServiceBroker::GetSettingsComponent()->GetSettings()->GetInt(
+      CSettings::SETTING_VIDEOPLAYER_HADES3DMVC);
+  CWinSystemBase* const winSystem = CServiceBroker::GetWinSystem();
+  track.allowed = KODI::MULTIVIEW::Allowed(setting, winSystem && winSystem->HasStereoDisplay());
+  track.decoder = KODI::MULTIVIEW::DecoderOfTwoViews(pStream->codecpar->codec_id) != nullptr;
+  track.extradata = pStream->codecpar->extradata;
+  track.extradataSize = pStream->codecpar->extradata_size;
+  track.stereoMode = containerMode;
+  // (HEVC: what the container says of the eyes, as FFmpeg gives it, and its Dolby Vision)
+  int disparity = 0;
+  if (const AVPacketSideData* stereo =
+          av_packet_side_data_get(pStream->codecpar->coded_side_data,
+                                  pStream->codecpar->nb_coded_side_data, AV_PKT_DATA_STEREO3D);
+      stereo && stereo->size >= sizeof(AVStereo3D))
+  {
+    const auto* s = reinterpret_cast<const AVStereo3D*>(stereo->data);
+    track.inverted = (s->flags & AV_STEREO3D_FLAG_INVERT) != 0;
+    if (s->type == AV_STEREO3D_UNSPEC || s->type == AV_STEREO3D_FRAMESEQUENCE)
+      track.layout = s->view == AV_STEREO3D_VIEW_LEFT || s->view == AV_STEREO3D_VIEW_RIGHT
+                         ? KODI::MULTIVIEW::ContainerLayout::ONE_EYE
+                         : KODI::MULTIVIEW::ContainerLayout::TWO_VIEWS;
+    else
+      track.layout = KODI::MULTIVIEW::ContainerLayout::OTHER;
+    // Hades: what Apple's spatial video says of its cameras and of how it is shown ('eyes' and
+    // 'hfov' of 'vexu', Apple's "QuickTime and ISO Base Media File Formats and Spatial and
+    // Immersive Media"): the disparity adjustment is applied (LeftEyeShift()); the hero eye, the
+    // baseline of the cameras and their field of view say how the video was made, and are told
+    const AVRational adjustment = s->horizontal_disparity_adjustment;
+    if (hevcViews && adjustment.num != 0 && adjustment.den > 0)
+      disparity = static_cast<int>(
+          std::clamp<int64_t>(av_rescale(adjustment.num, 10000, adjustment.den), -10000, 10000));
+    if (hevcViews && (s->primary_eye != AV_PRIMARY_EYE_NONE || s->baseline || adjustment.num != 0 ||
+                      s->horizontal_field_of_view.num != 0))
+      CLog::Log(LOGINFO,
+                "CDVDDemuxFFmpeg::AddStream - stream {}: the container says of its two views: "
+                "hero eye {}, cameras {:.3f} mm apart, horizontal field of view {:.3f} degrees, "
+                "disparity adjustment {:+.4f} of the width",
+                pStream->index,
+                s->primary_eye == AV_PRIMARY_EYE_LEFT    ? "left"
+                : s->primary_eye == AV_PRIMARY_EYE_RIGHT ? "right"
+                                                         : "unsaid",
+                s->baseline / 1000.0,
+                s->horizontal_field_of_view.den > 0 ? av_q2d(s->horizontal_field_of_view) : 0.0,
+                disparity / 10000.0);
+  }
+  track.dvProfile = st->dovi.dv_profile;
+  track.dvCompatibility = st->dovi.dv_bl_signal_compatibility_id;
+  const bool setsThere =
+      h264Views || KODI::MULTIVIEW::MvHevcSecondLayer(pStream->codecpar->extradata,
+                                                      pStream->codecpar->extradata_size);
+  const bool keptToOne =
+      hevcViews && KODI::MULTIVIEW::KeptToOneView(track.dvProfile, track.dvCompatibility);
+  if (const auto baseEye = KODI::MULTIVIEW::TwoViews(track))
+  {
+    st->multiview = true;
+    st->multiviewBaseRight = *baseEye == KODI::MULTIVIEW::BaseEye::RIGHT;
+    st->multiviewKeptToOne = false;
+    st->multiviewDisparity = disparity;
+    st->stereo_mode = KODI::MULTIVIEW::PACKED_STEREO_MODE;
+    // (the depth of subtitles of a 3D Blu-ray: H.264 only)
+    if (h264Views)
+      ConfigureOffsetMetadata(pStream, st);
+    CLog::Log(
+        LOGINFO,
+        "CDVDDemuxFFmpeg::AddStream - stream {}: {}{}; both views are to be decoded, the "
+        "base view as the {} eye (the container says \"{}\"{}){}",
+        pStream->index, kind, declaredBy, st->multiviewBaseRight ? "right" : "left", containerMode,
+        track.layout == KODI::MULTIVIEW::ContainerLayout::TWO_VIEWS
+            ? (track.inverted ? ", eyes reversed" : ", both eyes")
+            : "",
+        inBand ? "; the parameter sets of its second view were found in its first packets" : "");
+    if (disparity)
+    {
+      const int shift = KODI::MULTIVIEW::LeftEyeShift(disparity, pStream->codecpar->width, 2);
+      CLog::Log(LOGINFO,
+                "CDVDDemuxFFmpeg::AddStream - stream {}: its disparity adjustment is applied: the "
+                "left eye's picture goes {} pixels to the {}, the right eye's as far the other way "
+                "(the scene {} the screen)",
+                pStream->index, std::abs(shift), shift < 0 ? "left" : "right",
+                shift < 0 ? "farther behind" : "nearer in front of");
+    }
+    return;
+  }
+
+  // Hades: an MV-HEVC track whose private data lacks only the parameter sets of its second view,
+  // in a record of the form of 'hvcC' (Matroska), is looked for them in its first packets
+  // (LookForSecondViewSets()); it is the 2D stream it always was until they are found there
+  const auto lengthSize = KODI::MULTIVIEW::HvccLengthSize(pStream->codecpar->extradata,
+                                                          pStream->codecpar->extradata_size);
+  const auto declared = KODI::MULTIVIEW::MvHevcDeclaredLayer(pStream->codecpar->extradata,
+                                                             pStream->codecpar->extradata_size);
+  if (!inBand && hevcViews && !setsThere && !keptToOne && track.allowed && track.decoder &&
+      lengthSize && declared &&
+      KODI::MULTIVIEW::BaseEyeOfHevcContainer(track.layout, track.inverted, track.stereoMode))
+  {
+    KODI::MULTIVIEW::InBandSearch search;
+    search.layer = *declared;
+    search.lengthSize = *lengthSize;
+    m_inBandSearch = std::move(search);
+    m_inBandStream = pStream->index;
+    CLog::Log(LOGINFO,
+              "CDVDDemuxFFmpeg::AddStream - stream {}: {} whose private data does not carry the "
+              "parameter sets of the second view (layer {}); they are looked for in its first "
+              "packets, and it plays as 2D until they are found",
+              pStream->index, kind, *declared);
+    return;
+  }
+
+  // (Hades: a Dolby Vision 3D video kept to one view says so to the player information)
+  st->multiviewKeptToOne = keptToOne && track.allowed && track.decoder && setsThere;
+  CLog::Log(LOGINFO,
+            "CDVDDemuxFFmpeg::AddStream - stream {}: {}{} that is not decoded ({}); its base "
+            "view plays, as before",
+            pStream->index, kind, declaredBy.empty() ? declaredBy : declaredBy + ",",
+            !track.allowed && setting == KODI::MULTIVIEW::SETTING_AUTOMATIC
+                ? "the setting is on automatic and the display does not say that it takes 3D"
+            : !track.allowed ? "the setting is off"
+            : !track.decoder ? "this build has no decoder for it"
+            : !setsThere
+                ? (inBand ? "the parameter sets of the second view are not in its private "
+                            "data, nor in its packets before the first picture of that view"
+                          : "the private data of the track does not carry the parameter "
+                            "sets of the second view")
+            : keptToOne ? "Dolby Vision profile 20 whose base layer is in IPT-PQ-c2: one view is "
+                          "rebuilt with its Dolby Vision metadata, in 2D"
+                        : "the container names another layout, or one eye only");
+}
+
+void CDVDDemuxFFmpeg::LookForSecondViewSets(CDemuxStream* stream, const DemuxPacket& packet)
+{
+  const KODI::MULTIVIEW::InBand found =
+      KODI::MULTIVIEW::LookInPacket(*m_inBandSearch, packet.pData, packet.iSize);
+  if (found == KODI::MULTIVIEW::InBand::LOOKING)
+    return;
+  const KODI::MULTIVIEW::InBandSearch search = std::move(*m_inBandSearch);
+  m_inBandSearch.reset();
+  AVStream* pStream = m_pFormatContext->streams[m_inBandStream];
+  auto* video = dynamic_cast<CDemuxStreamVideo*>(stream);
+  if (found == KODI::MULTIVIEW::InBand::NOT_THERE || !video)
+  {
+    CLog::Log(LOGINFO,
+              "CDVDDemuxFFmpeg: stream {}: the parameter sets of the second view are not in its "
+              "packets before the first picture of that view ({} packets looked through): it "
+              "plays as 2D, its base view, as before",
+              m_inBandStream, search.packets);
+    return;
+  }
+  std::vector<uint8_t> record = KODI::MULTIVIEW::HvccWithSets(
+      pStream->codecpar->extradata, pStream->codecpar->extradata_size, search);
+  uint8_t* extradata =
+      record.empty()
+          ? nullptr
+          : static_cast<uint8_t*>(av_mallocz(record.size() + AV_INPUT_BUFFER_PADDING_SIZE));
+  if (!extradata)
+  {
+    CLog::Log(LOGINFO,
+              "CDVDDemuxFFmpeg: stream {}: the parameter sets of the second view found in its "
+              "packets cannot be added to its private data: it plays as 2D, as before",
+              m_inBandStream);
+    return;
+  }
+  std::memcpy(extradata, record.data(), record.size());
+  av_freep(&pStream->codecpar->extradata);
+  pStream->codecpar->extradata = extradata;
+  pStream->codecpar->extradata_size = static_cast<int>(record.size());
+  CLog::Log(LOGINFO,
+            "CDVDDemuxFFmpeg: stream {}: {} sequence and {} picture parameter sets of its second "
+            "view found in its first {} packets, before the first picture of that view",
+            m_inBandStream, search.sps.size(), search.pps.size(), search.packets);
+  ChooseTwoViews(pStream, video, true);
+  video->extraData =
+      FFmpegExtraData(pStream->codecpar->extradata, pStream->codecpar->extradata_size);
+  // VideoPlayer opens the codec of the stream again with what it is now (CheckStreamChanges()),
+  // before this packet is decoded
+  video->changes++;
+}
