From 0e7f63e6e16370102605f1a56ff904bc562e642e Mon Sep 17 00:00:00 2001
From: Hades <15710513+hadesdevls@users.noreply.github.com>
Date: Thu, 26 Nov 2026 23:32:11 +0000
Subject: [PATCH] [Hades][VideoPlayer] MV-HEVC: the card's decoder for the base
 view is asked only where its device can be had

When the processor alone does not decode both views of an MV-HEVC stream
in time, the stream is opened again with the graphics card's decoder
(VAAPI) for the base view before it goes back to its base view in 2D.
That was decided as if the display's card always had a VAAPI device; an
NVIDIA card whose NVDEC was refused for the stream has none in the
image, so the stream was opened again only to find no device there and
to measure the processor once more before 2D: one more stretch of
stutter. The device is now opened first, as Open() would, and let go at
once; without one the base view plays alone at once, said in kodi.log.
---
 .../DVDCodecs/Video/DVDVideoCodecFFmpeg.cpp   | 30 +++++++++++++++----
 .../DVDCodecs/Video/DVDVideoCodecFFmpeg.h     |  4 +++
 2 files changed, 28 insertions(+), 6 deletions(-)

diff --git a/xbmc/cores/VideoPlayer/DVDCodecs/Video/DVDVideoCodecFFmpeg.cpp b/xbmc/cores/VideoPlayer/DVDCodecs/Video/DVDVideoCodecFFmpeg.cpp
index a365da6..2162b3d 100644
--- a/xbmc/cores/VideoPlayer/DVDCodecs/Video/DVDVideoCodecFFmpeg.cpp
+++ b/xbmc/cores/VideoPlayer/DVDCodecs/Video/DVDVideoCodecFFmpeg.cpp
@@ -1202,6 +1202,29 @@ void CDVDVideoCodecFFmpeg::KeepSlow(const CDVDStreamInfo& hints)
   g_slow = {hints.filename, hints.width, hints.height};
 }
 
+bool CDVDVideoCodecFFmpeg::HybridInsteadOf2DNow() const
+{
+  KODI::MULTIVIEW::HybridBase wouldBe = KODI::MULTIVIEW::HybridBaseForTwoViews(
+      m_hints.codec == AV_CODEC_ID_HEVC, (m_hints.codecOptions & CODEC_FORCE_SOFTWARE) != 0,
+      HevcHardwareAllowed(), m_multiviewHybridFailed, false, HybridSetting(), true, true);
+  if (!KODI::MULTIVIEW::HybridInsteadOf2D(m_multiviewHybrid, m_multiviewHybridTried, wouldBe))
+    return false;
+  // (only where the display's card has a VAAPI device, as Open() would ask it: an NVIDIA card whose
+  // NVDEC was refused for this stream has none, and opening the stream again for it would only
+  // measure the processor once more before 2D; the device is let go at once)
+  std::string node;
+  AVBufferRef* device = DisplayVaapiDevice(node);
+  if (!device)
+  {
+    CLog::Log(LOGINFO,
+              "CDVDVideoCodecFFmpeg: the graphics card's decoder for the base view is not asked: {}",
+              KODI::MULTIVIEW::HybridBaseWhyNot(KODI::MULTIVIEW::HybridBase::NO_DEVICE));
+    return false;
+  }
+  av_buffer_unref(&device);
+  return true;
+}
+
 CDVDVideoCodec::VCReturn CDVDVideoCodecFFmpeg::LeaveMultiview()
 {
   // Hades: where NVDEC gave the views and they could not be had (not for slowness: the processor
@@ -1211,12 +1234,7 @@ CDVDVideoCodec::VCReturn CDVDVideoCodecFFmpeg::LeaveMultiview()
   // Hades: the processor alone did not keep up: the graphics card's decoder for the base view,
   // where it can be had and was not tried for this stream, before the base view plays alone
   // (KODI::MULTIVIEW::HybridInsteadOf2D())
-  if (m_multiview->Slow() && !m_multiviewNvdec &&
-      KODI::MULTIVIEW::HybridInsteadOf2D(
-          m_multiviewHybrid, m_multiviewHybridTried,
-          KODI::MULTIVIEW::HybridBaseForTwoViews(
-              m_hints.codec == AV_CODEC_ID_HEVC, (m_hints.codecOptions & CODEC_FORCE_SOFTWARE) != 0,
-              HevcHardwareAllowed(), m_multiviewHybridFailed, false, HybridSetting(), true, true)))
+  if (m_multiview->Slow() && !m_multiviewNvdec && HybridInsteadOf2DNow())
   {
     CLog::Log(LOGINFO,
               "CDVDVideoCodecFFmpeg: {}: the stream is opened again with the graphics card's "
diff --git a/xbmc/cores/VideoPlayer/DVDCodecs/Video/DVDVideoCodecFFmpeg.h b/xbmc/cores/VideoPlayer/DVDCodecs/Video/DVDVideoCodecFFmpeg.h
index 0a5e2aa..50dcf27 100644
--- a/xbmc/cores/VideoPlayer/DVDCodecs/Video/DVDVideoCodecFFmpeg.h
+++ b/xbmc/cores/VideoPlayer/DVDCodecs/Video/DVDVideoCodecFFmpeg.h
@@ -214,6 +214,10 @@ protected:
   //! Hades: what a picture of the decoder of both views says of its base view
   //! (KODI::MULTIVIEW::HybridSaw()); false where the stream is to be opened again (LeaveHybrid())
   bool HybridSaw(const AVFrame* frame);
+  //! Hades: whether a stream whose two views the processor did not decode in time is opened again
+  //! with the graphics card's decoder for the base view (KODI::MULTIVIEW::HybridInsteadOf2D(), and a
+  //! VAAPI device of the display that can be had) rather than playing its base view alone
+  bool HybridInsteadOf2DNow() const;
   //! Hades: the graphics card's decoder of the base view given up after its pictures were used:
   //! the stream is opened again, both views decoded by the processor
   CDVDVideoCodec::VCReturn LeaveHybrid();
