+++ b/addons/skin.estuary/language/resource.language.en_gb/strings.po
@@ -4281,12 +4281,6 @@ msgctxt "#32754"
 msgid "IPT-PQ-c2 (Dolby Vision)"
 msgstr ""
 
-#: addons/skin.estuary/xml/DialogPlayerProcessInfo.xml
-#. Hades, footer: the cache of the player
-msgctxt "#32755"
-msgid "Cache"
-msgstr ""
-
 #: addons/skin.estuary/xml/DialogPlayerProcessInfo.xml
 #. Hades, row: the part of the picture that is not bars
 msgctxt "#32760"
@@ -4563,12 +4557,6 @@ msgctxt "#32818"
 msgid "Processor (software)"
 msgstr ""
 
-#: addons/skin.estuary/xml/DialogPlayerProcessInfo.xml
-#. Hades, heading: the processor, graphics card and memory
-msgctxt "#32819"
-msgid "Resources"
-msgstr ""
-
 #: addons/skin.estuary/xml/Variables.xml
 #. Hades, reason on the Dolby Vision page of the player information: the EDID of the TV input has no Dolby Vision block (a TV may leave it out in its 4K120 or VRR input mode)
 msgctxt "#41170"
