From 1c3cd754e061ece0afb4f25d66f3e9b84dcb4530 Mon Sep 17 00:00:00 2001
From: ksooo <kai.sommerfeld@gmx.com>
Date: Mon, 16 Nov 2026 22:01:05 +0100
Subject: [PATCH] [AudioEngine] ActiveAE: Do not raise the limit for audible
 samples at stream start

With resampling, the sync threshold is five times as high while the
clock runs 5 % off. Samples played while the sync error of a starting
stream is measured stayed audible up to that limit, but the error is
adjusted regardless of it. A live TV channel starting with a low audio
buffer then played 100 ms of audio, followed by up to a second of
silence.

(cherry picked from commit 30c0eb7cc8b6cea9ac2943ed7a7d563e91444fd4)
---
 xbmc/cores/AudioEngine/Engines/ActiveAE/ActiveAE.cpp | 5 ++++-
 1 file changed, 4 insertions(+), 1 deletion(-)

diff --git a/xbmc/cores/AudioEngine/Engines/ActiveAE/ActiveAE.cpp b/xbmc/cores/AudioEngine/Engines/ActiveAE/ActiveAE.cpp
index 83bf841..f76d321 100644
--- a/xbmc/cores/AudioEngine/Engines/ActiveAE/ActiveAE.cpp
+++ b/xbmc/cores/AudioEngine/Engines/ActiveAE/ActiveAE.cpp
@@ -3292,9 +3292,12 @@ CSampleBuffer* CActiveAE::SyncStream(CActiveAEStream *stream)
 
   double error;
   double threshold = 100;
+  // The error measured at the start of a stream is adjusted whatever the clock speed is.
+  double startThreshold = threshold;
   if (stream->m_resampleMode)
   {
     threshold *= 2;
+    startThreshold = threshold;
     if (stream->m_pClock)
     {
       double clockspeed = stream->m_pClock->GetClockSpeed();
@@ -3330,7 +3333,7 @@ CSampleBuffer* CActiveAE::SyncStream(CActiveAEStream *stream)
   const bool clockFollowsAudio{!stream->m_resampleMode && !IsTrueHDPassthrough()};
   const auto keepAudible = [&](double syncError)
   {
-    return fabs(syncError) <= threshold ||
+    return fabs(syncError) <= startThreshold ||
            (clockFollowsAudio && syncError < 0 && -syncError <= MAX_LATE_START_MS);
   };
 
