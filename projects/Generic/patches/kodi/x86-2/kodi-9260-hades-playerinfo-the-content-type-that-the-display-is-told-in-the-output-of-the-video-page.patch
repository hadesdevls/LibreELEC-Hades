diff --git a/xbmc/windowing/gbm/WinSystemGbmGLESContext.cpp b/xbmc/windowing/gbm/WinSystemGbmGLESContext.cpp
index 104c54d..faeab01 100644
--- a/xbmc/windowing/gbm/WinSystemGbmGLESContext.cpp
+++ b/xbmc/windowing/gbm/WinSystemGbmGLESContext.cpp
@@ -12294,6 +12294,7 @@ void CWinSystemGbmGLESContext::PublishPlayerInfo()
       {"hades.out.modeplain", ""},
       {"hades.out.signal", ""},
       {"hades.out.colorspace", ""},
+      {"hades.out.content", ""},
       {"hades.out.depthkind", ""},
       {"hades.out.depth", ""},
       {"hades.out.plane", ""},
@@ -12540,6 +12541,16 @@ void CWinSystemGbmGLESContext::PublishPlayerInfo()
           info["hades.out.vrrtext"] = text;
         }
       }
+      // Hades: the content type that the AVI InfoFrame says (ContentType.h)
+      if (const auto content = value(KODI::WINDOWING::GBM::CONTENT_TYPE::PROPERTY))
+      {
+        namespace CT = KODI::WINDOWING::GBM::CONTENT_TYPE;
+        const auto name = connector->GetPropertyEnumName(CT::PROPERTY, *content);
+        const auto type = name ? CT::TypeOfName(*name) : std::nullopt;
+        if (type)
+          info["hades.out.content"] = CT::RowValue(
+              CT::AviOf(CT::DriverOf(m_playerInfoDriver), *type, NativeDVOutputInUse()));
+      }
       if (const auto colorspace = value("Colorspace"))
         info["hades.out.colorspace"] =
             connector->GetPropertyEnumName("Colorspace", *colorspace).value_or("");
