From 0c6000b7f59f5d01936bfc4564cdba98e4ab40c0 Mon Sep 17 00:00:00 2001
From: Garrett Brown <themagnificentmrb@gmail.com>
Date: Wed, 11 Nov 2026 13:23:19 -0800
Subject: [PATCH] [test] Avoid folder-stack suffixes in fanart fixture paths

Random directory suffixes such as cd1 can match folder-stack expressions
and make the stacked fanart test look for the wrong basename. Put the
random portion before a fixed suffix to keep the fixture unambiguous.

AI-review: Astra (Extra High reasoning effort)
(cherry picked from commit f0027cf1a0b8ebb492110eb2066cea901fbde761)
---
 xbmc/utils/test/TestArtUtils.cpp | 3 ++-
 1 file changed, 2 insertions(+), 1 deletion(-)

diff --git a/xbmc/utils/test/TestArtUtils.cpp b/xbmc/utils/test/TestArtUtils.cpp
index 2ac6fc4..f922557 100644
--- a/xbmc/utils/test/TestArtUtils.cpp
+++ b/xbmc/utils/test/TestArtUtils.cpp
@@ -376,7 +376,8 @@ TEST_P(GetLocalFanartTest, GetLocalFanart)
     std::error_code ec;
     auto tmpdir = KODI::PLATFORM::FILESYSTEM::temp_directory_path(ec);
     ASSERT_TRUE(!ec);
-    uniq = unique_path("FanartTest%%%%%");
+    // A random suffix can be mistaken for a stacked movie folder (e.g. "cd1").
+    uniq = unique_path("%%%%%FanartTest");
     path = URIUtils::AddFileToFolder(tmpdir, uniq);
     URIUtils::AddSlashAtEnd(path);
     XFILE::CDirectory::Create(path);
-- 
