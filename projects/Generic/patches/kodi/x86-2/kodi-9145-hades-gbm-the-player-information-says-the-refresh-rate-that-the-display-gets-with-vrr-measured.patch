+/*!
+ * \brief The rate of the flips of a video at its own rate as they went out, for the player
+ *        information: the median of the last WINDOW intervals between the out-fences of two flips
+ *        asked one slot apart (the kernel's time of each one's completion, CWinSystemGbm::VrrVideoFenced();
+ *        the vblanks of the CRTC where a driver gives no out-fence). A slot that a late flip missed is
+ *        no refresh rate and is left out; the median keeps a late flip from moving the rate. With VRR
+ *        on, each flip is a refresh of the display: this is the rate it gets, which its own information
+ *        shows (the LG C5 47 Hz and the Samsung Odyssey G60SD 72 Hz in the test of 2026-11-19, where the
+ *        player information said 120 and 359.999 Hz, the rates of the modes).
+ */
+class CFlipRate
+{
+public:
+  static constexpr size_t WINDOW = 96;
+  static constexpr size_t MIN_INTERVALS = 24;
+
+  void Reset() { *this = CFlipRate(); }
+  //! \return whether the interval counts (it was asked one period apart, within a quarter of one)
+  bool Add(int64_t actualNs, int64_t askedNs, double periodNs)
+  {
+    if (!(periodNs > 0.0) || actualNs <= 0 ||
+        std::fabs(static_cast<double>(askedNs) - periodNs) > periodNs / 4.0)
+      return false;
+    m_ring[m_next] = actualNs;
+    m_next = (m_next + 1) % WINDOW;
+    m_count = std::min(m_count + 1, WINDOW);
+    return true;
+  }
+  size_t Count() const { return m_count; }
+  //! the rate in Hz; 0 until MIN_INTERVALS intervals counted
+  double Hz() const
+  {
+    if (m_count < MIN_INTERVALS)
+      return 0.0;
+    std::array<int64_t, WINDOW> sorted{};
+    std::copy(m_ring.begin(), m_ring.begin() + static_cast<std::ptrdiff_t>(m_count),
+              sorted.begin());
+    const auto middle = sorted.begin() + static_cast<std::ptrdiff_t>(m_count / 2);
+    std::nth_element(sorted.begin(), middle, sorted.begin() + static_cast<std::ptrdiff_t>(m_count));
+    return *middle > 0 ? 1e9 / static_cast<double>(*middle) : 0.0;
+  }
+
+private:
+  std::array<int64_t, WINDOW> m_ring{};
+  size_t m_next = 0;
+  size_t m_count = 0;
+};
+
+//! The measured rate within this share of the rate asked for is that rate (the display counts the
+//! same): the player information says the rate asked for, which the flips were measured to keep
+constexpr double SHOWN_AGREES = 0.02;
+
+//! The refresh rate that the player information says (ShownRefresh())
+struct Shown
+{
+  double hz = 0.0;
+  bool vrr = false; //!< the rate of the flips of a video at its own rate with VRR, not the mode's
+};
+
+/*!
+ * \brief The refresh rate that the display gets, for the player information: where VRR follows a
+ *        video at its own rate (Applied::FOLLOWS) and the flips were measured (CFlipRate), their rate:
+ *        the rate asked for where the measure agrees with it within SHOWN_AGREES, the measure where it
+ *        does not; else the refresh rate of the mode (also while VRR is being checked, or before the
+ *        flips are measured). Never a rate that was not measured.
+ */
+inline Shown ShownRefresh(Applied applied, double modeHz, double askedHz, double measuredHz)
+{
+  if (applied == Applied::FOLLOWS && askedHz > 0.0 && measuredHz > 0.0 && std::isfinite(measuredHz))
+    return {std::fabs(measuredHz - askedHz) <= askedHz * SHOWN_AGREES ? askedHz : measuredHz, true};
+  return {modeHz, false};
+}
+
+//! What the VRR row of the player information is told (RowValue())
+struct RowFacts
+{
+  Applied applied = Applied::NONE; //!< a video at its own rate: what became of its VRR
+  int multiple = 0; //!< ... each picture k times
+  //! ... VRR did not come on, and the mode the video plays in has no whole multiple of its rate
+  bool refusedNoMode = false;
+  bool nativeDV = false; //!< native Dolby Vision has the output
+  //! a video plays in a mode with no whole multiple of its rate, and the display has no mode at its
+  //! rate or twice it at any resolution (DisplayHasModeFor())
+  bool playingNoMode = false;
+  std::optional<uint64_t> enabled; //!< VRR_ENABLED of the CRTC
+  std::optional<uint64_t> heldOff; //!< NV_HDMI_VRR_OFF of the connector (CHdmiVrrOff)
+  //! ... asked for by the settings: neither "HDMI variable refresh rate (VRR)" nor "Video at its own
+  //! rate with VRR" leaves VRR to the driver in Kodi's mode sets (CHdmiVrrOff::Allowed())
+  bool heldBySetting = false;
+  std::optional<uint64_t> capable; //!< vrr_capable of the connector
+};
+
+/*!
+ * \brief The value of hades.out.vrr (the VRR row of the System page): for a video at its own rate,
+ *        what became of it (each picture shown more than once: "repeats", whose text says how many
+ *        times and why, below the display's VRR minimum); native Dolby Vision, which changes the mode
+ *        ("dv"); VRR on the CRTC ("on"); a video in a mode that does not show it evenly, on a display
+ *        with no mode at its rate ("nomode": the case of the Samsung Odyssey G60SD with VRR off); held
+ *        off by the settings ("setting") or for HDR10+ ("held"); else what the display and the driver
+ *        offer.
+ */
+inline const char* RowValue(const RowFacts& f)
+{
+  if (f.applied != Applied::NONE)
+  {
+    if (f.applied == Applied::FOLLOWS)
+      return f.multiple > 1 ? "repeats" : "follows";
+    const char* name = AppliedName(f.applied);
+    return std::string_view(name) == "fixed" && f.refusedNoMode ? "nomode" : name;
+  }
+  const bool offered = f.capable && *f.capable;
+  const bool held = f.heldOff && *f.heldOff;
+  if (f.nativeDV && (offered || held))
+    return "dv";
+  if (f.enabled && *f.enabled)
+    return "on";
+  if (f.playingNoMode && offered)
+    return "nomode";
+  if (held)
+    return f.heldBySetting ? "setting" : "held";
+  return f.capable ? (*f.capable ? "offered" : "none") : "unknown";
+}
