From f054b2f321662323d7d608c3cdc51e8221ba5b9e Mon Sep 17 00:00:00 2001
From: Hades <15710513+hadesdevls@users.noreply.github.com>
Date: Wed, 18 Nov 2026 21:35:22 +0000
Subject: [PATCH] dialogs: the player information has its temperatures read
 ahead

The temperature that the panel shows (System.CPUTemperature, and
System.GPUTemperature where a skin's dialog shows it) is now read in
the background (CSystemGUIInfo, CBackgroundReading): before its first
reading has ended the label is empty, and the panel would open with
"12 %" and show "12 %, 45 C" a moment later.

When the skin file of the player information is loaded, ahead in the
idle menus (CWindowPreload) or at its first open, the temperatures that
it names are asked for once, which starts their reading in the
background, so that the first open over a video already has a value.
The same for the dialog of Hades' pages in other skins
(CGUIDialogHadesPlayerInfo). Info labels are matched in any case.
---
 xbmc/dialogs/GUIDialogHadesPlayerInfo.cpp   | 13 +++++++++++++
 xbmc/dialogs/GUIDialogHadesPlayerInfo.h     |  2 ++
 xbmc/dialogs/GUIDialogPlayerProcessInfo.cpp | 18 ++++++++++++++++++
 xbmc/dialogs/GUIDialogPlayerProcessInfo.h   |  7 +++++++
 4 files changed, 40 insertions(+)

diff --git a/xbmc/dialogs/GUIDialogHadesPlayerInfo.cpp b/xbmc/dialogs/GUIDialogHadesPlayerInfo.cpp
index 671e6ac..1e4410d 100644
--- a/xbmc/dialogs/GUIDialogHadesPlayerInfo.cpp
+++ b/xbmc/dialogs/GUIDialogHadesPlayerInfo.cpp
@@ -8,12 +8,14 @@
 
 #include "GUIDialogHadesPlayerInfo.h"
 
+#include "GUIDialogPlayerProcessInfo.h"
 #include "addons/Skin.h"
 #include "filesystem/SpecialProtocol.h"
 #include "guilib/WindowIDs.h"
 #include "input/actions/Action.h"
 #include "input/actions/ActionIDs.h"
 #include "utils/FileUtils.h"
+#include "utils/XBMCTinyXML.h"
 #include "utils/log.h"
 
 CGUIDialogHadesPlayerInfo::CGUIDialogHadesPlayerInfo()
@@ -48,3 +50,14 @@ bool CGUIDialogHadesPlayerInfo::LoadXML(const std::string& strPath, const std::s
             GetProperty("xmlfile").asString(), path);
   return CGUIDialog::LoadXML(path, path);
 }
+
+void CGUIDialogHadesPlayerInfo::OnWindowLoaded()
+{
+  CGUIDialog::OnWindowLoaded();
+  if (m_windowXMLRootElement)
+  {
+    TiXmlPrinter printer;
+    m_windowXMLRootElement->Accept(&printer);
+    CGUIDialogPlayerProcessInfo::ReadTemperaturesAhead(printer.CStr());
+  }
+}
diff --git a/xbmc/dialogs/GUIDialogHadesPlayerInfo.h b/xbmc/dialogs/GUIDialogHadesPlayerInfo.h
index 5be8bf1..b3ed765 100644
--- a/xbmc/dialogs/GUIDialogHadesPlayerInfo.h
+++ b/xbmc/dialogs/GUIDialogHadesPlayerInfo.h
@@ -37,4 +37,6 @@ public:
 
 protected:
   bool LoadXML(const std::string& strPath, const std::string& strLowerPath) override;
+  //! its temperatures read ahead (CGUIDialogPlayerProcessInfo::ReadTemperaturesAhead())
+  void OnWindowLoaded() override;
 };
diff --git a/xbmc/dialogs/GUIDialogPlayerProcessInfo.cpp b/xbmc/dialogs/GUIDialogPlayerProcessInfo.cpp
index 859fafc..0c3e575 100644
--- a/xbmc/dialogs/GUIDialogPlayerProcessInfo.cpp
+++ b/xbmc/dialogs/GUIDialogPlayerProcessInfo.cpp
@@ -8,6 +8,7 @@
 
 #include "GUIDialogPlayerProcessInfo.h"
 
+#include "GUIInfoManager.h"
 #include "ServiceBroker.h"
 #include "addons/Skin.h"
 #include "application/ApplicationComponents.h"
@@ -15,10 +16,12 @@
 #include "filesystem/File.h"
 #include "guilib/GUIComponent.h"
 #include "guilib/GUIWindowManager.h"
+#include "guilib/guiinfo/GUIInfoLabels.h"
 #include "input/actions/Action.h"
 #include "input/actions/ActionIDs.h"
 #include "settings/Settings.h"
 #include "settings/SettingsComponent.h"
+#include "utils/StringUtils.h"
 #include "utils/XBMCTinyXML.h"
 #include "utils/log.h"
 
@@ -89,5 +92,20 @@ void CGUIDialogPlayerProcessInfo::OnWindowLoaded()
     TiXmlPrinter printer;
     m_windowXMLRootElement->Accept(&printer);
     m_showsHades = std::string_view(printer.CStr()).find("Property(hades.") != std::string_view::npos;
+    ReadTemperaturesAhead(printer.CStr());
   }
 }
+
+void CGUIDialogPlayerProcessInfo::ReadTemperaturesAhead(std::string_view xml)
+{
+  auto* gui = CServiceBroker::GetGUI();
+  if (!gui)
+    return;
+  // (info labels are written in any case)
+  const std::string lower = StringUtils::ToLower(std::string(xml));
+  auto& infoManager = gui->GetInfoManager();
+  if (lower.find("system.cputemperature") != std::string::npos)
+    infoManager.GetLabel(SYSTEM_CPU_TEMPERATURE, INFO::DEFAULT_CONTEXT);
+  if (lower.find("system.gputemperature") != std::string::npos)
+    infoManager.GetLabel(SYSTEM_GPU_TEMPERATURE, INFO::DEFAULT_CONTEXT);
+}
diff --git a/xbmc/dialogs/GUIDialogPlayerProcessInfo.h b/xbmc/dialogs/GUIDialogPlayerProcessInfo.h
index e501507..cb1b40e 100644
--- a/xbmc/dialogs/GUIDialogPlayerProcessInfo.h
+++ b/xbmc/dialogs/GUIDialogPlayerProcessInfo.h
@@ -10,6 +10,8 @@
 
 #include "guilib/GUIDialog.h"
 
+#include <string_view>
+
 class CGUIDialogPlayerProcessInfo : public CGUIDialog
 {
 public:
@@ -22,6 +24,11 @@ public:
   //! DialogPlayerProcessInfo.xml otherwise; a change of the file loads it again
   void AllocResources(bool forceLoad = false) override;
 
+  //! Hades: the temperatures that the skin file \a xml of a dialog shows (System.CPUTemperature,
+  //! System.GPUTemperature) asked for once, so that they are read in the background while it loads
+  //! (ahead, in the idle menus: CWindowPreload) and its first open over a video shows them at once
+  static void ReadTemperaturesAhead(std::string_view xml);
+
 protected:
   void OnWindowLoaded() override;
 
-- 
