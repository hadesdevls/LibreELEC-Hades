From b8191658852bd2be3d461e28f3ea954c826c75cc Mon Sep 17 00:00:00 2001
From: olympia <olympia@xbmc.org>
Date: Tue, 17 Nov 2026 09:01:41 +0000
Subject: [PATCH] [BackgroundInfoLoader] Test an item held twice

Holds can be nested, for example when the list item that a dialog holds
is updated from a message while the dialog is open. Check that the
loader leaves such an item alone until the last hold ends.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>

[Hades: the test goes after the other tests of holds, before the
tests of a stopped read that Hades adds at the end of the file.]
(cherry picked from commit e80c433ba0e1e3a92c600056a77ea2a9b0cbec35)
---
 xbmc/test/TestBackgroundInfoLoader.cpp | 20 ++++++++++++++++++++
 1 file changed, 20 insertions(+)

diff --git a/xbmc/test/TestBackgroundInfoLoader.cpp b/xbmc/test/TestBackgroundInfoLoader.cpp
index 915fff9..c936218 100644
--- a/xbmc/test/TestBackgroundInfoLoader.cpp
+++ b/xbmc/test/TestBackgroundInfoLoader.cpp
@@ -129,6 +129,26 @@ TEST(TestBackgroundInfoLoader, StopWakesWaitForHeldItem)
   EXPECT_EQ(loader.Calls(), (std::vector<std::string>{"cached:b", "lookup:b"}));
 }
 
+TEST(TestBackgroundInfoLoader, ItemHeldTwiceIsLoadedAfterBothHolds)
+{
+  CFileItemList items;
+  AddItems(items);
+  CRecordingLoader loader;
+  {
+    const CBackgroundInfoLoader::CItemHold outer{loader, items[0].get()};
+    {
+      const CBackgroundInfoLoader::CItemHold inner{loader, items[0].get()};
+      loader.Load(items);
+      ASSERT_TRUE(ConditionPoll::poll([&loader] { return loader.Calls().size() >= 2; }));
+    }
+    std::this_thread::sleep_for(200ms);
+    EXPECT_EQ(loader.Calls(), (std::vector<std::string>{"cached:b", "lookup:b"}));
+  }
+  ASSERT_TRUE(ConditionPoll::poll([&loader] { return !loader.IsLoading(); }));
+  EXPECT_EQ(loader.Calls(),
+            (std::vector<std::string>{"cached:b", "lookup:b", "cached:a", "lookup:a"}));
+}
+
 namespace
 {
 //! An item that reads a file: the read ends when the file answers, and, if it looks at the flag as
