+#pragma once
+
+#include <algorithm>
+#include <cerrno>
+#include <cmath>
+#include <cstdint>
+#include <cstdlib>
+#include <optional>
+#include <string>
+
+namespace KODI
+{
+namespace SETTINGS
+{
+
+/*!
+ * \brief Hades: the defaults of the file cache (Settings > Services > Caching), from the RAM of the machine and from the
+ *        <cache> of an advancedsettings.xml
+ *
+ * Since Kodi 21 the cache is set in the settings, and Kodi reads nothing of the <cache> of advancedsettings.xml: a
+ * <memorysize> that a guide (or a forum, 30362 #813) gives is left out without a word. Hades takes those values as the
+ * defaults of the settings, so that they hold unless the user has set the setting itself (a value set in the settings
+ * stays, and kodi.log says which one is used). Each is taken in the units advancedsettings.xml had it, and brought to
+ * the nearest choice of its setting that is not more: memorysize in bytes (0, the cache on disk), buffermode by the
+ * same codes (CacheBufferMode), readfactor as a factor (4.0), chunksize in bytes.
+ *
+ * Kodi needs as much memory as the setting while a file plays (two buffers of half the size for a file of several
+ * streams, CFileCache::Open()), so a memorysize is taken up to a quarter of the RAM, and never above the largest
+ * choice, 2 GB, which CFileCache allows.
+ *
+ * The default without an advancedsettings.xml follows the RAM the kernel reports, about 1/14 of it at each step (an
+ * "8 GB" machine reports 7.3 to 7.8 GiB): 64 MB below 3.5 GiB or where the RAM is not known, 256 MB from 3.5 GiB,
+ * 512 MB from 7 GiB, 1 GB from 14 GiB and 2 GB from 28 GiB. A file of several streams (Matroska) holds 3/8 of it
+ * ahead (two buffers, each 3/4 ahead): at the 130 Mbit/s of the densest Dolby Vision FEL remuxes, 64 MB hold 1.5 s
+ * ahead, 512 MB 12 s, 1 GB 25 s and 2 GB 50 s.
+ */
+namespace FILECACHE
+{
+//! the choices of filecache.memorysize, in MB (0, the cache on disk, besides), as CServicesSettings lists them
+inline constexpr int MEMORY_SIZES[] = {16, 20, 24, 32, 48, 64, 96, 128, 192, 256, 384, 512, 768, 1024, 2048};
+//! ... of filecache.readfactor, x100 (0, adaptive, besides)
+inline constexpr int READ_FACTORS[] = {110, 125, 150, 175, 200, 250, 300, 400, 500, 700, 1000, 1500, 2000, 3000, 5000};
+//! ... of filecache.chunksize, in bytes
+inline constexpr int CHUNK_SIZES[] = {256,        512,         1024,       2 * 1024,   4 * 1024,
+                                      8 * 1024,   16 * 1024,   32 * 1024,  64 * 1024,  128 * 1024,
+                                      256 * 1024, 512 * 1024,  1024 * 1024};
+//! ... of filecache.buffermode: CacheBufferMode, INTERNET (0) to NETWORK (4)
+inline constexpr int BUFFER_MODE_MAX = 4;
+
+inline constexpr uint64_t GiB = uint64_t(1024) * 1024 * 1024;
+
+//! The default of filecache.memorysize, in MB, for a machine with this much RAM in bytes (0: not known)
+inline int DefaultMemorySize(uint64_t totalRam)
+{
+  if (totalRam >= 28 * GiB)
+    return 2048;
+  if (totalRam >= 14 * GiB)
+    return 1024;
+  if (totalRam >= 7 * GiB)
+    return 512;
+  if (totalRam >= 7 * GiB / 2)
+    return 256;
+  return 64; // Kodi's default, also when the RAM is not known
+}
+
+//! The largest choice of memory that a value of advancedsettings.xml is taken up to: at most a quarter of the RAM
+//! (2 GB where the RAM is not known), and 16 MB at least
+inline int MostMemory(uint64_t totalRam)
+{
+  const uint64_t quarter = totalRam ? totalRam / 4 / (1024 * 1024) : 2048;
+  int most = MEMORY_SIZES[0];
+  for (const int size : MEMORY_SIZES)
+  {
+    if (static_cast<uint64_t>(size) <= quarter)
+      most = size;
+  }
+  return most;
+}
+
+//! A whole number of a value of advancedsettings.xml (spaces around it allowed), or nothing
+inline std::optional<long long> Integer(const std::string& text)
+{
+  const size_t from = text.find_first_not_of(" \t\r\n");
+  if (from == std::string::npos)
+    return std::nullopt;
+  const std::string trimmed = text.substr(from, text.find_last_not_of(" \t\r\n") - from + 1);
+  errno = 0;
+  char* end = nullptr;
+  const long long value = std::strtoll(trimmed.c_str(), &end, 10);
+  if (errno || end == trimmed.c_str() || *end)
+    return std::nullopt;
+  return value;
+}
+
+//! A number of a value of advancedsettings.xml, as 4 or 4.0, or nothing
+inline std::optional<double> Number(const std::string& text)
+{
+  const size_t from = text.find_first_not_of(" \t\r\n");
+  if (from == std::string::npos)
+    return std::nullopt;
+  const std::string trimmed = text.substr(from, text.find_last_not_of(" \t\r\n") - from + 1);
+  errno = 0;
+  char* end = nullptr;
+  const double value = std::strtod(trimmed.c_str(), &end);
+  if (errno || end == trimmed.c_str() || *end || !std::isfinite(value))
+    return std::nullopt;
+  return value;
+}
+
+//! What the <cache> of advancedsettings.xml gives, as values of the settings; each one that it does not give, or not
+//! as advancedsettings.xml had it, is not there
+struct FromAdvanced
+{
+  std::optional<int> memorySize; //!< MB
+  bool memoryBounded = false; //!< memorysize was more than MostMemory(), which memorySize is then
+  std::optional<int> bufferMode;
+  std::optional<int> readFactor; //!< x100
+  std::optional<int> chunkSize; //!< bytes
+  bool Any() const { return memorySize || bufferMode || readFactor || chunkSize; }
+};
+
+//! The texts of <memorysize>, <buffermode>, <readfactor> and <chunksize> (nullptr: not there)
+inline FromAdvanced TakeAdvanced(const char* memorysize,
+                                 const char* buffermode,
+                                 const char* readfactor,
+                                 const char* chunksize,
+                                 uint64_t totalRam)
+{
+  FromAdvanced taken;
+  if (memorysize)
+  {
+    if (const auto bytes = Integer(memorysize); bytes && *bytes >= 0)
+    {
+      if (*bytes == 0)
+        taken.memorySize = 0;
+      else
+      {
+        const long long mb = *bytes / (1024 * 1024);
+        int size = MEMORY_SIZES[0];
+        for (const int choice : MEMORY_SIZES)
+        {
+          if (choice <= mb)
+            size = choice;
+        }
+        const int most = MostMemory(totalRam);
+        taken.memoryBounded = mb > most;
+        taken.memorySize = std::min(size, most);
+      }
+    }
+  }
+  if (buffermode)
+  {
+    if (const auto mode = Integer(buffermode); mode && *mode >= 0 && *mode <= BUFFER_MODE_MAX)
+      taken.bufferMode = static_cast<int>(*mode);
+  }
+  if (readfactor)
+  {
+    // (0 or less: no factor; the nearest choice, the lower one of two as near)
+    if (const auto factor = Number(readfactor); factor && *factor > 0 && *factor <= 1000)
+    {
+      const double x100 = *factor * 100.0;
+      int best = READ_FACTORS[0];
+      for (const int choice : READ_FACTORS)
+      {
+        if (std::fabs(choice - x100) < std::fabs(best - x100))
+          best = choice;
+      }
+      taken.readFactor = best;
+    }
+  }
+  if (chunksize)
+  {
+    if (const auto bytes = Integer(chunksize); bytes && *bytes > 0)
+    {
+      int size = CHUNK_SIZES[0];
+      for (const int choice : CHUNK_SIZES)
+      {
+        if (choice <= *bytes)
+          size = choice;
+      }
+      taken.chunkSize = size;
+    }
+  }
+  return taken;
+}
+
+} // namespace FILECACHE
+} // namespace SETTINGS
+} // namespace KODI
