+    };
+    text("memorysize", m_cacheMemorySize);
+    text("buffermode", m_cacheBufferMode);
+    text("readfactor", m_cacheReadFactor);
+    text("chunksize", m_cacheChunkSize);
+  }
+
   pElement = pRootElement->FirstChildElement("network");
   if (pElement)
   {
