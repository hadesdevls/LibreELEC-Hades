From 61de1ebec55f9a8f2393143f095b3b163a6cdea1 Mon Sep 17 00:00:00 2001
From: Kel Modderman <kelvmod@gmail.com>
Date: Sun, 1 Nov 2026 22:49:13 +1000
Subject: [PATCH] Keep XBPython when Python is left running at exit

When a script is left running at exit, CScriptInvocationManager stops
waiting for its thread, and XBPython keeps the GIL and skips
Py_Finalize(). The thread can still be on its way out, though: once it
has released the GIL for the last time, it calls
XBPython::OnExecutionEnded() without it, and if it is held up on the
way there until CServiceManager::DeinitStageOne() has destroyed
XBPython, it uses freed memory.

Leave XBPython allocated in that case. Its destructor does nothing then
besides removing it from the announcement manager, which Uninitialize()
has already done.

Assisted-by: Claude
(cherry picked from commit 828c5bc65f2b9071143a79eeacf7ae08b8839930)
(cherry picked from commit f249b0c7dfc28e6ad2ad0842394a02189023e482)
---
 xbmc/ServiceManager.cpp           | 6 +++++-
 xbmc/interfaces/python/XBPython.h | 2 ++
 2 files changed, 7 insertions(+), 1 deletion(-)

diff --git a/xbmc/ServiceManager.cpp b/xbmc/ServiceManager.cpp
index 929a8f2..cd4004a 100644
--- a/xbmc/ServiceManager.cpp
+++ b/xbmc/ServiceManager.cpp
@@ -317,7 +317,11 @@ void CServiceManager::DeinitStageOne()
   m_slideShowDelegator.reset();
 #ifdef HAS_PYTHON
   CScriptInvocationManager::GetInstance().UnregisterLanguageInvocationHandler(m_XBPython.get());
-  m_XBPython.reset();
+  // a script left running can still call into it from its own thread
+  if (m_XBPython->IsPythonLeftRunning())
+    static_cast<void>(m_XBPython.release());
+  else
+    m_XBPython.reset();
 #endif
 
   m_Platform->DeinitStageOne();
diff --git a/xbmc/interfaces/python/XBPython.h b/xbmc/interfaces/python/XBPython.h
index 9883acb..ceba3fb 100644
--- a/xbmc/interfaces/python/XBPython.h
+++ b/xbmc/interfaces/python/XBPython.h
@@ -113,6 +113,8 @@ public:
   // Once Kodi is stopping, gives up if a script holds the GIL too long.
   std::optional<bool> RunWithGil(const std::function<bool()>& fn);
   bool IsGilLost() const { return m_gilLost; }
+  // Python wasn't finalized at exit, as a script was left running or the GIL couldn't be had
+  bool IsPythonLeftRunning() const { return m_skipFinalize || m_gilLost; }
 
   // false means an inconsistent binding runtime: types would be created by a sub-interpreter
   bool BindingModulesLoaded() const { return m_bindingModulesLoaded; }
