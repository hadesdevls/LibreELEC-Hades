From d90aef823b9361742f91ec866ef47cf300268350 Mon Sep 17 00:00:00 2001
From: Hades <15710513+hadesdevls@users.noreply.github.com>
Date: Wed, 18 Nov 2026 04:46:35 +0000
Subject: [PATCH] player information: the connection to the TV and the
 versions, for the system page

The system page of the player information says how the output reaches the
TV and what runs, read from where each is said, at the 2 Hz of the rest and
only while the page is open:
 - hades.out.link: the link that nvidia-drm says (NV_OUTPUT_LINK): frl,
   tmds, tmdsscrambled, dp; "unknown" where the driver says none (amdgpu,
   i915, xe). For FRL, hades.out.frllanes and hades.out.frlgbps
   (FrlLanesAndGbps(), new in HotplugRelink.h beside FrlRateOf(): 3 at 3,
   3 at 6, 4 at 6, 4 at 8, 4 at 10, 4 at 12 Gb/s); for TMDS,
   hades.out.tmdsmhz, its character rate (TmdsKHz(): the pixel clock of the
   mode at the depth that NV_OUTPUT_BPC says, in the format of the link).
 - hades.out.pixelformat: the format of the link (NV_OUTPUT_LINK).
 - hades.out.vrr: on where the CRTC is asked for VRR (VRR_ENABLED); held
   where nvidia-drm's HDMI VRR is held off (NV_HDMI_VRR_OFF, CHdmiVrrOff:
   HDR10+ and native Dolby Vision); else offered or none (vrr_capable);
   unknown without it.
 - hades.sys.driverversion: the version of the driver, asked once with its
   name: the NVIDIA driver's own (/sys/module/nvidia/version), as nvidia-drm's
   DRM interface says nothing of it; the DRM interface's of the others.
 - hades.sys.hades, hades.sys.build, hades.sys.kernel, read once: Hades'
   version (BUILDER_VERSION of /etc/os-release, with BUILDER_NAME where it is
   not Hades), the build (VERSION) and the kernel (uname).

The words for the link in kodi.log at a change of mode (CModesetReport) can
take FrlLanesAndGbps() too.
---
 xbmc/windowing/gbm/HotplugRelink.h            |   8 ++
 .../windowing/gbm/WinSystemGbmGLESContext.cpp | 101 ++++++++++++++++++
 xbmc/windowing/gbm/WinSystemGbmGLESContext.h  |   1 +
 3 files changed, 110 insertions(+)

diff --git a/xbmc/windowing/gbm/HotplugRelink.h b/xbmc/windowing/gbm/HotplugRelink.h
index 8a51a8c..f87222f 100644
--- a/xbmc/windowing/gbm/HotplugRelink.h
+++ b/xbmc/windowing/gbm/HotplugRelink.h
@@ -126,6 +126,14 @@ inline unsigned int FrlRateOf(std::optional<uint64_t> value)
 {
   return value ? static_cast<unsigned int>((*value >> 8) & 0xff) : 0;
 }
+//! The lanes of an FRL rate (FrlRateOf(): 1 to 6, HDMI 2.1) and the Gb/s of each: 3 at 3, 3 at 6,
+//! 4 at 6, 4 at 8, 4 at 10, 4 at 12; {0, 0} for another
+inline std::pair<unsigned int, unsigned int> FrlLanesAndGbps(unsigned int rate)
+{
+  static const std::pair<unsigned int, unsigned int> rates[] = {{3, 3},  {3, 6},  {4, 6},
+                                                                {4, 8},  {4, 10}, {4, 12}};
+  return rate >= 1 && rate <= 6 ? rates[rate - 1] : std::pair<unsigned int, unsigned int>{0, 0};
+}
 inline std::optional<Format> FormatOf(std::optional<uint64_t> value)
 {
   if (!value || LinkOf(value) == Link::UNKNOWN)
diff --git a/xbmc/windowing/gbm/WinSystemGbmGLESContext.cpp b/xbmc/windowing/gbm/WinSystemGbmGLESContext.cpp
index 4b655e0..914eea2 100644
--- a/xbmc/windowing/gbm/WinSystemGbmGLESContext.cpp
+++ b/xbmc/windowing/gbm/WinSystemGbmGLESContext.cpp
@@ -93,6 +93,7 @@ extern "C"
 #include "windowing/WindowSystemFactory.h"
 #include "windowing/gbm/DVPlusModeStart.h"
 #include "windowing/gbm/DVPlusVBlank.h"
+#include "windowing/gbm/HdmiVrrOff.h"
 #include "windowing/gbm/HotplugRelink.h"
 #include "windowing/gbm/drm/DRMDisplayWatch.h"
 #include "windowing/gbm/drm/NvidiaDualMode.h"
@@ -11165,6 +11166,12 @@ void CWinSystemGbmGLESContext::PublishPlayerInfo()
       {"hades.out.depth", ""},
       {"hades.out.plane", ""},
       {"hades.out.linkformat", ""},
+      {"hades.out.link", ""},
+      {"hades.out.frllanes", ""},
+      {"hades.out.frlgbps", ""},
+      {"hades.out.tmdsmhz", ""},
+      {"hades.out.pixelformat", ""},
+      {"hades.out.vrr", ""},
       {"hades.out.depthwhy", ""},
       {"hades.out.fbformat", ""},
       {"hades.out.fbdepth", ""},
@@ -11188,6 +11195,10 @@ void CWinSystemGbmGLESContext::PublishPlayerInfo()
       {"hades.sys.gpu", ""},
       {"hades.sys.gputemp", ""},
       {"hades.sys.gpuread", ""},
+      {"hades.sys.driverversion", ""},
+      {"hades.sys.hades", ""},
+      {"hades.sys.build", ""},
+      {"hades.sys.kernel", ""},
       // (Hades: HDR10+, the video's and what the display is sent of it)
       {"hades.video.hdr10plus", ""},
       {"hades.out.hdr10plus", ""},
@@ -11242,10 +11253,23 @@ void CWinSystemGbmGLESContext::PublishPlayerInfo()
       if (drmVersionPtr version = drmGetVersion(fd))
       {
         m_playerInfoDriver = version->name ? version->name : "";
+        // Hades: and its version, for the system page: that of its DRM interface (amdgpu, i915,
+        // xe); nvidia-drm's says nothing of the driver, whose own the module gives
+        m_playerInfoDriverVersion =
+            StringUtils::Format("{}.{}.{}", version->version_major, version->version_minor,
+                                version->version_patchlevel);
         drmFreeVersion(version);
       }
+      if (m_playerInfoDriver == "nvidia-drm")
+      {
+        std::ifstream file("/sys/module/nvidia/version");
+        std::string said;
+        if (std::getline(file, said) && !StringUtils::Trim(said).empty())
+          m_playerInfoDriverVersion = said;
+      }
     }
     info["hades.out.driver"] = m_playerInfoDriver;
+    info["hades.sys.driverversion"] = m_playerInfoDriverVersion;
     if (const auto* mode = m_DRM ? m_DRM->GetSelectedMode() : nullptr;
         mode && mode->htotal && mode->vtotal)
     {
@@ -11258,6 +11282,56 @@ void CWinSystemGbmGLESContext::PublishPlayerInfo()
     {
       info["hades.out.connector"] = connector->GetName();
       const auto value = [&](const char* name) { return connector->GetPropertyValue(name); };
+      // Hades: the connection to the TV, for the system page. The link that nvidia-drm says
+      // (NV_OUTPUT_LINK, HotplugRelink.h): FRL with its lanes and the rate of each, or TMDS with
+      // its character rate (TmdsKHz(): the pixel clock of the mode at the depth that the output
+      // goes at, NV_OUTPUT_BPC, and in its format); and that format. No other driver says it.
+      {
+        namespace RELINK = HOTPLUG_RELINK;
+        const auto link = connector->SupportsProperty("NV_OUTPUT_LINK")
+                              ? connector->ReadPropertyValue("NV_OUTPUT_LINK")
+                              : std::nullopt;
+        const RELINK::Link kind = RELINK::LinkOf(link);
+        info["hades.out.link"] = kind == RELINK::Link::TMDS             ? "tmds"
+                                 : kind == RELINK::Link::TMDS_SCRAMBLED ? "tmdsscrambled"
+                                 : kind == RELINK::Link::FRL            ? "frl"
+                                 : kind == RELINK::Link::DP             ? "dp"
+                                                                        : "unknown";
+        if (kind == RELINK::Link::FRL)
+        {
+          const auto [lanes, gbps] = RELINK::FrlLanesAndGbps(RELINK::FrlRateOf(link));
+          if (lanes)
+          {
+            info["hades.out.frllanes"] = std::to_string(lanes);
+            info["hades.out.frlgbps"] = std::to_string(gbps);
+          }
+        }
+        const auto* selected = m_DRM ? m_DRM->GetSelectedMode() : nullptr;
+        if ((kind == RELINK::Link::TMDS || kind == RELINK::Link::TMDS_SCRAMBLED) && selected &&
+            selected->clock)
+        {
+          const auto bpc = connector->ReadPropertyValue("NV_OUTPUT_BPC");
+          const int depth = bpc && *bpc ? static_cast<int>(*bpc) : 8;
+          const int64_t khz = RELINK::TmdsKHz(selected->clock, depth, RELINK::FormatOf(link));
+          info["hades.out.tmdsmhz"] = std::to_string((khz + 500) / 1000);
+        }
+        if (const auto format = RELINK::FormatOf(link))
+        {
+          static const char* const formats[] = {"rgb", "444", "422", "420"};
+          info["hades.out.pixelformat"] = formats[static_cast<int>(*format)];
+        }
+        // VRR: on where the CRTC is asked for it (VRR_ENABLED; Kodi does not flip with it); held
+        // off where nvidia-drm's HDMI VRR is (NV_HDMI_VRR_OFF: HDR10+ and native Dolby Vision,
+        // CHdmiVrrOff); else what the display and the driver offer (vrr_capable)
+        const auto* crtc = m_DRM ? m_DRM->GetCrtc() : nullptr;
+        const auto enabled = crtc ? crtc->GetPropertyValue("VRR_ENABLED") : std::nullopt;
+        const auto heldOff = value(KODI::WINDOWING::GBM::CHdmiVrrOff::PROPERTY);
+        const auto capable = value("vrr_capable");
+        info["hades.out.vrr"] = enabled && *enabled  ? "on"
+                                : heldOff && *heldOff ? "held"
+                                : capable             ? (*capable ? "offered" : "none")
+                                                      : "unknown";
+      }
       if (const auto colorspace = value("Colorspace"))
         info["hades.out.colorspace"] =
             connector->GetPropertyEnumName("Colorspace", *colorspace).value_or("");
@@ -11469,6 +11543,33 @@ void CWinSystemGbmGLESContext::PublishPlayerInfo()
     if (const int bitrate = cache.GetVideoLiveBitRate(); bitrate > 0)
       info["hades.video.bitrate"] = StringUtils::Format("{:.1f}", bitrate / 1000000.0); // Mb/s
 
+    // Hades: the versions, for the system page, read once: Hades' own (BUILDER_NAME and
+    // BUILDER_VERSION of /etc/os-release, which the image writes; the name only where it is not
+    // Hades), the build (its VERSION) and the kernel (uname)
+    static const std::array<std::string, 3> versions = []
+    {
+      std::map<std::string, std::string> os;
+      std::ifstream file("/etc/os-release");
+      for (std::string line; std::getline(file, line);)
+      {
+        const size_t equals = line.find('=');
+        if (equals == std::string::npos)
+          continue;
+        std::string text = line.substr(equals + 1);
+        if (text.size() >= 2 && text.front() == '"' && text.back() == '"')
+          text = text.substr(1, text.size() - 2);
+        os[line.substr(0, equals)] = text;
+      }
+      std::string hades = os["BUILDER_VERSION"];
+      if (!os["BUILDER_NAME"].empty() && os["BUILDER_NAME"] != "Hades")
+        hades = os["BUILDER_NAME"] + (hades.empty() ? "" : " " + hades);
+      std::string kernel = CSysInfo::GetKernelName(true) + " " + CSysInfo::GetKernelVersionFull();
+      return std::array<std::string, 3>{hades, os["VERSION"], StringUtils::Trim(kernel)};
+    }();
+    info["hades.sys.hades"] = versions[0];
+    info["hades.sys.build"] = versions[1];
+    info["hades.sys.kernel"] = versions[2];
+
     // The use of all processors, as System.CpuUsage gives it on other systems (on Linux it
     // gives each processor); the memory in use and in all, in MB as System.Memory() has them
     if (const auto cpu = CServiceBroker::GetCPUInfo(); cpu && cpu->SupportsCPUUsage())
diff --git a/xbmc/windowing/gbm/WinSystemGbmGLESContext.h b/xbmc/windowing/gbm/WinSystemGbmGLESContext.h
index 25be005..dbdce2d 100644
--- a/xbmc/windowing/gbm/WinSystemGbmGLESContext.h
+++ b/xbmc/windowing/gbm/WinSystemGbmGLESContext.h
@@ -708,6 +708,7 @@ private:
   //! two beats a second that publish them), from both publications
   KODI::UTILS::PLAYERINFO::CChangeFlash m_infoFlash;
   std::string m_playerInfoDriver; //!< the name of the DRM driver, asked once
+  std::string m_playerInfoDriverVersion; //!< its version (the NVIDIA driver's own), asked once
   //! Hades: the use and the temperature of the GPU that draws, read by a thread of their own
   //! (GPUSENSORS::CSampler: made when the dialog is first shown; what it opens is let go when the
   //! dialog closes)
-- 
