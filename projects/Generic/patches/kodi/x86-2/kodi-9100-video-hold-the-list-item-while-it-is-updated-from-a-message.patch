From 105add134ec6dd194bb0d703519996b59d267829 Mon Sep 17 00:00:00 2001
From: olympia <olympia@xbmc.org>
Date: Tue, 17 Nov 2026 09:03:48 +0000
Subject: [PATCH] [Video] Hold the list item while it is updated from a message

GUI_MSG_UPDATE_ITEM changes the list item while the thumb loader may be
loading it. The information dialog sends it for the item it shows, which
the hold of the dialog no longer covers once the dialog moved on to
another item, and saving the playback state sends it too when playback
stops. Hold the item that the update changes.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
(cherry picked from commit f831e2f2c6e291a47d31cd0e2a177285135b6ae7)
---
 xbmc/video/windows/GUIWindowVideoBase.cpp | 18 +++++++++++++++---
 1 file changed, 15 insertions(+), 3 deletions(-)

diff --git a/xbmc/video/windows/GUIWindowVideoBase.cpp b/xbmc/video/windows/GUIWindowVideoBase.cpp
index 27e1563..8712341 100644
--- a/xbmc/video/windows/GUIWindowVideoBase.cpp
+++ b/xbmc/video/windows/GUIWindowVideoBase.cpp
@@ -220,9 +220,21 @@ bool CGUIWindowVideoBase::OnMessage(CGUIMessage& message)
       }
     }
     break;
-  case GUI_MSG_SEARCH:
-    OnSearch();
-    break;
+    case GUI_MSG_NOTIFY_ALL:
+      if (message.GetParam1() == GUI_MSG_UPDATE_ITEM && message.GetItem())
+      {
+        const auto newItem{std::static_pointer_cast<CFileItem>(message.GetItem())};
+        // the item that CFileItemList::UpdateItem() updates
+        const auto it{std::ranges::find_if(*m_vecItems, [&newItem](const auto& item)
+                                           { return item->IsSamePath(newItem.get()); })};
+        const std::shared_ptr<CFileItem> listItem{it != m_vecItems->end() ? *it : nullptr};
+        const CBackgroundInfoLoader::CItemHold itemHold{m_thumbLoader, listItem.get()};
+        return CGUIMediaWindow::OnMessage(message);
+      }
+      break;
+    case GUI_MSG_SEARCH:
+      OnSearch();
+      break;
   }
   return CGUIMediaWindow::OnMessage(message);
 }
