 }
 
+/*!
+ * \brief Hades: the modes that the driver lists with a 3D layout, for kodi.log: "frame packing at
+ *        1920x1080@23.976, 1280x720@60.000; top-and-bottom at ...; side-by-side (half) at ...", or
+ *        empty where it lists none (nvidia-drm, which lists no 3D modes). A layout that is not
+ *        listed at the size of Kodi's mode is not used at it (Choose()): where a display declares
+ *        3D at 1080p only, side by side and top and bottom of a 2160p mode go out untold.
+ */
+inline std::string DeclaredLayouts(std::span<const Mode> modes)
+{
+  std::string text;
+  for (const Layout layout :
+       {Layout::FRAME_PACKING, Layout::TOP_AND_BOTTOM, Layout::SIDE_BY_SIDE_HALF})
+  {
+    std::vector<std::string> sizes;
+    for (const Mode& mode : modes)
+    {
+      if (LayoutOf(mode.flags) != layout)
+        continue;
+      char one[48];
+      std::snprintf(one, sizeof(one), "%ux%u%s@%.3f", static_cast<unsigned int>(mode.hdisplay),
+                    static_cast<unsigned int>(mode.vdisplay),
+                    (mode.flags & FLAG_INTERLACE) ? "i" : "", RefreshRate(mode));
+      if (std::ranges::find(sizes, one) == sizes.end())
+        sizes.emplace_back(one);
+    }
+    if (sizes.empty())
+      continue;
+    text += text.empty() ? "" : "; ";
+    text += LayoutName(layout);
+    text += " at ";
+    for (size_t i = 0; i < sizes.size(); ++i)
+      text += (i ? ", " : "") + sizes[i];
+  }
+  return text;
+}
+
 /*!
  * \brief What a driver is given to send as the HDMI vendor InfoFrame of a half layout
