+  // Hades: ... and at which sizes and rates the driver lists its 3D layouts (a layout that is not
+  // listed at the size of Kodi's mode is not used at it: STEREO::Choose())
+  if (stereoDisplay)
+  {
+    std::string declared;
+    {
+      std::unique_lock lock(m_infoLock);
+      declared = STEREO::DeclaredLayouts(m_stereoModes);
+    }
+    CLog::Log(LOGINFO, "3D output: {}",
+              declared.empty()
+                  ? std::string("the driver lists no mode with a 3D layout; the half layouts are "
+                                "told by the HDMI vendor InfoFrame where the EDID declares them")
+                  : "the driver lists the 3D layouts of the display: " + declared);
+  }
   // Hades: ... and where it does, on a DisplayPort output, what is behind it (DV_DUAL_MODE)
   if (const char* why = stereoDisplay ? StereoAdaptorReason() : nullptr)
     CLog::Log(LOGINFO, "3D output: no 3D mode on {}: {}", m_DRM->GetConnector()->GetName(), why);
