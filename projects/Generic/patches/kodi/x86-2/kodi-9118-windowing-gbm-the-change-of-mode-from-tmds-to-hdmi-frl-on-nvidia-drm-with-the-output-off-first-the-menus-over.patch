+void CWinSystemGbmGLESContext::SyncLogsToDisk(const char* why)
+{
+  const auto now = std::chrono::steady_clock::now();
+  if (m_logsSyncedAt != std::chrono::steady_clock::time_point{} &&
+      now - m_logsSyncedAt < std::chrono::seconds(5))
+    return;
+  m_logsSyncedAt = now;
+  // (the file that CLog::Initialize() opens: the application's name in lower case, in the log path)
+  std::string app = CCompileInfo::GetAppName();
+  StringUtils::ToLower(app);
+  const std::string file =
+      URIUtils::AddFileToFolder(CSpecialProtocol::TranslatePath("special://logpath"), app + ".log");
+  CLog::Log(LOGINFO,
+            "{} and the journal are written to disk now ({}), so that what follows is kept if the "
+            "PC has to be switched off",
+            file, why);
+  std::thread(
+      [file]()
+      {
+        const int fd = open(file.c_str(), O_RDONLY | O_CLOEXEC);
+        if (fd >= 0)
+        {
+          fsync(fd);
+          close(fd);
+        }
+        // journald writes what it has to the disk and syncs it (its kernel lines with it)
+        char journalctl[] = "journalctl";
+        char sync[] = "--sync";
+        char* argv[] = {journalctl, sync, nullptr};
+        pid_t pid = 0;
+        if (posix_spawnp(&pid, "journalctl", nullptr, nullptr, argv, environ) == 0)
+        {
+          int status = 0;
+          waitpid(pid, &status, 0);
+        }
+      })
+      .detach();
+}
