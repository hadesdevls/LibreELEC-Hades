+
+#pragma once
+
+#include "HotplugRelink.h"
+
+#include <chrono>
+#include <cmath>
+#include <cstdint>
+#include <optional>
+#include <vector>
+
+/*
+ * Hades: the change of mode from a TMDS mode to one over HDMI FRL on nvidia-drm, and what is done
+ * when the display engine does not come back from it.
+ *
+ * The RTX 4080 SUPER of the Hades tests hangs, about once in ten, at the change of mode from the TMDS
+ * mode of a video (3840x2160 at 23.976 Hz, 297 MHz) back to the 3840x2160 at 120 Hz of the menus,
+ * over FRL at 4 lanes of 8 Gb/s: 3 of 31 on 2026-11-12 (driver 620.70.06, 1.0), 1 of 7 on 2026-11-18
+ * (1.1). The kernel log of the last one (nvidia-open-kernel-modules-9072) says that the link trained
+ * at the first try in 180 ms, that the display says over SCDC that its four lanes are locked, and
+ * that the raster of the head stands at line 0 one second and three seconds after the update went
+ * out: the head does not start. Training the link again inside FRL flush mode did not bring it
+ * back; NVIDIA's driver then went on without the update ("Lost display notification"), no flip came,
+ * and the next changes of mode were refused (-22). VRR was off in that mode set, and only one head
+ * was lit.
+ *
+ * NVKMS shuts a head down in an update of its own before it sets a mode over FRL
+ * (KickoffProposedModeSetStateIncompatibleApiHeadsShutDown() of nvkms-modeset.c), trains the link
+ * (nvHdmiFrlSetConfig()) and then sends the update of the new mode in the same call. What fails is
+ * the start of the head in that update, in the part of the driver that NVIDIA keeps closed (RM's
+ * handling of the display engine's supervisor): nothing in the open code says why.
+ *
+ * Two things that Kodi can do:
+ * - OffFirst(): such a change of mode goes out in two commits, the output off (CRTC ACTIVE 0) and
+ *   then the new mode, so that NVKMS finishes the mode set that turns the head off, with the link
+ *   and the display left without a signal, before it sets up the head over FRL from an output that
+ *   is off: a mode set that NVKMS makes in a call of its own, with its own post-update steps, where
+ *   the change in one commit makes the two in one call, the update of the new mode right after the
+ *   link trained. Whether that avoids the hang is not known: it is measured on the card that hangs.
+ * - Fallback(): where the flips do not come back after a change of mode to FRL (two stalls of the
+ *   flip in a row, CFlipStallRecovery), the menus go to the TMDS mode of the same size with the
+ *   highest refresh rate that TMDS carries (PickTmdsMode(): 3840x2160 at 60 Hz, 594 MHz), once in
+ *   each failure and at most MAX_FALLBACKS times while Kodi runs; the resolution chosen by the user
+ *   stays what it is (the next video, and the next start, go back to it). Where that does not bring
+ *   the flips back either, the output is turned off and on again as before.
+ * Pure: a test builds it on the host (tools/regress/kodi-host/output/presfix/frl_mode_change_test.cpp).
+ */
+namespace KODI::WINDOWING::GBM::FRL_MODE_CHANGE
+{
+//! a stall of the flips this long after a change of mode to FRL is taken as its failure
+constexpr auto AFTER_MODESET = std::chrono::seconds(60);
+//! the times the menus go to a TMDS mode while Kodi runs
+constexpr unsigned int MAX_FALLBACKS = 3;
+//! the highest refresh rate of a mode that is taken as carried by TMDS where its pixel clock is not
+//! known (3840x2160 at 60 Hz is 594 MHz, under the 600 MHz of TMDS at 8 bits)
+constexpr float TMDS_MAX_REFRESH = 60.01f;
+
+/*!
+ * \brief Whether a change of mode goes out in two commits, the output off first: on nvidia-drm
+ *        (it says the link, NV_OUTPUT_LINK), from a lit output over TMDS to a mode whose pixel clock
+ *        TMDS does not carry at 8 bits in RGB (TMDS_MAX_KHZ: that mode goes over FRL; a mode that a
+ *        format of fewer bits would carry over TMDS is counted as FRL too, which costs at most one
+ *        commit more), and not for a move of Kodi to another output
+ */
+inline bool OffFirst(std::optional<uint64_t> linkBefore, int64_t clockKHz, bool active, bool moving)
+{
+  using HOTPLUG_RELINK::Link;
+  const Link link = HOTPLUG_RELINK::LinkOf(linkBefore);
+  return active && !moving && (link == Link::TMDS || link == Link::TMDS_SCRAMBLED) &&
+         clockKHz > HOTPLUG_RELINK::TMDS_MAX_KHZ;
+}
+
+//! A mode that the menus can be set in (a resolution of Kodi)
+struct Mode
+{
+  int width = 0;
+  int height = 0;
+  float refresh = 0.0f;
+  bool interlaced = false;
+  bool stereo = false;
+  int64_t clockKHz = 0; //!< 0: not known
+};
+
+/*!
+ * \brief The mode of the same size as current that TMDS carries (its pixel clock at most
+ *        TMDS_MAX_KHZ where known, else a refresh rate of at most TMDS_MAX_REFRESH), progressive and
+ *        not 3D, with the highest refresh rate; between two of the same rate (60 and 59.94 Hz), the
+ *        one of the same family as current (both whole, or both divided by 1.001). Nothing where
+ *        there is none.
+ */
+inline std::optional<size_t> PickTmdsMode(const std::vector<Mode>& modes, const Mode& current)
+{
+  const auto fractional = [](float hz)
+  { return std::fabs(hz - std::round(hz)) > 0.005f; };
+  // (59.94 and 60 Hz are both of 60 Hz: a whole rate, or one divided by 1.001)
+  const auto nominal = [&fractional](float hz)
+  { return std::lround(fractional(hz) ? hz * 1.001f : hz); };
+  std::optional<size_t> best;
+  for (size_t i = 0; i < modes.size(); ++i)
+  {
+    const Mode& m = modes[i];
+    if (m.width != current.width || m.height != current.height || m.interlaced || m.stereo ||
+        !(m.refresh > 0.0f))
+      continue;
+    const bool tmds = m.clockKHz > 0 ? m.clockKHz <= HOTPLUG_RELINK::TMDS_MAX_KHZ
+                                     : m.refresh <= TMDS_MAX_REFRESH;
+    if (!tmds)
+      continue;
+    if (!best)
+    {
+      best = i;
+      continue;
+    }
+    const Mode& b = modes[*best];
+    if (nominal(m.refresh) > nominal(b.refresh))
+      best = i;
+    else if (nominal(m.refresh) == nominal(b.refresh) &&
+             fractional(m.refresh) == fractional(current.refresh) &&
+             fractional(b.refresh) != fractional(current.refresh))
+      best = i;
+  }
+  return best;
+}
+
+enum class Action
+{
+  SAME_MODE, //!< the output off and on again in the mode it has (CFlipStallRecovery, as before)
+  TMDS_MODE, //!< the menus to the TMDS mode of PickTmdsMode()
+};
+
+/*!
+ * \brief What the recovery of a stall of the flips does (CWinSystemGbmGLESContext::FlipStalled(),
+ *        where CFlipStallRecovery says to act): TMDS_MODE where the output goes over FRL, its last
+ *        change of mode was at most AFTER_MODESET ago, a TMDS mode was found, this failure has not
+ *        gone to one already and fewer than MAX_FALLBACKS have since Kodi started; else SAME_MODE
+ */
+inline Action Fallback(bool overFrl,
+                       std::optional<std::chrono::steady_clock::duration> sinceModeset,
+                       bool tmdsModeFound,
+                       bool fellBackInThisFailure,
+                       unsigned int fallbacks)
+{
+  if (overFrl && sinceModeset && *sinceModeset <= AFTER_MODESET && tmdsModeFound &&
+      !fellBackInThisFailure && fallbacks < MAX_FALLBACKS)
+    return Action::TMDS_MODE;
+  return Action::SAME_MODE;
+}
+
+} // namespace KODI::WINDOWING::GBM::FRL_MODE_CHANGE
