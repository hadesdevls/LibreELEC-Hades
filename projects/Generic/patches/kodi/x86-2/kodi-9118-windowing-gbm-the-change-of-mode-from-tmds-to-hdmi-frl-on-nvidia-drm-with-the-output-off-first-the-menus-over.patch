+void CDRMAtomic::CommitOutputOffFirst(std::optional<uint64_t> linkBefore)
+{
+  const double hz = (m_mode && m_mode->htotal && m_mode->vtotal)
+                        ? m_mode->clock * 1000.0 /
+                              (static_cast<double>(m_mode->htotal) * m_mode->vtotal)
+                        : 0.0;
+  const std::string name = m_connector ? m_connector->GetName() : "none";
+  CDRMAtomicRequest off;
+  if (!m_crtc || !off.AddProperty(m_crtc, "ACTIVE", 0))
+  {
+    CLog::Log(LOGWARNING,
+              "Change of mode on {} to {}x{} @ {:.3f} Hz over HDMI FRL: the output could not be "
+              "asked to go off first; the change of mode goes out in one commit",
+              name, m_mode ? m_mode->hdisplay : 0, m_mode ? m_mode->vdisplay : 0, hz);
+    return;
+  }
+  const auto start = std::chrono::steady_clock::now();
+  const int ret = drmModeAtomicCommit(m_fd, off.Get(), DRM_MODE_ATOMIC_ALLOW_MODESET, nullptr);
+  const int error = errno;
+  const double ms =
+      std::chrono::duration<double, std::milli>(std::chrono::steady_clock::now() - start).count();
+  if (ret != 0)
+  {
+    CLog::Log(LOGWARNING,
+              "Change of mode on {} to {}x{} @ {:.3f} Hz over HDMI FRL: the driver refused to turn "
+              "the output off first ({}, {:.0f} ms); the change of mode goes out in one commit, as "
+              "before",
+              name, m_mode ? m_mode->hdisplay : 0, m_mode ? m_mode->vdisplay : 0, hz,
+              strerror(error), ms);
+    return;
+  }
+  off.CacheProperties();
+  CLog::Log(LOGINFO,
+            "Change of mode on {} from {} to {}x{} @ {:.3f} Hz, which goes over HDMI FRL: the "
+            "output turned off first, in a commit of its own that took {:.0f} ms; the new mode "
+            "goes out in the next one (the head starts over FRL from an output that is off: "
+            "FrlModeChange.h)",
+            name, CModesetReport::LinkText(linkBefore), m_mode ? m_mode->hdisplay : 0,
+            m_mode ? m_mode->vdisplay : 0, hz, ms);
+}
