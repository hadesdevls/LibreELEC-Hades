+  if (reset && FallBackToTmdsMode(now))
+    return true;
   if (reset)
   {
     // The output off first: that commit waits, and the flips that have not come are completed
@@ -1418,6 +1438,133 @@ bool CWinSystemGbmGLESContext::FlipStalled()
   return true;
 }
 
+bool CWinSystemGbmGLESContext::FallBackToTmdsMode(std::chrono::steady_clock::time_point now)
+{
+  namespace FRL = KODI::WINDOWING::GBM::FRL_MODE_CHANGE;
+  const auto drm = std::dynamic_pointer_cast<CDRMAtomic>(m_DRM);
+  CDRMConnector* connector = drm ? drm->GetConnector() : nullptr;
+  // (only nvidia-drm says the link: NV_OUTPUT_LINK)
+  if (!connector || !connector->SupportsProperty("NV_OUTPUT_LINK"))
+    return false;
+  const bool overFrl = HOTPLUG_RELINK::LinkOf(connector->ReadPropertyValue("NV_OUTPUT_LINK")) ==
+                       HOTPLUG_RELINK::Link::FRL;
+  auto& gfx = GetGfxContext();
+  const RESOLUTION_INFO current = gfx.GetResInfo(gfx.GetVideoResolution());
+  const auto modeOf = [](const RESOLUTION_INFO& info)
+  {
+    FRL::Mode mode;
+    mode.width = info.iScreenWidth;
+    mode.height = info.iScreenHeight;
+    mode.refresh = info.fRefreshRate;
+    mode.interlaced = (info.dwFlags & D3DPRESENTFLAG_INTERLACED) != 0;
+    mode.stereo = (info.dwFlags & (D3DPRESENTFLAG_MODE3DSBS | D3DPRESENTFLAG_MODE3DTB)) != 0;
+    return mode;
+  };
+  // (the clock of the mode of each resolution: its strId is the place of its mode among the
+  // connector's, CDRMUtils::GetConnectorModes())
+  const std::vector<drmModeModeInfo> connectorModes = drm->GetConnectorModes();
+  CDisplaySettings& display = CDisplaySettings::GetInstance();
+  std::vector<FRL::Mode> modes;
+  std::vector<RESOLUTION> ids;
+  for (int i = RES_CUSTOM; i < static_cast<int>(display.ResolutionInfoSize()); ++i)
+  {
+    const RESOLUTION_INFO& info = display.GetResolutionInfo(i);
+    FRL::Mode mode = modeOf(info);
+    char* end = nullptr;
+    const long place = std::strtol(info.strId.c_str(), &end, 10);
+    if (!info.strId.empty() && end && *end == '\0' && place >= 0 &&
+        place < static_cast<long>(connectorModes.size()))
+      mode.clockKHz = connectorModes[static_cast<size_t>(place)].clock;
+    modes.push_back(mode);
+    ids.push_back(static_cast<RESOLUTION>(i));
+  }
+  const auto pick = FRL::PickTmdsMode(modes, modeOf(current));
+  // (the last change of mode that the driver took, whichever way it went out: the end of native
+  // Dolby Vision, the one that hung on 2026-11-18, goes out from SetFullScreen(), not FlipPage())
+  const auto lastModeset = drm->LastModesetAt();
+  const auto since = lastModeset
+                         ? std::optional<std::chrono::steady_clock::duration>(now - *lastModeset)
+                         : std::nullopt;
+  if (FRL::Fallback(overFrl, since, pick.has_value(), m_frlFellBackHere, m_frlFallbacks) !=
+      FRL::Action::TMDS_MODE)
+  {
+    if (overFrl)
+      CLog::Log(LOGINFO,
+                "The flips stall over HDMI FRL: the output is turned off and on again in its mode "
+                "({}; the menus go to a TMDS mode only within {} s of a change of mode, once in "
+                "each failure and {} times while Kodi runs, where one of the same size is there: "
+                "{} s since the last change of mode, {}, {} times so far)",
+                current.strMode,
+                std::chrono::duration_cast<std::chrono::seconds>(FRL::AFTER_MODESET).count(),
+                FRL::MAX_FALLBACKS,
+                since ? std::chrono::duration_cast<std::chrono::seconds>(*since).count() : -1,
+                pick ? "one found" : "none found", m_frlFallbacks);
+    return false;
+  }
+  m_frlFellBackHere = true;
+  ++m_frlFallbacks;
+  const RESOLUTION to = ids[*pick];
+  const RESOLUTION_INFO& toInfo = display.GetResolutionInfo(to);
+  const auto text = [](const RESOLUTION_INFO& info)
+  { return StringUtils::Format("{}x{} @ {:.2f} Hz", info.iScreenWidth, info.iScreenHeight,
+                               info.fRefreshRate); };
+  CLog::Log(LOGWARNING,
+            "The flips have not come back since the change of mode to {} over HDMI FRL {} s ago: "
+            "the menus go to {}, which goes over TMDS, so that the picture comes back ({} of at "
+            "most {} times while Kodi runs). The resolution chosen in Settings stays {}: the next "
+            "video, and the next start, go back to it (FrlModeChange.h)",
+            text(current), since ? std::chrono::duration_cast<std::chrono::seconds>(*since).count() : 0,
+            text(toInfo), m_frlFallbacks, FRL::MAX_FALLBACKS, text(current));
+  SyncLogsToDisk("the menus go to a TMDS mode");
+  CServiceBroker::GetAppMessenger()->PostMsg(TMSG_SETVIDEORESOLUTION, static_cast<int>(to), 1);
+  std::string notice = CGUIUtils::GetHadesString(62300, 54305);
+  StringUtils::Replace(notice, "{0}", text(current));
+  StringUtils::Replace(notice, "{1}", text(toInfo));
+  CGUIDialogKaiToast::QueueNotification(
+      CGUIDialogKaiToast::Warning,
+      CServiceBroker::GetResourcesComponent().GetLocalizeStrings().Get(14220), notice, 10000);
+  return true;
+}
