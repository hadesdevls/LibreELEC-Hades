From 6ea9a8a2dd718c75474365e7cc2ec48535c325bc Mon Sep 17 00:00:00 2001
From: Hades <15710513+hadesdevls@users.noreply.github.com>
Date: Tue, 24 Nov 2026 18:00:27 +0000
Subject: [PATCH] [Hades][dvbridge] The form of the metadata, to compare with
 what licensed players send

What a licensed core sends was read on the user's Amlogic player with Dolby's
own core (IDK 2.6, TV-led, five films). It differs from what Hades sends in
places whose effect only a display shows, so each difference becomes a choice
of the serializer (dvbridge_set_form(), kept through a reset like the trims),
and Hades' own form stays the serializer's default:

- the level 5 block: Hades' own (the RPU's area where the picture is placed,
  edges taken in for what is drawn over the bars, a block of the place where
  the player puts bars around the picture); the same without that made block
  where the RPU has none (what the TV's own player and the patched OPPO send);
  the RPU's block as it is (what CoreELEC sends); or none, which is what the
  licensed core sent for an active area of zeros and for real bars alike. The
  blanking margins of the transport are the same with each. fandangos measured
  on an LG C1 and a Hisense that a TV without a level 5 block leaves a positive
  lift of the level 2 trims aside and applies it with one;
- the blocks in the order of their level (1, 2, 3, 4, 5, 8, 9, 10, 11, 254), as
  the licensed core sent them, in place of the RPU's order (v2.9, then v4.0).
  ETSI GS CCM 001 6.2.2 orders levels 1, 2 and 5 only, which both keep;
- level 254 with its dm_version_index 0, where the RPUs and dovi_tool's CM
  v4.0.2 default have 2 (the licensed core sent 0000 for 0002);
- a neutral level 3 (2048, 2048, 2048) added to an RPU of content mapping v2.9
  for a display that reads v4.0, as the licensed core did for every CM v2.9
  film and for no CM v4.0 one.

Level 4 is left as the RPU has it: the licensed core computes the one it sends
by a rule that is not understood (sometimes the RPU's, sometimes its second
field 0 or 019c, once both fields changed); the cases are written down where
level 4 is written. The renderer takes the form (dvbridge_render_set_form()),
CDVBridgeGLES::SetMetadataForm() gives it, and kodi.log says, with the first
picture of each stream, the levels of the blocks sent in their order and the
form where it is not Hades' own. The player information reads back a payload
without a level 5 block as such.
---
 tools/dvbridge/dvbridge_core.c                |  24 ++-
 tools/dvbridge/dvbridge_core.h                |  27 ++-
 tools/dvbridge/dvbridge_metadata.h            | 156 +++++++++++++++++-
 tools/dvbridge/dvbridge_render.c              |   6 +
 tools/dvbridge/dvbridge_render.h              |   3 +
 .../VideoRenderers/DVBridgeGLES.cpp           |  41 +++++
 .../VideoPlayer/VideoRenderers/DVBridgeGLES.h |   7 +
 7 files changed, 260 insertions(+), 4 deletions(-)

diff --git a/tools/dvbridge/dvbridge_core.c b/tools/dvbridge/dvbridge_core.c
index 11da4b7..d183d8d 100644
--- a/tools/dvbridge/dvbridge_core.c
+++ b/tools/dvbridge/dvbridge_core.c
@@ -94,6 +94,23 @@ void dvbridge_set_cm40(struct dvbridge_context *context, int mode, unsigned disp
     context->cm29_forced = mode == DVBRIDGE_CM40_V29_ONLY;
 }
 
+/* (Hades: the values of dvbridge_core.h are those of dvbridge_metadata.h) */
+_Static_assert(DVBRIDGE_L5_PLACED == DVBRIDGE_DV_L5_PLACED && DVBRIDGE_L5_AS_GIVEN == DVBRIDGE_DV_L5_AS_GIVEN &&
+                   DVBRIDGE_L5_NONE == DVBRIDGE_DV_L5_NONE && DVBRIDGE_L5_UNMADE == DVBRIDGE_DV_L5_UNMADE,
+               "the forms of the level 5 block");
+
+void dvbridge_set_form(struct dvbridge_context *context, int l5, unsigned form)
+{
+    if (!context)
+        return;
+    context->state.l5_form = l5 == DVBRIDGE_L5_AS_GIVEN || l5 == DVBRIDGE_L5_NONE || l5 == DVBRIDGE_L5_UNMADE
+                                 ? (unsigned)l5
+                                 : DVBRIDGE_DV_L5_PLACED;
+    context->state.level_order = (form & DVBRIDGE_FORM_LEVEL_ORDER) != 0;
+    context->state.l254_zero = (form & DVBRIDGE_FORM_L254_ZERO) != 0;
+    context->state.l3_neutral = (form & DVBRIDGE_FORM_L3_NEUTRAL) != 0;
+}
+
 void dvbridge_set_cm40_video(struct dvbridge_context *context, unsigned video, bool menus,
                              const struct dvbridge_cm40_decision *known)
 {
@@ -286,6 +303,11 @@ bool dvbridge_candidate_reading(const struct dvbridge_candidate *candidate,
     reading->cm40_level = candidate->state.cm40_level;
     reading->cm40_length = candidate->state.cm40_length;
     reading->cm40_added = r->cm40_added;
+    reading->l5_left_out = r->l5_left_out;
+    reading->l5_as_given = r->l5_as_given;
+    reading->level_order = r->level_order;
+    reading->l3_added = r->l3_added;
+    reading->l254_zeroed = r->l254_zeroed;
     reading->cm40_auto = candidate->state.cm40_auto && candidate->state.cm40_auto_on;
     reading->cm40_auto_source = candidate->state.cm40_auto_source;
     reading->cm40_auto_revoked = candidate->state.cm40_auto_revoked;
@@ -329,7 +351,7 @@ int dvbridge_sent_blocks(const struct dvbridge_candidate *candidate, uint8_t *le
             levels[i] = level;
         pos += length;
     }
-    if (pos != d->size || (!area && !d->reading.l5_none))
+    if (pos != d->size || (!area && !d->reading.l5_none && !d->reading.l5_left_out))
         return -1;
     if (!area)
         for (unsigned j = 0; j < 4; ++j)
diff --git a/tools/dvbridge/dvbridge_core.h b/tools/dvbridge/dvbridge_core.h
index 8d27768..0f4775c 100644
--- a/tools/dvbridge/dvbridge_core.h
+++ b/tools/dvbridge/dvbridge_core.h
@@ -141,6 +141,24 @@ static inline unsigned dvbridge_cm40_video_of(unsigned picture, unsigned now)
 /* Hades: the decision of the context (of its last committed frame); false where none is made */
 bool dvbridge_get_cm40_decision(const struct dvbridge_context *context, struct dvbridge_cm40_decision *decision);
 void dvbridge_set_cm40(struct dvbridge_context *context, int mode, unsigned display_peak_pq);
+/* Hades: the form of the metadata sent, to compare on a display with what a licensed player sends (dvbridge_dv::l5_form
+ * and the three after it in dvbridge_metadata.h). l5: the level 5 block, Hades' own (DVBRIDGE_L5_PLACED, the default:
+ * the RPU's active area where the picture is placed, edges taken out for what is drawn over the bars, a block of the
+ * place where the player adds bars), the same without that made block (DVBRIDGE_L5_UNMADE: none where the RPU has
+ * none, as the TV's own player), the RPU's as it is (DVBRIDGE_L5_AS_GIVEN), or none (DVBRIDGE_L5_NONE, as a
+ * licensed core sends in TV-led). form: DVBRIDGE_FORM_LEVEL_ORDER, the blocks in the order of their level;
+ * DVBRIDGE_FORM_L254_ZERO, level 254 with its dm_version_index 0; DVBRIDGE_FORM_L3_NEUTRAL, a level 3 block of no
+ * offsets added to an RPU of content mapping v2.9 for a display that reads v4.0. 0 and 0: as Hades sends them. Set and
+ * kept as dvbridge_set_trims(). */
+#define DVBRIDGE_FORM 1
+#define DVBRIDGE_L5_PLACED 0
+#define DVBRIDGE_L5_AS_GIVEN 1
+#define DVBRIDGE_L5_NONE 2
+#define DVBRIDGE_L5_UNMADE 3
+#define DVBRIDGE_FORM_LEVEL_ORDER 1u
+#define DVBRIDGE_FORM_L254_ZERO 2u
+#define DVBRIDGE_FORM_L3_NEUTRAL 4u
+void dvbridge_set_form(struct dvbridge_context *context, int l5, unsigned form);
 
 /* No state advances until presentation succeeds and commit is called. */
 struct dvbridge_candidate *dvbridge_prepare(
@@ -182,8 +200,8 @@ bool dvbridge_active_area(const struct dvbridge_candidate *candidate, unsigned m
  * block, the active area as left, right, top and bottom offsets on the 3840x2160 raster. Returns
  * how many blocks there are, or -1 when the payload does not read back as it is written.
  * Hades: a payload has at most one level 5 block: none where the metadata have none and the
- * picture fills the raster (dvbridge_dv_made_area() in dvbridge_metadata.h); its four values are
- * then DVBRIDGE_SENT_NO_L5. */
+ * picture fills the raster (dvbridge_dv_made_area() in dvbridge_metadata.h), or where the form of the
+ * metadata sends none (dvbridge_set_form()); its four values are then DVBRIDGE_SENT_NO_L5. */
 #define DVBRIDGE_SENT_NO_L5 0xFFFFFFFFu
 int dvbridge_sent_blocks(const struct dvbridge_candidate *candidate, uint8_t *levels,
                          unsigned max, unsigned l5[4]);
@@ -228,6 +246,11 @@ struct dvbridge_reading {
     unsigned cm40_level, cm40_length;
     /* Hades: blocks of the default v4.0 part added to this frame (dvbridge_set_cm40_default()) */
     unsigned cm40_added;
+    /* Hades: the form of the metadata (dvbridge_set_form()): no level 5 block sent where the frame had one or its place
+     * made one; the RPU's level 5 block sent as it is; the blocks in the order of their level; level 254 blocks sent
+     * with dm_version_index 0; a level 3 block of no offsets added */
+    bool l5_left_out, l5_as_given, level_order, l3_added;
+    unsigned l254_zeroed;
     unsigned packets;     /* transport packets of the payload */
     bool scene_refresh;   /* the frame refreshes the scene */
     unsigned metadata_id;
diff --git a/tools/dvbridge/dvbridge_metadata.h b/tools/dvbridge/dvbridge_metadata.h
index 858cda2..53028b9 100644
--- a/tools/dvbridge/dvbridge_metadata.h
+++ b/tools/dvbridge/dvbridge_metadata.h
@@ -55,6 +55,12 @@ struct dvbridge_dv_reading {
     unsigned cm40_dropped;
     /* Hades: blocks of the default v4.0 part added to this frame (dvbridge_dv::cm40_default) */
     unsigned cm40_added;
+    /* Hades: the form of the metadata sent where it is not Hades' own (dvbridge_dv::l5_form and the three after it):
+     * no level 5 block was sent although the frame had one or its place made one (l5_left_out); the RPU's level 5
+     * block was sent as the RPU has it (l5_as_given); the blocks went in the order of their level (level_order); level
+     * 254 blocks whose dm_version_index went as 0 (l254_zeroed); a level 3 block of no offsets was added (l3_added) */
+    bool l5_left_out, l5_as_given, level_order, l3_added;
+    unsigned l254_zeroed;
 };
 
 /* The state of the serializer of one output: the payload of 6.2 and the packets of 6.3 made from it. */
@@ -184,7 +190,43 @@ struct dvbridge_dv {
      * the video, for every value of its offsets, and kept through dvbridge_dv_restart(). */
     bool l5_picture;
     unsigned l5_picture_video;
+    /* Hades: the form of the metadata, to compare on a display with what a licensed player sends (dvbridge_set_form();
+     * what a licensed core sends was read on an Amlogic player with Dolby's own core, IDK 2.6, in TV-led output, five
+     * films, read on 2026-11-24). All 0, the default of the serializer: as Hades sends them. Kept
+     * through dvbridge_dv_restart(): they are the user's choice, not the stream's.
+     *  - l5_form, the level 5 block (the active area). DVBRIDGE_DV_L5_PLACED, Hades' own: the RPU's offsets on the
+     *    3840x2160 raster where the picture is placed (dvbridge_dv_l5()), each edge taken out while something is drawn
+     *    over the bars beyond it (cover), and a block of the place where the RPU has none and the player puts bars
+     *    around the picture (dvbridge_dv_made_area()). DVBRIDGE_DV_L5_AS_GIVEN: the RPU's block with its four offsets
+     *    as the RPU has them, nothing taken out for what is drawn over the bars, and none where the RPU has none (what
+     *    CoreELEC sends). DVBRIDGE_DV_L5_NONE: no level 5 block at all, what the licensed core sent in TV-led for an
+     *    RPU with an active area of zeros and for one with real bars alike (and the licensed driver of an OPPO
+     *    UDP-203 as fandangos read and measured it: oppo-dv-mkv, fix 24). DVBRIDGE_DV_L5_UNMADE: Hades' own, but no
+     *    block where the RPU has none, also where the player puts bars around the picture (a 3840x1600 encode): what
+     *    the TV's own player and the patched OPPO send for such an RPU; fandangos measured on an LG C1 and a Hisense
+     *    that without a level 5 block a TV leaves a positive lift of the level 2 trims aside, and with one applies it
+     *    inside the area (CroqueMr/libreelec-CB1#212). The blanking margins of the transport, what the renderer
+     *    paints black, are the same with the four.
+     *  - level_order: the blocks in the order of their level (1, 2, 3, 4, 5, 8, 9, 10, 11, 254, those of one level
+     *    in the RPU's order), as the licensed core sent them, in place of the order of an RPU (the v2.9 part, then the
+     *    v4.0 part). ETSI GS CCM 001 V1.1.1 6.2.2 orders levels 1, 2 and 5 only (a level 5 block after at least one
+     *    of level 1 or 2, and none of those after the last level 5 block), which both orders keep; the other levels
+     *    are reserved there, and a display ignores them wherever they are.
+     *  - l254_zero: the dm_version_index of a level 254 block (its second byte) sent as 0. The RPUs and dovi_tool's
+     *    default of content mapping v4.0.2 (level254.rs, cmv402_default(): dm_mode 0, dm_version_index 2) have 2; the
+     *    licensed core sent 0 in place of 2. What a display reads in it has no public definition.
+     *  - l3_neutral: a level 3 block of no offsets (2048, 2048, 2048: SMPTE ST 2094-10 offsets of 0) added to the
+     *    metadata of an RPU without a content mapping v4.0 part, for a display that reads that part (not cm29_only),
+     *    as the licensed core added one to each film of content mapping v2.9 (four of four) for a display of display
+     *    management 4, and none to a film of v4.0. Not where the v4.0 part is left out for the stream
+     *    (cm40_dropped), nor where the default v4.0 part is added (cm40_default: it has a level 3 block of its own). */
+    unsigned l5_form;
+    bool level_order, l254_zero, l3_neutral;
 };
+#define DVBRIDGE_DV_L5_PLACED 0
+#define DVBRIDGE_DV_L5_AS_GIVEN 1
+#define DVBRIDGE_DV_L5_NONE 2
+#define DVBRIDGE_DV_L5_UNMADE 3
 /* Hades: how long an edge of the active area sent stays taken out after the last frame that had
  * something drawn over the bars beyond it: 2 s of the video. The lines of subtitles in a bar, and an
  * OSD that is shown again, come and go within it: the area sent changes once when they come and once
@@ -532,7 +574,14 @@ static inline void dvbridge_dv_restart(struct dvbridge_dv *d)
     /* (Hades: and the reading of the offsets measured for a video: dvbridge_dv_l5_of_picture()) */
     const bool l5_picture = d->l5_picture;
     const unsigned l5_picture_video = d->l5_picture_video;
+    /* (Hades: and the form of the metadata, which is the user's) */
+    const unsigned l5_form = d->l5_form;
+    const bool level_order = d->level_order, l254_zero = d->l254_zero, l3_neutral = d->l3_neutral;
     memset(d, 0, sizeof(*d));
+    d->l5_form = l5_form;
+    d->level_order = level_order;
+    d->l254_zero = l254_zero;
+    d->l3_neutral = l3_neutral;
     d->l5_picture = l5_picture;
     d->l5_picture_video = l5_picture_video;
     d->l5_ignored = l5_ignored;
@@ -619,6 +668,12 @@ static inline bool dvbridge_dv_made_area(struct dvbridge_dv *d, unsigned taken,
         d->reading.l5_none = true;
         return true;
     }
+    /* Hades: a block of the place is Hades' own (l5_form): the RPU has none to send as it is, none is made, or none
+     * is sent */
+    if (d->l5_form != DVBRIDGE_DV_L5_PLACED) {
+        d->reading.l5_left_out = true;
+        return true;
+    }
     for (int j = 0; j < 4; j++)
         if (taken >> j & 1) v[j] = 0; /* Hades: taken out to what is drawn over the bars */
     DV_REFUSE(d->size + 13 <= DVBRIDGE_DV_MAX_PAYLOAD,
@@ -632,6 +687,53 @@ static inline bool dvbridge_dv_made_area(struct dvbridge_dv *d, unsigned taken,
     d->payload[count_pos]++; /* num_ext_blocks */
     return true;
 }
+/* Hades: the converted payload of a level 254 block (wire, size bytes: dm_mode, dm_version_index) in the form asked
+ * for (l254_zero): its dm_version_index 0. Returns whether it was changed. */
+static inline bool dvbridge_dv_l254_form(const struct dvbridge_dv *d, uint8_t *wire, int size)
+{
+    if (!d->l254_zero || size != 2 || !wire[1])
+        return false;
+    wire[1] = 0;
+    return true;
+}
+/* Hades: the extension blocks of the payload, whose count is at count_pos and which follow it to its end, put in the
+ * order of their level, the blocks of one level in the order they were written (level_order). False where the blocks
+ * do not read back as dvbridge_dv_metadata() writes them (not reached), the payload then as it was. */
+static inline bool dvbridge_dv_order_by_level(struct dvbridge_dv *d, unsigned count_pos)
+{
+    const unsigned count = d->payload[count_pos];
+    unsigned at[64], length[64], pos = count_pos + 1;
+    if (count > 64 || d->size > DVBRIDGE_DV_MAX_PAYLOAD)
+        return false;
+    for (unsigned i = 0; i < count; i++) {
+        if (d->size < pos || d->size - pos < 5)
+            return false;
+        const uint32_t n = (uint32_t)d->payload[pos] << 24 | (uint32_t)d->payload[pos + 1] << 16 |
+                           (uint32_t)d->payload[pos + 2] << 8 | d->payload[pos + 3];
+        if (n > d->size - pos - 5)
+            return false;
+        /* a stable insertion by level: after every block already placed whose level is not greater */
+        unsigned k = i;
+        for (; k > 0 && d->payload[at[k - 1] + 4] > d->payload[pos + 4]; k--) {
+            at[k] = at[k - 1];
+            length[k] = length[k - 1];
+        }
+        at[k] = pos;
+        length[k] = 5 + n;
+        pos += 5 + n;
+    }
+    if (pos != d->size)
+        return false;
+    uint8_t blocks[DVBRIDGE_DV_MAX_PAYLOAD];
+    unsigned to = 0;
+    for (unsigned i = 0; i < count; i++) {
+        memcpy(blocks + to, d->payload + at[i], length[i]);
+        to += length[i];
+    }
+    memcpy(d->payload + count_pos + 1, blocks, to);
+    d->reading.level_order = true;
+    return true;
+}
 /* The payload of 6.2 and its packets of 6.3 for the frame being rendered: the metadata are that
  * frame's (not the decoder's newest), and a repeated presentation time (a pause) keeps the same payload.
  * A discontinuity forces scene refresh; no stale RPU across a seek.
@@ -712,6 +814,8 @@ static inline bool dvbridge_dv_metadata(struct dvbridge_dv *d, const AVDOVIMetad
     d->reading.l5_ignored = NULL;
     d->reading.l5_none = false;
     d->reading.cm40_left_out = d->reading.cm40_dropped = d->reading.cm40_added = 0;
+    d->reading.l5_left_out = d->reading.l5_as_given = d->reading.level_order = d->reading.l3_added = false;
+    d->reading.l254_zeroed = 0;
     /* 6.2.1 table 3: dm_metadata() */
     d->size = 0;
     d->payload[d->size++] = 0; /* reserved_0x00_8bits */
@@ -860,9 +964,33 @@ static inline bool dvbridge_dv_metadata(struct dvbridge_dv *d, const AVDOVIMetad
             memcpy(d->margins, v, sizeof(d->margins));
             for (int j = 0; j < 4; j++)
                 if (taken >> j & 1) v[j] = 0; /* Hades: taken out to what is drawn over the bars */
+            /* Hades: the form of the level 5 block (l5_form): none, or the RPU's as it is (the margins stay those
+             * above) */
+            if (d->l5_form == DVBRIDGE_DV_L5_NONE) {
+                d->reading.l5_left_out = true;
+                continue;
+            }
+            if (d->l5_form == DVBRIDGE_DV_L5_AS_GIVEN) {
+                v[0] = e->l5.left_offset;
+                v[1] = e->l5.right_offset;
+                v[2] = e->l5.top_offset;
+                v[3] = e->l5.bottom_offset;
+                d->reading.l5_as_given = true;
+            }
             break;
         /* level 4 (content mapping v2.9) and levels 3, 8 to 11 and 254 (v4.0): their bytes in the
-         * RPU, converted for the tunnel by dvbridge_cm4_wire() */
+         * RPU, converted for the tunnel by dvbridge_cm4_wire()
+         * Hades: level 4 goes as the RPU has it, and stays so. A licensed core (Dolby's IDK 2.6 on an Amlogic
+         * player, read on 2026-11-24) computes the level 4 block it sends rather than copying
+         * it, by a rule that is not understood: the RPU's two fields (anchor_pq, anchor_power) were sent as they are
+         * in a profile 5 title and in Top Gun: Maverick (seven places); the second sent as 0 in a profile 7 film
+         * (0430 01cc -> 0430 0000); the first changed and the second 0 in Blade Runner 2049, profile 8.1, whose RPU
+         * changes level 4 in every frame and whose sent block held one value across shots (066e 0132 -> 0608 0000,
+         * 01b0..01c4 -> 0108 0000, 03e4 0256 -> 0308 0000, 02fb 027b -> 0208 0000); and the second always 019c in
+         * John Wick 4 and Dune: Part Two whatever the RPU had (0214 020f -> 0214 019c, 052201b4 -> 0522 019c,
+         * 020b 014d -> 020b 019c, and 0040, 019e, 0055, 010c, 01f2). Level 4 serves the global dimming of displays
+         * with a backlight; what it changes on an OLED is not known. Nothing here imitates a rule that is not
+         * known. */
         case 4: case 3: case 8: case 9: case 10: case 11: case 254: {
             /* Hades: the v4.0 part, for a display that does not read it (level 4 is of v2.9) */
             const bool v40 = e->level != 4;
@@ -912,6 +1040,9 @@ static inline bool dvbridge_dv_metadata(struct dvbridge_dv *d, const AVDOVIMetad
                 d->cm40_length = e->dvbridge_original_length;
                 continue;
             }
+            /* Hades: level 254 with its dm_version_index 0 (l254_zero) */
+            if (e->level == 254 && dvbridge_dv_l254_form(d, wire, size))
+                d->reading.l254_zeroed++;
             dvbridge_dv_u32(d, (unsigned)size); /* ext_block_length (6.2.1 table 4) */
             d->payload[d->size++] = e->level;   /* ext_block_level */
             memcpy(d->payload + d->size, wire, (size_t)size);
@@ -974,6 +1105,8 @@ static inline bool dvbridge_dv_metadata(struct dvbridge_dv *d, const AVDOVIMetad
             const int n = dvbridge_cm4_wire(defaults[k].level, defaults[k].raw, defaults[k].length, wire);
             fits = n >= 0 && d->size + 5 + (unsigned)n <= DVBRIDGE_DV_MAX_PAYLOAD &&
                    d->payload[count_pos] + 1u <= AV_DOVI_MAX_EXT_BLOCKS;
+            if (fits && defaults[k].level == 254 && dvbridge_dv_l254_form(d, wire, n))
+                d->reading.l254_zeroed++;
             if (fits) {
                 dvbridge_dv_u32(d, (uint32_t)n);
                 d->payload[d->size++] = defaults[k].level;
@@ -987,8 +1120,29 @@ static inline bool dvbridge_dv_metadata(struct dvbridge_dv *d, const AVDOVIMetad
         } else {
             d->size = size0;
             d->payload[count_pos] = count0;
+            d->reading.l254_zeroed = 0;
+        }
+    }
+    /* Hades: a level 3 block of no offsets for an RPU of content mapping v2.9 (l3_neutral), after its blocks as
+     * level 3 is in an RPU (the order of the levels, where asked, comes after) */
+    if (d->l3_neutral && !rpu_v40 && !d->cm29_only && !d->cm40_dropped && !d->reading.cm40_added) {
+        static const uint8_t neutral[5] = {0x80, 0x08, 0x00, 0x80, 0x00}; /* 2048, 2048, 2048 */
+        uint8_t wire[32];
+        const int n = dvbridge_cm4_wire(3, neutral, sizeof(neutral), wire);
+        if (n == 6 && d->size + 5 + (unsigned)n <= DVBRIDGE_DV_MAX_PAYLOAD &&
