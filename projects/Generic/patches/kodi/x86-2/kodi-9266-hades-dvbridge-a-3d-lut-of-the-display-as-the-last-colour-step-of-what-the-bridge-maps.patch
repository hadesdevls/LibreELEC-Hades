 };
 
 /*
@@ -638,6 +650,20 @@ static struct pl_hook_res mask_low_latency(struct active_mask *mask, const struc
         .description = "DV Low-Latency picture within the display's peak"};
     mask->failed = mask->failed || p->stage != PL_HOOK_OUTPUT ||
                    !bars_written_in_this_shader(mask, p) || !pl_shader_custom(p->sh, &shader);
+    /* Hades: the 3D LUT of the display (dvbridge_render_set_lut()), the last step of the colour, over the picture
+     * and the test pattern; the bars stay at code 0, as they stay where they are written at the start of the shader
+     * (skip_inactive_area()) and as the lift of the black leaves them: a LUT that maps black elsewhere does not light
+     * them. Without a LUT the shader is the one before. */
