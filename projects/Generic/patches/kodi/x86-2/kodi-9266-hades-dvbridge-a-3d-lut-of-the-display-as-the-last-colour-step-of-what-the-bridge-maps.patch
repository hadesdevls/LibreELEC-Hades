diff --git a/tools/dvbridge/dvbridge_lut.c b/tools/dvbridge/dvbridge_lut.c
new file mode 100644
index 0000000..397b60a
--- /dev/null
+++ b/tools/dvbridge/dvbridge_lut.c
@@ -0,0 +1,749 @@
+/*
+ *  Copyright (C) 2026 Hades
+ *  This file is part of LibreELEC Hades. It is not in Kodi as Team Kodi publishes it.
+ *
+ *  SPDX-License-Identifier: GPL-2.0-or-later
