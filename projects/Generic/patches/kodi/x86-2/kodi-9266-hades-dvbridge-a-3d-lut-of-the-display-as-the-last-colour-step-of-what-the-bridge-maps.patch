+ */
+#include "dvbridge_lut.h"
+
+#include <libplacebo/shaders/custom.h>
+#include <math.h>
+#include <stdarg.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+
+/* ------------------------------------------------------------------------------------------------- the text */
+
+struct text {
+    const char *at, *end;
+};
+
+static void say(char *why, size_t why_size, const char *fmt, ...)
+{
+    if (!why || !why_size)
+        return;
+    va_list ap;
+    va_start(ap, fmt);
+    vsnprintf(why, why_size, fmt, ap);
+    va_end(ap);
+}
+
+static bool blank(char c)
+{
+    return c == ' ' || c == '\t' || c == '\r' || c == '\f' || c == '\v';
+}
+
+/* the next line, without the spaces at either end; false at the end of the text */
+static bool next_line(struct text *t, struct text *line, int *number)
+{
+    if (t->at >= t->end)
+        return false;
+    const char *eol = memchr(t->at, '\n', (size_t)(t->end - t->at));
+    const char *stop = eol ? eol : t->end;
+    line->at = t->at;
+    line->end = stop;
+    t->at = eol ? eol + 1 : t->end;
+    while (line->at < line->end && blank(*line->at))
+        ++line->at;
+    while (line->end > line->at && blank(line->end[-1]))
+        --line->end;
+    ++*number;
+    return true;
+}
+
+static void skip_blanks(struct text *t)
+{
+    while (t->at < t->end && blank(*t->at))
+        ++t->at;
+}
+
+/* A number as the C locale writes it (sign, digits, a point, digits, an exponent), whatever the locale of the
+ * process: the digits taken as an integer and scaled by a power of ten, each step rounded once */
+static bool number(struct text *t, double *out)
+{
+    skip_blanks(t);
+    const char *p = t->at;
+    bool negative = false;
+    if (p < t->end && (*p == '-' || *p == '+'))
+        negative = *p++ == '-';
+    uint64_t mantissa = 0;
+    int scale = 0, digits = 0, kept = 0;
+    while (p < t->end && *p >= '0' && *p <= '9') {
+        if (kept < 18) {
+            mantissa = mantissa * 10 + (uint64_t)(*p - '0');
+            kept += mantissa != 0;
+        } else {
+            ++scale;
+        }
+        ++p;
+        ++digits;
+    }
+    if (p < t->end && *p == '.') {
+        ++p;
+        while (p < t->end && *p >= '0' && *p <= '9') {
+            if (kept < 18) {
+                mantissa = mantissa * 10 + (uint64_t)(*p - '0');
+                kept += mantissa != 0;
+                --scale;
+            }
+            ++p;
+            ++digits;
+        }
+    }
+    if (!digits)
+        return false;
+    if (p < t->end && (*p == 'e' || *p == 'E')) {
+        const char *q = p + 1;
+        bool down = false;
+        if (q < t->end && (*q == '-' || *q == '+'))
+            down = *q++ == '-';
+        int e = 0, ed = 0;
+        while (q < t->end && *q >= '0' && *q <= '9' && e < 1000) {
+            e = e * 10 + (*q++ - '0');
+            ++ed;
+        }
+        if (!ed)
+            return false;
+        scale += down ? -e : e;
+        p = q;
+    }
+    /* the end of the number: a space or the end of the line */
+    if (p < t->end && !blank(*p))
+        return false;
+    double v = (double)mantissa;
+    if (scale < 0) {
+        double d = 1.0;
+        for (int i = 0; i < -scale && i < 400; ++i)
+            d *= 10.0;
+        v /= d;
+    } else {
+        for (int i = 0; i < scale && i < 400; ++i)
+            v *= 10.0;
+    }
+    *out = negative ? -v : v;
+    t->at = p;
+    return isfinite(*out);
+}
+
+/* a whole number (no point, no exponent) */
+static bool integer(struct text *t, long *out)
+{
+    skip_blanks(t);
+    const char *p = t->at;
+    if (p >= t->end || *p < '0' || *p > '9')
+        return false;
+    long v = 0;
+    while (p < t->end && *p >= '0' && *p <= '9') {
+        if (v > 100000000L)
+            return false;
+        v = v * 10 + (*p++ - '0');
+    }
+    if (p < t->end && !blank(*p))
+        return false;
+    *out = v;
+    t->at = p;
+    return true;
+}
+
+static bool at_end(struct text *t)
+{
+    skip_blanks(t);
+    return t->at >= t->end;
+}
+
+/* the keyword at the start of a line (letters, digits and _), and the line after it */
+static bool keyword(const struct text *line, const char *name, struct text *rest)
+{
+    const size_t n = strlen(name);
+    if ((size_t)(line->end - line->at) < n || memcmp(line->at, name, n))
+        return false;
+    if (line->at + n < line->end && !blank(line->at[n]))
+        return false;
+    rest->at = line->at + n;
+    rest->end = line->end;
+    return true;
+}
+
+static bool starts_alpha(const struct text *line)
+{
+    const char c = *line->at;
+    return (c >= 'A' && c <= 'Z') || (c >= 'a' && c <= 'z') || c == '_';
+}
+
+static uint64_t fnv1a(const void *bytes, size_t size, uint64_t h)
+{
+    const uint8_t *p = bytes;
+    for (size_t i = 0; i < size; ++i) {
+        h ^= p[i];
+        h *= 0x100000001b3ULL;
+    }
+    return h;
+}
+
+/* ---------------------------------------------------------------------------------------------- the LUT */
+
+static struct dvbridge_lut *make(int size, enum dvbridge_lut_format format)
+{
+    struct dvbridge_lut *lut = calloc(1, sizeof(*lut));
+    const size_t n = (size_t)size * size * size * 3;
+    if (!lut || !(lut->data = malloc(n * sizeof(float)))) {
+        free(lut);
+        return NULL;
+    }
+    lut->size = size;
+    lut->format = format;
+    lut->pl.size[0] = lut->pl.size[1] = lut->pl.size[2] = size;
+    lut->pl.data = lut->data;
+    lut->in = lut->out = (struct dvbridge_lut_range){0.0f, 255.0f};
+    return lut;
+}
+
+void dvbridge_lut_free(struct dvbridge_lut **lut)
+{
+    if (!lut || !*lut)
+        return;
+    free((*lut)->data);
+    free(*lut);
+    *lut = NULL;
+}
+
+static void finish(struct dvbridge_lut *lut, const void *bytes, size_t size)
+{
+    /* the signature of the table (libplacebo makes it again when it changes): the file's bytes and its format */
+    uint64_t h = fnv1a(bytes, size, 0xcbf29ce484222325ULL);
+    h = fnv1a(&lut->format, sizeof(lut->format), h);
+    lut->pl.signature = h ? h : 1;
+}
+
+/* a value of the output: finite, and not far outside [0, 1] (a LUT gives a signal; a little outside it is held
+ * within it after the LUT) */
+static bool sane(double v)
+{
+    return isfinite(v) && v >= -1.0 && v <= 2.0;
+}
+
+/* ----------------------------------------------------------------------------------------------- .cube */
+
+static struct dvbridge_lut *parse_cube(const char *bytes, size_t size, struct dvbridge_lut_range range,
+                                       char *why, size_t ws)
+{
+    struct text t = {bytes, bytes + size}, line, rest;
+    int number_of_line = 0, n = 0;
+    size_t values = 0, want = 0;
+    struct dvbridge_lut *lut = NULL;
+    char title[128] = "";
+    bool data = false;
+    while (next_line(&t, &line, &number_of_line)) {
+        if (line.at == line.end || *line.at == '#')
+            continue;
+        if (starts_alpha(&line)) {
+            if (data) {
+                say(why, ws, "a keyword after the values (line %d)", number_of_line);
+                goto fail;
+            }
+            double a, b, c;
+            long l;
+            if (keyword(&line, "TITLE", &rest)) {
+                skip_blanks(&rest);
+                size_t len = (size_t)(rest.end - rest.at);
+                const char *s = rest.at;
+                if (len >= 2 && s[0] == '"' && s[len - 1] == '"') {
+                    ++s;
+                    len -= 2;
+                }
+                if (len >= sizeof(title))
+                    len = sizeof(title) - 1;
+                memcpy(title, s, len);
+                title[len] = '\0';
+            } else if (keyword(&line, "LUT_3D_SIZE", &rest)) {
+                if (n) {
+                    say(why, ws, "LUT_3D_SIZE given twice (line %d)", number_of_line);
+                    goto fail;
+                }
+                if (!integer(&rest, &l) || !at_end(&rest) || l < 2 || l > DVBRIDGE_LUT_MAX_SIZE) {
+                    say(why, ws, "LUT_3D_SIZE is not a size from 2 to %d (line %d)", DVBRIDGE_LUT_MAX_SIZE,
+                        number_of_line);
+                    goto fail;
+                }
+                n = (int)l;
+            } else if (keyword(&line, "LUT_1D_SIZE", &rest) || keyword(&line, "LUT_1D_INPUT_RANGE", &rest)) {
+                say(why, ws, "a 1D LUT (line %d): only 3D LUTs are applied", number_of_line);
+                goto fail;
+            } else if (keyword(&line, "DOMAIN_MIN", &rest)) {
+                if (!number(&rest, &a) || !number(&rest, &b) || !number(&rest, &c) || !at_end(&rest) || a != 0.0 ||
+                    b != 0.0 || c != 0.0) {
+                    say(why, ws, "DOMAIN_MIN is not 0 0 0 (line %d): only LUTs of the domain [0, 1] are read",
+                        number_of_line);
+                    goto fail;
+                }
+            } else if (keyword(&line, "DOMAIN_MAX", &rest)) {
+                if (!number(&rest, &a) || !number(&rest, &b) || !number(&rest, &c) || !at_end(&rest) || a != 1.0 ||
+                    b != 1.0 || c != 1.0) {
+                    say(why, ws, "DOMAIN_MAX is not 1 1 1 (line %d): only LUTs of the domain [0, 1] are read",
+                        number_of_line);
+                    goto fail;
+                }
+            } else if (keyword(&line, "LUT_3D_INPUT_RANGE", &rest)) {
+                if (!number(&rest, &a) || !number(&rest, &b) || !at_end(&rest) || a != 0.0 || b != 1.0) {
+                    say(why, ws, "LUT_3D_INPUT_RANGE is not 0 1 (line %d): only LUTs of the domain [0, 1] are read",
+                        number_of_line);
+                    goto fail;
+                }
+            } else {
+                const char *e = line.at;
+                while (e < line.end && !blank(*e))
+                    ++e;
+                say(why, ws, "the keyword %.*s is not one that is read (line %d)", (int)(e - line.at > 40 ? 40 : e - line.at),
+                    line.at, number_of_line);
+                goto fail;
+            }
+            continue;
+        }
+        /* a line of values */
+        if (!n) {
+            say(why, ws, "values before LUT_3D_SIZE (line %d)", number_of_line);
+            goto fail;
+        }
+        if (!lut) {
+            lut = make(n, DVBRIDGE_LUT_CUBE);
+            if (!lut) {
+                say(why, ws, "no memory for a LUT of %d points a side", n);
+                goto fail;
+            }
+            want = (size_t)n * n * n;
+            data = true;
+        }
+        if (values >= want) {
+            say(why, ws, "more lines of values than LUT_3D_SIZE %d says (line %d)", n, number_of_line);
+            goto fail;
+        }
+        double v[3];
+        if (!number(&line, &v[0]) || !number(&line, &v[1]) || !number(&line, &v[2]) || !at_end(&line)) {
+            say(why, ws, "line %d is not three numbers", number_of_line);
+            goto fail;
+        }
+        for (int c = 0; c < 3; ++c) {
+            if (!sane(v[c])) {
+                say(why, ws, "a value far outside [0, 1] (line %d)", number_of_line);
+                goto fail;
+            }
+            /* red fastest, as libplacebo's table */
+            lut->data[values * 3 + (size_t)c] = (float)v[c];
+        }
+        ++values;
+    }
+    if (!n) {
+        say(why, ws, "no LUT_3D_SIZE");
+        goto fail;
+    }
+    if (values != want) {
+        say(why, ws, "%zu lines of values where LUT_3D_SIZE %d says %zu", values, n, want);
+        goto fail;
+    }
+    lut->in = lut->out = range;
+    snprintf(lut->title, sizeof(lut->title), "%s", title);
+    finish(lut, bytes, size);
+    return lut;
+fail:
+    dvbridge_lut_free(&lut);
+    return NULL;
+}
+
+/* ------------------------------------------------------------------------------------------------ .3dl */
+
+static struct dvbridge_lut *parse_3dl(const char *bytes, size_t size, struct dvbridge_lut_range range,
+                                      char *why, size_t ws)
+{
+    struct text t = {bytes, bytes + size}, line, rest;
+    int number_of_line = 0, n = 0, mesh_in = 0, mesh_out = 0;
+    long shaper[DVBRIDGE_LUT_MAX_SIZE + 1];
+    uint32_t *raw = NULL;
+    size_t values = 0, want = 0;
+    struct dvbridge_lut *lut = NULL;
+    while (next_line(&t, &line, &number_of_line)) {
+        if (line.at == line.end || *line.at == '#')
+            continue;
+        /* (Lustre's header line, which starts with a digit) */
+        if (!n && keyword(&line, "3DMESH", &rest) && at_end(&rest))
+            continue;
+        if (starts_alpha(&line)) {
+            long a, b;
+            if (keyword(&line, "Mesh", &rest) && integer(&rest, &a) && integer(&rest, &b) && at_end(&rest) &&
+                a >= 1 && a <= 8 && b >= 8 && b <= 16 && !n) {
+                mesh_in = (int)a;
+                mesh_out = (int)b;
+                continue;
+            }
+            say(why, ws, "line %d is no line of a .3dl that is read", number_of_line);
+            goto fail;
+        }
+        if (!n) {
+            /* the shaper: the input codes of the grid */
+            int count = 0;
+            long v;
+            while (!at_end(&line)) {
+                if (count > DVBRIDGE_LUT_MAX_SIZE || !integer(&line, &v)) {
+                    say(why, ws, "the first line of values (line %d) is not the input codes of a grid of 2 to %d "
+                        "points", number_of_line, DVBRIDGE_LUT_MAX_SIZE);
+                    goto fail;
+                }
+                shaper[count++] = v;
+            }
+            if (count < 2 || count > DVBRIDGE_LUT_MAX_SIZE || shaper[0] != 0) {
+                say(why, ws, "the shaper line (line %d) is not a grid of 2 to %d points from 0", number_of_line,
+                    DVBRIDGE_LUT_MAX_SIZE);
+                goto fail;
+            }
+            if (mesh_in && count != (1 << mesh_in) + 1) {
+                say(why, ws, "the shaper line has %d points where Mesh %d says %d", count, mesh_in,
+                    (1 << mesh_in) + 1);
+                goto fail;
+            }
+            n = count;
+            const long top = shaper[n - 1];
+            bool uniform = top > 0;
+            for (int i = 0; i < n && uniform; ++i)
+                uniform = shaper[i] == lround((double)i * (double)top / (n - 1));
+            /* Nuke's and Flame's: codes i 2^bits / (N - 1), the last one the maximum (0, 64, ..., 960, 1023) */
+            bool two = false;
+            if (!uniform && n > 2 && ((top + 1) & top) == 0 && (top + 1) % (n - 1) == 0) {
+                const long step = (top + 1) / (n - 1);
+                two = true;
+                for (int i = 0; i < n - 1 && two; ++i)
+                    two = shaper[i] == (long)i * step;
+            }
+            if (!uniform && !two) {
+                say(why, ws, "the shaper line (line %d) is neither a uniform grid nor Nuke's (0, 64, ..., 1023): "
+                    "such a .3dl is not read", number_of_line);
+                goto fail;
+            }
+            lut = make(n, DVBRIDGE_LUT_3DL);
+            want = (size_t)n * n * n;
+            raw = malloc(want * 3 * sizeof(uint32_t));
+            if (!lut || !raw) {
+                say(why, ws, "no memory for a LUT of %d points a side", n);
+                goto fail;
+            }
+            if (two) {
+                lut->shaper_two = true;
+                lut->shaper_knee = (float)((double)shaper[n - 2] / (double)top);
+            }
+            continue;
+        }
+        if (values >= want) {
+            say(why, ws, "more lines of values than the shaper's %d points a side make (line %d)", n,
+                number_of_line);
+            goto fail;
+        }
+        long v[3];
+        if (!integer(&line, &v[0]) || !integer(&line, &v[1]) || !integer(&line, &v[2]) || !at_end(&line) ||
+            v[0] > 65535 || v[1] > 65535 || v[2] > 65535) {
+            say(why, ws, "line %d is not three whole numbers from 0 to 65535", number_of_line);
+            goto fail;
+        }
+        for (int c = 0; c < 3; ++c)
+            raw[values * 3 + (size_t)c] = (uint32_t)v[c];
+        ++values;
+    }
+    if (!n) {
+        say(why, ws, "no shaper line");
+        goto fail;
+    }
+    if (values != want) {
+        say(why, ws, "%zu lines of values where the shaper's %d points a side make %zu", values, n, want);
+        goto fail;
+    }
+    /* the depth of the output: Mesh's, else the smallest that holds the largest value */
+    uint32_t largest = 0;
+    for (size_t i = 0; i < want * 3; ++i)
+        largest = raw[i] > largest ? raw[i] : largest;
+    int bits = mesh_out;
+    if (!bits) {
+        static const int depths[4] = {10, 12, 14, 16};
+        for (int i = 0; i < 4 && !bits; ++i)
+            if (largest <= (1u << depths[i]) - 1)
+                bits = depths[i];
+    }
+    if (largest > (1u << bits) - 1) {
+        say(why, ws, "a value of %u above the %d bits of Mesh", largest, bits);
+        goto fail;
+    }
+    const double scale = (double)((1u << bits) - 1);
+    /* blue fastest in the file (red, green, blue nested), red fastest in the table */
+    for (int r = 0; r < n; ++r)
+        for (int g = 0; g < n; ++g)
+            for (int b = 0; b < n; ++b) {
+                const size_t from = ((size_t)r * n + g) * n + b, to = ((size_t)b * n + g) * n + r;
+                for (int c = 0; c < 3; ++c)
+                    lut->data[to * 3 + (size_t)c] = (float)(raw[from * 3 + (size_t)c] / scale);
+            }
+    free(raw);
+    lut->out_bits = bits;
+    lut->in = lut->out = range;
+    finish(lut, bytes, size);
+    return lut;
+fail:
+    free(raw);
+    dvbridge_lut_free(&lut);
+    return NULL;
+}
+
+/* ---------------------------------------------------------------------------------------------- madVR */
+
+#define MADVR_HEADER 96
+
+static uint32_t le32(const uint8_t *p)
+{
+    return (uint32_t)p[0] | (uint32_t)p[1] << 8 | (uint32_t)p[2] << 16 | (uint32_t)p[3] << 24;
+}
+
+static bool near_xy(const double a[8], const double b[8])
+{
+    for (int i = 0; i < 8; ++i)
+        if (fabs(a[i] - b[i]) > 0.002)
+            return false;
+    return true;
+}
+
+static bool has_word(const struct text *t, const char *word)
+{
+    const size_t n = strlen(word);
+    for (const char *p = t->at; p + n <= t->end; ++p) {
+        bool same = true;
+        for (size_t i = 0; i < n && same; ++i) {
+            char c = p[i];
+            if (c >= 'a' && c <= 'z')
+                c = (char)(c - 'a' + 'A');
+            same = c == word[i];
+        }
+        if (same)
+            return true;
+    }
+    return false;
+}
+
+static struct dvbridge_lut *parse_madvr(const uint8_t *bytes, size_t size, char *why, size_t ws)
+{
+    if (size < MADVR_HEADER || memcmp(bytes, "3DLT", 4)) {
+        say(why, ws, "not a madVR 3DLUT (no 3DLT header)");
+        return NULL;
+    }
+    const uint32_t version = le32(bytes + 4);
+    const uint32_t in_bits[3] = {le32(bytes + 48), le32(bytes + 52), le32(bytes + 56)};
+    const uint32_t in_encoding = le32(bytes + 60), out_bits = le32(bytes + 64), out_encoding = le32(bytes + 68);
+    const uint32_t params_at = le32(bytes + 72), params_size = le32(bytes + 76);
+    const uint32_t lut_at = le32(bytes + 80), compression = le32(bytes + 84);
+    const uint32_t stored = le32(bytes + 88), whole = le32(bytes + 92);
+    if (version != 1 || compression != 0 || in_encoding != 0 || out_encoding != 0 || out_bits != 16) {
+        say(why, ws, "a madVR 3DLUT of another kind (version %u, compression %u, input encoding %u, output "
+            "encoding %u, output %u bits): only version 1, uncompressed, RGB, 16-bit output is read",
+            version, compression, in_encoding, out_encoding, out_bits);
+        return NULL;
+    }
+    if (in_bits[0] != in_bits[1] || in_bits[0] != in_bits[2] || in_bits[0] < 1 || in_bits[0] > 8) {
+        say(why, ws, "a madVR 3DLUT whose input depths are %u, %u and %u: only one depth of 1 to 8 bits is read",
+            in_bits[0], in_bits[1], in_bits[2]);
+        return NULL;
+    }
+    const int n = 1 << in_bits[0];
+    const size_t want = (size_t)n * n * n * 3 * 2;
+    if (stored != want || whole != want || lut_at < MADVR_HEADER || lut_at > size || size - lut_at < want ||
+        (params_size && (params_at < MADVR_HEADER || params_at > size || size - params_at < params_size))) {
+        say(why, ws, "a madVR 3DLUT whose sizes do not hold (%u points a side, the table %u of %zu bytes at %u, "
+            "the parameters %u bytes at %u, the file %zu bytes)", n, stored, want, lut_at, params_size, params_at,
+            size);
+        return NULL;
+    }
+    struct dvbridge_lut *lut = make(n, DVBRIDGE_LUT_MADVR);
+    if (!lut) {
+        say(why, ws, "no memory for a LUT of %d points a side", n);
+        return NULL;
+    }
+    /* as Kodi's CColorManager::Load3dLut() reads it: red slowest and blue fastest, each sample blue, green, red;
+     * red fastest in the table */
+    const uint8_t *p = bytes + lut_at;
+    for (int r = 0; r < n; ++r)
+        for (int g = 0; g < n; ++g)
+            for (int b = 0; b < n; ++b, p += 6) {
+                float *to = lut->data + (((size_t)b * n + g) * n + r) * 3;
+                to[0] = (float)((p[4] | p[5] << 8) / 65535.0);
+                to[1] = (float)((p[2] | p[3] << 8) / 65535.0);
+                to[2] = (float)((p[0] | p[1] << 8) / 65535.0);
+            }
+    lut->out_bits = 16;
+    /* video levels, as madVR and Kodi take a madVR LUT, where its parameters say no other */
+    lut->in = lut->out = (struct dvbridge_lut_range){16.0f, 235.0f};
+    struct text params = {(const char *)bytes + params_at, (const char *)bytes + params_at + params_size}, line, rest;
+    int number_of_line = 0;
+    while (params_size && next_line(&params, &line, &number_of_line)) {
+        double a, b, xy[8];
+        if (keyword(&line, "Input_Range", &rest) && number(&rest, &a) && number(&rest, &b) && a >= 0 && b <= 255 &&
+            b > a) {
+            lut->in = (struct dvbridge_lut_range){(float)a, (float)b};
+            lut->range_declared = true;
+        } else if (keyword(&line, "Output_Range", &rest) && number(&rest, &a) && number(&rest, &b) && a >= 0 &&
+                   b <= 255 && b > a) {
+            lut->out = (struct dvbridge_lut_range){(float)a, (float)b};
+            lut->range_declared = true;
+        } else if (keyword(&line, "Input_Primaries", &rest)) {
+            int k = 0;
+            while (k < 8 && number(&rest, &xy[k]))
+                ++k;
+            static const double bt709[8] = {0.640, 0.330, 0.300, 0.600, 0.150, 0.060, 0.3127, 0.3290};
+            static const double p3[8] = {0.680, 0.320, 0.265, 0.690, 0.150, 0.060, 0.3127, 0.3290};
+            static const double bt2020[8] = {0.708, 0.292, 0.170, 0.797, 0.131, 0.046, 0.3127, 0.3290};
+            if (k == 8)
+                lut->gamut = near_xy(xy, bt709) ? DVBRIDGE_LUT_GAMUT_BT709
+                             : near_xy(xy, p3)  ? DVBRIDGE_LUT_GAMUT_P3_D65
+                             : near_xy(xy, bt2020) ? DVBRIDGE_LUT_GAMUT_BT2020
+                                                   : DVBRIDGE_LUT_GAMUT_UNKNOWN;
+        } else if (keyword(&line, "Input_Transfer_Function", &rest)) {
+            lut->signal = has_word(&rest, "PQ") || has_word(&rest, "2084") ? DVBRIDGE_LUT_SIGNAL_PQ
+                          : has_word(&rest, "HLG")                         ? DVBRIDGE_LUT_SIGNAL_HLG
+                                                                           : DVBRIDGE_LUT_SIGNAL_SDR;
+        }
+    }
+    finish(lut, bytes, size);
+    return lut;
+}
+
+/* ---------------------------------------------------------------------------------------------- parse */
+
+static bool ends_with(const char *name, const char *ext)
+{
+    const size_t n = name ? strlen(name) : 0, e = strlen(ext);
+    if (n < e)
+        return false;
+    for (size_t i = 0; i < e; ++i) {
+        char c = name[n - e + i];
+        if (c >= 'A' && c <= 'Z')
+            c = (char)(c - 'A' + 'a');
+        if (c != ext[i])
+            return false;
+    }
+    return true;
+}
+
+struct dvbridge_lut *dvbridge_lut_parse(const void *bytes, size_t size, const char *name,
+                                        struct dvbridge_lut_range range, char *why, size_t why_size)
+{
+    say(why, why_size, "%s", "");
+    if (!bytes || !size) {
+        say(why, why_size, "the file is empty");
+        return NULL;
+    }
+    if (size > DVBRIDGE_LUT_MAX_BYTES) {
+        say(why, why_size, "the file is larger than %zu MB", DVBRIDGE_LUT_MAX_BYTES >> 20);
+        return NULL;
+    }
+    if (!(range.lo >= 0.0f && range.hi <= 255.0f && range.hi > range.lo)) {
+        say(why, why_size, "no range of the LUT's values");
+        return NULL;
+    }
+    if (size >= 4 && !memcmp(bytes, "3DLT", 4))
+        return parse_madvr(bytes, size, why, why_size);
+    if (ends_with(name, ".3dlut")) {
+        say(why, why_size, "a .3dlut without the header of madVR's format (3DLT)");
+        return NULL;
+    }
+    /* a text: no zero byte in it */
+    if (memchr(bytes, '\0', size)) {
+        say(why, why_size, "not a LUT of text (.cube, .3dl) nor of madVR's format");
+        return NULL;
+    }
+    if (ends_with(name, ".3dl"))
+        return parse_3dl(bytes, size, range, why, why_size);
+    if (ends_with(name, ".cube"))
+        return parse_cube(bytes, size, range, why, why_size);
+    say(why, why_size, "the name of the file ends in neither .cube, .3dl nor .3dlut");
+    return NULL;
+}
+
+const char *dvbridge_lut_format_name(enum dvbridge_lut_format format)
+{
+    switch (format) {
+    case DVBRIDGE_LUT_CUBE: return ".cube";
+    case DVBRIDGE_LUT_3DL: return ".3dl";
+    case DVBRIDGE_LUT_MADVR: return "madVR 3DLUT";
+    default: return "none";
+    }
+}
+
+const char *dvbridge_lut_signal_name(enum dvbridge_lut_signal signal)
+{
+    switch (signal) {
+    case DVBRIDGE_LUT_SIGNAL_SDR: return "SDR";
+    case DVBRIDGE_LUT_SIGNAL_PQ: return "PQ";
+    case DVBRIDGE_LUT_SIGNAL_HLG: return "HLG";
+    default: return "not said";
+    }
+}
+
+const char *dvbridge_lut_gamut_name(enum dvbridge_lut_gamut gamut)
+{
+    switch (gamut) {
+    case DVBRIDGE_LUT_GAMUT_BT709: return "BT.709";
+    case DVBRIDGE_LUT_GAMUT_P3_D65: return "DCI-P3 (D65)";
+    case DVBRIDGE_LUT_GAMUT_BT2020: return "BT.2020";
+    default: return "not said";
+    }
+}
+
+void dvbridge_lut_point(const struct dvbridge_lut *lut, int r, int g, int b, float rgb[3])
+{
+    const size_t at = (((size_t)b * lut->size + g) * lut->size + r) * 3;
+    rgb[0] = lut->data[at];
+    rgb[1] = lut->data[at + 1];
+    rgb[2] = lut->data[at + 2];
+}
+
+/* ---------------------------------------------------------------------------------------------- shader */
+
+static bool full(struct dvbridge_lut_range r)
+{
+    return r.lo == 0.0f && r.hi == 255.0f;
+}
+
+bool dvbridge_lut_shader(pl_shader sh, const struct dvbridge_lut *lut, pl_shader_obj *state)
+{
+    if (!sh || !lut || !state)
+        return false;
+    /* the input of the LUT: its range, then the grid coordinate of a .3dl of Nuke's shaper (the last interval
+     * shorter: codes 0 to knee in N - 2 steps, knee to the maximum in one), as the fraction of [0, 1] that
+     * libplacebo's table takes. Nothing where the range is full and the grid uniform: the LUT alone. */
+    char body[640];
+    int at = 0;
+    if (!full(lut->in))
+        at += snprintf(body + at, sizeof(body) - (size_t)at,
+                       "color.rgb = (vec3(%.9g) + vec3(%.9g) * color.rgb) * vec3(%.9g);\n", (double)lut->in.lo,
+                       (double)(lut->in.hi - lut->in.lo), 1.0 / 255.0);
+    if (lut->shaper_two) {
+        const double knee = lut->shaper_knee, steps = lut->size - 2, last = lut->size - 1;
+        at += snprintf(body + at, sizeof(body) - (size_t)at,
+                       "{\n"
+                       "    vec3 lut_u = clamp(color.rgb, 0.0, 1.0);\n"
+                       "    vec3 lut_g = mix(lut_u * vec3(%.9g), vec3(%.9g) + (lut_u - vec3(%.9g)) * vec3(%.9g),\n"
+                       "                     greaterThan(lut_u, vec3(%.9g)));\n"
+                       "    color.rgb = lut_g * vec3(%.9g);\n"
+                       "}\n",
+                       steps / knee, steps, knee, 1.0 / (1.0 - knee), knee, 1.0 / last);
+    }
+    if (at && !pl_shader_custom(sh, &(struct pl_custom_shader){
+                                        .input = PL_SHADER_SIG_COLOR, .output = PL_SHADER_SIG_COLOR,
+                                        .body = body, .description = "3D LUT: its input"}))
+        return false;
+    pl_shader_custom_lut(sh, &lut->pl, state);
+    if (pl_shader_is_failed(sh))
+        return false;
+    /* its output: back from its range, held within [0, 1] */
+    if (!full(lut->out))
+        snprintf(body, sizeof(body), "color.rgb = clamp((color.rgb * vec3(255.0) - vec3(%.9g)) * vec3(%.9g), 0.0, "
+                 "1.0);\n", (double)lut->out.lo, 1.0 / (double)(lut->out.hi - lut->out.lo));
+    else
+        snprintf(body, sizeof(body), "color.rgb = clamp(color.rgb, 0.0, 1.0);\n");
+    return pl_shader_custom(sh, &(struct pl_custom_shader){
+                                    .input = PL_SHADER_SIG_COLOR, .output = PL_SHADER_SIG_COLOR,
+                                    .body = body, .description = "3D LUT: its output"});
+}
diff --git a/tools/dvbridge/dvbridge_lut.h b/tools/dvbridge/dvbridge_lut.h
new file mode 100644
index 0000000..83c6140
--- /dev/null
+++ b/tools/dvbridge/dvbridge_lut.h
@@ -0,0 +1,128 @@
+/*
+ *  Copyright (C) 2026 Hades
+ *  This file is part of LibreELEC Hades. It is not in Kodi as Team Kodi publishes it.
+ *
+ *  SPDX-License-Identifier: GPL-2.0-or-later
+ *  See LICENSES/README.md for more information.
+ */
+#ifndef DVBRIDGE_LUT_H
+#define DVBRIDGE_LUT_H
+
+/*
+ * Hades: a 3D LUT of the user's (a calibration of a display), read from a file, applied by the bridge as the last
+ * colour step of what it draws for a display that it maps to (dvbridge_render_set_lut()).
+ *
+ * The formats, each read here exactly as its file says or refused with the reason:
+ *   - .cube (Adobe / Resolve): LUT_3D_SIZE, TITLE, DOMAIN_MIN 0 0 0, DOMAIN_MAX 1 1 1, LUT_3D_INPUT_RANGE 0 1;
+ *     red fastest. A 1D LUT, another domain or input range, or any other keyword is refused: libplacebo's
+ *     pl_lut_parse_cube() passes unknown keywords over with a warning, reads a file with both a 1D and a 3D size
+ *     as one of them, scales the output values by the domain and takes a first data line that starts with a
+ *     space for a header line; the values of a LUT that it reads are the same as here.
+ *   - .3dl (Autodesk Lustre / Nuke): optional "3DMESH" and "Mesh <in bits> <out bits>", then the shaper line
+ *     (the input codes of the grid) and the integer outputs, blue fastest. The shaper of a uniform grid (code
+ *     i (max) / (N - 1), rounded) and the shaper of Nuke and Flame (codes i 2^bits / (N - 1), the last one the
+ *     maximum: 0, 64, ..., 960, 1023) are read exactly (the second as a shaper of two slopes in the shader);
+ *     any other is refused. The output depth is "Mesh"'s, else the smallest of 10, 12, 14 and 16 bits that holds
+ *     the largest value.
+ *   - .3dlut (madVR's format, as Kodi's CColorManager reads it: the "3DLT" header, version 1, RGB in and out,
+ *     16-bit output, no compression): its parameters say the range of its input and output (Input_Range and
+ *     Output_Range, on the scale of 0 to 255; video levels, 16 to 235, where it says none, as madVR and Kodi take
+ *     it), its primaries (Input_Primaries) and its transfer (Input_Transfer_Function: PQ, HLG or another).
+ *
+ * The values are kept as the file has them (scaled to [0, 1] where they are integers), on a uniform grid of N
+ * points per axis, red fastest: libplacebo's pl_custom_lut, which pl_shader_custom_lut() interpolates
+ * tetrahedrally from a 3D texture of 32-bit floats (on OpenGL ES 3, sh_lut() takes RGBA32F, the first float format
+ * that is not emulated): at its grid points it gives the values of the file, to the bit.
+ */
+
+#include <libplacebo/shaders.h>
+#include <libplacebo/shaders/lut.h>
+#include <stdbool.h>
+#include <stddef.h>
+#include <stdint.h>
+
+/* the formats */
+enum dvbridge_lut_format {
+    DVBRIDGE_LUT_NONE = 0,
+    DVBRIDGE_LUT_CUBE = 1,
+    DVBRIDGE_LUT_3DL = 2,
+    DVBRIDGE_LUT_MADVR = 3,
+};
+
+/* what a file says it was made for: its signal (UNKNOWN where it does not say: .cube and .3dl) */
+enum dvbridge_lut_signal {
+    DVBRIDGE_LUT_SIGNAL_UNKNOWN = 0,
+    DVBRIDGE_LUT_SIGNAL_SDR = 1, /* a gamma (BT.1886, a power, sRGB) */
+    DVBRIDGE_LUT_SIGNAL_PQ = 2,
+    DVBRIDGE_LUT_SIGNAL_HLG = 3,
+};
+
+/* ... and its gamut (UNKNOWN where it does not say, or where it is none of these) */
+enum dvbridge_lut_gamut {
+    DVBRIDGE_LUT_GAMUT_UNKNOWN = 0,
+    DVBRIDGE_LUT_GAMUT_BT709 = 1,
+    DVBRIDGE_LUT_GAMUT_P3_D65 = 2,
+    DVBRIDGE_LUT_GAMUT_BT2020 = 3,
+};
+
+/* the range of the values of the input or output of a LUT: full (0 to 1 of the signal), or the levels of video
+ * (lo to hi on the scale of 0 to 255: 16 to 235) */
+struct dvbridge_lut_range {
+    float lo, hi; /* 0 and 255: full */
+};
+
+/* the largest grid that is read (256: madVR's LUTs; 268 MB of 32-bit floats on the GPU) */
+#define DVBRIDGE_LUT_MAX_SIZE 256
+/* the largest file that is read */
+#define DVBRIDGE_LUT_MAX_BYTES ((size_t)256 << 20)
+
+struct dvbridge_lut {
+    /* the LUT as libplacebo takes it: size (N, N, N), data (N^3 RGB floats, red fastest), signature (of the
+     * file's bytes and how it is read) */
+    struct pl_custom_lut pl;
+    float *data;
+    enum dvbridge_lut_format format;
+    int size;
+    struct dvbridge_lut_range in, out;
+    /* the range was said by the file (madVR's parameters), not taken from the caller */
+    bool range_declared;
+    /* a .3dl of Nuke's shaper: the grid's last interval is shorter; the code where it starts (shaper_knee, of
+     * [0, 1] of the input) */
+    bool shaper_two;
+    float shaper_knee;
+    enum dvbridge_lut_signal signal;
+    enum dvbridge_lut_gamut gamut;
+    /* the depth of the integers of a .3dl's output, or of madVR's (16); 0: floats */
+    int out_bits;
+    char title[128]; /* TITLE of a .cube; empty where none */
+};
+
+/*
+ * Reads a LUT from the bytes of its file. name: the file's name (its extension says the format where its bytes
+ * do not: a madVR LUT by its header, a .cube by its keywords, a .3dl by its shaper line). range: the range of the
+ * input and output of a .cube or .3dl (which say none): full (0, 255) or video levels (16, 235).
+ * NULL where the file is not one of these formats or cannot be read exactly: why says why (a fixed text and what
+ * was found, at most why_size bytes).
+ */
+struct dvbridge_lut *dvbridge_lut_parse(const void *bytes, size_t size, const char *name,
+                                        struct dvbridge_lut_range range, char *why, size_t why_size);
+void dvbridge_lut_free(struct dvbridge_lut **lut);
+
+/* The name of a format and of a signal, for the log */
+const char *dvbridge_lut_format_name(enum dvbridge_lut_format format);
+const char *dvbridge_lut_signal_name(enum dvbridge_lut_signal signal);
+const char *dvbridge_lut_gamut_name(enum dvbridge_lut_gamut gamut);
+
+/*
+ * Appends the LUT to a shader whose colour is the signal in full range within [0, 1] (the output of the bridge's
+ * last pass): the input taken to the LUT's range and grid (its shaper), the LUT (pl_shader_custom_lut(), with
+ * state, the GPU object that holds its table: the caller's, destroyed with pl_shader_obj_destroy()), the output
+ * taken back from its range and held within [0, 1]. False where the shader could not take it (nothing then is
+ * to be drawn with this shader).
+ */
+bool dvbridge_lut_shader(pl_shader sh, const struct dvbridge_lut *lut, pl_shader_obj *state);
+
+/* The value of the LUT at grid point (r, g, b), as the file gives it (for the tests) */
+void dvbridge_lut_point(const struct dvbridge_lut *lut, int r, int g, int b, float rgb[3]);
+
+#endif
