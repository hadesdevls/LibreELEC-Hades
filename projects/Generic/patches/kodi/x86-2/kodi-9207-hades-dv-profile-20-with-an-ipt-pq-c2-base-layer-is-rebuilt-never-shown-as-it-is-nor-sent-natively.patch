 .../DVDCodecs/Video/DVDVideoCodecFFmpeg.cpp   | 25 ++++++++++-----
 .../DVDCodecs/Video/DVDVideoCodecFFmpeg.h     |  2 ++
 .../DVDCodecs/Video/DVPlaybackPolicy.h        | 31 +++++++++++++++++--
 .../VideoRenderers/DVBridgeLayers.h           |  4 +--
 .../windowing/gbm/WinSystemGbmGLESContext.cpp |  7 +++--
 6 files changed, 56 insertions(+), 17 deletions(-)

diff --git a/xbmc/cores/VideoPlayer/DVDCodecs/Overlay/PgsRange.h b/xbmc/cores/VideoPlayer/DVDCodecs/Overlay/PgsRange.h
index ffab625..ff16f37 100644
--- a/xbmc/cores/VideoPlayer/DVDCodecs/Overlay/PgsRange.h
+++ b/xbmc/cores/VideoPlayer/DVDCodecs/Overlay/PgsRange.h
@@ -14,11 +14,11 @@
 namespace KODI::SUBTITLES
 {
 //! (Hades) Whether a Dolby Vision video is a PQ video in BT.2020 whose base layer says nothing of
-//! its colours: profile 5, and 10 with a base layer of no other kind (IPT-PQ-c2). The other
+//! its colours: profile 5, and 10 and 20 with a base layer of no other kind (IPT-PQ-c2). The other
 //! profiles say what they are themselves (HDR10, SDR, HLG).
 constexpr bool IptPQVideo(int dvProfile, int blCompatibility)
 {
-  return dvProfile == 5 || (dvProfile == 10 && blCompatibility == 0);
+  return dvProfile == 5 || ((dvProfile == 10 || dvProfile == 20) && blCompatibility == 0);
 }
 
 /*!
diff --git a/xbmc/cores/VideoPlayer/DVDCodecs/Video/DVDVideoCodecFFmpeg.cpp b/xbmc/cores/VideoPlayer/DVDCodecs/Video/DVDVideoCodecFFmpeg.cpp
index c0deb73..d012c81 100644
--- a/xbmc/cores/VideoPlayer/DVDCodecs/Video/DVDVideoCodecFFmpeg.cpp
+++ b/xbmc/cores/VideoPlayer/DVDCodecs/Video/DVDVideoCodecFFmpeg.cpp
@@ -419,6 +419,9 @@ bool CDVDVideoCodecFFmpeg::Open(CDVDStreamInfo &hints, CDVDCodecOptions &options
   // Hades: ... or the stream is sent as the HDR10+ it also is (CDVDStreamInfo::doviHdr10PlusWins,
   // videoscreen.hadesdualhdr): its pictures go to the ordinary output, with their own HDR10+ metadata
   m_dvNoNative = m_dvNoNative || hints.doviHdr10PlusWins;
+  // Hades: ... or its profile does not go out natively (DVBRIDGE::NativeProfile(): profile 20)
+  m_dvProfileNotNative = !DVBRIDGE::NativeProfile(hints.dovi.dv_profile);
+  m_dvNoNative = m_dvNoNative || m_dvProfileNotNative;
   // Hades: and the pictures of any stream, HDR or not, say whether the user chose to send this video
   // as SDR (OutputChoice::SDR; what an SDR picture does with it is nothing)
   m_hdrAsSdrChosen = DVBRIDGE::GetOutputChoice() == DVBRIDGE::OutputChoice::SDR;
@@ -498,6 +501,9 @@ bool CDVDVideoCodecFFmpeg::Open(CDVDStreamInfo &hints, CDVDCodecOptions &options
             ? "decoded for the ordinary output, its base layer sent as SDR, as the user chose "
               "for this video (it is not rebuilt for SDR here: the tone mapping method of the "
               "video is not that of a reference display, or this output cannot draw it)"
+        : m_dvConvert && m_dvProfileNotNative
+            ? "decoded for output as HDR10 (a profile that is not sent natively; the base layer "
+              "is rebuilt)"
         : m_dvConvert && m_dvNoNative ? "decoded for output as HDR10, as the user chose "
                                         "for this video"
         : m_dvConvert && DVBRIDGE::BaseLayerIsNoPicture(hints.dovi.dv_profile,
@@ -508,14 +514,16 @@ bool CDVDVideoCodecFFmpeg::Open(CDVDStreamInfo &hints, CDVDCodecOptions &options
         : m_dvConvert ? "decoded for output as HDR10"
         : DVBRIDGE::BaseLayerIsNoPicture(hints.dovi.dv_profile,
                                          hints.dovi.dv_bl_signal_compatibility_id)
-            ? (m_dvNoNative ? "decoded for the ordinary output, as the user chose for this "
-                              "video (the base layer is no picture by itself: its colours "
-                              "are wrong)"
-                            : "decoded for the ordinary output (the base layer is no picture "
-                              "by itself, and it cannot be rebuilt here: its colours are "
-                              "wrong)")
-        : m_dvNoNative ? "decoded for the ordinary output, as the user chose for this video"
-                       : "decoded for the ordinary output");
+            ? (m_dvNoNative && !m_dvProfileNotNative
+                   ? "decoded for the ordinary output, as the user chose for this "
+                     "video (the base layer is no picture by itself: its colours "
+                     "are wrong)"
+                   : "decoded for the ordinary output (the base layer is no picture by itself, "
+                     "and it cannot be rebuilt here: its colours are wrong)")
+        : m_dvProfileNotNative ? "decoded for the ordinary output (a profile that is not sent "
+                                 "natively)"
+        : m_dvNoNative         ? "decoded for the ordinary output, as the user chose for this video"
+                               : "decoded for the ordinary output");
   if (m_dvFromHdr10Plus)
     CLog::Log(LOGINFO, "DV: its Dolby Vision metadata are made from its HDR10+ metadata, picture by "
                        "picture{}{}",
@@ -977,6 +985,7 @@ void CDVDVideoCodecFFmpeg::Dispose()
   m_dvConvert = false;
   m_dvConvertSdr = false;
   m_dvNoNative = false;
+  m_dvProfileNotNative = false;
   m_hdrAsSdrChosen = false;
   m_dvFromHdr10Plus = false;
   m_dvHdr10PlusFill = false;
diff --git a/xbmc/cores/VideoPlayer/DVDCodecs/Video/DVDVideoCodecFFmpeg.h b/xbmc/cores/VideoPlayer/DVDCodecs/Video/DVDVideoCodecFFmpeg.h
index 22c2ba8..c48f029 100644
--- a/xbmc/cores/VideoPlayer/DVDCodecs/Video/DVDVideoCodecFFmpeg.h
+++ b/xbmc/cores/VideoPlayer/DVDCodecs/Video/DVDVideoCodecFFmpeg.h
@@ -156,6 +156,8 @@ protected:
   bool m_dvConvertSdr{false};
   //! Hades: the user chose another output than native for the video (VideoPicture::doviNoNative)
   bool m_dvNoNative{false};
+  //! Hades: ... because the profile of the stream is not sent natively (DVBRIDGE::NativeProfile())
+  bool m_dvProfileNotNative{false};
   //! Hades: the user chose to send the video as SDR (VideoPicture::hdrAsSdrChosen)
   bool m_hdrAsSdrChosen{false};
   //! Hades: whether the pictures of this stream come from VAAPI was told (DVBRIDGE::DecoderTook())
diff --git a/xbmc/cores/VideoPlayer/DVDCodecs/Video/DVPlaybackPolicy.h b/xbmc/cores/VideoPlayer/DVDCodecs/Video/DVPlaybackPolicy.h
index ca319de..62681d0 100644
--- a/xbmc/cores/VideoPlayer/DVDCodecs/Video/DVPlaybackPolicy.h
+++ b/xbmc/cores/VideoPlayer/DVDCodecs/Video/DVPlaybackPolicy.h
@@ -88,7 +88,10 @@ constexpr bool RpuRepeated(bool hevc, bool codedRpu)
  */
 constexpr bool CpuPicturesEligible(int profile, bool enhancementLayer, bool ownMetadata)
 {
-  return ownMetadata && !enhancementLayer && (profile == 5 || profile == 8 || profile == 10);
+  // (Hades: and 20, of which the base view plays where it is not two views: single-layer, its own
+  // RPU on every access unit as profile 5 has it)
+  return ownMetadata && !enhancementLayer &&
+         (profile == 5 || profile == 8 || profile == 10 || profile == 20);
 }
 
 // Hades: the size of a frame of the transport of native Dolby Vision, and of its mode: the window,
@@ -532,6 +535,23 @@ constexpr bool NativeAllowed(OutputChoice choice)
          choice == OutputChoice::DOLBY_VISION || choice == OutputChoice::HDR10PLUS;
 }
 
+/*!
+ * rief Hades: whether a Dolby Vision stream of this profile may go out natively
+ *
+ * Not profile 20, Dolby Vision in MV-HEVC (the 3D films made for the Vision Pro, Apple's only
+ * Dolby Vision for stereo video). Its base view with its RPU could go to a display in Dolby Vision
+ * as profile 5 does (Dolby defines its base layer of compatibility 0 as that of profile 5), but no
+ * display was seen taking it so, and one that does not take its RPU shows wrong colours or
+ * nothing. It is rebuilt by the bridge and sent as HDR10, or mapped to SDR, as profile 5 is on a
+ * display without Dolby Vision (BaseLayerIsNoPicture()); with an HLG base layer (compatibility 4)
+ * it plays as HLG. (Its two views, a 3D picture, never go out in Dolby Vision: no display takes
+ * Dolby Vision in 3D over HDMI, and a stereoscopic video is never eligible: Eligible().)
+ */
+constexpr bool NativeProfile(int profile)
+{
+  return profile != 20;
+}
+
 //! Hades: a choice that reconstructs every Dolby Vision stream for output as HDR10, and never sends
 //! it natively: HDR10 (as kept for a file before 1.0 RC7), REBUILT_HDR10 and REBUILT_HDR10PLUS,
 //! which differ only in what goes out with the rebuilt picture (RebuiltHdr10PlusOf())
@@ -707,10 +727,17 @@ constexpr ConversionSetting ConversionSettingOf(bool convert, bool alsoEnhanceme
  * compatible with nothing (bl_signal_compatibility_id 0; by the profile, no such stream was at
  * hand). The base layer of every other stream is a picture by itself, the version made for
  * displays without Dolby Vision.
+ *
+ * Hades: and profile 20 (MV-HEVC) with compatibility 0, which Dolby's table of profiles defines as
+ * profile 5: "None, Dolby Vision proprietary 10 bit", BT.2020 with "PQ with reshaping" and the
+ * matrix IPT-PQ-C2 of SMPTE ST 2128 (Dolby Vision bitstream profiles, Online Delivery Kit). Before,
+ * its base view was shown as it is, as PQ in BT.2020: green and purple, as users of other players
+ * report of such files. (Its compatibility 4 is HLG, a picture by itself.)
  */
 constexpr bool BaseLayerIsNoPicture(int profile, int compatibility)
 {
-  return profile == 5 || (profile == 10 && compatibility == 0);
+  return profile == 5 || (profile == 10 && compatibility == 0) ||
+         (profile == 20 && compatibility == 0);
 }
 
 /*!
diff --git a/xbmc/cores/VideoPlayer/VideoRenderers/DVBridgeLayers.h b/xbmc/cores/VideoPlayer/VideoRenderers/DVBridgeLayers.h
index d17077e..94f35c7 100644
--- a/xbmc/cores/VideoPlayer/VideoRenderers/DVBridgeLayers.h
+++ b/xbmc/cores/VideoPlayer/VideoRenderers/DVBridgeLayers.h
@@ -334,8 +334,8 @@ inline std::string Describe(const Shape& base,
     text += "; enhancement layer not decoded: its RPUs say that it carries no residual";
   else if (without == Without::SET_ASIDE)
     text += "; enhancement layer set aside: its RPU says that it carries no residual";
-  // (profiles 5 and 8 have one layer)
-  else if (profile == 5 || profile == 8)
+  // (profiles 5, 8 and 20 have one layer: the second view of 20 is no enhancement layer)
+  else if (profile == 5 || profile == 8 || profile == 20)
     text += "; a single layer";
   else if (residual == Residual::FEL)
     text += "; no enhancement picture with it, though its RPU has a residual";
diff --git a/xbmc/windowing/gbm/WinSystemGbmGLESContext.cpp b/xbmc/windowing/gbm/WinSystemGbmGLESContext.cpp
index 0e60e3d..e89e5c3 100644
--- a/xbmc/windowing/gbm/WinSystemGbmGLESContext.cpp
+++ b/xbmc/windowing/gbm/WinSystemGbmGLESContext.cpp
@@ -2980,9 +2980,10 @@ KODI::GUILIB::GUIINFO::COREELEC::StreamHdr LabelsStreamHdr(StreamHdrType type)
 bool StreamEligible(const CDVDStreamInfo& stream, bool anyMode)
 {
   const bool software = (stream.codecOptions & CODEC_FORCE_SOFTWARE) != 0;
-  // (Hades: nor a video sent as the HDR10+ it also is: CDVDStreamInfo::doviHdr10PlusWins)
-  const bool chosen =
-      DVBRIDGE::NativeAllowed(DVBRIDGE::GetOutputChoice()) && !stream.doviHdr10PlusWins;
+  // (Hades: nor a video sent as the HDR10+ it also is: CDVDStreamInfo::doviHdr10PlusWins; nor one
+  // of a profile that does not go out natively: DVBRIDGE::NativeProfile())
+  const bool chosen = DVBRIDGE::NativeAllowed(DVBRIDGE::GetOutputChoice()) &&
+                      !stream.doviHdr10PlusWins && DVBRIDGE::NativeProfile(stream.dovi.dv_profile);
   // (Hades: not a picture bigger than the raster that the output carries, decided here, before the
   // display enters Dolby Vision: DVBRIDGE::SourceFitsRaster())
   const bool fits = DVBRIDGE::SourceFitsRaster(stream.width, stream.height);
