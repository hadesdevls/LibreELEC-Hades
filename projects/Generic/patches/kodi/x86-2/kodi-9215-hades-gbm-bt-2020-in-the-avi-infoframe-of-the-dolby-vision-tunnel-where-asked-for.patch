From 00059c24f9f4a65d6301fedf9ef75fe8a7545980 Mon Sep 17 00:00:00 2001
From: Hades <15710513+hadesdevls@users.noreply.github.com>
Date: Tue, 24 Nov 2026 18:00:27 +0000
Subject: [PATCH] [Hades][GBM] BT.2020 in the AVI InfoFrame of the Dolby Vision
 tunnel, where asked for

A licensed player sends the AVI InfoFrame of Dolby Vision TV-led with RGB, full
range and the extended colorimetry BT.2020 (the user's Amlogic player, five
films; Amlogic's transmitter cites "Expected AVI-IF for Dolby Vision output,
need BT2020 for DV" of Dolby's kit). Hades sends no colorimetry there. What a
display does with either is only seen on it, so it becomes a choice:
COutputHandover::SetAviBt2020(), off by default.

With it, the capture of the output asks the kernel's backends (i915/xe,
amdgpu) for DVBRIDGE_DV_AVI_BT2020_LAB = 1, a property that changes only the
colorimetry of that InfoFrame ("Colorspace" stays Default, so not a byte of the
pixels changes), and nvidia-drm for "Colorspace" BT2020_RGB, with which NVKMS
sends BT.2020 in its AVI InfoFrame and drives the head as for RGB (nvkms-evo3.c:
the procamp, OCSC1 and clamp of BT2020RGB are those of RGB). Only for Dolby
Vision Standard: Low-Latency already says BT.2020 itself, and the HDMI 1.4b
signalling and HDR over the tunnel have their own. A kernel without the
property sends no colorimetry, as before. kodi.log says which.
---
 xbmc/windowing/gbm/drm/OutputHandover.cpp | 18 ++++++++++++++++++
 xbmc/windowing/gbm/drm/OutputHandover.h   | 11 +++++++++++
 xbmc/windowing/gbm/drm/TransportSpecs.h   | 14 +++++++++++++-
 3 files changed, 42 insertions(+), 1 deletion(-)

diff --git a/xbmc/windowing/gbm/drm/OutputHandover.cpp b/xbmc/windowing/gbm/drm/OutputHandover.cpp
index 123608f..1f3b8bd 100644
--- a/xbmc/windowing/gbm/drm/OutputHandover.cpp
+++ b/xbmc/windowing/gbm/drm/OutputHandover.cpp
@@ -40,6 +40,7 @@ std::atomic<int> g_converterUse{0};
 
 // ---- what the drivers call things (TransportSpecs.h) ----
 
+using OS::TRANSPORT::KERNEL_AVI_BT2020;
 using OS::TRANSPORT::KERNEL_DV;
 using OS::TRANSPORT::KERNEL_HDMI14B;
 using OS::TRANSPORT::KERNEL_HDR_TUNNEL;
@@ -520,6 +521,23 @@ bool COutputHandover::TakeOver(
   kind.hdmi14b = hdmi14b;
   kind.hdr10Tunnel = hdr10Tunnel;
   kind.signal = signal;
+  // Hades: BT.2020 in the AVI InfoFrame of the Standard tunnel where it is asked for
+  // (SetAviBt2020()); on the kernel's backends only where the driver has the property: an older
+  // kernel sends no colorimetry, as before, and the log says so
+  const bool standard = !lowLatency && !hdmi14b && !hdr10Tunnel;
+  kind.aviBt2020 = m_aviBt2020 && standard &&
+                   (driver == Driver::NVIDIA_DRM || connector->SupportsProperty(KERNEL_AVI_BT2020));
+  m_aviBt2020Taken = kind.aviBt2020;
+  if (m_aviBt2020)
+    CLog::Log(LOGINFO, "DVBridge: the AVI InfoFrame of the tunnel {}",
+              kind.aviBt2020 ? (driver == Driver::NVIDIA_DRM
+                                    ? "is to say BT.2020 colorimetry, as licensed set-top boxes send "
+                                      "it (Colorspace BT2020_RGB)"
+                                    : "is to say BT.2020 colorimetry, as licensed set-top boxes send "
+                                      "it (DVBRIDGE_DV_AVI_BT2020_LAB)")
+              : !standard ? "says what its signal says: BT.2020 in the AVI InfoFrame is set for "
+                            "Dolby Vision Standard only"
+                          : "says no colorimetry: the driver has no DVBRIDGE_DV_AVI_BT2020_LAB");
   const std::vector<OS::Spec> specs = OS::TRANSPORT::TransportSpecs(kind);
   constexpr auto CONNECTOR = OS::Role::CONNECTOR;
   constexpr auto CRTC = OS::Role::CRTC;
diff --git a/xbmc/windowing/gbm/drm/OutputHandover.h b/xbmc/windowing/gbm/drm/OutputHandover.h
index caef5aa..3587ec9 100644
--- a/xbmc/windowing/gbm/drm/OutputHandover.h
+++ b/xbmc/windowing/gbm/drm/OutputHandover.h
@@ -149,6 +149,15 @@ public:
   //! Why the last Capture() did not capture the output (what the output lacks, or what stands in
   //! the way), for the log; empty after one that did
   const std::string& TakeOverFailure() const { return m_takeOverFailure; }
+  //! Hades: the AVI InfoFrame of the Standard tunnel says BT.2020 colorimetry, as licensed players
+  //! send it (videoscreen.hadesdvavibt2020), from the next TakeOver(): the kernel's
+  //! DVBRIDGE_DV_AVI_BT2020_LAB where the driver has it, "Colorspace" BT2020_RGB on nvidia-drm
+  //! (NVKMS drives the head the same for BT2020_RGB as for RGB: nvkms-evo3.c, the procamp, OCSC1
+  //! and clamp of NVT_COLORIMETRY_BT2020RGB are those of NVT_COLORIMETRY_RGB). Not with
+  //! Low-Latency, the HDMI 1.4b signalling or HDR over the tunnel, which have their own.
+  void SetAviBt2020(bool on) { m_aviBt2020 = on; }
+  //! ... and whether the last TakeOver() asked the driver for it
+  bool AviBt2020Taken() const { return m_aviBt2020Taken; }
   //! The driver of the captured output (NONE when nothing is captured).
   Driver HeldDriver() const { return m_driver; }
   //! The captured output sends Dolby Vision Low-Latency
@@ -189,6 +198,8 @@ private:
   Driver m_driver = Driver::NONE;
   bool m_refusalNoticeDue = true;
   std::string m_takeOverFailure;
+  bool m_aviBt2020{false}; //!< Hades: see SetAviBt2020()
+  bool m_aviBt2020Taken{false};
   bool m_lowLatency = false;
   bool m_hdr10Tunnel = false;
   //! the blob of the Dolby vendor InfoFrame (not with the HDMI 1.4b signalling)
diff --git a/xbmc/windowing/gbm/drm/TransportSpecs.h b/xbmc/windowing/gbm/drm/TransportSpecs.h
index 5370b95..1f32c54 100644
--- a/xbmc/windowing/gbm/drm/TransportSpecs.h
+++ b/xbmc/windowing/gbm/drm/TransportSpecs.h
@@ -24,6 +24,9 @@ constexpr const char* KERNEL_DV = "DVBRIDGE_DV_STANDARD_LAB";
 constexpr const char* KERNEL_LOW_LATENCY = "DVBRIDGE_DV_LOW_LATENCY_LAB";
 constexpr const char* KERNEL_HDMI14B = "DVBRIDGE_DV_HDMI14B_LAB";
 constexpr const char* KERNEL_HDR_TUNNEL = "DVBRIDGE_HDR10_TUNNEL_LAB";
+//! Hades: BT.2020 in the AVI InfoFrame of the Standard tunnel (i915/xe, amdgpu; a setting, not a
+//! signal: it says nothing of whether the tunnel is on)
+constexpr const char* KERNEL_AVI_BT2020 = "DVBRIDGE_DV_AVI_BT2020_LAB";
 constexpr const char* NVIDIA_VSIF = "NV_HDMI_VSIF_METADATA";
 constexpr const char* NVIDIA_LOW_LATENCY = "NV_HDMI_DV_LOW_LATENCY";
 constexpr const char* NVIDIA_HDMI14B = "NV_HDMI_DV_HDMI14B";
@@ -44,6 +47,9 @@ struct Kind
   bool lowLatency{false}; //!< Dolby Vision Low-Latency
   bool hdmi14b{false}; //!< the HDMI 1.4b signalling of Dolby Vision
   bool hdr10Tunnel{false}; //!< HDR over the tunnel (the kernel's backends only)
+  //! Hades: BT.2020 in the AVI InfoFrame of the Standard tunnel, as licensed players send it
+  //! (COutputHandover::SetAviBt2020()); never with the three above
+  bool aviBt2020{false};
   uint32_t signal{0}; //!< nvidia-drm: the blob of the vendor InfoFrame (made by the caller)
 };
 
@@ -83,6 +89,10 @@ inline std::vector<Spec> TransportSpecs(const Kind& kind)
     number(CONNECTOR, "max bpc", 8, true);
     named(CONNECTOR, "Broadcast RGB", "Full", true);
     named(CONNECTOR, "Colorspace", "Default", true);
+    // Hades: what the AVI InfoFrame of the tunnel says of colorimetry: BT.2020 where asked for, else
+    // none (a value that another program left goes back with the end); only the InfoFrame changes,
+    // not a byte of the pixels ("Colorspace" stays Default)
+    number(CONNECTOR, KERNEL_AVI_BT2020, kind.aviBt2020 ? 1 : 0, false);
     // The tunnel is RGB (amdgpu refuses another colour format than AUTO or RGB): AUTO with it; what
     // the user chose, or another program left, goes back with its end
     named(CONNECTOR, OUTPUT_FORMAT::PROPERTY, "AUTO", false);
@@ -114,7 +124,9 @@ inline std::vector<Spec> TransportSpecs(const Kind& kind)
     // bpc").
     named(CONNECTOR, OUTPUT_FORMAT::PROPERTY_NVIDIA, "auto", false);
     named(CONNECTOR, NVIDIA_OUTPUT_BPC, "auto", false);
-    named(CONNECTOR, "Colorspace", "Default", true);
+    // Hades: BT2020_RGB where the AVI InfoFrame is to say BT.2020 (kind.aviBt2020): NVKMS then sends
+    // its AVI InfoFrame with BT.2020 and drives the head as for RGB (COutputHandover::SetAviBt2020())
+    named(CONNECTOR, "Colorspace", kind.aviBt2020 ? "BT2020_RGB" : "Default", true);
     named(CRTC, "NV_CRTC_REGAMMA_TF", "Default", false);
     number(CRTC, "NV_CRTC_REGAMMA_LUT", 0, false);
     number(CRTC, "NV_CRTC_REGAMMA_DIVISOR", NVIDIA_ONE, false);
-- 
2.53.0

