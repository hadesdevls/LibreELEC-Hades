diff --git a/xbmc/network/ProjectorLink.h b/xbmc/network/ProjectorLink.h
index 1055782..eaef44a 100644
--- a/xbmc/network/ProjectorLink.h
+++ b/xbmc/network/ProjectorLink.h
@@ -150,6 +150,18 @@ struct Timeouts
   int gapMs = 1000;
 };
 
+/*!
+ * \brief Hades: how long the test of the connection is waited for, at most, in ms: the longest talk that the thread of
+ *        the control can be in when it is asked (connected and let in, its power, a picture mode and a lens memory,
+ *        whose answer a JVC gives once the lens has moved), and then the test's own (connected and let in, its power
+ *        and its model), with their gaps; the settings show it as a progress with Cancel
+ */
+constexpr int TestWaitMs(const Timeouts& t)
+{
+  return (t.connectMs + 2 * t.answerMs + t.modeMs + t.lensMs + 3 * t.gapMs) +
+         (t.connectMs + 3 * t.answerMs + 2 * t.gapMs);
+}
+
 /*!
  * \brief One talk with the projector: Open(), then commands, then Close() (or the destructor). Each
  *        call blocks for at most its timeout, and returns at once when *stop becomes true. Not thread
