 void CProjectorControl::Send(
@@ -650,15 +657,71 @@ void CProjectorControl::OnSettingAction(const std::shared_ptr<const CSetting>& s
   if (!setting || setting->GetId() != CSettings::SETTING_VIDEOSCREEN_HADESPROJECTORTEST)
     return;
   // the test runs on the thread of the control, which is the only one that talks to the projector
-  // (a JVC takes one connection at a time); the settings wait for it under the busy dialog
+  // (a JVC takes one connection at a time). The thread may be waiting for a lens that moves (up to a
+  // minute): the settings wait for the test with a progress that the user can cancel, and for
+  // TestWaitMs() at most; a test that is not waited for any more is taken back, or stopped
+  const unsigned int number = ++m_testNumber;
+  m_testStop = false;
   m_testDone.Reset();
-  m_testAsked = true;
+  m_testAsked = number;
   m_wake.Set();
-  CGUIDialogBusy::WaitOnEvent(m_testDone, 100, false);
+  const int limitMs = TestWaitMs(Timeouts());
+  const auto start = std::chrono::steady_clock::now();
+  auto* progress = CServiceBroker::GetGUI()->GetWindowManager().GetWindow<CGUIDialogProgress>(
+      WINDOW_DIALOG_PROGRESS);
+  if (progress)
+  {
+    progress->SetHeading(CVariant{Text(62750)});
+    progress->SetText(CVariant{Text(62770)});
+    progress->SetCanCancel(true);
+    progress->ShowProgressBar(true);
+    progress->SetPercentage(0);
+    progress->Open();
+  }
   std::string text;
+  bool done = false;
+  bool cancelled = false;
+  for (;;)
+  {
+    if (m_testDone.Wait(100ms))
+    {
+      std::lock_guard lock(m_testLock);
+      if (m_testDoneNumber == number)
+      {
+        text = m_testText;
+        done = true;
+        break;
+      }
+    }
+    const auto elapsedMs = std::chrono::duration_cast<std::chrono::milliseconds>(
+                               std::chrono::steady_clock::now() - start)
+                               .count();
+    if (progress)
+    {
+      progress->SetPercentage(static_cast<int>(std::min<int64_t>(100, elapsedMs * 100 / limitMs)));
+      progress->Progress();
+      if (progress->IsCanceled())
+      {
+        cancelled = true;
+        break;
+      }
+    }
+    if (elapsedMs >= limitMs)
+      break;
+  }
+  if (progress)
+    progress->Close();
+  if (!done)
   {
-    std::lock_guard lock(m_testLock);
-    text = m_testText;
+    unsigned int asked = number;
+    const bool takenBack = m_testAsked.compare_exchange_strong(asked, 0);
+    m_testStop = true;
+    CLog::Log(LOGINFO, "Projector: test of the connection {} ({})",
+              cancelled ? "cancelled by the user" : "not answered in time",
+              takenBack ? "not begun" : "stopped");
+    if (cancelled)
+      return;
+    text = Fill(Text(62771), BrandName(BrandSet()), std::to_string(limitMs / 1000));
   }
   KODI::MESSAGING::HELPERS::ShowOKDialogText(CVariant{Text(62750)}, CVariant{text});
 }
