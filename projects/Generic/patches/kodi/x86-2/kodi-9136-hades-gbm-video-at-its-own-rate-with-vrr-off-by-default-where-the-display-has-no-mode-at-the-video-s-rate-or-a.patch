+/*
+ *  Copyright (C) 2026 Hades
+ *  This file is part of LibreELEC Hades. It is not in Kodi as Team Kodi publishes it.
+ *
+ *  SPDX-License-Identifier: GPL-2.0-or-later
+ *  See LICENSES/README.md for more information.
+ */
+
+#pragma once
+
+namespace KODI::SETTINGS::HADES
+{
+
+/*!
+ * \brief A boolean setting of Hades taken over by a setting with more values (the expert settings of
+ *        native Dolby Vision output, CDVEngineSettings; "Video at its own rate with VRR",
+ *        VRR_VIDEO::Mode)
+ *
+ * The boolean is kept, hidden, with the value that an earlier build would read from it (toOld()). A
+ * boolean that says something else than the new setting at its default says (never set, or set back
+ * to it, which sets the boolean again) was saved by a build without the new setting: the new one
+ * takes it over (fromOld()). So a user's choice survives the update to this build, and the way back
+ * to an earlier one. Pure: a test runs it on the host.
+ */
+struct TakeOver
+{
+  int mode = 0; //!< the new setting
+  bool old = true; //!< the boolean
+  bool modeChanged = false;
+  bool oldChanged = false;
+};
+
+//! When the settings are loaded: what the two are to be. \param deflt the default of the new one
+inline TakeOver Migrate(int mode, int deflt, bool old, int (*fromOld)(bool), bool (*toOld)(int))
+{
+  TakeOver m;
+  m.mode = mode == deflt && old != toOld(deflt) ? fromOld(old) : mode;
+  m.old = toOld(m.mode);
+  m.modeChanged = m.mode != mode;
+  m.oldChanged = m.old != old;
+  return m;
+}
+
+} // namespace KODI::SETTINGS::HADES
