From 147c5c8f4d2217fc03053757e81886c2e5d648e1 Mon Sep 17 00:00:00 2001
From: Hades <15710513+hadesdevls@users.noreply.github.com>
Date: Tue, 24 Nov 2026 16:51:15 +0000
Subject: [PATCH] [Hades][GBM] A frame-packed mode of nvidia-drm gets a window
 of 8 bits, and kodi.log names its buffer

Issue #33 (Khazar321, RTX 5090): the first frame-packed window was made of
half floats (AB4H), the window of the video before it, and nvidia-drm refused
it as it refused the 8-bit ones after it. A 3D video (MVC, H.264) has 8 bits,
and the frame packing of the driver was never seen with a deeper buffer: a
frame-packed mode of nvidia-drm now gets a window of 8 bits
(CreateNewWindow()), and kodi.log says so. The window of the next mode has
the depth of the video again (SetVideoOutput()).

kodi.log also names the buffer that a frame-packed frame goes to the driver
in, wherever one is made (CreateNewWindow(), CreateOutputSurface()): its size
and format, its pitch, its modifier and the byte where the second eye begins
(CDRMUtils::DescribeFramePackedBuffer()). Next to the reasons that the driver
now gives in the kernel log for a refused frame-packed mode
(nvidia-open-kernel-modules-9084), that is what is needed to fix the refusal.
Nothing changes on another driver or in another mode.
---
 xbmc/windowing/gbm/WinSystemGbmEGLContext.cpp | 37 +++++++++++++++++++
 xbmc/windowing/gbm/drm/DRMUtils.cpp           | 19 ++++++++++
 xbmc/windowing/gbm/drm/DRMUtils.h             |  4 ++
 3 files changed, 60 insertions(+)

diff --git a/xbmc/windowing/gbm/WinSystemGbmEGLContext.cpp b/xbmc/windowing/gbm/WinSystemGbmEGLContext.cpp
index 5b80e9e..bc79080 100644
--- a/xbmc/windowing/gbm/WinSystemGbmEGLContext.cpp
+++ b/xbmc/windowing/gbm/WinSystemGbmEGLContext.cpp
@@ -34,6 +34,24 @@ namespace
 constexpr unsigned int FLOAT_OUTPUT_ATTEMPTS = 3;
 constexpr unsigned int FLOAT_OUTPUT_WAIT = 7;
 
+//! Hades: the bits per component of a format of the window (8 for any other)
+int FormatBits(uint32_t format)
+{
+  switch (format)
+  {
+    case DRM_FORMAT_ARGB2101010:
+    case DRM_FORMAT_XRGB2101010:
+    case DRM_FORMAT_ABGR2101010:
+    case DRM_FORMAT_XBGR2101010:
+      return 10;
+    case DRM_FORMAT_ABGR16161616F:
+    case DRM_FORMAT_XBGR16161616F:
+      return 16;
+    default:
+      return 8;
+  }
+}
+
 bool IsFloatFormat(uint32_t format)
 {
   return format == DRM_FORMAT_ABGR16161616F || format == DRM_FORMAT_XBGR16161616F;
@@ -207,6 +225,19 @@ bool CWinSystemGbmEGLContext::CreateNewWindow(const std::string& name,
   }
 
   uint32_t format = m_eglContext.GetConfigAttrib(EGL_NATIVE_VISUAL_ID);
+
+  // Hades: a frame-packed mode of nvidia-drm gets a window of 8 bits (issue #33): a 3D video
+  // (MVC, H.264) has 8 bits, and the driver's frame packing was never seen with a deeper buffer.
+  // The window of the mode after it has the depth of the video again (SetVideoOutput()).
+  if (int width = res.iWidth;
+      m_DRM->FramePackedBufferDemands(format, width) && FormatBits(format) > 8 &&
+      ChooseEGLConfig(m_renderableType, 8))
+  {
+    CLog::LogF(LOGINFO, "3D output: the window of the frame-packed mode is made of 8 bits, not {}",
+               FormatBits(format));
+    format = m_eglContext.GetConfigAttrib(EGL_NATIVE_VISUAL_ID);
+  }
+
   std::vector<uint64_t> fallbackModifiers = {DRM_FORMAT_MOD_LINEAR};
   std::vector<uint64_t>* modifiers = &fallbackModifiers;
 
@@ -274,6 +305,10 @@ bool CWinSystemGbmEGLContext::CreateNewWindow(const std::string& name,
               __FUNCTION__, wrong);
     return false;
   }
+  // Hades: ... and what it is, where it is one (issue #33: what the driver was given, next to
+  // why it refused it, which the kernel log says)
+  if (const std::string packed = m_DRM->DescribeFramePackedBuffer(bo); !packed.empty())
+    CLog::Log(LOGINFO, "3D output: the frame-packed frame goes to the driver in {}", packed);
 
 #if defined(HAS_GBM_MODIFIERS)
   uint64_t modifier = gbm_bo_get_modifier(bo);
@@ -593,6 +628,8 @@ bool CWinSystemGbmEGLContext::CreateOutputSurface(uint32_t format, struct gbm_bo
                wrong);
     return false;
   }
+  if (const std::string packed = m_DRM->DescribeFramePackedBuffer(bo); !packed.empty())
+    CLog::Log(LOGINFO, "3D output: the frame-packed frame goes to the driver in {}", packed);
   return true;
 }
 
diff --git a/xbmc/windowing/gbm/drm/DRMUtils.cpp b/xbmc/windowing/gbm/drm/DRMUtils.cpp
index eb1d2ee..8d8c695 100644
--- a/xbmc/windowing/gbm/drm/DRMUtils.cpp
+++ b/xbmc/windowing/gbm/drm/DRMUtils.cpp
@@ -2251,6 +2251,25 @@ bool CDRMUtils::FramePackedBufferUsable(struct gbm_bo* bo, std::string& wrong) c
   return wrong.empty();
 }
 
+std::string CDRMUtils::DescribeFramePackedBuffer(struct gbm_bo* bo) const
+{
+  if (!bo || !FramePackedByOffsets())
+    return {};
+#if defined(HAS_GBM_MODIFIERS)
+  const uint32_t pitch = gbm_bo_get_stride_for_plane(bo, 0);
+  return StringUtils::Format(
+      "a buffer of {}x{} ({}), pitch {} bytes, modifier {}, the second eye from line {} (byte "
+      "{}), for a mode of {}x{} with {} lines in all",
+      gbm_bo_get_width(bo), gbm_bo_get_height(bo),
+      DRMHELPERS::FourCCToString(gbm_bo_get_format(bo)), pitch,
+      DRMHELPERS::ModifierToString(gbm_bo_get_modifier(bo)), m_mode->vtotal,
+      static_cast<uint64_t>(pitch) * m_mode->vtotal, m_mode->hdisplay, m_mode->vdisplay,
+      ScanoutHeight());
+#else
+  return StringUtils::Format("a buffer of {}x{}", gbm_bo_get_width(bo), gbm_bo_get_height(bo));
+#endif
+}
+
 uint32_t CDRMUtils::ScanoutHeight() const
 {
   return static_cast<uint32_t>(STEREO::ScanoutHeight(StereoModeOf(*m_mode)));
diff --git a/xbmc/windowing/gbm/drm/DRMUtils.h b/xbmc/windowing/gbm/drm/DRMUtils.h
index ad6f949..6e1b9ad 100644
--- a/xbmc/windowing/gbm/drm/DRMUtils.h
+++ b/xbmc/windowing/gbm/drm/DRMUtils.h
@@ -313,6 +313,10 @@ public:
   //! \brief Whether a buffer that was made meets it; true where nothing is asked
   //! \param[out] wrong what does not, for the log
   bool FramePackedBufferUsable(struct gbm_bo* bo, std::string& wrong) const;
+  //! \brief Hades: for the log, a buffer that is to hold a frame-packed frame for the driver: its
+  //!        size, pitch, modifier and where the second eye begins; empty where nothing is asked
+  //!        (FramePackedBufferDemands())
+  std::string DescribeFramePackedBuffer(struct gbm_bo* bo) const;
 
   void SetInFenceFd(int fd) { m_inFenceFd = fd; }
   //! Hades: the out-fence of the last commit, still Kodi's (TakeOutFenceFd() takes it); -1: none
-- 
