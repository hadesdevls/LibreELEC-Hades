From 9b567f3d9f95c3d2ae80e81a2002ab5ea2e4a928 Mon Sep 17 00:00:00 2001
From: olympia <olympia@xbmc.org>
Date: Tue, 17 Nov 2026 09:02:13 +0000
Subject: [PATCH] [Video] Hold the list item while it is played

Playing an item copies it and can change its properties while the
thumb loader may still be loading it, as StopAsync() does not wait for
the item in progress. Hold the item for the whole call, which waits only
when the loader is on that very item.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
(cherry picked from commit 3700150ead8bffc8ec49d68f5c1463d362e22972)
---
 xbmc/video/windows/GUIWindowVideoBase.cpp | 2 ++
 1 file changed, 2 insertions(+)

diff --git a/xbmc/video/windows/GUIWindowVideoBase.cpp b/xbmc/video/windows/GUIWindowVideoBase.cpp
index b18b83f..3d18581 100644
--- a/xbmc/video/windows/GUIWindowVideoBase.cpp
+++ b/xbmc/video/windows/GUIWindowVideoBase.cpp
@@ -1145,6 +1145,8 @@ bool CGUIWindowVideoBase::OnContextButton(int itemNumber, CONTEXT_BUTTON button)
 bool CGUIWindowVideoBase::OnPlayMedia(const std::shared_ptr<CFileItem>& pItem,
                                       const std::string& player)
 {
+  const CBackgroundInfoLoader::CItemHold itemHold{m_thumbLoader, pItem.get()};
+
   // party mode
   if (g_partyModeManager.IsEnabled(PartyModeContext::VIDEO))
   {
