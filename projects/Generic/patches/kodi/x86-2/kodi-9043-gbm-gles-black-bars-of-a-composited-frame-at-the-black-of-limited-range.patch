From b902d3b62062e3ff8a928d8a734a1d5133758bd0 Mon Sep 17 00:00:00 2001
From: Hades <15710513+hadesdevls@users.noreply.github.com>
Date: Wed, 18 Nov 2026 05:28:17 +0000
Subject: [PATCH] [GBM][GLES] Black bars of a composited frame at the black of
 limited range

Where the GUI is composited over the picture (into PQ, HLG, or SDR of
BT.2020), the picture is drawn by RenderEx() without its black bars, which
Kodi draws in the GUI pass (DrawBlackBars()) and the composite leaves out:
EndGuiComposite() clears the window's buffer to 0, and that is the bars.
Where the output is limited range ("Use limited colour range", the
composite made with KODI_LIMITED_RANGE), 0 is below black: the black of
that range is 16 of 255, 64 of 1023, which is what Kodi draws the bars of
SDR video at. A display that clips below black shows no difference; one
that shows it (a PLUGE set up) showed the bars darker than black.

The buffer is now cleared to 16 of 255 (stored as 64 in a 10-bit buffer)
in limited range on a single plane, for HDR as for SDR of BT.2020
(GuiCompositeClearBlack()). Where the GUI has a plane of its own, its
buffer stays transparent black: the display blends it over the video
plane, and a black of 16 would be added to the picture. Full range, and
the composite of native Dolby Vision output (always full range), are as
before.
---
 xbmc/rendering/gles/CMakeLists.txt            |  1 +
 xbmc/rendering/gles/GuiCompositeClear.h       | 37 +++++++++++++++++++
 .../windowing/gbm/WinSystemGbmGLESContext.cpp |  7 ++--
 3 files changed, 42 insertions(+), 3 deletions(-)
 create mode 100644 xbmc/rendering/gles/GuiCompositeClear.h

diff --git a/xbmc/rendering/gles/CMakeLists.txt b/xbmc/rendering/gles/CMakeLists.txt
index eb48551..4b8bcc8 100644
--- a/xbmc/rendering/gles/CMakeLists.txt
+++ b/xbmc/rendering/gles/CMakeLists.txt
@@ -7,6 +7,7 @@ if(TARGET ${APP_NAME_LC}::OpenGLES)
   set(HEADERS RenderSystemGLES.h
               ScreenshotSurfaceGLES.h
               GLESShader.h
+              GuiCompositeClear.h
               GuiCompositeShaderGLES.h)
 
 if("webos" IN_LIST CORE_PLATFORM_NAME_LC)
diff --git a/xbmc/rendering/gles/GuiCompositeClear.h b/xbmc/rendering/gles/GuiCompositeClear.h
new file mode 100644
index 0000000..1d1a883
--- /dev/null
+++ b/xbmc/rendering/gles/GuiCompositeClear.h
@@ -0,0 +1,37 @@
+/*
+ *  Copyright (C) 2026 Hades
+ *  This file is part of LibreELEC Hades. It is not in Kodi as Team Kodi publishes it.
+ *
+ *  SPDX-License-Identifier: GPL-2.0-or-later
+ *  See LICENSES/README.md for more information.
+ */
+
+#pragma once
+
+namespace KODI
+{
+namespace RENDERING
+{
+namespace GLES
+{
+
+/*!
+ * \brief Hades: what the window's buffer is cleared to before the picture of a frame whose GUI is
+ *        composited over it (CWinSystemGbmGLESContext::EndGuiComposite()), in each channel
+ *
+ * The picture is drawn by RenderEx() without its black bars (Kodi draws them in the GUI pass,
+ * DrawBlackBars(), which the composite leaves out), so the clear is what the bars are. Where the
+ * composite encodes limited range (KODI_LIMITED_RANGE, into PQ, HLG or SDR of BT.2020), that is the
+ * black of that range: 16 of 255, which a 10-bit buffer stores as 64 of 1023, as Kodi draws the
+ * bars of SDR there; a clear to 0 put the bars below black. Where the GUI has a plane of its own
+ * (the picture on the video plane), the buffer is the GUI plane, blended over the picture by the
+ * display: it stays transparent black, or the black of the range would be added to the picture.
+ */
+constexpr float GuiCompositeClearBlack(bool limitedRange, bool guiPlaneOfItsOwn)
+{
+  return limitedRange && !guiPlaneOfItsOwn ? 16.0f / 255.0f : 0.0f;
+}
+
+} // namespace GLES
+} // namespace RENDERING
+} // namespace KODI
diff --git a/xbmc/windowing/gbm/WinSystemGbmGLESContext.cpp b/xbmc/windowing/gbm/WinSystemGbmGLESContext.cpp
index 9730e7f..84c5a57 100644
--- a/xbmc/windowing/gbm/WinSystemGbmGLESContext.cpp
+++ b/xbmc/windowing/gbm/WinSystemGbmGLESContext.cpp
@@ -49,6 +49,7 @@
 #include "messaging/ApplicationMessenger.h"
 #include "messaging/helpers/DialogHelper.h"
 #include "rendering/MatrixGL.h"
+#include "rendering/gles/GuiCompositeClear.h"
 #include "rendering/gles/GuiCompositeShaderGLES.h"
 #include "rendering/gles/ScreenshotSurfaceGLES.h"
 #include "resources/LocalizeStrings.h"
@@ -2405,9 +2406,9 @@ void CWinSystemGbmGLESContext::EndGuiComposite()
   // never called. Without this clear, letterbox areas retain stale content
   // from the swap chain when the display resolution doesn't change between
   // GUI and video playback.
-  // (Hades: SDR of BT.2020 in limited range, single plane: the black of that range, as Kodi draws
-  // the bars of SDR video there, DrawBlackBars(); the HDR composite is left as it was)
-  const float black = m_compositeSdrWide && m_compositeLimited && !isD2P ? 16.0f / 255.0f : 0.0f;
+  // (Hades: in limited range, the black of that range on a single plane, for PQ, HLG and SDR of
+  // BT.2020 alike: KODI::RENDERING::GLES::GuiCompositeClearBlack())
+  const float black = KODI::RENDERING::GLES::GuiCompositeClearBlack(m_compositeLimited, isD2P);
   glClearColor(black, black, black, 0.0f);
   glClear(GL_COLOR_BUFFER_BIT);
 }
