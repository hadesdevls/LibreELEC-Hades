From 66225aae07aae56718d927bb59c05611e59714e5 Mon Sep 17 00:00:00 2001
From: Hades <15710513+hadesdevls@users.noreply.github.com>
Date: Fri, 20 Nov 2026 21:20:47 +0000
Subject: [PATCH] player information: native Dolby Vision Low-Latency is not
 shown as TV-led

The Output row of the overview said "Native, TV-led" and the Signal row
"Dolby Vision (TV-led)" for any native Dolby Vision, also in Low-Latency,
where Hades maps the picture to the display and the TV shows it as it
comes (issue #25). They now say "Native, Low-Latency" and
"DV Low-Latency" there, from hades.dv.transport, as the Transport row
already did. Standard is unchanged.

New strings #52860 and #52861 in en_gb, es_es, es_ar and es_mx; the
pages for other skins (system/hades) made again with make-playerinfo.py.
---
 .../language/resource.language.en_gb/strings.po      | 12 ++++++++++++
 .../language/resource.language.es_ar/strings.po      | 12 ++++++++++++
 .../language/resource.language.es_es/strings.po      | 12 ++++++++++++
 .../language/resource.language.es_mx/strings.po      | 12 ++++++++++++
 addons/skin.estuary/xml/Variables.xml                |  2 ++
 system/hades/HadesIncludes.xml                       |  2 ++
 6 files changed, 52 insertions(+)

diff --git a/addons/skin.estuary/language/resource.language.en_gb/strings.po b/addons/skin.estuary/language/resource.language.en_gb/strings.po
index cd95062..7f4fb26 100644
--- a/addons/skin.estuary/language/resource.language.en_gb/strings.po
+++ b/addons/skin.estuary/language/resource.language.en_gb/strings.po
@@ -4425,6 +4425,18 @@ msgctxt "#52785"
 msgid "Dolby Vision (TV-led)"
 msgstr ""
 
+#: addons/skin.estuary/xml/DialogPlayerProcessInfo.xml
+#. Hades, value: native Dolby Vision Low-Latency, which Hades maps to the display (in Standard the TV does: #52780)
+msgctxt "#52860"
+msgid "Native, Low-Latency"
+msgstr ""
+
+#: addons/skin.estuary/xml/DialogPlayerProcessInfo.xml
+#. Hades, value: what the TV receives, in native Dolby Vision Low-Latency (#52785 is Standard)
+msgctxt "#52861"
+msgid "DV Low-Latency"
+msgstr ""
+
 #: addons/skin.estuary/xml/DialogPlayerProcessInfo.xml
 #. Hades, value: what the TV receives
 msgctxt "#52786"
diff --git a/addons/skin.estuary/language/resource.language.es_ar/strings.po b/addons/skin.estuary/language/resource.language.es_ar/strings.po
index aa460f2..13b48b0 100644
--- a/addons/skin.estuary/language/resource.language.es_ar/strings.po
+++ b/addons/skin.estuary/language/resource.language.es_ar/strings.po
@@ -4231,6 +4231,18 @@ msgctxt "#52785"
 msgid "Dolby Vision (TV-led)"
 msgstr "Dolby Vision (TV-led)"
 
+#: addons/skin.estuary/xml/DialogPlayerProcessInfo.xml
+#. Hades, value: native Dolby Vision Low-Latency, which Hades maps to the display (in Standard the TV does: #52780)
+msgctxt "#52860"
+msgid "Native, Low-Latency"
+msgstr "Nativo, Low-Latency"
+
+#: addons/skin.estuary/xml/DialogPlayerProcessInfo.xml
+#. Hades, value: what the TV receives, in native Dolby Vision Low-Latency (#52785 is Standard)
+msgctxt "#52861"
+msgid "DV Low-Latency"
+msgstr "DV Low-Latency"
+
 #: addons/skin.estuary/xml/DialogPlayerProcessInfo.xml
 #. Hades, value: what the TV receives
 msgctxt "#52786"
diff --git a/addons/skin.estuary/language/resource.language.es_es/strings.po b/addons/skin.estuary/language/resource.language.es_es/strings.po
index d209b1d..0be88e4 100644
