diff --git a/addons/skin.estuary/xml/Variables.xml b/addons/skin.estuary/xml/Variables.xml
index 21afe20..3e3b57a 100644
--- a/addons/skin.estuary/xml/Variables.xml
+++ b/addons/skin.estuary/xml/Variables.xml
@@ -1365,6 +1365,7 @@
 		<value>$VAR[AudioCodecVar]</value>
 	</variable>
 	<variable name="HadesOvDVOutVar">
+		<value condition="String.IsEqual(Window(Home).Property(hades.dv.state),native) + String.IsEqual(Window(Home).Property(hades.dv.transport),lowlatency)">$ADDON[skin.estuary 52860]</value>
 		<value condition="String.IsEqual(Window(Home).Property(hades.dv.state),native)">$ADDON[skin.estuary 52780]</value>
 		<value condition="String.IsEqual(Window(Home).Property(hades.dv.state),hdr10) + String.IsEqual(Window(Home).Property(hades.dv.hdr10plus),yes)">$ADDON[skin.estuary 52782]</value>
 		<value condition="String.IsEqual(Window(Home).Property(hades.dv.state),hdr10)">$ADDON[skin.estuary 52781]</value>
@@ -1376,6 +1377,7 @@
 		<value>$ADDON[skin.estuary 52796]</value>
 	</variable>
 	<variable name="HadesOvSignalVar">
+		<value condition="String.IsEqual(Window(Home).Property(hades.out.signal),dv) + String.IsEqual(Window(Home).Property(hades.dv.transport),lowlatency)">$ADDON[skin.estuary 52861]</value>
 		<value condition="String.IsEqual(Window(Home).Property(hades.out.signal),dv)">$ADDON[skin.estuary 52785]</value>
 		<value condition="String.IsEqual(Window(Home).Property(hades.out.signal),hdr10plus)">$ADDON[skin.estuary 52787]</value>
 		<value condition="String.IsEqual(Window(Home).Property(hades.out.signal),pq)">$ADDON[skin.estuary 52786]</value>
