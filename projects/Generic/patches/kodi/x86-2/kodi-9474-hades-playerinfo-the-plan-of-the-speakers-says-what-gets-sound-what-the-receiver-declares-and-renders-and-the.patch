+namespace
+{
+// Kodi's channel of a name ("FL", "SL"; AE_CH_NULL for any other)
+AEChannel ChannelOfName(const std::string& name)
+{
+  for (int ch = AE_CH_FL; ch < AE_CH_MAX; ++ch)
+    if (name == CAEChannelInfo::GetChName(static_cast<AEChannel>(ch)))
+      return static_cast<AEChannel>(ch);
+  return AE_CH_NULL;
+}
+
+// The channel names of a list in its order ("FL, FR, FC"), Kodi's channels only
+std::vector<std::string> ChannelNamesOf(const std::string& list)
+{
+  std::vector<std::string> names;
+  for (const std::string& part : StringUtils::Split(list, ","))
+  {
+    std::string name = part;
+    StringUtils::Trim(name);
+    if (ChannelOfName(name) != AE_CH_NULL &&
+        std::find(names.begin(), names.end(), name) == names.end())
+      names.push_back(name);
+  }
+  return names;
+}
+} // namespace
+
+void CWinSystemGbmGLESContext::SpeakerPlanInfo(std::map<std::string, std::string>& info,
+                                               const std::string& streamLit,
+                                               const std::string& streamChannels,
+                                               const std::string& codec) const
+{
+  namespace SP = KODI::UTILS::SPEAKER_PLAN;
+  const std::string& kind = info["hades.audio.path"];
+  const SP::Path path = kind == "bitstream" ? SP::Path::PASSTHROUGH
+                        : kind == "pcm"     ? SP::Path::DECODED
+                                            : SP::Path::NOT_KNOWN;
+  // what Hades sends, where it decodes: the layout that the sink was opened with
+  std::vector<std::string> sentNames;
+  AEAudioFormat sink;
+  IAE* ae = CServiceBroker::GetActiveAE();
+  if (path == SP::Path::DECODED && ae && ae->GetCurrentSinkFormat(sink))
+    for (unsigned int i = 0; i < sink.m_channelLayout.Count(); ++i)
+      sentNames.emplace_back(CAEChannelInfo::GetChName(sink.m_channelLayout[i]));
+  SP::Places sent;
+  for (const std::string& name : sentNames)
+    if (SP::IsKnownChannel(name))
+      sent.insert(name);
+  sent = SP::Positions(sent);
+
+  // what the display or receiver declares: the speaker allocation of the EDID of the display that
+  // Kodi shows on, where the sink opened the output of that display (its ELD names the same display)
+  std::optional<SP::Places> declared;
+  std::string why;
+  SP::EdidAudio edidAudio;
+  if (path != SP::Path::NOT_KNOWN)
+  {
+    uint64_t generation = 0;
+    const std::vector<KODI::UTILS::SoundOutput> outputs =
+        KODI::UTILS::CSoundOutputsInUse::Get(generation);
+    const auto opened = std::find_if(
+        outputs.begin(), outputs.end(), [](const KODI::UTILS::SoundOutput& o)
+        { return o.role.find("the output that the sink opened") != std::string::npos; });
+    const auto display = ShownDisplayInfo();
+    if (opened == outputs.end())
+      why = "notknown";
+    else if (opened->kind != KODI::UTILS::SoundOutput::Kind::DISPLAY)
+      why = "other";
+    else if (!display || !KODI::UTILS::SameDisplay(opened->identity,
+                                                   KODI::UTILS::IdentityOfEdid(display->Edid())))
+      why = "otherdisplay";
+    else
+    {
+      edidAudio = SP::AudioOfEdid(display->Edid());
+      const SP::Places places =
+          edidAudio.allocation ? SP::Declared(*edidAudio.allocation) : SP::Places{};
+      if (places.empty())
+        why = "none";
+      else
+      {
+        declared = places;
+        info["hades.audio.declby"] = DisplayModel();
+        std::string off;
+        for (const std::string& name : SP::DeclaredOffPlan(*edidAudio.allocation))
+          off += (off.empty() ? "" : ", ") + name;
+        info["hades.audio.declmore"] = off;
+      }
+    }
+  }
+  const SP::ObjectStream objects = SP::ObjectStreamOf(codec);
+  const SP::Plan plan = SP::PlanOf(path, SP::Positions(SP::Names(streamLit)), sent, declared,
+                                   objects, SP::ObjectsDeclared(edidAudio, objects));
+  info["hades.audio.spk"] = plan.sound;
+  info["hades.audio.spkobj"] = plan.objects;
+  info["hades.audio.spkdecl"] = plan.declared;
+  info["hades.audio.objects"] = plan.objectsSaid;
+  info["hades.audio.decl"] = declared ? SP::LayoutName(*declared) : "";
+  info["hades.audio.declwhy"] = why;
+  if (path != SP::Path::DECODED || sentNames.empty())
+    return;
+  // (by its layout: the plan shows where each channel goes)
+  info["hades.audio.sent"] = SP::LayoutName(sent);
+
+  // what the downmix folds: the matrix that libswresample builds for the decoder's layout and the
+  // sink's, with the levels that Kodi gives it (CActiveAEResampleFFMPEG::Init(): the centre and the
+  // surrounds at -3 dB, the LFE at audiooutput.mixsublevel, nothing where it is 0); which input goes
+  // into which output does not depend on the levels that are not 0
+  const std::vector<std::string> in = ChannelNamesOf(streamChannels);
+  bool folds = false;
+  for (const std::string& name : in)
+    folds |= std::find(sentNames.begin(), sentNames.end(), name) == sentNames.end();
+  if (!folds)
+    return;
+  std::vector<std::string> out;
+  uint64_t inMask = 0, outMask = 0;
+  for (const std::string& name : in)
+    inMask |= CAEUtil::GetAVChannelMask(ChannelOfName(name));
+  for (const std::string& name : sentNames)
+    if (ChannelOfName(name) != AE_CH_NULL &&
+        !(outMask & CAEUtil::GetAVChannelMask(ChannelOfName(name))))
+    {
+      outMask |= CAEUtil::GetAVChannelMask(ChannelOfName(name));
+      out.push_back(name);
+    }
+  AVChannelLayout inLayout = {}, outLayout = {};
+  if (av_channel_layout_from_mask(&inLayout, inMask) < 0 ||
+      av_channel_layout_from_mask(&outLayout, outMask) < 0)
+    return;
+  // (the names in the order of the layouts' channels, as the matrix has them)
+  const auto ordered = [](const AVChannelLayout& layout, const std::vector<std::string>& names)
+  {
+    std::vector<std::string> o;
+    for (int i = 0; i < layout.nb_channels; ++i)
+    {
+      const AVChannel ch = av_channel_layout_channel_from_index(&layout, i);
+      for (const std::string& n : names)
+        if (CAEUtil::GetAVChannel(ChannelOfName(n)) == ch)
+          o.push_back(n);
+    }
+    return o;
+  };
+  const std::vector<std::string> inOrdered = ordered(inLayout, in);
+  const std::vector<std::string> outOrdered = ordered(outLayout, out);
+  const auto component = CServiceBroker::GetSettingsComponent();
+  const auto settings = component ? component->GetSettings() : nullptr;
+  const double lfe =
+      settings ? settings->GetInt(CSettings::SETTING_AUDIOOUTPUT_MIXSUBLEVEL) / 100.0 : 0.0;
+  const std::size_t stride = static_cast<std::size_t>(inLayout.nb_channels);
+  std::vector<double> matrix(stride * static_cast<std::size_t>(outLayout.nb_channels));
+  const int built =
+      swr_build_matrix2(&inLayout, &outLayout, M_SQRT1_2, M_SQRT1_2, lfe, 1.0, 1.0, matrix.data(),
+                        static_cast<ptrdiff_t>(stride), AV_MATRIX_ENCODING_NONE, nullptr);
+  av_channel_layout_uninit(&inLayout);
+  av_channel_layout_uninit(&outLayout);
+  if (built < 0 || inOrdered.size() != stride || outOrdered.size() != out.size())
+    return;
+  std::string dropped;
+  info["hades.audio.fold"] = SP::Folded(inOrdered, outOrdered, matrix, stride, dropped);
+  info["hades.audio.folddrop"] = dropped;
+}
