diff --git a/xbmc/utils/SpeakerPlan.h b/xbmc/utils/SpeakerPlan.h
new file mode 100644
index 0000000..460f9b2
--- /dev/null
+++ b/xbmc/utils/SpeakerPlan.h
@@ -0,0 +1,488 @@
+/*
+ *  Copyright (C) 2026 Hades
+ *  This file is part of LibreELEC Hades. It is not in Kodi as Team Kodi publishes it.
+ *
+ *  SPDX-License-Identifier: GPL-2.0-or-later
+ *  See LICENSES/README.md for more information.
+ */
+
+#pragma once
+
+#include <array>
+#include <cstddef>
+#include <cstdint>
+#include <optional>
+#include <set>
+#include <span>
+#include <string>
+#include <vector>
+
+/*!
+ * \brief Hades: the plan of the speakers of the player information (its Audio page): what is true of
+ *        each speaker, from where it is known
+ *
+ * Each place of the plan shows one of four things, in this order:
+ * - sound: the stream's bed or channels use it (passed through to the receiver: what the player says
+ *   of the stream, KODI::UTILS::PLAYERINFO::Speakers()), or a channel that Hades sends it (decoded:
+ *   the layout that the audio engine's sink was opened with). A filled disc.
+ * - objects: Dolby Atmos passed through to a receiver that declares it, which renders the objects to
+ *   every speaker it has: a speaker that it declares beyond the bed. A ring in the colour of sound.
+ * - declared: the display or receiver declares the speaker, and nothing is sent to it. A grey ring.
+ * - nothing known of it: the faint ring of the plan, or nothing.
+ *
+ * What a display or receiver declares is its Speaker Allocation Data Block (CTA-861), read from the
+ * EDID of the display that Kodi shows on, where the sound goes to that display: the ELD of the
+ * sound card carries its first byte alone (the kernel's drm_edid_to_eld(): eld[DRM_ELD_SPEAKER] =
+ * data[0]), no height, and the HDA HDMI codec shows a display that declares none as having every
+ * speaker (0xffff). The bits as edid-decode (v4l-utils 1.32.0, parse-cta-block.cpp,
+ * cta_speaker_map[]) and libdisplay-info 0.4.0 (cta.c, parse_speaker_alloc()) read them:
+ * - byte 1: FL/FR, LFE1, FC, BL/BR (RL/RR before CTA-861-G), BC, FLc/FRc, RLC/RRC (deprecated),
+ *   FLw/FRw;
+ * - byte 2: TpFL/TpFR, TpC, TpFC, LS/RS, LFE2, TpBC, SiL/SiR, TpSiL/TpSiR;
+ * - byte 3: TpBL/TpBR, BtFC, BtFL/BtFR, TpLS/TpRS (deprecated), LSd/RSd.
+ * A receiver of CTA-861-D declares 5.1 as FL/FR, LFE, FC, RL/RR and 7.1 with RLC/RRC as well (the
+ * channel allocation of HDMI's PCM carries 7.1 so): RL/RR are its surrounds then, RLC/RRC its backs.
+ * Where LS/RS or SiL/SiR are declared, those are the surrounds and BL/BR the backs.
+ *
+ * Kodi's channels name a 5.1 surround pair BL/BR or SL/SR as its decoder has them: on the plan both
+ * are the surrounds (SL/SR), and BL/BR the backs only where the sides are there too.
+ *
+ * Pure: a host test runs it on real and made EDIDs (speakers_test.cpp).
+ */
+namespace KODI::UTILS::SPEAKER_PLAN
+{
+
+using Places = std::set<std::string>;
+
+//! The Speaker Allocation Data Block of an EDID: its three bytes (a shorter one padded with 0)
+struct Allocation
+{
+  std::array<uint8_t, 3> bytes{};
+};
+
+//! What an EDID declares of object-based sound, in its short audio descriptors
+enum class Objects
+{
+  NOT_DECLARED,
+  DECLARED,
+  NOT_KNOWN, //!< the descriptor carries no bit for it that is verified here
+};
+
+//! The audio of an EDID that the plan needs
+struct EdidAudio
+{
+  bool read = false; //!< a CTA-861 extension with data blocks was read
+  std::optional<Allocation> allocation; //!< its speaker allocation, where it has one
+  //! E-AC-3 with Joint Object Coding (Dolby Atmos over Dolby Digital Plus): the third byte of its
+  //! descriptor, bit 0 ("Dolby Audio and Dolby Atmos over HDMI", as edid-decode reads it)
+  bool eac3Joc = false;
+  //! MAT (MLP): Dolby TrueHD with object audio PCM, bit 0 of the third byte (edid-decode); a MAT
+  //! descriptor without it takes Dolby TrueHD alone
+  bool matObjects = false;
+  bool eac3 = false; //!< an E-AC-3 descriptor
+  bool mat = false; //!< a MAT descriptor
+};
+
+/*!
+ * \brief The audio of an EDID: the first speaker allocation, and the descriptors of E-AC-3 and
+ *        MAT, of its CTA-861 extensions (revision 3 and later, as the kernel reads them)
+ */
+inline EdidAudio AudioOfEdid(std::span<const uint8_t> edid)
+{
+  constexpr std::size_t BLOCK = 128;
+  EdidAudio audio;
+  for (std::size_t at = BLOCK; at + BLOCK <= edid.size(); at += BLOCK)
+  {
+    const std::span<const uint8_t> b = edid.subspan(at, BLOCK);
+    if (b[0] != 0x02 || b[1] < 3 || b[2] < 4 || b[2] > BLOCK - 1)
+      continue;
+    audio.read = true;
+    for (std::size_t i = 4; i < b[2];)
+    {
+      const unsigned int tag = b[i] >> 5;
+      const std::size_t length = b[i] & 0x1F;
+      if (i + 1 + length > b[2])
+        break;
+      if (tag == 4 && length >= 1 && !audio.allocation)
+      {
+        Allocation a;
+        for (std::size_t k = 0; k < 3 && k < length; ++k)
+          a.bytes[k] = b[i + 1 + k];
+        audio.allocation = a;
+      }
+      else if (tag == 1)
+      {
+        for (std::size_t s = i + 1; s + 3 <= i + 1 + length; s += 3)
+        {
+          const unsigned int format = (b[s] >> 3) & 0xF;
+          if (format == 10)
+          {
+            audio.eac3 = true;
+            audio.eac3Joc |= (b[s + 2] & 0x01) != 0;
+          }
+          else if (format == 12)
+          {
+            audio.mat = true;
+            audio.matObjects |= (b[s + 2] & 0x01) != 0;
+          }
+        }
+      }
+      i += 1 + length;
+    }
+  }
+  return audio;
+}
+
+inline bool Bit(const Allocation& a, int byte, int bit)
+{
+  return (a.bytes[byte] >> bit) & 1;
+}
+
+/*!
+ * \brief The places of the plan that an allocation declares: FL FR FC FLOC FROC LFE SL SR BL BR BC
+ *        TFL TFC TFR TC TSL TSR TBL TBC TBR (TSL/TSR: the top middle, TpSiL/TpSiR; the deprecated
+ *        TpLS/TpRS too)
+ */
+inline Places Declared(const Allocation& a)
+{
+  Places p;
+  const auto pair = [&p](const char* l, const char* r)
+  {
+    p.insert(l);
+    p.insert(r);
+  };
+  if (Bit(a, 0, 0))
+    pair("FL", "FR");
+  if (Bit(a, 0, 1) || Bit(a, 1, 4))
+    p.insert("LFE");
+  if (Bit(a, 0, 2))
+    p.insert("FC");
+  if (Bit(a, 0, 4))
+    p.insert("BC");
+  if (Bit(a, 0, 5))
+    pair("FLOC", "FROC");
+  const bool rlrr = Bit(a, 0, 3);
+  const bool rlcrrc = Bit(a, 0, 6);
+  const bool sides = Bit(a, 1, 3) || Bit(a, 1, 6);
+  if (sides)
+  {
+    pair("SL", "SR");
+    if (rlrr || rlcrrc)
+      pair("BL", "BR");
+  }
+  else
+  {
+    if (rlrr)
+      pair("SL", "SR");
+    if (rlcrrc)
+      pair("BL", "BR");
+  }
+  if (Bit(a, 1, 0))
+    pair("TFL", "TFR");
+  if (Bit(a, 1, 1))
+    p.insert("TC");
+  if (Bit(a, 1, 2))
+    p.insert("TFC");
+  if (Bit(a, 1, 5))
+    p.insert("TBC");
+  if (Bit(a, 1, 7) || Bit(a, 2, 3))
+    pair("TSL", "TSR");
+  if (Bit(a, 2, 0))
+    pair("TBL", "TBR");
+  return p;
+}
+
+//! The speakers that an allocation declares and the plan has no place for (CTA-861's names)
+inline std::vector<std::string> DeclaredOffPlan(const Allocation& a)
+{
+  std::vector<std::string> off;
+  if (Bit(a, 0, 7))
+    off.emplace_back("FLw/FRw");
+  if (Bit(a, 1, 4))
+    off.emplace_back("LFE2");
+  if (Bit(a, 2, 1))
+    off.emplace_back("BtFC");
+  if (Bit(a, 2, 2))
+    off.emplace_back("BtFL/BtFR");
+  if (Bit(a, 2, 4))
+    off.emplace_back("LSd/RSd");
+  return off;
+}
+
+inline bool IsTop(const std::string& place)
+{
+  return place.size() > 1 && place[0] == 'T';
+}
+
+/*!
+ * \brief The layout of places as the number of floor speakers, of LFE and of heights ("5.1.2",
+ *        "7.1"; "2.0"); empty for none
+ */
+inline std::string LayoutName(const Places& places)
+{
+  int floor = 0, lfe = 0, top = 0;
+  for (const std::string& p : places)
+  {
+    if (p == "LFE")
+      lfe = 1;
+    else if (IsTop(p))
+      ++top;
+    else
+      ++floor;
+  }
+  if (floor + lfe + top == 0)
+    return "";
+  std::string name = std::to_string(floor) + "." + std::to_string(lfe);
+  if (top > 0)
+    name += "." + std::to_string(top);
+  return name;
+}
+
+/*!
+ * \brief The places of Kodi's channel names (FL FR FC LFE BL BR FLOC FROC BC SL SR TFL TFR TFC TC
+ *        TBL TBR TBC BLOC BROC) on the plan: a surround pair named BL/BR without SL/SR is the
+ *        surrounds (SL/SR); BLOC/BROC, where they come with BL/BR, the backs
+ */
+inline Places Positions(const Places& names)
+{
+  Places p;
+  const bool sides = names.count("SL") || names.count("SR");
+  for (const std::string& n : names)
+  {
+    if ((n == "BL" || n == "BR") && !sides)
+      p.insert(n == "BL" ? "SL" : "SR");
+    else if (n == "BLOC" || n == "BROC")
+      p.insert(n == "BLOC" ? "BL" : "BR");
+    else
+      p.insert(n);
+  }
+  return p;
+}
+
+//! Two names of a left and right pair (BL and BR, TFL and TFR, FLOC and FROC)
+inline bool IsPair(const std::string& a, const std::string& b)
+{
+  if (a.size() != b.size())
+    return false;
+  int differ = 0;
+  for (std::size_t i = 0; i < a.size(); ++i)
+    if (a[i] != b[i])
+    {
+      if (!((a[i] == 'L' && b[i] == 'R') || (a[i] == 'R' && b[i] == 'L')))
+        return false;
+      ++differ;
+    }
+  return differ == 1;
+}
+
+//! Kodi's channel names that the plan places (Positions()); others (UNKNOWN1, ...) are not drawn
+inline bool IsKnownChannel(const std::string& name)
+{
+  static const Places known{"FL",  "FR",  "FC",  "LFE", "BL",  "BR",  "FLOC", "FROC", "BC",  "SL",
+                            "SR",  "TFL", "TFR", "TFC", "TC",  "TBL", "TBR",  "TBC",  "BLOC", "BROC"};
+  return known.count(name) > 0;
+}
+
+//! Names from a list in any separator (";FL;FR;", "FL,FR", "FL, FR"), upper case
+inline Places Names(const std::string& list)
+{
+  Places names;
+  std::string token;
+  const auto flush = [&]()
+  {
+    if (!token.empty())
+      names.insert(token);
+    token.clear();
+  };
+  for (const char c : list)
+  {
+    if ((c >= 'A' && c <= 'Z') || (c >= '0' && c <= '9'))
+      token += c;
+    else if (c >= 'a' && c <= 'z')
+      token += static_cast<char>(c - 'a' + 'A');
+    else
+      flush();
+  }
+  flush();
+  return names;
+}
+
+//! ";A;B;" (a semicolon at each end, as the skin tests a name), empty for none
+inline std::string Lit(const Places& places)
+{
+  if (places.empty())
+    return "";
+  std::string out = ";";
+  for (const std::string& p : places)
+    out += p + ";";
+  return out;
+}
+
+//! Stream formats whose objects a receiver renders
+enum class ObjectStream
+{
+  NONE,
+  ATMOS_EAC3, //!< Dolby Digital Plus with Joint Object Coding
+  ATMOS_TRUEHD, //!< Dolby TrueHD with Atmos
+  DTSX, //!< DTS:X
+};
+
+//! The object format of a stream by its codec as VideoPlayer.AudioCodec has it
+inline ObjectStream ObjectStreamOf(const std::string& codec)
+{
+  if (codec == "eac3_ddp_atmos")
+    return ObjectStream::ATMOS_EAC3;
+  if (codec == "truehd_atmos")
+    return ObjectStream::ATMOS_TRUEHD;
+  if (codec == "dtshd_ma_x" || codec == "dtshd_ma_x_imax")
+    return ObjectStream::DTSX;
+  return ObjectStream::NONE;
+}
+
+//! Whether the EDID declares that its sink renders the objects of that format
+inline Objects ObjectsDeclared(const EdidAudio& audio, ObjectStream stream)
+{
+  switch (stream)
+  {
+    case ObjectStream::ATMOS_EAC3:
+      return audio.eac3Joc ? Objects::DECLARED : Objects::NOT_DECLARED;
+    case ObjectStream::ATMOS_TRUEHD:
+      return audio.matObjects ? Objects::DECLARED : Objects::NOT_DECLARED;
+    case ObjectStream::DTSX:
+      // (bit 1 of the third byte of a DTS-HD descriptor, which edid-decode reads as DTS:X from
+      // reverse engineering: not verified, so not taken)
+      return Objects::NOT_KNOWN;
+    default:
+      return Objects::NOT_DECLARED;
+  }
+}
+
+//! Where the sound goes, as the plan needs it
+enum class Path
+{
+  NOT_KNOWN, //!< no sink open, or not known: what the stream has
+  PASSTHROUGH, //!< the stream as it is, to the receiver
+  DECODED, //!< PCM that Hades sends
+};
+
+//! What the plan says
+struct Plan
+{
+  std::string sound; //!< the places that get sound (Lit())
+  std::string objects; //!< the places the receiver renders objects to, beyond the bed
+  std::string declared; //!< the places declared, which get nothing
+  //! the receiver renders the objects: "yes" (to the places in objects, heights included),
+  //! "noheights" (it declares Atmos and no speaker beyond the bed), "notdeclared" (it does not
+  //! declare the stream's object format: it plays the bed), "notknown" (DTS:X, or its speakers
+  //! not known); empty for a stream without objects, or one not passed through
+  std::string objectsSaid;
+};
+
+/*!
+ * \param stream the places of the stream's bed or channels (Positions())
+ * \param sent the places of the channels that Hades sends, where it decodes (Positions())
+ * \param declared the places that the display or receiver declares, where known
+ */
+inline Plan PlanOf(Path path,
+                   const Places& stream,
+                   const Places& sent,
+                   const std::optional<Places>& declared,
+                   ObjectStream objects,
+                   Objects objectsDeclared)
+{
+  Plan plan;
+  const Places& sound = path == Path::DECODED ? sent : stream;
+  plan.sound = Lit(sound);
+  const bool passedObjects = path == Path::PASSTHROUGH && objects != ObjectStream::NONE;
+  const bool rendered = passedObjects && declared && objectsDeclared == Objects::DECLARED;
+  Places obj, decl;
+  if (declared)
+    for (const std::string& p : *declared)
+    {
+      if (sound.count(p))
+        continue;
+      (rendered ? obj : decl).insert(p);
+    }
+  plan.objects = Lit(obj);
+  plan.declared = Lit(decl);
+  if (passedObjects)
+    plan.objectsSaid = !declared || objectsDeclared == Objects::NOT_KNOWN ? "notknown"
+                       : objectsDeclared != Objects::DECLARED             ? "notdeclared"
+                       : obj.empty()                                      ? "noheights"
+                                                                          : "yes";
+  return plan;
+}
+
+/*!
+ * \brief What a downmix folds into what: for each channel of the input that the output does not
+ *        have, the output channels that it goes into, by a matrix as libswresample builds it
+ *        (swr_build_matrix2(): matrix[out * stride + in], the weight of input in in output out)
+ * \return "BL+BR > SL+SR; FC > FL+FR" in Kodi's channel names; dropped, the channels that go
+ *         nowhere ("LFE")
+ */
+inline std::string Folded(const std::vector<std::string>& in,
+                          const std::vector<std::string>& out,
+                          const std::vector<double>& matrix,
+                          std::size_t stride,
+                          std::string& dropped)
+{
+  dropped.clear();
+  struct Fold
+  {
+    std::vector<std::string> from;
+    std::vector<std::string> to;
+  };
+  std::vector<Fold> folds;
+  for (std::size_t i = 0; i < in.size(); ++i)
+  {
+    bool kept = false;
+    for (const std::string& o : out)
+      kept |= o == in[i];
+    if (kept)
+      continue;
+    std::vector<std::string> to;
+    for (std::size_t o = 0; o < out.size(); ++o)
+      if (o * stride + i < matrix.size() && matrix[o * stride + i] != 0.0)
+        to.push_back(out[o]);
+    if (to.empty())
+    {
+      dropped += (dropped.empty() ? "" : ", ") + in[i];
+      continue;
+    }
+    // (channels that go into the same outputs, together: BL+BR > SL+SR)
+    bool joined = false;
+    for (Fold& f : folds)
+    {
+      // a left and right pair that goes into a left and right pair, each into its side
+      if (f.from.size() == 1 && f.to.size() == 1 && to.size() == 1 && IsPair(f.from[0], in[i]) &&
+          IsPair(f.to[0], to[0]))
+      {
+        f.from.push_back(in[i]);
+        f.to.push_back(to[0]);
+        joined = true;
+        break;
+      }
+      if (f.to == to)
+      {
+        f.from.push_back(in[i]);
+        joined = true;
+        break;
+      }
+    }
+    if (!joined)
+      folds.push_back({{in[i]}, to});
+  }
+  std::string text;
+  for (const Fold& f : folds)
+  {
+    std::string from, to;
+    for (const std::string& n : f.from)
+      from += (from.empty() ? "" : "+") + n;
+    for (const std::string& n : f.to)
+      to += (to.empty() ? "" : "+") + n;
+    text += (text.empty() ? "" : "; ") + from + " > " + to;
+  }
+  return text;
+}
+
+} // namespace KODI::UTILS::SPEAKER_PLAN
