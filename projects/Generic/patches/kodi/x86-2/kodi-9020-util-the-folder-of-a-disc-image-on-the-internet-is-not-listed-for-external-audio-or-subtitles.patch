From ab5db7583f490e5f6664e408c3f06dca0a79a6c8 Mon Sep 17 00:00:00 2001
From: Hades <15710513+hadesdevls@users.noreply.github.com>
Date: Wed, 18 Nov 2026 03:36:46 +0000
Subject: [PATCH] Util: the folder of a disc image on the internet is not
 listed for external audio or subtitles

CUtil::ScanForExternalAudio() and ScanForExternalSubtitles() look in the
folder of a video for files of the same name, except for a video on the
internet. A disc played from its playlist has a bluray:// path, which is not
an internet stream, so the folder of its image was listed even when the image
is on a web server: a streaming CDN answers the folder of a file with an error,
while the player holds the one or two connections it allows to the file.
Measured in a VM, a Blu-ray image from a CDN-like server: two listings of the
folder of the image at every start, each answered 404.

Now a disc whose image (or folder) is on a web server that is not on this
network is taken as any other video on the internet: nothing beside it is
listed, and one INFO line says so. A disc on this network, or on a local disk,
is as before.
Measured after: no listing, and the two INFO lines at every start.
---
 xbmc/Util.cpp | 33 +++++++++++++++++++++++++++++++++
 1 file changed, 33 insertions(+)

diff --git a/xbmc/Util.cpp b/xbmc/Util.cpp
index c6e8544..ea8e0ab 100644
--- a/xbmc/Util.cpp
+++ b/xbmc/Util.cpp
@@ -35,6 +35,7 @@
 #include "URL.h"
 #include "filesystem/Directory.h"
 #include "filesystem/File.h"
+#include "filesystem/HttpSourceMemory.h"
 #include "filesystem/SpecialProtocol.h"
 #include "utils/StringUtils.h"
 #include "utils/URIUtils.h"
@@ -2125,6 +2126,22 @@ bool IsDiscExtrasOwnFile(const std::string& file,
   return std::ranges::any_of(ownNames, [&name](const std::string& own)
                              { return StringUtils::StartsWithNoCase(name, own); });
 }
+
+/*!
+ * Hades: the image (or folder) of a disc played from its playlist (a bluray:// path) is on a web
+ * server that is not on this network: the folder beside it is not listed for external audio or
+ * subtitles, as for any other video on the internet. The bluray:// path itself is not an internet
+ * stream, so the folder of the image was listed: a Debrid CDN answers that with an error, while the
+ * player holds the one or two connections it allows to the file (measured in a VM: two listings of
+ * the folder of the image at every start, each answered 404).
+ */
+bool IsDiscOnTheInternet(const std::string& videoPath)
+{
+  if (!URIUtils::IsBlurayPath(videoPath))
+    return false;
+  const std::string disc{URIUtils::GetDiscFile(videoPath)};
+  return URIUtils::IsInternetStream(disc) && !URIUtils::IsOnLAN(disc);
+}
 } // namespace
 
 std::vector<std::string> CUtil::GetVersionFileNames(const std::string& videoPath,
@@ -2227,6 +2244,14 @@ void CUtil::ScanForExternalSubtitles(const std::string& strMovie,
   if ((isInternetStream && !isOnLAN) || (!isStrmAnchor && isPlayList) || isPvr ||
       (!isStrmAnchor && !isVideo))
     return;
+  if (IsDiscOnTheInternet(strMovie))
+  {
+    CLog::Log(LOGINFO,
+              "CUtil::ScanForExternalSubtitles - the disc {} is on the internet: no folder beside "
+              "it is looked in for subtitles",
+              XFILE::CHttpSourceMemory::ShortForLog(URIUtils::GetDiscFile(strMovie)));
+    return;
+  }
 
   CLog::Log(LOGDEBUG, "{}: Searching for subtitles...", __FUNCTION__);
 
@@ -2582,6 +2607,14 @@ void CUtil::ScanForExternalAudio(const std::string& videoPath,
   if (NETWORK::IsInternetStream(item) || PLAYLIST::IsPlayList(item) || item.IsLiveTV() ||
       item.IsPVR() || !VIDEO::IsVideo(item))
     return;
+  if (IsDiscOnTheInternet(videoPath))
+  {
+    CLog::Log(LOGINFO,
+              "CUtil::ScanForExternalAudio - the disc {} is on the internet: no folder beside it "
+              "is looked in for audio",
+              XFILE::CHttpSourceMemory::ShortForLog(URIUtils::GetDiscFile(videoPath)));
+    return;
+  }
 
   // What the caller passes in, such as the video itself ahead of its audio, is kept as it is
   const auto passedIn{static_cast<std::ptrdiff_t>(vecAudio.size())};
