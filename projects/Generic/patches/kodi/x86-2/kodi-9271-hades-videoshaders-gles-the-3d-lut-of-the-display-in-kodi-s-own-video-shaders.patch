diff --git a/system/shaders/GLES/2.0/gles_lut3d.frag b/system/shaders/GLES/2.0/gles_lut3d.frag
new file mode 100644
index 0000000..f012e7a
--- /dev/null
+++ b/system/shaders/GLES/2.0/gles_lut3d.frag
@@ -0,0 +1,98 @@
+// Hades: the 3D LUT of the display (videoscreen.hadeslut3d*, windowing/gbm/DisplayLut.h), the last step of the colour
+// of a picture that Kodi's renderer draws itself, as the bridge applies it to those it maps (dvbridge_lut_shader()).
+// Put into a shader only where a LUT is applied (VideoShaders/Lut3dGLES.h): without one, every shader is the one before,
+// to the byte. GLSL ES 1.00 has no 3D texture: the table is a 2D texture of 32-bit floats that holds the N slices of
+// blue side by side (tools/dvbridge/dvbridge_lut_atlas.h), read at the centres of its texels and interpolated over the
+// six tetrahedra of a cube, as libplacebo's pl_shader_custom_lut(); in highp, whatever the precision of the shader.
+#if __VERSION__ >= 300
+#define KODI_LUT3D_TEXTURE texture
+#elif defined(GL_FRAGMENT_PRECISION_HIGH)
+#define KODI_LUT3D_TEXTURE texture2D
+#else
+#error "the 3D LUT is read and interpolated in highp, which this GPU does not have in a fragment shader"
+#endif
+
+uniform highp sampler2D m_lut3d;
+// N - 1 (N: points a side), slices a row of the texture, 1 / its width, 1 / its height
+uniform highp vec4 m_lut3dGrid;
+// the signal in full range to the input range of the LUT: scale, offset
+uniform highp vec2 m_lut3dIn;
+// a .3dl of Nuke's shaper: knee, (N - 2) / knee, N - 2, 1 / (1 - knee); a knee of 0: a uniform grid
+uniform highp vec4 m_lut3dShaper;
+// the output range of the LUT back to full: scale, offset
+uniform highp vec2 m_lut3dOut;
+// the range of the picture's signal (full: 1, 0; limited: 876 / 1023, 64 / 1023), and whether the LUT is applied
+// (0: a picture drawn elsewhere than into the window)
+uniform highp vec3 m_lut3dSignal;
+
+// the value of the LUT at grid point i (integers)
+highp vec3 KodiLut3dAt(highp vec3 i)
+{
+  highp float n = m_lut3dGrid.x + 1.0;
+  highp float row = floor((i.b + 0.5) / m_lut3dGrid.y);
+  highp float col = i.b - row * m_lut3dGrid.y;
+  highp vec2 at = vec2(col * n + i.r + 0.5, row * n + i.g + 0.5) * m_lut3dGrid.zw;
+  return KODI_LUT3D_TEXTURE(m_lut3d, at).rgb;
+}
+
+highp vec3 KodiLut3d(highp vec3 signal)
+{
+  if (m_lut3dSignal.z < 0.5)
+    return signal;
+  // the signal in full range within [0, 1], to the input range of the LUT; an output of limited range carries what is
+  // below its black and above its white (to 0 and 1023 of 1023), which goes on beside the LUT, as far from its black and
+  // white as it was (an output of full range holds it at 0 and 1 itself)
+  highp vec3 full = (signal - vec3(m_lut3dSignal.y)) / m_lut3dSignal.x;
+  highp vec3 c = clamp(full, 0.0, 1.0);
+  highp vec3 beyond = m_lut3dSignal.x < 1.0 ? full - c : vec3(0.0);
+  c = c * m_lut3dIn.x + m_lut3dIn.y;
+  // ... to the grid: uniform, or Nuke's shaper (N - 2 steps up to the knee, one after it)
+  highp vec3 p;
+  if (m_lut3dShaper.x > 0.0)
+  {
+    highp vec3 u = clamp(c, 0.0, 1.0);
+    highp vec3 below = u * m_lut3dShaper.y;
+    highp vec3 above = vec3(m_lut3dShaper.z) + (u - vec3(m_lut3dShaper.x)) * m_lut3dShaper.w;
+    p.r = u.r > m_lut3dShaper.x ? above.r : below.r;
+    p.g = u.g > m_lut3dShaper.x ? above.g : below.g;
+    p.b = u.b > m_lut3dShaper.x ? above.b : below.b;
+    p = clamp(p, 0.0, m_lut3dGrid.x);
+  }
+  else
+    p = clamp(c, 0.0, 1.0) * m_lut3dGrid.x;
+  // the cube of p and where p is in it, and the tetrahedron: the steps along the axes in the order of the fractions,
+  // the largest first
+  highp vec3 base = min(floor(p), vec3(m_lut3dGrid.x - 1.0));
+  highp vec3 f = p - base;
+  highp vec3 c0 = KodiLut3dAt(base);
+  highp vec3 c3 = KodiLut3dAt(base + vec3(1.0));
+  highp vec3 v;
+  if (f.r >= f.g)
+  {
+    if (f.g >= f.b)
+      v = (1.0 - f.r) * c0 + (f.r - f.g) * KodiLut3dAt(base + vec3(1.0, 0.0, 0.0)) +
+          (f.g - f.b) * KodiLut3dAt(base + vec3(1.0, 1.0, 0.0)) + f.b * c3;
+    else if (f.r >= f.b)
+      v = (1.0 - f.r) * c0 + (f.r - f.b) * KodiLut3dAt(base + vec3(1.0, 0.0, 0.0)) +
+          (f.b - f.g) * KodiLut3dAt(base + vec3(1.0, 0.0, 1.0)) + f.g * c3;
+    else
+      v = (1.0 - f.b) * c0 + (f.b - f.r) * KodiLut3dAt(base + vec3(0.0, 0.0, 1.0)) +
+          (f.r - f.g) * KodiLut3dAt(base + vec3(1.0, 0.0, 1.0)) + f.g * c3;
+  }
+  else
+  {
+    if (f.b >= f.g)
+      v = (1.0 - f.b) * c0 + (f.b - f.g) * KodiLut3dAt(base + vec3(0.0, 0.0, 1.0)) +
+          (f.g - f.r) * KodiLut3dAt(base + vec3(0.0, 1.0, 1.0)) + f.r * c3;
+    else if (f.b >= f.r)
+      v = (1.0 - f.g) * c0 + (f.g - f.b) * KodiLut3dAt(base + vec3(0.0, 1.0, 0.0)) +
+          (f.b - f.r) * KodiLut3dAt(base + vec3(0.0, 1.0, 1.0)) + f.r * c3;
+    else
+      v = (1.0 - f.g) * c0 + (f.g - f.r) * KodiLut3dAt(base + vec3(0.0, 1.0, 0.0)) +
+          (f.r - f.b) * KodiLut3dAt(base + vec3(1.0, 1.0, 0.0)) + f.b * c3;
+  }
+  // the output of the LUT back to full range within [0, 1], and to the range of the picture's signal
+  v = clamp(v * m_lut3dOut.x + m_lut3dOut.y, 0.0, 1.0);
+  return (v + beyond) * m_lut3dSignal.x + vec3(m_lut3dSignal.y);
+}
+
