From 4e574f0713326b9013d8cc65598c94a10bda2f16 Mon Sep 17 00:00:00 2001
From: Hades <15710513+hadesdevls@users.noreply.github.com>
Date: Thu, 26 Nov 2026 18:49:12 +0000
Subject: [PATCH] [Hades][dvbridge] kodi.log says where the passes of the IPT
 tunnel could not be made

Where the GPU could not make the passes of the IPT tunnel (or the filter
of its chroma is not the one its shaders hold), a picture of the source
transport goes out as composed, in YCbCr, when the tunnel is chosen. The
bridge said so on its standard error, and kodi.log said instead that the
conversion was made by the fragment passes, as where only the compute
pass could not be made.

dvbridge_render_can_ipt() says whether the passes were made, and
kodi.log now says, as a warning, that the pictures go out as composed
where the tunnel is chosen. Where they were made, kodi.log says what it
said before: which pass converts the pictures.

Checked on Mesa's software OpenGL ES: with the passes made, the getter
says so and the pictures are converted; with the weights of the filter
changed in a copy of the bridge, it says they were not made and the
pictures go out as composed.
---
 tools/dvbridge/dvbridge_render.c                       | 5 +++++
 tools/dvbridge/dvbridge_render.h                       | 5 +++++
 xbmc/cores/VideoPlayer/VideoRenderers/DVBridgeGLES.cpp | 9 +++++++--
 3 files changed, 17 insertions(+), 2 deletions(-)

diff --git a/tools/dvbridge/dvbridge_render.c b/tools/dvbridge/dvbridge_render.c
index 285cfea..e14256a 100644
--- a/tools/dvbridge/dvbridge_render.c
+++ b/tools/dvbridge/dvbridge_render.c
@@ -4317,6 +4317,11 @@ bool dvbridge_render_ipt_computed(const struct dvbridge_renderer *r)
     return dvbridge_render_ipt(r) && dvbridge_source_ipt_computed(r->source_packer);
 }
 
+bool dvbridge_render_can_ipt(const struct dvbridge_renderer *r)
+{
+    return r && dvbridge_source_can_ipt(r->source_packer);
+}
+
 unsigned dvbridge_render_source_quad(const struct dvbridge_renderer *r)
 {
     return r ? dvbridge_source_quad(r->source_packer) : 0u;
diff --git a/tools/dvbridge/dvbridge_render.h b/tools/dvbridge/dvbridge_render.h
index a936ade..434b80a 100644
--- a/tools/dvbridge/dvbridge_render.h
+++ b/tools/dvbridge/dvbridge_render.h
@@ -683,6 +683,11 @@ bool dvbridge_render_compute_rows_usable(const struct dvbridge_renderer *rendere
 #define DVBRIDGE_RENDER_COMPUTE_IPT 1
 bool dvbridge_render_compute_ipt_usable(const struct dvbridge_renderer *renderer);
 bool dvbridge_render_ipt_computed(const struct dvbridge_renderer *renderer);
+/* Hades: whether the passes of the IPT tunnel were made on this GPU at all
+ * (dvbridge_source_can_ipt()); without them, a picture of the source transport goes out as composed
+ * where the tunnel is asked for */
+#define DVBRIDGE_RENDER_CAN_IPT 1
+bool dvbridge_render_can_ipt(const struct dvbridge_renderer *renderer);
 /* Hades: which forms of pass 4 of the source transport take the even pixel's codes of a pair drawn
  * over from the invocation next to it (dvbridge_source_quad(): bit 1, the GUI read in place; bit 0,
  * the composited picture, is never set); 0 without quad operations, and in the reference of a check
diff --git a/xbmc/cores/VideoPlayer/VideoRenderers/DVBridgeGLES.cpp b/xbmc/cores/VideoPlayer/VideoRenderers/DVBridgeGLES.cpp
index 5215a62..856520d 100644
--- a/xbmc/cores/VideoPlayer/VideoRenderers/DVBridgeGLES.cpp
+++ b/xbmc/cores/VideoPlayer/VideoRenderers/DVBridgeGLES.cpp
@@ -653,8 +653,13 @@ bool CDVBridgeGLES::Initialize(bool allowSoftware)
                          "unless it fails on this GPU, which the log then says");
     }
     // Hades: and the conversion of the IPT tunnel (where it is chosen) by one compute pass that
-    // takes each pixel once, where the fragment passes take the left pixel of a pair twice
-    if (computeRows && dvbridge_render_compute_ipt_usable(m_renderer))
+    // takes each pixel once, where the fragment passes take the left pixel of a pair twice; or
+    // by neither, where its passes could not be made on this GPU (then the pictures go out as
+    // composed, in YCbCr)
+    if (!dvbridge_render_can_ipt(m_renderer))
+      CLog::Log(LOGWARNING, "DVBridge: the passes of the IPT tunnel could not be made on this GPU: "
+                            "where it is chosen, the pictures go out as composed (YCbCr)");
+    else if (computeRows && dvbridge_render_compute_ipt_usable(m_renderer))
     {
       m_computeIptSaid = true;
       CLog::Log(LOGINFO, "DVBridge: the conversion of the IPT tunnel, where it is chosen, is made by a "
-- 
2.53.0

