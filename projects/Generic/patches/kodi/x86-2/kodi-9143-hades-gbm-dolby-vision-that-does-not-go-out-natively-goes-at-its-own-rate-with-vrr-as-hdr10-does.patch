 #ifdef HAVE_DVBRIDGE
 #include "cores/VideoPlayer/DVDCodecs/Video/DVPlaybackPolicy.h"
 #include "windowing/gbm/WinSystemGbm.h"
@@ -126,8 +127,9 @@ RESOLUTION CResolutionUtils::ChooseBestResolution(float fps,
