+bool DVBRIDGE::StreamOutputMayBeHlg()
+{
+  // (VideoStreamOpened() sets these before Kodi chooses the mode of the stream)
+  return g_dvStreamHlg ||
+         BaseLayerTransferOf(g_dvStreamProfile, g_dvStreamCompatibility) == BASE_LAYER_HLG;
+}
+
 void DVBRIDGE::VideoStreamOpened(const CDVDStreamInfo& stream)
 {
   g_dvStreamProfile = static_cast<int>(stream.dovi.dv_profile);
