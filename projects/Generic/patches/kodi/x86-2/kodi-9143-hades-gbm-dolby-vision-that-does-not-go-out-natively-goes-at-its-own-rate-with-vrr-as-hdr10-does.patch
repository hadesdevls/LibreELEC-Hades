   {
     RESOLUTION gui = res;
     if (CServiceBroker::GetWinSystem()->TakeVideoAtOwnRate(fps, is3D, nativeDV, progressive, video,
diff --git a/xbmc/windowing/gbm/VrrVideo.h b/xbmc/windowing/gbm/VrrVideo.h
index df9ce07..fe89337 100644
--- a/xbmc/windowing/gbm/VrrVideo.h
+++ b/xbmc/windowing/gbm/VrrVideo.h
@@ -68,10 +68,12 @@ namespace KODI::WINDOWING::GBM::VRR_VIDEO
  *
  * HDR10+ only where the driver sends its InfoFrame in a slot that the VRR packet does not take
  * (NV_HDR10PLUS_WITH_VRR of nvidia-drm, nvidia-open-kernel-modules-9082: Ada and Blackwell; on
- * Turing and Ampere the EMP of HDMI VRR takes the one slot of HDR10+). Never for Dolby Vision (native
- * output, or a video that says it is Dolby Vision), HDR10+ elsewhere, HLG, 3D,
- * a video not known to be progressive, or a video whose kind is not known: those change the mode as
- * before, and so does anything this cannot do exactly (Decide()). Nothing of Kodi is here: a test
+ * Turing and Ampere the EMP of HDMI VRR takes the one slot of HDR10+). A Dolby Vision video that does
+ * not go out as Dolby Vision (the display has none, or the user chose another output) goes out as
+ * HDR10, HDR10+ or SDR: it is taken as HDR10+ is, where the driver has that slot, and not where it
+ * could go out as HLG. Never for native Dolby Vision (NativeDolbyVisionWhy()), HDR10+ elsewhere, HLG,
+ * 3D, a video not known to be progressive, or a video whose kind is not known: those change the mode
+ * as before, and so does anything this cannot do exactly (Decide()). Nothing of Kodi is here: a test
  * runs it on the host.
  */
 
@@ -231,6 +233,18 @@ inline bool Automatic(bool setting, bool kodiStays, double menusRefresh, double
   return setting && kodiStays && !hasMode && !WholeMultipleOf(menusRefresh, fps);
 }
 
+/*!
+ * \brief Whether CResolutionUtils::ChooseBestResolution() asks again after Kodi's choice (Automatic()):
+ *        never for native Dolby Vision, whose mode is its transport mode at the rate Kodi chose
+ *        (FindDVTransportResolution()), nor for 3D. With "Always" asked first and refused
+ *        (NativeDolbyVisionWhy()), native Dolby Vision gets Kodi's choice: the change of mode to its
+ *        rate, never the fixed refresh of the menus.
+ */
+constexpr bool AskedAfterKodi(bool nativeDV, bool is3D)
+{
+  return !nativeDV && !is3D;
+}
+
 /*!
  * \brief Whether the mode sets of the menus leave VRR to the driver for it (CHdmiVrrOff::Allowed()):
  *        the setting is Mode::NO_MODE, the display declares VRR, and it has no mode at the rate of
@@ -278,6 +292,9 @@ struct Query
   bool media = false; //!< the CRTC has NV_VRR_MEDIA_TARGET, and NV_VRR_MEDIA is 1 in its mode
   //! the connector's NV_HDR10PLUS_WITH_VRR is 1: HDR10+ goes out next to the VRR packet
   bool hdr10PlusWithVrr = false;
+  //! a Dolby Vision video that does not go out natively may go out as HLG: its stream or its base
+  //! layer is HLG (DVBRIDGE::StreamOutputMayBeHlg())
+  bool dvMayBeHlg = false;
   int vrrMin = 0; //!< the display's VRR range, in Hz (0: not known)
   int vrrMax = 0;
   float guiRefresh = 0.0f; //!< the mode of the menus, which stays
@@ -298,6 +315,29 @@ struct Verdict
   const char* why = nullptr;
 };
 
+/*!
+ * \brief Why native Dolby Vision output never goes at its own rate with VRR, and keeps its change of
+ *        mode to the video's rate (the same as with the setting off, never the fixed refresh of the
+ *        menus). Looked at for the LG C5 (2026-11-19):
+ *  - its transport needs a mode of its own: 3840x2160 at 23.976 to 60 Hz (IsTransportMode() of
+ *    DVPlaybackPolicy.h), so with the menus at 120 Hz a change of mode comes anyway, and the change to
+ *    the video's rate shows it exactly;
+ *  - no display says that it takes Dolby Vision with VRR: the Dolby block of the EDID has no field for
+ *    it, nor has the HDMI Forum block (VRR range, ALLM, QMS and the like), and the LG C5 declares Dolby
+ *    Vision Standard with Quick Frame Transport off and only Low-Latency in its game configuration;
+ *  - nothing in the signal tells the source that the display decodes the tunnel at a varying refresh:
+ *    a display that does not shows a wrong picture, which no check here can see (CStartCheck measures
+ *    the output, not the picture), so it would not be fail-closed.
+ * The packets themselves would fit (NVKMS sends the Dolby InfoFrame in the vendor slot and the EMP of
+ * HDMI VRR in the generic one), and the tunnel carries the metadata of each picture in its pixels.
+ */
+constexpr const char* NativeDolbyVisionWhy()
+{
+  return "the video goes out as native Dolby Vision, which changes the mode to its rate as always "
+         "(its transport needs 3840x2160 at up to 60 Hz, and no display declares Dolby Vision with "
+         "VRR)";
+}
+
 /*!
  * \brief Whether a video goes at its own rate with VRR in the mode of the menus, at which rate and
  *        how its time is kept. With the setting off the answer is "no, and nothing to say": the
@@ -308,8 +348,18 @@ inline Verdict Decide(const Query& q)
   Verdict v;
   if (!q.setting)
     return v;
-  if (q.nativeDV || q.video == WholeMultipleVideo::DOLBY_VISION)
-    v.why = "the video is Dolby Vision, which keeps the change of mode it always had";
+  // (a Dolby Vision video that does not go out natively goes out as HDR10, HDR10+ or SDR)
+  const bool dvOther = q.video == WholeMultipleVideo::DOLBY_VISION && !q.nativeDV;
+  if (q.nativeDV)
+    v.why = NativeDolbyVisionWhy();
+  else if (dvOther && !q.hdr10PlusWithVrr)
+    v.why =
+        "the video is Dolby Vision that goes out as HDR10, HDR10+ or SDR, and the driver has no "
+        "slot for an HDR10+ InfoFrame next to the VRR packet (NV_HDR10PLUS_WITH_VRR is not 1: "
+        "Turing and Ampere, or another driver)";
+  else if (dvOther && q.dvMayBeHlg)
+    v.why = "the video is Dolby Vision whose stream or base layer is HLG, which it may go out as: "
+            "only SDR, HDR10 and HDR10+ go at their own rate";
   else if (q.video == WholeMultipleVideo::HDR10PLUS && !q.hdr10PlusWithVrr)
     v.why = "the video is HDR10+, and the driver has no slot for its InfoFrame next to the VRR "
             "packet (NV_HDR10PLUS_WITH_VRR is not 1: Turing and Ampere, or another driver)";
@@ -317,7 +367,7 @@ inline Verdict Decide(const Query& q)
     v.why = "the video is HLG: only SDR, HDR10 and HDR10+ (where the driver says so) go at "
             "their own rate";
   else if (!WholeMultipleVideoTakes(q.video) &&
-           !(q.video == WholeMultipleVideo::HDR10PLUS && q.hdr10PlusWithVrr))
+           !(q.video == WholeMultipleVideo::HDR10PLUS && q.hdr10PlusWithVrr) && !dvOther)
     v.why = "what the video is was not told";
   else if (q.is3D)
     v.why = "the video is 3D";
