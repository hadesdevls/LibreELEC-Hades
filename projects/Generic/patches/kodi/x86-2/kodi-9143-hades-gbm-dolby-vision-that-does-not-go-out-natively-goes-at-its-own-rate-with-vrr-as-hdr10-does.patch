@@ -446,6 +446,12 @@ inline std::string StreamKeptOutReason(StreamKeptOut why,
 //! no other form), the user is told why, once for that state of the display.
 void DolbyVisionWithoutNativeOutput(const CDVDStreamInfo& stream);
 
+//! Hades: the Dolby Vision video stream that opened last may go out as HLG where it is not sent
+//! natively: the stream is coded with the HLG transfer or says it is HLG, or its base layer is HLG
+//! (BaseLayerTransferOf(): profiles 8.4 and 10.4). For "Video at its own rate with VRR", which takes
+//! no HLG (VRR_VIDEO::Decide()).
+bool StreamOutputMayBeHlg();
+
 //! Hades: what the settings say of a Dolby Vision stream that is not sent natively
 enum class ConversionSetting
 {
diff --git a/xbmc/windowing/Resolution.cpp b/xbmc/windowing/Resolution.cpp
