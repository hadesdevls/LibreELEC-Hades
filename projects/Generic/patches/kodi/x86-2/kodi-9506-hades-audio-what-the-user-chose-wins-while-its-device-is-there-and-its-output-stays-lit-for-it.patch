+// Hades: the outputs of a driver as the decisions by the displays know them (ActiveAEFollowDisplay.h)
+std::vector<INTERNAL::FollowCandidate> CandidatesOf(const AE::AESinkInfo& sink, bool passthrough)
+{
+  using INTERNAL::FollowCandidate;
+  std::vector<FollowCandidate> outputs;
+  outputs.reserve(sink.m_deviceInfoList.size());
+  for (const auto& d : sink.m_deviceInfoList)
+  {
+    FollowCandidate candidate;
+    candidate.name = d.m_deviceName;
+    candidate.display =
+        d.m_display == CAEDeviceInfo::Display::PRESENT  ? FollowCandidate::Display::PRESENT
+        : d.m_display == CAEDeviceInfo::Display::ABSENT ? FollowCandidate::Display::ABSENT
+                                                        : FollowCandidate::Display::UNKNOWN;
+    candidate.usable = IsUsableFor(d, passthrough);
+    candidate.family = INTERNAL::OutputFamily(d.m_deviceName, d.GetFriendlyName());
+    candidate.identity = d.m_displayIdentity;
+    outputs.push_back(std::move(candidate));
+  }
+  return outputs;
+}
