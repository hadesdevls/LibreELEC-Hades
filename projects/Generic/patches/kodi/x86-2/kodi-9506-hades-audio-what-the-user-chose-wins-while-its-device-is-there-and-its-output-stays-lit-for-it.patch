+TEST(TestActiveAEFollowDisplay, Issue24TheChosenIntelOutputKeepsTheReceiver)
+{
+  DisplayInUseChoice choice = DisplayInUseChoice::NONE;
+  // 1.2.2: chosen with the TV, which is on the NVIDIA card now: the sound went to the TV
+  EXPECT_EQ(-1, User(Issue24(), "hdmi:CARD=PCH,DEV=0", LG_B7, LG_B7, choice));
+  EXPECT_TRUE(choice == DisplayInUseChoice::USER_OUTPUT);
+  // ... the same where the TV was kept for a setting from before
+  EXPECT_EQ(-1, User(Issue24(), "hdmi:CARD=PCH,DEV=0", LG_B7, LG_B7, choice, false, false));
+  EXPECT_TRUE(choice == DisplayInUseChoice::USER_OUTPUT);
+  // ... as it still does for a setting that the user did not choose
+  EXPECT_EQ(3, OutputForDisplayInUse(Issue24(), "hdmi:CARD=PCH,DEV=0", true, LG_B7, LG_B7, false,
+                                     choice));
+  EXPECT_TRUE(choice == DisplayInUseChoice::REMEMBERED);
+  // the setting is kept with the receiver from now on, and then the receiver keeps it
+  const auto relearned = RelearnedDisplay(Issue24(), "hdmi:CARD=PCH,DEV=0", LG_B7);
+  ASSERT_TRUE(relearned.has_value());
+  EXPECT_TRUE(KODI::UTILS::SameDisplay(*relearned, PIONEER));
+  EXPECT_EQ(-1, User(Issue24(), "hdmi:CARD=PCH,DEV=0", PIONEER, LG_B7, choice));
+  EXPECT_TRUE(choice == DisplayInUseChoice::USER_OUTPUT);
+  // the Expert setting on: the same output (the windowing system lights it for that setting)
+  EXPECT_EQ(-1, User(Issue24(), "hdmi:CARD=PCH,DEV=0", PIONEER, LG_B7, choice, true));
+  EXPECT_TRUE(choice == DisplayInUseChoice::NONE);
+}
