+TEST(TestActiveAEFollowDisplay, AChosenReceiverOnItsOwnOutputKeepsItsSound)
+{
+  DisplayInUseChoice choice = DisplayInUseChoice::NONE;
+  // as AReceiverOnItsOwnOutputOnlyWithTheExpertSetting, chosen by the user: the receiver keeps
+  // the sound with the Expert setting off too
+  const std::vector<FollowCandidate> outputs = {Hdmi("hdmi:CARD=NVidia,DEV=0", PRESENT, LG_C5),
+                                                Hdmi("hdmi:CARD=NVidia,DEV=1", PRESENT, RECEIVER)};
+  EXPECT_EQ(-1, User(outputs, "hdmi:CARD=NVidia,DEV=1", RECEIVER, LG_C5, choice));
+  EXPECT_TRUE(choice == DisplayInUseChoice::USER_OUTPUT);
+  // ... kept for a setting from before: as before, until the output is chosen again
+  EXPECT_EQ(0, User(outputs, "hdmi:CARD=NVidia,DEV=1", RECEIVER, LG_C5, choice, false, false));
+  EXPECT_TRUE(choice == DisplayInUseChoice::DISPLAY_IN_USE);
+  // ... under another number now: that number
+  const std::vector<FollowCandidate> swapped = {Hdmi("hdmi:CARD=NVidia,DEV=0", PRESENT, RECEIVER),
+                                                Hdmi("hdmi:CARD=NVidia,DEV=1", PRESENT, LG_C5)};
+  EXPECT_EQ(0, User(swapped, "hdmi:CARD=NVidia,DEV=1", RECEIVER, LG_C5, choice));
+  EXPECT_TRUE(choice == DisplayInUseChoice::REMEMBERED);
+  // the chosen display is the one in use: nothing to say
+  EXPECT_EQ(-1, User(outputs, "hdmi:CARD=NVidia,DEV=0", LG_C5, LG_C5, choice));
+  EXPECT_TRUE(choice == DisplayInUseChoice::NONE);
+}
