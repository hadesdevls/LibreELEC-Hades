+TEST(TestActiveAEKeptOutputs, TheDeviceOfAnOutputTheUserChoseStaysLit)
+{
+  // Hades (issue #24, a report of 2026-11-26): the audio setting names the Intel output, and the
+  // receiver is on it; the picture is on the NVIDIA card. KEEP_OUTPUTS::OutputsForSound() with
+  // "Keep the display of the audio output on" off and no hades-keep-outputs: the receiver's output
+  // stays in the decision, so that it is not turned off as an output that Kodi does not use
+  KEEP::GraphicsDevice i915;
+  i915.node = "/dev/dri/card0";
+  i915.pci = "0000:00:02.0";
+  KEEP::GraphicsOutput dp;
+  dp.name = "DP-1";
+  dp.sound = true;
+  dp.connected = true;
+  dp.identity = Display(PIO, 0x1097);
+  i915.outputs.push_back(dp);
+  KEEP::GraphicsDevice nvidia;
+  nvidia.node = "/dev/dri/card1";
+  nvidia.pci = "0000:01:00.0";
+  KEEP::GraphicsOutput hdmi;
+  hdmi.name = "HDMI-A-3";
+  hdmi.sound = true;
+  hdmi.connected = true;
+  hdmi.identity = Display(GSM, 0xC0A0);
+  nvidia.outputs.push_back(hdmi);
+  const std::vector<KEEP::GraphicsDevice> devices{nvidia, i915};
+  const KEEP::OutputKey picture{"/dev/dri/card1", "HDMI-A-3"};
+
+  SoundOutput chosen = Receiver();
+  chosen.keepLit = true;
+  const KEEP::SoundDecision decision =
+      KEEP::OutputsForSound({chosen, Tv()}, true, devices, picture, false);
+  EXPECT_TRUE(decision.Keeps("/dev/dri/card0", "DP-1"));
+  // the output with the picture is on anyway, and is not kept for the TV's sound
+  EXPECT_FALSE(decision.Keeps("/dev/dri/card1", "HDMI-A-3"));
+  const bool saysWhy = std::ranges::any_of(decision.notes,
+                                           [](const std::string& note)
+                                           {
+                                             return note.find("that the user chose (/dev/dri/card0 "
+                                                              "DP-1)") != std::string::npos;
+                                           });
+  EXPECT_TRUE(saysWhy);
+  const bool saysNotKept =
+      std::ranges::any_of(decision.notes, [](const std::string& note)
+                          { return note.find("is not kept on") != std::string::npos; });
+  EXPECT_FALSE(saysNotKept);
+  // the same sound not chosen by the user: as before, not kept
+  EXPECT_FALSE(KEEP::OutputsForSound({Receiver(), Tv()}, true, devices, picture, false)
+                   .Keeps("/dev/dri/card0", "DP-1"));
+  // only what is certain: its display not known, or its card of no graphics device, keeps nothing
+  SoundOutput unknown = chosen;
+  unknown.identity = DisplayIdentity{};
+  EXPECT_FALSE(KEEP::OutputsForSound({unknown}, true, devices, picture, false)
+                   .Keeps("/dev/dri/card0", "DP-1"));
+  unknown = chosen;
+  unknown.card = "0000:03:00.1";
+  unknown.cardSuppliers.clear();
+  EXPECT_FALSE(KEEP::OutputsForSound({unknown}, true, devices, picture, false)
+                   .Keeps("/dev/dri/card0", "DP-1"));
+  // the device of the chosen output is another display than the one on DP-1 (the TV it was
+  // chosen with): nothing is lit for it
+  SoundOutput other = chosen;
+  other.identity = Display(GSM, 0xC0A0);
+  EXPECT_FALSE(KEEP::OutputsForSound({other}, true, devices, picture, false)
+                   .Keeps("/dev/dri/card0", "DP-1"));
+}
