+TEST(TestActiveAEFollowDisplay, ThePortOfTheUserIsJudgedOnlyWhereItIsKnown)
+{
+  const std::vector<FollowCandidate> outputs = Issue24();
+  const int tv = OnlyOutputWith(outputs, LG_B7);
+  EXPECT_EQ(3, tv);
+  EXPECT_TRUE(ChosenPortHasItsOwnDevice(outputs, 0, tv));
+  // the same card: another number of the same port
+  EXPECT_FALSE(ChosenPortHasItsOwnDevice(outputs, 0, 1));
+  // the configured output not there, or the display not found, or the same output
+  EXPECT_FALSE(ChosenPortHasItsOwnDevice(outputs, -1, tv));
+  EXPECT_FALSE(ChosenPortHasItsOwnDevice(outputs, 0, -1));
+  EXPECT_FALSE(ChosenPortHasItsOwnDevice(outputs, 3, 3));
+  // a family that is not known, a display not known, an output that cannot be used
+  std::vector<FollowCandidate> unknown = outputs;
+  unknown[0].family.clear();
+  EXPECT_FALSE(ChosenPortHasItsOwnDevice(unknown, 0, tv));
+  unknown = outputs;
+  unknown[3].family.clear();
+  EXPECT_FALSE(ChosenPortHasItsOwnDevice(unknown, 0, tv));
+  unknown = outputs;
+  unknown[0].identity = DisplayIdentity{};
+  EXPECT_FALSE(ChosenPortHasItsOwnDevice(unknown, 0, tv));
+  unknown = outputs;
+  unknown[0].usable = false;
+  EXPECT_FALSE(ChosenPortHasItsOwnDevice(unknown, 0, tv));
+  unknown = outputs;
+  unknown[0].display = UNKNOWN;
+  EXPECT_FALSE(ChosenPortHasItsOwnDevice(unknown, 0, tv));
+  // two TVs of one model: neither is the one it was chosen with
+  std::vector<FollowCandidate> twins = outputs;
+  twins[4] = Card("hdmi:CARD=NVidia,DEV=1", "hdmi:NVidia", PRESENT, LG_B7);
+  EXPECT_EQ(-1, OnlyOutputWith(twins, LG_B7));
+  EXPECT_FALSE(RelearnedDisplay(twins, "hdmi:CARD=PCH,DEV=0", LG_B7).has_value());
+  // nothing remembered, or the output has the display it was chosen with: nothing relearned
+  EXPECT_FALSE(RelearnedDisplay(outputs, "hdmi:CARD=PCH,DEV=0", {}).has_value());
+  EXPECT_FALSE(RelearnedDisplay(outputs, "hdmi:CARD=PCH,DEV=0", PIONEER).has_value());
+  EXPECT_FALSE(RelearnedDisplay(outputs, "hdmi:CARD=PCH,DEV=7", LG_B7).has_value());
+}
