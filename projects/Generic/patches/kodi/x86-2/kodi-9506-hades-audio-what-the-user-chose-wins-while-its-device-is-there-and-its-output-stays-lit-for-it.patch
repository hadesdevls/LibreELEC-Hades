+TEST(TestActiveAEFollowDisplay, AnotherNumberOfTheSameCardIsStillTheDisplayFollowed)
+{
+  DisplayInUseChoice choice = DisplayInUseChoice::NONE;
+  // the numbers of one card are given in the order the displays came: the user's choice is the
+  // display, not the number (the session of 2026-11-12)
+  const std::vector<FollowCandidate> outputs = {Hdmi("hdmi:CARD=NVidia,DEV=0", PRESENT, ODYSSEY),
+                                                Hdmi("hdmi:CARD=NVidia,DEV=1", ABSENT),
+                                                Hdmi("hdmi:CARD=NVidia,DEV=2", PRESENT, LG_C5)};
+  EXPECT_EQ(2, User(outputs, "hdmi:CARD=NVidia,DEV=0", LG_C5, LG_C5, choice));
+  EXPECT_TRUE(choice == DisplayInUseChoice::REMEMBERED);
+  EXPECT_FALSE(RelearnedDisplay(outputs, "hdmi:CARD=NVidia,DEV=0", LG_C5).has_value());
+  // ... also where that display is not the one in use: it is the user's choice
+  EXPECT_EQ(2, User(outputs, "hdmi:CARD=NVidia,DEV=0", LG_C5, ODYSSEY, choice));
+  EXPECT_TRUE(choice == DisplayInUseChoice::REMEMBERED);
+  // ... but a display kept for a setting from before, not the one in use, is not known to be the
+  // user's: as before (the display in use is the Odyssey on the configured number)
+  EXPECT_EQ(-1, User(outputs, "hdmi:CARD=NVidia,DEV=0", LG_C5, ODYSSEY, choice, false, false));
+  EXPECT_TRUE(choice == DisplayInUseChoice::NONE);
+}
