+         const DisplayIdentity& remembered,
+         const DisplayIdentity& driven,
+         DisplayInUseChoice& choice,
+         bool lightOthers = false,
+         bool deliberate = true)
+{
+  return OutputForDisplayInUse(outputs, configured, true, remembered, driven, lightOthers, choice,
+                               true, deliberate);
+}
