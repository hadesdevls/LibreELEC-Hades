From dcf69ad61eb5f736d62aa267e97a5492a622bdb6 Mon Sep 17 00:00:00 2001
From: Hades <15710513+hadesdevls@users.noreply.github.com>
Date: Wed, 25 Nov 2026 20:35:12 +0000
Subject: [PATCH] [Hades][GBM] A 3D video gone back to 2D is rebuilt by the
 Dolby Vision bridge as a 2D one

Where the processor cannot keep up with both views of a 3D video (MVC, MV-HEVC), the decoder of
both views is given up and the stream is opened again for its base view alone, in 2D (as it is
where that decoder cannot be had at all). Its pictures then say "mono"
(KODI::MULTIVIEW::BASE_ONLY_STEREO_MODE), the word with which Kodi marks a 2D picture: its renderer
draws it whole and the display leaves 3D. The decisions of the bridge took any stereo mode that is
not empty for a 3D picture, and asked whether the bridge could draw it a view at a time; "mono" has
no views, and so the picture went to none of them. A Dolby Vision 3D film of profile 20, whose base
layer is no picture by itself (IPT-PQ-c2), was rebuilt in 3D and, once back in 2D, showed that base
layer as it is: green and purple. An HDR10 3D video back in 2D on a display without HDR went from
the bridge's mapping to SDR to Kodi's own, in the middle of the film.

A picture is one of a 3D video now where its stereo mode is neither empty nor "mono"
(KODI::UTILS::STEREO3D::IsStereo(), as Kodi's own code has it elsewhere), in the reconstruction of
Dolby Vision (WantsConversion()), the mapping of HDR to SDR (WantsPlainMapping()), the choice of
SDR for 3D video (HdrAsSdr(), which said so already) and the adaptation of HDR10
(Hdr10AdaptDecide(); decided once a video, so a video that began in 3D keeps what it had there):
the base view in 2D is the same picture as the stream played in 2D from its start, and goes
through the same decisions. A picture without a stereo mode and every picture of a 3D layout are
decided as before.

Not changed: native Dolby Vision and the HDR10 tunnel, which hand the whole output to a transport
that a 3D output does not carry (a video gone back to 2D can still be shown in a 3D output, where
3D is kept when a 3D video ends); and the choice of the mode of the display, where such a video
still counts as 3D, which only keeps the video at its own rate with VRR (off by default) out, as a
3D output needs.
---
 xbmc/utils/Stereo3DVideo.h                     | 16 ++++++++++++++++
 xbmc/windowing/gbm/WinSystemGbmGLESContext.cpp | 12 ++++++------
 2 files changed, 22 insertions(+), 6 deletions(-)

diff --git a/xbmc/utils/Stereo3DVideo.h b/xbmc/utils/Stereo3DVideo.h
index f54b346..3662748 100644
--- a/xbmc/utils/Stereo3DVideo.h
+++ b/xbmc/utils/Stereo3DVideo.h
@@ -155,6 +155,22 @@ constexpr Packing PackingOf(std::string_view mode)
   return Packing::NONE;
 }
 
+/*!
+ * \brief Whether a picture of this stereo mode is one of a 3D video: not one without a stereo mode,
+ *        nor one that says it is 2D, "mono", as Kodi has it (CStereoscopicsManager,
+ *        GetFlagsStereoMode(): drawn whole, the display left in 2D)
+ *
+ * Such is the base view alone of a stream of two views whose decoder of both was given up, its 3D
+ * gone back to 2D where the processor could not keep up (KODI::MULTIVIEW::BASE_ONLY_STEREO_MODE): it
+ * is the same picture as that of the stream played in 2D from its start, and goes to the Dolby
+ * Vision bridge as that one does. Taken for a 3D picture, it went nowhere: a Dolby Vision 3D film of
+ * profile 20 showed its base layer in IPT-PQ-c2 as it is (green and purple).
+ */
+constexpr bool IsStereo(std::string_view mode)
+{
+  return !mode.empty() && mode != "mono";
+}
+
 //! The size of one view of a picture of width x height (the whole picture where it is not packed)
 struct Size
 {
diff --git a/xbmc/windowing/gbm/WinSystemGbmGLESContext.cpp b/xbmc/windowing/gbm/WinSystemGbmGLESContext.cpp
index d52ee6d..b5882d9 100644
--- a/xbmc/windowing/gbm/WinSystemGbmGLESContext.cpp
+++ b/xbmc/windowing/gbm/WinSystemGbmGLESContext.cpp
@@ -3920,12 +3920,12 @@ bool DVBRIDGE::WantsConversion(const VideoPicture* picture, int toneMapMethod)
   return window && picture && picture->doviConvert && !picture->doviBaseRefused &&
          picture->hdrType == StreamHdrType::HDR_TYPE_DOLBYVISION &&
          !(picture->iFlags & DVP_FLAG_INTERLACED) &&
-         (picture->stereoMode.empty() ||
+         (!KODI::UTILS::STEREO3D::IsStereo(picture->stereoMode) ||
           window->StereoPictureTaken(*picture, !picture->doviBaseIsPicture)) &&
          (picture->doviConvertSdr
               ? (window->SupportsDVConversionToSdr() ||
                  ((picture->hdrAsSdrChosen ||
-                   (!picture->stereoMode.empty() &&
+                   (KODI::UTILS::STEREO3D::IsStereo(picture->stereoMode) &&
                     KODI::UTILS::STEREO3D::ChoosesSdr(window->Stereo3DChoice()))) &&
                   window->DVConversionToSdrChosen())) &&
                     SdrConversionHolds(picture->doviBaseIsPicture,
@@ -3960,7 +3960,8 @@ bool DVBRIDGE::WantsPlainMapping(const VideoPicture* picture, int toneMapMethod)
       picture->color_primaries == AVCOL_PRI_BT2020, picture->color_space == AVCOL_SPC_BT2020_NCL,
       peak, (picture->iFlags & DVP_FLAG_INTERLACED) != 0,
       // (Hades: a picture of a 3D video where the bridge draws it a view at a time: StereoPictureTaken())
-      !picture->stereoMode.empty() && !window->StereoPictureTaken(*picture, false));
+      KODI::UTILS::STEREO3D::IsStereo(picture->stereoMode) &&
+          !window->StereoPictureTaken(*picture, false));
 }
 
 bool DVBRIDGE::WantsHdr10Adapt(const VideoPicture* picture)
@@ -4008,8 +4009,7 @@ bool CWinSystemGbmGLESContext::HdrAsSdr(const VideoPicture& picture) const
   const int setting = m_hdrAsSdr.load(std::memory_order_relaxed);
   // Hades: a picture of a 3D video, on an output that takes its HDR: as the choice for 3D video says
   // (videoscreen.hades3dcolour), over "Play HDR videos as SDR"; Automatic leaves it to that setting
-  if ((pq || hlg) && !picture.stereoMode.empty() && picture.stereoMode != "mono" &&
-      HdrAsSdrChoosable())
+  if ((pq || hlg) && KODI::UTILS::STEREO3D::IsStereo(picture.stereoMode) && HdrAsSdrChoosable())
   {
     namespace S = KODI::UTILS::STEREO3D;
     const S::Choice choice = Stereo3DChoice();
@@ -4070,7 +4070,7 @@ HDR10_ADAPT::CState::Snapshot CWinSystemGbmGLESContext::Hdr10AdaptDecide(const V
     p.bt2020 = picture.color_primaries == AVCOL_PRI_BT2020;
     p.ncl = picture.color_space == AVCOL_SPC_BT2020_NCL;
     p.interlaced = (picture.iFlags & DVP_FLAG_INTERLACED) != 0;
-    p.stereo = !picture.stereoMode.empty();
+    p.stereo = KODI::UTILS::STEREO3D::IsStereo(picture.stereoMode);
     p.mdl = picture.hasDisplayMetadata && picture.displayMetadata.has_luminance &&
                     picture.displayMetadata.max_luminance.den
                 ? av_q2d(picture.displayMetadata.max_luminance)
