diff --git a/xbmc/platform/linux/HadesBootState.cpp b/xbmc/platform/linux/HadesBootState.cpp
index a21a60c..af28966 100644
--- a/xbmc/platform/linux/HadesBootState.cpp
+++ b/xbmc/platform/linux/HadesBootState.cpp
@@ -100,8 +100,9 @@ std::string Describe(const BootState& state)
     return "this PC did not start by UEFI, or its firmware gives no boot order: 'Restart into "
            "Windows' is not shown";
   const std::string where = "this start came from " + Entry(state.current, state.currentName) +
-                            "; a plain restart starts " + Entry(state.next, state.nextName) +
-                            "; the boot order is " + (state.order.empty() ? "empty" : state.order);
+                            "; the firmware starts " + Entry(state.next, state.nextName) +
