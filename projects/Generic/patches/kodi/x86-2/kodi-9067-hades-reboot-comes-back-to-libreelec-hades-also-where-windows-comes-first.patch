+                            (state.order.empty() ? "empty" : state.order);
   if (!IsEntryNumber(state.windows))
     return "no entry of Windows in the boot order of the firmware: 'Restart into Windows' is not "
            "shown; " +
@@ -113,7 +114,7 @@ std::string Describe(const BootState& state)
            where;
   return "Windows is " + Entry(state.windows, state.windowsName) +
          ": 'Restart into Windows' is shown" +
-         (state.next == state.windows ? " (a plain restart starts Windows too)" : "") + "; " +
+         (state.next == state.windows ? " (Windows comes first in the boot order)" : "") + "; " +
          where;
 }
 
@@ -133,4 +134,61 @@ SetResult ParseSetResult(std::string_view output, int exitStatus)
     r.error = exitStatus > 0 ? "exit " + std::to_string(exitStatus) : "no answer";
   return r;
 }
+
+KeepResult ParseKeepResult(std::string_view output, int exitStatus)
+{
+  KeepResult r;
+  std::string bootNext, kept;
+  Lines(output,
+        [&](std::string_view key, std::string_view value)
+        {
+          if (key == "bootnext")
+            bootNext = Value(value);
+          else if (key == "kept")
+            kept = Value(value);
+          else if (key == "error")
+            r.error = Value(value);
+        });
+  const bool ended = exitStatus == 0 || exitStatus == -1;
+  if (r.error == "no-current-entry")
+    r.outcome = KeepResult::Outcome::NO_CURRENT;
+  else if (!r.error.empty() || !ended)
+    r.outcome = KeepResult::Outcome::FAILED;
+  else if (IsEntryNumber(bootNext))
+  {
+    r.outcome = KeepResult::Outcome::SET;
+    r.entry = bootNext;
+  }
+  else if (bootNext == "none" && IsEntryNumber(kept))
+  {
+    r.outcome = KeepResult::Outcome::CHOSEN;
+    r.entry = kept;
+  }
+  else if (bootNext == "none" && kept.empty())
+    r.outcome = KeepResult::Outcome::ALREADY;
+  if (r.outcome == KeepResult::Outcome::FAILED && r.error.empty())
+    r.error = exitStatus > 0 ? "exit " + std::to_string(exitStatus) : "no answer";
+  return r;
+}
+
+std::string Describe(const KeepResult& result)
+{
+  switch (result.outcome)
+  {
+    case KeepResult::Outcome::SET:
+      return "'Reboot' comes back to this system: BootNext=" + result.entry +
+             " (a plain restart would start another entry)";
+    case KeepResult::Outcome::ALREADY:
+      return "'Reboot': a plain restart starts this system already; nothing written";
+    case KeepResult::Outcome::CHOSEN:
+      return "'Reboot': the next start was chosen already (BootNext=" + result.entry +
+             "), left as it is";
+    case KeepResult::Outcome::NO_CURRENT:
+      return "'Reboot' goes by the boot order of the firmware: it does not say which entry this "
+             "start came from, or the PC started by BIOS; nothing written";
+    default:
+      return "'Reboot' goes by the boot order of the firmware: BootNext could not be set (" +
+             result.error + ")";
+  }
+}
 } // namespace KODI::PLATFORM::LINUX::HADESBOOT
diff --git a/xbmc/platform/linux/HadesBootState.h b/xbmc/platform/linux/HadesBootState.h
index 1d0f035..74dc75e 100644
--- a/xbmc/platform/linux/HadesBootState.h
+++ b/xbmc/platform/linux/HadesBootState.h
@@ -59,6 +59,27 @@ struct SetResult
  */
 SetResult ParseSetResult(std::string_view output, int exitStatus);
 
+//! What "hades-bootnext again --keep-chosen" answered before "Reboot".
+struct KeepResult
+{
+  enum class Outcome
+  {
+    SET, //!< BootNext = this start: the restart comes back to this system
+    ALREADY, //!< a plain restart starts this system already: nothing written
+    CHOSEN, //!< the next start was chosen already ("Restart into Windows"): left as it is
+    NO_CURRENT, //!< the firmware does not say which entry this start came from, or the PC started by BIOS
+    FAILED, //!< the firmware did not take it, or no answer
+  };
+  Outcome outcome{Outcome::FAILED};
+  std::string entry; //!< the entry of BootNext: set, or kept
+  std::string error;
+};
+
+KeepResult ParseKeepResult(std::string_view output, int exitStatus);
+
+//! One line for kodi.log: where the restart goes.
+std::string Describe(const KeepResult& result);
+
 //! Four hexadecimal digits in capitals, as the helper writes the number of an entry.
 bool IsEntryNumber(std::string_view value);
 } // namespace KODI::PLATFORM::LINUX::HADESBOOT
diff --git a/xbmc/platform/linux/HadesFirmwareBoot.cpp b/xbmc/platform/linux/HadesFirmwareBoot.cpp
index 8f4f712..b02ad8db 100644
--- a/xbmc/platform/linux/HadesFirmwareBoot.cpp
+++ b/xbmc/platform/linux/HadesFirmwareBoot.cpp
@@ -19,14 +19,18 @@
 #include <string>
 
 #include <sys/wait.h>
+#include <unistd.h>
 
 namespace KODI::PLATFORM::LINUX::HADESBOOT
 {
 namespace
 {
 constexpr const char* STATE_FILE = "/run/hades-bootnext";
-// (a fixed command: nothing in it comes from outside)
+constexpr const char* HELPER = "/usr/lib/libreelec/hades-bootnext";
+// (fixed commands: nothing in them comes from outside)
 constexpr const char* SET_WINDOWS = "/bin/sh /usr/lib/libreelec/hades-bootnext windows 2>&1";
+constexpr const char* KEEP_THIS_START =
+    "/bin/sh /usr/lib/libreelec/hades-bootnext again --keep-chosen 2>&1";
 
 std::mutex g_lock;
 bool g_read{false};
@@ -69,40 +73,62 @@ bool CanRebootToWindows()
   return g_offers;
 }
 
+namespace
+{
+// Runs one of the fixed commands above; what it says goes to output. The exit status, -1 when it is not known, and
+// -2 when the command could not be started.
+int Run(const char* command, std::string& output)
+{
+  FILE* p = popen(command, "r");
+  if (!p)
+    return -2;
+  char buffer[256];
+  while (output.size() < 4096 && fgets(buffer, sizeof(buffer), p))
+    output += buffer;
+  const int rc = pclose(p);
+  if (rc == -1)
+    return -1;
+  return WIFEXITED(rc) ? WEXITSTATUS(rc) : 128;
+}
+} // namespace
+
 bool SetWindowsForNextStart()
 {
   // The helper looks the entry of Windows up again in the firmware: that, and not what was read at the start, counts.
   std::string output;
-  int status = -1;
-  if (FILE* p = popen(SET_WINDOWS, "r"))
-  {
-    char buffer[256];
-    while (output.size() < 4096 && fgets(buffer, sizeof(buffer), p))
-      output += buffer;
-    const int rc = pclose(p);
-    if (rc != -1 && WIFEXITED(rc))
-      status = WEXITSTATUS(rc);
-    else if (rc != -1)
-      status = 128;
-  }
-  else
+  const int status = Run(SET_WINDOWS, output);
+  if (status == -2)
   {
     CLog::Log(LOGERROR, "Hades boot: 'Restart into Windows' not done: hades-bootnext could not be "
-                        "started; the PC is not "
-                        "restarted");
+                        "started; the PC is not restarted");
     return false;
   }
   const SetResult result = ParseSetResult(output, status);
   if (result.done)
-    CLog::Log(LOGINFO,
-              "Hades boot: 'Restart into Windows': BootNext={} set, and the firmware gives it "
-              "back; the PC restarts "
-              "into Windows once, and goes by its boot order after that",
-              result.bootNext);
+    CLog::Log(
+        LOGINFO,
+        "Hades boot: 'Restart into Windows': BootNext={} set, and the firmware gives it back; "
+        "the PC restarts into Windows once, and goes by its boot order after that",
+        result.bootNext);
   else
     CLog::Log(LOGWARNING,
               "Hades boot: 'Restart into Windows' not done ({}); the PC is not restarted",
               result.error);
   return result.done;
 }
+
+void KeepThisStartForReboot()
+{
+  if (access(HELPER, R_OK) != 0)
+  {
+    CLog::Log(LOGINFO, "Hades boot: no {}: 'Reboot' goes by the boot order of the firmware",
+              HELPER);
+    return;
+  }
+  std::string output;
+  const int status = Run(KEEP_THIS_START, output);
+  const KeepResult result = ParseKeepResult(output, status == -2 ? 127 : status);
+  CLog::Log(result.outcome == KeepResult::Outcome::FAILED ? LOGWARNING : LOGINFO, "Hades boot: {}",
+            Describe(result));
+}
 } // namespace KODI::PLATFORM::LINUX::HADESBOOT
diff --git a/xbmc/platform/linux/HadesFirmwareBoot.h b/xbmc/platform/linux/HadesFirmwareBoot.h
