+++ b/xbmc/platform/linux/HadesFirmwareBoot.h
@@ -15,10 +15,10 @@ namespace KODI::PLATFORM::LINUX::HADESBOOT
  *
  * On a PC with Windows and Hades, Windows comes first in the boot order of the firmware, and Hades is started for one
  * start: from the boot menu of the firmware, or by "Restart into LibreELEC Hades" of the installer for Windows, which
- * sets BootNext. A plain restart then goes back to Windows; on a PC where Hades comes first (installed inside the PC
- * and chosen first in the firmware), or where the firmware puts a USB drive first, it does not. This entry starts
- * Windows at the next start in every case, and only at that one: it sets BootNext, a variable of the firmware that
- * the firmware deletes when it uses it, to the entry of Windows that the firmware already has. No boot entry is made,
+ * sets BootNext. "Reboot" comes back to this system (KeepThisStartForReboot), and on a PC where Hades comes first, or
+ * where the firmware puts a USB drive first, a restart comes back to it anyway: this entry is the way to Windows. It
+ * starts Windows at the next start, and only at that one: it sets BootNext, a variable of the firmware that the
+ * firmware deletes when it uses it, to the entry of Windows that the firmware already has. No boot entry is made,
  * changed or deleted, and the boot order stays as it is. The work with the firmware is done by
  * /usr/lib/libreelec/hades-bootnext (also used by the system for the restarts that finish an update).
  */
@@ -30,4 +30,16 @@ bool CanRebootToWindows();
 //! Sets the next start, and only that one, to Windows; true when the firmware gave the value back. The PC is not
 //! restarted here. Says what happened in kodi.log.
 bool SetWindowsForNextStart();
+
+/*!
+ * \brief "Reboot" comes back to this system (CPowerManager::Reboot, before the restart).
+ *
+ * Where this start was one start of Hades (from the boot menu of the firmware, or by BootNext) and the boot order
+ * starts Windows first, a plain restart would end in Windows. Like the restarts that the system makes itself, "Reboot"
+ * sets BootNext to the entry that this start came from (BootCurrent). Nothing is written when a plain restart starts
+ * this system already, when the next start was chosen already in this start ("Restart into Windows"), when the
+ * firmware does not say which entry this start came from, or on a start by BIOS. Says in kodi.log where the restart
+ * goes. It never stops the restart.
+ */
+void KeepThisStartForReboot();
 } // namespace KODI::PLATFORM::LINUX::HADESBOOT
diff --git a/xbmc/platform/linux/test/TestHadesBootState.cpp b/xbmc/platform/linux/test/TestHadesBootState.cpp
index d5318ce..aba3444 100644
--- a/xbmc/platform/linux/test/TestHadesBootState.cpp
+++ b/xbmc/platform/linux/test/TestHadesBootState.cpp
@@ -38,7 +38,7 @@ TEST(TestHadesBootState, PcOfTheUser)
   EXPECT_EQ(s.next, "0000");
   EXPECT_TRUE(OffersWindows(s));
   const std::string said = Describe(s);
-  EXPECT_NE(said.find("'Restart into Windows' is shown (a plain restart starts Windows too)"),
+  EXPECT_NE(said.find("'Restart into Windows' is shown (Windows comes first in the boot order)"),
             std::string::npos)
       << said;
   EXPECT_NE(said.find("this start came from Boot0003 \"UEFI: HIKSEMI, Partition 1\""),
@@ -104,6 +104,32 @@ TEST(TestHadesBootState, AnswerOfTheHelper)
   EXPECT_FALSE(ParseSetResult("bootnext=0000\n", 128).done);
 }
 
+TEST(TestHadesBootState, AnswerBeforeReboot)
+{
+  using O = KeepResult::Outcome;
+  KeepResult r = ParseKeepResult("bootnext=0003\n", 0);
+  EXPECT_EQ(r.outcome, O::SET);
+  EXPECT_EQ(r.entry, "0003");
+  EXPECT_NE(Describe(r).find("comes back to this system: BootNext=0003"), std::string::npos);
+  EXPECT_EQ(ParseKeepResult("bootnext=0003\n", -1).outcome, O::SET);
+  EXPECT_EQ(ParseKeepResult("bootnext=none\n", 0).outcome, O::ALREADY);
+  r = ParseKeepResult("bootnext=none\nkept=0000\n", 0);
+  EXPECT_EQ(r.outcome, O::CHOSEN);
+  EXPECT_EQ(r.entry, "0000");
+  EXPECT_NE(Describe(r).find("chosen already (BootNext=0000)"), std::string::npos);
+  r = ParseKeepResult("error=no-current-entry\n", 1);
+  EXPECT_EQ(r.outcome, O::NO_CURRENT);
+  EXPECT_NE(Describe(r).find("started by BIOS; nothing written"), std::string::npos);
+  r = ParseKeepResult("error=not-written\n", 1);
+  EXPECT_EQ(r.outcome, O::FAILED);
+  EXPECT_NE(Describe(r).find("(not-written)"), std::string::npos);
+  EXPECT_EQ(ParseKeepResult("bootnext=0003\n", 1).outcome, O::FAILED);
+  EXPECT_EQ(ParseKeepResult("", 0).outcome, O::FAILED);
+  EXPECT_EQ(ParseKeepResult("", 0).error, "no answer");
+  EXPECT_EQ(ParseKeepResult("sh: can't open\n", 127).error, "exit 127");
+  EXPECT_EQ(ParseKeepResult("bootnext=none\nkept=junk\n", 0).outcome, O::FAILED);
+}
+
 TEST(TestHadesBootState, EntryNumbers)
 {
   EXPECT_TRUE(IsEntryNumber("0000"));
