+msgstr ""
+
+#: addons/skin.estuary/xml/Variables.xml
+#. Hades, player information, the speakers: the same, where the display has no name (SpeakerPlan.h)
+msgctxt "#54963"
+msgid "the device between this PC and the display"
+msgstr ""
+
+#: addons/skin.estuary/xml/Variables.xml
+#. Hades, player information, the speakers: after the name of the display: the EDID cannot tell its own speakers from those of a device on its eARC or ARC (SpeakerPlan.h)
+msgctxt "#54964"
+msgid "or the device on its eARC/ARC"
+msgstr ""
+
+#: addons/skin.estuary/xml/Variables.xml
+#. Hades, player information, the speakers: the same, where the display has no name (SpeakerPlan.h)
+msgctxt "#54965"
+msgid "the display or the device on its eARC/ARC"
+msgstr ""
