+/*!
+ * \brief The speakers that the device says it has in the room: its Room Configuration Data Block and
+ *        the named places of its Speaker Location Data Block (not its speaker allocation, which is
+ *        what it accepts); nothing where it has neither
+ */
+inline std::optional<Places> RoomPlaces(const EdidAudio& audio)
+{
+  if (!audio.room && audio.located.empty())
+    return std::nullopt;
+  Places p;
+  if (audio.room)
+    p = Declared(*audio.room);
+  std::vector<std::string> off;
+  for (const std::string& place : Located(audio.located, off))
+    p.insert(place);
+  return p;
+}
+
+//! Which device the speakers of an EDID are declared by, as far as its physical address tells
+enum class Declarer
+{
+  //! the EDID gives no address (DisplayPort, an ELD, no HDMI vendor block): the device it names
+  NAMED,
+  //! depth 2 or more: a device between the source and the display (a sound bar, an AV receiver, a
+  //! switch), whose own audio blocks these are, though the name is the display's
+  REPEATER,
+  //! depth 1: the display, or a device on its eARC or ARC that it forwards; the EDID cannot tell
+  DISPLAY_OR_ITS_ARC,
+};
+
+//! The depth of a physical address: 1 for A.0.0.0, 2 for A.B.0.0...; 0 for 0.0.0.0 and for one with
+//! a level of 0 before one that is not (not valid), or 0xFFFF (none)
+inline int PhysicalDepth(uint16_t address)
+{
+  if (address == 0xFFFF)
+    return 0;
+  int depth = 0;
+  bool ended = false;
+  for (int n = 3; n >= 0; --n)
+  {
+    const int level = (address >> (4 * n)) & 0xF;
+    if (level == 0)
+      ended = true;
+    else if (ended)
+      return 0;
+    else
+      ++depth;
+  }
+  return depth;
+}
+
+inline Declarer DeclarerOf(const EdidAudio& audio)
+{
+  if (audio.fromEld)
+    return Declarer::NAMED;
+  const int depth = PhysicalDepth(audio.physicalAddress);
+  return depth >= 2 ? Declarer::REPEATER : depth == 1 ? Declarer::DISPLAY_OR_ITS_ARC : Declarer::NAMED;
+}
+
+//! The address as CEC writes it, "2.2.0.0"; empty for none
+inline std::string PhysicalAddressText(uint16_t address)
+{
+  if (address == 0xFFFF)
+    return "";
+  std::string s;
+  for (int n = 3; n >= 0; --n)
+    s += std::to_string((address >> (4 * n)) & 0xF) + (n ? "." : "");
+  return s;
+}
