 }
+
+#ifdef HAVE_DVBRIDGE
+int CLinuxRendererGLES::StereoPacking() const
+{
+  // as ManageRenderArea() takes the half of each eye (CBaseRenderer: CONF_FLAGS_STEREO_MODE_SBS, _TAB)
+  switch (CONF_FLAGS_STEREO_MODE_MASK(m_iFlags))
+  {
+    case CONF_FLAGS_STEREO_MODE_SBS:
+      return static_cast<int>(KODI::UTILS::STEREO3D::Packing::SIDE_BY_SIDE);
+    case CONF_FLAGS_STEREO_MODE_TAB:
+      return static_cast<int>(KODI::UTILS::STEREO3D::Packing::TOP_AND_BOTTOM);
+    default:
+      return 0;
+  }
+}
+
+void CLinuxRendererGLES::TellStereoVideo(const VideoPicture& picture, int transfer)
+{
+  namespace S = KODI::UTILS::STEREO3D;
+  auto* window =
+      dynamic_cast<KODI::WINDOWING::GBM::CWinSystemGbmGLESContext*>(CServiceBroker::GetWinSystem());
+  if (!window)
+    return;
+  if (S::PackingOf(picture.stereoMode) == S::Packing::NONE)
+  {
+    window->NoteStereoVideo("", "");
+    return;
+  }
+  // what it goes out as: HDR as the output was told (PQ or HLG), else SDR in the container it was drawn into
+  const char* signal = m_passthroughHDR ? (transfer == AVCOL_TRC_ARIB_STD_B67 ? "hlg" : "hdr10")
+                       : !m_sdrWide     ? "sdr709"
+                       : m_sdrWideMapped && m_sdrContainer == 2 ? "sdrp3"
+                                                                : "sdr2020";
+  const bool hdrVideo = picture.color_transfer == AVCOL_TRC_SMPTE2084 ||
+                        picture.color_transfer == AVCOL_TRC_ARIB_STD_B67 ||
+                        picture.hdrType == StreamHdrType::HDR_TYPE_DOLBYVISION;
+  const S::Choice choice = window->Stereo3DChoice();
+  // ... and whether the choice for 3D video made it (of an HDR video only: an SDR one goes out as it is)
+  const bool hdrOut = m_passthroughHDR;
+  const bool had = choice == S::Choice::HDR          ? hdrOut
+                   : choice == S::Choice::SDR_BT2020 ? std::string_view(signal) == "sdr2020"
+                   : choice == S::Choice::SDR_BT709  ? std::string_view(signal) == "sdr709"
+                                                     : true;
+  const char* by = !hdrVideo || choice == S::Choice::AUTOMATIC ? ""
+                   : had                                       ? "chosen"
+                                                               : "notpossible";
+  // (the player information says it of an HDR video, which the choice is about: of an SDR one, such as a 3D Blu-ray,
+  // its 3D row stays as it was)
+  window->NoteStereoVideo(hdrVideo ? signal : "", by);
+  const bool bridge = m_dvConvert || m_plainMap;
+  CLog::Log(
+      had ? LOGINFO : LOGWARNING, "3D video ({}x{}, {}): goes out as {}{}; {}", picture.iWidth,
+      picture.iHeight, picture.stereoMode,
+      std::string_view(signal) == "hdr10"     ? "HDR10 (PQ)"
+      : std::string_view(signal) == "hlg"     ? "HLG"
+      : std::string_view(signal) == "sdr2020" ? "SDR in BT.2020"
+      : std::string_view(signal) == "sdrp3"   ? "SDR in DCI-P3 (D65)"
+                                              : "SDR in BT.709",
+      !hdrVideo ? " (an SDR video goes out as it is, whatever the choice for 3D video)"
+      : choice == S::Choice::AUTOMATIC ? " (videoscreen.hades3dcolour: Automatic)"
+      : had
+          ? StringUtils::Format(" (as chosen for 3D video: {})", S::ChoiceName(choice))
+          : StringUtils::Format(" (not {}, chosen for 3D video: the display or the output does not "
+                                "take it here; the lines before say why)",
+                                S::ChoiceName(choice)),
+      bridge
+          ? "drawn by the Dolby Vision bridge a view at a time, each view as the same picture in 2D"
+          : "drawn by Kodi's own shaders, an eye at a time");
+}
+#endif
