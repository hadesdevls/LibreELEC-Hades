index 49415bd..05ba7e7 100644
--- a/xbmc/windowing/WinSystem.h
+++ b/xbmc/windowing/WinSystem.h
@@ -520,11 +520,18 @@ public:
   // Hades: the container an HDR picture mapped to SDR would go out in now (asked before the picture is mapped:
   // the bridge maps into it): 1 BT.2020, 2 DCI-P3 (D65), or 0, BT.709 as Kodi, with *why where the setting asks for
   // a wider one that the display, the driver or the output does not take
-  virtual int SdrMappedContainer(std::string* why) const
+  // (Hades: stereo, for a picture of a 3D video, whose gamut the choice for 3D video may set:
+  // KODI::UTILS::STEREO3D::Container())
+  virtual int SdrMappedContainer(std::string* why, bool stereo = false) const
   {
     (void)why;
+    (void)stereo;
     return 0;
   }
+  // Hades: whether a Dolby Vision 3D film whose base layer is no picture by itself (profile 20 with
+  // compatibility 0) can be rebuilt in 3D here, a view at a time by the bridge (KODI::UTILS::STEREO3D):
