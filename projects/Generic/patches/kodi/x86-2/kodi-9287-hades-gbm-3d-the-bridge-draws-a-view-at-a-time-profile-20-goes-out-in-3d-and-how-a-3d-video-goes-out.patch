+#include "windowing/GraphicContext.h"
+
+#include <algorithm>
+
+using namespace KODI::WINDOWING::GBM;
+
+namespace S = KODI::UTILS::STEREO3D;
+
+S::Choice CWinSystemGbmGLESContext::Stereo3DChoice() const
+{
+  // (as it was when the video started: DVConversionNewVideo(); a change applies from the next video)
+  return S::ChoiceOfSetting(m_stereo3dChoice.load(std::memory_order_relaxed));
+}
+
+int CWinSystemGbmGLESContext::Stereo3DChoiceSetting()
+{
+  const auto component = CServiceBroker::GetSettingsComponent();
+  const auto settings = component ? component->GetSettings() : nullptr;
+  return settings && settings->GetSetting(CSettings::SETTING_VIDEOSCREEN_HADES3DCOLOUR)
+             ? settings->GetInt(CSettings::SETTING_VIDEOSCREEN_HADES3DCOLOUR)
+             : 0;
+}
+
+#ifdef HAVE_DVBRIDGE
+
+bool CWinSystemGbmGLESContext::PartCopyAvailable() const
+{
+  // glCopyImageSubData() (dvbridge_gl_part.h): OpenGL ES 3.2, or one of the extensions that have it, as the
+  // render system read them when the context was made (any thread)
+  unsigned int major = 0, minor = 0;
+  GetRenderVersion(major, minor);
+  return m_renderableType == EGL_OPENGL_ES3_BIT &&
+         (major > 3 || (major == 3 && minor >= 2) || IsExtSupported("GL_EXT_copy_image") ||
+          IsExtSupported("GL_OES_copy_image"));
+}
+
+bool CWinSystemGbmGLESContext::RebuildsDolbyVisionIn3D() const
+{
+  return PartCopyAvailable();
+}
+
+bool CWinSystemGbmGLESContext::StereoBridgeTakes(bool noPicture,
+                                                 int viewWidth,
+                                                 int viewHeight) const
+{
+  if (viewWidth < 2 || viewHeight < 2 || viewWidth % 2 || viewHeight % 2 ||
+      viewWidth > DVBRIDGE::SOURCE_MAX_WIDTH || viewHeight > DVBRIDGE::SOURCE_MAX_HEIGHT ||
+      !PartCopyAvailable())
+    return false;
+  const S::Choice choice = Stereo3DChoice();
+  const auto component = CServiceBroker::GetSettingsComponent();
+  const auto settings = component ? component->GetSettings() : nullptr;
+  const int gamut =
+      settings && settings->GetSetting(CSettings::SETTING_VIDEOSCREEN_HADESSDRHDRGAMUT)
+          ? settings->GetInt(CSettings::SETTING_VIDEOSCREEN_HADESSDRHDRGAMUT)
+          : 0;
+  return S::BridgeTakes(
+      noPicture, choice, S::Container(choice, gamut),
+      const_cast<CWinSystemGbmGLESContext*>(this)->GetGfxContext().GetStereoMode());
+}
+
+bool CWinSystemGbmGLESContext::StereoPictureTaken(const VideoPicture& picture, bool noPicture) const
+{
+  const S::Packing packing = S::PackingOf(picture.stereoMode);
+  const int width = static_cast<int>(picture.iWidth);
+  const int height = static_cast<int>(picture.iHeight);
+  if (!S::ViewsFit(packing, width, height, DVBRIDGE::SOURCE_MAX_WIDTH, DVBRIDGE::SOURCE_MAX_HEIGHT))
+    return false;
+  const S::Size view = S::ViewSize(packing, width, height);
+  return StereoBridgeTakes(noPicture, view.width, view.height);
+}
+
+void CWinSystemGbmGLESContext::NoteStereoVideo(const char* signal, const char* by)
+{
+  m_stereo3dSignal.store(signal ? signal : "", std::memory_order_relaxed);
+  m_stereo3dBy.store(by ? by : "", std::memory_order_relaxed);
+}
+
+void CWinSystemGbmGLESContext::StereoPartsLetGo()
+{
+  if (!m_stereoPartsHeld)
+    return;
+  // (render thread: the context of the textures is current)
+  dvbridge_gl_part_free(&m_stereoParts[0]);
+  dvbridge_gl_part_free(&m_stereoParts[1]);
+  m_stereoPartsHeld = false;
+}
+
+int CWinSystemGbmGLESContext::RenderStereoParts(
+    const CDVBridgeGLES::Layer& layer,
+    const CRect& source,
+    const CRect& dest,
+    const std::function<int(const CDVBridgeGLES::Layer&, const CRect&, const CRect&)>& draw)
+{
+  auto& gfx = GetGfxContext();
+  const RenderStereoMode mode = gfx.GetStereoMode();
+  const RenderStereoView view = gfx.GetStereoView();
+  S::Part parts[2];
+  const int count = S::Parts(static_cast<S::Packing>(layer.stereo), layer.width, layer.height,
+                             {source.x1, source.y1, source.x2, source.y2},
+                             {dest.x1, dest.y1, dest.x2, dest.y2}, parts);
+  if (count == 0)
+    return -1;
+  // (the right eye where the eyes are mixed: the left one was drawn whole, in 2D: BridgeTakes())
+  if (S::RoleOf(mode, view, 0, count) == S::Role::SKIPPED)
+    return 1;
+  // the eye that Kodi draws now: its size, and where it lies in the window (the corner of its viewport,
+  // CGraphicContext::SetStereoView()); the whole window where nothing is split
+  const RESOLUTION_INFO eye = gfx.GetResInfo();
+  const CPoint origin = gfx.StereoCorrection(CPoint(0.0f, 0.0f));
+  int result = 1;
+  for (int i = 0; i < count; ++i)
+  {
+    S::Rect from = parts[i].source;
+    S::Rect to = parts[i].dest;
+    if (!S::EyePlace(from, to, static_cast<float>(eye.iWidth), static_cast<float>(eye.iHeight),
+                     origin.x, origin.y))
+      continue;
+    CDVBridgeGLES::Layer part = layer;
+    part.stereo = 0;
+    part.width = parts[i].size.width;
+    part.height = parts[i].size.height;
+    if (!dvbridge_gl_part_copy(&m_stereoParts[parts[i].view], layer.layout, layer.width,
+                               layer.height, layer.planes, parts[i].x, parts[i].y, part.width,
+                               part.height, part.planes))
+    {
+      if (!std::exchange(m_stereoPartFailTold, true))
+        CLog::Log(
+            LOGERROR,
+            "3D video: a view of a {}x{} picture could not be copied for the bridge ({}x{} at "
+            "{},{}; glCopyImageSubData): this picture is not drawn by it",
+            layer.width, layer.height, part.width, part.height, parts[i].x, parts[i].y);
+      result = -1;
+      break;
+    }
+    m_stereoPartsHeld = true;
+    m_stereoRole = S::RoleOf(mode, view, i, count);
+    const int drawn =
+        draw(part, CRect(from.x1, from.y1, from.x2, from.y2), CRect(to.x1, to.y1, to.x2, to.y2));
+    m_stereoRole = S::Role::NONE;
+    if (drawn < 0)
+    {
+      result = -1;
+      break;
+    }
+    result = std::min(result, drawn);
+  }
+  return result;
+}
+
+#endif
