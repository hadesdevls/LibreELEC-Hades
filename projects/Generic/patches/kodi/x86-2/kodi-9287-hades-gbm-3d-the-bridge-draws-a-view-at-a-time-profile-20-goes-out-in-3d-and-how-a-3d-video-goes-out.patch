+ */
+
+#pragma once
+
+#include "rendering/RenderSystemTypes.h"
+
+#include <algorithm>
+#include <string_view>
+
+namespace KODI
+{
+namespace UTILS
+{
+namespace STEREO3D
+{
+
+/*!
+ * \brief Hades: how a 3D video goes out, and how the Dolby Vision bridge draws its two views
+ *
+ * A 3D video comes as one picture of two views: side by side or one above the other (a 3D file,
+ * and MVC and MV-HEVC as Kodi puts their two views side by side, KODI::MULTIVIEW). Kodi draws each
+ * eye from its half of that picture (CBaseRenderer::ManageRenderArea()), in the place of that eye
+ * in the window (CGraphicContext::SetStereoView(), StereoCorrection()).
+ *
+ * The bridge (Dolby Vision rebuilt as HDR10 or SDR, HDR mapped to SDR by the method of a reference
+ * display) drew no such picture: it draws a picture from textures of its own size, into a place
+ * of the window, and a 3D picture would have been drawn whole, or both eyes into the left one.
+ * Here it draws each eye as a picture of its own: the view of that eye copied into textures of
+ * the view's size (dvbridge_gl_part_copy()), drawn exactly as the same picture in 2D, into the
+ * place of that eye (Parts(), EyePlace()). A Dolby Vision 3D film of profile 20, whose base layer
+ * is no picture by itself, goes out in 3D so, rebuilt as HDR10 or mapped to SDR.
+ *
+ * Choice: videoscreen.hades3dcolour, how a 3D video goes out, for those who try what a 3D TV or
+ * projector takes. Automatic (the default) is what Hades sends without the setting: HDR where the
+ * display takes the HDR of the video, SDR otherwise, in the gamut of "HDR to SDR: gamut of the
+ * output". The others ask for HDR, SDR in BT.2020 or SDR in BT.709 for every HDR video in 3D.
+ */
+
+//! The values of videoscreen.hades3dcolour
+enum class Choice
+{
+  AUTOMATIC = 0,
+  HDR = 1, //!< HDR as the video is: HDR10 (PQ), HLG for an HLG video, Dolby Vision rebuilt as HDR10
+  SDR_BT2020 = 2, //!< mapped to SDR, in BT.2020
+  SDR_BT709 = 3, //!< mapped to SDR, in BT.709
+};
+
+constexpr Choice ChoiceOfSetting(int value)
+{
+  return value == 1   ? Choice::HDR
+         : value == 2 ? Choice::SDR_BT2020
+         : value == 3 ? Choice::SDR_BT709
+                      : Choice::AUTOMATIC;
+}
+
+constexpr const char* ChoiceName(Choice choice)
+{
+  switch (choice)
+  {
+    case Choice::HDR:
+      return "HDR";
+    case Choice::SDR_BT2020:
+      return "SDR in BT.2020";
+    case Choice::SDR_BT709:
+      return "SDR in BT.709";
+    default:
+      return "Automatic";
+  }
+}
+
+constexpr bool ChoosesSdr(Choice choice)
+{
+  return choice == Choice::SDR_BT2020 || choice == Choice::SDR_BT709;
+}
+
+/*!
+ * \brief Whether an HDR picture of a 3D video goes out as SDR on an output that takes its HDR
+ * \param settingSaysSdr what "Play HDR videos as SDR" says of it (DVBRIDGE::HdrAsSdrFor())
+ *
+ * The choice for 3D is about 3D video, so it stands for that setting there; Automatic leaves it to
+ * the setting. (The user's choice for the video itself, "As SDR", stands for both: the caller asks
+ * it first.)
+ */
+constexpr bool AsSdr(Choice choice, bool settingSaysSdr)
+{
+  return choice == Choice::AUTOMATIC ? settingSaysSdr : ChoosesSdr(choice);
+}
+
+/*!
+ * \brief The container of an HDR picture of a 3D video mapped to SDR (KODI::UTILS::SDRWIDE: 0
+ *        BT.709, 1 BT.2020, 2 DCI-P3 (D65))
+ * \param gamutSetting videoscreen.hadessdrhdrgamut
+ */
+constexpr int Container(Choice choice, int gamutSetting)
+{
+  return choice == Choice::SDR_BT2020 ? 1 : choice == Choice::SDR_BT709 ? 0 : gamutSetting;
+}
+
+//! The ways of Kodi of showing a 3D picture that put both eyes into one picture, each eye drawn
+//! through a mask (the colours of anaglyph glasses, lines or squares of the screen)
+constexpr bool MixesEyes(RenderStereoMode mode)
+{
+  return mode == RenderStereoMode::ANAGLYPH_RED_CYAN ||
+         mode == RenderStereoMode::ANAGLYPH_GREEN_MAGENTA ||
+         mode == RenderStereoMode::ANAGLYPH_YELLOW_BLUE || mode == RenderStereoMode::INTERLACED ||
+         mode == RenderStereoMode::CHECKERBOARD || mode == RenderStereoMode::HARDWAREBASED;
+}
+
+constexpr bool SplitsEyes(RenderStereoMode mode)
+{
+  return mode == RenderStereoMode::SPLIT_HORIZONTAL || mode == RenderStereoMode::SPLIT_VERTICAL;
+}
+
+/*!
+ * \brief Whether the bridge draws a 3D picture (whose layout is one it can cut: Packing)
+ * \param noPicture its base layer is no picture by itself (Dolby Vision profile 5, and 20 with
+ *        compatibility 0): shown as it is its colours are wrong, so the bridge draws it whatever
+ *        the way of showing it (in a way that mixes the eyes, the view of the left eye alone, in
+ *        2D: the bridge's copy into the window takes no mask)
+ * \param container what Container() gives for it
+ *
+ * Any other picture only where the eyes are not mixed, and where the user asked for it: SDR chosen
+ * for 3D, or a gamut of SDR wider than BT.709. Automatic with BT.709, the default, keeps the 3D
+ * that Hades drew before: HDR passed through, or Kodi's own tone mapping.
+ */
+constexpr bool BridgeTakes(bool noPicture, Choice choice, int container, RenderStereoMode mode)
+{
+  if (noPicture)
+    return true;
+  if (MixesEyes(mode))
+    return false;
+  return ChoosesSdr(choice) || container != 0;
+}
+
+//! How the two views of a 3D picture lie in it: the layouts that Kodi draws each eye from a half
+//! of (GetFlagsStereoMode(): CONF_FLAGS_STEREO_MODE_SBS, CONF_FLAGS_STEREO_MODE_TAB)
+enum class Packing
+{
+  NONE,
+  SIDE_BY_SIDE,
+  TOP_AND_BOTTOM,
+};
+
+//! The packing of a picture by its stereo mode, in the words of Matroska as Kodi has them
+constexpr Packing PackingOf(std::string_view mode)
+{
+  if (mode == "left_right" || mode == "right_left")
+    return Packing::SIDE_BY_SIDE;
+  if (mode == "top_bottom" || mode == "bottom_top")
+    return Packing::TOP_AND_BOTTOM;
+  return Packing::NONE;
+}
+
+//! The size of one view of a picture of width x height (the whole picture where it is not packed)
+struct Size
+{
+  int width = 0;
+  int height = 0;
+};
+
+constexpr Size ViewSize(Packing packing, int width, int height)
+{
+  return packing == Packing::SIDE_BY_SIDE     ? Size{width / 2, height}
+         : packing == Packing::TOP_AND_BOTTOM ? Size{width, height / 2}
+                                              : Size{width, height};
+}
+
+/*!
+ * \brief Whether each view of a packed picture can be cut out for the bridge: two views of even
+ *        sizes (a view of 4:2:0 begins and ends on a chroma sample), each within the largest picture
+ *        the bridge takes in (maxWidth x maxHeight, DVBRIDGE::SOURCE_MAX_WIDTH and _HEIGHT)
+ */
+constexpr bool ViewsFit(Packing packing, int width, int height, int maxWidth, int maxHeight)
+{
+  if (packing == Packing::NONE || width < 4 || height < 4)
+    return false;
+  const Size view = ViewSize(packing, width, height);
+  const bool exact = packing == Packing::SIDE_BY_SIDE ? width % 4 == 0 && height % 2 == 0
+                                                      : height % 4 == 0 && width % 2 == 0;
+  return exact && view.width <= maxWidth && view.height <= maxHeight;
+}
+
+//! A rectangle from the top left, as Kodi's renderer gives the part of the picture it shows and
+//! where (CRect)
+struct Rect
+{
+  float x1 = 0, y1 = 0, x2 = 0, y2 = 0;
+};
+
+//! One part of a draw: what of one view is drawn, and where
+struct Part
+{
+  int view = 0; //!< 0 the left or top half of the picture, 1 the right or bottom one
+  int x = 0, y = 0; //!< where that view begins in the picture
+  Size size; //!< ... and its size
+  Rect source; //!< the part of the view that is drawn, in the view's own pixels
+  Rect dest; //!< where it goes, as Kodi gave the destination (the place in the eye)
+};
+
+/*!
+ * \brief The parts of one draw of a packed picture: the part of the picture that Kodi shows
+ *        (source) cut at the seam between its views, each part with the part of the destination
+ *        that it fills
+ * \return how many parts (0 where there is nothing to draw, or the picture is not packed): one in
+ *         the place of an eye (Kodi takes that eye's half), two where Kodi shows the whole
+ *         picture (a 3D video without a 3D way of showing it: both views side by side as they are)
+ */
+inline int Parts(
+    Packing packing, int width, int height, const Rect& source, const Rect& dest, Part out[2])
+{
+  if (packing == Packing::NONE || width < 2 || height < 2 || !(source.x2 > source.x1) ||
+      !(source.y2 > source.y1) || !(dest.x2 > dest.x1) || !(dest.y2 > dest.y1))
+    return 0;
+  const bool sideBySide = packing == Packing::SIDE_BY_SIDE;
+  const Size size = ViewSize(packing, width, height);
+  const float seam = static_cast<float>(sideBySide ? size.width : size.height);
+  const float s1 = sideBySide ? source.x1 : source.y1;
+  const float s2 = sideBySide ? source.x2 : source.y2;
+  const float d1 = sideBySide ? dest.x1 : dest.y1;
+  const float d2 = sideBySide ? dest.x2 : dest.y2;
+  const float scale = (d2 - d1) / (s2 - s1);
+  // (less than a hundredth of a pixel of a view is none of it: the half that Kodi takes ends on the
+  // seam exactly)
+  constexpr float NOTHING = 0.01f;
+  int count = 0;
+  for (int view = 0; view < 2; ++view)
+  {
+    const float from = view == 0 ? s1 : std::max(s1, seam);
+    const float to = view == 0 ? std::min(s2, seam) : s2;
+    if (!(to - from > NOTHING))
+      continue;
+    Part& part = out[count++];
+    part.view = view;
+    part.size = size;
+    part.x = sideBySide && view ? size.width : 0;
+    part.y = !sideBySide && view ? size.height : 0;
+    const float origin = view ? seam : 0.0f;
+    const float dFrom = d1 + (from - s1) * scale;
+    const float dTo = to == s2 ? d2 : d1 + (to - s1) * scale;
+    part.source = source;
+    part.dest = dest;
+    if (sideBySide)
+    {
+      part.source.x1 = from - origin;
+      part.source.x2 = to - origin;
+      part.dest.x1 = dFrom;
+      part.dest.x2 = dTo;
+    }
+    else
+    {
+      part.source.y1 = from - origin;
+      part.source.y2 = to - origin;
+      part.dest.y1 = dFrom;
+      part.dest.y2 = dTo;
+    }
+  }
+  return count;
+}
+
+/*!
+ * \brief The place of a part in the window: its destination (in the coordinates of the eye that
+ *        Kodi draws, from its top left) cut to that eye (eyeWidth x eyeHeight; the source cut by
+ *        the same part), then moved to where that eye lies in the window (originX, originY:
+ *        CGraphicContext::StereoCorrection() of the eye's corner; 0 where nothing is split)
+ * \return false where nothing of it is within the eye
+ *
+ * Kodi draws an eye through the viewport of that eye: what it draws past the eye is cut away there.
+ * The bridge draws into the window, so the eye's edge is the edge here (a zoomed picture would
+ * otherwise reach into the other eye).
+ */
+inline bool EyePlace(
+    Rect& source, Rect& dest, float eyeWidth, float eyeHeight, float originX, float originY)
+{
+  if (!(dest.x2 > dest.x1) || !(dest.y2 > dest.y1) || !(source.x2 > source.x1) ||
+      !(source.y2 > source.y1) || !(eyeWidth > 0) || !(eyeHeight > 0))
+    return false;
+  if (dest.x1 >= eyeWidth || dest.y1 >= eyeHeight || dest.x2 <= 0 || dest.y2 <= 0)
+    return false;
+  const float perX = (source.x2 - source.x1) / (dest.x2 - dest.x1);
+  const float perY = (source.y2 - source.y1) / (dest.y2 - dest.y1);
+  if (dest.x1 < 0)
+  {
+    source.x1 -= dest.x1 * perX;
+    dest.x1 = 0;
+  }
+  if (dest.y1 < 0)
+  {
+    source.y1 -= dest.y1 * perY;
+    dest.y1 = 0;
+  }
+  if (dest.x2 > eyeWidth)
+  {
+    source.x2 -= (dest.x2 - eyeWidth) * perX;
+    dest.x2 = eyeWidth;
+  }
+  if (dest.y2 > eyeHeight)
+  {
+    source.y2 -= (dest.y2 - eyeHeight) * perY;
+    dest.y2 = eyeHeight;
+  }
+  dest.x1 += originX;
+  dest.x2 += originX;
+  dest.y1 += originY;
+  dest.y2 += originY;
+  return true;
+}
+
+//! What one draw of the bridge is of a frame, for the GPU timer of a picture rebuilt from Dolby
+//! Vision (CDVConvertStep): a picture of a 3D video is drawn in two or more draws (an eye each),
+//! and the frame's time is that of all of them
+enum class Role
+{
+  NONE, //!< no picture of a 3D video: as before
+  ALONE, //!< the only draw of the frame
+  FIRST, //!< the first of more: the timer begins, the level of the step-down is taken
+  MIDDLE, //!< between: neither
+  LAST, //!< the last: the timer ends; the level of the first stays
+  SKIPPED, //!< nothing is drawn: the right eye where the eyes are mixed (BridgeTakes())
+};
+
+/*!
+ * \param view the eye that Kodi draws now (CGraphicContext::GetStereoView())
+ * \param part which part of this draw (Parts()), of parts
+ */
+constexpr Role RoleOf(RenderStereoMode mode, RenderStereoView view, int part, int parts)
+{
+  if (MixesEyes(mode) && view == RenderStereoView::RIGHT)
+    return Role::SKIPPED;
+  const bool split = SplitsEyes(mode) && view != RenderStereoView::OFF;
+  const bool first = part == 0 && (!split || view == RenderStereoView::LEFT);
+  const bool last = part == parts - 1 && (!split || view == RenderStereoView::RIGHT);
+  return first && last ? Role::ALONE : first ? Role::FIRST : last ? Role::LAST : Role::MIDDLE;
+}
+
+constexpr bool TimerBegins(Role role)
+{
+  return role == Role::NONE || role == Role::ALONE || role == Role::FIRST;
+}
+
+constexpr bool TimerEnds(Role role)
+{
+  return role == Role::NONE || role == Role::ALONE || role == Role::LAST;
+}
+
+} // namespace STEREO3D
+} // namespace UTILS
+} // namespace KODI
