From c4e36eb2bc9eef05dda8e7d4df3b84b7fadb43fd Mon Sep 17 00:00:00 2001
From: Hades <15710513+hadesdevls@users.noreply.github.com>
Date: Wed, 18 Nov 2026 06:34:29 +0000
Subject: [PATCH] windowing/gbm: the lanes and Gb/s of an FRL rate from one
 table

ModesetReport.h wrote its own table of the lanes and the Gb/s of each
FRL rate of NV_OUTPUT_LINK; HOTPLUG_RELINK::FrlLanesAndGbps(), beside
FrlRateOf(), has the same one for the player information. The line of
each change of mode takes it now: the same text for every rate.
---
 xbmc/windowing/gbm/ModesetReport.h | 34 +++---------------------------
 1 file changed, 3 insertions(+), 31 deletions(-)

diff --git a/xbmc/windowing/gbm/ModesetReport.h b/xbmc/windowing/gbm/ModesetReport.h
index 75fe638..4d93cda 100644
--- a/xbmc/windowing/gbm/ModesetReport.h
+++ b/xbmc/windowing/gbm/ModesetReport.h
@@ -54,37 +54,9 @@ public:
     const Link link = HOTPLUG_RELINK::LinkOf(value);
     if (link != Link::FRL)
       return HOTPLUG_RELINK::Name(link);
-    unsigned int lanes = 0;
-    unsigned int gbps = 0;
-    switch (HOTPLUG_RELINK::FrlRateOf(value))
-    {
-      case 1:
-        lanes = 3;
-        gbps = 3;
-        break;
-      case 2:
-        lanes = 3;
-        gbps = 6;
-        break;
-      case 3:
-        lanes = 4;
-        gbps = 6;
-        break;
-      case 4:
-        lanes = 4;
-        gbps = 8;
-        break;
-      case 5:
-        lanes = 4;
-        gbps = 10;
-        break;
-      case 6:
-        lanes = 4;
-        gbps = 12;
-        break;
-      default:
-        return "FRL";
-    }
+    const auto [lanes, gbps] = HOTPLUG_RELINK::FrlLanesAndGbps(HOTPLUG_RELINK::FrlRateOf(value));
+    if (!lanes)
+      return "FRL";
     return "FRL, " + std::to_string(lanes) + " lanes at " + std::to_string(gbps) + " Gb/s";
   }
 };
-- 
