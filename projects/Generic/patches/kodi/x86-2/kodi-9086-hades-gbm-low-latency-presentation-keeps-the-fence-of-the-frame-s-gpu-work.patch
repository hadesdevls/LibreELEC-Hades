From b70735eecf00907413db18ba544ec1f52c485d2f Mon Sep 17 00:00:00 2001
From: Hades <15710513+hadesdevls@users.noreply.github.com>
Date: Wed, 18 Nov 2026 06:52:10 +0000
Subject: [PATCH] [Hades][GBM] Low latency presentation keeps the fence of the
 frame's GPU work

Piers 02a497b has the full screen game window commit each frame and wait
for its flip. It does so by making async false in PresentRender(), which
also leaves out the fence of the frame's GPU work: the commit then has no
in-fence, and the kernel waits only for a fence that the driver attaches
to the buffer itself. egl-gbm on NVIDIA may not attach one, and Hades
already finishes the GPU work before each commit that has no in-fence for
that reason (FlipHeldGui(), the frames of native Dolby Vision output that
wait).

The fence now goes with the commit whether it waits for its flip or not;
only async follows the low latency presentation. Nothing else changes
with it: the flip of the frame before came with its own commit, which
waited for it, so the waits for that flip return at once, and the commit
waits for its own flip as upstream's does. A commit that waits and has an
in-fence is what the fallback of a stalled flip (FlipStalled()) and a
commit paced for VRR already make.

The change of presentation is said once each way in kodi.log.
---
 .../windowing/gbm/WinSystemGbmGLESContext.cpp | 24 ++++++++++++++++---
 xbmc/windowing/gbm/WinSystemGbmGLESContext.h  |  2 ++
 2 files changed, 23 insertions(+), 3 deletions(-)

diff --git a/xbmc/windowing/gbm/WinSystemGbmGLESContext.cpp b/xbmc/windowing/gbm/WinSystemGbmGLESContext.cpp
index 54ce403..2350c86 100644
--- a/xbmc/windowing/gbm/WinSystemGbmGLESContext.cpp
+++ b/xbmc/windowing/gbm/WinSystemGbmGLESContext.cpp
@@ -1111,15 +1111,33 @@ void CWinSystemGbmGLESContext::PresentRender(bool rendered, bool videoLayer)
     // before it, and that the display is back after it (CHeldModeAnnouncement)
     AnnounceHeldModeChange(false);
 #endif
+    // Hades: the GPU work of the frame goes to its commit as an in-fence whether the commit waits
+    // for its flip or not, with low latency presentation (a game full screen) too: without it the
+    // kernel would wait only for a fence that the driver attaches to the buffer itself, which
+    // egl-gbm on NVIDIA may not (FlipHeldGui() and the frames of native Dolby Vision output that
+    // wait finish their GPU work for that reason). With low latency the waits for the flip of the
+    // frame before return at once: it came with its own commit, which waited for it.
+    const bool fenced = !videoLayer && m_eglFence;
     // A frame committed without waiting reaches the screen a vblank later
-    bool async = !videoLayer && m_eglFence && !m_lowLatencyPresentation;
+    bool async = fenced && !m_lowLatencyPresentation;
+    // (Hades: said once each way)
+    if (const bool lowLatency = fenced && m_lowLatencyPresentation; lowLatency != m_lowLatencySaid)
+    {
+      m_lowLatencySaid = lowLatency;
+      CLog::LogF(LOGINFO, "{}",
+                 lowLatency ? "low latency presentation (a game is full screen): each frame is "
+                              "committed with the fence of its GPU work and waited for until it is "
+                              "on the screen"
+                            : "low latency presentation has ended: frames are committed without "
+                              "waiting for their flip again");
+    }
     int lagFd = -1; // (Hades: the out-fence of the frame before, to read when it flipped)
     if (rendered)
     {
       // Hades: before the fence of the frame, which stands for all of its GPU work
       ClearStereoGap();
 #if defined(EGL_ANDROID_native_fence_sync) && defined(EGL_KHR_fence_sync)
-      if (async)
+      if (fenced)
       {
         int fd = m_DRM->TakeOutFenceFd();
         if (fd != -1)
@@ -1145,7 +1163,7 @@ void CWinSystemGbmGLESContext::PresentRender(bool rendered, bool videoLayer)
       }
 
 #if defined(EGL_ANDROID_native_fence_sync) && defined(EGL_KHR_fence_sync)
-      if (async)
+      if (fenced)
       {
         int fd = m_eglFence->FlushFence();
 
diff --git a/xbmc/windowing/gbm/WinSystemGbmGLESContext.h b/xbmc/windowing/gbm/WinSystemGbmGLESContext.h
index 8d8fb9e..194d584 100644
--- a/xbmc/windowing/gbm/WinSystemGbmGLESContext.h
+++ b/xbmc/windowing/gbm/WinSystemGbmGLESContext.h
@@ -562,6 +562,8 @@ private:
   //! drawn on, made black before the frame is swapped (StereoGap.h); said once for each layout
   void ClearStereoGap();
   std::array<int, 6> m_stereoGapTold{};
+  //! Hades: low latency presentation (CWinSystemBase::SetLowLatencyPresentation()) as last said
+  bool m_lowLatencySaid{false};
   bool m_flipOutputOff{false};
   std::chrono::steady_clock::time_point m_flipOutputTry{};
   std::chrono::steady_clock::duration m_flipOutputWait{};
-- 
