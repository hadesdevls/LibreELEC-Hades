+// Hades: what a display declares in its EDID, for the system page of the player information
+// (hades.tv.*, which the skin says in words): its HDR formats (the EOTFs of its HDR static metadata
+// block, and HDR10+ by its block of any application version), its Dolby Vision block (the modes it
+// offers and its version, as CDisplayInfo reads it for the decisions), what its HDMI Forum block
+// declares (the VRR range, the fastest FRL or TMDS only, ALLM, QMS) and AMD's block of FreeSync.
+// Nothing without display information (no EDID that could be read): the page says so.
+std::map<std::string, std::string> DeclaresOf(const KODI::UTILS::CDisplayInfo* display)
+{
+  std::map<std::string, std::string> keys;
+  if (!display)
+    return keys;
+  std::vector<std::string> hdr;
+  if (display->SupportsEOTF(KODI::UTILS::Eotf::PQ))
+    hdr.emplace_back("HDR10");
+  if (display->SupportsEOTF(KODI::UTILS::Eotf::HLG))
+    hdr.emplace_back("HLG");
+  if (display->DeclaresHDR10Plus())
+    hdr.emplace_back(display->HDR10PlusVersion() >= 1 ? "HDR10+" : "HDR10+ (v0)");
+  keys["hades.tv.hdr"] = hdr.empty() ? "none" : StringUtils::Join(hdr, ", ");
+  // (Standard with the Dolby vendor InfoFrame, Low-Latency, or only the older signalling of HDMI
+  // 1.4b; "unread": a block that is not taken, see CDisplayInfo::DolbyVisionBlockInvalid())
+  const KODI::UTILS::DolbyVideoBlock& dv = display->GetDolbyVideoBlock();
+  if (!dv.valid)
+    keys["hades.tv.dv"] = display->SupportsDolbyVision() ? "unread" : "none";
+  else
+  {
+    keys["hades.tv.dv"] = dv.standard && dv.lowLatency                 ? "stdll"
+                          : dv.standard                                 ? "std"
+                          : dv.lowLatency                               ? "ll"
+                          : display->SupportsLegacyDolbyVisionOnly() ? "old"
+                                                                        : "unread";
+    keys["hades.tv.dvversion"] = std::to_string(dv.version);
+  }
+  const KODI::UTILS::HdmiForumSink& forum = display->GetHdmiForumSink();
+  if (forum.vrrMinHz)
+  {
+    keys["hades.tv.vrrmin"] = std::to_string(forum.vrrMinHz);
+    if (forum.vrrMaxHz)
+      keys["hades.tv.vrrmax"] = std::to_string(forum.vrrMaxHz);
+  }
+  else
+    keys["hades.tv.vrrmin"] = "none";
+  if (!forum.declared)
+    keys["hades.tv.frl"] = "none";
+  else if (forum.maxFrlRate)
+  {
+    keys["hades.tv.frl"] = "frl";
+    const auto [lanes, gbps] = ::HOTPLUG_RELINK::FrlLanesAndGbps(forum.maxFrlRate);
+    if (lanes)
+    {
+      keys["hades.tv.frllanes"] = std::to_string(lanes);
+      keys["hades.tv.frlgbps"] = std::to_string(gbps);
+    }
+  }
+  else
+  {
+    keys["hades.tv.frl"] = "tmds";
+    if (forum.maxTmdsMhz)
+      keys["hades.tv.tmdsmhz"] = std::to_string(forum.maxTmdsMhz);
+  }
+  keys["hades.tv.allm"] = forum.allm ? "yes" : "no";
+  keys["hades.tv.qms"] = forum.qms ? "yes" : "no";
+  keys["hades.tv.freesync"] = display->DeclaresFreeSync() ? "yes" : "no";
+  return keys;
+}
 } // namespace
 
