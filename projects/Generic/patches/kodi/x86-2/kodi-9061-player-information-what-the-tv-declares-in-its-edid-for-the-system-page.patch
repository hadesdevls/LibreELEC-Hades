+// Hades: what an HDMI Forum block declares (HdmiForumSink): of two (an HF-VSDB and an HF-SCDB), the
+// most that either says, and the VRR range of the first that gives one
+void TakeHdmiForum(HdmiForumSink& sink, const di_cta_hdmi_scds& scds)
+{
+  sink.declared = true;
+  sink.maxFrlRate = std::max(sink.maxFrlRate, static_cast<unsigned int>(scds.max_frl_rate));
+  if (scds.max_tmds_char_rate_mhz > 0)
+    sink.maxTmdsMhz =
+        std::max(sink.maxTmdsMhz, static_cast<unsigned int>(scds.max_tmds_char_rate_mhz));
+  sink.allm |= scds.supports_allm;
+  sink.qms |= scds.supports_qms;
+  if (scds.vrr_min_hz > 0 && sink.vrrMinHz == 0)
+  {
+    sink.vrrMinHz = static_cast<unsigned int>(scds.vrr_min_hz);
+    sink.vrrMaxHz = scds.vrr_max_hz > 0 ? static_cast<unsigned int>(scds.vrr_max_hz) : 0;
+  }
+}
