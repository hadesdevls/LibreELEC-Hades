+/*!
+ * \brief Hades: the EDID has AMD's vendor-specific data block, with which a display declares
+ *        FreeSync over HDMI: for the player information (what the TV declares)
+ *
+ * A CTA-861 data block of tag 3 (vendor-specific) whose payload starts with AMD's IEEE OUI 00-00-1A,
+ * least significant byte first (1A 00 00), as the kernel finds it (drm_edid.c: AMD_IEEE_OUI and
+ * cea_db_is_vendor()), in a CTA extension block with a right checksum, as far as its data blocks
+ * can be followed. Only that the block is there is read: AMD does not publish its fields, and the
+ * kernel reads those of version 3 only, which say nothing of refresh rates (amd_vsdb_v3_payload).
+ * A display turns it on and off with a setting of its own (FreeSync on an LG TV), and its EDID
+ * changes with it.
+ */
+inline bool EdidDeclaresFreeSync(const std::vector<uint8_t>& edid)
+{
+  const std::size_t size = edid.size();
+  if (size < 256 || size % 128)
+    return false;
+  for (std::size_t block = 1; block < size / 128; ++block)
+  {
+    const uint8_t* b = edid.data() + block * 128;
+    unsigned int sum = 0;
+    for (unsigned int i = 0; i < 128; ++i)
+      sum += b[i];
+    if ((sum & 0xff) != 0 || b[0] != 0x02 || b[1] < 3)
+      continue;
+    const unsigned int end = b[2];
+    if (end < 4 || end > 127)
+      continue;
+    for (unsigned int pos = 4; pos < end && pos + (b[pos] & 31u) + 1 <= end;
+         pos += (b[pos] & 31u) + 1)
+    {
+      if ((b[pos] >> 5) == 3 && (b[pos] & 31u) >= 3 && b[pos + 1] == 0x1a && b[pos + 2] == 0x00 &&
+          b[pos + 3] == 0x00)
+        return true;
+    }
+  }
+  return false;
+}
+
+} // namespace KODI::UTILS
