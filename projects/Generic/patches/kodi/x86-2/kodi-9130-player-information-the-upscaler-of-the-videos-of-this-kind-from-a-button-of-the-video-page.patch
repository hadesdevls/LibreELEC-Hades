+namespace
+{
+// Hades: the setting of the upscaler that decides the video that plays (UpscalerChoice.h: the one
+// that the renderer reads for it), and which of the three it is; false when no video plays or the
+// settings are not there
+bool UpscalerSettingNow(std::string& id, KODI::UPSCALER::From& from)
+{
+  namespace U = KODI::UPSCALER;
+  const auto& components = CServiceBroker::GetAppComponents();
+  const auto appPlayer = components.GetComponent<CApplicationPlayer>();
+  const auto component = CServiceBroker::GetSettingsComponent();
+  const auto settings = component ? component->GetSettings() : nullptr;
+  if (!appPlayer || !appPlayer->IsPlayingVideo() || !settings ||
+      !settings->GetSetting(CSettings::SETTING_VIDEOPLAYER_HADESUPSCALERHD) ||
+      !settings->GetSetting(CSettings::SETTING_VIDEOPLAYER_HADESUPSCALERSD) ||
+      !settings->GetSetting(CSettings::SETTING_VIDEOPLAYER_HADESUPSCALERANIME))
+    return false;
+  auto& cache = CServiceBroker::GetDataCacheCore();
+  const int width = cache.GetVideoWidth();
+  const int height = cache.GetVideoHeight();
+  if (width <= 0 || height <= 0)
+    return false;
+  U::Settings s;
+  s.hd = settings->GetInt(CSettings::SETTING_VIDEOPLAYER_HADESUPSCALERHD);
+  s.sd = settings->GetInt(CSettings::SETTING_VIDEOPLAYER_HADESUPSCALERSD);
+  s.anime = settings->GetInt(CSettings::SETTING_VIDEOPLAYER_HADESUPSCALERANIME);
+  U::Choose(s, width, height, U::PlayingAnimation().load(std::memory_order_relaxed), &from);
+  switch (from)
+  {
+    case U::From::HD:
+      id = CSettings::SETTING_VIDEOPLAYER_HADESUPSCALERHD;
+      break;
+    case U::From::SD:
+      id = CSettings::SETTING_VIDEOPLAYER_HADESUPSCALERSD;
+      break;
+    case U::From::ANIME:
+      id = CSettings::SETTING_VIDEOPLAYER_HADESUPSCALERANIME;
+      break;
+  }
+  return true;
+}
+
+// The values of a setting of the upscaler, in the order of Player > Videos ("same as the other
+// two" only for animation), and their names, the strings of those settings
+std::vector<int> UpscalerValues(KODI::UPSCALER::From from)
+{
+  namespace U = KODI::UPSCALER;
+  std::vector<int> values;
+  if (from == U::From::ANIME)
+    values.push_back(U::SAME_AS_OTHERS);
+  for (const int value : {U::OFF, U::RAVU, U::FSRCNNX8, U::FSRCNNX16})
+    values.push_back(value);
+  return values;
+}
+
+std::string UpscalerValueName(int value)
+{
+  namespace U = KODI::UPSCALER;
+  switch (value)
+  {
+    case U::SAME_AS_OTHERS:
+      return CGUIUtils::GetHadesString(62070, 54070);
+    case U::OFF:
+      return CGUIUtils::GetHadesString(62066, 54066);
+    case U::RAVU:
+      return CGUIUtils::GetHadesString(62067, 54067);
+    case U::FSRCNNX8:
+      return CGUIUtils::GetHadesString(62068, 54068);
+    case U::FSRCNNX16:
+      return CGUIUtils::GetHadesString(62069, 54069);
+    default:
+      return std::to_string(value);
+  }
+}
+
+// the name of the kind of videos on the button, and in the heading of the list (that the
+// setting is for all of them)
+std::string UpscalerScope(KODI::UPSCALER::From from, bool heading)
+{
+  namespace U = KODI::UPSCALER;
+  switch (from)
+  {
+    case U::From::HD:
+      return heading ? CGUIUtils::GetHadesString(62079, 54079)
+                     : CGUIUtils::GetHadesString(62076, 54076);
+    case U::From::SD:
+      return heading ? CGUIUtils::GetHadesString(62080, 54080)
+                     : CGUIUtils::GetHadesString(62077, 54077);
+    case U::From::ANIME:
+      return heading ? CGUIUtils::GetHadesString(62081, 54081)
+                     : CGUIUtils::GetHadesString(62078, 54078);
+  }
+  return {};
+}
+} // namespace
+
+std::string CGUIDialogVideoSettings::UpscalerChoiceName()
+{
+  std::string id;
+  KODI::UPSCALER::From from = KODI::UPSCALER::From::HD;
+  if (!UpscalerSettingNow(id, from))
+    return {};
+  return UpscalerValueName(CServiceBroker::GetSettingsComponent()->GetSettings()->GetInt(id));
+}
+
+std::string CGUIDialogVideoSettings::UpscalerScopeName()
+{
+  std::string id;
+  KODI::UPSCALER::From from = KODI::UPSCALER::From::HD;
+  if (!UpscalerSettingNow(id, from))
+    return {};
+  return UpscalerScope(from, false);
+}
+
+void CGUIDialogVideoSettings::SelectUpscaler()
+{
+  // (Hades: asked for by the button of the Video page of the player information, OK on its Video
+  // tab, or a key of a keymap. The setting is that of Player > Videos for all the videos of the
+  // kind of the one that plays: the list says so in its heading, and the choice is kept there,
+  // as when it is made in the settings; it applies at once, as there)
+  std::string id;
+  KODI::UPSCALER::From from = KODI::UPSCALER::From::HD;
+  if (!UpscalerSettingNow(id, from))
+  {
+    CLog::Log(LOGINFO, "Upscaler: a change was asked for, but no video plays, or the settings of "
+                       "the upscalers are not there");
+    return;
+  }
+  const auto settings = CServiceBroker::GetSettingsComponent()->GetSettings();
+  auto* gui = CServiceBroker::GetGUI();
+  auto* dialog =
+      gui ? gui->GetWindowManager().GetWindow<CGUIDialogSelect>(WINDOW_DIALOG_SELECT) : nullptr;
+  if (!dialog)
+  {
+    CLog::Log(LOGERROR,
+              "Upscaler: a change was asked for: the list dialog of the skin is not there");
+    return;
+  }
+  const std::vector<int> values = UpscalerValues(from);
+  const int current = settings->GetInt(id);
+  dialog->Reset();
+  dialog->SetHeading(CVariant{UpscalerScope(from, true)});
+  int selected = -1;
+  for (size_t i = 0; i < values.size(); ++i)
+  {
+    dialog->Add(UpscalerValueName(values[i]));
+    if (values[i] == current)
+      selected = static_cast<int>(i);
+  }
+  if (selected >= 0)
+    dialog->SetSelected(selected);
+  CLog::Log(LOGINFO, "Upscaler: a change was asked for from the player information: {} ({}) is {}",
+            id, KODI::UPSCALER::FromName(from), UpscalerValueName(current));
+  dialog->Open();
+  // only what the user chose: a list closed another way changes nothing
+  const int chosen = dialog->IsConfirmed() ? dialog->GetSelectedItem() : -1;
+  if (chosen < 0 || chosen >= static_cast<int>(values.size()) || values[chosen] == current)
+  {
+    CLog::Log(LOGINFO, "Upscaler: the list was closed without a change");
+    return;
+  }
+  settings->SetInt(id, values[chosen]);
+  settings->Save();
+  CLog::Log(LOGINFO,
+            "Upscaler: {} set to {} from the player information, for every video of its "
+            "kind (it applies at once)",
+            id, UpscalerValueName(values[chosen]));
+}
