From e5560ebcff75ff3e7380ed824e7dfb2f715d336c Mon Sep 17 00:00:00 2001
From: Hades <15710513+hadesdevls@users.noreply.github.com>
Date: Tue, 24 Nov 2026 20:58:38 +0000
Subject: [PATCH] AEStreamParser: a DTS header whose channel arrangement has no
 entry is no header

SyncDTS() reads AMODE, a field of six bits (0 to 63), and indexes
DTSChannels[] with it, a table of 16 entries: a value of 16 or more read
past the table and took whatever followed it as the number of channels
of the stream. Values 16 to 63 are user defined in ETSI TS 102 114, so
no number of channels can be had from them, and the parser looks for a
sync word in any bytes: a false sync is the likelier way there.

Such a header is now skipped, next to the checks of the sample rate and
of the frame size that are there for the same reason.

Found by SamuriHL (SamuriHL/coreelec-xbmc commit b09f7a5763, "ae: reject
a DTS header whose channel mode has no table entry"), from a review of
avdvplus R10.
---
 xbmc/cores/AudioEngine/Utils/AEStreamInfo.cpp |  7 +++
 .../Utils/test/TestAEStreamParser.cpp         | 43 +++++++++++++++++++
 2 files changed, 50 insertions(+)

diff --git a/xbmc/cores/AudioEngine/Utils/AEStreamInfo.cpp b/xbmc/cores/AudioEngine/Utils/AEStreamInfo.cpp
index 0f88c69..79217ca 100644
--- a/xbmc/cores/AudioEngine/Utils/AEStreamInfo.cpp
+++ b/xbmc/cores/AudioEngine/Utils/AEStreamInfo.cpp
@@ -11,6 +11,7 @@
 #include "utils/log.h"
 
 #include <algorithm>
+#include <iterator>
 #include <string.h>
 
 #define DTS_PREAMBLE_14BE 0x1FFFE800
@@ -602,6 +603,12 @@ unsigned int CAEStreamParser::SyncDTS(uint8_t* data, unsigned int size)
     if (sfreq == 0 || sfreq >= DTS_SFREQ_COUNT)
       continue;
 
+    // Hades: AMODE has six bits, and only its first 16 values have a channel arrangement
+    // (DTSChannels[]); the others are user defined, and a false sync is likelier than a stream
+    // that uses one: a header with one is no DTS header
+    if (amode >= std::size(DTSChannels))
+      continue;
+
     // make sure the framesize is sane
     if (m_fsize < 96 || m_fsize > 16384)
       continue;
diff --git a/xbmc/cores/AudioEngine/Utils/test/TestAEStreamParser.cpp b/xbmc/cores/AudioEngine/Utils/test/TestAEStreamParser.cpp
index a94baf1..1351fa4 100644
--- a/xbmc/cores/AudioEngine/Utils/test/TestAEStreamParser.cpp
+++ b/xbmc/cores/AudioEngine/Utils/test/TestAEStreamParser.cpp
@@ -448,3 +448,46 @@ TEST(TestAEStreamParser, AFrameLargerThanTheParserIsNotWaitedFor)
   EXPECT_GE(frames, 8u);
   EXPECT_LT(backlog.size(), 2 * (CORE_SIZE + HD_SIZE));
 }
+
+namespace
+{
+//! A core frame whose AMODE (6 bits: the low nibble of byte 7, the two high bits of byte 8) is
+//! \p amode; the sample rate bits of byte 8 stay
+std::vector<uint8_t> CoreFrameWithAmode(unsigned int amode)
+{
+  std::vector<uint8_t> frame = CoreFrame();
+  frame[7] = static_cast<uint8_t>((frame[7] & 0xF0) | ((amode >> 2) & 0x0F));
+  frame[8] = static_cast<uint8_t>((frame[8] & 0x3F) | ((amode & 0x3) << 6));
+  return frame;
+}
+} // namespace
+
+//! Hades: AMODE 16 to 63 has no channel arrangement (user defined; DTSChannels[] has 16 entries):
+//! such a header is no DTS header. The number of channels was read from past the end of the table.
+TEST(TestAEStreamParser, ADtsHeaderWhoseAmodeHasNoArrangementIsNotTaken)
+{
+  for (const unsigned int amode : {16u, 37u, 63u})
+  {
+    std::vector<uint8_t> stream;
+    for (int i = 0; i < 4; ++i)
+      Append(stream, CoreFrameWithAmode(amode));
+
+    EXPECT_TRUE(Parse(stream).empty()) << "AMODE " << amode;
+  }
+}
+
+//! ... and the last one that has, 15 (eight channels), is taken as before
+TEST(TestAEStreamParser, ADtsHeaderWithTheLastArrangementIsTaken)
+{
+  std::vector<uint8_t> stream;
+  for (int i = 0; i < 4; ++i)
+    Append(stream, CoreFrameWithAmode(15));
+
+  CAEStreamParser parser;
+  uint8_t* out = nullptr;
+  unsigned int outSize = 0;
+  parser.AddData(stream.data(), static_cast<unsigned int>(stream.size()), &out, &outSize);
+  ASSERT_GT(outSize, 0u);
+  EXPECT_EQ(CAEStreamInfo::STREAM_TYPE_DTS_512, parser.GetDataType());
+  EXPECT_EQ(9u, parser.GetStreamInfo().m_channels); // 8 and the LFE
+}
-- 
