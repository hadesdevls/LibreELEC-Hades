From 9a8f990feb7e42c4ef1213c344e8fc39af69e4bf Mon Sep 17 00:00:00 2001
From: Hades <15710513+hadesdevls@users.noreply.github.com>
Date: Wed, 18 Nov 2026 01:06:07 +0000
Subject: [PATCH] VideoPlayer: a Blu-ray page already shown takes a new range
 of the disc's graphics

The graphics of a disc are taken in the range of the video of the play
item (PQ on an HDR10 or Dolby Vision playlist of an Ultra HD Blu-ray) and,
before a playlist is known, in the one the disc declares for its start
(index.bdmv). That held only for what was drawn after the range was set:
libbluray draws a page once, and some Ultra HD discs declare SDR at their
start although their film and the graphics their BD-J application draws
are HDR10. A page drawn before the first play item stayed taken as SDR when
the play item said PQ (its white a grey at about a quarter of its
brightness, as fandangos reported in issue #211 of CroqueMr's build for
three UHD Blu-ray discs)
until the disc drew it again.

When the range or the matrix of the disc's graphics changes, what its
planes hold is made again as they now say, and given to the player again
once where anything of it shows, with a line in kodi.log. The images the
player has are never changed (the renderer may be drawing them): the plane
takes copies, each with a texture of its own. An image of an HDMV menu,
whose colours come from a palette, keeps the palette as the disc gave it
(CDVDOverlayImage::paletteSource, which the part of an image that a later
draw leaves keeps too), so that its colours are made again for the new
range or matrix, byte for byte as they would have been drawn so; an image
of BD-J is told its new range. Nothing changes for a disc whose range and
matrix stay as they were.

Tested on the host with Kodi's own CDVDOverlayImage: the palette made from
what is kept against the one made from the disc's entries (byte for byte,
every range and matrix), a BD-J page and an HDMV page across SDR and PQ, a
change of matrix alone, the part of an image, an image without its
palette kept, and the image the player has left unchanged; seven mutants,
each caught. Not run with a disc.
---
 .../DVDCodecs/Overlay/DVDOverlayImage.h       |  6 ++
 .../DVDInputStreams/BlurayGraphicsRange.h     | 60 +++++++++++++++++++
 .../DVDInputStreams/DVDInputStreamBluray.cpp  | 56 +++++++++++++++--
 .../DVDInputStreams/DVDInputStreamBluray.h    |  4 ++
 4 files changed, 120 insertions(+), 6 deletions(-)

diff --git a/xbmc/cores/VideoPlayer/DVDCodecs/Overlay/DVDOverlayImage.h b/xbmc/cores/VideoPlayer/DVDCodecs/Overlay/DVDOverlayImage.h
index ce06a52..af65072 100644
--- a/xbmc/cores/VideoPlayer/DVDCodecs/Overlay/DVDOverlayImage.h
+++ b/xbmc/cores/VideoPlayer/DVDCodecs/Overlay/DVDOverlayImage.h
@@ -45,6 +45,7 @@ public:
     source_width = src.source_width;
     source_height = src.source_height;
     m_isHDROverlay = src.m_isHDROverlay;
+    paletteSource = src.paletteSource;
 
     pixels.resize(static_cast<size_t>(sub_h) * linesize);
 
@@ -80,6 +81,11 @@ public:
   // pixels are already HDR, matching video's colorimetry
   bool m_isHDROverlay{false};
 
+  //! Hades: the entries of the palette as the source gave them, where palette was made from them for
+  //! a range and a matrix that may change while the image is shown: the menus of a Blu-ray disc,
+  //! Y | Cr << 8 | Cb << 16 | T << 24 (KODI::BLURAYGRAPHICS::Remade()); none for any other image
+  std::shared_ptr<const std::vector<uint32_t>> paletteSource;
+
   int linesize{0};
   int x{0};
   int y{0};
diff --git a/xbmc/cores/VideoPlayer/DVDInputStreams/BlurayGraphicsRange.h b/xbmc/cores/VideoPlayer/DVDInputStreams/BlurayGraphicsRange.h
index 3411084..883f568 100644
--- a/xbmc/cores/VideoPlayer/DVDInputStreams/BlurayGraphicsRange.h
+++ b/xbmc/cores/VideoPlayer/DVDInputStreams/BlurayGraphicsRange.h
@@ -11,6 +11,8 @@
 #include "PlatformDefs.h"
 
 #include <cstdint>
+#include <memory>
+#include <vector>
 
 namespace KODI::BLURAYGRAPHICS
 {
@@ -143,4 +145,62 @@ constexpr uint32_t PaletteEntryToRGBA(
                       1.164 * (y - 16) - 0.391 * (cb - 128) - 0.813 * (cr - 128),
                       1.164 * (y - 16) + 2.018 * (cb - 128));
 }
+
+//! (Hades) An entry of a palette as the disc gives it, kept with the image it colours
+//! (CDVDOverlayImage::paletteSource), so that the colours can be made again for another range
+constexpr uint32_t PaletteSourceEntry(uint8_t y, uint8_t cr, uint8_t cb, uint8_t t)
+{
+  return static_cast<uint32_t>(y) | static_cast<uint32_t>(cr) << 8 |
+         static_cast<uint32_t>(cb) << 16 | static_cast<uint32_t>(t) << 24;
+}
+
+//! (Hades) The colours of a palette kept as the disc gave it (PaletteSourceEntry()), for a range
+//! and a matrix
+inline std::vector<uint32_t> PaletteFromSource(const std::vector<uint32_t>& source,
+                                               Range range,
+                                               Matrix matrix)
+{
+  std::vector<uint32_t> palette;
+  palette.reserve(source.size());
+  for (const uint32_t e : source)
+    palette.push_back(PaletteEntryToRGBA(static_cast<uint8_t>(e), static_cast<uint8_t>(e >> 8),
+                                         static_cast<uint8_t>(e >> 16),
+                                         static_cast<uint8_t>(e >> 24), range, matrix));
+  return palette;
+}
+
+/*!
+ * \brief (Hades) An image of the disc's graphics that is shown already, as the range and the matrix
+ *        the disc's graphics are taken in now make it: a copy where it is not that, else nothing
+ *
+ * libbluray draws a page of a menu once, and draws it again only when the page changes. A BD-J
+ * application (or a menu of HDMV) that shows a page before the first play item of a playlist draws
+ * it in the range the disc declares for its start (index.bdmv), and some Ultra HD discs declare SDR
+ * there although their film, and the graphics they draw, are HDR10 (issue #211 of CroqueMr's build,
+ * by fandangos: The Call of the Wild, Avatar: Fire and Ash, The Devil Wears Prada 2). When the play
+ * item then tells PQ, the page stayed as it was drawn, taken as SDR: its white a grey at about a
+ * quarter of its brightness, until the disc drew it again. An image whose colours come from a
+ * palette has them made again from the palette as the disc gave it (CDVDOverlayImage::paletteSource);
+ * without that (an image made before it was kept), only its range is told again. The image the
+ * player has is never changed (the renderer may be drawing it): the plane takes the copy, and the
+ * player is given the planes again.
+ * \return the copy, or nullptr where the image is as the range and the matrix make it
+ */
+template<typename Image>
+std::shared_ptr<Image> Remade(const Image& image, Range range, Matrix matrix)
+{
+  const bool pq = range == Range::PQ;
+  std::vector<uint32_t> palette;
+  const bool fromSource = image.paletteSource && !image.palette.empty() &&
+                          image.paletteSource->size() == image.palette.size();
+  if (fromSource)
+    palette = PaletteFromSource(*image.paletteSource, range, matrix);
+  if (image.m_isHDROverlay == pq && (!fromSource || palette == image.palette))
+    return nullptr;
+  auto copy = std::make_shared<Image>(image, image.x, image.y, image.width, image.height);
+  copy->m_isHDROverlay = pq;
+  if (fromSource)
+    copy->palette = std::move(palette);
+  return copy;
+}
 } // namespace KODI::BLURAYGRAPHICS
diff --git a/xbmc/cores/VideoPlayer/DVDInputStreams/DVDInputStreamBluray.cpp b/xbmc/cores/VideoPlayer/DVDInputStreams/DVDInputStreamBluray.cpp
index 6c2ed24..9373e23 100644
--- a/xbmc/cores/VideoPlayer/DVDInputStreams/DVDInputStreamBluray.cpp
+++ b/xbmc/cores/VideoPlayer/DVDInputStreams/DVDInputStreamBluray.cpp
@@ -1530,6 +1530,8 @@ void CDVDInputStreamBluray::SetGraphicsRange(KODI::BLURAYGRAPHICS::Range range,
             "CDVDInputStreamBluray - the graphics of the disc (its menus, what BD-J draws) are "
             "taken as {}, as {} says",
             KODI::BLURAYGRAPHICS::RangeName(range), from);
+  // Hades: and so is what the disc shows already (a page drawn before this play item)
+  RemakeShownGraphics();
 }
 
 void CDVDInputStreamBluray::SetGraphicsMatrix(KODI::BLURAYGRAPHICS::Matrix matrix, const char* from)
@@ -1542,6 +1544,46 @@ void CDVDInputStreamBluray::SetGraphicsMatrix(KODI::BLURAYGRAPHICS::Matrix matri
             "CDVDInputStreamBluray - the palettes of the disc's graphics in SDR (its menus) are "
             "in the {} matrix, the one of {}",
             KODI::BLURAYGRAPHICS::MatrixName(matrix), from);
+  RemakeShownGraphics();
+}
+
+void CDVDInputStreamBluray::RemakeShownGraphics()
+{
+#if (BD_OVERLAY_INTERFACE_VERSION >= 2)
+  // (set before the lock: an image drawn meanwhile by an overlay callback takes the new range
+  // itself, and one drawn before it is on a plane by now)
+  const KODI::BLURAYGRAPHICS::Range range = m_graphicsRange;
+  const KODI::BLURAYGRAPHICS::Matrix matrix = m_graphicsMatrix;
+  std::unique_lock lock(m_overlayLock);
+  unsigned int remade = 0;
+  for (SPlane& plane : m_planes)
+  {
+    for (SOverlay& image : plane.o)
+    {
+      if (!image)
+        continue;
+      if (SOverlay copy = KODI::BLURAYGRAPHICS::Remade(*image, range, matrix))
+      {
+        image = std::move(copy);
+        ++remade;
+      }
+    }
+  }
+  if (remade == 0)
+    return;
+  // Once, as the disc would have flushed them (only what draws anything is given: OverlayFlush());
+  // nothing is given where nothing shows
+  const bool shows = PlaneShows(m_planes[0]) || PlaneShows(m_planes[1]) ||
+                     (m_bgVisible && PlaneShows(m_planes[2]));
+  CLog::Log(LOGINFO,
+            "CDVDInputStreamBluray - {} image(s) that the disc shows already were drawn before "
+            "its graphics were taken as {}: they are made again so{}",
+            remade, KODI::BLURAYGRAPHICS::RangeName(range),
+            shows ? ", and given to the player again"
+                  : " (nothing of them shows now: given with the next flush of the disc)");
+  if (shows)
+    OverlayFlush(-1);
+#endif
 }
 
 void CDVDInputStreamBluray::OverlayClose()
@@ -1750,12 +1792,14 @@ void CDVDInputStreamBluray::OverlayCallback(const BD_OVERLAY * const ov)
 
     if (ov->palette)
     {
-      overlay->palette.resize(256);
-
-      for(unsigned i = 0; i < 256; i++)
-        overlay->palette[i] = KODI::BLURAYGRAPHICS::PaletteEntryToRGBA(
-            ov->palette[i].Y, ov->palette[i].Cr, ov->palette[i].Cb, ov->palette[i].T, range,
-            matrix);
+      // Hades: the palette as the disc gives it is kept with the image, for a range or a matrix
+      // that changes while it is shown (RemakeShownGraphics())
+      auto source = std::make_shared<std::vector<uint32_t>>(256);
+      for (unsigned i = 0; i < 256; i++)
+        (*source)[i] = KODI::BLURAYGRAPHICS::PaletteSourceEntry(
+            ov->palette[i].Y, ov->palette[i].Cr, ov->palette[i].Cb, ov->palette[i].T);
+      overlay->palette = KODI::BLURAYGRAPHICS::PaletteFromSource(*source, range, matrix);
+      overlay->paletteSource = std::move(source);
     }
     else
       overlay->palette.clear();
diff --git a/xbmc/cores/VideoPlayer/DVDInputStreams/DVDInputStreamBluray.h b/xbmc/cores/VideoPlayer/DVDInputStreams/DVDInputStreamBluray.h
index 3bbaab0..6e916b5 100644
--- a/xbmc/cores/VideoPlayer/DVDInputStreams/DVDInputStreamBluray.h
+++ b/xbmc/cores/VideoPlayer/DVDInputStreams/DVDInputStreamBluray.h
@@ -391,6 +391,10 @@ protected:
   //! Hades: (player thread) the matrix of the palettes of the disc's graphics in SDR is matrix,
   //! as from says; each change is told in the log
   void SetGraphicsMatrix(KODI::BLURAYGRAPHICS::Matrix matrix, const char* from);
+  //! Hades: (player thread) what the planes hold already, drawn before the range or the matrix
+  //! changed, is made again as they are now (KODI::BLURAYGRAPHICS::Remade()), and given to the
+  //! player again once where it shows anything; told in the log
+  void RemakeShownGraphics();
 
   IVideoPlayer* m_player = nullptr;
   BLURAY* m_bd = nullptr;
-- 
