From f4561ed6fba3a3c7a38086fdbdff8e907449583e Mon Sep 17 00:00:00 2001
From: Hades <15710513+hadesdevls@users.noreply.github.com>
Date: Wed, 18 Nov 2026 01:25:27 +0000
Subject: [PATCH] VideoPlayer: do not wait in a flush for a stream player that
 is not open

CVideoPlayer::FlushBuffers() sends both stream players a
CDVDMsgGeneralSynchronize of 1 s for audio and video, and waits until
both have taken it. A player whose stream is not open has no queue: its
Put() refuses the message (MSGQ_NOT_INITIALIZED, a warning in the log)
and no thread of it answers, so the wait ran to the end of the second
each time. That is each seek, chapter jump and resume of a file with no
audio stream or no video stream (audio-only streams that VideoPlayer
plays, live radio), and each flush while a disc changes playlists with
one of its streams closed.

Measured on the host with the code of the tree (the class and its two
Wait() taken word for word from DVDMessage.cpp, a player thread that
answers as CVideoPlayerVideo::Process() does): both players open, 5 ms;
one not open, 1000 ms (1002 with the audio player alone); the open one
alone asked, 5 ms.

Only the players whose stream is open (IsInited(): their queue was
opened by OpenStream() and not ended by CloseStream(), which the player
thread of FlushBuffers() itself does) are sent the message and waited
for, with the same second as before; with none open there is nothing to
wait for. A player that is open is waited for as before, so nothing that
it plays loses its place or its sync. The log says at INFO, when it
changes, which player a flush does not wait for.

Found by CroqueMr in CB1 (bdc8357a41, "a Blu-ray handover waited 1 s").
---
 xbmc/cores/VideoPlayer/VideoPlayer.cpp | 36 +++++++++++++++++++++++---
 xbmc/cores/VideoPlayer/VideoPlayer.h   |  3 +++
 2 files changed, 35 insertions(+), 4 deletions(-)

diff --git a/xbmc/cores/VideoPlayer/VideoPlayer.cpp b/xbmc/cores/VideoPlayer/VideoPlayer.cpp
index 5d937df..38089df 100644
--- a/xbmc/cores/VideoPlayer/VideoPlayer.cpp
+++ b/xbmc/cores/VideoPlayer/VideoPlayer.cpp
@@ -6425,10 +6425,38 @@ void CVideoPlayer::FlushBuffers(double pts, bool accurate, bool sync)
       m_processInfo->IsTempoAllowed(static_cast<float>(m_playSpeed) / DVD_PLAYSPEED_NORMAL))
   {
     // make sure players are properly flushed, should put them in stalled state
-    auto msg = std::make_shared<CDVDMsgGeneralSynchronize>(1s, SYNCSOURCE_AUDIO | SYNCSOURCE_VIDEO);
-    m_VideoPlayerAudio->SendMessage(msg, 1);
-    m_VideoPlayerVideo->SendMessage(msg, 1);
-    msg->Wait(m_bStop, 0);
+    // Hades: only the stream players whose stream is open take part. One whose stream is not open
+    // has no queue (Put() refuses the message: MSGQ_NOT_INITIALIZED) and no thread to answer, and
+    // this waited the whole second of the message for it (measured on the host with this code:
+    // 1000 ms, against 5 ms with the open one alone): at each seek of a file with no audio or no
+    // video, and at each flush while a disc changes playlists. Found by CroqueMr (CB1).
+    unsigned int sources = 0;
+    if (m_VideoPlayerAudio->IsInited())
+      sources |= SYNCSOURCE_AUDIO;
+    if (m_VideoPlayerVideo->IsInited())
+      sources |= SYNCSOURCE_VIDEO;
+    if (sources != 0)
+    {
+      auto msg = std::make_shared<CDVDMsgGeneralSynchronize>(1s, sources);
+      if (sources & SYNCSOURCE_AUDIO)
+        m_VideoPlayerAudio->SendMessage(msg, 1);
+      if (sources & SYNCSOURCE_VIDEO)
+        m_VideoPlayerVideo->SendMessage(msg, 1);
+      msg->Wait(m_bStop, 0);
+    }
+    // (in the log when the players left out change)
+    const unsigned int notOpen = ~sources & (SYNCSOURCE_AUDIO | SYNCSOURCE_VIDEO);
+    if (notOpen != m_flushNotOpenTold)
+    {
+      m_flushNotOpenTold = notOpen;
+      if (notOpen != 0)
+        CLog::Log(LOGINFO,
+                  "VideoPlayer: a flush of the buffers does not wait for the {} player, whose "
+                  "stream is not open (it waited 1 s for it before)",
+                  notOpen == SYNCSOURCE_AUDIO   ? "audio"
+                  : notOpen == SYNCSOURCE_VIDEO ? "video"
+                                                : "audio and the video");
+    }
 
     // purge any pending PLAYER_STARTED messages
     m_messenger.Flush(CDVDMsg::PLAYER_STARTED);
diff --git a/xbmc/cores/VideoPlayer/VideoPlayer.h b/xbmc/cores/VideoPlayer/VideoPlayer.h
index bcbccae..41ed654 100644
--- a/xbmc/cores/VideoPlayer/VideoPlayer.h
+++ b/xbmc/cores/VideoPlayer/VideoPlayer.h
@@ -809,6 +809,9 @@ protected:
   XbmcThreads::EndTime<> m_syncTimer;
 
   std::optional<std::chrono::steady_clock::time_point> m_syncStartPtsWait;
+  //! Hades: the stream players that the last flush did not wait for, their stream not open
+  //! (SYNCSOURCE_AUDIO, SYNCSOURCE_VIDEO), as the log said it last (FlushBuffers())
+  unsigned int m_flushNotOpenTold{0};
 
   //! Hades: OnInputWait(), given to the input around the reads of packets (ReadPacket())
   const std::function<void(std::chrono::milliseconds)> m_inputWaitFn{
-- 
