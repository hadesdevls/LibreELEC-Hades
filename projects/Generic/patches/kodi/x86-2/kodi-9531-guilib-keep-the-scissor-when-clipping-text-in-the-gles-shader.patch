From 1aeacfc2e0dfe0181491886317952481bcf6dd37 Mon Sep 17 00:00:00 2001
From: =?UTF-8?q?Markus=20H=C3=A4rer?= <markus.haerer@gmx.net>
Date: Mon, 9 Nov 2026 23:59:49 +0100
Subject: [PATCH] [guilib] Keep the scissor when clipping text in the GLES
 shader

When text can't be clipped with the scissor, the GLES font renderer clips
it in the shader and reset the scissor to the full screen without
restoring it. Everything rendered afterwards in the pass ignored the
scissor, so partial redraws of dirty regions drew over the rest of the
screen, e.g. translucent overlays darkening it a bit more every frame.

The shader clips the text on its own, so keep the current scissor.

(cherry picked from commit 64db80713de0ab2e6bb873545232a3266ac7d2ca)
(cherry picked from commit 94eb842d728d9ead9422c366eadefa1457708388)
---
 xbmc/guilib/GUIFontTTFGLES.cpp | 3 ---
 1 file changed, 3 deletions(-)

diff --git a/xbmc/guilib/GUIFontTTFGLES.cpp b/xbmc/guilib/GUIFontTTFGLES.cpp
index 720788f..ddf4912 100644
--- a/xbmc/guilib/GUIFontTTFGLES.cpp
+++ b/xbmc/guilib/GUIFontTTFGLES.cpp
@@ -71,7 +71,6 @@ bool CGUIFontTTFGLES::FirstBegin()
   else
   {
     m_scissorClip = false;
-    renderSystem->ResetScissors();
     renderSystem->EnableGUIShader(ShaderMethodGLES::SM_FONTS_SHADER_CLIP);
   }
 
@@ -197,8 +196,6 @@ void CGUIFontTTFGLES::LastEnd()
       else
       {
         // clip using vertex shader
-        renderSystem->ResetScissors();
-
         const float clipBoundaries[4] = {
             (m_vertexTrans[i].m_clip.x1 - m_vertexTrans[i].m_translateX -
              m_vertexTrans[i].m_offsetX) /
