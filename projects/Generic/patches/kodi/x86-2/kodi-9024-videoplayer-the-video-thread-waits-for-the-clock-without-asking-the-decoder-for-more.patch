From 0ade608ef91a35cb239a095104d729adfd531d9e Mon Sep 17 00:00:00 2001
From: Hades <15710513+hadesdevls@users.noreply.github.com>
Date: Wed, 18 Nov 2026 03:36:46 +0000
Subject: [PATCH] VideoPlayer: the video thread waits for the clock without
 asking the decoder for more

Once its first picture is out, the video thread waits for the player to start
the clock (SYNC_WAITSYNC). Each time its wait for that message timed out
(every ten frame times), it asked the decoder for another picture and, with
one, waited up to 500 ms for a buffer of the renderer to put it in
(OutputPicture()); the clock's message that came meanwhile was taken that
much later, and the video began behind the clock it had just set.

Measured in a VM (software decoding of MPEG-2, from a CDN-like server and from
one that sends at 450 KiB/s): the message was taken in the same millisecond
it was sent in all 8 starts and seeks, as the decoder had no further picture
then; the 500 ms wait was seen with the video waiting for a clock that did
not come (a seek whose source was refused). A decoder that holds more
pictures (hardware decoding) can be in that wait when the message comes.
Now nothing is asked of the decoder while the clock is waited for; what it
has is taken once the clock runs, with its own times, so the cadence and the
sync do not change. One INFO line at each start and seek says how long the
video waited for the clock after its first picture. Credit: CroqueMr
(38a3cfd0a3).
---
 xbmc/cores/VideoPlayer/VideoPlayerVideo.cpp | 20 ++++++++++++++++++++
 xbmc/cores/VideoPlayer/VideoPlayerVideo.h   |  3 +++
 2 files changed, 23 insertions(+)

diff --git a/xbmc/cores/VideoPlayer/VideoPlayerVideo.cpp b/xbmc/cores/VideoPlayer/VideoPlayerVideo.cpp
index 1be1cb0..bfd588d 100644
--- a/xbmc/cores/VideoPlayer/VideoPlayerVideo.cpp
+++ b/xbmc/cores/VideoPlayer/VideoPlayerVideo.cpp
@@ -393,6 +393,15 @@ void CVideoPlayerVideo::Process()
     }
     else if (ret == MSGQ_TIMEOUT)
     {
+      // Hades: the first picture is out and the player is about to start the clock (WAITSYNC): only
+      // its message is waited for. Asking the decoder for the next picture here, or waiting up to
+      // 500 ms for a buffer of the renderer to put it in (OutputPicture()), held the thread when the
+      // clock's message came, and the video began behind the clock that it had just set (measured
+      // with a source that sends slowly, kodi.log "in step with the clock"). What the decoder has
+      // is taken once the clock runs. (Idea of CroqueMr's build, 38a3cfd0a3.)
+      if (m_syncState == IDVDStreamPlayer::SYNC_WAITSYNC)
+        continue;
+
       if (m_outputSate == OUTPUT_AGAIN &&
           m_picture.videoBuffer)
       {
@@ -461,6 +470,16 @@ void CVideoPlayerVideo::Process()
     {
       pts = std::static_pointer_cast<CDVDMsgDouble>(pMsg)->m_value;
 
+      // Hades: how long the video waited for the clock after its first picture (one line per
+      // start and seek: a long wait is the player filling its buffers from a slow source)
+      if (m_syncState == IDVDStreamPlayer::SYNC_WAITSYNC)
+        CLog::Log(LOGINFO,
+                  "CVideoPlayerVideo - in step with the clock {} ms after its first picture was "
+                  "ready (the decoder was left alone meanwhile)",
+                  std::chrono::duration_cast<std::chrono::milliseconds>(
+                      std::chrono::steady_clock::now() - m_waitSyncSince)
+                      .count());
+
       m_syncState = IDVDStreamPlayer::SYNC_INSYNC;
       m_droppingStats.Reset();
       m_rewindStalled = false;
@@ -919,6 +938,7 @@ bool CVideoPlayerVideo::ProcessDecoderOutput(double &frametime, double &pts)
         !(m_picture.iFlags & DVP_FLAG_DROPPED))
     {
       m_syncState = IDVDStreamPlayer::SYNC_WAITSYNC;
+      m_waitSyncSince = std::chrono::steady_clock::now(); // (Hades)
       SStartMsg msg;
       msg.player = VideoPlayer_VIDEO;
       msg.cachetime = DVD_MSEC_TO_TIME(50); //! @todo implement
diff --git a/xbmc/cores/VideoPlayer/VideoPlayerVideo.h b/xbmc/cores/VideoPlayer/VideoPlayerVideo.h
index f8f8800..60a3880 100644
--- a/xbmc/cores/VideoPlayer/VideoPlayerVideo.h
+++ b/xbmc/cores/VideoPlayer/VideoPlayerVideo.h
@@ -22,6 +22,7 @@
 #include "utils/BitstreamStats.h"
 
 #include <atomic>
+#include <chrono>
 
 #define DROP_DROPPED 1
 #define DROP_VERYLATE 2
@@ -131,6 +132,8 @@ protected:
   int m_speed;
   std::atomic_bool m_stalled = false;
   std::atomic_bool m_rewindStalled;
+  //! Hades: when the first picture was out and the clock began to be waited for (SYNC_WAITSYNC)
+  std::chrono::steady_clock::time_point m_waitSyncSince;
   bool m_paused;
   IDVDStreamPlayer::ESyncState m_syncState;
   std::atomic_bool m_bAbortOutput;
-- 
