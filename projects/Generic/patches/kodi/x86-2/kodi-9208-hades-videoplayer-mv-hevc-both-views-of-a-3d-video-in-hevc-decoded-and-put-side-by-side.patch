+//! profile_tier_level() (ITU-T H.265 7.3.3), skipped
+inline void SkipProfileTierLevel(Rbsp& bits, bool profilePresent, unsigned int maxSubLayersMinus1)
+{
+  // general_profile_space to general_inbld_flag: 88 bits whatever the profile says
+  if (profilePresent)
+    bits.Skip(88);
+  bits.Skip(8); // general_level_idc
+  bool profile[8] = {};
+  bool level[8] = {};
+  for (unsigned int i = 0; i < maxSubLayersMinus1; ++i)
+  {
+    profile[i] = bits.Bit();
+    level[i] = bits.Bit();
+  }
+  if (maxSubLayersMinus1 > 0)
+    bits.Skip(2 * (8 - maxSubLayersMinus1)); // reserved_zero_2bits
+  for (unsigned int i = 0; i < maxSubLayersMinus1; ++i)
+  {
+    if (profile[i])
+      bits.Skip(88);
+    if (level[i])
+      bits.Skip(8);
+  }
