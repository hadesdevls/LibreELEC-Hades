+/*!
+ * \brief The bits of a NAL unit as its syntax has them: without the bytes that the stream
+ *        inserts so that no start code stands inside a unit (emulation_prevention_three_byte)
+ *
+ * Reading past the end gives zeros and is remembered: a field that was not all there makes the
+ * whole reading worth nothing (Ok()).
+ */
+class Rbsp
+{
+public:
+  //! \param skip bytes of the unit not read (its header)
+  Rbsp(const uint8_t* nal, size_t size, size_t skip)
+  {
+    m_data.reserve(size);
+    unsigned int zeros = 0;
+    for (size_t i = skip; i < size; ++i)
+    {
+      if (zeros >= 2 && nal[i] == 3)
+      {
+        zeros = 0;
+        continue;
+      }
+      m_data.push_back(nal[i]);
+      zeros = nal[i] == 0 ? zeros + 1 : 0;
+    }
+  }
+
+  uint32_t Bits(unsigned int count)
+  {
+    uint32_t value = 0;
+    for (unsigned int i = 0; i < count; ++i)
+    {
+      uint32_t bit = 0;
+      if (m_bit / 8 < m_data.size())
+        bit = (m_data[m_bit / 8] >> (7 - m_bit % 8)) & 1;
+      else
+        m_overrun = true;
+      ++m_bit;
+      value = value << 1 | bit;
+    }
+    return value;
+  }
+  bool Bit() { return Bits(1) != 0; }
+  void Skip(size_t count)
+  {
+    m_bit += count;
+    if (m_bit > 8 * m_data.size())
+      m_overrun = true;
+  }
+  //! An Exp-Golomb code (ue(v)) of up to 31 leading zeros; a longer one is no reading
+  uint32_t Ue()
+  {
+    unsigned int zeros = 0;
+    while (!Bit())
+    {
+      if (++zeros > 31 || m_overrun)
+      {
+        m_overrun = true;
+        return 0;
+      }
+    }
+    return static_cast<uint32_t>((uint64_t{1} << zeros) - 1 + Bits(zeros));
+  }
+  void Align() { m_bit = (m_bit + 7) / 8 * 8; }
+  bool Ok() const { return !m_overrun; }
+
+private:
+  std::vector<uint8_t> m_data;
+  size_t m_bit{0};
+  bool m_overrun{false};
+};
