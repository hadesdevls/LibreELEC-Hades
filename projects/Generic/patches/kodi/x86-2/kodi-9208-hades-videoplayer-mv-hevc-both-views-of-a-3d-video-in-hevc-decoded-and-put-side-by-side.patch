+    bits.Ue(); // bit_rate_value_minus1
+    bits.Ue(); // cpb_size_value_minus1
+    if (subPicture)
+    {
+      bits.Ue(); // cpb_size_du_value_minus1
+      bits.Ue(); // bit_rate_du_value_minus1
+    }
