+  const uint32_t layerSetsMinus1 = bits.Ue();
+  if (layerSetsMinus1 > 1)
+    return std::nullopt;
+  bits.Skip(static_cast<size_t>(layerSetsMinus1) * (maxLayerId + 1)); // layer_id_included_flag
+  if (bits.Bit()) // vps_timing_info_present_flag
+  {
+    bits.Skip(32 + 32); // vps_num_units_in_tick, vps_time_scale
+    if (bits.Bit()) // vps_poc_proportional_to_timing_flag
+      bits.Ue();
+    const uint32_t hrdCount = bits.Ue();
+    if (hrdCount > layerSetsMinus1 + 1)
