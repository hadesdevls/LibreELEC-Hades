+const AVCodec* KODI::MULTIVIEW::DecoderOfTwoViews(int codecId)
+{
+  if (codecId == AV_CODEC_ID_H264)
+    return avcodec_find_decoder_by_name(DECODER_NAME);
+  if (codecId != AV_CODEC_ID_HEVC)
+    return nullptr;
+  const AVCodec* decoder = avcodec_find_decoder_by_name(HEVC_DECODER_NAME);
+  if (!decoder || !decoder->priv_class ||
+      !av_opt_find(const_cast<void*>(static_cast<const void*>(&decoder->priv_class)),
+                   DECODER_VIEWS_OPTION, nullptr, 0, AV_OPT_SEARCH_FAKE_OBJ))
+    return nullptr;
+  return decoder;
+}
