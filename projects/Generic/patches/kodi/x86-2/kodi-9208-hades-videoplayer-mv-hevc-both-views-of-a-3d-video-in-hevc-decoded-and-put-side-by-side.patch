+//! What a picture says of its own eye: the 3D reference displays information of MV-HEVC, which
+//! FFmpeg's HEVC decoder gives as AVStereo3D of the type AV_STEREO3D_FRAMESEQUENCE
+PictureEye EyeOf(const AVFrame* frame)
+{
+  const AVFrameSideData* side = av_frame_get_side_data(frame, AV_FRAME_DATA_STEREO3D);
+  if (!side || side->size < sizeof(AVStereo3D))
+    return PictureEye::UNSAID;
+  const auto* stereo = reinterpret_cast<const AVStereo3D*>(side->data);
+  if (stereo->type != AV_STEREO3D_FRAMESEQUENCE)
+    return PictureEye::UNSAID;
+  return stereo->view == AV_STEREO3D_VIEW_LEFT    ? PictureEye::LEFT
+         : stereo->view == AV_STEREO3D_VIEW_RIGHT ? PictureEye::RIGHT
+                                                  : PictureEye::UNSAID;
+}
