+  bits.Skip(4); // vps_video_parameter_set_id
+  const bool baseInternal = bits.Bit();
+  const bool baseAvailable = bits.Bit();
+  const uint32_t maxLayersMinus1 = bits.Bits(6);
+  const uint32_t maxSubLayersMinus1 = bits.Bits(3);
