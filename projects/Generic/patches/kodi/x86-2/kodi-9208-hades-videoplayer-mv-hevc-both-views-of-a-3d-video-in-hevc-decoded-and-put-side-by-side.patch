+//! Pictures that go out after a start or a seek before the pace is judged (two seconds of film:
+//! the player fills its queue and the display mode may change)
+inline constexpr unsigned int PACE_GRACE = 48;
+//! The pictures over which the pace is judged (four seconds of film)
+inline constexpr unsigned int PACE_WINDOW = 96;
+//! Of them, those that went out while the player was behind, at which a window is a slow one
+//! (one picture in eight)
+inline constexpr unsigned int PACE_LATE_IN_WINDOW = 12;
+//! Slow windows in a row after which the processor is taken not to keep up (eight seconds)
+inline constexpr unsigned int PACE_SLOW_WINDOWS = 2;
+
+//! How the pictures of two views keep up with the playback (Paced())
+struct Pace
+{
+  unsigned int seen{0}; //!< pictures since the start or the last seek, up to PACE_GRACE
+  unsigned int inWindow{0};
+  unsigned int lateInWindow{0};
+  unsigned int slowWindows{0}; //!< slow windows in a row
+};
+
+/*!
+ * \brief A picture went out of the decoder of both views; whether the processor is now taken
+ *        not to keep up, so that the stream goes back to its base view alone, in 2D
+ * \param late the player was behind when the picture went out: it asked the decoder to drop
+ *        pictures to catch up (DVD_CODEC_CTRL_DROP_ANY), which this decoder never does (a view
+ *        would be dropped without the other: CDVDVideoCodecFFmpeg::SetCodecControl()), so the
+ *        player drops them after they are decoded
+ * \param judged the picture counts: the player plays at the normal speed and is not dropping
+ *        what comes before the target of a seek
+ *
+ * Decoding two views takes the processor twice the work of one, without the hardware decoder,
+ * and a 3840x2160 view twice more again. Where that is more than the processor does in time, the
+ * player falls behind and drops pictures, again and again: a 3D picture that judders and jumps.
+ * After a start or a seek the first PACE_GRACE pictures are not judged. Then, when in two windows
+ * in a row of PACE_WINDOW pictures one in eight or more went out while the player was behind,
+ * the stream is given up for its base view, which the hardware decodes where it can (the
+ * reason is said in the log and in the player information). A slow moment does not end the 3D:
+ * one window of it is forgotten by the next that keeps up.
+ */
+inline bool Paced(Pace& pace, bool late, bool judged)
+{
+  if (!judged)
+    return false;
+  if (pace.seen < PACE_GRACE)
+  {
+    ++pace.seen;
+    return false;
+  }
+  ++pace.inWindow;
+  if (late)
+    ++pace.lateInWindow;
+  if (pace.inWindow < PACE_WINDOW)
+    return false;
+  pace.slowWindows = pace.lateInWindow >= PACE_LATE_IN_WINDOW ? pace.slowWindows + 1 : 0;
+  pace.inWindow = 0;
+  pace.lateInWindow = 0;
+  return pace.slowWindows >= PACE_SLOW_WINDOWS;
+}
