+bool ForEachHevcNal(const uint8_t* data, size_t size, Each each)
+{
+  if (!data || size < 4)
+    return false;
+  if (data[0] == 1)
+  {
+    if (size < 23)
+      return false;
+    size_t pos = 23;
+    for (unsigned int array = data[22]; array; --array)
+    {
+      if (size - pos < 3)
+        return false;
+      size_t count = Be16(data + pos + 1);
+      pos += 3;
+      for (; count; --count)
+      {
+        if (size - pos < 2)
+          return false;
+        const size_t length = Be16(data + pos);
+        pos += 2;
+        if (size - pos < length)
+          return false;
+        each(data + pos, length);
+        pos += length;
+      }
+    }
+    return true;
+  }
+  // start codes of three bytes (one of four is one of three behind a zero)
+  size_t start = 0;
+  bool open = false;
+  for (size_t i = 0; i + 3 <= size; ++i)
+  {
+    if (data[i] != 0 || data[i + 1] != 0 || data[i + 2] != 1)
+      continue;
+    if (open)
+    {
+      size_t end = i;
+      while (end > start && data[end - 1] == 0)
+        --end;
+      each(data + start, end - start);
+    }
+    start = i + 3;
+    open = true;
+    i += 2;
+  }
+  if (!open)
+    return false;
+  each(data + start, size - start);
+  return true;
+}
