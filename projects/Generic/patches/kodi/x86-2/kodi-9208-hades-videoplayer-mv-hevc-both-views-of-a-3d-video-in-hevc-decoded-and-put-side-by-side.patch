+{
+  bool nal = false;
+  bool vcl = false;
+  bool subPicture = false;
+  if (commonInfPresent)
+  {
+    nal = bits.Bit();
+    vcl = bits.Bit();
+    if (nal || vcl)
+    {
+      subPicture = bits.Bit();
+      if (subPicture)
+        bits.Skip(8 + 5 + 1 + 5);
+      bits.Skip(4 + 4); // bit_rate_scale, cpb_size_scale
+      if (subPicture)
+        bits.Skip(4); // cpb_size_du_scale
+      bits.Skip(5 + 5 + 5);
+    }
+  }
+  for (unsigned int i = 0; i <= maxSubLayersMinus1; ++i)
