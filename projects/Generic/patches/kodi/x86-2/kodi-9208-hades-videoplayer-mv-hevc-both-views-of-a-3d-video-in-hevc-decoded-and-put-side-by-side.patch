+ * keeps the base layer's sets only, which FFmpeg's and mkvmerge do) would switch a 3D display to
+ * 3D and back once its first packets were decoded, or never show its second view. Such a track
+ * stays the 2D stream it always was, and the log says why (MvHevcDeclared()).
+ */
+inline std::optional<int> MvHevcSecondLayer(const uint8_t* data, size_t size)
+{
+  std::optional<int> layer;
+  bool sps[64] = {};
+  bool pps[64] = {};
+  const bool whole = DETAIL::ForEachHevcNal(
+      data, size,
+      [&](const uint8_t* nal, size_t length)
+      {
+        const DETAIL::HevcNal header = DETAIL::HevcNalHeader(nal, length);
+        if (header.type == DETAIL::HEVC_NAL_VPS && header.layer == 0 && !layer)
+          layer = DETAIL::SecondViewLayerOfVps(nal, length);
+        else if (header.type == DETAIL::HEVC_NAL_SPS && header.layer >= 0)
+          sps[header.layer] = true;
+        else if (header.type == DETAIL::HEVC_NAL_PPS && header.layer >= 0)
+          pps[header.layer] = true;
+      });
+  if (!whole || !layer || !sps[*layer] || !pps[*layer])
+    return std::nullopt;
+  return layer;
+}
