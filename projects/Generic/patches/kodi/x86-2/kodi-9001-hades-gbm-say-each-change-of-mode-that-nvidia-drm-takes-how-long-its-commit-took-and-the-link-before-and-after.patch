From 7577ff9d48d3a6eb212886980e4717dcc0e9f671 Mon Sep 17 00:00:00 2001
From: Hades <15710513+hadesdevls@users.noreply.github.com>
Date: Wed, 18 Nov 2026 03:30:00 +0000
Subject: [PATCH] [Hades][GBM] Say each change of mode that nvidia-drm takes:
 how long its commit took, and the link before and after it

An RTX 4080 SUPER hung three times at the change of mode from
a video's TMDS mode back to 3840x2160 at 120 Hz over HDMI FRL. kodi.log said
that a change of the display mode had taken 3 to 6 s, but not over which link
the output went before and after it; the kernel log says that in its own clock,
and kodi.log is what most reports carry.

Where nvidia-drm says the link of a connector (NV_OUTPUT_LINK,
nvidia-open-kernel-modules-9057), each commit that changes the mode and that
the driver takes now leaves one line: the connector, the mode, how long the
commit took, and the link before and after it ("TMDS, scrambled", "FRL, 4
lanes at 8 Gb/s"...). From 2500 ms it is a warning that points at the kernel's
lines of the mode set (nvidia-open-kernel-modules-9072): in the same kodi.log
files the 4080's changes of mode took 86 to 755 ms where nothing went
wrong and 3130 ms or more where a flip did not come or the display engine hung.
Two reads of the property per change of mode; nothing else changes, and on
amdgpu and i915, which have no NV_OUTPUT_LINK, nothing is said.

CModesetReport (ModesetReport.h) words and decides; a host test with googletest
checks it (the link of each FRL rate and kind, the threshold against the times
above) and fails on each of 6 mutations of it.
---
 xbmc/windowing/gbm/ModesetReport.h   | 94 ++++++++++++++++++++++++++++
 xbmc/windowing/gbm/drm/DRMAtomic.cpp | 31 +++++++++
 2 files changed, 125 insertions(+)
 create mode 100644 xbmc/windowing/gbm/ModesetReport.h

diff --git a/xbmc/windowing/gbm/ModesetReport.h b/xbmc/windowing/gbm/ModesetReport.h
new file mode 100644
index 0000000..75fe638
--- /dev/null
+++ b/xbmc/windowing/gbm/ModesetReport.h
@@ -0,0 +1,94 @@
+/*
+ *  Copyright (C) 2026 Hades
+ *  This file is part of LibreELEC Hades. It is not in Kodi as Team Kodi publishes it.
+ *
+ *  SPDX-License-Identifier: GPL-2.0-or-later
+ *  See LICENSES/README.md for more information.
+ */
+
+#pragma once
+
+#include "HotplugRelink.h"
+
+#include <cstdint>
+#include <optional>
+#include <string>
+
+namespace KODI
+{
+namespace WINDOWING
+{
+namespace GBM
+{
+
+/*!
+ * \brief Hades: what kodi.log says of each change of mode that nvidia-drm takes
+ *        (CDRMAtomic::DrmAtomicCommit())
+ *
+ * On 2026-11-12 the RTX 4080 SUPER hung three times at the change of mode from a video's TMDS mode
+ * back to 3840x2160 at 120 Hz over HDMI FRL: the commit took 3.2 to 6.4 s and no flip came after
+ * it. kodi.log said how long the change of mode took, but not over which link the output went
+ * before and after it, which the kernel log says in its own clock. One line for each change of mode
+ * of a connector that has NV_OUTPUT_LINK (nvidia-open-kernel-modules-9057) says both, with the time
+ * the commit took; from SLOW_MS a warning that points at the kernel's lines ("Hades: head ...",
+ * nvidia-open-kernel-modules-9072). nvidia-drm waits up to 3 s for the flip of a commit that waits,
+ * and NVKMS up to 3 s for the display engine to finish a mode set. In the kodi.log files of
+ * 2026-11-12 the 4080's changes of mode took 86 to 755 ms where nothing went wrong (the commits
+ * that left native Dolby Vision, 274 to 329 ms), and 3130 ms or more where a flip did not come or
+ * the display engine hung (the two such commits that left Dolby Vision, 3256 and 3289 ms).
+ *
+ * This class only words and decides.
+ */
+class CModesetReport
+{
+public:
+  //! a commit that changes the mode and takes this long, or longer, is said as a warning
+  static constexpr double SLOW_MS = 2500.0;
+
+  static bool Slow(double ms) { return ms >= SLOW_MS; }
+
+  //! NV_OUTPUT_LINK in words: "TMDS", "TMDS, scrambled", "FRL, 4 lanes at 8 Gb/s"...
+  static std::string LinkText(std::optional<uint64_t> value)
+  {
+    using HOTPLUG_RELINK::Link;
+    const Link link = HOTPLUG_RELINK::LinkOf(value);
+    if (link != Link::FRL)
+      return HOTPLUG_RELINK::Name(link);
+    unsigned int lanes = 0;
+    unsigned int gbps = 0;
+    switch (HOTPLUG_RELINK::FrlRateOf(value))
+    {
+      case 1:
+        lanes = 3;
+        gbps = 3;
+        break;
+      case 2:
+        lanes = 3;
+        gbps = 6;
+        break;
+      case 3:
+        lanes = 4;
+        gbps = 6;
+        break;
+      case 4:
+        lanes = 4;
+        gbps = 8;
+        break;
+      case 5:
+        lanes = 4;
+        gbps = 10;
+        break;
+      case 6:
+        lanes = 4;
+        gbps = 12;
+        break;
+      default:
+        return "FRL";
+    }
+    return "FRL, " + std::to_string(lanes) + " lanes at " + std::to_string(gbps) + " Gb/s";
+  }
+};
+
+} // namespace GBM
+} // namespace WINDOWING
+} // namespace KODI
diff --git a/xbmc/windowing/gbm/drm/DRMAtomic.cpp b/xbmc/windowing/gbm/drm/DRMAtomic.cpp
index 019ba45..383f22f 100644
--- a/xbmc/windowing/gbm/drm/DRMAtomic.cpp
+++ b/xbmc/windowing/gbm/drm/DRMAtomic.cpp
@@ -22,6 +22,7 @@
 #include "utils/log.h"
 #include "windowing/gbm/HDR10PlusOutput.h"
 #include "windowing/gbm/HdmiVrrOff.h"
+#include "windowing/gbm/ModesetReport.h"
 #include "windowing/gbm/RgbRange.h"
 
 #include <algorithm>
@@ -519,11 +520,41 @@ bool CDRMAtomic::DrmAtomicCommit(int fb_id, int flags, bool rendered, bool video
                   { AddProperty(object, name, value); });
   }
 
+  // Hades: over which link the output goes before a change of mode, where nvidia-drm says it
+  // (NV_OUTPUT_LINK), for the line of the change in the log (CModesetReport)
+  const bool reportsLink =
+      modeset && m_connector && m_connector->SupportsProperty("NV_OUTPUT_LINK");
+  const std::optional<uint64_t> linkBefore =
+      reportsLink ? m_connector->ReadPropertyValue("NV_OUTPUT_LINK") : std::nullopt;
   const auto commitStart = std::chrono::steady_clock::now();
   ret = drmModeAtomicCommit(m_fd, m_req->Get(), flags, nullptr);
   // Hades: how long a commit that changes the mode took, for the report of a slow pass of the GUI
   if (modeset)
     CModeChangeTime::Add(commitStart);
+  // Hades: ... and one line for each change of mode that nvidia-drm took: how long its commit took
+  // and over which link the output went before it and goes now (CModesetReport)
+  if (reportsLink && ret == 0)
+  {
+    const double ms =
+        std::chrono::duration<double, std::milli>(std::chrono::steady_clock::now() - commitStart)
+            .count();
+    const std::optional<uint64_t> linkAfter = m_connector->ReadPropertyValue("NV_OUTPUT_LINK");
+    const double hz =
+        (m_mode && m_mode->htotal && m_mode->vtotal)
+            ? m_mode->clock * 1000.0 / (static_cast<double>(m_mode->htotal) * m_mode->vtotal)
+            : 0.0;
+    const bool slow = CModesetReport::Slow(ms);
+    CLog::Log(slow ? LOGWARNING : LOGINFO,
+              "Change of mode on {} to {}x{} @ {:.3f} Hz{}: the driver took its commit in {:.0f} "
+              "ms; the output went over {} and goes over {} now{}",
+              m_connector->GetName(), m_mode ? m_mode->hdisplay : 0, m_mode ? m_mode->vdisplay : 0,
+              hz, m_active ? "" : " (output off)", ms, CModesetReport::LinkText(linkBefore),
+              CModesetReport::LinkText(linkAfter),
+              slow ? " (slow: nvidia-drm waits up to 3 s for the flip of a commit, and NVIDIA's "
+                     "driver up to 3 s for the display engine to finish a mode set; the kernel "
+                     "log says what they did, in its lines \"Hades: head\")"
+                   : "");
+  }
   // Hades: (the time of a commit that does not wait for its flip is the time of the ioctl; one that
   // waits takes the rest of the refresh)
   if (frame && (flags & DRM_MODE_ATOMIC_NONBLOCK))
-- 
