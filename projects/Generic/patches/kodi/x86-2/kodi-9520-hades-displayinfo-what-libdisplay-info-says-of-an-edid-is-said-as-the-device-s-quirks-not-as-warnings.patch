From f68700d04b0d4bf9f61d21d1107eacf1b4b1f15a Mon Sep 17 00:00:00 2001
From: Hades <15710513+hadesdevls@users.noreply.github.com>
Date: Fri, 27 Nov 2026 06:54:55 +0000
Subject: [PATCH] [Hades][DisplayInfo] What libdisplay-info says of an EDID is
 said as the device's quirks, not as warnings

kodi.log wrote "warning: [display-info] EDID parser warnings:" for every
EDID that does not follow CTA-861 or HDMI to the letter: a sound bar
that sets the bits of its speaker allocation that CTA-861-H deprecates
("Deprecated bit F16 must be 0", "F33"), a monitor whose CTA header says
overscanned where its video capability block says underscanned. Those
are quirks of the device's EDID: libdisplay-info reads them as the
standard says (it takes nothing from a deprecated bit) and goes on, and
nothing is wrong with the display, its link or Kodi. A diagnostic read
them as faults.

They are written at the level of information now, under a line that
says what they are; an EDID that cannot be read at all is still
reported as before. (The other line of this kind, "The data size does
not match the encoded block count." of a monitor with an HDMI Forum
EEODB, was libdisplay-info leaving the blocks past the count of the
base block unread: its patch libdisplay-info-9901 reads them.)
---
 xbmc/utils/DisplayInfo.cpp | 14 ++++++++------
 1 file changed, 8 insertions(+), 6 deletions(-)

diff --git a/xbmc/utils/DisplayInfo.cpp b/xbmc/utils/DisplayInfo.cpp
index 0c78c97..c414ec3 100644
--- a/xbmc/utils/DisplayInfo.cpp
+++ b/xbmc/utils/DisplayInfo.cpp
@@ -534,20 +534,22 @@ bool CDisplayInfo::IsValid() const
   if (!m_info)
     return false;
 
+  // Hades: what libdisplay-info says of an EDID that does not follow CTA-861 or HDMI is a quirk of
+  // the device's EDID (a deprecated bit set, a flag that contradicts another), which it reads as the
+  // standard says and parsing goes on: no fault of the display, of its link or of Kodi, so not a
+  // warning. (An EDID that cannot be read at all gives no m_info, above.)
   const char* error = di_info_get_failure_msg(m_info.get());
   if (error)
   {
-    CLog::Log(LOGWARNING, "[display-info] EDID parser warnings:");
-    CLog::Log(LOGWARNING, "[display-info] ----------------------------------------------");
-
+    CLog::Log(LOGINFO, "[display-info] quirks of this device's EDID, where it does not follow CTA-861 "
+                       "or HDMI; each is read as the standard says, and none is a fault:");
     std::vector<std::string> lines = StringUtils::Split(error, "\n");
 
     for (const auto& line : lines)
     {
-      CLog::Log(LOGWARNING, "[display-info] {}", line);
+      if (!line.empty())
+        CLog::Log(LOGINFO, "[display-info]   {}", line);
     }
-
-    CLog::Log(LOGWARNING, "[display-info] ----------------------------------------------");
   }
 
   return true;
