From de09d36f56ce070fe942c1d4d5c04b18af753c34 Mon Sep 17 00:00:00 2001
From: Dom Cobley <popcornmix@gmail.com>
Date: Sun, 11 Oct 2026 10:31:43 +0100
Subject: [PATCH] windowing/gbm: apply the GUI size limit on 1080p displays too

videoscreen.limitguisize was ignored unless the panel was larger than
1080p, so the 720p option could never be selected on the 1080p displays
where the memory it saves matters most. On a 1GB Pi4 a 720p GUI frees
21.6MB of GPU memory: the GBM swapchain drops from 24.3MB to 10.8MB and
the render targets shrink with it.

Apply the limit whenever one is set. It caps the line count and the
width follows the mode's aspect ratio, so the GUI is never enlarged and
is not stretched on non-16:9 panels or squashed on pixel-repeated SD
modes such as 1440x576.

(cherry picked from commit 266f5065a76caa19184ad3fb21affb879115e705)

[Hades: the limit is left out of the modes with a 3D layout, which are
Hades' own on GBM: their GUI is drawn at the size they scan out, where
the eyes and the gap between them are counted in lines of the screen
(iBlanking, StereoCorrection), and a 1920x2205 frame-packed mode would
otherwise get a GUI 940 pixels wide. The default of the setting is 0
(no limit), and the limit applies only with the PRIME renderer, as
before. The includes are those of both sides.]
(cherry picked from commit 8b6b0da82b8389befd1bd820c92d1f569c2ca9cc)
---
 xbmc/windowing/gbm/drm/DRMUtils.cpp | 11 ++++++++++-
 1 file changed, 10 insertions(+), 1 deletion(-)

diff --git a/xbmc/windowing/gbm/drm/DRMUtils.cpp b/xbmc/windowing/gbm/drm/DRMUtils.cpp
index 6339bc6..eb1d2ee 100644
--- a/xbmc/windowing/gbm/drm/DRMUtils.cpp
+++ b/xbmc/windowing/gbm/drm/DRMUtils.cpp
@@ -24,6 +24,8 @@
 #include "utils/log.h"
 #include "windowing/GraphicContext.h"
 
+#include <algorithm>
+#include <cmath>
 #include <cstring>
 #include <fstream>
 #include <map>
@@ -1996,7 +1998,9 @@ RESOLUTION_INFO CDRMUtils::GetResolutionInfo(drmModeModeInfoPtr mode)
                             settings->GetInt(CSettings::SETTING_VIDEOPLAYER_USEPRIMERENDERER) == 0
                         ? settings->GetInt(SETTING_VIDEOSCREEN_LIMITGUISIZE)
                         : 0;
-  if (limit > 0 && res.iScreenWidth > 1920 && res.iScreenHeight > 1080)
+  // Hades: not in a mode with a 3D layout: its GUI is drawn at the size it scans out, where the eyes
+  // and the gap between them are counted in lines of the screen (iBlanking, StereoCorrection)
+  if (limit > 0 && !(mode->flags & DRM_MODE_FLAG_3D_MASK))
   {
     switch (limit)
     {
@@ -2017,6 +2021,11 @@ RESOLUTION_INFO CDRMUtils::GetResolutionInfo(drmModeModeInfoPtr mode)
         res.iHeight = mode->vrefresh > 30 ? 1080 : res.iScreenHeight;
         break;
     }
+    // the limit caps the line count; the width follows the mode's aspect ratio, so non-16:9 and
+    // pixel-repeated SD modes are not stretched or squashed, and the GUI is never enlarged
+    const double scale = std::min(1.0, static_cast<double>(res.iHeight) / res.iScreenHeight);
+    res.iWidth = static_cast<int>(std::lround(res.iScreenWidth * scale));
+    res.iHeight = static_cast<int>(std::lround(res.iScreenHeight * scale));
   }
 
   if (mode->htotal > 0 && mode->vtotal > 0)
-- 
