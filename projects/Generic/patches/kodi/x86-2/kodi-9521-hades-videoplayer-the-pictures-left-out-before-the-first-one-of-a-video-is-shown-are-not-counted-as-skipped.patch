+  KODI::RENDERQUEUE::CStartSkips m_startSkips;
 
   struct SPresent
   {
diff --git a/xbmc/cores/VideoPlayer/VideoRenderers/StartSkips.h b/xbmc/cores/VideoPlayer/VideoRenderers/StartSkips.h
new file mode 100644
index 0000000..a44a80b
--- /dev/null
+++ b/xbmc/cores/VideoPlayer/VideoRenderers/StartSkips.h
@@ -0,0 +1,93 @@
+/*
+ *  Copyright (C) 2026 Hades
+ *  This file is part of LibreELEC Hades. It is not in Kodi as Team Kodi publishes it.
+ *
+ *  SPDX-License-Identifier: GPL-2.0-or-later
+ *  See LICENSES/README.md for more information.
+ */
+
+#pragma once
+
+#include <algorithm>
+#include <cmath>
+#include <string>
+
+/*!
+ * \file
+ * \brief Hades: the pictures that the renderer leaves out before the first picture of a video is
+ *        shown, counted apart from those it skips while the video plays
+ *
+ * VideoPlayer starts its clock when the first picture of a video is ready (CVideoPlayerVideo: "in
+ * step with the clock ... after its first picture was ready"), and the renderer shows that picture
+ * at the first refresh after it is set up. After a change of display mode (native Dolby Vision
+ * takes its transport, a new refresh rate) the output shows its first frame 20 to 300 ms after the
+ * clock started: the pictures that came due meanwhile are late before any frame was shown, and
+ * PrepareNextRender() leaves out all but the latest of them ("skip late frames"), as it does for a
+ * picture that is late while the video plays. The player information counted them as skipped ("1"
+ * right after the start of every video on an RTX 4080 SUPER with an LG C5: the first frame went out
+ * 126 ms after the clock started, three pictures at 23.976 Hz), and kodi.log did not say them.
+ *
+ * What is done with them does not change: the clock is not held for the output (the sound and the
+ * first frame of Dolby Vision follow it as before), and the picture shown is the one that is due.
+ * They are only counted apart, and said once a video in kodi.log with how late the first picture
+ * shown was. Pure: a host test runs it (start_skips_test.cpp).
+ */
+namespace KODI::RENDERQUEUE
+{
+
+class CStartSkips
+{
+public:
+  //! a video starts (CRenderManager::PreInit())
+  void Start()
+  {
+    m_shown = false;
+    m_skipped = 0;
+  }
+
+  /*!
+   * \brief A picture is left out as late
+   * \return true where no picture of the video has been shown yet: it is counted here, not as a
+   *         picture skipped while the video plays
+   */
+  bool Skipped()
+  {
+    if (m_shown)
+      return false;
+    ++m_skipped;
+    return true;
+  }
+
+  /*!
+   * \brief A picture is chosen to be shown
+   * \param lateUs how late it is by the clock, in microseconds (DVD_TIME_BASE)
+   * \return for the first picture of the video where pictures were left out before it, the line of
+   *         kodi.log; empty otherwise
+   */
+  std::string Shown(double lateUs)
+  {
+    if (m_shown)
+      return "";
+    m_shown = true;
+    if (m_skipped == 0)
+      return "";
+    const long lateMs = std::lround(std::max(lateUs, 0.0) / 1000.0);
+    return std::to_string(m_skipped) + (m_skipped == 1 ? " picture" : " pictures") +
+           " of the start came due before the output showed its first frame (it showed the one "
+           "then due, " + std::to_string(lateMs) +
+           " ms after its time by the clock, which runs from the first picture ready: a change of "
+           "mode, the renderer set up for it) and " +
+           (m_skipped == 1 ? "was" : "were") +
+           " left out; not counted as skipped in the player information";
+  }
+
+  //! the pictures left out before the first one was shown, of this video
+  int Count() const { return m_skipped; }
+  bool FirstShown() const { return m_shown; }
+
+private:
+  bool m_shown = false;
+  int m_skipped = 0;
+};
+
+} // namespace KODI::RENDERQUEUE
