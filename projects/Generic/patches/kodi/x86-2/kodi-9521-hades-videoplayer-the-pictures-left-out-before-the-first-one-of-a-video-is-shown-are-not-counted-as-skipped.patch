   int GetSkippedFrames()  { return m_QueueSkip; }
 
   //! progressive: the stream is progressive (CDVDStreamInfo::progressive) and no picture of it
@@ -316,6 +319,10 @@ protected:
 
   int m_QueueSize = 2;
   int m_QueueSkip = 0;
+  //! Hades: the pictures left out before the first one of the video was shown (StartSkips.h): the
+  //! clock runs from the first picture ready, and the output may show its first frame some
