 #include "cores/VideoPlayer/VideoRenderers/VsyncPhase.h"
 #include "cores/VideoSettings.h"
@@ -147,6 +148,8 @@ public:
   bool Supports(ERENDERFEATURE feature) const;
   bool Supports(ESCALINGMETHOD method) const;
 
+  //! the pictures skipped while the video plays (Hades: not those left out before its first one was
