+++ b/xbmc/cores/VideoPlayer/VideoRenderers/RenderManager.cpp
@@ -537,6 +537,7 @@ void CRenderManager::PreInit()
 
   m_QueueSize   = 2;
   m_QueueSkip   = 0;
+  m_startSkips.Start();
   m_presentstep = PRESENT_IDLE;
   m_bRenderGUI = true;
 
@@ -1921,7 +1922,10 @@ void CRenderManager::PrepareNextRender()
       if (m_presentsourcePast >= 0)
       {
         m_discard.push_back(m_presentsourcePast);
-        m_QueueSkip++;
+        // (Hades: before the first picture of the video is shown, a picture left out is one that
+        // came due while the output was not showing frames yet, counted apart: StartSkips.h)
+        if (!m_startSkips.Skipped())
+          m_QueueSkip++;
       }
       m_presentsourcePast = m_queued.front();
       m_queued.pop_front();
@@ -1934,6 +1938,9 @@ void CRenderManager::PrepareNextRender()
     else
       m_lateframes = 0;
 
+    // (Hades: the first picture of the video shown: what was left out before it is said, once)
+    if (const auto said = m_startSkips.Shown(renderPts - m_Queue[idx].pts); !said.empty())
+      CLog::Log(LOGINFO, "CRenderManager: {}", said);
     m_presentstep = PRESENT_FLIP;
     m_discard.push_back(m_presentsource);
     m_presentsource = idx;
@@ -1952,6 +1959,8 @@ void CRenderManager::PrepareNextRender()
   {
     m_lateframes = 0;
     m_presentstep = PRESENT_FLIP;
+    if (const auto said = m_startSkips.Shown(renderPts - m_Queue[m_queued.front()].pts); !said.empty())
+      CLog::Log(LOGINFO, "CRenderManager: {}", said);
     m_presentsourcePast = m_presentsource;
     m_presentsource = m_queued.front();
     SideDataChosen(m_presentsource);
