+++ b/xbmc/platform/linux/HadesFirmwareBoot.h
@@ -0,0 +1,33 @@
+/*
+ *  Copyright (C) 2026 Hades
+ *  This file is part of LibreELEC Hades. It is not in Kodi as Team Kodi publishes it.
+ *
+ *  SPDX-License-Identifier: GPL-2.0-or-later
+ *  See LICENSES/README.md for more information.
+ */
+
+#pragma once
+
+namespace KODI::PLATFORM::LINUX::HADESBOOT
+{
+/*!
+ * \brief "Restart into Windows" of the power menu (System.CanRebootToWindows, builtin RebootToWindows).
+ *
+ * On a PC with Windows and Hades, Windows comes first in the boot order of the firmware, and Hades is started for one
+ * start: from the boot menu of the firmware, or by "Restart into LibreELEC Hades" of the installer for Windows, which
+ * sets BootNext. A plain restart then goes back to Windows; on a PC where Hades comes first (installed inside the PC
+ * and chosen first in the firmware), or where the firmware puts a USB drive first, it does not. This entry starts
+ * Windows at the next start in every case, and only at that one: it sets BootNext, a variable of the firmware that
+ * the firmware deletes when it uses it, to the entry of Windows that the firmware already has. No boot entry is made,
+ * changed or deleted, and the boot order stays as it is. The work with the firmware is done by
+ * /usr/lib/libreelec/hades-bootnext (also used by the system for the restarts that finish an update).
+ */
+
+//! The firmware has an entry of Windows that BootNext can name. Read once from /run/hades-bootnext, which
+//! hades-bootnext.service writes before Kodi starts (while that file is not there, asked again every 10 s).
+bool CanRebootToWindows();
+
+//! Sets the next start, and only that one, to Windows; true when the firmware gave the value back. The PC is not
+//! restarted here. Says what happened in kodi.log.
+bool SetWindowsForNextStart();
+} // namespace KODI::PLATFORM::LINUX::HADESBOOT
