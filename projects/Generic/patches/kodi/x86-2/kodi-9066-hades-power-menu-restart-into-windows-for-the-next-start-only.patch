+ *  See LICENSES/README.md for more information.
+ */
+
+#pragma once
+
+#include <string>
+#include <string_view>
+
+namespace KODI::PLATFORM::LINUX::HADESBOOT
+{
+/*!
+ * \brief What the UEFI firmware of the PC starts, as /usr/lib/libreelec/hades-bootnext says it ("key=value", one per
+ *        line). hades-bootnext.service leaves it in /run/hades-bootnext at every start of the system, before Kodi.
+ *
+ * Entries are named by their number, four hexadecimal digits ("0003" is Boot0003). "next" is what a plain restart
+ * starts (a BootNext that is set, or the first active entry of the boot order); "windows" the entry of Windows
+ * (Windows Boot Manager, \EFI\Microsoft\Boot\bootmgfw.efi), empty when there is none.
+ */
+struct BootState
+{
+  bool known{false}; //!< the text said anything at all
+  bool uefi{false};
+  bool writable{false}; //!< the variables of the firmware can be written
+  std::string current;
+  std::string currentName;
+  std::string order;
+  std::string next;
+  std::string nextName;
+  std::string windows;
+  std::string windowsName;
+};
+
+BootState ParseBootState(std::string_view text);
+
+//! "Restart into Windows" is offered: a start by UEFI, an entry of Windows, and variables that can be written.
+bool OffersWindows(const BootState& state);
+
+//! One line for kodi.log: whether the entry of the power menu is shown, why, and what a plain restart starts.
+std::string Describe(const BootState& state);
+
+//! What "hades-bootnext windows" answered.
+struct SetResult
+{
+  bool done{false};
+  std::string bootNext; //!< the entry it set, four hexadecimal digits
+  std::string
+      error; //!< its reason when it did not ("no-windows-entry", "read-only", "not-written"...)
+};
+
+/*!
+ * \brief Done when the helper said "bootnext=<entry>" (it says it only after the firmware gave the value back) and no
+ *        error, and did not end with a failure. exitStatus -1: not known (the status of the process was lost), which
+ *        does not count against it; anything else but 0 does.
+ */
+SetResult ParseSetResult(std::string_view output, int exitStatus);
+
+//! Four hexadecimal digits in capitals, as the helper writes the number of an entry.
+bool IsEntryNumber(std::string_view value);
+} // namespace KODI::PLATFORM::LINUX::HADESBOOT
diff --git a/xbmc/platform/linux/HadesFirmwareBoot.cpp b/xbmc/platform/linux/HadesFirmwareBoot.cpp
new file mode 100644
index 0000000..8f4f712
--- /dev/null
+++ b/xbmc/platform/linux/HadesFirmwareBoot.cpp
@@ -0,0 +1,108 @@
+/*
+ *  Copyright (C) 2026 Hades
+ *  This file is part of LibreELEC Hades. It is not in Kodi as Team Kodi publishes it.
+ *
+ *  SPDX-License-Identifier: GPL-2.0-or-later
+ *  See LICENSES/README.md for more information.
+ */
+
+#include "HadesFirmwareBoot.h"
+
+#include "HadesBootState.h"
+#include "utils/log.h"
+
+#include <chrono>
+#include <cstdio>
+#include <fstream>
+#include <iterator>
+#include <mutex>
+#include <string>
+
+#include <sys/wait.h>
+
+namespace KODI::PLATFORM::LINUX::HADESBOOT
+{
+namespace
+{
+constexpr const char* STATE_FILE = "/run/hades-bootnext";
+// (a fixed command: nothing in it comes from outside)
+constexpr const char* SET_WINDOWS = "/bin/sh /usr/lib/libreelec/hades-bootnext windows 2>&1";
+
+std::mutex g_lock;
+bool g_read{false};
+bool g_offers{false};
+bool g_saidMissing{false};
+std::chrono::steady_clock::time_point g_lastTry{};
+} // namespace
+
+bool CanRebootToWindows()
+{
+  std::lock_guard<std::mutex> lock(g_lock);
+  if (g_read)
+    return g_offers;
+  // (asked for every frame while the power menu is open: the file is looked for at most every 10 s)
+  const auto now = std::chrono::steady_clock::now();
+  if (g_lastTry != std::chrono::steady_clock::time_point{} &&
+      now - g_lastTry < std::chrono::seconds(10))
+    return false;
+  g_lastTry = now;
+  std::ifstream file(STATE_FILE);
+  if (!file)
+  {
+    if (!g_saidMissing)
+      CLog::Log(LOGINFO,
+                "Hades boot: no {} (hades-bootnext.service has not written it): 'Restart into "
+                "Windows' is not "
+                "shown for now",
+                STATE_FILE);
+    g_saidMissing = true;
+    return false;
+  }
+  std::string text;
+  text.assign(std::istreambuf_iterator<char>(file), std::istreambuf_iterator<char>());
+  if (text.size() > 8192)
+    text.resize(8192);
+  const BootState state = ParseBootState(text);
+  g_read = true;
+  g_offers = OffersWindows(state);
+  CLog::Log(LOGINFO, "Hades boot: {}", Describe(state));
+  return g_offers;
+}
+
+bool SetWindowsForNextStart()
+{
+  // The helper looks the entry of Windows up again in the firmware: that, and not what was read at the start, counts.
+  std::string output;
+  int status = -1;
+  if (FILE* p = popen(SET_WINDOWS, "r"))
+  {
+    char buffer[256];
+    while (output.size() < 4096 && fgets(buffer, sizeof(buffer), p))
+      output += buffer;
+    const int rc = pclose(p);
+    if (rc != -1 && WIFEXITED(rc))
+      status = WEXITSTATUS(rc);
+    else if (rc != -1)
+      status = 128;
+  }
+  else
+  {
+    CLog::Log(LOGERROR, "Hades boot: 'Restart into Windows' not done: hades-bootnext could not be "
+                        "started; the PC is not "
+                        "restarted");
+    return false;
+  }
+  const SetResult result = ParseSetResult(output, status);
+  if (result.done)
+    CLog::Log(LOGINFO,
+              "Hades boot: 'Restart into Windows': BootNext={} set, and the firmware gives it "
+              "back; the PC restarts "
+              "into Windows once, and goes by its boot order after that",
+              result.bootNext);
+  else
+    CLog::Log(LOGWARNING,
+              "Hades boot: 'Restart into Windows' not done ({}); the PC is not restarted",
+              result.error);
+  return result.done;
+}
+} // namespace KODI::PLATFORM::LINUX::HADESBOOT
diff --git a/xbmc/platform/linux/HadesFirmwareBoot.h b/xbmc/platform/linux/HadesFirmwareBoot.h
new file mode 100644
index 0000000..37d1caa
