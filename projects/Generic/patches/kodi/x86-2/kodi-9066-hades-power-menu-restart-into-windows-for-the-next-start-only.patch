diff --git a/xbmc/platform/linux/test/TestHadesBootState.cpp b/xbmc/platform/linux/test/TestHadesBootState.cpp
new file mode 100644
index 0000000..d5318ce
--- /dev/null
+++ b/xbmc/platform/linux/test/TestHadesBootState.cpp
@@ -0,0 +1,117 @@
+/*
+ *  Copyright (C) 2026 Hades
+ *  This file is part of LibreELEC Hades. It is not in Kodi as Team Kodi publishes it.
+ *
+ *  SPDX-License-Identifier: GPL-2.0-or-later
+ *  See LICENSES/README.md for more information.
+ */
+
+#include "platform/linux/HadesBootState.h"
+
+#include <gtest/gtest.h>
+
+using namespace KODI::PLATFORM::LINUX::HADESBOOT;
+
+namespace
+{
+// what hades-bootnext status said in its host test for the PC of the user (Windows first, Hades on a USB SSD)
+constexpr const char* ASUS = "uefi=yes\n"
+                             "current=0003\n"
+                             "current_name=UEFI: HIKSEMI, Partition 1\n"
+                             "order=0000 0003 0001 0002 0004\n"
+                             "next=0000\n"
+                             "next_name=Windows Boot Manager\n"
+                             "windows=0000\n"
+                             "windows_name=Windows Boot Manager\n"
+                             "writable=yes\n";
+} // namespace
+
+TEST(TestHadesBootState, PcOfTheUser)
+{
+  const BootState s = ParseBootState(ASUS);
+  EXPECT_TRUE(s.known);
+  EXPECT_TRUE(s.uefi);
+  EXPECT_TRUE(s.writable);
+  EXPECT_EQ(s.current, "0003");
+  EXPECT_EQ(s.currentName, "UEFI: HIKSEMI, Partition 1");
+  EXPECT_EQ(s.windows, "0000");
+  EXPECT_EQ(s.next, "0000");
+  EXPECT_TRUE(OffersWindows(s));
+  const std::string said = Describe(s);
+  EXPECT_NE(said.find("'Restart into Windows' is shown (a plain restart starts Windows too)"),
+            std::string::npos)
+      << said;
+  EXPECT_NE(said.find("this start came from Boot0003 \"UEFI: HIKSEMI, Partition 1\""),
+            std::string::npos)
+      << said;
+}
+
+TEST(TestHadesBootState, HadesFirstWithLinesOfWindows)
+{
+  const BootState s =
+      ParseBootState("uefi=yes\r\ncurrent=0005\r\nnext=0005\r\nwindows=0000\r\nwritable=yes\r\n");
+  EXPECT_EQ(s.next, "0005");
+  EXPECT_TRUE(OffersWindows(s));
+  EXPECT_EQ(Describe(s).find("too"), std::string::npos);
+}
+
+TEST(TestHadesBootState, NotOffered)
+{
+  EXPECT_FALSE(OffersWindows(ParseBootState("")));
+  EXPECT_FALSE(ParseBootState("").known);
+  EXPECT_NE(Describe(ParseBootState("")).find("not asked"), std::string::npos);
+  const BootState bios = ParseBootState("uefi=no\n");
+  EXPECT_TRUE(bios.known);
+  EXPECT_FALSE(OffersWindows(bios));
+  EXPECT_NE(Describe(bios).find("did not start by UEFI"), std::string::npos);
+  EXPECT_FALSE(OffersWindows(ParseBootState("uefi=yes\nwindows=\nwritable=yes\n")));
+  EXPECT_NE(
+      Describe(ParseBootState("uefi=yes\nwindows=\nwritable=yes\n")).find("no entry of Windows"),
+      std::string::npos);
+  const BootState ro = ParseBootState("uefi=yes\nwindows=0000\nwritable=no\n");
+  EXPECT_FALSE(OffersWindows(ro));
+  EXPECT_NE(Describe(ro).find("cannot be written"), std::string::npos);
+  EXPECT_FALSE(OffersWindows(ParseBootState("uefi=yes\nwindows=000c\nwritable=yes\n")));
+  EXPECT_FALSE(OffersWindows(ParseBootState("uefi=yes\nwindows=00000\nwritable=yes\n")));
+  EXPECT_FALSE(OffersWindows(ParseBootState("windows=0000\nwritable=yes\n")));
+  // (a line without "=" or with nothing before it is no line of the helper)
+  EXPECT_FALSE(ParseBootState("uefi yes\n=0000\n").known);
+}
+
+TEST(TestHadesBootState, LongNamesAreCut)
+{
+  const BootState s = ParseBootState("windows_name=" + std::string(500, 'x') + "\n");
+  EXPECT_EQ(s.windowsName.size(), 120u);
+}
+
+TEST(TestHadesBootState, AnswerOfTheHelper)
+{
+  SetResult r = ParseSetResult("bootnext=0000\n", 0);
+  EXPECT_TRUE(r.done);
+  EXPECT_EQ(r.bootNext, "0000");
+  EXPECT_TRUE(ParseSetResult("bootnext=000C\n", -1).done);
+  r = ParseSetResult("bootnext=0000\n", 1);
+  EXPECT_FALSE(r.done);
+  EXPECT_EQ(r.error, "exit 1");
+  r = ParseSetResult("error=read-only\n", 1);
+  EXPECT_FALSE(r.done);
+  EXPECT_EQ(r.error, "read-only");
+  r = ParseSetResult("", 0);
+  EXPECT_FALSE(r.done);
+  EXPECT_EQ(r.error, "no answer");
+  EXPECT_FALSE(ParseSetResult("bootnext=none\n", 0).done);
+  EXPECT_FALSE(ParseSetResult("bootnext=0000\nerror=not-written\n", 0).done);
+  EXPECT_FALSE(ParseSetResult("bootnext=0000\n", 128).done);
+}
+
+TEST(TestHadesBootState, EntryNumbers)
+{
+  EXPECT_TRUE(IsEntryNumber("0000"));
+  EXPECT_TRUE(IsEntryNumber("FFFF"));
+  EXPECT_TRUE(IsEntryNumber("0A1B"));
+  EXPECT_FALSE(IsEntryNumber("0a1b"));
+  EXPECT_FALSE(IsEntryNumber("000"));
+  EXPECT_FALSE(IsEntryNumber("00000"));
+  EXPECT_FALSE(IsEntryNumber("00G0"));
+  EXPECT_FALSE(IsEntryNumber(""));
+}
