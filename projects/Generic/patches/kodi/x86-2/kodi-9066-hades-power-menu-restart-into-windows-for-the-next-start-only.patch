diff --git a/xbmc/platform/linux/HadesBootState.cpp b/xbmc/platform/linux/HadesBootState.cpp
new file mode 100644
index 0000000..a21a60c
--- /dev/null
+++ b/xbmc/platform/linux/HadesBootState.cpp
@@ -0,0 +1,136 @@
+/*
+ *  Copyright (C) 2026 Hades
+ *  This file is part of LibreELEC Hades. It is not in Kodi as Team Kodi publishes it.
+ *
+ *  SPDX-License-Identifier: GPL-2.0-or-later
+ *  See LICENSES/README.md for more information.
+ */
+
+#include "HadesBootState.h"
+
+#include <cstddef>
+
+namespace KODI::PLATFORM::LINUX::HADESBOOT
+{
+namespace
+{
+// a value is kept as it is, cut at 120 characters (a name of the firmware can be anything)
+std::string Value(std::string_view v)
+{
+  if (!v.empty() && v.back() == '\r')
+    v.remove_suffix(1);
+  return std::string(v.substr(0, 120));
+}
+
+template<typename F>
+void Lines(std::string_view text, F&& each)
+{
+  while (!text.empty())
+  {
+    const size_t end = text.find('\n');
+    const std::string_view line = text.substr(0, end);
+    const size_t eq = line.find('=');
+    if (eq != std::string_view::npos && eq > 0)
+      each(line.substr(0, eq), line.substr(eq + 1));
+    if (end == std::string_view::npos)
+      break;
+    text.remove_prefix(end + 1);
+  }
+}
+
+std::string Entry(const std::string& number, const std::string& name)
+{
+  if (number.empty())
+    return "none";
+  return "Boot" + number + (name.empty() ? "" : " \"" + name + "\"");
+}
+} // namespace
+
+bool IsEntryNumber(std::string_view value)
+{
+  if (value.size() != 4)
+    return false;
+  for (const char c : value)
+    if (!((c >= '0' && c <= '9') || (c >= 'A' && c <= 'F')))
+      return false;
+  return true;
+}
+
+BootState ParseBootState(std::string_view text)
+{
+  BootState s;
+  Lines(text,
+        [&s](std::string_view key, std::string_view value)
+        {
+          const std::string v = Value(value);
+          s.known = true;
+          if (key == "uefi")
+            s.uefi = v == "yes";
+          else if (key == "writable")
+            s.writable = v == "yes";
+          else if (key == "current")
+            s.current = v;
+          else if (key == "current_name")
+            s.currentName = v;
+          else if (key == "order")
+            s.order = v;
+          else if (key == "next")
+            s.next = v;
+          else if (key == "next_name")
+            s.nextName = v;
+          else if (key == "windows")
+            s.windows = v;
+          else if (key == "windows_name")
+            s.windowsName = v;
+        });
+  return s;
+}
+
+bool OffersWindows(const BootState& state)
+{
+  return state.uefi && state.writable && IsEntryNumber(state.windows);
+}
+
+std::string Describe(const BootState& state)
+{
+  if (!state.known)
+    return "the firmware was not asked (no answer from hades-bootnext): 'Restart into Windows' is "
+           "not shown";
+  if (!state.uefi)
+    return "this PC did not start by UEFI, or its firmware gives no boot order: 'Restart into "
+           "Windows' is not shown";
+  const std::string where = "this start came from " + Entry(state.current, state.currentName) +
+                            "; a plain restart starts " + Entry(state.next, state.nextName) +
+                            "; the boot order is " + (state.order.empty() ? "empty" : state.order);
+  if (!IsEntryNumber(state.windows))
+    return "no entry of Windows in the boot order of the firmware: 'Restart into Windows' is not "
+           "shown; " +
+           where;
+  if (!state.writable)
+    return "Windows is " + Entry(state.windows, state.windowsName) +
+           ", but the variables of the firmware cannot be written: 'Restart into Windows' is not "
+           "shown; " +
+           where;
+  return "Windows is " + Entry(state.windows, state.windowsName) +
+         ": 'Restart into Windows' is shown" +
+         (state.next == state.windows ? " (a plain restart starts Windows too)" : "") + "; " +
+         where;
+}
+
+SetResult ParseSetResult(std::string_view output, int exitStatus)
+{
+  SetResult r;
+  Lines(output,
+        [&r](std::string_view key, std::string_view value)
+        {
+          if (key == "bootnext")
+            r.bootNext = Value(value);
+          else if (key == "error")
+            r.error = Value(value);
+        });
+  r.done = IsEntryNumber(r.bootNext) && r.error.empty() && (exitStatus == 0 || exitStatus == -1);
+  if (!r.done && r.error.empty())
+    r.error = exitStatus > 0 ? "exit " + std::to_string(exitStatus) : "no answer";
+  return r;
+}
+} // namespace KODI::PLATFORM::LINUX::HADESBOOT
