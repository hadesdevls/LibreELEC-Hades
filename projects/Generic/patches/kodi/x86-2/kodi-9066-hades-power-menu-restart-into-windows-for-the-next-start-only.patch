+/*! \brief Hades: restart into Windows, for the next start only.
+ *  \param params (ignored)
+ *  \details Sets BootNext of the UEFI firmware to its entry of Windows (no entry is made, and the boot order stays
+ *  as it is) and reboots as Reboot does. When the firmware does not take it, the PC is not restarted, and a
+ *  notification says so.
+ */
+static int RebootToWindows(const std::vector<std::string>& params)
+{
+#if defined(TARGET_LINUX)
+  if (KODI::PLATFORM::LINUX::HADESBOOT::SetWindowsForNextStart())
+  {
+    CServiceBroker::GetAppMessenger()->PostMsg(TMSG_RESTART);
+    return 0;
+  }
+  CGUIDialogKaiToast::QueueNotification(CGUIDialogKaiToast::Warning,
+                                        CGUIUtils::GetHadesString(42240, 34240),
+                                        CGUIUtils::GetHadesString(42241, 34241), 10000);
+#endif
+  return 0;
+}
+
 /*! \brief Restart application.
  *  \param params (ignored)
  */
