 #: system/settings/settings.xml
 #. Hades, value of setting "videoscreen.hadesdvtransport": the composer's picture as it is, as clause 6 of ETSI GS CCM 001 describes (the default); also on the Dolby Vision page of the player information; the core string #59896
diff --git a/tools/dvbridge/dvbridge_ipt.h b/tools/dvbridge/dvbridge_ipt.h
index d880b5b..5d17c0d 100644
--- a/tools/dvbridge/dvbridge_ipt.h
+++ b/tools/dvbridge/dvbridge_ipt.h
@@ -5,20 +5,25 @@
  *  SPDX-License-Identifier: GPL-2.0-or-later
  *  See LICENSES/README.md for more information.
  */
-/* Hades: the matrices of the IPT-PQ-c2 tunnel. Licensed players are reported to send Dolby Vision in
- * IPT-PQ-c2 whatever the profile (the TV-led output mode of Amlogic's licensed driver is "IPT
- * tunnel" for every source; captures of licensed Amlogic and MediaTek players carry IPT matrices in
- * their metadata). ETSI GS CCM 001 V1.1.1 allows it (6.2.2, table 6: signal_color_space 2) and gives
- * no matrices for it; these are the ones that the RPUs of profile 5 carry (as dovi_tool writes
- * them), in the units of the DM header: YCCtoRGB (IPT -> L'M'S', 13 fractional bits), its offsets
- * (28) and RGBtoLMS (the crosstalk of L, M and S, 14). The packer converts with their exact inverses
- * (dvbridge_source_to_ipt()), so a display decodes what was encoded. */
+/* Hades: the matrices of the IPT-PQ-c2 tunnel. A licensed core sends Dolby Vision in IPT-PQ-c2 whatever
+ * the profile: Dolby's own core (IDK 2.6) on an Amlogic player, read on the user's player in TV-led
+ * output with five films of profiles 5, 7 and 8.1 (read on 2026-11-24), sent these
+ * matrices, the same for every film and every frame, a profile 5 title with its own matrices among
+ * them. ETSI GS CCM 001 V1.1.1 allows it (6.2.2, table 6: signal_color_space 2) and gives no matrices
+ * for it. In the units of the DM header: YCCtoRGB (IPT -> L'M'S', 13 fractional bits: its first column
+ * 8194, not the 8192 of the RPUs of profile 5 as dovi_tool writes them), its offsets (28) and RGBtoLMS
+ * (the crosstalk of L, M and S, 14: 17080 and -348, not 17081 and -349). Sent as the bytes
+ * 2002 031f 0691 2002 fc5b 0443 2002 010b ea57, 00000000 08000000 08000000,
+ * 42b8 fea4 fea4 fea4 42b8 fea4 fea4 fea4 42b8, byte for byte those of the licensed core. The packer
+ * converts with their exact inverses (dvbridge_source_to_ipt()), so a display decodes what was
+ * encoded. (Until 2026-11: the matrices of the RPUs of profile 5, which differ from those in the last
+ * code of four coefficients.) */
 #ifndef DVBRIDGE_IPT_H
 #define DVBRIDGE_IPT_H
 
-#define DVBRIDGE_IPT_YCC {8192, 799, 1681, 8192, -933, 1091, 8192, 267, -5545}
+#define DVBRIDGE_IPT_YCC {8194, 799, 1681, 8194, -933, 1091, 8194, 267, -5545}
 #define DVBRIDGE_IPT_OFFSETS {0u, 134217728u, 134217728u}
-#define DVBRIDGE_IPT_LMS {17081, -349, -349, -349, 17081, -349, -349, -349, 17081}
+#define DVBRIDGE_IPT_LMS {17080, -348, -348, -348, 17080, -348, -348, -348, 17080}
 /* the RGBtoLMS of BT.2020 (that of the RPUs of profiles 7 and 8) */
 #define DVBRIDGE_LMS_2020 {7222, 8771, 390, 2654, 12430, 1300, 0, 422, 15962}
 
diff --git a/tools/dvbridge/dvbridge_metadata.h b/tools/dvbridge/dvbridge_metadata.h
index 563b7be..858cda2 100644
--- a/tools/dvbridge/dvbridge_metadata.h
+++ b/tools/dvbridge/dvbridge_metadata.h
@@ -669,7 +669,8 @@ static inline bool dvbridge_dv_made_area(struct dvbridge_dv *d, unsigned taken,
  * and the rest, which the display maps from itself. dovi_tool's "safe" CM v4.0 default is such a
  * set as well (levels 3, 9, 11 and 254, without 8 and 10). */
 /* Hades: source: 0 the picture converted to BT.2020, 1 the composer's picture as it is, 2 the
- * composer's YCbCr picture in IPT-PQ-c2 (dvbridge_source_to_ipt(), dvbridge_ipt.h) */
+ * composer's picture (YCbCr, or ICtCp with the matrices of its RPU) in IPT-PQ-c2 with the matrices of a
+ * licensed core (dvbridge_source_to_ipt(), dvbridge_ipt.h) */
 static inline bool dvbridge_dv_metadata(struct dvbridge_dv *d, const AVDOVIMetadata *m, double pts,
                                         int source, unsigned cover)
 {
@@ -748,16 +749,17 @@ static inline bool dvbridge_dv_metadata(struct dvbridge_dv *d, const AVDOVIMetad
         depth = hd->vdr_bit_depth;
         space = c->signal_color_space;
         if (source == 2) {
-            /* Hades: the IPT tunnel: a picture in YCbCr whose RGBtoLMS is that of BT.2020, sent in
-             * IPT-PQ-c2 with the matrices of the RPUs of profile 5 and signal_color_space 2 */
+            /* Hades: the IPT tunnel: a picture in YCbCr whose RGBtoLMS is that of BT.2020, or one in
+             * IPT-PQ-c2 with the matrices of its RPU (profile 5), sent in IPT-PQ-c2 with the matrices
+             * that a licensed core sends (dvbridge_ipt.h) and signal_color_space 2 */
