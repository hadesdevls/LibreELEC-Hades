       m_pendingDetail.sentCount = sent;
-      std::copy(std::begin(area), std::end(area), std::begin(m_pendingDetail.sentL5));
-      m_pendingDetail.sentL5Drawn = dvbridge_active_area(candidate, margins) &&
+      // (Hades: no level 5 block sent, dvbridge_dv_made_area(): nothing of it taken out either)
