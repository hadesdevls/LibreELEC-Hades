+    bool l5_none;
     /* Extension blocks of a level that CCM 001 reserves, which a display ignores: left out. */
     unsigned skipped, skipped_level;
     /* Hades: blocks of the content mapping v4.0 part of the metadata (levels 3, 8 to 11 and 254),
@@ -544,13 +547,30 @@ static inline bool dvbridge_dv_gap_refresh(struct dvbridge_dv *d, double gap)
     return earlier || (trusted && long_gap);
 }
 /* Hades: the level 5 block made for the raster, where the metadata have none: the place of the
- * picture (dvbridge_dv_margins() of no offsets), each edge drawn over beyond (taken) sent as 0 */
+ * picture (dvbridge_dv_margins() of no offsets), each edge drawn over beyond (taken) sent as 0.
+ * Hades: where that place is the whole raster (the four margins 0), no block is made: the metadata
+ * go out without a level 5 block, as the RPU has none. A display reads the active area as the whole
+ * picture either way (ETSI GS CCM 001 V1.1.1, 6.2.2), but displays do not treat the two alike: with
+ * an RPU of a positive lift in its level 2 trims, an LG C1 and a Hisense TV left the lift aside
+ * without a level 5 block and applied it with a whole-frame one (measured by fandangos with a
+ * colorimeter and the TVs' own captures: the shadows 11.8 to 13.1 times brighter), and the TVs' own
+ * players and an OPPO UDP-203 send none. A block of zeros made here described nothing that the RPU
+ * did not, and changed the picture. Where the player itself puts bars around the picture (a picture
+ * placed in the raster with its own shape), the block is made as before: they are the bars of what
+ * is sent. Whether a block is made goes by the place only, not by what is drawn over the bars
+ * (taken), so that it does not come and go with subtitles or the OSD. Hades' own metadata (HDR10,
+ * HDR10+ and HLG sent as Dolby Vision, the menus) have a level 5 block of their own
+ * (dvbridge_profile81_metadata()), sent as before. */
 static inline bool dvbridge_dv_made_area(struct dvbridge_dv *d, unsigned taken, unsigned count_pos)
 {
     unsigned v[4];
     if (!dvbridge_dv_margins(d, 0, 0, 0, 0, v))
         return false; /* (d->refused says why) */
     memcpy(d->margins, v, sizeof(d->margins));
+    if (!v[0] && !v[1] && !v[2] && !v[3]) {
+        d->reading.l5_none = true;
+        return true;
+    }
     for (int j = 0; j < 4; j++)
         if (taken >> j & 1) v[j] = 0; /* Hades: taken out to what is drawn over the bars */
     DV_REFUSE(d->size + 13 <= DVBRIDGE_DV_MAX_PAYLOAD,
@@ -641,6 +661,7 @@ static inline bool dvbridge_dv_metadata(struct dvbridge_dv *d, const AVDOVIMetad
     }
     d->reading.skipped = d->reading.skipped_level = 0;
     d->reading.l5_ignored = NULL;
+    d->reading.l5_none = false;
     d->reading.cm40_left_out = d->reading.cm40_dropped = d->reading.cm40_added = 0;
     /* 6.2.1 table 3: dm_metadata() */
     d->size = 0;
