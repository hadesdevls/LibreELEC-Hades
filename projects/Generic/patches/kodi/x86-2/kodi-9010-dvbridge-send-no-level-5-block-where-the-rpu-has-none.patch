@@ -65,15 +65,17 @@ bool dvbridge_hdr10plus_same_scene(const AVDynamicHDRPlus *a, const AVDynamicHDR
 
 /* The Dolby Vision metadata of the picture (av_free() it; *size its bytes): profile 8.1 over a 10-bit base layer,
  * identity mapping, BT.2020 PQ as dovi_tool's profile 8.1 has it, the source range of the mastering display (PQ
