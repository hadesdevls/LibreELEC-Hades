diff --git a/tools/dvbridge/dvbridge_core.c b/tools/dvbridge/dvbridge_core.c
index 56a8cff..c6fce95 100644
--- a/tools/dvbridge/dvbridge_core.c
+++ b/tools/dvbridge/dvbridge_core.c
@@ -264,6 +264,7 @@ bool dvbridge_candidate_reading(const struct dvbridge_candidate *candidate,
     memcpy(reading->as_given, r->as_given, sizeof(reading->as_given));
     memcpy(reading->margins, candidate->state.margins, sizeof(reading->margins));
     reading->l5_ignored = r->l5_ignored;
+    reading->l5_none = r->l5_none;
     reading->skipped = r->skipped;
     reading->skipped_level = r->skipped_level;
     reading->cm40_left_out = r->cm40_left_out;
@@ -291,7 +292,8 @@ int dvbridge_sent_blocks(const struct dvbridge_candidate *candidate, uint8_t *le
     if (!pos || pos >= d->size || d->size > sizeof(d->payload))
         return -1;
     /* As dvbridge_dv_metadata() writes each block: its length (32 bits), its level, its data.
-     * Every payload has one level 5 block, from the metadata or made for the raster. */
+     * A payload has one level 5 block, from the metadata or made for the raster (Hades: or none, where
+     * the metadata have none and the picture fills the raster: dvbridge_dv_made_area()). */
     const unsigned count = d->payload[pos++];
     bool area = false;
     for (unsigned i = 0; i < count; ++i) {
@@ -314,5 +316,10 @@ int dvbridge_sent_blocks(const struct dvbridge_candidate *candidate, uint8_t *le
             levels[i] = level;
         pos += length;
     }
-    return pos == d->size && area ? (int)count : -1;
+    if (pos != d->size || (!area && !d->reading.l5_none))
+        return -1;
+    if (!area)
+        for (unsigned j = 0; j < 4; ++j)
+            l5[j] = DVBRIDGE_SENT_NO_L5;
+    return (int)count;
 }
diff --git a/tools/dvbridge/dvbridge_core.h b/tools/dvbridge/dvbridge_core.h
index 428b867..a62932f 100644
--- a/tools/dvbridge/dvbridge_core.h
+++ b/tools/dvbridge/dvbridge_core.h
@@ -170,7 +170,11 @@ bool dvbridge_active_area(const struct dvbridge_candidate *candidate, unsigned m
  * read back from the payload that the display is sent, for the player information: their levels
  * in the order in which they are sent (the first max of them), and the four values of its level 5
  * block, the active area as left, right, top and bottom offsets on the 3840x2160 raster. Returns
- * how many blocks there are, or -1 when the payload does not read back as it is written. */
+ * how many blocks there are, or -1 when the payload does not read back as it is written.
+ * Hades: a payload has at most one level 5 block: none where the metadata have none and the
+ * picture fills the raster (dvbridge_dv_made_area() in dvbridge_metadata.h); its four values are
+ * then DVBRIDGE_SENT_NO_L5. */
+#define DVBRIDGE_SENT_NO_L5 0xFFFFFFFFu
 int dvbridge_sent_blocks(const struct dvbridge_candidate *candidate, uint8_t *levels,
                          unsigned max, unsigned l5[4]);
 
@@ -186,6 +190,9 @@ struct dvbridge_reading {
     /* Hades: the level 5 offsets were left aside for the video, and why (dvbridge_dv_l5() in dvbridge_metadata.h);
      * NULL when they were not */
     const char *l5_ignored;
+    /* Hades: the metadata have no level 5 block and the picture fills the raster: the display is sent none
+     * (dvbridge_dv_made_area() in dvbridge_metadata.h) */
+    bool l5_none;
     /* Extension blocks of reserved levels, left out (a display ignores them): how many, and the
      * level of the first one */
     unsigned skipped, skipped_level;
diff --git a/tools/dvbridge/dvbridge_hdr10plus.c b/tools/dvbridge/dvbridge_hdr10plus.c
index 2b84540..4220f57 100644
--- a/tools/dvbridge/dvbridge_hdr10plus.c
+++ b/tools/dvbridge/dvbridge_hdr10plus.c
@@ -319,14 +319,15 @@ AVDOVIMetadata *dvbridge_profile81_metadata(unsigned min_pq, unsigned max_pq, un
     e->l1.min_pq = min_pq;
     e->l1.max_pq = max_pq;
     e->l1.avg_pq = avg_pq;
-    if (area) {
-        e = av_dovi_get_ext(m, m->num_ext_blocks++);
-        e->level = 5;
-        e->l5.left_offset = area[0];
-        e->l5.right_offset = area[1];
-        e->l5.top_offset = area[2];
-        e->l5.bottom_offset = area[3];
-    }
+    /* Hades: a level 5 block always, of the area given or of the whole picture: these metadata are Hades' own, and the
