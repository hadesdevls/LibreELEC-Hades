From e347114e27390c3c6396163ee9a94d63655c99ae Mon Sep 17 00:00:00 2001
From: Portisch <hugo.portisch@yahoo.de>
Date: Thu, 19 Nov 2026 08:13:29 +0000
Subject: [PATCH] SMB: no new context while the system sleeps

As the system goes to sleep, CPowerManager::OnSleep() closes the network
shares, which frees the context of libsmbclient (CSMB::Deinit()). A job
or a thread that read a share then (a scan, the texture cache, a
directory of an add-on) made a new one at once in CSMB::Init(), with the
network going down under it, and that context outlived the sleep.

CSMB is now a CPowerState: OnSleep() is called before the shares are
closed and OnWake() once the network is back, and Init() makes no
context in between. The callers already see that there is none
(IsSmbValid()), the file operations as before; Create(), Remove() and
Exists() of CSMBDirectory now check it too, and Exists() closes the
directory it opened only when the context is still there.

From Portisch's pull request to Kodi, xbmc/xbmc#30662 ("[posix][smb]
Don't create a new context while the system sleeps", open at the time;
CoreELEC/xbmc commit c97cff967a).
---
 xbmc/platform/posix/filesystem/SMBDirectory.cpp | 10 +++++++++-
 xbmc/platform/posix/filesystem/SMBFile.cpp      |  5 ++++-
 xbmc/platform/posix/filesystem/SMBFile.h        |  4 +++-
 xbmc/powermanagement/PowerManager.cpp           | 12 ++++++++++++
 4 files changed, 28 insertions(+), 3 deletions(-)

diff --git a/xbmc/platform/posix/filesystem/SMBDirectory.cpp b/xbmc/platform/posix/filesystem/SMBDirectory.cpp
index 5b95189..fb33672 100644
--- a/xbmc/platform/posix/filesystem/SMBDirectory.cpp
+++ b/xbmc/platform/posix/filesystem/SMBDirectory.cpp
@@ -318,6 +318,8 @@ bool CSMBDirectory::Create(const CURL& url2)
 {
   std::unique_lock lock(smb);
   smb.Init();
+  if (!smb.IsSmbValid())
+    return false;
 
   CURL url = CSMB::GetResolvedUrl(url2);
   CPasswordManager::GetInstance().AuthenticateURL(url);
@@ -335,6 +337,8 @@ bool CSMBDirectory::Remove(const CURL& url2)
 {
   std::unique_lock lock(smb);
   smb.Init();
+  if (!smb.IsSmbValid())
+    return false;
 
   CURL url = CSMB::GetResolvedUrl(url2);
   CPasswordManager::GetInstance().AuthenticateURL(url);
@@ -355,6 +359,8 @@ bool CSMBDirectory::Exists(const CURL& url2)
 {
   std::unique_lock lock(smb);
   smb.Init();
+  if (!smb.IsSmbValid())
+    return false;
 
   // A bare server URL (smb://server/) has no share to stat, so smbc_stat() fails on it
   // even when the server is up. Count the server as existing if it can list its shares,
@@ -368,7 +374,9 @@ bool CSMBDirectory::Exists(const CURL& url2)
       return false;
 
     lock.lock();
-    smbc_closedir(fd);
+    // (the context that opened it may have gone meanwhile, with the shares closed for a sleep)
+    if (smb.IsSmbValid())
+      smbc_closedir(fd);
     return true;
   }
 
diff --git a/xbmc/platform/posix/filesystem/SMBFile.cpp b/xbmc/platform/posix/filesystem/SMBFile.cpp
index 79d98e1..0e41640 100644
--- a/xbmc/platform/posix/filesystem/SMBFile.cpp
+++ b/xbmc/platform/posix/filesystem/SMBFile.cpp
@@ -488,7 +488,10 @@ void CSMB::Init()
 {
   std::unique_lock lock(*this);
 
-  if (!m_context)
+  // Hades: not while the system goes to sleep or sleeps: the shares are closed (Deinit()) as it
+  // goes, and a context made then, by a job or a thread that reads a share, has no network under
+  // it and outlives the sleep. The callers find no context (IsSmbValid()) and fail.
+  if (!m_context && !IsSleeping())
   {
     const std::shared_ptr<CSettings> settings =
         CServiceBroker::GetSettingsComponent()->GetSettings();
diff --git a/xbmc/platform/posix/filesystem/SMBFile.h b/xbmc/platform/posix/filesystem/SMBFile.h
index 162a502..005ebee 100644
--- a/xbmc/platform/posix/filesystem/SMBFile.h
+++ b/xbmc/platform/posix/filesystem/SMBFile.h
@@ -16,6 +16,7 @@
 
 #include "URL.h"
 #include "filesystem/IFile.h"
+#include "powermanagement/PowerState.h"
 #include "threads/CriticalSection.h"
 
 #include <cerrno>
@@ -31,7 +32,8 @@
 struct _SMBCCTX;
 typedef _SMBCCTX SMBCCTX;
 
-class CSMB : public CCriticalSection
+// Hades: and a CPowerState: while the system sleeps, Init() makes no context (CPowerManager)
+class CSMB : public CCriticalSection, public CPowerState
 {
 public:
   CSMB();
diff --git a/xbmc/powermanagement/PowerManager.cpp b/xbmc/powermanagement/PowerManager.cpp
index 60c93a0..d869644 100644
--- a/xbmc/powermanagement/PowerManager.cpp
+++ b/xbmc/powermanagement/PowerManager.cpp
@@ -39,6 +39,10 @@
 
 #include "windowing/WinSystem.h"
 
+#if defined(TARGET_POSIX) && defined(HAS_FILESYSTEM_SMB)
+#include "platform/posix/filesystem/SMBFile.h"
+#endif
+
 #if defined(TARGET_LINUX)
 #include "platform/linux/HadesFirmwareBoot.h"
 #endif
@@ -219,6 +223,10 @@ void CPowerManager::OnSleep()
   const auto appPower = components.GetComponent<CApplicationPowerHandling>();
   appPower->StopShutdownTimer();
   appPower->StopScreenSaverTimer();
+#if defined(TARGET_POSIX) && defined(HAS_FILESYSTEM_SMB)
+  // (Hades: before the shares are closed, so that none is opened again until the system wakes)
+  smb.OnSleep();
+#endif
   g_application.CloseNetworkShares();
   CServiceBroker::GetActiveAE()->Suspend();
 }
@@ -233,6 +241,10 @@ void CPowerManager::OnWake()
     winSystem->OnSystemWake();
 
   CServiceBroker::GetNetwork().WaitForNet();
+#if defined(TARGET_POSIX) && defined(HAS_FILESYSTEM_SMB)
+  // (Hades: the network is back: the shares can be opened again)
+  smb.OnWake();
+#endif
 
   // reset out timers
   auto& components = CServiceBroker::GetAppComponents();
-- 
