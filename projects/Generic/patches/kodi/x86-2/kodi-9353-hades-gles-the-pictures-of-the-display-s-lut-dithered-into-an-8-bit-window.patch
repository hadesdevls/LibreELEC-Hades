From 000577dfd15cbe6ad6148ab7317a0dc6432fb1d6 Mon Sep 17 00:00:00 2001
From: Hades <15710513+hadesdevls@users.noreply.github.com>
Date: Wed, 25 Nov 2026 19:42:27 +0000
Subject: [PATCH] [Hades][GLES] The pictures of the display's LUT dithered into
 an 8-bit window

A LUT puts the values of a picture between the codes of the window. The
bridge's copy dithers the pictures it maps into an 8-bit window (blue
noise, dvbridge_gl_pack.c), but the pictures that Kodi draws itself were
rounded: Kodi's dither (videoscreen.dither) is off by default, and its
automatic depth did not count the LUT. Measured on a slow dark gradient
through a calibration-like LUT, rounded to 8 bits the picture is up to
0.38 of a code off over a block of 16 pixels (in bands of up to 88
pixels), and 0.02 with Kodi's ordered dither.

- Kodi's dither on, depth automatic: the LUT in the pass counts, as a
  change of range or tone mapping does.
- Kodi's dither off: where the LUT is applied and the window is of 8
  bits, the shaders that apply it take Kodi's ordered dither at 8 bits
  (its texture made the first time it is needed, as the constructor
  makes it for videoscreen.dither); a window of more bits is left as it
  is, and so is every picture without the LUT, to the byte.
---
 .../VideoRenderers/LinuxRendererGLES.cpp      | 93 ++++++++++++++++---
 .../VideoRenderers/LinuxRendererGLES.h        |  4 +
 2 files changed, 83 insertions(+), 14 deletions(-)

diff --git a/xbmc/cores/VideoPlayer/VideoRenderers/LinuxRendererGLES.cpp b/xbmc/cores/VideoPlayer/VideoRenderers/LinuxRendererGLES.cpp
index a4d04b5..8e42fa4 100644
--- a/xbmc/cores/VideoPlayer/VideoRenderers/LinuxRendererGLES.cpp
+++ b/xbmc/cores/VideoPlayer/VideoRenderers/LinuxRendererGLES.cpp
@@ -1642,6 +1642,18 @@ void CLinuxRendererGLES::Lut3dTake()
   // (Hades: and with its 1D LUT where it has one: a LUT that takes the place of another in one frame changes the
   // shaders where one has a 1D LUT and the other none)
   const bool curve = want && m_lut3d.HasCurve();
+  // Hades: a picture that the LUT changes is dithered where it goes into a window of 8 bits, as the bridge's copy
+  // dithers the pictures it maps (dvbridge_gl_pack.c): its values fall between the codes of the window, and rounded a
+  // slow gradient through a calibration is up to 0.38 of a code off over a block of 16 pixels, in bands (dithered:
+  // 0.02). Where Kodi's own dither is on (videoscreen.dither), Kodi's dither does it; where it is off, Kodi's ordered
+  // dither is put in the shaders of the LUT alone, at 8 bits (a window of more bits is left as it is)
+  bool lutDither = false;
+  if (want && !m_useDithering)
+  {
+    GLint redBits = 0;
+    glGetIntegerv(GL_RED_BITS, &redBits);
+    lutDither = redBits == 8 && LutDitherTexture();
+  }
   if (!lut && m_lut3d.Started())
   {
     m_lut3d.Release();
@@ -1650,10 +1662,11 @@ void CLinuxRendererGLES::Lut3dTake()
   }
   // the shaders made again with it or without it where it comes or goes (the setting, the LUT of another display, the
   // video going out as HDR), the scaler of a second pass too: once, as for a change of the scaling method
-  if (want != m_lut3dShaders || curve != m_lut3dCurveShaders)
+  if (want != m_lut3dShaders || curve != m_lut3dCurveShaders || lutDither != m_lutDither)
   {
     m_lut3dShaders = want;
     m_lut3dCurveShaders = curve;
+    m_lutDither = lutDither;
     m_reloadShaders = true;
     m_scalingMethodGui = VS_SCALINGMETHOD_MAX;
     CLog::Log(LOGDEBUG, "3D LUT: the shaders of Kodi's renderer are made again {} it", want ? "with" : "without");
@@ -1693,6 +1706,33 @@ void CLinuxRendererGLES::Lut3dDrawn()
   window->LutDrawn(true, applied, failed, m_lut3dPending);
 }
 
+bool CLinuxRendererGLES::LutDitherTexture()
+{
+  // the texture of Kodi's dither, as the constructor makes it where videoscreen.dither is on
+  if (m_ditherTex)
+    return true;
+#if defined(GL_R16_EXT)
+  if (!CGLExtensions::IsExtensionSupported(CGLExtensions::EXT_texture_norm16))
+    return false;
+  glGenTextures(1, &m_ditherTex);
+  glActiveTexture(GL_TEXTURE3);
+  glBindTexture(GL_TEXTURE_2D, m_ditherTex);
+  glPixelStorei(GL_UNPACK_ALIGNMENT, 1);
+  glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_MAG_FILTER, GL_NEAREST);
+  glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_MIN_FILTER, GL_NEAREST);
+  glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_WRAP_S, GL_REPEAT);
+  glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_WRAP_T, GL_REPEAT);
+  glTexImage2D(GL_TEXTURE_2D, 0, GL_R16_EXT, dither_size, dither_size, 0, GL_RED, GL_UNSIGNED_SHORT,
+               dither_matrix);
+  glPixelStorei(GL_UNPACK_ALIGNMENT, 4);
+  glActiveTexture(GL_TEXTURE0);
+  CLog::Log(LOGINFO, "3D LUT: its pictures dithered into the 8 bits of the window (Kodi's ordered dither)");
+  return true;
+#else
+  return false;
+#endif
+}
+
 const CLut3dGLES* CLinuxRendererGLES::Lut3dShaders() const
 {
   return m_lut3dShaders && m_lut3d.Valid() ? &m_lut3d : nullptr;
@@ -2407,17 +2447,21 @@ void CLinuxRendererGLES::UpdateVideoFilter()
 
     // TODO: GL also passes m_nonLinStretch, m_intermediateGammaCorrection.
     // Add when non-linear stretch and gamma correction are ported to GLES.
+    bool useDither = m_useDithering;
 #ifdef HAVE_DVBRIDGE
     // Hades: the scaler of the second pass writes the picture to the window: the 3D LUT of the display goes there
     // (Lut3dTake()); made again without it where the GPU does not make it with it
     const CLut3dGLES* lut3d = Lut3dShaders();
-    m_pVideoFilterShader = new ConvolutionFilterShader(m_scalingMethod, m_useDithering, lut3d);
+    // (and dithered into an 8-bit window where Kodi's own dither is off: m_lutDither, Lut3dTake())
+    useDither = m_useDithering || (m_lutDither && lut3d);
+    m_pVideoFilterShader = new ConvolutionFilterShader(m_scalingMethod, useDither, lut3d);
     bool filterMade = m_pVideoFilterShader->CompileAndLink();
     if (!filterMade && lut3d)
     {
       delete m_pVideoFilterShader;
       m_pVideoFilterShader = new ConvolutionFilterShader(m_scalingMethod, m_useDithering);
       filterMade = m_pVideoFilterShader->CompileAndLink();
+      useDither = m_useDithering;
       // (where it is made without the LUT, the LUT was why)
       if (filterMade)
         Lut3dShaderFailed("the scaler of the second pass");
@@ -2432,11 +2476,14 @@ void CLinuxRendererGLES::UpdateVideoFilter()
       break;
     }
 
-    if (m_useDithering && m_ditherTex)
+    if (useDither && m_ditherTex)
     {
       bool ditherActive = true;
       unsigned int effectiveDitherDepth = m_ditherDepth;
-      if (m_ditherDepth == 0)
+      // Hades: the dither of the LUT alone (Kodi's off): into the 8 bits of the window
+      if (!m_useDithering)
+        effectiveDitherDepth = 8;
+      else if (m_ditherDepth == 0)
       {
         GLint redBits = 0;
         glGetIntegerv(GL_RED_BITS, &redBits);
@@ -2451,6 +2498,12 @@ void CLinuxRendererGLES::UpdateVideoFilter()
         bool downscaling = scaleFactor > 0.0f && scaleFactor < 1.0f;
         ditherActive = (m_srcFullRange != m_fullRange) || m_srcColorBits > effectiveDitherDepth ||
                        m_toneMap || downscaling;
+#ifdef HAVE_DVBRIDGE
+        // Hades: and the 3D LUT of the display where this pass applies it: its values fall between the codes of the
+        // window (a slow gradient through a calibration, rounded to 8 bits: up to 0.38 of a code off over a block of
+        // 16 pixels, in bands; dithered: 0.02)
+        ditherActive = ditherActive || m_pVideoFilterShader->HasLut3d();
+#endif
       }
       static_cast<ConvolutionFilterShader*>(m_pVideoFilterShader)
           ->SetDitherUniforms(ditherActive, m_ditherTex, effectiveDitherDepth, dither_size);
@@ -2519,8 +2572,16 @@ void CLinuxRendererGLES::LoadShaders(int field)
           // The m_ditherEnabled uniform controls whether the shader applies dithering.
           bool ditherActive = true;
           unsigned int effectiveDitherDepth = m_ditherDepth;
-
-          if (m_ditherDepth == 0 && m_ditherTex)
+          // Hades: the 3D LUT of the display where this pass applies it (UpdateVideoFilter() for a second pass), and
+          // its dither into an 8-bit window where Kodi's own dither is off (m_lutDither, Lut3dTake())
+          bool lutDithered = false;
+#ifdef HAVE_DVBRIDGE
+          lutDithered = m_renderQuality != RQ_MULTIPASS && Lut3dShaders() != nullptr;
+#endif
+          const bool useDither = m_useDithering || (m_lutDither && lutDithered);
+          if (!m_useDithering)
+            effectiveDitherDepth = 8;
+          else if (m_ditherDepth == 0 && m_ditherTex)
           {
             GLint redBits = 0;
             glGetIntegerv(GL_RED_BITS, &redBits);
@@ -2533,12 +2594,14 @@ void CLinuxRendererGLES::LoadShaders(int field)
             bool downscaling = scaleFactor > 0.0f && scaleFactor < 1.0f;
             ditherActive = (m_srcFullRange != m_fullRange) ||
                            m_srcColorBits > effectiveDitherDepth || m_toneMap || downscaling;
+            // Hades: and the 3D LUT of the display where this pass applies it
+            ditherActive = ditherActive || lutDithered;
 
             CLog::Log(LOGDEBUG,
                       "GLES: auto dither {} (depth={}, source={}bit, "
-                      "rangeMismatch={}, toneMap={}, downscaling={})",
+                      "rangeMismatch={}, toneMap={}, downscaling={}, lut3d={})",
                       ditherActive ? "on" : "off", effectiveDitherDepth, m_srcColorBits,
-                      m_srcFullRange != m_fullRange, m_toneMap, downscaling);
+                      m_srcFullRange != m_fullRange, m_toneMap, downscaling, lutDithered);
           }
 
           EShaderFormat shaderFormat = GetShaderFormat();
@@ -2563,7 +2626,7 @@ void CLinuxRendererGLES::LoadShaders(int field)
           {
             m_pYUVProgShader = new YUV2RGBFilterShader(shaderFormat, DrawnPrimaries(), m_srcPrimaries,
                                                        m_toneMap, m_toneMapMethod, m_scalingMethod,
-                                                       m_useDithering, chroma, lut3d);
+                                                       useDither, chroma, lut3d);
             // TODO: GL gates this on !m_cmsOn. Add when CMS is ported to GLES.
             m_pYUVProgShader->SetConvertFullColorRange(m_fullRange);
 
@@ -2588,7 +2651,7 @@ void CLinuxRendererGLES::LoadShaders(int field)
 #endif
             if (filterMade)
             {
-              if (m_useDithering && m_ditherTex)
+              if ((m_useDithering || (useDither && lut3d)) && m_ditherTex)
                 m_pYUVProgShader->SetDitherUniforms(ditherActive, m_ditherTex, effectiveDitherDepth,
                                                     dither_size);
               TellChroma(m_pYUVProgShader->ChromaFilter());
@@ -2607,7 +2670,7 @@ void CLinuxRendererGLES::LoadShaders(int field)
           // Fall back to regular progressive shader
           m_pYUVProgShader =
               new YUV2RGBProgressiveShader(shaderFormat, DrawnPrimaries(), m_srcPrimaries,
-                                           m_toneMap, m_toneMapMethod, m_useDithering, chroma, lut3d);
+                                           m_toneMap, m_toneMapMethod, useDither, chroma, lut3d);
           m_pYUVProgShader->SetConvertFullColorRange(m_fullRange);
           bool progressiveMade = m_pYUVProgShader->CompileAndLink();
 #ifdef HAVE_DVBRIDGE
@@ -2645,7 +2708,7 @@ void CLinuxRendererGLES::LoadShaders(int field)
             delete m_pYUVProgShader;
             m_pYUVProgShader =
                 new YUV2RGBProgressiveShader(shaderFormat, DrawnPrimaries(), m_srcPrimaries,
-                                             m_toneMap, m_toneMapMethod, m_useDithering, fewer, lut3d);
+                                             m_toneMap, m_toneMapMethod, useDither, fewer, lut3d);
             m_pYUVProgShader->SetConvertFullColorRange(m_fullRange);
             progressiveMade = m_pYUVProgShader->CompileAndLink();
             m_chroma.Start(static_cast<int>(fewer));
@@ -2657,7 +2720,7 @@ void CLinuxRendererGLES::LoadShaders(int field)
             TellChroma(m_pYUVProgShader->ChromaFilter());
 
           m_pYUVBobShader = new YUV2RGBBobShader(shaderFormat, DrawnPrimaries(), m_srcPrimaries,
-                                                 m_toneMap, m_toneMapMethod, m_useDithering, lut3d);
+                                                 m_toneMap, m_toneMapMethod, useDither, lut3d);
           m_pYUVBobShader->SetConvertFullColorRange(m_fullRange);
           bool bobMade = progressiveMade && m_pYUVBobShader->CompileAndLink();
 #ifdef HAVE_DVBRIDGE
@@ -2676,7 +2739,8 @@ void CLinuxRendererGLES::LoadShaders(int field)
 
           if (bobMade)
           {
-            if (m_useDithering && m_ditherTex)
+            // (Hades: the dither of the LUT alone only in shaders that have the LUT; a shader made without it has none)
+            if ((m_useDithering || (useDither && lut3d)) && m_ditherTex)
             {
               m_pYUVProgShader->SetDitherUniforms(ditherActive, m_ditherTex, effectiveDitherDepth,
                                                   dither_size);
@@ -2762,6 +2826,7 @@ void CLinuxRendererGLES::UnInit()
   m_lut3d.Release();
   m_lut3dShaders = false;
   m_lut3dCurveShaders = false;
+  m_lutDither = false;
   m_lut3dOf = nullptr;
   m_lut3dSig = 0;
 #endif
diff --git a/xbmc/cores/VideoPlayer/VideoRenderers/LinuxRendererGLES.h b/xbmc/cores/VideoPlayer/VideoRenderers/LinuxRendererGLES.h
index c9808f0..a458460 100644
--- a/xbmc/cores/VideoPlayer/VideoRenderers/LinuxRendererGLES.h
+++ b/xbmc/cores/VideoPlayer/VideoRenderers/LinuxRendererGLES.h
@@ -341,6 +341,8 @@ protected:
   //! A shader with the LUT could not be made on this GPU, and was made without it (which: what it is, for the log): the
   //! LUT is not tried again for this video until another one is chosen
   void Lut3dShaderFailed(const char* which);
+  //! Hades: the texture of Kodi's dither for the pictures of the LUT where videoscreen.dither is off (made once)
+  bool LutDitherTexture();
   Shaders::GLES::CLut3dGLES m_lut3d;
   //! the LUT of the window system whose table m_lut3d holds (compared, never read: the window system keeps it), and the
   //! signature of its file
@@ -352,6 +354,8 @@ protected:
   //! the shaders are made with it (and with its 1D LUT: Hades, gles_lut3d_curve.frag)
   bool m_lut3dShaders = false;
   bool m_lut3dCurveShaders = false;
+  //! Hades: those shaders dither into the 8-bit window where Kodi's own dither is off (LutDitherTexture())
+  bool m_lutDither = false;
   //! the picture in hand is drawn into the window (Lut3dTake() asked the window system), and the LUT it gave was
   //! refused by this GPU
   bool m_lut3dTaken = false;
