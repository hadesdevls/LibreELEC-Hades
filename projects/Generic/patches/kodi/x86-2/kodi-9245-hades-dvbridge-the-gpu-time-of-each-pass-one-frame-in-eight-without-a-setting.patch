+void CDVBridgeGLES::TimePasses(bool everyFrame)
+{
+  dvbridge_render_time_passes(m_renderer, true);
+  bool placebo = false;
+  bool own = false;
+  dvbridge_render_passes_timed(m_renderer, &placebo, &own);
+  // (a GL without GL_EXT_disjoint_timer_query has no timers: nothing is sampled then)
+  m_passTimes = placebo || own;
+  if (!m_passTimes)
+  {
+    dvbridge_render_time_passes(m_renderer, false);
+    CLog::Log(LOGINFO, "DVBridge: the GPU time of each pass is not measured: the GL has no "
+                       "GL_EXT_disjoint_timer_query");
+    return;
+  }
+  m_passEvery = everyFrame ? 1 : PASS_SAMPLE_EVERY;
+  m_passFrame = 0;
+  CLog::Log(LOGINFO,
+            "DVBridge: the GPU time of each pass is measured in one frame of {}{}: libplacebo's "
+            "passes {}, the bridge's own {}",
+            m_passEvery, everyFrame ? " (every one, as advancedsettings.xml asks: dvpasstimes)" : "",
+            placebo ? "timed" : "not timed", own ? "timed" : "not timed");
+}
+
+void CDVBridgeGLES::SamplePasses()
+{
+  if (!m_passTimes || !m_renderer)
+    return;
+  dvbridge_render_sample_passes(m_renderer, m_passEvery <= 1 || m_passFrame++ % m_passEvery == 0);
+}
