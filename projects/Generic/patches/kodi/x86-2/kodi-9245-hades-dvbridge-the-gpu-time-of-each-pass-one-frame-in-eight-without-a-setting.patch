+void dvbridge_render_sample_passes(struct dvbridge_renderer *r, bool now)
+{
+    if (!r || !r->passtime || r->passtime_now == now)
+        return;
+    r->passtime_now = now;
+    pl_opengl_pause_timers(r->gpu, !now);
+}
