+void CWinSystemGbmGLESContext::ConversionPassTimes(bool end)
+{
+  if (!m_dvConvertBridge)
+    return;
+  const auto now = std::chrono::steady_clock::now();
+  if (m_convPassesStart == std::chrono::steady_clock::time_point{})
+    m_convPassesStart = now;
+  if (!end && now - m_convPassesStart < std::chrono::seconds(10))
+    return;
+  m_convPassesStart = now;
+  const auto passes = m_dvConvertBridge->TakePassTimes(CDVPassTimes::LOGGED);
