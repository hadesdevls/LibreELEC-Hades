+std::string CPeripheralCecAdapter::ConnectorName(unsigned int card, uint32_t connectorId)
+{
+  // Hades: the name of a DRM connector (DP-1, HDMI-A-3...) from its id, as sysfs has it
+  // (/sys/class/drm/card<n>-<name>/connector_id); empty where it does not say
+#if defined(TARGET_LINUX)
+  const std::string prefix = StringUtils::Format("card{}-", card);
+  std::error_code error;
+  for (const auto& entry : std::filesystem::directory_iterator("/sys/class/drm", error))
+  {
+    const std::string name = entry.path().filename().string();
+    if (!name.starts_with(prefix))
+      continue;
+    std::ifstream file(entry.path() / "connector_id");
+    uint32_t id = 0;
+    if (file >> id && id == connectorId)
+      return name.substr(prefix.size());
+  }
+#endif
+  return {};
+}
+
+std::optional<std::pair<int, std::string>> CPeripheralCecAdapter::GetSettingsNote() const
+{
+  // Hades: an adapter on another output than Kodi's picture: the TV's remote does not reach Kodi
+  // through it (issue #24). Said here, where the user looks when the remote does nothing, and not
+  // at every start: it may be connected so on purpose, for an AV receiver.
+  if (m_picture != CEC_PICTURE::Verdict::OTHER)
+    return std::nullopt;
+  std::unique_lock lock(m_noteLock);
+  if (m_noteAdapter.empty())
+    return std::nullopt;
+  return std::make_pair(
+      62340, StringUtils::Format(CGUIUtils::GetHadesString(62341, 54341), m_noteAdapter,
+                                 m_notePicture));
+}
