From fa86bda151aa1fb45a7ce385432c920c89cdeb10 Mon Sep 17 00:00:00 2001
From: Hades <15710513+hadesdevls@users.noreply.github.com>
Date: Tue, 24 Nov 2026 17:04:55 +0000
Subject: [PATCH] [Hades][GBM] After a refused frame packing, the next 3D
 layout is chosen for the eyes as they will be drawn

NTM-3D, LibreELEC forum thread 30682 #172, on four NVIDIA cards (GTX 1080,
RTX 2080 SUPER, 4070 Ti SUPER, 5050): a 3D Blu-ray went to frame packing for a
moment, then to top and bottom, and 3.4 s later to side by side half. In the
kodi.log of the 2080 SUPER, frame packing was refused by the driver
(03:03:42.862), Kodi set the 2D mode with the vendor InfoFrame of top and
bottom (42.924), and side by side half at the next try (46.384). A Philips
display stayed in the first layout through that.

A side-by-side source (an MVC film too) is drawn one above the other only
while frame packing is what the display takes (GetStereoOutputArrangement()).
The layout after the refusal was chosen for the frame drawn before, one above
the other (top and bottom), while the eyes went back to side by side from the
next frame, which then asked for side by side half: two changes of mode where
one does. The layout is now chosen for the arrangement that will be drawn
(STEREO::ArrangementToChoose()): side by side where the eyes were drawn one
above the other only for frame packing and frame packing has been refused. A
source that is top and bottom itself is chosen as before.

Test: tools/regress/mvc/kodi (stereo_rate_test.cpp), five cases and two
mutants of the rule.
---
 xbmc/windowing/gbm/WinSystemGbm.cpp | 20 ++++++++++++--------
 xbmc/windowing/gbm/WinSystemGbm.h   |  5 +++++
 xbmc/windowing/gbm/drm/DRMStereo.h  | 21 +++++++++++++++++++++
 3 files changed, 38 insertions(+), 8 deletions(-)

diff --git a/xbmc/windowing/gbm/WinSystemGbm.cpp b/xbmc/windowing/gbm/WinSystemGbm.cpp
index 94dd2c9..dfb8064 100644
--- a/xbmc/windowing/gbm/WinSystemGbm.cpp
+++ b/xbmc/windowing/gbm/WinSystemGbm.cpp
@@ -727,12 +727,6 @@ bool IsSplitStereoMode(RenderStereoMode mode)
   return mode == RenderStereoMode::SPLIT_HORIZONTAL || mode == RenderStereoMode::SPLIT_VERTICAL;
 }
 
-STEREO::Arrangement ArrangementOf(RenderStereoMode mode)
-{
-  return mode == RenderStereoMode::SPLIT_HORIZONTAL ? STEREO::Arrangement::TOP_AND_BOTTOM
-                                                   : STEREO::Arrangement::SIDE_BY_SIDE;
-}
-
 // Kodi's option of the whitelist (CResolutionUtils::FindResolutionFromWhitelist())
 constexpr const char* SETTING_VIDEOSCREEN_WHITELIST_DOUBLEREFRESHRATE =
     "videoscreen.whitelistdoublerefreshrate";
@@ -948,7 +942,7 @@ bool CWinSystemGbm::GetStereoOutputMode(RESOLUTION res,
   STEREO::Choice choice;
   if (GetStereoOffers(offers, allowed, reason, true))
   {
-    choice = STEREO::Choose(offers, base, ArrangementOf(mode), allowed);
+    choice = STEREO::Choose(offers, base, ArrangementToChoose(mode), allowed);
     if (choice.layout == STEREO::Layout::NONE)
     {
       reason = allowed.framePacking && allowed.halfModes && allowed.infoFrame
@@ -1044,10 +1038,19 @@ bool CWinSystemGbm::GetStereoOutputMode(RESOLUTION res,
   return true;
 }
 
+STEREO::Arrangement CWinSystemGbm::ArrangementToChoose(RenderStereoMode drawn) const
+{
+  return STEREO::ArrangementToChoose(drawn == RenderStereoMode::SPLIT_HORIZONTAL,
+                                     m_stereoDrawnForFramePacking, m_stereoRefusedFramePacking);
+}
+
 RenderStereoMode CWinSystemGbm::GetStereoOutputArrangement(RenderStereoMode wanted)
 {
   if (wanted != RenderStereoMode::SPLIT_VERTICAL || !m_DRM)
+  {
+    m_stereoDrawnForFramePacking = false; // (Hades: ArrangementToChoose())
     return wanted;
+  }
 
   const RESOLUTION_INFO entry =
       CDisplaySettings::GetInstance().GetResolutionInfo(GetGfxContext().GetVideoResolution());
@@ -1057,6 +1060,7 @@ RenderStereoMode CWinSystemGbm::GetStereoOutputArrangement(RenderStereoMode want
   const bool packed =
       !entry.strId.empty() && GetStereoOffers(offers, allowed, reason, false) &&
       STEREO::PrefersTopAndBottom(offers, std::atoi(entry.strId.c_str()), allowed);
+  m_stereoDrawnForFramePacking = packed; // (Hades: ArrangementToChoose())
   if (m_stereoArrangementTold.exchange(packed) != packed && packed)
     CLog::Log(LOGINFO,
               "3D output: the display takes frame packing for {}: the eyes are drawn one above "
@@ -1175,7 +1179,7 @@ void CWinSystemGbm::PrepareStereoInfoFrame(const RESOLUTION_INFO& res)
     if (GetStereoOffers(offers, allowed, reason, true))
     {
       const int base = std::atoi(res.strId.c_str());
-      const STEREO::Choice choice = STEREO::Choose(offers, base, ArrangementOf(drawn), allowed);
+      const STEREO::Choice choice = STEREO::Choose(offers, base, ArrangementToChoose(drawn), allowed);
       if (choice.infoFrame && choice.mode == base)
         wanted = choice.layout;
     }
diff --git a/xbmc/windowing/gbm/WinSystemGbm.h b/xbmc/windowing/gbm/WinSystemGbm.h
index 837670a..534f09f 100644
--- a/xbmc/windowing/gbm/WinSystemGbm.h
+++ b/xbmc/windowing/gbm/WinSystemGbm.h
@@ -1206,6 +1206,11 @@ private:
   int m_stereoLeaveTries{0}; //!< times in a row that a 3D mode stayed when a 2D one was set
   std::string m_stereoStatus; //!< see TellStereoOutput()
   std::atomic<bool> m_stereoArrangementTold{false};
+  //! Hades: the eyes are drawn one above the other only for frame packing, from a side-by-side
+  //! source (GetStereoOutputArrangement()); for ArrangementToChoose()
+  std::atomic<bool> m_stereoDrawnForFramePacking{false};
+  //! Hades: the arrangement that the next 3D layout is chosen for (STEREO::ArrangementToChoose())
+  STEREO::Arrangement ArrangementToChoose(RenderStereoMode drawn) const;
   //! What the display says of 3D, under m_infoLock (other threads ask): the modes of its
   //! connector as they were when the resolutions were made of them (UpdateResolutions(): the
   //! place of a mode among them is the strId of its resolution), and the 3D part of its
diff --git a/xbmc/windowing/gbm/drm/DRMStereo.h b/xbmc/windowing/gbm/drm/DRMStereo.h
index 470687b..398f6ed 100644
--- a/xbmc/windowing/gbm/drm/DRMStereo.h
+++ b/xbmc/windowing/gbm/drm/DRMStereo.h
@@ -969,6 +969,27 @@ constexpr bool TakeAwayHeldInfoFrame(bool layoutMode, uint64_t held, uint64_t ow
   return layoutMode && held != 0 && held != own;
 }
 
+/*!
+ * \brief Hades: the arrangement that the next 3D layout is chosen for (Choose())
+ *
+ * A side-by-side source (an MVC film too) is drawn one above the other only while frame packing
+ * is what the display takes (CWinSystemGbm::GetStereoOutputArrangement()). Once the driver refused
+ * frame packing, the eyes go back to side by side from the next frame on, and the layout chosen
+ * for the frame drawn before (top and bottom) would last only until then: NTM-3D saw it on four
+ * NVIDIA cards, top and bottom for 3.4 s, then side by side half, two changes of mode where one
+ * does. A source that is top and bottom itself is drawn so whatever the display takes.
+ * \param topAndBottom the last frame drew the eyes one above the other
+ * \param forFramePacking ... only because frame packing was preferred, for a side-by-side source
+ * \param framePackingRefused frame packing was refused since
+ */
+constexpr Arrangement ArrangementToChoose(bool topAndBottom, bool forFramePacking,
+                                          bool framePackingRefused)
+{
+  if (topAndBottom && !(forFramePacking && framePackingRefused))
+    return Arrangement::TOP_AND_BOTTOM;
+  return Arrangement::SIDE_BY_SIDE;
+}
+
 } // namespace STEREO
 } // namespace GBM
 } // namespace WINDOWING
