@@ -0,0 +1,70 @@
+/* SPDX-License-Identifier: GPL-2.0-or-later */
+#pragma once
+
+#include "cores/VideoSettings.h"
+
+/*!
+ * \brief Hades: the default tone mapping method of a profile, and what earlier versions saved of it
+ *
+ * The method of a reference display (VS_TONEMAPMETHOD_BT2390) is the default. Up to LibreELEC Hades
+ * 1.0 every new profile got Off instead, without anyone choosing it: CVideoSettings starts with Off,
+ * and the settings file of a new profile is written from the defaults before it is first read
+ * (CSettings::Load() -> Reset() -> Save()). That file then said "hadestonemap" 1, which kept the Off
+ * from then on. And Kodi keeps the video settings of a file (the settings table of the video
+ * database) whenever a video stops with any of them other than the defaults (another audio or
+ * subtitle stream is enough): those took the Off along. On a display or projector without HDR, Off
+ * leaves HDR10, HDR10+, HLG and Dolby Vision profiles 7 and 8.1 unmapped (washed out), and "Play
+ * HDR videos as SDR" does the same on one with HDR. An HDR display that is sent HDR is not concerned:
+ * the method maps only what goes out as SDR. YBLOD described the fault (its kodi-9909 and kodi-9960).
+ */
+namespace HADES_TONEMAP
+{
+//! "hadestonemap" as this version writes it into guisettings.xml (1 was written up to 1.0, where an
+//! Off read with it stayed)
+constexpr int DEFAULTS_MARKER = 2;
+
+//! A method as it is read from a file: one out of the range is not taken (an ETONEMAPMETHOD past the
+//! last one names no method, and the formatter of the log throws for it)
+constexpr bool ValidMethod(int method)
+{
+  return method >= VS_TONEMAPMETHOD_OFF && method < VS_TONEMAPMETHOD_MAX;
+}
+
+/*!
+ * \brief What the default method read from guisettings.xml is taken for
+ * \param present the file has <tonemapmethod>, with a valid value (ValidMethod())
+ * \param method that value
+ * \param marker <hadestonemap> of the file, 0 where there is none
+ *
+ * Without the key: the default. Hable without a marker: Kodi's default before Hades had a method of
+ * its own, taken for the default once. Off with a marker below DEFAULTS_MARKER: what
+ * every profile got up to 1.0, the default once (an Off that the user chose then is lost once; the
+ * log says so). An Off or a Hable chosen after that stays.
+ */
+constexpr int MethodLoaded(bool present, int method, int marker)
+{
+  if (!present)
+    return VS_TONEMAPMETHOD_BT2390;
+  if (marker < 1 && method == VS_TONEMAPMETHOD_HABLE)
+    return VS_TONEMAPMETHOD_BT2390;
+  if (marker < DEFAULTS_MARKER && method == VS_TONEMAPMETHOD_OFF)
+    return VS_TONEMAPMETHOD_BT2390;
+  return method;
+}
+
+/*!
+ * \brief Whether the video settings kept for files are still to be looked at, once: an Off kept for
+ *        a file up to 1.0 is the default method from then on
+ * \param present the settings read have the defaults of the video settings at all. A file that
+ *        Kodi wrote always has them; settings without them are not a profile of an earlier
+ *        version: Kodi reads its sub-settings (this among them) from such settings before it makes
+ *        the file of a new profile (seen in QEMU with a profile that had no guisettings.xml: the
+ *        sub-settings say what they miss, then "unable to load settings ... creating new default
+ *        settings", CSettings::Load() -> Reset() -> Save()). Nothing is looked at for them.
+ * \param filesMarker <hadestonemapfiles> of the file, 0 where there is none; 1 once it is done
+ */
+constexpr bool FilesPending(bool present, int filesMarker)
+{
+  return present && filesMarker < 1;
+}
+} // namespace HADES_TONEMAP
