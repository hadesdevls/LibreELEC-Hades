 }
 
+void CMediaSettings::ToneMapOfFilesOnce(CVideoDatabase& db)
+{
+  // (taken first: once, also where two videos start together)
+  if (!m_toneMapFilesPending.exchange(false))
+    return;
+  const int off = static_cast<int>(VS_TONEMAPMETHOD_OFF);
+  const int count =
+      db.GetSingleValueInt(db.PrepareSQL("SELECT COUNT(1) FROM settings WHERE TonemapMethod=%i", off));
+  if (count > 0 &&
+      !db.ExecuteQuery(db.PrepareSQL("UPDATE settings SET TonemapMethod=%i WHERE TonemapMethod=%i",
+                                     static_cast<int>(VS_TONEMAPMETHOD_BT2390), off)))
+  {
+    // (tried again with the next video)
+    m_toneMapFilesPending = true;
+    CLog::Log(LOGWARNING,
+              "CMediaSettings: the video settings kept for {} files have the tone mapping method "
+              "Off, as they were kept up to LibreELEC Hades 1.0, but they could not be changed to "
+              "Reference (BT.2390) now; tried again with the next video",
+              count);
+    return;
+  }
+  CLog::Log(LOGINFO,
+            "CMediaSettings: the video settings kept for files were looked at once for the tone "
+            "mapping method Off, which every profile had up to LibreELEC Hades 1.0 without a choice "
+            "(hadestonemapfiles): {} of them had it, and have Reference (BT.2390) from now on; a "
+            "method chosen again for a file stays",
+            count);
+}
+
