From c00a742b01ca40542a40c3209cfffd76984c82b2 Mon Sep 17 00:00:00 2001
From: Hades <15710513+hadesdevls@users.noreply.github.com>
Date: Thu, 26 Nov 2026 07:25:02 +0000
Subject: [PATCH] [Hades][GBM] A half layout at 2160p at 24 to 30 Hz is told on
 nvidia-drm where the driver names the format by its CTA-861 number

In a mode that HDMI has a format number of its own for (3840x2160 at 24,
25 and 30 Hz, 4096x2160 at 24 Hz), NVKMS tells that number in its own
vendor InfoFrame and none in the AVI InfoFrame, and the vendor InfoFrame
of a half layout from Kodi goes out in the place of NVKMS's: the display
would be told a layout of no format, so such modes were left untold
(HasHdmiVic()). NVKMS now puts the CTA-861 number of the mode in the AVI
InfoFrame next to a vendor InfoFrame of side by side (half) or top and
bottom from its user, as the kernel signals a mode with a 3D layout
(drm_mode_hdmi_vic() gives none to it), where the EDID of the display
declares that layout for that format; nvidia-drm says so with the
read-only connector property NV_HDMI_3D_AVI_CTA_VIC
(nvidia-open-kernel-modules-9086, nvidia-legacy-open-9083). That is the
rule of the kernel for i915 and amdgpu, whatever the HDMI version of the
display: a format declared in 3D is listed in its video data block, and
vic_for_avi_infoframe() keeps a listed number.

- STEREO::FormatNamed(): the rule of the driver. GetStereoOffers() and
  the commit (NextInfoFrameStep(): driverTells) use it: a half layout at
  2160p at 24 to 30 Hz is offered and told where the connector has
  NV_HDMI_3D_AVI_CTA_VIC and the EDID declares the layout for that format
  (Supports()); elsewhere such modes stay untold, as before.
- kodi.log says, with what the EDID declares, whether the half layouts
  are told at 2160p at 24 to 30 Hz.
---
 xbmc/windowing/gbm/WinSystemGbm.cpp | 36 +++++++++++++++++++----------
 xbmc/windowing/gbm/drm/DRMStereo.h  | 28 +++++++++++++++++++++-
 2 files changed, 51 insertions(+), 13 deletions(-)

diff --git a/xbmc/windowing/gbm/WinSystemGbm.cpp b/xbmc/windowing/gbm/WinSystemGbm.cpp
index b6f67b2..3d4a2d5 100644
--- a/xbmc/windowing/gbm/WinSystemGbm.cpp
+++ b/xbmc/windowing/gbm/WinSystemGbm.cpp
@@ -515,11 +515,19 @@ void CWinSystemGbm::MakeResolutions(const RESOLUTION_INFO* desktop)
       declared = STEREO::DeclaredLayouts(m_stereoModes);
       edidDeclares = STEREO::EdidLayouts(m_stereoEdid);
     }
+    // (2160p at 24 to 30 Hz: STEREO::FormatNamed())
+    const bool aviCtaVic = m_DRM->GetConnector() &&
+                           m_DRM->GetConnector()->SupportsProperty(STEREO::NVIDIA_3D_AVI_CTA_VIC);
+    const std::string at2160 =
+        aviCtaVic ? "at 2160p at 24 to 30 Hz too: the driver names those modes by their CTA-861 "
+                    "number next to it"
+                  : "not at 2160p at 24 to 30 Hz, which the driver tells by a format number of "
+                    "HDMI's own";
     CLog::Log(LOGINFO, "3D output: {}",
               declared.empty()
                   ? "the driver lists no mode with a 3D layout; the half layouts are told by the "
-                    "HDMI vendor InfoFrame where the EDID declares them (not at 2160p at 24 to 30 "
-                    "Hz, which the driver tells by a format number of HDMI's own): it declares " +
+                    "HDMI vendor InfoFrame where the EDID declares them (" +
+                        at2160 + "): it declares " +
                         (edidDeclares.empty() ? std::string("none") : edidDeclares)
                   : "the driver lists the 3D layouts of the display: " + declared);
   }
@@ -957,16 +965,17 @@ bool CWinSystemGbm::GetStereoOffers(std::vector<STEREO::Offer>& offers,
       NVIDIA_DUAL_MODE::DrivenAsHdmi(connector->GetType(), dualModeTmds) &&
       connector->SupportsProperty("NV_HDMI_VSIF_METADATA"))
   {
+    // (in a mode that HDMI has a format number of its own for, 2160p at 24 to 30 Hz, only where
+    // the driver names its format by its CTA-861 number next to the layout, STEREO::FormatNamed():
+    // a 3D layout is told only with that number in the AVI InfoFrame, as the kernel does for a mode
+    // with a 3D layout, drm_mode_hdmi_vic(). The commit leaves such a mode untold elsewhere as
+    // well, NextInfoFrameStep(): driverTells.)
+    const bool aviCtaVic = connector->SupportsProperty(STEREO::NVIDIA_3D_AVI_CTA_VIC);
     for (STEREO::Offer& offer : offers)
     {
-      // (not in a mode that HDMI has a format number of its own for, 2160p at 24 to 30 Hz: the
-      // driver tells the display of it by that number in its own vendor InfoFrame, with no
-      // CTA-861 number in the AVI InfoFrame, and a 3D layout is told in its place only with the
-      // CTA-861 number in the AVI InfoFrame, as the kernel does for a mode with a 3D layout,
-      // drm_mode_hdmi_vic(): nvidia-drm takes no such number from its user. The commit leaves
-      // such a mode untold as well, NextInfoFrameStep(): driverTells.)
-      const uint8_t vic =
-          STEREO::HasHdmiVic(modes[offer.base]) ? uint8_t{0} : STEREO::VicOf(modes[offer.base]);
+      const uint8_t vic = STEREO::FormatNamed(modes[offer.base], aviCtaVic)
+                              ? STEREO::VicOf(modes[offer.base])
+                              : uint8_t{0};
       offer.infoFrameTopAndBottom =
           offer.topAndBottom < 0 && STEREO::Supports(edid, vic, STEREO::Layout::TOP_AND_BOTTOM);
       offer.infoFrameSideBySide =
@@ -1242,8 +1251,11 @@ void CWinSystemGbm::PrepareStereoInfoFrame(const RESOLUTION_INFO& res)
   // What is done about it with this commit (STEREO::NextInfoFrameStep(), which has the rules).
   // The driver sends a vendor InfoFrame of its own, which one from here would be sent in place
   // of, for a mode with a 3D layout and for one that HDMI has a format number of its own for
-  // (2160p at 24 to 30 Hz).
-  const bool driverTells = !plain || STEREO::HasHdmiVic(mode);
+  // (2160p at 24 to 30 Hz) where it does not name that format next to a layout from here
+  // (STEREO::FormatNamed()).
+  const bool driverTells =
+      !plain ||
+      !STEREO::FormatNamed(mode, connector->SupportsProperty(STEREO::NVIDIA_3D_AVI_CTA_VIC));
   STEREO::InfoFrameStep step =
       STEREO::NextInfoFrameStep(m_stereoInfoFrameLayout, m_stereoInfoFrameEnds, wanted,
                                 driverTells, m_stereoInfoFrameNoEnd);
diff --git a/xbmc/windowing/gbm/drm/DRMStereo.h b/xbmc/windowing/gbm/drm/DRMStereo.h
index 3ee3308..fa7d350 100644
--- a/xbmc/windowing/gbm/drm/DRMStereo.h
+++ b/xbmc/windowing/gbm/drm/DRMStereo.h
@@ -831,6 +831,31 @@ inline bool Supports(const Edid3D& edid, uint8_t vic, Layout layout)
                              { return format.vic == vic && (format.structures & structure); });
 }
 
+//! (Hades) the property of nvidia-drm on a connector whose driver names the format of a mode that
+//! HDMI has a number of its own for by its CTA-861 number in the AVI InfoFrame, next to a half
+//! layout of the HDMI vendor InfoFrame from its user (nvidia-open-kernel-modules-9086)
+inline constexpr const char* NVIDIA_3D_AVI_CTA_VIC = "NV_HDMI_3D_AVI_CTA_VIC";
+
+/*!
+ * \brief Whether the display is told the format of a 2D mode next to a half layout that the HDMI
+ *        vendor InfoFrame from Kodi tells (nvidia-drm, which lists no 3D modes)
+ * \param aviCtaVic the connector has NVIDIA_3D_AVI_CTA_VIC
+ *
+ * In a mode that HDMI has a format number of its own for (HasHdmiVic(): 2160p at 24 to 30 Hz) the
+ * driver tells that number in its own vendor InfoFrame, in whose place Kodi's goes, and none in
+ * the AVI InfoFrame: the display would be told a layout of no format. With NVIDIA_3D_AVI_CTA_VIC the
+ * driver puts the CTA-861 number of the mode in the AVI InfoFrame there, as the kernel signals a
+ * mode with a 3D layout (drm_mode_hdmi_vic() gives none to it), where the EDID of the display
+ * declares that layout for that number (Supports(), asked as well): the same rule as the driver's,
+ * nvHadesStereoAviCtaVic(), and as the kernel's for i915 and amdgpu, whatever the HDMI version of
+ * the display (a format declared in 3D is listed in its video data block, and
+ * vic_for_avi_infoframe() keeps a listed number).
+ */
+inline bool FormatNamed(const Mode& mode, bool aviCtaVic)
+{
+  return !HasHdmiVic(mode) || aviCtaVic;
+}
+
 /*!
  * \brief Whether a display says that it takes stereoscopic 3D
  * \param modes the modes of its connector: a driver that has 3D lists those of the display that
@@ -983,7 +1008,8 @@ enum class InfoFrameStep
  * \param wanted the half layout that the display is to be told of with this mode; none: none
  * \param driverTells the driver sends a vendor InfoFrame of its own for this mode, which one
  *        from here would be sent in place of: a mode with a 3D layout, or one that HDMI has a
- *        format number of its own for (HasHdmiVic())
+ *        format number of its own for (HasHdmiVic()) where the driver does not name its format
+ *        next to a layout from here (FormatNamed())
  * \param noLayoutRefused the driver did not take the InfoFrame that says "no 3D" before
  *
  * - A layout is told from here only in a mode for which the driver tells nothing itself.
-- 
2.53.0

