+// ---- Hades: the video at its own rate with VRR (VrrVideo.h) ----
+
+bool CWinSystemGbm::TakeVideoAtOwnRate(float fps,
+                                       bool is3D,
+                                       bool nativeDV,
+                                       bool progressive,
+                                       KODI::WINDOWING::WholeMultipleVideo video,
+                                       RESOLUTION& gui)
+{
+  using namespace VRR_VIDEO;
+  const auto component = CServiceBroker::GetSettingsComponent();
+  const auto settings = component ? component->GetSettings() : nullptr;
+  Query q;
+  q.setting = settings && settings->GetSetting(CSettings::SETTING_VIDEOSCREEN_HADESVRRVIDEO) &&
+              settings->GetBool(CSettings::SETTING_VIDEOSCREEN_HADESVRRVIDEO);
+  if (!q.setting)
+  {
+    std::unique_lock lock(m_vrrLock);
+    m_vrrWanted = {};
+    return false;
+  }
+  q.fps = fps;
+  q.progressive = progressive;
+  q.is3D = is3D;
+  q.nativeDV = nativeDV;
+  q.video = video;
+  auto drm = std::dynamic_pointer_cast<CDRMAtomic>(m_DRM);
+  CDRMConnector* connector = drm ? drm->GetConnector() : nullptr;
+  CDRMCrtc* crtc = drm ? drm->GetCrtc() : nullptr;
+  if (connector && crtc)
+  {
+    q.vrrCapable = connector->GetPropertyValue("vrr_capable") == 1u;
+    q.crtcVrrEnabled = crtc->SupportsProperty("VRR_ENABLED");
+    q.flipTime = crtc->SupportsProperty(FLIP_TIME);
+    q.nvidia = q.flipTime || connector->SupportsProperty(CHdmiVrrOff::PROPERTY);
+    q.media = crtc->SupportsProperty(MEDIA_TARGET) && crtc->GetPropertyValue(MEDIA) == 1u;
+  }
+  q.hdmiVrrAllowed = HdmiVrrAllowedBySetting();
+  if (const auto info = DisplayInfo())
+  {
+    // (amdgpu takes the VRR of an HDMI display from AMD's FreeSync block alone, NVKMS from the HDMI
+    // Forum block)
+    if (!q.nvidia && info->FreeSyncMin() > 0)
+    {
+      q.vrrMin = info->FreeSyncMin();
+      q.vrrMax = info->FreeSyncMax();
+    }
+    else
+    {
+      q.vrrMin = info->HdmiVrrMin();
+      q.vrrMax = info->HdmiVrrMax();
+    }
+  }
+  RESOLUTION menus = RES_DESKTOP;
+  if (CDisplaySettings::GetInstance().GetCurrentResolution() > RES_DESKTOP)
+    menus = CDisplaySettings::GetInstance().GetCurrentResolution();
+  const RESOLUTION_INFO menusInfo = GetGfxContext().GetResInfo(menus);
+  q.guiRefresh = menusInfo.fRefreshRate;
+  q.guiLines = menusInfo.iScreenHeight;
+  q.guiInterlaced = (menusInfo.dwFlags & D3DPRESENTFLAG_INTERLACED) != 0;
+  q.gui3D = (menusInfo.dwFlags & (D3DPRESENTFLAG_MODE3DSBS | D3DPRESENTFLAG_MODE3DTB)) != 0;
+
+  const Verdict v = Decide(q);
+  const std::string key = StringUtils::Format(
+      "{:.3f}|{}|{}|{:.3f}|{}", fps, v.use, v.why ? v.why : "", v.rate, static_cast<int>(v.pacing));
+  bool tell = false;
+  {
+    std::unique_lock lock(m_vrrLock);
+    m_vrrWanted = {};
+    if (v.use)
+      m_vrrWanted = {true, v.rate, fps, v.multiple, v.pacing, v.mediaTarget};
+    tell = key != m_vrrToldKey;
+    m_vrrToldKey = key;
+  }
+  if (tell && v.use)
+    CLog::Log(
+        LOGINFO,
+        "VRR video: {:.3f} fps goes at its own rate with VRR in the mode of the menus ({}): "
+        "each picture {} time(s), at {:.3f} Hz, in the display's VRR range of {} to {} Hz; {}",
+        fps, menusInfo.strMode, v.multiple, v.rate, q.vrrMin, q.vrrMax, PacingName(v.pacing));
+  else if (tell)
+    CLog::Log(LOGINFO, "VRR video: {:.3f} fps changes the mode as before: {}", fps,
+              v.why ? v.why : "not chosen");
+  if (v.use)
+    gui = menus;
+  return v.use;
+}
+
+void CWinSystemGbm::EndVideoAtOwnRate()
+{
+  std::unique_lock lock(m_vrrLock);
+  m_vrrWanted = {};
+  m_vrrToldKey.clear();
+}
+
+bool CWinSystemGbm::VrrClockSlots(int64_t& first, double& period) const
+{
+  period = m_vrrSlotPeriod.load();
+  first = m_vrrSlotFirst.load();
+  return period > 0.0;
+}
+
+namespace
+{
+int64_t ClockNs(clockid_t clock)
+{
+  struct timespec ts;
+  clock_gettime(clock, &ts);
+  return static_cast<int64_t>(ts.tv_sec) * 1000000000LL + ts.tv_nsec;
+}
+} // namespace
+
+void CWinSystemGbm::StageVrrMediaMode()
+{
+  auto drm = std::dynamic_pointer_cast<CDRMAtomic>(m_DRM);
+  CDRMCrtc* crtc = drm ? drm->GetCrtc() : nullptr;
+  if (!crtc || !drm->ModesetPending() || !crtc->SupportsProperty(VRR_VIDEO::MEDIA))
+    return;
+  const auto component = CServiceBroker::GetSettingsComponent();
+  const auto settings = component ? component->GetSettings() : nullptr;
+  const uint64_t want =
+      settings && settings->GetSetting(CSettings::SETTING_VIDEOSCREEN_HADESVRRVIDEO) &&
+              settings->GetBool(CSettings::SETTING_VIDEOSCREEN_HADESVRRVIDEO)
+          ? 1
+          : 0;
+  if (crtc->GetPropertyValue(VRR_VIDEO::MEDIA) == want)
+    return;
+  if (drm->AddProperty(crtc, VRR_VIDEO::MEDIA, want))
+    CLog::Log(LOGINFO, "VRR video: Media VRR is {} for the mode set of the menus ({} {})",
+              want ? "asked for" : "no longer asked for", VRR_VIDEO::MEDIA, want);
+}
+
+void CWinSystemGbm::StartVrrVideo(const VrrWanted& wanted)
+{
+  using namespace VRR_VIDEO;
+  auto drm = std::dynamic_pointer_cast<CDRMAtomic>(m_DRM);
+  CDRMCrtc* crtc = drm ? drm->GetCrtc() : nullptr;
+  if (!crtc)
+    return;
+  drm->AddProperty(crtc, "VRR_ENABLED", 1);
+  if (wanted.pacing == Pacing::MEDIA)
+    drm->AddProperty(crtc, MEDIA_TARGET, wanted.mediaTarget);
+  m_vrrNow = wanted;
+  m_vrrPacing = wanted.pacing;
+  const double period = 1e9 / wanted.rate;
+  m_vrrSchedule.Start(ClockNs(CLOCK_MONOTONIC) + static_cast<int64_t>(period), period);
+  m_vrrRecent.Reset();
+  m_vrrAll.Reset();
+  m_vrrOffsetRecent.Reset();
+  m_vrrOffsetAll.Reset();
+  m_vrrFlips = 0;
+  m_vrrLate = 0;
+  m_vrrLastAsked = 0;
+  m_vrrLastNs = 0;
+  m_vrrLastSeq = 0;
+  m_vrrLastLog = std::chrono::steady_clock::now();
+  m_vrrActive = true;
+  m_vrrRefresh = static_cast<float>(wanted.rate);
+  if (m_vrrPacing != Pacing::MEDIA)
+  {
+    m_vrrSlotFirst = m_vrrSchedule.First();
+    m_vrrSlotPeriod = period;
+  }
+  CLog::Log(LOGINFO,
+            "VRR video: on: {:.3f} fps at {:.3f} Hz, each picture {} time(s), {} (VRR_ENABLED 1{})",
+            wanted.fps, wanted.rate, wanted.multiple, PacingName(m_vrrPacing),
+            m_vrrPacing == Pacing::MEDIA
+                ? StringUtils::Format(", {} {}", MEDIA_TARGET, wanted.mediaTarget)
+                : std::string());
+}
+
+void CWinSystemGbm::StopVrrVideo(const char* why)
+{
+  using namespace VRR_VIDEO;
+  auto drm = std::dynamic_pointer_cast<CDRMAtomic>(m_DRM);
+  CDRMCrtc* crtc = drm ? drm->GetCrtc() : nullptr;
+  if (crtc)
+  {
+    drm->AddProperty(crtc, "VRR_ENABLED", 0);
+    if (crtc->SupportsProperty(MEDIA_TARGET))
+      drm->AddProperty(crtc, MEDIA_TARGET, 0);
+  }
+  m_vrrActive = false;
+  m_vrrSlotPeriod = 0.0;
+  m_vrrSlotFirst = 0;
+  m_vrrRefresh = 0.0f;
+  m_vrrSchedule.Stop();
+  CLog::Log(LOGINFO, "VRR video: off ({}) after {} flips, {} of them late for their time{}", why,
+            m_vrrFlips, m_vrrLate, crtc ? "; VRR_ENABLED 0" : "");
+  LogVrrIntervals(m_vrrAll, m_vrrOffsetAll, "the whole video");
+}
+
+void CWinSystemGbm::LogVrrIntervals(const VRR_VIDEO::CIntervals& intervals,
+                                    const VRR_VIDEO::CIntervals& offsets,
+                                    const char* what) const
+{
+  using namespace VRR_VIDEO;
+  if (intervals.Count())
+  {
+    const double p1 = intervals.QuantileUs(0.01);
+    const double p50 = intervals.QuantileUs(0.5);
+    const double p99 = intervals.QuantileUs(0.99);
+    const bool exact = std::max(std::fabs(p1), std::fabs(p99)) <= EXACT_P99_US;
+    CLog::Log(
+        LOGINFO,
+        "VRR video: {}: {} intervals between pictures against those asked for: error p1 {:.0f} "
+        "us, median {:.0f} us, p99 {:.0f} us, from {:.0f} to {:.0f} us, {} over 1 ms; {} "
+        "refreshes the display made by itself; {} ({})",
+        what, intervals.Count(), p1, p50, p99, intervals.MinUs(), intervals.MaxUs(),
+        intervals.Over1ms(), intervals.ExtraRefreshes(),
+        exact ? "exact: 98 % within 1 ms" : "NOT exact: more than 1 % off by over 1 ms",
+        PacingName(m_vrrPacing));
+  }
+  if (offsets.Count())
+  {
+    const double p1 = offsets.QuantileUs(0.01);
+    const double p99 = offsets.QuantileUs(0.99);
+    CLog::Log(
+        LOGINFO,
+        "VRR video: {}: the vblank of each of {} flips against the time asked for it: p1 {:.0f} "
+        "us, median {:.0f} us, p99 {:.0f} us, from {:.0f} to {:.0f} us; spread p1 to p99 "
+        "{:.0f} us (the median also holds the display's own delay from a flip to its vblank "
+        "time)",
+        what, offsets.Count(), p1, offsets.QuantileUs(0.5), p99, offsets.MinUs(), offsets.MaxUs(),
+        p99 - p1);
+  }
+}
+
+std::optional<int64_t> CWinSystemGbm::PaceVrrVideo(bool videoLayer)
+{
+  using namespace VRR_VIDEO;
+  auto drm = std::dynamic_pointer_cast<CDRMAtomic>(m_DRM);
+  CDRMCrtc* crtc = drm ? drm->GetCrtc() : nullptr;
+  VrrWanted wanted;
+  {
+    std::unique_lock lock(m_vrrLock);
+    wanted = m_vrrWanted;
+  }
+  const bool want = wanted.use && videoLayer && crtc && GetGfxContext().IsFullScreenVideo() &&
+                    !NativeDVOutputInUse();
+  // (a commit with a change of mode is never paced: the mode set goes out as before, with VRR off)
+  const bool modeset = !drm || drm->ModesetPending() || m_dispReset;
+  if (!want || modeset)
+  {
+    if (m_vrrActive)
+      StopVrrVideo(!want ? "the video ended, left the full screen or is no longer chosen"
+                         : "a change of mode");
+    return std::nullopt;
+  }
+  if (!m_vrrActive || m_vrrNow.rate != wanted.rate || m_vrrNow.pacing != wanted.pacing)
+  {
+    if (m_vrrActive)
+      StopVrrVideo("another rate");
+    StartVrrVideo(wanted);
+  }
+  if (m_vrrPacing == Pacing::MEDIA)
+    return 0;
+
+  // the time of this flip: the next slot, or the first one that is still ahead by half a millisecond
+  const int64_t now = ClockNs(CLOCK_MONOTONIC);
+  uint64_t skipped = 0;
+  const int64_t slot = m_vrrSchedule.Time(m_vrrSchedule.Take(now, 500000, skipped));
+  m_vrrLate += skipped;
+  if (m_vrrPacing == Pacing::FLIP_TIME)
+  {
+    // in the clock of RM's GPU-CPU time correlation (CLOCK_MONOTONIC_RAW), read beside the other
+    const int64_t mono = ClockNs(CLOCK_MONOTONIC);
+    const int64_t raw = ClockNs(CLOCK_MONOTONIC_RAW);
+    drm->AddProperty(crtc, FLIP_TIME, static_cast<uint64_t>(slot - (mono - raw)));
+  }
+  else
+  {
+    struct timespec ts;
+    ts.tv_sec = slot / 1000000000LL;
+    ts.tv_nsec = slot % 1000000000LL;
+    while (clock_nanosleep(CLOCK_MONOTONIC, TIMER_ABSTIME, &ts, nullptr) == EINTR)
+    {
+    }
+  }
+  return slot;
+}
+
+void CWinSystemGbm::VrrVideoFlipped(std::optional<int64_t> asked)
+{
+  using namespace VRR_VIDEO;
+  if (!asked || !m_vrrActive)
+    return;
+  auto drm = std::dynamic_pointer_cast<CDRMAtomic>(m_DRM);
+  CDRMCrtc* crtc = drm ? drm->GetCrtc() : nullptr;
+  uint64_t sequence = 0;
+  uint64_t ns = 0;
+  if (!crtc ||
+      drmCrtcGetSequence(drm->GetFileDescriptor(), crtc->GetCrtcId(), &sequence, &ns) != 0 || !ns ||
+      !m_DRM->LastBufferTaken())
+  {
+    m_vrrLastAsked = 0;
+    return;
+  }
+  ++m_vrrFlips;
+  const double period = 1e9 / m_vrrNow.rate;
+  if (m_vrrLastNs && sequence > m_vrrLastSeq)
+  {
+    const int64_t interval = static_cast<int64_t>(ns) - m_vrrLastNs;
+    int64_t error = 0;
+    uint64_t extra = 0;
+    if (m_vrrPacing == Pacing::MEDIA)
+    {
+      // the display engine keeps the rate: each refresh a period long
+      const uint64_t refreshes = sequence - m_vrrLastSeq;
+      error = interval - static_cast<int64_t>(std::llround(refreshes * period));
+    }
+    else if (m_vrrLastAsked)
+    {
+      error = interval - (*asked - m_vrrLastAsked);
+      extra = sequence - m_vrrLastSeq - 1;
+    }
+    m_vrrRecent.Add(error, extra);
+    m_vrrAll.Add(error, extra);
+  }
+  // the vblank of this flip against the time asked for it: the presentation error itself (its
+  // median also holds the display's own delay from a flip to its vblank time)
+  if (m_vrrPacing != Pacing::MEDIA && *asked && (!m_vrrLastNs || sequence > m_vrrLastSeq))
+  {
+    m_vrrOffsetRecent.Add(static_cast<int64_t>(ns) - *asked, 0);
+    m_vrrOffsetAll.Add(static_cast<int64_t>(ns) - *asked, 0);
+  }
+  m_vrrLastNs = static_cast<int64_t>(ns);
+  m_vrrLastSeq = sequence;
+  m_vrrLastAsked = *asked;
+
+  // a driver that does not hold the flips until their time: Kodi waits for it from now on
+  if (m_vrrPacing == Pacing::FLIP_TIME && m_vrrAll.Count() == FLIP_TIME_TRUST_AFTER &&
+      m_vrrAll.QuantileUs(0.5) < FLIP_TIME_UNTRUSTED_US)
+  {
+    CLog::Log(LOGWARNING,
+              "VRR video: the driver did not hold the flips until their time (median interval "
+              "{:.0f} us shorter than asked): Kodi waits for each time itself from now on",
+              -m_vrrAll.QuantileUs(0.5));
+    m_vrrPacing = Pacing::TIMER;
+    m_vrrAll.Reset();
+    m_vrrRecent.Reset();
+    m_vrrOffsetAll.Reset();
+    m_vrrOffsetRecent.Reset();
+  }
+  const auto now = std::chrono::steady_clock::now();
+  if (now - m_vrrLastLog >= std::chrono::seconds(30))
+  {
+    m_vrrLastLog = now;
+    LogVrrIntervals(m_vrrRecent, m_vrrOffsetRecent, "the last 30 seconds");
+    m_vrrRecent.Reset();
+    m_vrrOffsetRecent.Reset();
+  }
+}
