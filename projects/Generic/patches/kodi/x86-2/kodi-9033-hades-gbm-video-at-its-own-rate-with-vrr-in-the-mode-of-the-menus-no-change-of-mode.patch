+        if (tag == 3 && length >= 7 && b[i + 1] == 0x1a && b[i + 2] == 0x00 && b[i + 3] == 0x00 &&
+            (b[i + 5] & 0x01) && b[i + 6] > 0 && b[i + 7] > b[i + 6])
+        {
+          min = b[i + 6];
+          max = b[i + 7];
+          return;
+        }
+        i += 1 + length;
+      }
+    }
+  }
