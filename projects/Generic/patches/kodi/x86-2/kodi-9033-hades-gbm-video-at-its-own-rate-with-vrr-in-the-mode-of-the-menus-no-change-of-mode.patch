+void CVideoSyncGbm::RunVrrSlots(CEvent& stopEvent, int64_t first, double period)
+{
+  auto* gbm = dynamic_cast<KODI::WINDOWING::GBM::CWinSystemGbm*>(m_winSystem);
+  CLog::Log(LOGINFO, "CVideoSyncGbm::{}: the clock follows the times of the flips ({:.3f} Hz)",
+            __FUNCTION__, 1e9 / period);
+  const auto now = []
+  {
+    struct timespec ts;
+    clock_gettime(CLOCK_MONOTONIC, &ts);
+    return static_cast<int64_t>(ts.tv_sec) * 1000000000LL + ts.tv_nsec;
+  };
+  const int64_t start = now();
+  uint64_t n = start > first ? static_cast<uint64_t>((start - first) / period) + 1 : 0;
+  while (!stopEvent.Signaled() && !m_abort)
+  {
+    int64_t f = 0;
+    double p = 0.0;
+    if (!gbm || !gbm->VrrClockSlots(f, p) || f != first || p != period)
+      break;
+    const int64_t slot =
+        first + static_cast<int64_t>(std::llround(static_cast<double>(n) * period));
+    // (in steps of at most 50 ms, so that a stop is seen)
+    const int64_t wait = slot - now();
+    if (wait > 50000000)
+    {
+      stopEvent.Wait(std::chrono::milliseconds(50));
+      continue;
+    }
+    if (wait > 0)
+    {
+      struct timespec ts;
+      ts.tv_sec = slot / 1000000000LL;
+      ts.tv_nsec = slot % 1000000000LL;
+      while (clock_nanosleep(CLOCK_MONOTONIC, TIMER_ABSTIME, &ts, nullptr) == EINTR)
+      {
+      }
+    }
+    m_refClock->UpdateClock(1, MonotonicToHostCounter(static_cast<uint64_t>(slot)));
+    ++n;
+  }
+}
