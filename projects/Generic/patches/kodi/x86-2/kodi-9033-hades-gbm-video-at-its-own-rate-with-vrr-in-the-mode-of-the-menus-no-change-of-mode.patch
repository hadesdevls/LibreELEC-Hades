+
+namespace KODI::WINDOWING::GBM::VRR_VIDEO
+{
+
+/*!
+ * \brief Hades: a video at its own rate with the display's variable refresh rate, in the mode of the
+ *        menus (System > Display, "Video at its own rate with VRR (no change of mode)":
+ *        videoscreen.hadesvrrvideo, off by default)
+ *
+ * Kodi changes the mode of the display to the frame rate of a video ("Adjust display refresh rate"),
+ * and the display goes black for that change, when the video starts and when it stops. A display
+ * with VRR starts a refresh when a picture arrives, within its VRR range: the mode of the menus can
+ * stay, and each picture of the video be shown at its own time. Below the display's VRR minimum each
+ * picture goes twice or more (a whole multiple k of the frame rate, so that no refresh waits longer
+ * than the display allows): 23.976 fps goes at 47.952 Hz to a display whose VRR starts at 40 Hz.
+ *
+ * Kodi then presents at that rate (CWinSystemGbm: the window system, Kodi's clock and the frame
+ * rate that the render manager sees are the rate's, as with a mode at that rate), and the time of
+ * each picture is kept one of three ways (Pacing):
+ *  - MEDIA: Media VRR of NVIDIA's Blackwell (NV_VRR_MEDIA, NV_VRR_MEDIA_TARGET of nvidia-drm,
+ *    nvidia-open-kernel-modules-9076): the display engine keeps the rate, fractional, by itself;
+ *  - FLIP_TIME: every flip carries its time (NV_FLIP_TIME_RAW_NS, same patch), and the display engine
+ *    holds it until then (NVIDIA from Turing on);
+ *  - TIMER: Kodi waits until the time of each flip and then commits it (amdgpu, and NVIDIA without
+ *    the patch).
+ * Each way is measured while it runs: the intervals between the refreshes against those asked for
+ * (CIntervals), in kodi.log every 30 seconds and at the end. A FLIP_TIME that the driver does not
+ * hold to goes on as TIMER, and the log says so.
+ *
+ * Never for Dolby Vision (native output, or a video that says it is Dolby Vision), HDR10+, HLG, 3D,
+ * a video not known to be progressive, or a video whose kind is not known: those change the mode as
+ * before, and so does anything this cannot do exactly (Decide()). Nothing of Kodi is here: a test
+ * runs it on the host.
+ */
+
+constexpr const char* SETTING = "videoscreen.hadesvrrvideo";
+//! nvidia-drm: the time of a flip, in ns of CLOCK_MONOTONIC_RAW (nvidia-open-kernel-modules-9076)
+constexpr const char* FLIP_TIME = "NV_FLIP_TIME_RAW_NS";
+//! nvidia-drm: Media VRR for the mode set of the head, where the GPU has it (same patch)
+constexpr const char* MEDIA = "NV_VRR_MEDIA";
+//! nvidia-drm: the rate of Media VRR that the flips ask for (Hz << 1, bit 0 for 1.001)
+constexpr const char* MEDIA_TARGET = "NV_VRR_MEDIA_TARGET";
+//! The rate is at least this much above the display's VRR minimum, so that no refresh comes as late
+//! as the display's longest frame, where the driver would repeat the picture by itself
+constexpr double MIN_MARGIN = 1.05;
+//! The refresh rate of a mode that NVKMS gives VRR: 50 Hz and 720 lines (nvGetAllowedDpyVrrType()),
+//! and 110 % of the display's VRR minimum (nvAdjustHwModeTimingsForVrrEvo())
+constexpr double NVIDIA_VRR_MIN_REFRESH = 49.995;
+constexpr int NVIDIA_VRR_MIN_LINES = 720;
+constexpr double NVIDIA_VRR_MIN_FACTOR = 1.1;
+
+//! How the time of each picture is kept
+enum class Pacing
+{
+  NONE,
+  MEDIA, //!< Media VRR: the display engine keeps the rate
+  FLIP_TIME, //!< the display engine holds each flip until its time
+  TIMER, //!< Kodi waits until the time of each flip
+};
+
+constexpr const char* PacingName(Pacing pacing)
+{
+  switch (pacing)
+  {
+    case Pacing::MEDIA:
+      return "Media VRR: the display engine keeps the rate";
+    case Pacing::FLIP_TIME:
+      return "each flip held by the display engine until its time";
+    case Pacing::TIMER:
+      return "each flip committed at its time by Kodi";
+    case Pacing::NONE:
+      break;
+  }
+  return "none";
+}
+
+//! The target of Media VRR for a rate: the rate in Hz shifted left by one, with bit 0 for the
+//! divider of 1.001; 0 where the rate is neither a whole number of Hz nor one divided by 1.001
+inline unsigned int MediaTarget(double rate)
+{
+  if (!(rate > 0.0) || !std::isfinite(rate))
+    return 0;
+  for (unsigned int divider = 0; divider < 2; ++divider)
+  {
+    const double hz = divider ? rate * 1.001 : rate;
+    const double whole = std::round(hz);
+    if (whole >= 1.0 && whole <= 1023.0 && std::fabs(hz - whole) < 1e-3)
+      return static_cast<unsigned int>(whole) << 1 | divider;
+  }
+  return 0;
+}
+
+//! What Decide() is told
+struct Query
+{
+  bool setting = false; //!< videoscreen.hadesvrrvideo
+  float fps = 0.0f; //!< the frame rate that Kodi chooses the mode for
+  bool progressive = false; //!< CDVDStreamInfo::progressive, as the render manager keeps it
+  bool is3D = false;
+  bool nativeDV = false; //!< the video goes out as native Dolby Vision
+  WholeMultipleVideo video = WholeMultipleVideo::UNKNOWN;
+  bool vrrCapable = false; //!< the connector's vrr_capable is 1
+  bool crtcVrrEnabled = false; //!< the CRTC has VRR_ENABLED
+  bool nvidia = false; //!< nvidia-drm: the mode of the menus has VRR only by NVKMS's rule
+  bool hdmiVrrAllowed = true; //!< videoscreen.hadeshdmivrr (NVIDIA: VRR in the mode sets)
+  bool flipTime = false; //!< the CRTC has NV_FLIP_TIME_RAW_NS
+  bool media = false; //!< the CRTC has NV_VRR_MEDIA_TARGET, and NV_VRR_MEDIA is 1 in its mode
+  int vrrMin = 0; //!< the display's VRR range, in Hz (0: not known)
+  int vrrMax = 0;
+  float guiRefresh = 0.0f; //!< the mode of the menus, which stays
+  int guiLines = 0;
+  bool guiInterlaced = false;
+  bool gui3D = false;
+};
+
+//! What Decide() said
+struct Verdict
+{
+  bool use = false; //!< the video goes at its own rate, in the mode of the menus
+  int multiple = 0; //!< k: each picture is shown k times
+  double rate = 0.0; //!< k times the frame rate
+  Pacing pacing = Pacing::NONE;
+  unsigned int mediaTarget = 0; //!< Pacing::MEDIA: MediaTarget(rate)
+  //! why not (for the log); nullptr with the setting off: then nothing is said
+  const char* why = nullptr;
+};
+
+/*!
+ * \brief Whether a video goes at its own rate with VRR in the mode of the menus, at which rate and
+ *        how its time is kept. With the setting off the answer is "no, and nothing to say": the
+ *        caller goes on with Kodi's choice exactly as before.
+ */
+inline Verdict Decide(const Query& q)
+{
+  Verdict v;
+  if (!q.setting)
+    return v;
+  if (q.nativeDV || q.video == WholeMultipleVideo::DOLBY_VISION)
+    v.why = "the video is Dolby Vision, which keeps the change of mode it always had";
+  else if (q.video == WholeMultipleVideo::HDR10PLUS)
+    v.why = "the video is HDR10+: only SDR and HDR10 go at their own rate";
+  else if (q.video == WholeMultipleVideo::HLG)
+    v.why = "the video is HLG: only SDR and HDR10 go at their own rate";
+  else if (!WholeMultipleVideoTakes(q.video))
+    v.why = "what the video is was not told";
+  else if (q.is3D)
+    v.why = "the video is 3D";
+  else if (!q.progressive)
+    v.why = "the video is not known to be progressive";
+  else if (!(q.fps > 0.0f) || !std::isfinite(q.fps))
+    v.why = "the video has no frame rate";
+  else if (!q.vrrCapable)
+    v.why =
+        "the output offers no variable refresh rate (vrr_capable is not 1: the display declares "
+        "none that the driver takes, or its VRR or FreeSync setting is off)";
+  else if (!q.crtcVrrEnabled)
+    v.why = "the driver has no VRR_ENABLED on the CRTC";
+  else if (q.vrrMin <= 0 || q.vrrMax < q.vrrMin)
+    v.why = "the VRR range of the display is not known";
+  else if (!(q.guiRefresh > 0.0f) || q.guiInterlaced || q.gui3D)
+    v.why = "the mode of the menus is interlaced or 3D, or has no refresh rate";
+  else if (q.nvidia && !q.hdmiVrrAllowed)
+    v.why = "\"HDMI variable refresh rate (VRR)\" is off in System > Display";
+  else if (q.nvidia && (q.guiLines < NVIDIA_VRR_MIN_LINES ||
+                        static_cast<double>(q.guiRefresh) < NVIDIA_VRR_MIN_REFRESH ||
+                        static_cast<double>(q.guiRefresh) < NVIDIA_VRR_MIN_FACTOR * q.vrrMin))
+    v.why =
+        "the mode of the menus has no VRR on NVIDIA (it needs 50 Hz, 720 lines and 110 % of the "
+        "display's VRR minimum)";
+  if (v.why)
+    return v;
+
+  const double fps = static_cast<double>(q.fps);
+  const int k = std::max(1, static_cast<int>(std::ceil(q.vrrMin * MIN_MARGIN / fps - 1e-9)));
+  const double rate = k * fps;
+  const double top = std::min(static_cast<double>(q.vrrMax), static_cast<double>(q.guiRefresh));
+  if (rate > top + 0.01)
+  {
+    v.why = "no whole multiple of the frame rate is in the display's VRR range and at or under the "
+            "refresh rate of the menus";
+    return v;
+  }
+  v.use = true;
+  v.multiple = k;
+  v.rate = rate;
+  v.mediaTarget = q.media ? MediaTarget(rate) : 0;
+  v.pacing = v.mediaTarget ? Pacing::MEDIA : q.flipTime ? Pacing::FLIP_TIME : Pacing::TIMER;
+  return v;
+}
+
+/*!
+ * \brief The times of the flips: slot n at first + n periods, in ns of one clock, with no error that
+ *        grows with n
+ */
+class CSchedule
+{
+public:
+  void Start(int64_t firstNs, double periodNs)
+  {
+    m_first = firstNs;
+    m_period = periodNs;
+    m_next = 0;
+  }
+  void Stop() { m_period = 0.0; }
+  bool Started() const { return m_period > 0.0; }
+  double Period() const { return m_period; }
+  int64_t First() const { return m_first; }
+  int64_t Time(uint64_t n) const
+  {
+    return m_first + static_cast<int64_t>(std::llround(static_cast<double>(n) * m_period));
+  }
+  /*!
+   * \brief The slot of the next flip: the one after the last, or, where that one is already closer
+   *        to now than margin, the first one that is not (the slots in between are missed, counted
+   *        in skipped)
+   */
+  uint64_t Take(int64_t nowNs, int64_t marginNs, uint64_t& skipped)
+  {
+    skipped = 0;
+    uint64_t n = m_next;
+    if (m_period > 0.0 && Time(n) < nowNs + marginNs)
+    {
+      const double behind = static_cast<double>(nowNs + marginNs - m_first) / m_period;
+      uint64_t m = behind > 0.0 ? static_cast<uint64_t>(std::ceil(behind)) : 0;
+      while (Time(m) < nowNs + marginNs)
+        ++m;
+      if (m > n)
+      {
+        skipped = m - n;
+        n = m;
+      }
+    }
+    m_next = n + 1;
+    return n;
+  }
+
+private:
+  int64_t m_first = 0;
+  double m_period = 0.0;
+  uint64_t m_next = 0;
+};
+
+/*!
+ * \brief How exact the presentation is: each interval between two refreshes that showed a flip,
+ *        against the interval between the times asked for, in steps of 10 us from -20 to +30 ms
+ *        (what falls outside is counted at the edge). The constant delay from a time to its refresh
+ *        is the same for every flip and leaves no trace here; a picture shown early or late does.
+ */
+class CIntervals
+{
+public:
+  static constexpr int64_t STEP_NS = 10000;
+  static constexpr int64_t LOW_NS = -20000000;
+  static constexpr size_t BINS = 5000;
+
+  void Add(int64_t errorNs, uint64_t extraRefreshes)
+  {
+    int64_t bin = (errorNs - LOW_NS) / STEP_NS;
+    bin = std::clamp<int64_t>(bin, 0, static_cast<int64_t>(BINS) - 1);
+    ++m_bins[static_cast<size_t>(bin)];
+    ++m_count;
+    m_sum += static_cast<double>(errorNs);
+    m_min = m_count == 1 ? errorNs : std::min(m_min, errorNs);
+    m_max = m_count == 1 ? errorNs : std::max(m_max, errorNs);
+    if (std::llabs(errorNs) > 1000000)
+      ++m_over1ms;
+    m_extra += extraRefreshes;
+  }
+  void Reset() { *this = CIntervals(); }
+  uint64_t Count() const { return m_count; }
+  uint64_t Over1ms() const { return m_over1ms; }
+  uint64_t ExtraRefreshes() const { return m_extra; }
+  double MeanUs() const { return m_count ? m_sum / m_count / 1000.0 : 0.0; }
+  double MinUs() const { return m_min / 1000.0; }
+  double MaxUs() const { return m_max / 1000.0; }
+  //! the error at quantile p (0 to 1), in us, at the middle of its step
+  double QuantileUs(double p) const
+  {
+    if (!m_count)
+      return 0.0;
+    const uint64_t rank =
+        std::max<uint64_t>(1, static_cast<uint64_t>(std::ceil(p * static_cast<double>(m_count))));
+    uint64_t seen = 0;
+    for (size_t i = 0; i < BINS; ++i)
+    {
+      seen += m_bins[i];
+      if (seen >= rank)
+        return (LOW_NS + static_cast<int64_t>(i) * STEP_NS + STEP_NS / 2) / 1000.0;
+    }
+    return (LOW_NS + static_cast<int64_t>(BINS) * STEP_NS) / 1000.0;
+  }
+
+private:
+  std::array<uint32_t, BINS> m_bins{};
+  uint64_t m_count = 0;
+  double m_sum = 0.0;
+  int64_t m_min = 0;
+  int64_t m_max = 0;
+  uint64_t m_over1ms = 0;
+  uint64_t m_extra = 0;
+};
+
+//! A presentation is taken as exact where 99 % of its intervals are within this of the ones asked
+//! for: an eighth of the time that the display takes to draw one refresh from top to bottom at 120
+//! Hz (2160 of 2250 lines of 8.33 ms: 8.0 ms), over which every picture already reaches the screen
+constexpr double EXACT_P99_US = 1000.0;
+
+//! FLIP_TIME: after this many intervals, a median this much shorter than asked means that the
+//! driver does not hold the flips (they go out as soon as they come): TIMER from then on
+constexpr uint64_t FLIP_TIME_TRUST_AFTER = 48;
+constexpr double FLIP_TIME_UNTRUSTED_US = -2000.0;
+
+} // namespace KODI::WINDOWING::GBM::VRR_VIDEO
