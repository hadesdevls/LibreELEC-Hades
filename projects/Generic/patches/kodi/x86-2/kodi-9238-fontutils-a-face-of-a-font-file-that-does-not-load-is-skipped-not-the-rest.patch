From d14e24cd070532f7aa5ffb496852489205231175 Mon Sep 17 00:00:00 2001
From: Hades <15710513+hadesdevls@users.noreply.github.com>
Date: Tue, 24 Nov 2026 21:03:56 +0000
Subject: [PATCH] FontUtils: a face of a font file that does not load is
 skipped, not the rest

GetFontFamilyNames() reads the family name of each face of a font file
(a TrueType collection has several). The first face that did not load
ended the reading: the faces after it were lost, and a file whose first
face did not load came back "found" with no name, which the cache of
user fonts kept. A face without a family name returned false, losing
the names of the faces before it.

A face that does not load, or that has no family name, is now skipped
and said in the log, and the reading goes on with the next face; the
function says it found something only when it has a name. The number of
faces is read first: from FreeType (a face index of -1), or, where it
cannot open the first face of a collection, from the header of the
TrueType collection.

From Portisch's pull request to Kodi, xbmc/xbmc#30317 ("FontUtils: skip
font faces that fail to load", open at the time; CoreELEC/xbmc commit
cef61e3a6e). There a first face that did not load still ended the
reading, as the number of faces came from the face loaded; here it is
read before the loop.
---
 xbmc/utils/FontUtils.cpp | 67 ++++++++++++++++++++++++++--------------
 1 file changed, 43 insertions(+), 24 deletions(-)

diff --git a/xbmc/utils/FontUtils.cpp b/xbmc/utils/FontUtils.cpp
index 6ad566b..b467054 100644
--- a/xbmc/utils/FontUtils.cpp
+++ b/xbmc/utils/FontUtils.cpp
@@ -18,6 +18,9 @@
 #include "utils/CharsetConverter.h"
 #include "utils/log.h"
 
+#include <algorithm>
+#include <cstdint>
+
 #include <ft2build.h>
 
 #include FT_FREETYPE_H
@@ -99,13 +102,37 @@ bool GetFontFamilyNames(const std::vector<uint8_t>& buffer, std::set<std::string
   args.memory_base = reinterpret_cast<const FT_Byte*>(buffer.data());
   args.memory_size = static_cast<FT_Long>(buffer.size());
 
+  // Hades: the number of faces first (a face index of -1 reads it without loading a face), so
+  // that a face that does not load is skipped and the ones after it are still read. FreeType reads
+  // the first face of a collection for it, so where that one is broken, the number is the one of
+  // the header of the TrueType collection ('ttcf', its number of fonts at byte 8, big-endian).
   FT_Long numFaces{0};
+  {
+    FT_Face count{nullptr};
+    if (FT_Open_Face(m_library, &args, -1, &count) == 0)
+    {
+      numFaces = count->num_faces;
+      FT_Done_Face(count);
+    }
+    else if (buffer.size() >= 12 && buffer[0] == 't' && buffer[1] == 't' && buffer[2] == 'c' &&
+             buffer[3] == 'f')
+    {
+      constexpr FT_Long MAX_FACES = 256;
+      const uint32_t fonts = (uint32_t{buffer[8]} << 24) | (uint32_t{buffer[9]} << 16) |
+                             (uint32_t{buffer[10]} << 8) | uint32_t{buffer[11]};
+      numFaces = std::min<FT_Long>(fonts, MAX_FACES);
+    }
+  }
   FT_Long numInstances{0};
   FT_Long faceIndex{0};
   FT_Long instanceIndex{0};
+  bool found{false};
 
-  // Iterate over all font faces, files like .ttc (TrueType Collection) contains multiple fonts
-  do
+  // Iterate over all font faces, files like .ttc (TrueType Collection) contains multiple fonts.
+  // Hades: a face that does not load, or that has no family name, is skipped; the file gives the
+  // names of the others. Before, the first such face ended the reading: the faces after a broken
+  // one were lost, and a face without a name lost the names of all of them.
+  while (faceIndex < numFaces)
   {
     FT_Long idx = (instanceIndex << 16) + faceIndex;
     FT_Face face{nullptr};
@@ -114,38 +141,31 @@ bool GetFontFamilyNames(const std::vector<uint8_t>& buffer, std::set<std::string
     if (error)
     {
       CLog::LogF(LOGERROR, "Failed to open font face at index {} error code {}", idx, error);
-      break;
+      // (its named instances are of no use without it)
+      faceIndex++;
+      instanceIndex = 0;
+      continue;
     }
 
     std::string familyName = GetFamilyNameFromSfnt(face);
-    if (familyName.empty())
+    if (familyName.empty() && face->family_name)
     {
-      if (!face->family_name)
-      {
-        CLog::LogF(LOGERROR, "Family name missing in the font");
-        FT_Done_Face(face);
-        FT_Done_FreeType(m_library);
-        return false;
-      }
-
       CLog::LogF(LOGWARNING, "Failed to get the unicode family name for \"{}\", fallback to ASCII",
                  face->family_name);
       // ASCII font family name may differ from the unicode one, use this as fallback only
       familyName = std::string{face->family_name};
-      if (familyName.empty())
-      {
-        CLog::LogF(LOGERROR, "Family name missing in the font");
-        FT_Done_Face(face);
-        FT_Done_FreeType(m_library);
-        return false;
-      }
     }
 
     // We use the "set" container to avoid duplicate names that can happens
     // for example when a font have each style on different files
-    familyNames.insert(familyName);
+    if (familyName.empty())
+      CLog::LogF(LOGERROR, "Family name missing in the font face at index {}", idx);
+    else
+    {
+      familyNames.insert(familyName);
+      found = true;
+    }
 
-    numFaces = face->num_faces;
     numInstances = face->style_flags >> 16;
 
     FT_Done_Face(face);
@@ -157,11 +177,10 @@ bool GetFontFamilyNames(const std::vector<uint8_t>& buffer, std::set<std::string
       faceIndex++;
       instanceIndex = 0;
     }
-
-  } while (faceIndex < numFaces);
+  }
 
   FT_Done_FreeType(m_library);
-  return true;
+  return found;
 }
 
 bool GetFontFamilyNames(const std::string& filepath, std::set<std::string>& familyNames)
-- 
2.53.0

