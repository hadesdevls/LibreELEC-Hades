From 1a4e163110fa453fe7050c7b978939ff44451a25 Mon Sep 17 00:00:00 2001
From: Hades <15710513+hadesdevls@users.noreply.github.com>
Date: Wed, 18 Nov 2026 06:09:49 +0000
Subject: [PATCH] strings: ranges with "to" and three dots in five Estuary
 strings of Hades
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

Five strings of Hades in Estuary still had characters that the texts of
the project no longer use: three reasons of the player information
wrote a range of refresh rates with an en dash (31658, 31896, 31940),
the Spanish of what to do with it as well (32731; its English already
said "24 to 60 Hz"), and the button that changes the output of a video
ended with the ellipsis character (32753).

They now say "24 to 60 Hz" ("de 24 a 60 Hz", and "no está entre 24 y
60 Hz" for a refresh rate fixed outside them), and "..." as Kodi's own
strings end a command that opens a choice (85 of them in the core
strings, none with the ellipsis character). In en_gb, es_es, es_ar and
es_mx; only the texts change, not the ids or the skin.
---
 .../language/resource.language.en_gb/strings.po    |  6 +++---
 .../language/resource.language.es_ar/strings.po    | 14 +++++++-------
 .../language/resource.language.es_es/strings.po    | 14 +++++++-------
 .../language/resource.language.es_mx/strings.po    | 14 +++++++-------
 4 files changed, 24 insertions(+), 24 deletions(-)

diff --git a/addons/skin.estuary/language/resource.language.en_gb/strings.po b/addons/skin.estuary/language/resource.language.en_gb/strings.po
index c27619d..937bc1f 100644
--- a/addons/skin.estuary/language/resource.language.en_gb/strings.po
+++ b/addons/skin.estuary/language/resource.language.en_gb/strings.po
@@ -1080,7 +1080,7 @@ msgstr ""
 #: /xml/DialogPlayerProcessInfo.xml
 #. Reason: the output mode is not 4K
 msgctxt "#31658"
-msgid "the output mode is not 3840x2160 at 24–60 Hz"
+msgid "the output mode is not 3840x2160 at 24 to 60 Hz"
 msgstr ""
 
 #: /xml/DialogPlayerProcessInfo.xml
@@ -2243,7 +2243,7 @@ msgstr ""
 #: addons/skin.estuary/xml/Variables.xml
 #. Reason on the Dolby Vision page: the output offers no 3840x2160 mode at 24 to 60 Hz
 msgctxt "#31896"
-msgid "this output has no 3840x2160 mode at 24–60 Hz"
+msgid "this output has no 3840x2160 mode at 24 to 60 Hz"
 msgstr ""
 
 #: addons/skin.estuary/xml/Variables.xml
@@ -2459,7 +2459,7 @@ msgstr ""
 #: /xml/DialogPlayerProcessInfo.xml
 #. Reason: the refresh rate is not adjusted to the video and stays at one that native output does not go to
 msgctxt "#31940"
-msgid "the refresh rate is fixed outside 24–60 Hz"
+msgid "the refresh rate is fixed outside 24 to 60 Hz"
 msgstr ""
 
 #: system/settings/settings.xml
