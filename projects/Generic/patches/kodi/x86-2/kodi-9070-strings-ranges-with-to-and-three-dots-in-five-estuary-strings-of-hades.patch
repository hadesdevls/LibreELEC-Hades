 #: /xml/DialogPlayerProcessInfo.xml
 #. Reason: the output mode is not 4K
 msgctxt "#31658"
-msgid "the output mode is not 3840x2160 at 24–60 Hz"
-msgstr "el modo de salida no es 3840x2160 a 24–60 Hz"
+msgid "the output mode is not 3840x2160 at 24 to 60 Hz"
+msgstr "el modo de salida no es 3840x2160 de 24 a 60 Hz"
 
 #: /xml/DialogPlayerProcessInfo.xml
 #. Reason: other (e.g. this stream is not eligible)
@@ -2025,8 +2025,8 @@ msgstr "el controlador lo rechazó (registro del kernel)"
 #: addons/skin.estuary/xml/Variables.xml
 #. Reason on the Dolby Vision page: the output offers no 3840x2160 mode at 24 to 60 Hz
 msgctxt "#31896"
-msgid "this output has no 3840x2160 mode at 24–60 Hz"
-msgstr "esta salida no tiene modo 3840x2160 a 24–60 Hz"
+msgid "this output has no 3840x2160 mode at 24 to 60 Hz"
+msgstr "esta salida no tiene modo 3840x2160 de 24 a 60 Hz"
 
 #: addons/skin.estuary/xml/Variables.xml
 #. Signal of Dolby Vision rebuilt and sent as HDR10: the link carries it at 10 bits or more
@@ -2241,8 +2241,8 @@ msgstr "el controlador no admite DV con HDMI 1.4b"
 #: /xml/DialogPlayerProcessInfo.xml
 #. Reason: the refresh rate is not adjusted to the video and stays at one that native output does not go to
 msgctxt "#31940"
-msgid "the refresh rate is fixed outside 24–60 Hz"
-msgstr "la frecuencia fija está fuera de 24–60 Hz"
+msgid "the refresh rate is fixed outside 24 to 60 Hz"
+msgstr "la frecuencia fija no está entre 24 y 60 Hz"
 
 #: system/settings/settings.xml
 #. Hades, label of setting "audiooutput.hadeslivepassthrough"; the core string #39890
@@ -3955,7 +3955,7 @@ msgstr "Revisá esta entrada de la TV: su modo juego y su ajuste de Dolby Vision
 #. Hades, what to do
 msgctxt "#32731"
 msgid "Set the display mode to 3840x2160 at 24 to 60 Hz in the display settings."
-msgstr "Poné el modo de pantalla en 3840x2160 a 24–60 Hz en los ajustes de pantalla."
+msgstr "Poné el modo de pantalla en 3840x2160 de 24 a 60 Hz en los ajustes de pantalla."
 
 #: addons/skin.estuary/xml/DialogPlayerProcessInfo.xml
 #. Hades, what to do
