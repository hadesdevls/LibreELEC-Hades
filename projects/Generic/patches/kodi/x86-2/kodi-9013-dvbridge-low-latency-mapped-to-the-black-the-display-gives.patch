--- a/addons/resource.language.en_gb/resources/strings.po
+++ b/addons/resource.language.en_gb/resources/strings.po
@@ -27645,6 +27645,18 @@ msgctxt "#41853"
 msgid "Hades lights only the display that shows the picture (System > Display > Monitor), and the sound goes to the audio output of that display, whatever number that output has today. Turn this on only if the sound goes to a device on another output of the graphics card, such as an AV receiver on its own HDMI output: the display of the audio output chosen above is then kept on, black, for its sound, and if it was off, it comes on with the next video that changes the display mode. Off by default."
 msgstr ""
 
+#: system/settings/settings.xml
+#. Hades: label of setting "videoscreen.hadesdvllblackedid"
+msgctxt "#41980"
+msgid "Low-Latency: use the black level the display gives"
+msgstr ""
+
+#: system/settings/settings.xml
+#. Hades: help of setting "videoscreen.hadesdvllblackedid"
+msgctxt "#41981"
+msgid "Hades lifts the darkest parts of the film to the black level that the display gives for Low-Latency in its Dolby Vision information, so that they are not crushed into its black: the darkest parts rise the most, brighter ones less, and the highlights not at all. Most OLED TVs give 0, and nothing changes; LCD TVs and projectors give about 0.005 to 0.27 cd/m². On a display whose real black is lower than the one it gives (some LCD TVs with local dimming), blacks then look grey: turn this off. Not used while 'Low-Latency: peak and colours set here' is on, which has its own black. Takes effect from the next video."
+msgstr ""
+
 #. Hades: value of Kodi's tone mapping method (#36553) and of setting "videoscreen.hadesdvhdr10curve": the BT.2390 curve with libplacebo's default knee (KS = 2 maxLum - 1); translated in Estuary (#33460)
 #: xbmc/video/dialogs/GUIDialogVideoSettings.cpp
 #: system/settings/settings.xml
