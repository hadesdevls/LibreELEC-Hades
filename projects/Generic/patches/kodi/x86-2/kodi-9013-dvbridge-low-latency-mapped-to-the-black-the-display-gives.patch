diff --git a/system/settings/settings.xml b/system/settings/settings.xml
index 48890bc..6d1e12e 100644
--- a/system/settings/settings.xml
+++ b/system/settings/settings.xml
@@ -3649,6 +3649,29 @@
         </dependencies>
         <control type="toggle" />
       </setting>
+      <!-- Hades: the black of the display's Low-Latency target taken from its Dolby Vision block, as its peak
+           and primaries are (CWinSystemGbmGLESContext::DVLowLatencyTarget()); not with the target set by hand,
+           which has its own black -->
+      <setting id="videoscreen.hadesdvllblackedid" type="boolean" parent="videoscreen.hadesdvlowlatency" label="41980" help="41981">
+        <requirement>
+          <and>
+            <condition>HAVE_GBM</condition>
+            <condition>HAS_GLES</condition>
+          </and>
+        </requirement>
+        <level>3</level>
+        <default>true</default>
+        <dependencies>
+          <dependency type="enable">
+            <and>
+              <condition setting="videoscreen.hadesdvnative" operator="is">true</condition>
+              <condition setting="videoscreen.hadesdvlowlatency" operator="is">true</condition>
+              <condition setting="videoscreen.hadesdvllmanual" operator="is">false</condition>
+            </and>
+          </dependency>
+        </dependencies>
+        <control type="toggle" />
+      </setting>
       <setting id="videoscreen.hadesdvllmanual" type="boolean" parent="videoscreen.hadesdvlowlatency" label="40968" help="40969">
         <requirement>
           <and>
diff --git a/xbmc/settings/Settings.h b/xbmc/settings/Settings.h
index 068e85b..1d2af21 100644
--- a/xbmc/settings/Settings.h
+++ b/xbmc/settings/Settings.h
@@ -470,6 +470,7 @@ public:
   static constexpr auto SETTING_VIDEOSCREEN_HADESDVLLGAMUT = "videoscreen.hadesdvllgamut";
   //! Hades: ... and its black, cd/m2 (0: the black of the source kept)
   static constexpr auto SETTING_VIDEOSCREEN_HADESDVLLBLACK = "videoscreen.hadesdvllblack";
+  static constexpr auto SETTING_VIDEOSCREEN_HADESDVLLBLACKEDID = "videoscreen.hadesdvllblackedid";
   //! Hades: the display that Dolby Vision mapped to SDR is made for (Reference, Bright room,
   //! Projector)
   static constexpr auto SETTING_VIDEOSCREEN_HADESDVSDRTARGET = "videoscreen.hadesdvsdrtarget";
diff --git a/xbmc/settings/dialogs/GUIDialogSettingsBase.cpp b/xbmc/settings/dialogs/GUIDialogSettingsBase.cpp
index e5e4b86..7377bbf 100644
--- a/xbmc/settings/dialogs/GUIDialogSettingsBase.cpp
+++ b/xbmc/settings/dialogs/GUIDialogSettingsBase.cpp
@@ -636,6 +636,10 @@ std::string CGUIDialogSettingsBase::GetLocalizedString(uint32_t labelId) const
   // the black of the display for Dolby Vision Low-Latency (System > Display): label, help
   if (labelId >= 40980 && labelId <= 40983)
     return CGUIUtils::GetHadesString(labelId, 32276 + (labelId - 40980));
+  // the black that the display's Dolby Vision block gives for Low-Latency (System > Display): label,
+  // help
+  if (labelId == 41980 || labelId == 41981)
+    return CGUIUtils::GetHadesString(labelId, 41174 + (labelId - 41980));
   // the video scaling method (the video settings of the player): Kodi's own label, and where it
   // does not apply: the Dolby Vision bridge scales the picture itself, with its own filters
 #ifdef HAVE_DVBRIDGE
diff --git a/xbmc/windowing/gbm/WinSystemGbmGLESContext.cpp b/xbmc/windowing/gbm/WinSystemGbmGLESContext.cpp
index 9d5d65e..66bb4c1 100644
--- a/xbmc/windowing/gbm/WinSystemGbmGLESContext.cpp
+++ b/xbmc/windowing/gbm/WinSystemGbmGLESContext.cpp
@@ -5061,6 +5061,18 @@ dvbridge_hdr10_mapping CWinSystemGbmGLESContext::DVLowLatencyTarget(const UTILS:
       mapping.black = std::isfinite(black) ? static_cast<float>(std::clamp(black, 0.0, 0.5)) : 0.0f;
       manual = true;
     }
+    // Hades: ... or the black that the block gives for Low-Latency (12-bit PQ in a version 2 block, at
+    // most 1.03 cd/m2; cd/m2 in a version 1 one, at most 1), within what the black set by hand takes
+    // (0.5 cd/m2), as videoscreen.hadesdvllblackedid asks: the third value of the same target as the
+    // peak and the primaries. Hades' EDID corpus: 0 in 40 of 177 version 2 blocks (OLED), a median of
+    // 0.035 cd/m2, at most 0.27 (edge-lit LCD TVs of 240 to 370 cd/m2).
+    else if (BoolSetting(settings, CSettings::SETTING_VIDEOSCREEN_HADESDVLLBLACKEDID, true))
+    {
+      const double black =
+          dv.version == 2 ? UTILS::PqLevelToNits(dv.targetMinPq) : dv.targetMinNits;
+      mapping.black =
+          std::isfinite(black) && black > 0.0 ? static_cast<float>(std::min(black, 0.5)) : 0.0f;
+    }
   }
   return mapping;
 }
@@ -5150,11 +5162,16 @@ dvbridge_hdr10_mapping CWinSystemGbmGLESContext::TakeDVLowLatencyMapping(const V
                                    : "of its Dolby Vision block",
               mapping.source_known ? "the gamut of its mastering display"
                                    : "BT.2020 (its mastering display is not known)",
-              mapping.black > 0.0f
+              mapping.black > 0.0f && m_dvLowLatencyManual
                   ? StringUtils::Format("its black taken to {:.4f} cd/m2, the black of the display set "
                                         "in the settings, with the black level lift of ITU-R BT.2390 "
                                         "(videoscreen.hadesdvllblack)",
                                         mapping.black)
+              : mapping.black > 0.0f
+                  ? StringUtils::Format("its black taken to {:.4f} cd/m2, the black that the display's "
+                                        "Dolby Vision block gives for Low-Latency, with the black level "
+                                        "lift of ITU-R BT.2390 (videoscreen.hadesdvllblackedid)",
+                                        mapping.black)
                   : std::string("its black kept"),
               NativeDVLowLatencyOverStandard()
                   ? "; the display takes Dolby Vision Standard too, and Low-Latency is sent as the "
