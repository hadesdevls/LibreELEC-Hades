+// Hades: a HEVC stream whose VUI has frame_field_info_present_flag is not known to be progressive
+// from its parameter sets (PROGRESSIVE_VIDEO::Check()): FFmpeg's decoder marks a picture as
+// interlaced where the pic_struct of its picture timing SEI says a field. Kodi then never gave it a
+// mode at its own rate (25 Hz for 25p), and "Video at its own rate with VRR" never took it (the
+// HDR10+ film of the Samsung Odyssey G60SD of the test of 2026-11-18). The picture timing of its
+// first access units is read here, without decoding, before the streams are given to the player,
+// so that the first choice of a mode has it (no second change of mode): progressive where
+// CPictureTimingProof says so. As PrefetchForSoftTelecine(), only a file read from its start by a
+// plain input; the packets that the reads ahead before it took are looked at first, and those read
+// here are added after them (ReadFrame() gives them all first, in order). Not where the two tracks
+// of a Dolby Vision stream are joined (their packets go through CDVLayerMerge). Only where the
+// verdict can change Kodi's choice of a mode (PictureTimingNotNeeded()): nothing is read, and no
+// time taken, for a film at 23.976 with the VRR of videos off.
+void CDVDDemuxFFmpeg::PrefetchForPictureTiming()
+{
+  using namespace PROGRESSIVE_VIDEO;
+  static constexpr size_t MAX_PACKETS = 1200;
+  static constexpr size_t MAX_BYTES = 48 * 1024 * 1024;
+  static constexpr auto MAX_TIME = std::chrono::milliseconds(1500);
+
+  if (!m_pFormatContext || !m_pInput || !m_pInput->IsStreamType(DVDSTREAM_TYPE_FILE) ||
+      m_pInput->IsRealtime() || m_checkTransportStream)
+    return;
+#ifdef HAVE_DVBRIDGE
+  if (m_dvBaseIndex >= 0)
+    return;
+#endif
+
+  struct Probe
+  {
+    CDemuxStreamVideo* video = nullptr;
+    int lengthSize = 0;
+    CPictureTimingProof proof;
+  };
+  std::map<int, Probe> probes;
+  // only where what it says can change a choice of a mode: no time is taken for a film at 23.976
+  // with the VRR of videos off (PictureTimingNotNeeded())
+  PictureTimingNeed need;
+  if (const auto component = CServiceBroker::GetSettingsComponent(); component)
+  {
+    if (const auto settings = component->GetSettings(); settings)
+    {
+      need.settingsRead = true;
+      need.adjustRefreshRate = settings->GetInt(CSettings::SETTING_VIDEOPLAYER_ADJUSTREFRESHRATE) !=
+                               ADJUST_REFRESHRATE_OFF;
+      need.vrrVideo = settings->GetInt(CSettings::SETTING_VIDEOSCREEN_HADESVRRVIDEOMODE) != 0;
+      need.userWhitelist = !settings->GetList(CSettings::SETTING_VIDEOSCREEN_WHITELIST).empty();
+      need.wholeMultiple = settings->GetBool(KODI::WINDOWING::WHOLE_MULTIPLE_SETTING);
+    }
+  }
+  for (unsigned int i = 0; i < m_pFormatContext->nb_streams; ++i)
+  {
+    const AVStream* st = m_pFormatContext->streams[i];
+    if (st->codecpar->codec_type != AVMEDIA_TYPE_VIDEO ||
+        st->codecpar->codec_id != AV_CODEC_ID_HEVC ||
+        (st->disposition & AV_DISPOSITION_ATTACHED_PIC))
+      continue;
+    auto* video = dynamic_cast<CDemuxStreamVideo*>(GetStream(static_cast<int>(i)));
+    if (!video || video->interlaced || video->filmCadence != KODI::FIELDCADENCE::Cadence::UNKNOWN)
+      continue;
+    const Result scan = Check(AV_CODEC_ID_HEVC, st->codecpar->extradata,
+                              static_cast<size_t>(std::max(st->codecpar->extradata_size, 0)));
+    if (scan.progressive || !scan.byPictureTiming)
+      continue;
+    need.fps = video->iFpsRate > 0 && video->iFpsScale > 0
+                   ? static_cast<double>(video->iFpsRate) / video->iFpsScale
+                   : 0.0;
+    if (const char* why = PictureTimingNotNeeded(need))
+    {
+      CLog::Log(
+          LOGINFO,
+          "CDVDDemuxFFmpeg: stream {} is HEVC whose VUI has frame_field_info_present_flag; its "
+          "picture timing is not read ahead ({:.3f} fps): {}",
+          i, need.fps, why);
+      continue;
+    }
+    probes[static_cast<int>(i)] = {
+        video,
+        HevcLengthSize(st->codecpar->extradata,
+                       static_cast<size_t>(std::max(st->codecpar->extradata_size, 0))),
+        {}};
+  }
+  if (probes.empty())
+    return;
+
+  const auto allDone = [&probes]
+  { return std::ranges::all_of(probes, [](const auto& p) { return p.second.proof.Done(); }); };
+  const auto look = [&probes](const AVPacket* packet)
+  {
+    const auto it = probes.find(packet->stream_index);
+    if (it == probes.end() || packet->size <= 0 || it->second.proof.Done())
+      return;
+    it->second.proof.Add(
+        HevcPictureTiming(packet->data, static_cast<size_t>(packet->size), it->second.lengthSize));
+  };
+  // (what was read ahead already, then on from there)
+  size_t bytes = 0;
+  for (const AVPacket* packet : m_prefetched)
+  {
+    look(packet);
+    bytes += static_cast<size_t>(std::max(packet->size, 0));
+  }
+  const auto begin = std::chrono::steady_clock::now();
+  m_timeout.Set(2s);
+  while (!allDone() && m_prefetched.size() < MAX_PACKETS && bytes < MAX_BYTES &&
+         std::chrono::steady_clock::now() - begin < MAX_TIME &&
+         !(m_abortRequested || (m_cancelCheck && m_cancelCheck())))
+  {
+    AVPacket* packet = av_packet_alloc();
+    if (!packet)
+      break;
+    if (av_read_frame(m_pFormatContext, packet) < 0)
+    {
+      av_packet_free(&packet);
+      break;
+    }
+    bytes += static_cast<size_t>(std::max(packet->size, 0));
+    m_prefetched.push_back(packet);
+    look(packet);
+  }
+  m_timeout.SetInfinite();
+  const auto ms = std::chrono::duration_cast<std::chrono::milliseconds>(
+                      std::chrono::steady_clock::now() - begin)
+                      .count();
+
+  for (auto& [index, probe] : probes)
+  {
+    const CPictureTimingProof& proof = probe.proof;
+    switch (proof.Get())
+    {
+      case CPictureTimingProof::Verdict::PROGRESSIVE:
+        probe.video->progressiveByTiming = true;
+        CLog::Log(LOGINFO,
+                  "CDVDDemuxFFmpeg: stream {} is HEVC whose VUI has frame_field_info_present_flag; "
+                  "the picture timing of its first {} access units says whole progressive "
+                  "pictures ({} of them timed; {} packets, {} KiB read ahead, {} ms): it is "
+                  "progressive",
+                  index, proof.Units(), proof.Timed(), m_prefetched.size(), bytes / 1024, ms);
+        break;
+      case CPictureTimingProof::Verdict::NOT_PROGRESSIVE:
+        CLog::Log(LOGINFO,
+                  "CDVDDemuxFFmpeg: stream {} is HEVC whose picture timing says pic_struct {} with "
+                  "source_scan_type {} in its access unit {}: not taken as progressive, as before",
+                  index, proof.PicStruct(), proof.SourceScanType(), proof.DeniedAt());
+        break;
+      case CPictureTimingProof::Verdict::UNKNOWN:
+        CLog::Log(LOGINFO,
+                  "CDVDDemuxFFmpeg: stream {} is HEVC whose VUI has frame_field_info_present_flag; "
+                  "{} of its first {} access units had their picture timing (it takes {}; {} "
+                  "packets, {} KiB read ahead, {} ms): not known to be progressive, as before",
+                  index, proof.Timed(), proof.Units(), CPictureTimingProof::MIN_TIMED,
+                  m_prefetched.size(), bytes / 1024, ms);
+        break;
+    }
+  }
+}
+
