+/*!
+ * \brief Hades: whether the first access units of such a stream show that it is progressive, read
+ *        before playback (CDVDDemuxFFmpeg::PrefetchForPictureTiming())
+ *
+ * FFmpeg's HEVC decoder marks a picture as interlaced only through the pic_struct of a picture
+ * timing SEI, and keeps the last one for an access unit without one. PROGRESSIVE where MIN_TIMED
+ * access units had their timing, each a whole progressive picture (WholeProgressiveFrame()), and none
+ * said otherwise: the stream is then taken as progressive, as one without the flag is, from its first
+ * choice of a mode on (one change of mode, not two). NOT_PROGRESSIVE at the first one that says
+ * fields or interlaced video: as before. UNKNOWN otherwise (too few read): as before. A later picture
+ * marked as interlaced still makes the stream not progressive for the rest of the file (the render
+ * manager, CRenderManager::UpdateProgressive()), as for any stream. Pure: a test runs it on the host.
+ */
+class CPictureTimingProof
+{
+public:
+  static constexpr unsigned int MIN_TIMED = 24;
+
+  enum class Verdict
+  {
+    UNKNOWN,
+    PROGRESSIVE,
+    NOT_PROGRESSIVE,
+  };
+
+  void Add(const PictureTiming& timing)
+  {
+    ++m_units;
+    if (!timing.found)
+      return;
+    ++m_timed;
+    if (!timing.wholeFrames && !m_denied)
+    {
+      m_denied = true;
+      m_deniedAt = m_units;
+      m_picStruct = timing.picStruct;
+      m_sourceScanType = timing.sourceScanType;
+    }
+  }
+  Verdict Get() const
+  {
+    if (m_denied)
+      return Verdict::NOT_PROGRESSIVE;
+    return m_timed >= MIN_TIMED ? Verdict::PROGRESSIVE : Verdict::UNKNOWN;
+  }
+  //! nothing more to read
+  bool Done() const { return Get() != Verdict::UNKNOWN; }
+  unsigned int Units() const { return m_units; }
+  unsigned int Timed() const { return m_timed; }
+  //! where it was denied: the access unit, its pic_struct and source_scan_type
+  unsigned int DeniedAt() const { return m_deniedAt; }
+  unsigned int PicStruct() const { return m_picStruct; }
+  unsigned int SourceScanType() const { return m_sourceScanType; }
+
+private:
+  unsigned int m_units{0};
+  unsigned int m_timed{0};
+  bool m_denied{false};
+  unsigned int m_deniedAt{0};
+  unsigned int m_picStruct{0};
+  unsigned int m_sourceScanType{0};
+};
+
+//! Hades: what decides whether the picture timing of such a stream is read before playback
+//! (PictureTimingNotNeeded())
+struct PictureTimingNeed
+{
+  bool settingsRead{false}; //!< the four settings below were read
+  bool adjustRefreshRate{true}; //!< videoplayer.adjustrefreshrate is not off
+  bool vrrVideo{true}; //!< videoscreen.hadesvrrvideomode is not off
+  bool userWhitelist{false}; //!< videoscreen.whitelist has modes
+  bool wholeMultiple{false}; //!< videoscreen.hadeswholemultiple
+  double fps{0.0}; //!< the frame rate that the demuxer gives the stream; 0 where it has none
+};
+
+/*!
+ * \brief Hades: a refresh rate that Kodi's default whitelist takes only for a video known to be
+ *        progressive: 30 Hz or less, but 24 Hz (CResolutionUtils::FindResolutionFromWhitelist(),
+ *        ExactRateElsewhere.h RateTaken()). Of a rate that a video asks for, with a margin over the
+ *        0.01 Hz within which a mode matches it: a mode that matches 23.976 is always taken.
+ */
+constexpr bool HalfRefreshRate(double rate)
+{
+  return rate > 0.0 && rate <= 30.02 && (rate < 23.92 || rate > 24.08);
+}
+
+/*!
+ * \brief Hades: whether the picture timing of a HEVC stream that only it could make interlaced
+ *        (Result::byPictureTiming) is read before playback, and if not, why
+ *
+ * Whether such a stream is progressive (CDVDStreamInfo::progressive) changes only Kodi's choice of
+ * a mode for it:
+ * - "Video at its own rate with VRR" takes only a progressive video (VRR_VIDEO::Decide());
+ * - with a whitelist of the user, a mode that is a whole-number multiple of the frame rate is kept
+ *   only for one (WholeMultipleKeep());
+ * - without one, a mode of 30 Hz or less but 24 Hz is taken only for one (HalfRefreshRate()): the
+ *   video's own rate, twice it or 2.5 times it (the steps of FindResolutionFromWhitelist(), and
+ *   ExactRateElsewhere.h);
+ * and none of that is asked with "Adjust display refresh rate" off. Where none of it can change, the
+ * up to 1.5 s of reading ahead (CDVDDemuxFFmpeg::PrefetchForPictureTiming()) would delay the start
+ * for nothing: a film at 23.976 with the VRR of videos off is not read. The frame rate is the
+ * demuxer's, which the player's first choice uses. Where the settings could not be read, or the
+ * stream has no frame rate, it is read, as before. Pure: a test runs it on the host.
+ *
+ * \return nullptr where it is read; else why not, for the log
+ */
+constexpr const char* PictureTimingNotNeeded(const PictureTimingNeed& n)
+{
+  if (!n.settingsRead)
+    return nullptr;
+  if (!n.adjustRefreshRate)
+    return "\"Adjust display refresh rate\" is off: no mode is chosen for the video";
+  if (n.vrrVideo)
+    return nullptr;
+  if (n.userWhitelist)
+    return n.wholeMultiple ? nullptr
+                           : "a whitelist of the user chooses the mode, whole-number multiples are "
+                             "off, and \"Video at its own rate with VRR\" is off";
+  // (twice the rate, or 2.5 times it, is 30 Hz or less only for a rate of 15 Hz or less, which is
+  // such a refresh rate itself)
+  if (!(n.fps > 0.0) || HalfRefreshRate(n.fps))
+    return nullptr;
+  return "at its frame rate Kodi chooses the same mode for a progressive video, and \"Video at "
+         "its own rate with VRR\" is off";
+}
