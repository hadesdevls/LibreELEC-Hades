     if (filmCadence != KODI::FIELDCADENCE::Cadence::UNKNOWN)
     {
       progressive = true;
@@ -355,6 +358,15 @@ void CDVDStreamInfo::Assign(const CDemuxStream& right, bool withextradata)
           right.codec, right.extraData.GetData(), right.extraData.GetSize());
       progressive = scan.progressive;
       progressiveReason = scan.reason;
+      // (Hades: what only the picture timing could bar, its first access units showed not to)
