+// Hades: the NAL units of an access unit: each with a length field of lengthSize bytes (1 to 4, as
+// its hvcC says), or an Annex B byte stream (lengthSize 0)
+std::vector<std::span<const uint8_t>> AccessUnitNals(std::span<const uint8_t> data, int lengthSize)
+{
+  if (lengthSize == 0)
+    return AnnexBNals(data);
+  std::vector<std::span<const uint8_t>> nals;
+  if (lengthSize < 1 || lengthSize > 4)
+    return nals;
+  const size_t fieldSize = static_cast<size_t>(lengthSize);
+  size_t pos = 0;
+  while (data.size() - pos >= fieldSize)
+  {
+    size_t length = 0;
+    for (size_t i = 0; i < fieldSize; i++)
+      length = (length << 8) | data[pos + i];
+    pos += fieldSize;
+    if (length > data.size() - pos)
+      break;
+    nals.push_back(data.subspan(pos, length));
+    pos += length;
+  }
+  return nals;
+}
+
+constexpr unsigned int HEVC_NAL_SEI_PREFIX = 39;
+constexpr unsigned int HEVC_SEI_PIC_TIMING = 1;
+
+// Hades: an ff_byte coded value of a SEI message (payloadType, payloadSize): 0xFF bytes and the last
+// one, summed; false where the RBSP ends first
+bool SeiValue(std::span<const uint8_t> rbsp, size_t& pos, size_t& value)
+{
+  value = 0;
+  while (pos < rbsp.size())
+  {
+    const uint8_t byte = rbsp[pos++];
+    value += byte;
+    if (byte != 0xFF)
+      return true;
+  }
+  return false;
+}
+
+// Hades: the pic_timing of a prefix SEI NAL unit of the base layer, as FFmpeg's HEVC decoder reads
+// it with frame_field_info_present_flag (hevc/sei.c, decode_nal_sei_pic_timing()): pic_struct u(4),
+// source_scan_type u(2), duplicate_flag u(1)
+void ReadSeiPictureTiming(std::span<const uint8_t> nal, PROGRESSIVE_VIDEO::PictureTiming& timing)
+{
+  const std::vector<uint8_t> rbsp = Rbsp(nal.subspan(2));
+  size_t pos = 0;
+  // (messages up to the rbsp_trailing_bits)
+  while (pos < rbsp.size() && !(rbsp.size() - pos == 1 && rbsp[pos] == 0x80))
+  {
+    size_t type = 0;
+    size_t size = 0;
+    if (!SeiValue(rbsp, pos, type) || !SeiValue(rbsp, pos, size) || size > rbsp.size() - pos)
+      return;
+    if (type == HEVC_SEI_PIC_TIMING && size > 0)
+    {
+      CRbspReader br(std::span<const uint8_t>(rbsp).subspan(pos, size));
+      const uint32_t picStruct = br.Bits(4);
+      const uint32_t sourceScanType = br.Bits(2);
+      if (!br.Failed())
+      {
+        const bool frame = PROGRESSIVE_VIDEO::WholeProgressiveFrame(picStruct, sourceScanType);
+        if (!timing.found || (timing.wholeFrames && !frame))
+        {
+          timing.picStruct = picStruct;
+          timing.sourceScanType = sourceScanType;
+        }
+        timing.wholeFrames = (!timing.found || timing.wholeFrames) && frame;
+        timing.found = true;
+      }
+    }
+    pos += size;
+  }
