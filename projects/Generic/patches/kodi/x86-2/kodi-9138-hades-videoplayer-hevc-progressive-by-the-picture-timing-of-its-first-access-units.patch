+/*!
+ * \brief Hades: a pic_struct of the picture timing SEI (H.265, table D.2) and its
+ *        source_scan_type that make a whole progressive picture: a frame (0), or a frame shown
+ *        twice or three times (7, 8), from a source that is not interlaced (source_scan_type 1,
+ *        progressive, or 2, unknown; 0 is interlaced). FFmpeg 9 marks a picture as interlaced for
+ *        the fields (1, 2, 9 to 12); the frames of two fields (3 to 6) it does not mark, but they are
+ *        interlaced video, and are not taken here either.
+ */
+constexpr bool WholeProgressiveFrame(unsigned int picStruct, unsigned int sourceScanType)
+{
+  return (picStruct == 0 || picStruct == 7 || picStruct == 8) && sourceScanType != 0;
+}
