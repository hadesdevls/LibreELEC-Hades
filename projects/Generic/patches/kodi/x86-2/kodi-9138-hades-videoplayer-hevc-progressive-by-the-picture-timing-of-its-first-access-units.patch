+int HevcLengthSize(const uint8_t* extradata, size_t size)
+{
+  // (an hvcC record, as HevcNals() takes one: lengthSizeMinusOne in its byte 21)
+  if (extradata && size >= 23 &&
+      (extradata[0] == 1 || (extradata[0] == 0 && (extradata[1] != 0 || extradata[2] > 1))))
+    return (extradata[21] & 3) + 1;
+  return 0;
+}
+
+PictureTiming HevcPictureTiming(const uint8_t* data, size_t size, int lengthSize)
+{
+  PictureTiming timing;
+  if (!data || size == 0)
+    return timing;
+  for (const auto& nal : AccessUnitNals(std::span<const uint8_t>(data, size), lengthSize))
+  {
+    // (a prefix SEI of the base layer: nuh_layer_id 0)
+    if (nal.size() < 3 || ((nal[0] >> 1) & 0x3f) != HEVC_NAL_SEI_PREFIX ||
+        (((nal[0] & 1) << 5) | (nal[1] >> 3)) != 0)
+      continue;
+    ReadSeiPictureTiming(nal, timing);
+  }
+  return timing;
+}
