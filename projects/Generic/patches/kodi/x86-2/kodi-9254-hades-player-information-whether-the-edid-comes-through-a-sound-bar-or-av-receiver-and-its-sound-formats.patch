+	<!-- Hades: whether the EDID comes from the TV itself or through a sound bar, an AV receiver or a switch (by the HDMI
+	     address that the EDID gives the PC: hades.tv.path, hades.tv.address), and the sound formats it declares
+	     (hades.tv.audio, the same names in every language): through such a device, what this page says is what that
+	     device declares (EdidHdmiPath.h of Kodi) -->
+	<variable name="HadesTvPathVar">
+		<value condition="String.IsEqual(Window(Home).Property(hades.tv.path),through)">$ADDON[skin.estuary 54522]$INFO[Window(Home).Property(hades.tv.address), (,)]</value>
+		<value>$ADDON[skin.estuary 54521]$INFO[Window(Home).Property(hades.tv.address), (,)]</value>
+	</variable>
+	<variable name="HadesTvAudioVar">
+		<value condition="String.IsEqual(Window(Home).Property(hades.tv.audio),none)">$ADDON[skin.estuary 61913]</value>
+		<value>$INFO[Window(Home).Property(hades.tv.audio)]</value>
+	</variable>
 	<variable name="HadesTvFreeSyncVar">
 		<value condition="String.IsEqual(Window(Home).Property(hades.tv.freesync),yes)">$ADDON[skin.estuary 61914]</value>
 		<value>$ADDON[skin.estuary 61913]</value>
