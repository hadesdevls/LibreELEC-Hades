diff --git a/xbmc/utils/EdidHdmiPath.h b/xbmc/utils/EdidHdmiPath.h
new file mode 100644
index 0000000..0b4b7e5
--- /dev/null
+++ b/xbmc/utils/EdidHdmiPath.h
@@ -0,0 +1,184 @@
+/*
+ *  Copyright (C) 2026 Hades
+ *  This file is part of LibreELEC Hades. It is not in Kodi as Team Kodi publishes it.
+ *
+ *  SPDX-License-Identifier: GPL-2.0-or-later
+ *  See LICENSES/README.md for more information.
+ */
+
+#pragma once
+
+#include <algorithm>
+#include <cstddef>
+#include <cstdint>
+#include <string>
+#include <vector>
+
+namespace KODI
+{
+namespace UTILS
+{
+
+/*!
+ * \brief Hades: whether the EDID that the source reads comes from the display itself or from a device between them
+ *        (a sound bar, an AV receiver, a switch), and the sound formats it declares, read from the raw EDID
+ *
+ * HDMI gives every source a physical address (HDMI 1.4b, 8.7), which the sink writes into the EDID of each of its
+ * inputs, in its HDMI VSDB: the TV is 0.0.0.0, a source on its input 4 reads 4.0.0.0, and a source on input 2 of a
+ * sound bar that is on the TV's input 2 reads 2.2.0.0. A device that passes HDMI on (a repeater) has to make an EDID
+ * of its own for each of its inputs, so what the source reads there is what that device declares: on an LG C5 behind
+ * a TCL Q85H Pro, 2.2.0.0, a Dolby Vision block of version 1 (12 bytes) where the TV's own is version 2, DTS and
+ * DTS-HD that the TV does not take, and FRL 40 Gb/s where the TV declares 48 (EDIDs of the same TV read both ways,
+ * 2026-11-24).
+ *
+ * An address that the rules of HDMI do not allow (F.F.F.F, which a sink without an address writes; a nibble that is
+ * not 0 after one that is) says nothing, and neither does 0.0.0.0 (the address of the TV itself, which some PC
+ * monitors write for every input): where the source sits is then unknown, as where the EDID has no HDMI VSDB at all
+ * (DisplayPort, DVI).
+ */
+struct EdidHdmiPath
+{
+  //! the physical address of the HDMI VSDB, A.B.C.D in four nibbles (A the highest); NONE without one
+  uint16_t address = NONE;
+  //! the CTA-861 audio format codes of the short audio descriptors (bit n set: code n is declared)
+  uint32_t audioFormats = 0;
+  //! the most channels of LPCM that a descriptor declares
+  unsigned int pcmChannels = 0;
+
+  static constexpr uint16_t NONE = 0xFFFF;
+
+  //! An address that says where the source is: not F.F.F.F, not 0.0.0.0, and no nibble after a 0 that is not 0
+  bool Valid() const
+  {
+    if (address == NONE || address == 0)
+      return false;
+    bool zero = false;
+    for (int shift = 12; shift >= 0; shift -= 4)
+    {
+      const unsigned nibble = (address >> shift) & 0xF;
+      if (zero && nibble)
+        return false;
+      zero |= nibble == 0;
+    }
+    return true;
+  }
+
+  /*!
+   * \brief How many devices pass the signal on between the source and the display: 0 where the source is on an input
+   *        of the display (A.0.0.0), 1 behind one device (A.B.0.0), up to 3; -1 where that is not known (see Valid())
+   */
+  int Between() const
+  {
+    if (!Valid())
+      return -1;
+    int depth = 0;
+    for (int shift = 12; shift >= 0 && ((address >> shift) & 0xF); shift -= 4)
+      ++depth;
+    return depth - 1;
+  }
+
+  //! The address as HDMI writes it, "2.2.0.0"; "" without one
+  std::string AddressText() const
+  {
+    if (address == NONE)
+      return {};
+    std::string text;
+    for (int shift = 12; shift >= 0; shift -= 4)
+    {
+      if (!text.empty())
+        text += '.';
+      const unsigned nibble = (address >> shift) & 0xF;
+      text += static_cast<char>(nibble < 10 ? '0' + nibble : 'a' + nibble - 10);
+    }
+    return text;
+  }
+
+  bool Declares(unsigned int code) const { return code < 32 && (audioFormats >> code) & 1; }
+
+  /*!
+   * \brief The sound formats that matter for a film, by their short names, the same in every language: "TrueHD, DD+,
+   *        DTS-HD, DTS, AC-3, PCM 8 ch"; "" where the EDID declares none (no audio data block: the display takes
+   *        two channels of PCM, or no sound at all)
+   */
+  std::string AudioText() const
+  {
+    std::string text;
+    const auto add = [&text](const char* name)
+    {
+      if (!text.empty())
+        text += ", ";
+      text += name;
+    };
+    if (Declares(MAT))
+      add("TrueHD");
+    if (Declares(EAC3))
+      add("DD+");
+    if (Declares(DTSHD))
+      add("DTS-HD");
+    if (Declares(DTS))
+      add("DTS");
+    if (Declares(AC3))
+      add("AC-3");
+    if (Declares(LPCM) && pcmChannels)
+    {
+      add("PCM ");
+      text += std::to_string(pcmChannels) + " ch";
+    }
+    return text;
+  }
+
+  // the audio format codes of CTA-861 (short audio descriptors) named above
+  static constexpr unsigned int LPCM = 1;
+  static constexpr unsigned int AC3 = 2;
+  static constexpr unsigned int DTS = 7;
+  static constexpr unsigned int EAC3 = 10;
+  static constexpr unsigned int DTSHD = 11;
+  static constexpr unsigned int MAT = 12; //!< MAT (MLP): Dolby TrueHD
+};
+
+/*!
+ * \brief The EdidHdmiPath of an EDID: the CTA-861 extensions (tag 2) of every block that was read, their HDMI VSDB
+ *        (IEEE OUI 00-0C-03: the address is its two bytes after the OUI) and their audio data blocks
+ *
+ * The first HDMI VSDB gives the address (a repeater writes one per EDID). The data blocks are read as the kernel and
+ * libdisplay-info read them: from byte 4 of the extension to its offset of the detailed timings, never past its 128
+ * bytes.
+ */
+inline EdidHdmiPath EdidHdmiPathOf(const std::vector<uint8_t>& edid)
+{
+  EdidHdmiPath path;
+  bool addressed = false;
+  for (std::size_t b = 128; b + 128 <= edid.size(); b += 128)
+  {
+    const uint8_t* e = &edid[b];
+    if (e[0] != 0x02)
+      continue;
+    const unsigned end = e[2];
+    for (unsigned i = 4; i < end && i < 128;)
+    {
+      const unsigned tag = e[i] >> 5, len = e[i] & 31;
+      const uint8_t* blk = e + i + 1;
+      const unsigned avail = i + 1 + len <= 128 ? len : 127 - i;
+      if (tag == 1)
+      {
+        for (unsigned k = 0; k + 3 <= avail; k += 3)
+        {
+          const unsigned code = (blk[k] >> 3) & 0xF;
+          path.audioFormats |= 1u << code;
+          if (code == EdidHdmiPath::LPCM)
+            path.pcmChannels = std::max(path.pcmChannels, (blk[k] & 7u) + 1);
+        }
+      }
+      else if (tag == 3 && avail >= 5 && blk[0] == 0x03 && blk[1] == 0x0c && blk[2] == 0x00 && !addressed)
+      {
+        path.address = static_cast<uint16_t>((blk[3] << 8) | blk[4]);
+        addressed = true;
+      }
+      i += 1 + len;
+    }
+  }
+  return path;
+}
+
+} // namespace UTILS
+} // namespace KODI
