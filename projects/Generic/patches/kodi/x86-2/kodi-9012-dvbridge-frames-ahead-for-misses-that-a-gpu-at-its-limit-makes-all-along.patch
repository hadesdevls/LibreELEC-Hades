From 7e4eb6904a15cd05588ff9598b9c4a0372acd8bd Mon Sep 17 00:00:00 2001
From: Hades <15710513+hadesdevls@users.noreply.github.com>
Date: Wed, 18 Nov 2026 01:32:52 +0000
Subject: [PATCH] [DVBridge] Frames ahead for misses that a GPU at its limit
 makes all along

Issue #4: a Quadro RTX 4000 in a laptop held to 35 W (P5, its power cap
active, 1125 of 1560 MHz) played a profile 8 film of 1 h 48 min at
23.976 Hz in 1.0 with 194 frames shown two refresh periods long in
155 319 (1.25 in 1000, one every half minute or so), each with a frame
of more than a refresh period of GPU time. Presenting frames a frame
ahead gives a frame up to two periods, and was never called for there:
the rule of misses wants 3 or more late frames in a run of 240 in two of
the last three runs, and that film had 0 to 3 in a run, about 0.3 on
average.

CDVAhead now also keeps the last 30 runs of 240 frames presented the way
that waits (five minutes of film), each marked where a frame of it missed
its refresh and a frame of it took more GPU time than a refresh period
(the frames without GUI elements, told by TimedWithoutGui() as their
timer queries come back). 7 marked runs of the 30 call for frames ahead,
with a line in kodi.log that says so and what it costs: the GUI over the
video comes a refresh later; the sound is kept in step
(DVLatency.h). A seek keeps the runs, as it keeps those of the rule
before; a new refresh rate or the end of the output forgets them. The
rules before (MISS_LATE in two of three runs, the short runs of a GPU
that cannot keep up at all, the GPU time on drivers where it counts) are
unchanged, and come first.

The GPU time is what tells those misses from the others: in the film, of
the 152 windows of 10 s without GUI elements with a frame shown late, 121
had a frame of more than 41.7 ms of GPU time, and of the 450 without, 1;
in every log at hand of an RTX 4080 SUPER (1 142 windows without GUI
elements in 1.0), one window had both.

Replayed (the windows of the logs, the late frames at 50 seeded random
places, the GPU maximum of a window on its late frames): the film calls
for frames ahead in 50 of 50 replays (at the median after 42 runs, seven
minutes), counting its windows with GUI elements as without them too;
no log of an RTX 4080 SUPER, RTX 4080 Laptop GPU or RTX 5090 does, either
way. An older test of this header, unchanged, passes with it;
the new checks fail against the header before.
---
 xbmc/windowing/gbm/DVAhead.h                  | 126 ++++++++++++++++--
 .../windowing/gbm/WinSystemGbmGLESContext.cpp |  14 ++
 2 files changed, 132 insertions(+), 8 deletions(-)

diff --git a/xbmc/windowing/gbm/DVAhead.h b/xbmc/windowing/gbm/DVAhead.h
index 036fa33..5336e71 100644
--- a/xbmc/windowing/gbm/DVAhead.h
+++ b/xbmc/windowing/gbm/DVAhead.h
@@ -9,6 +9,7 @@
 #pragma once
 
 #include <algorithm>
+#include <array>
 #include <cmath>
 
 namespace KODI
@@ -73,6 +74,20 @@ namespace GBM
  * aside for the short runs (not for those of MISS_WINDOW): its first frames draw what the warm-up
  * left, and the GPU's clocks are still those of the menus. A GPU that cannot keep up at all still
  * misses its refresh after them.
+ *
+ * Hades: a GPU at the edge of its time misses its refresh now and then, but all along: the same
+ * Quadro RTX 4000 in a laptop held to 35 W (P5, its power cap active), with a profile 8 film of 1 h 48
+ * min at 23.976 Hz in 1.0, had 194 frames shown two periods long in 155 319 (1.25 in 1000; 166 of them
+ * in the 602 of its 648 windows of 10 s without GUI elements), 0 to 3 in a run of 240, so that the rule
+ * of MISS_LATE never called for frames ahead (issue #4). Each came with a frame that took more GPU time
+ * than a refresh period: of its 152 windows without GUI elements with a frame shown late, 121 had a
+ * frame of more than 41.7 ms of GPU time, and of the 450 without, 1. Frames ahead give a frame up to
+ * two periods. So the runs
+ * of MISS_WINDOW frames presented the way that waits are kept for SUSTAIN_RUNS of them (five minutes of
+ * film), each marked where a frame of it missed its refresh and a frame of it (without GUI elements,
+ * TimedWithoutGui()) took more than a refresh period of GPU time; SUSTAIN_HITS marked runs call for
+ * frames ahead (SustainedRuns()). An RTX 4080 SUPER, in every log of it at hand (1.0: 1 142 windows
+ * without GUI elements), had one window with both; its misses come without such frames.
  */
 class CDVAhead
 {
@@ -174,6 +189,7 @@ public:
       m_missLate = 0;
       m_missRuns = 0;
       ForgetQuick();
+      ForgetSustained();
       m_quickAsideMs = START_ASIDE_MS;
     }
     // (the frames of the time set aside after a seek, or after GUI elements went, count for
@@ -206,6 +222,7 @@ public:
         m_missNeeded = true;
         m_missNeededPeriod = periodMs;
         m_quickCalled = true;
+        m_sustainCalled = false;
         return Change::NEEDED;
       }
     }
@@ -213,8 +230,18 @@ public:
     if (++m_missFrames < MISS_WINDOW)
       return Change::NONE;
     const unsigned int lateInRun = m_missLate;
+    const unsigned int overrunsInRun = m_sustainOverruns;
     m_missFrames = 0;
     m_missLate = 0;
+    m_sustainOverruns = 0;
+    // Hades: the run in the last SUSTAIN_RUNS: whether a frame of it missed its refresh and a frame of
+    // it took more GPU time than a refresh period (SustainedRuns())
+    const bool hit = lateInRun >= 1 && overrunsInRun >= 1;
+    m_sustainHits = ((m_sustainHits << 1) | (hit ? 1u : 0u)) & SUSTAIN_MASK;
+    m_sustainLate[m_sustainAt] = lateInRun > 255 ? 255 : static_cast<unsigned char>(lateInRun);
+    m_sustainAt = (m_sustainAt + 1) % SUSTAIN_RUNS;
+    if (m_sustainSeen < SUSTAIN_RUNS)
+      ++m_sustainSeen;
     // the last three runs, the newest in the lowest bit
     m_missRuns = ((m_missRuns << 1) | (lateInRun >= MISS_LATE ? 1u : 0u)) & 0x7u;
     if (lateInRun >= MISS_LATE)
@@ -222,19 +249,56 @@ public:
       m_missLateBefore = m_missLateLast;
       m_missLateLast = lateInRun;
     }
-    if (lateInRun < MISS_LATE || Needed(periodMs))
+    if (Needed(periodMs))
       return Change::NONE;
     const unsigned int runs =
         (m_missRuns & 1u) + ((m_missRuns >> 1) & 1u) + ((m_missRuns >> 2) & 1u);
-    if (runs < MISS_RUNS)
-      return Change::NONE;
-    m_missRuns = 0;
-    m_missNeeded = true;
-    m_missNeededPeriod = periodMs;
-    m_quickCalled = false;
-    return Change::NEEDED;
+    if (lateInRun >= MISS_LATE && runs >= MISS_RUNS)
+    {
+      m_missRuns = 0;
+      m_missNeeded = true;
+      m_missNeededPeriod = periodMs;
+      m_quickCalled = false;
+      m_sustainCalled = false;
+      return Change::NEEDED;
+    }
+    // Hades: ... or misses that a GPU at the edge of its time makes now and then, but all along
+    // (SustainedRuns())
+    if (SustainedHits() >= SUSTAIN_HITS)
+    {
+      m_sustainCalledHits = SustainedHits();
+      m_sustainCalledLate = SustainedLate();
+      m_sustainHits = 0;
+      m_missNeeded = true;
+      m_missNeededPeriod = periodMs;
+      m_quickCalled = false;
+      m_sustainCalled = true;
+      return Change::NEEDED;
+    }
+    return Change::NONE;
+  }
+
+  /*!
+   * \brief Hades: the GPU time of a frame of the video playing without GUI elements (as the frames
+   *        that PresentedWaiting() is told of), for SustainedRuns(): whether it took more than a
+   *        refresh period. Where frames are presented the way that waits, such a frame cannot come
+   *        with its refresh.
+   */
+  void TimedWithoutGui(double ms, double periodMs)
+  {
+    if (!(ms > 0.0) || !(periodMs > 0.0) || !SamePeriod(periodMs, m_missPeriod) ||
+        m_missAsideMs > 0.0)
+      return;
+    if (ms > SUSTAIN_OVER * periodMs && m_sustainOverruns < 65535)
+      ++m_sustainOverruns;
   }
 
+  //! Hades: SustainedRuns() called for it, the last time it was called for, with how many runs of
+  //! the last SUSTAIN_RUNS, and how many frames of them missed their refresh, for the log
+  bool SustainedRuns() const { return m_sustainCalled; }
+  unsigned int SustainedCalledHits() const { return m_sustainCalledHits; }
+  unsigned int SustainedCalledLate() const { return m_sustainCalledLate; }
+
   //! Hades: the frames that missed their refresh in the two runs that called for it last (newest
   //! second), for the log
   unsigned int MissedBefore() const { return m_missLateBefore; }
@@ -361,6 +425,7 @@ public:
     m_missRuns = 0;
     m_missAsideMs = 0.0;
     ForgetQuick();
+    ForgetSustained();
     m_quickAsideMs = START_ASIDE_MS;
     return gone;
   }
@@ -378,6 +443,33 @@ private:
     m_quickRuns = 0;
   }
 
+  //! Hades: the runs of SustainedRuns() (with the runs of MISS_WINDOW: a new refresh rate, the end of an
+  //! output; a seek keeps them, as it keeps those)
+  void ForgetSustained()
+  {
+    m_sustainOverruns = 0;
+    m_sustainHits = 0;
+    m_sustainLate.fill(0);
+    m_sustainAt = 0;
+    m_sustainSeen = 0;
+  }
+  //! Hades: of the last SUSTAIN_RUNS runs, those in which a frame missed its refresh and a frame took
+  //! more GPU time than a refresh period, and the frames of the last runs that missed their refresh
+  unsigned int SustainedHits() const
+  {
+    unsigned int n = 0;
+    for (unsigned int bits = m_sustainHits; bits; bits >>= 1)
+      n += bits & 1u;
+    return n;
+  }
+  unsigned int SustainedLate() const
+  {
+    unsigned int n = 0;
+    for (unsigned int i = 0; i < m_sustainSeen; ++i)
+      n += m_sustainLate[i];
+    return n;
+  }
+
   static constexpr unsigned int WINDOW = 24; //!< frames of an average (a second of film)
   //! part of the refresh period from which the frames call for it: with half the period left,
   //! a frame that takes half as long again is still in time without it
@@ -407,6 +499,17 @@ public:
   //! ... after the first time of a native output or of a refresh rate, which they set aside (as
   //! much as a seek sets aside)
   static constexpr double START_ASIDE_MS = SEEK_ASIDE_MS;
+  //! Hades: SustainedRuns(): the runs of MISS_WINDOW looked at (30: 7200 frames, five minutes of
+  //! film), ...
+  static constexpr unsigned int SUSTAIN_RUNS = 30;
+  static constexpr unsigned int SUSTAIN_MASK = (1u << SUSTAIN_RUNS) - 1u;
+  //! ... those of them in which a frame missed its refresh and a frame took more than SUSTAIN_OVER of
+  //! a refresh period of GPU time, from which frames ahead are called for (replayed, issue #4's film calls
+  //! for it after 42 runs at the median, seven minutes; an RTX 4080 Laptop GPU with three such runs in
+  //! two and a half minutes, and a few more where its GUI was over the video, does not at 7, as no RTX
+  //! 4080 SUPER or RTX 5090 log does)
+  static constexpr unsigned int SUSTAIN_HITS = 7;
+  static constexpr double SUSTAIN_OVER = 1.0;
 
 private:
 
@@ -443,6 +546,13 @@ private:
   unsigned int m_quickLateLast = 0;
   bool m_quickCalled = false;
   double m_quickAsideMs = START_ASIDE_MS; //!< of the start of an output or of a refresh rate
+  // Hades: SustainedRuns()
+  unsigned int m_sustainOverruns = 0; //!< frames of the run being counted over a period of GPU time
+  unsigned int m_sustainHits = 0; //!< the last SUSTAIN_RUNS runs, the newest in the lowest bit
+  std::array<unsigned char, SUSTAIN_RUNS> m_sustainLate{}; //!< ... the frames of each that were late
+  unsigned int m_sustainAt = 0, m_sustainSeen = 0;
+  bool m_sustainCalled = false;
+  unsigned int m_sustainCalledHits = 0, m_sustainCalledLate = 0;
 };
 
 } // namespace GBM
diff --git a/xbmc/windowing/gbm/WinSystemGbmGLESContext.cpp b/xbmc/windowing/gbm/WinSystemGbmGLESContext.cpp
index 067f941..9d5d65e 100644
--- a/xbmc/windowing/gbm/WinSystemGbmGLESContext.cpp
+++ b/xbmc/windowing/gbm/WinSystemGbmGLESContext.cpp
@@ -9174,6 +9174,10 @@ void CWinSystemGbmGLESContext::DVGpuTimerCollect()
       // Hades: HDR over the tunnel: does it keep up (CHdr10TunnelGuard)
       if (m_outputHandover.HeldHdr10Tunnel())
         Hdr10TunnelGuardFrame(ms, false);
+      // Hades: ... and the GPU time of the frames without GUI elements, for the misses that a GPU at
+      // the edge of its time makes all along (CDVAhead::SustainedRuns())
+      if (!gui)
+        m_dvAhead.TimedWithoutGui(ms, period);
       const auto change = m_dvAhead.Measured(ms, period);
       if (change != CDVAhead::Change::NONE && m_dvAheadModeRead &&
           m_dvAheadMode == CDVAhead::Mode::NEEDED)
@@ -9756,6 +9760,16 @@ void CWinSystemGbmGLESContext::DVAheadWaited(bool late, double periodMs)
               "presenting them a frame ahead is now called for",
               m_dvAhead.QuickMissedBefore(), m_dvAhead.QuickMissedLast(), CDVAhead::QUICK_WINDOW,
               m_dvAhead.Average(), periodMs);
+  else if (m_dvAhead.SustainedRuns())
+    CLog::Log(LOGINFO,
+              "DVBridge: frames presented the way that waits missed their refresh all along, each time "
+              "with a frame that took more GPU time than a refresh period ({} of the last {} runs of {} "
+              "frames without GUI elements, {} frames late in them; GPU {:.1f} ms on average, of the "
+              "{:.1f} ms of a refresh): a GPU at the edge of its time (a laptop's power limit, say). "
+              "Presenting them a frame ahead is now called for: a frame has up to two refresh periods, "
+              "and the GUI over the video comes a refresh later (the sound is kept in step)",
+              m_dvAhead.SustainedCalledHits(), CDVAhead::SUSTAIN_RUNS, CDVAhead::MISS_WINDOW,
+              m_dvAhead.SustainedCalledLate(), m_dvAhead.Average(), periodMs);
   else
     CLog::Log(LOGINFO,
               "DVBridge: frames presented the way that waits missed their refresh again and again "
-- 
2.53.0

