From b377ece8595350e09d1113ddde596e4d8e4275a8 Mon Sep 17 00:00:00 2001
From: Hades <15710513+hadesdevls@users.noreply.github.com>
Date: Wed, 18 Nov 2026 20:33:45 +0000
Subject: [PATCH] [GBM][DRM] Hades: the picture of the output at Kodi's start
 is put back only while it is still there

At its end Kodi puts back the mode and the frame buffer that its output had
when it started (RestoreOriginalMode(), drmModeSetCrtc() with the buffer id
read then). That buffer was the console's frame buffer, which lives as long as
the device. Where displays of different sizes are connected, hades-picture now
shows the picture of the start, or a notice, on each display in a buffer of its
own until Kodi has put its own in its place, and then frees it: at Kodi's end
the id named no frame buffer ("Failed to set original crtc mode", an error in
kodi.log at every end of Kodi), or, since ids are used again, another one.

The frame buffer is described when Kodi takes the output (GETFB: size, pitch,
depth; the handle that GETFB gives a privileged caller is closed at once) and
put back only while that id still describes the same; else nothing is put back,
with a line that says why: the console shows its own picture when Kodi closes
the device (drm_lastclose()), as it does after every other end of Kodi.
---
 xbmc/windowing/gbm/drm/DRMUtils.cpp | 40 +++++++++++++++++++++++++++++
 xbmc/windowing/gbm/drm/DRMUtils.h   | 12 +++++++++
 2 files changed, 52 insertions(+)

diff --git a/xbmc/windowing/gbm/drm/DRMUtils.cpp b/xbmc/windowing/gbm/drm/DRMUtils.cpp
index f31708c..155dada 100644
--- a/xbmc/windowing/gbm/drm/DRMUtils.cpp
+++ b/xbmc/windowing/gbm/drm/DRMUtils.cpp
@@ -1250,6 +1250,8 @@ bool CDRMUtils::FindCrtc()
     m_crtc = m_orig_crtc;
     // (Hades: the output that it drives, which the end of Kodi gives it back with its mode)
     m_origConnectorId = *m_connector->GetConnectorId();
+    // (Hades: and the picture that it showed, see RestoreOriginalMode())
+    m_origFb = DescribeFb(m_orig_crtc->GetBufferId());
     // Hades: an output that was left in a mode with a 3D layout (by a Kodi that ended while it
     // showed 3D) is not taken to be in a mode: Kodi starts in the preferred one, which is one
     // of its list, as where the output has no mode (FindPreferredMode()).
@@ -1277,6 +1279,25 @@ bool CDRMUtils::FindCrtc()
   return false;
 }
 
+CDRMUtils::OrigFb CDRMUtils::DescribeFb(uint32_t id) const
+{
+  OrigFb fb;
+  drmModeFBPtr info = id ? drmModeGetFB(m_fd, id) : nullptr;
+  if (info)
+  {
+    fb = {info->fb_id, info->width, info->height, info->pitch, info->bpp};
+    if (info->handle)
+    {
+      // (GETFB gives a privileged caller a handle of the buffer, which is not wanted here)
+      drm_gem_close close{};
+      close.handle = info->handle;
+      drmIoctl(m_fd, DRM_IOCTL_GEM_CLOSE, &close);
+    }
+    drmModeFreeFB(info);
+  }
+  return fb;
+}
+
 bool CDRMUtils::RestoreOriginalMode()
 {
   if (!m_orig_crtc)
@@ -1284,6 +1305,25 @@ bool CDRMUtils::RestoreOriginalMode()
     return false;
   }
 
+  // Hades: the picture that the output showed when Kodi started may be gone. hades-picture shows the picture of the
+  // start, or a notice, on each display in a buffer of its own until Kodi has put its own in its place, and then
+  // frees it; its number may belong to another frame buffer by now. The console's own picture comes back when Kodi
+  // closes the device (drm_lastclose()), so nothing is put back here (before, this asked for a frame buffer that was
+  // no more, and logged an error).
+  if (m_origFb.id != 0)
+  {
+    const OrigFb now = DescribeFb(m_origFb.id);
+    if (now.id != m_origFb.id || now.width != m_origFb.width || now.height != m_origFb.height ||
+        now.pitch != m_origFb.pitch || now.bpp != m_origFb.bpp)
+    {
+      CLog::LogF(LOGINFO,
+                 "the picture that the output showed when Kodi started ({}x{}, frame buffer {}) is gone: it "
+                 "is not put back, the console shows its own when Kodi closes the display",
+                 m_origFb.width, m_origFb.height, m_origFb.id);
+      return false;
+    }
+  }
+
   // Hades: an output that Kodi found in a mode with a 3D layout (see FindCrtc()) is not put
   // back into it, but into the same timing as a 2D mode: what is shown there next is a 2D
   // picture, which a display that is told of a 3D layout shows as two eyes. Any other mode is
diff --git a/xbmc/windowing/gbm/drm/DRMUtils.h b/xbmc/windowing/gbm/drm/DRMUtils.h
index c67f2a3..165996b 100644
--- a/xbmc/windowing/gbm/drm/DRMUtils.h
+++ b/xbmc/windowing/gbm/drm/DRMUtils.h
@@ -497,6 +497,18 @@ private:
   //! Hades: the output that Kodi took over when it started, which the end of Kodi puts back in the
   //! mode it was in (RestoreOriginalMode()), also after a move to another output
   uint32_t m_origConnectorId{0};
+  //! Hades: the picture that output showed when Kodi took it over (its frame buffer, as GETFB described it then),
+  //! which RestoreOriginalMode() puts back only while that frame buffer is still the same one
+  struct OrigFb
+  {
+    uint32_t id{0};
+    uint32_t width{0};
+    uint32_t height{0};
+    uint32_t pitch{0};
+    uint32_t bpp{0};
+  } m_origFb;
+  //! Hades: m_origFb as GETFB describes the frame buffer of that id now (nothing where there is none)
+  OrigFb DescribeFb(uint32_t id) const;
   std::vector<std::unique_ptr<CDRMConnector>> m_connectors;
   std::vector<std::unique_ptr<CDRMEncoder>> m_encoders;
   std::vector<std::unique_ptr<CDRMCrtc>> m_crtcs;
-- 
