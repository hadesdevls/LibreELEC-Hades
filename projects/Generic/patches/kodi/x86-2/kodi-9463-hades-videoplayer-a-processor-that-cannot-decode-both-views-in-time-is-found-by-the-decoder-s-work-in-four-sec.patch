@@ -131,6 +139,9 @@ private:
   int m_disparity{0};
   bool m_sizeTold{false}; //!< what the eyes are was said in the log
   KODI::MULTIVIEW::Pace m_pace;
+  KODI::MULTIVIEW::Work m_work;
+  //! (Hades) why the processor was taken not to keep up, where it was by the work of the decoder
+  std::string m_slowText;
   bool m_slow{false};
   AVFrame* m_waiting{nullptr}; //!< the picture that waits for the other view of its access unit
   std::optional<KODI::MULTIVIEW::View> m_waitingView; //!< ... and what it is, when one waits
diff --git a/xbmc/cores/VideoPlayer/MultiviewChoice.h b/xbmc/cores/VideoPlayer/MultiviewChoice.h
index 1fb52a8..46ce6b5 100644
--- a/xbmc/cores/VideoPlayer/MultiviewChoice.h
+++ b/xbmc/cores/VideoPlayer/MultiviewChoice.h
@@ -1635,6 +1635,66 @@ inline bool Paced(Pace& pace, bool late, bool judged)
   return pace.slowWindows >= PACE_SLOW_WINDOWS;
 }
 
+//! Hades: pictures after a start or a seek before the work of the decoder is measured (its threads
+//! fill, and the first pictures of each cost more)
+inline constexpr unsigned int WORK_SKIP = 8;
+//! Hades: the pictures over which the work of the decoder is measured (two seconds of film)
+inline constexpr unsigned int WORK_WINDOW = 48;
+//! Hades: the share of the rate of the video under which a window is a slow one: the decoder gives
+//! fewer pictures a second of its own work than nine tenths of the pictures of a second of film
+inline constexpr double WORK_MARGIN = 0.9;
+//! Hades: slow windows in a row after which the processor is taken not to keep up (four seconds)
+inline constexpr unsigned int WORK_SLOW_WINDOWS = 2;
+
+//! Hades: the work of the decoder of both views, measured (Worked())
+struct Work
+{
+  unsigned int skipped{0}; //!< pictures since the start or the last seek, up to WORK_SKIP
+  unsigned int inWindow{0};
+  double busyMs{0.0}; //!< the time spent in the decoder for the pictures of the window
+  unsigned int slowWindows{0}; //!< slow windows in a row
+  double rate{0.0}; //!< pictures a second of the decoder's own work, in the last window
+};
+
+/*!
+ * \brief Hades: a picture of two views went out of the decoder that the processor runs; whether
+ *        the processor is now taken not to keep up, by the work of the decoder itself
+ * \param busyMs the time that the player spent in the decoder (sending it packets, asking it for
+ *        pictures) since the picture before: with threads, the decoder takes a packet only when
+ *        one of them is free, so that where the processor is what holds the playback back, this
+ *        is the time it needs for a picture; where it keeps up, the player waits elsewhere (for
+ *        the display, for its source) and this is short
+ * \param fps the pictures a second of the video (0 where it is not known: never judged)
+ * \param judged as for Paced()
+ *
+ * Paced() sees that the processor does not keep up only once the playback has fallen behind, again
+ * and again, for eight seconds after a grace of two: ten seconds and more of a picture that
+ * judders. The work of the decoder tells it sooner: where, in two windows in a row of
+ * WORK_WINDOW pictures, it gives fewer pictures a second of its own work than WORK_MARGIN of the
+ * pictures of a second of film, it cannot keep up, and the stream goes back to its base view at
+ * once, about four seconds into the film. A processor that keeps up, or nearly, is left to
+ * Paced(), as before.
+ */
+inline bool Worked(Work& work, double busyMs, double fps, bool judged)
+{
+  if (!judged || !(fps > 0.0))
+    return false;
+  if (work.skipped < WORK_SKIP)
+  {
+    ++work.skipped;
+    return false;
+  }
+  ++work.inWindow;
+  work.busyMs += busyMs > 0.0 ? busyMs : 0.0;
+  if (work.inWindow < WORK_WINDOW)
+    return false;
+  work.rate = work.busyMs > 0.0 ? work.inWindow * 1000.0 / work.busyMs : 1.0e9;
+  work.slowWindows = work.rate < WORK_MARGIN * fps ? work.slowWindows + 1 : 0;
+  work.inWindow = 0;
+  work.busyMs = 0.0;
+  return work.slowWindows >= WORK_SLOW_WINDOWS;
+}
+
 //! @}
 
