   AVFrame* m_viewDownload = nullptr;
diff --git a/xbmc/cores/VideoPlayer/DVDCodecs/Video/MultiviewPacker.cpp b/xbmc/cores/VideoPlayer/DVDCodecs/Video/MultiviewPacker.cpp
index a0ec373..9a4956b 100644
--- a/xbmc/cores/VideoPlayer/DVDCodecs/Video/MultiviewPacker.cpp
+++ b/xbmc/cores/VideoPlayer/DVDCodecs/Video/MultiviewPacker.cpp
@@ -515,6 +515,27 @@ void CMultiviewPacker::Reset()
   m_withoutPicture = 0;
   // (the pace is judged anew after a seek, from its grace on)
   m_pace = {};
+  m_work = {};
+}
+
+void CMultiviewPacker::Paced(bool late, bool judged, double busyMs, double fps)
+{
+  if (m_slow)
+    return;
+  if (KODI::MULTIVIEW::Worked(m_work, busyMs, fps, judged))
+  {
+    m_slow = true;
+    char text[320];
+    snprintf(text, sizeof(text),
+             "the processor does not decode both views in time: it gives %.1f pictures of two "
+             "views a second of its work, measured over two windows of %u pictures in a row, and "
+             "the video has %.3f",
+             m_work.rate, KODI::MULTIVIEW::WORK_WINDOW, fps);
+    m_slowText = text;
+    Fail(m_slowText.c_str());
+    return;
+  }
+  Paced(late, judged);
 }
 
 void CMultiviewPacker::Paced(bool late, bool judged)
