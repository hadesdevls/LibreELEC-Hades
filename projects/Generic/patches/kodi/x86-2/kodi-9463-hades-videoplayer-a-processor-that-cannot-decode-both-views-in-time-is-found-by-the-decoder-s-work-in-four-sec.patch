index e22703b..6e67d75 100644
--- a/xbmc/cores/VideoPlayer/DVDCodecs/Video/DVDVideoCodecFFmpeg.cpp
+++ b/xbmc/cores/VideoPlayer/DVDCodecs/Video/DVDVideoCodecFFmpeg.cpp
@@ -940,9 +940,17 @@ int CDVDVideoCodecFFmpeg::ReceiveMultiviewFrame(int result)
       // Hades: how the playback keeps up with the pictures of two views: the player asks for
       // pictures to be dropped when it falls behind (not at another speed, nor before the target
       // of a seek), which this decoder never does (SetCodecControl())
+      // ... and, where the processor decodes them, by the work of the decoder since the picture
+      // before, which finds a processor that cannot keep up sooner (KODI::MULTIVIEW::Worked())
+      const double busyMs =
+          std::chrono::duration<double, std::milli>(std::exchange(m_multiviewBusy, {})).count();
+      const double fps = m_hints.fpsrate > 0 && m_hints.fpsscale > 0
+                             ? static_cast<double>(m_hints.fpsrate) / m_hints.fpsscale
+                             : 0.0;
       m_multiview->Paced(
           (m_codecControlFlags & DVD_CODEC_CTRL_DROP_ANY) != 0,
-          !(m_codecControlFlags & (DVD_CODEC_CTRL_NO_POSTPROC | DVD_CODEC_CTRL_DROP)));
+          !(m_codecControlFlags & (DVD_CODEC_CTRL_NO_POSTPROC | DVD_CODEC_CTRL_DROP)), busyMs,
+          m_multiviewNvdec ? 0.0 : fps);
       return 0;
     }
     if (result == AVERROR_EOF)
@@ -950,7 +958,10 @@ int CDVDVideoCodecFFmpeg::ReceiveMultiviewFrame(int result)
     // no picture could be made: the second view is given up, by the caller
     if (made == CMultiviewPacker::Result::FAILED)
       return AVERROR(EAGAIN);
+    const auto receiveStart = std::chrono::steady_clock::now();
     result = avcodec_receive_frame(m_pCodecContext, m_pDecodedFrame);
+    if (!m_multiviewNvdec)
+      m_multiviewBusy += std::chrono::steady_clock::now() - receiveStart;
   }
 }
 
@@ -1424,7 +1435,13 @@ bool CDVDVideoCodecFFmpeg::SendPacket(AVPacket* avpkt, const CDrainRestart::Info
     }
   }
 
+  // Hades: the time in the decoder of both views that the processor runs (CMultiviewPacker::Paced())
+  const bool timed = m_multiview && !m_multiviewNvdec;
+  const auto sendStart =
+      timed ? std::chrono::steady_clock::now() : std::chrono::steady_clock::time_point{};
   int ret = avcodec_send_packet(m_pCodecContext, avpkt);
+  if (timed)
+    m_multiviewBusy += std::chrono::steady_clock::now() - sendStart;
 
   // Whether Kodi sends this packet again (false below): on EAGAIN, and on a hardware decoder
   // without free surfaces.
@@ -2220,7 +2237,10 @@ CDVDVideoCodec::VCReturn CDVDVideoCodecFFmpeg::GetBasePicture(VideoPicture* pVid
     av_packet_free(&avpkt);
   }
 
+  const auto receiveStart = std::chrono::steady_clock::now();
   int ret = avcodec_receive_frame(m_pCodecContext, m_pDecodedFrame);
+  if (m_multiview && !m_multiviewNvdec)
+    m_multiviewBusy += std::chrono::steady_clock::now() - receiveStart;
 
   // Hades: the two views of an access unit come as two pictures and go on as one. A stream
   // that this cannot be done for goes back to the decoder of every other stream (not at its
diff --git a/xbmc/cores/VideoPlayer/DVDCodecs/Video/DVDVideoCodecFFmpeg.h b/xbmc/cores/VideoPlayer/DVDCodecs/Video/DVDVideoCodecFFmpeg.h
index 56d0354..c727807 100644
--- a/xbmc/cores/VideoPlayer/DVDCodecs/Video/DVDVideoCodecFFmpeg.h
+++ b/xbmc/cores/VideoPlayer/DVDCodecs/Video/DVDVideoCodecFFmpeg.h
@@ -17,6 +17,7 @@
 #include "utils/HDR10PlusVsif.h"
 #include "utils/SideData.h"
 
+#include <chrono>
 #include <map>
 #include <memory>
 #include <optional>
@@ -293,6 +294,9 @@ protected:
   //! views copied from the card (DownloadView(), m_viewDownload); FFmpeg no longer offered it
   //! (GetFormat()); it failed for this stream, which outlives Dispose() as m_multiviewFailed does
   bool m_multiviewNvdec = false;
+  //! Hades: the time spent in the decoder of both views that the processor runs since the last
+  //! picture of two views (CMultiviewPacker::Paced())
+  std::chrono::steady_clock::duration m_multiviewBusy{};
   bool m_multiviewNvdecLost = false;
