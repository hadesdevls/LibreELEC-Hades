From bbe9e1f2530f5cbbfc554711689c9219f714baca Mon Sep 17 00:00:00 2001
From: olympia <olympia@xbmc.org>
Date: Tue, 17 Nov 2026 09:02:41 +0000
Subject: [PATCH] [Video] Hold the list item while its disc playlist is chosen

Choosing a disc playlist copies the list item and marks it to force the
playlist selection, while the thumb loader may be loading it. Hold the
item for the whole choice, playing it included.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
(cherry picked from commit 68ae79d255e912a57f0b7cd58de548a2a0bd2988)
---
 xbmc/video/windows/GUIWindowVideoBase.cpp | 2 ++
 1 file changed, 2 insertions(+)

diff --git a/xbmc/video/windows/GUIWindowVideoBase.cpp b/xbmc/video/windows/GUIWindowVideoBase.cpp
index 3d18581..27e1563 100644
--- a/xbmc/video/windows/GUIWindowVideoBase.cpp
+++ b/xbmc/video/windows/GUIWindowVideoBase.cpp
@@ -1133,6 +1133,8 @@ bool CGUIWindowVideoBase::OnContextButton(int itemNumber, CONTEXT_BUTTON button)
     return OnPlayMedia(itemNumber);
   case CONTEXT_BUTTON_CHOOSE_PLAYLIST:
   {
+    const CBackgroundInfoLoader::CItemHold itemHold{m_thumbLoader, item.get()};
+
     item->SetProperty("force_playlist_selection", true);
     return OnPlayMedia(itemNumber);
   }
