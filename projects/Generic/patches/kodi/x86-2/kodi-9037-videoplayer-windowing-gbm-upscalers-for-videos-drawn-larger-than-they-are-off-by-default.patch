+
+void CWinSystemGbmGLESContext::TakeUpscaler(int method,
+                                            int asked,
+                                            KODI::UPSCALER::From from,
+                                            const VideoPicture& picture,
+                                            bool upscaled,
+                                            bool mapped,
+                                            const char* why)
+{
+  m_upscaleMethod = UpscalerUsable() ? method : 0;
+  if (asked == 0)
+    return; // (no setting asks for one: nothing to say)
+  const char* name = dvbridge_upscale_name(asked);
+  const bool hdr = picture.color_transfer == AVCOL_TRC_SMPTE2084 ||
+                   picture.color_transfer == AVCOL_TRC_ARIB_STD_B67;
+  std::string line;
+  if (!UpscalerUsable())
+    line = StringUtils::Format("Upscaler: {} ({}) is not used for the rest of this video: it failed "
+                               "or was too slow earlier in it",
+                               name ? name : "unknown", KODI::UPSCALER::FromName(from));
+  else if (!name)
+    line = StringUtils::Format("Upscaler: the settings ask for upscaler {}, which this build does "
+                               "not have ({}): Kodi's scaling",
+                               asked, KODI::UPSCALER::FromName(from));
+  else if (upscaled)
+    line = StringUtils::Format(
+        "Upscaler: {} draws this {}x{} {} video ({}), by the bridge: its luma doubled by the "
+        "upscaler's shaders, the rest of the scaling and its chroma with Lanczos 3, nothing mapped",
+        name, picture.iWidth, picture.iHeight, hdr ? "HDR" : "SDR", KODI::UPSCALER::FromName(from));
+  else if (mapped)
+    line = StringUtils::Format(
+        "Upscaler: {} draws this {}x{} HDR video ({}) with the mapping that the bridge makes of it, "
+        "where it is drawn larger than it is (its shaders run only then)",
+        name, picture.iWidth, picture.iHeight, KODI::UPSCALER::FromName(from));
+  else
+    line = StringUtils::Format("Upscaler: {} is chosen for this {}x{} video ({}) and not used: {}; "
+                               "Kodi's scaling",
+                               name, picture.iWidth, picture.iHeight,
+                               KODI::UPSCALER::FromName(from),
+                               why ? why : "the picture is not one it is drawn for");
+  if (line != m_upscaleTold)
+  {
+    CLog::Log(LOGINFO, "{}", line);
+    m_upscaleTold = line;
+  }
+  // (the cost of a new run of pictures drawn with it is counted from now)
+  if (upscaled)
+  {
+    m_upscaleStats = {};
+    m_upscaleStats.start = std::chrono::steady_clock::now();
+  }
+}
+
+void CWinSystemGbmGLESContext::DisableUpscaler(const char* reason, bool tellOnScreen)
+{
+  const int method = m_upscaleMethod.exchange(0);
+  if (m_upscaleDisabled.exchange(true))
+    return;
+  const char* name = dvbridge_upscale_name(method);
+  CLog::Log(LOGWARNING,
+            "Upscaler: {} is turned off for the rest of this video: {}. The video goes on with "
+            "Kodi's scaling (or, where the bridge maps it, without the upscaler)",
+            name && method ? name : "the upscaler", reason ? reason : "it failed");
+  if (tellOnScreen)
+    CGUIDialogKaiToast::QueueNotification(CGUIDialogKaiToast::Warning,
+                                          CGUIUtils::GetHadesString(42072, 34072),
+                                          CGUIUtils::GetHadesString(42073, 34073), 8000, false);
+}
+
+bool CWinSystemGbmGLESContext::BridgeUpscaler()
+{
+  // the upscaler of this video on the bridge, or none (OFF: every picture as before); one that cannot
+  // be loaded is turned off for the video, and the bridge is left with none
+  const int method = UpscalerUsable() ? m_upscaleMethod.load(std::memory_order_relaxed) : 0;
+  std::string why;
+  if (m_dvConvertBridge->SetUpscaler(method, why))
+    return true;
+  DisableUpscaler(StringUtils::Format("its shaders could not be loaded ({})", why).c_str());
+  m_dvConvertBridge->SetUpscaler(0, why);
+  return false;
+}
+
+int CWinSystemGbmGLESContext::RenderUpscaled(const CDVBridgeGLES::Layer& layer,
+                                             const dvbridge_plain& plain,
+                                             const CRect& source,
+                                             const CRect& dest,
+                                             unsigned int serial)
+{
+  // As a picture mapped to SDR is drawn (RenderPlainMapping()): the part of the source that Kodi
+  // shows, at the place Kodi gives it, into the window alone; drawn as it is (no mapping), with the
+  // upscaler of the video
+  if (!UpscalerUsable() || m_upscaleMethod.load(std::memory_order_relaxed) == 0)
+    return -1;
+  const DVBRIDGE::ConversionPlace place =
+      DVBRIDGE::PlaceConversion(source.x1, source.y1, source.x2, source.y2, dest.x1, dest.y1,
+                                dest.x2, dest.y2, layer.width, layer.height, m_nWidth, m_nHeight);
+  if (!place.valid)
+    return -1;
+  dvbridge_view view{};
+  view.src_x0 = place.srcX0;
+  view.src_y0 = place.srcY0;
+  view.src_x1 = place.srcX1;
+  view.src_y1 = place.srcY1;
+  view.dst_x = place.dstX;
+  view.dst_y = place.dstY;
+  view.dst_width = place.dstWidth;
+  view.dst_height = place.dstHeight;
+  GLint target = 0;
+  glGetIntegerv(GL_DRAW_FRAMEBUFFER_BINDING, &target);
+  if (target != 0)
+    return -1;
+  if (!ConversionBridge(false))
+    return -1;
+  m_dvConvertBridge->SetConversionMapping(dvbridge_hdr10_mapping{});
+  m_dvConvertBridge->SetConversionTarget(0, UseLimitedColor());
+  if (!BridgeUpscaler())
+    return -1;
+  Hdr10AdaptTimerCollect(m_upscaleStats);
+  Hdr10AdaptTimerMark(true);
+  const bool drawn =
+      m_dvConvertBridge->PreparePlain(layer, plain, view, m_nWidth, m_nHeight, serial);
+  // ... or the picture before it, drawn whole, where this one could not be (none: Kodi draws it)
+  const dvbridge_gl_rect area{place.dstX, place.dstY, place.dstWidth, place.dstHeight};
+  const bool copied =
+      m_dvConvertBridge->CopyConversion(0, m_nWidth, m_nHeight, UseLimitedColor(), &area);
+  Hdr10AdaptTimerMark(false);
+  ++(!copied ? m_upscaleStats.notMapped : drawn ? m_upscaleStats.mapped : m_upscaleStats.kept);
+  // its shaders failed on this GPU: the bridge drew the picture without them; the renderer goes on in
+  // Kodi's way from the next picture (CLinuxRendererGLES::WantsUpscale())
+  if (m_dvConvertBridge->UpscalerFailed())
+    DisableUpscaler("libplacebo could not draw its shaders on this GPU");
+  UpscaleStatsLog(false);
+  if (!copied)
+    return -1;
+  if (drawn && m_gpuPower && (serial == 0 || serial != m_gpuPowerSerial))
+  {
+    m_gpuPowerSerial = serial;
+    m_gpuPower->Drawn(GPUPOWER::Drawing::MAPPING);
+  }
+  return drawn ? 1 : 0;
+}
+
+void CWinSystemGbmGLESContext::UpscaleStatsLog(bool end)
+{
+  const auto now = std::chrono::steady_clock::now();
+  auto& s = m_upscaleStats;
+  if (s.start == std::chrono::steady_clock::time_point{})
+    s.start = now;
+  if (!end && now - s.start < std::chrono::seconds(10))
+    return;
+  const int method = m_upscaleMethod.load(std::memory_order_relaxed);
+  const char* name = dvbridge_upscale_name(method);
+  const double period = DVRefreshPeriodMs();
+  if (s.mapped || s.kept || s.notMapped)
+  {
+    // (and the passes that took the most of it, where advancedsettings.xml asks for their times:
+    // dvpasstimes)
+    std::string passes;
+    if (m_dvConvertBridge)
+      if (const auto times = m_dvConvertBridge->TakePassTimes(CDVPassTimes::LOGGED); !times.empty())
+        passes = "; passes: " + CDVPassTimes::Line(times);
+    CLog::Log(LOGINFO,
+              "DVBridge: pictures drawn with the upscaler {}, {}: {} drawn, {} shown again in place "
+              "of one that could not be, {} not drawn; GPU time {} (refresh period {:.1f} ms){}",
+              name ? name : "(none)", end ? "at the end" : "last 10 s", s.mapped, s.kept,
+              s.notMapped,
+              s.timed ? StringUtils::Format("{:.1f} ms on average, {:.1f} at most, of {} timed",
+                                            s.gpuSumMs / s.timed, s.gpuMaxMs, s.timed)
+                      : std::string("not timed (no GL_EXT_disjoint_timer_query)"),
+              period, passes);
+    // an upscaler that does not keep up with the display drops pictures: where its pictures took 85 %
+    // of a refresh or more on average, over at least 24 timed, it is turned off for the rest of the
+    // video, and the screen says so
+    if (method != 0 && period > 0 && s.timed >= 24 && s.gpuSumMs / s.timed >= 0.85 * period)
+      DisableUpscaler(StringUtils::Format("its pictures took {:.1f} ms of GPU time on average, too "
+                                          "much for a refresh of {:.1f} ms",
+                                          s.gpuSumMs / s.timed, period)
+                          .c_str(),
+                      true);
+  }
+  s = {};
+  s.start = now;
+}
