+bool CDVBridgeGLES::SetUpscaler(int method, std::string& why)
+{
+  why.clear();
+  if (method == m_upscaler.method)
+    return true; // (loaded, or none asked for and none set)
+  if (!m_conversion || !m_renderer || !m_gl)
+  {
+    why = "the bridge that draws the pictures is not set up";
+    return method == DVBRIDGE_UPSCALE_OFF;
+  }
+  // (libplacebo makes the textures of the shaders, the look-up table of RAVU among them, while it
+  // reads them: the GL state of Kodi's frame is kept)
+  const CKeptGLState kept;
+  dvbridge_render_set_upscaler(m_renderer, nullptr);
+  dvbridge_upscale_free(&m_upscaler);
+  if (method == DVBRIDGE_UPSCALE_OFF)
+    return true;
+  const std::string folder = CSpecialProtocol::TranslatePath("special://xbmc/system/hades/upscalers");
+  char text[512] = {};
+  TakeStaleGLErrors("the upscaler is loaded");
+  if (!dvbridge_upscale_load(&m_upscaler, m_gl->gpu, method, folder.c_str(), text, sizeof(text)))
+  {
+    why = text;
+    return false;
+  }
+  dvbridge_render_set_upscaler(m_renderer, &m_upscaler);
+  CLog::Log(LOGINFO, "DVBridge: upscaler {} loaded from {} ({} shader file(s))",
+            dvbridge_upscale_name(method), folder, m_upscaler.num_hooks);
+  // a picture that is asked for again is drawn again, with it
+  m_convertSerial = 0;
+  return true;
+}
