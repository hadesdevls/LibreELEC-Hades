+
+// Hades: the upscalers (UpscalerChoice.h, dvbridge_upscale.h)
+int CLinuxRendererGLES::UpscaleMethod(const VideoPicture& picture, KODI::UPSCALER::From* from) const
+{
+  namespace U = KODI::UPSCALER;
+  const auto component = CServiceBroker::GetSettingsComponent();
+  const auto settings = component ? component->GetSettings() : nullptr;
+  if (!settings)
+    return U::OFF;
+  U::Settings s;
+  s.hd = settings->GetInt(CSettings::SETTING_VIDEOPLAYER_HADESUPSCALERHD);
+  s.sd = settings->GetInt(CSettings::SETTING_VIDEOPLAYER_HADESUPSCALERSD);
+  s.anime = settings->GetInt(CSettings::SETTING_VIDEOPLAYER_HADESUPSCALERANIME);
+  return U::Choose(s, static_cast<int>(picture.iWidth), static_cast<int>(picture.iHeight),
+                   U::PlayingAnimation().load(std::memory_order_relaxed), from);
+}
+
+bool CLinuxRendererGLES::WantsUpscale(const VideoPicture& picture, const char** why) const
+{
+  if (why)
+    *why = nullptr;
+  if (UpscaleMethod(picture) == KODI::UPSCALER::OFF)
+    return false;
+  const auto* window =
+      dynamic_cast<KODI::WINDOWING::GBM::CWinSystemGbmGLESContext*>(CServiceBroker::GetWinSystem());
+  const char* no = nullptr;
+  // (the first of these that holds is the reason given)
+  if (!window || !window->UpscalerUsable())
+    no = "it failed or was too slow earlier in this video";
+  else if (WantsDVBridge(picture))
+    no = "the picture goes out as native Dolby Vision, which is rebuilt as the specification says";
+  else if (WantsDVConversion(picture))
+    no = "the picture is Dolby Vision rebuilt as HDR10 or SDR";
+  else if (WantsPlainMapping(picture) || WantsHdr10Adapt(picture))
+    no = nullptr; // (mapped by the bridge, which draws it with the upscaler: not this way)
+  else if (!KODI::UPSCALER::ShadersRun(UpscaleMethod(picture), static_cast<float>(picture.iWidth),
+                                        static_cast<float>(picture.iHeight), m_upscaleDestWidth,
+                                        m_upscaleDestHeight))
+    no = KODI::UPSCALER::NOT_LARGE_ENOUGH;
+  else if (picture.iFlags & DVP_FLAG_INTERLACED)
+    no = "the picture is interlaced";
+  else if (!picture.stereoMode.empty() && picture.stereoMode != "mono")
+    no = "the picture is 3D";
+  else if (m_videoSettings.m_Brightness != 50.0f || m_videoSettings.m_Contrast != 50.0f)
+    no = "Kodi's brightness or contrast of the video is not at its middle";
+  else if (!CanUpscale(picture))
+    no = "this renderer cannot give the bridge the planes of this picture (an 8-bit picture of the "
+         "processor, a 4:2:2 or 4:4:4 one, or a rotated one)";
+  else
+    return !(WantsPlainMapping(picture) || WantsHdr10Adapt(picture));
+  if (why)
+    *why = no;
+  return false;
+}
+
+bool CLinuxRendererGLES::WantsMappedUpscale(const VideoPicture& picture, const char** why) const
+{
+  if (why)
+    *why = nullptr;
+  const int method = UpscaleMethod(picture);
+  if (method == KODI::UPSCALER::OFF)
+    return false;
+  const auto* window =
+      dynamic_cast<KODI::WINDOWING::GBM::CWinSystemGbmGLESContext*>(CServiceBroker::GetWinSystem());
+  const char* no = nullptr;
+  if (!window || !window->UpscalerUsable())
+    no = "it failed or was too slow earlier in this video";
+  else if (!KODI::UPSCALER::ShadersRun(method, static_cast<float>(picture.iWidth),
+                                       static_cast<float>(picture.iHeight), m_upscaleDestWidth,
+                                       m_upscaleDestHeight))
+    no = KODI::UPSCALER::NOT_LARGE_ENOUGH;
+  else
+    return true;
+  if (why)
+    *why = no;
+  return false;
+}
+
+bool CLinuxRendererGLES::CanUpscale(const VideoPicture& picture) const
+{
+  // the three planes that the renderer uploads for a 10-bit 4:2:0 picture of the processor, as for
+  // Dolby Vision of the processor (DVCpuWhyNot(), without asking that it is Dolby Vision)
+  return picture.videoBuffer && picture.videoBuffer->GetFormat() == AV_PIX_FMT_YUV420P10 &&
+         picture.iWidth >= 2 && picture.iHeight >= 2 && !(picture.iWidth % 2) &&
+         !(picture.iHeight % 2) &&
+         DVBRIDGE::SourceFitsRaster(static_cast<int>(picture.iWidth),
+                                    static_cast<int>(picture.iHeight)) &&
+         m_textureTarget == GL_TEXTURE_2D && m_renderOrientation == 0;
+}
+
+void CLinuxRendererGLES::UpscaleColourOf(int idx, dvbridge_plain& plain) const
+{
+  plain = {};
+  const CPictureBuffer& buffer = m_buffers[idx];
+  plain.full_range = buffer.m_srcFullRange;
+  const AVColorTransferCharacteristic transfer = buffer.m_srcColTransfer;
+  if (transfer == AVCOL_TRC_SMPTE2084 || transfer == AVCOL_TRC_ARIB_STD_B67)
+  {
+    // an HDR picture, passed through: as RenderPlainMapping() takes it, without its HDR10+ (it is not
+    // mapped)
+    plain.hlg = transfer == AVCOL_TRC_ARIB_STD_B67;
+    if (buffer.hasDisplayMetadata && buffer.displayMetadata.has_luminance &&
+        buffer.displayMetadata.max_luminance.den && buffer.displayMetadata.min_luminance.den)
+    {
+      plain.max_luma = static_cast<float>(av_q2d(buffer.displayMetadata.max_luminance));
+      plain.min_luma = static_cast<float>(av_q2d(buffer.displayMetadata.min_luminance));
+    }
+    if (buffer.hasLightMetadata)
+    {
+      plain.max_cll = static_cast<float>(buffer.lightMetadata.MaxCLL);
+      plain.max_fall = static_cast<float>(buffer.lightMetadata.MaxFALL);
+    }
+    return;
+  }
+  // an SDR picture: its matrix as Kodi's shaders take it (CYUV2RGB shaders, SetColParams(): an
+  // unspecified one by the size of the picture) and its primaries (CConvertMatrix: unspecified is
+  // BT.709); the bridge draws it in BT.709, converting other primaries as Kodi's shaders do
+  AVColorSpace space = buffer.m_srcColSpace;
+  if (space == AVCOL_SPC_UNSPECIFIED)
+    space = m_sourceWidth > 1024 || m_sourceHeight >= 600 ? AVCOL_SPC_BT709 : AVCOL_SPC_BT470BG;
+  switch (space)
+  {
+    case AVCOL_SPC_BT470BG:
+    case AVCOL_SPC_SMPTE170M:
+    case AVCOL_SPC_SMPTE240M:
+      plain.sdr = DVBRIDGE_PLAIN_SDR_BT601;
+      break;
+    case AVCOL_SPC_BT2020_NCL:
+      plain.sdr = DVBRIDGE_PLAIN_SDR_BT2020;
+      break;
+    default:
+      plain.sdr = DVBRIDGE_PLAIN_SDR_BT709;
+      break;
+  }
+  switch (buffer.m_srcPrimaries)
+  {
+    case AVCOL_PRI_BT470BG:
+      plain.sdr_primaries = DVBRIDGE_PLAIN_PRIM_BT601_625;
+      break;
+    case AVCOL_PRI_SMPTE170M:
+    case AVCOL_PRI_SMPTE240M:
