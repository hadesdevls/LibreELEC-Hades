+  }
+}
+
+int CLinuxRendererGLES::RenderUpscaled(int idx)
+{
+  // a 10-bit 4:2:0 picture of the processor: its three planes (DVCpuPlanes() without asking that it
+  // is Dolby Vision)
+  auto* window =
+      dynamic_cast<KODI::WINDOWING::GBM::CWinSystemGbmGLESContext*>(CServiceBroker::GetWinSystem());
+  if (!window || idx < 0 || idx >= NUM_BUFFERS || m_format != AV_PIX_FMT_YUV420P10 ||
+      m_textureTarget != GL_TEXTURE_2D || m_renderOrientation != 0 || !UploadTexture(idx))
+    return -1;
+  const CPictureBuffer& buffer = m_buffers[idx];
+  if (buffer.image.bpp != 2)
+    return -1;
+  CDVBridgeGLES::Layer layer{};
+  for (int p = 0; p < 3; ++p)
+  {
+    const CYuvPlane& plane = buffer.fields[FIELD_FULL][p];
+    if (!plane.id)
+      return -1;
+    layer.planes[p] = {plane.id, static_cast<int>(plane.texwidth),
+                       static_cast<int>(plane.texheight)};
+  }
+  layer.layout = DVBRIDGE_YUV420P10;
+  layer.width = m_sourceWidth;
+  layer.height = m_sourceHeight;
+  layer.chroma = buffer.doviChroma;
+  dvbridge_plain plain{};
+  UpscaleColourOf(idx, plain);
+  return window->RenderUpscaled(layer, plain, m_sourceRect, m_destRect, buffer.doviSerial);
+}
