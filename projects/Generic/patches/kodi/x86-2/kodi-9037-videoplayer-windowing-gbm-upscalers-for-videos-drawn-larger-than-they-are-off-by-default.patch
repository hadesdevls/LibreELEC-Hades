diff --git a/xbmc/cores/VideoPlayer/VideoRenderers/UpscalerChoice.h b/xbmc/cores/VideoPlayer/VideoRenderers/UpscalerChoice.h
new file mode 100644
index 0000000..935464c
--- /dev/null
+++ b/xbmc/cores/VideoPlayer/VideoRenderers/UpscalerChoice.h
@@ -0,0 +1,161 @@
+/*
+ *  Copyright (C) 2026 Hades
+ *  This file is part of LibreELEC Hades. It is not in Kodi as Team Kodi publishes it.
+ *
+ *  SPDX-License-Identifier: GPL-2.0-or-later
+ *  See LICENSES/README.md for more information.
+ */
+
+#pragma once
+
+/*!
+ * \file UpscalerChoice.h
+ * \brief Hades: which upscaler draws a video, from the expert settings (Player > Videos):
+ *        videoplayer.hadesupscalerhd for videos of 1080p and above, videoplayer.hadesupscalersd for
+ *        smaller ones, and videoplayer.hadesupscaleranime for animation, whose "same as the others" leaves
+ *        it to the first two. All three are off by default ("Kodi's scaling"), and then nothing changes.
+ *        The upscalers themselves are dvbridge_upscale.h. Pure rules, no Kodi state: CLinuxRendererGLES
+ *        asks them with what the settings, the video and the screen say.
+ */
+
+#include <algorithm>
+#include <atomic>
+#include <cctype>
+#include <string>
+#include <vector>
+
+namespace KODI::UPSCALER
+{
+
+//! The value of videoplayer.hadesupscaleranime that leaves animation to the other two settings
+constexpr int SAME_AS_OTHERS = -1;
+//! The value of the settings that keeps Kodi's own scaling (DVBRIDGE_UPSCALE_OFF)
+constexpr int OFF = 0;
+//! The upscalers, as the settings and dvbridge_upscale.h number them (DVBRIDGE_UPSCALE_*)
+constexpr int RAVU = 1;
+constexpr int FSRCNNX8 = 2;
+constexpr int FSRCNNX16 = 3;
+
+//! A picture at least this wide or tall is "1080p and above": a 1920x800 scope film is 1080p, as is a
+//! 1440x1080 one (with some room for a few lines cropped by the encoder)
+constexpr int HD_MIN_WIDTH = 1880;
+constexpr int HD_MIN_HEIGHT = 1000;
+
+//! What the three settings hold
+struct Settings
+{
+  int hd = OFF;
+  int sd = OFF;
+  int anime = SAME_AS_OTHERS;
+};
+
+//! Which setting decided
+enum class From
+{
+  HD,
+  SD,
+  ANIME,
+};
+
+inline const char* FromName(From from)
+{
+  switch (from)
+  {
+    case From::HD:
+      return "videoplayer.hadesupscalerhd, for videos of 1080p and above";
+    case From::SD:
+      return "videoplayer.hadesupscalersd, for videos smaller than 1080p";
+    case From::ANIME:
+      return "videoplayer.hadesupscaleranime, for animation";
+  }
+  return "";
+}
+
+inline bool IsHd(int width, int height)
+{
+  return width >= HD_MIN_WIDTH || height >= HD_MIN_HEIGHT;
+}
+
+//! The method for a picture of that size (its own, in samples), animation or not, and which setting said it
+inline int Choose(const Settings& s, int width, int height, bool animation, From* from = nullptr)
+{
+  if (animation && s.anime != SAME_AS_OTHERS)
+  {
+    if (from)
+      *from = From::ANIME;
+    return s.anime;
+  }
+  const bool hd = IsHd(width, height);
+  if (from)
+    *from = hd ? From::HD : From::SD;
+  return hd ? s.hd : s.sd;
+}
+
+//! Whether the shaders of the upscaler run for a picture of that size drawn at that size: their own
+//! conditions (the //!WHEN lines of their files, which libplacebo evaluates), in width and in height.
+//! RAVU: the luma less than 0.707106 of the output (drawn more than 1.414 times its size); FSRCNNX:
+//! the output more than 1.3 times the luma. Where they would not run, the picture keeps Kodi's way.
+inline bool ShadersRun(int method, float width, float height, float dstWidth, float dstHeight)
+{
+  if (!(width > 0 && height > 0 && dstWidth > 0 && dstHeight > 0))
+    return false;
+  switch (method)
+  {
+    case RAVU:
+      return width / dstWidth < 0.707106f && height / dstHeight < 0.707106f;
+    case FSRCNNX8:
+    case FSRCNNX16:
+      return dstWidth / width > 1.3f && dstHeight / height > 1.3f;
+    default:
+      return false;
+  }
+}
+
+//! Why a picture is not drawn with the upscaler at that size (for the log)
+constexpr const char* NOT_LARGE_ENOUGH =
+    "the picture is not drawn large enough for the upscaler's shaders to run (more than 1.41 times "
+    "its size in width and height for RAVU, 1.3 times for FSRCNNX)";
+
+namespace DETAIL
+{
+inline std::string Lower(const std::string& text)
+{
+  std::string out = text;
+  std::transform(out.begin(), out.end(), out.begin(),
+                 [](unsigned char c) { return static_cast<char>(std::tolower(c)); });
+  return out;
+}
+} // namespace DETAIL
+
+//! Whether a video is animation by its genres, as the library or the add-on that plays it gives them
+//! (TMDb's "Animation" in the languages Kodi's scrapers use, and "Anime"). A genre is compared whole,
+//! without case for the Latin ones.
+inline bool IsAnimation(const std::vector<std::string>& genres)
+{
+  static const char* const names[] = {
+      "animation", "anime", "animación", "animacion", "animação", "animacao", "animazione",
+      "animatie", "animacja", "animace", "animasyon", "animaatio", "animering", "animasjon",
+      "анимация", "мультфильм", "アニメ", "アニメーション", "动画", "動畫", "애니메이션"};
+  for (const auto& genre : genres)
+  {
+    // (spaces around a genre, as some add-ons give them)
+    const auto first = genre.find_first_not_of(" \t");
+    const auto last = genre.find_last_not_of(" \t");
+    if (first == std::string::npos)
+      continue;
+    const std::string g = DETAIL::Lower(genre.substr(first, last - first + 1));
+    for (const char* name : names)
+      if (g == name)
+        return true;
+  }
+  return false;
+}
+
+//! The file that plays is animation, by its genres (CVideoPlayer::OpenFile(), IsAnimation()); any thread
+inline std::atomic<bool>& PlayingAnimation()
+{
+  static std::atomic<bool> playing{false};
+  return playing;
+}
+
+} // namespace KODI::UPSCALER
