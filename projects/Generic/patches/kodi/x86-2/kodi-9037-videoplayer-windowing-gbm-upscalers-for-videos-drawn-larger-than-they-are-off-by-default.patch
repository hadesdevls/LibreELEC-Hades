+bool CRendererVAAPIGLES::CanUpscale(const VideoPicture& picture) const
+{
+  const auto* pic = dynamic_cast<const CVaapiRenderPicture*>(picture.videoBuffer);
+  if (!pic || pic->procPic.videoSurface == VA_INVALID_ID || m_textureTarget != GL_TEXTURE_2D ||
+      m_renderOrientation != 0 || picture.iWidth < 1 || picture.iHeight < 1 ||
+      !DVBRIDGE::SourceFitsRaster(static_cast<int>(picture.iWidth),
+                                  static_cast<int>(picture.iHeight)))
+    return false;
+  switch (pic->procPic.fourcc)
+  {
+    case VA_FOURCC_NV12:
+    case VA_FOURCC_P010:
+    case VA_FOURCC_P012:
+    case VA_FOURCC_P016:
+      return true;
+    default:
+      return false;
+  }
+}
