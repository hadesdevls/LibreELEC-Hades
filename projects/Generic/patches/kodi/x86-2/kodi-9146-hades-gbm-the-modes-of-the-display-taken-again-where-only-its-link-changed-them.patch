From 7ee7d9696a439874895f68df7604fe6024c456e9 Mon Sep 17 00:00:00 2001
From: Hades <15710513+hadesdevls@users.noreply.github.com>
Date: Thu, 19 Nov 2026 08:38:00 +0000
Subject: [PATCH] [Hades][GBM] The modes of the display taken again where only
 its link changed them

Kodi reads the modes of the display in use again after a hot-plug event (ModeListRefresh.h), but did
nothing where the EDID was the same. nvidia-drm offers the modes that the HDMI link it assessed
carries, and that assessment can change with the same EDID: a Samsung Odyssey G60SD
woke up as the PC started, NVIDIA's assessment of its FRL link found none ("no FRL: the
assessment of the link found none" in the kernel log), so its modes of more than 600 MHz (2560x1440
at 240 and 360 Hz, 1920x1080 at 240 and 360 Hz) were not offered and Kodi started its menus at 120
Hz. A hot-plug event 16 s later assessed the link again ("FRL up to 4 lanes at 10 Gb/s") and the
kernel offered those modes, but Kodi kept the list of its start, with no 360 Hz to choose, until a
restart of the interface.

- The same EDID with other modes is taken as other modes (MODELIST::Of()): the resolutions are made
  again of them, and the menus go to the mode a start takes with them (the 360 Hz of the settings, or
  of that display: DisplayModeMemory.h). The same EDID with the same modes: nothing, as before.
- kodi.log says when the modes changed with the same EDID.

Checked: the host test (modelist_test.cpp: the case of the G60SD with the timings of its kernel log,
and the rule changed) with a mutant that puts the rule before back; the changed files and the
sources that include them compile with the commands of the image's build. Not run on a GPU.
---
 xbmc/windowing/gbm/ModeListRefresh.h | 15 ++++++++++----
 xbmc/windowing/gbm/WinSystemGbm.cpp  | 31 ++++++++++++++++------------
 2 files changed, 29 insertions(+), 17 deletions(-)

diff --git a/xbmc/windowing/gbm/ModeListRefresh.h b/xbmc/windowing/gbm/ModeListRefresh.h
index c1448bb..903bda9 100644
--- a/xbmc/windowing/gbm/ModeListRefresh.h
+++ b/xbmc/windowing/gbm/ModeListRefresh.h
@@ -44,7 +44,12 @@ namespace GBM
  *   open, nothing is calibrated, no slideshow and no 3D. Without such an event nothing is done
  *   at all (WhenToLook());
  * - the display is probed then, as when a video starts after such an event (CDisplayLook). Not
- *   connected, no EDID that can be read, or the same EDID: nothing is done (Of());
+ *   connected, or no EDID that can be read: nothing is done (Of()). The same EDID with the same
+ *   modes: nothing either. The same EDID does not mean the same modes: nvidia-drm offers the modes
+ *   that the link it assessed carries, and a display whose HDMI FRL link could not be assessed
+ *   when the driver found it (a monitor that wakes up as the PC starts) has its modes of more than
+ *   600 MHz (2560x1440 at 240 and 360 Hz on a Samsung Odyssey G60SD) only from the hot-plug event
+ *   that assesses it again, with the same EDID. Those modes are taken as any other (OTHER_MODES);
  * - another EDID with the same modes in the same places, the same one preferred: nothing is
  *   done either (SameList()): a start would make the same choices;
  * - other modes: the resolutions are made again of them, and every choice is the one a start
@@ -144,7 +149,7 @@ enum class Found
 {
   NOT_CONNECTED, //!< nothing is connected to the output now: the resolutions stay
   NO_EDID, //!< no EDID that can be read (a display that wakes up): the resolutions stay
-  SAME_EDID, //!< the EDID that the resolutions were made with: nothing is done
+  SAME_EDID, //!< the EDID and the modes that the resolutions were made with: nothing is done
   SAME_MODES, //!< another EDID, with the same modes (SameList()): nothing is done
   OTHER_MODES, //!< other modes: MakePlan()
 };
@@ -153,7 +158,8 @@ enum class Found
  * \param connected the display is connected
  * \param edidRead an EDID was read
  * \param sameEdid it is the one the resolutions were made with (the bytes are the same)
- * \param sameModes the display has the modes that the resolutions were made of (SameList())
+ * \param sameModes the display has the modes that the resolutions were made of (SameList()), with
+ *        whichever EDID
  */
 inline Found Of(bool connected, bool edidRead, bool sameEdid, bool sameModes)
 {
@@ -161,7 +167,8 @@ inline Found Of(bool connected, bool edidRead, bool sameEdid, bool sameModes)
     return Found::NOT_CONNECTED;
   if (!edidRead)
     return Found::NO_EDID;
-  if (sameEdid)
+  // (the same EDID with other modes: the driver assessed the link again, OTHER_MODES below)
+  if (sameEdid && sameModes)
     return Found::SAME_EDID;
   return sameModes ? Found::SAME_MODES : Found::OTHER_MODES;
 }
diff --git a/xbmc/windowing/gbm/WinSystemGbm.cpp b/xbmc/windowing/gbm/WinSystemGbm.cpp
index bc5a2c7..810a7f3 100644
--- a/xbmc/windowing/gbm/WinSystemGbm.cpp
+++ b/xbmc/windowing/gbm/WinSystemGbm.cpp
@@ -3224,9 +3224,11 @@ void CWinSystemGbm::RefreshModes()
   const std::vector<drmModeModeInfo> before = drm->GetConnectorModes();
   // (the bytes are compared: the kernel can give a new EDID the id of an earlier one)
   const bool sameEdid = !edid.empty() && edid == m_modesEdid;
+  // (the modes are compared with the same EDID too: nvidia-drm offers the modes of the HDMI FRL link
+  // it assessed, which a hot-plug event may assess again with the same EDID)
   const MODELIST::Found found =
       MODELIST::Of(connected, !edid.empty(), sameEdid,
-                   connected && !edid.empty() && !sameEdid && MODELIST::SameList(before, now));
+                   connected && !edid.empty() && MODELIST::SameList(before, now));
   if (found != MODELIST::Found::OTHER_MODES)
   {
     drmModeFreeConnector(probed);
@@ -3247,8 +3249,8 @@ void CWinSystemGbm::RefreshModes()
         break;
       case MODELIST::Found::SAME_EDID:
         CLog::Log(LOGDEBUG,
-                  "Modes: after a hot-plug event the display of {} has the EDID that the "
-                  "resolutions were made with: nothing is done",
+                  "Modes: after a hot-plug event the display of {} has the EDID and the modes "
+                  "that the resolutions were made with: nothing is done",
                   output);
         break;
       default:
@@ -3264,6 +3266,9 @@ void CWinSystemGbm::RefreshModes()
 
   // What a start would do with the new list (ModeListRefresh.h)
   const MODELIST::Plan plan = MODELIST::MakePlan(before, now);
+  // (for the log: other modes with the same EDID come of the link, which the driver assessed again)
+  const char* sameEdidNote =
+      sameEdid ? " with the same EDID (the driver offers the modes of the link it found)" : "";
   if (plan.kind == MODELIST::Plan::Kind::SAME)
   {
     drmModeFreeConnector(probed);
@@ -3340,12 +3345,12 @@ void CWinSystemGbm::RefreshModes()
     if (current != gfxBefore)
       GetGfxContext().ApplyModeChange(current);
     CLog::Log(LOGINFO,
-              "Modes: the display of {} has other modes ({} -> {}): the resolutions are made again "
-              "of them, as a start makes them. The interface stays in {}, the resolution a start "
-              "sets ({}; resolution {} -> {}); the desktop resolution is {}, the mode the display "
-              "prefers",
-              output, before.size(), now.size(), ModeText(currentNow), chosenAs, gfxBefore,
-              current, ModeText(desktopNow));
+              "Modes: the display of {} has other modes ({} -> {}){}: the resolutions are made "
+              "again of them, as a start makes them. The interface stays in {}, the resolution a "
+              "start sets ({}; resolution {} -> {}); the desktop resolution is {}, the mode the "
+              "display prefers",
+              output, before.size(), now.size(), sameEdidNote, ModeText(currentNow), chosenAs,
+              gfxBefore, current, ModeText(desktopNow));
     CGUIDialogKaiToast::QueueNotification(
         CGUIDialogKaiToast::Info,
         CServiceBroker::GetResourcesComponent().GetLocalizeStrings().Get(14220),
@@ -3355,10 +3360,10 @@ void CWinSystemGbm::RefreshModes()
 
   // The interface is set in the resolution a start sets
   CLog::Log(LOGINFO,
-            "Modes: the display of {} has other modes ({} -> {}): the resolutions are made again "
-            "of them, as a start makes them. The interface is set in {}, the resolution a start "
-            "sets ({}), from {}; the desktop resolution is {}, the mode the display prefers",
-            output, before.size(), now.size(), ModeText(currentNow), chosenAs,
+            "Modes: the display of {} has other modes ({} -> {}){}: the resolutions are made "
+            "again of them, as a start makes them. The interface is set in {}, the resolution a "
+            "start sets ({}), from {}; the desktop resolution is {}, the mode the display prefers",
+            output, before.size(), now.size(), sameEdidNote, ModeText(currentNow), chosenAs,
             ModeText(screenInfo), ModeText(desktopNow));
   GetGfxContext().SetVideoResolution(current, true);
   if (drm->LastCommitRefused())
