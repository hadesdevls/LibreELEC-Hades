From 88bc19dff3dce7473a607e5a634af59180e14c24 Mon Sep 17 00:00:00 2001
From: Hades <15710513+hadesdevls@users.noreply.github.com>
Date: Thu, 26 Nov 2026 18:35:09 +0000
Subject: [PATCH] [Hades][dvbridge] The IPT tunnel holds the scale of its
 12-bit codes as a constant

Pass 9 reads the scale of the codes (2^12: the tunnel is made only from
pictures of 12 bits) from a uniform, so the GPU had to load it and work
out its reciprocal in every invocation (on RDNA2 a v_rcp_f32, a quarter
rate operation, four times in an invocation of 9c). It is now a
constant of the shaders, 4096.0, whose reciprocal the compiler folds:
the same two powers of 2, the same arithmetic, the same bytes.

dvbridge_source_to_ipt() now refuses a picture whose codes are not of
12 bits itself, where before only dvbridge_source_ipt_setup() did.

Measured, the same bytes: the 14 pictures of the profile 7 FEL stream
by both forms of pass 9 and three with the GUI over them (62 files).
radeonsi (ACO, gfx1030), 9c: the four reciprocals and their loads gone,
680 vector instructions to 676.
---
 tools/dvbridge/dvbridge_source.c | 13 ++++++-------
 1 file changed, 6 insertions(+), 7 deletions(-)

diff --git a/tools/dvbridge/dvbridge_source.c b/tools/dvbridge/dvbridge_source.c
index 4b6a684..80c8526 100644
--- a/tools/dvbridge/dvbridge_source.c
+++ b/tools/dvbridge/dvbridge_source.c
@@ -1721,7 +1721,7 @@ struct common_uniforms {
     "precision highp int;\n"                                                                      \
     "uniform highp sampler2D luma_plane;\n"                                                       \
     "uniform highp usampler2D chroma_rows;\n" /* pass 2: the YCbCr rows of 4:2:2 */               \
-    "uniform float code_scale;\n"                                                                 \
+    "const float code_scale = 4096.0;\n" /* (12-bit codes only, dvbridge_source_to_ipt()) */      \
     "uniform mat3 ycc_src, to_lms, to_ipt;\n"                                                     \
     "uniform vec3 off_src;\n"                                                                     \
     "uniform ivec4 active_box;\n" /* x0, y0, x1, y1 of the active picture, in the picture */          \
@@ -2085,7 +2085,7 @@ struct dvbridge_source_packer {
      * those (rows_ipt: set by it, cleared by dvbridge_source_rows() and dvbridge_source_scale()) */
     GLuint ipt_luma_program, ipt_rows_program;
     struct ipt_uniforms {
-        GLint luma, rows, code_scale, ycc_src, to_lms, to_ipt, off_src, active, pairs, eotf, oetf;
+        GLint luma, rows, ycc_src, to_lms, to_ipt, off_src, active, pairs, eotf, oetf;
     } il, ir;
     GLint ir_rows;
     struct texture ipt_luma, ipt_rows;
@@ -2502,8 +2502,8 @@ static struct dvbridge_source_packer *create_packer(bool allow_quad)
     }
     /* Hades: pass 9; without it the pictures go out as composed */
     {
-        static const char *const ipt[] = {"luma_plane", "chroma_rows", "code_scale", "ycc_src",
-                                          "to_lms", "to_ipt", "off_src", "active_box", "pairs",
+        static const char *const ipt[] = {"luma_plane", "chroma_rows", "ycc_src", "to_lms",
+                                          "to_ipt", "off_src", "active_box", "pairs",
                                           "eotf_table", "oetf_table"};
         _Static_assert(sizeof(p->il) == COUNT(ipt) * sizeof(GLint), "ipt uniforms");
         /* (Hades: only where the filter is the one whose weights its shaders hold, IPT_HPOS and
@@ -3198,8 +3198,8 @@ bool dvbridge_source_to_ipt(struct dvbridge_source_packer *p,
 {
     if (ipt_luma)
         *ipt_luma = 0;
-    if (!picture_fits(p, src, width, height, x, y, margins) || !luma || !ipt_luma ||
-        !dvbridge_source_can_ipt(p) || !rows_of(p, width, height, x, y, margins) ||
+    if (!picture_fits(p, src, width, height, x, y, margins) || src->bits != 12 || !luma ||
+        !ipt_luma || !dvbridge_source_can_ipt(p) || !rows_of(p, width, height, x, y, margins) ||
         p->rows_ipt)
         return false;
     /* the active picture in the picture, and its pairs (those whose even pixel is in it, as pass 2) */
@@ -3253,7 +3253,6 @@ bool dvbridge_source_to_ipt(struct dvbridge_source_packer *p,
             bind(p, 1, p->chroma.texture);
             glUniform1i(u->luma, 0);
             glUniform1i(u->rows, 1);
-            glUniform1f(u->code_scale, (float)(1 << src->bits));
             set_matrix(u->ycc_src, src->ycc_forward);
             set_matrix(u->to_lms, to_lmsf);
             set_matrix(u->to_ipt, to_iptf);
