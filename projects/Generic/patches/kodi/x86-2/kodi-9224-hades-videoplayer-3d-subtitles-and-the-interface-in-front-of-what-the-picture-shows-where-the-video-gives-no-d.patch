+void CRenderManager::StereoDepthFrame()
+{
+  using namespace KODI::STEREODEPTH;
+
+  auto& gfx = CServiceBroker::GetWinSystem()->GetGfxContext();
+  if (!m_pRenderer)
+  {
+    gfx.SetGuiDepthOverVideo(0.0f);
+    return;
+  }
+
+  const auto settings = CServiceBroker::GetSettingsComponent()->GetSettings();
+  CStereoDepthMeter::Facts facts;
+  facts.automatic = settings->GetInt(CSettings::SETTING_SUBTITLES_HADESSTEREODEPTH) ==
+                    CSettings::HADES_STEREO_DEPTH_AUTOMATIC;
+  facts.fixedPixels = settings->GetInt(CSettings::SETTING_SUBTITLES_STEREOSCOPICDEPTH);
+  facts.mode = gfx.GetStereoMode();
+  facts.stereoVideo = !m_picture.stereoMode.empty() && m_picture.stereoMode != "mono";
+  // the video of a renderer that composites the interface over it (HDR) is drawn once, under the
+  // interface, not in each eye's pass: there is no eye of it to copy
+  facts.drawnInGuiPass = m_pRenderer->IsGuiLayer();
+  facts.fullscreen = gfx.IsFullScreenVideo();
+  facts.discDepth = m_playerPort->SubtitleDepthFromDisc();
+  facts.discOffset = m_playerPort->GetSubtitlePlaneOffset(m_Queue[m_presentsource].pts);
+  CRect src;
+  CRect dst;
+  CRect view;
+  m_pRenderer->GetVideoRect(src, dst, view);
+  facts.sourceWidth = src.Width();
+  facts.destWidth = dst.Width();
+  const OVERLAY::CRenderer::SubtitleEvent subtitles = m_overlays.GetSubtitleEvent();
+  facts.subtitleVisible = subtitles.visible;
+  facts.subtitleEvent = subtitles.event;
+  facts.subtitleArea = subtitles.area;
+  facts.guiShown = gfx.GuiOverVideo();
+
+  const CStereoDepthMeter::Depths depths = m_stereoDepth.Frame(facts);
+  m_overlays.SetMeasuredSubtitleDepth(depths.subtitles);
+  gfx.SetGuiDepthOverVideo(depths.guiPixels);
 }
 
