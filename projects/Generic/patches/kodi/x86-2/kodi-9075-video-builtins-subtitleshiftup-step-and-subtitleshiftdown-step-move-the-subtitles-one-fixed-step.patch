diff --git a/xbmc/video/SubtitleShiftStep.h b/xbmc/video/SubtitleShiftStep.h
new file mode 100644
index 0000000..3f8e442
--- /dev/null
+++ b/xbmc/video/SubtitleShiftStep.h
@@ -0,0 +1,66 @@
+/*
+ *  Copyright (C) 2026 Hades
+ *  This file is part of LibreELEC Hades. It is not in Kodi as Team Kodi publishes it.
+ *
+ *  SPDX-License-Identifier: GPL-2.0-or-later
+ *  See LICENSES/README.md for more information.
+ */
+
+#pragma once
+
+#include <algorithm>
+#include <cctype>
+#include <string>
+#include <string_view>
+
+/*!
+ * \brief Hades: the options of the built-ins SubtitleShiftUp() and SubtitleShiftDown()
+ *
+ * A press of a key bound to the action subtitleshiftup moves the subtitles by the distance of a
+ * moving speed (CPlayerController, UTILS::MOVING_SPEED): one pixel for a single press, faster only
+ * while the key repeats. A remote that sends single presses (a TV remote over CEC, a phone app, a
+ * menu entry) then needs hundreds of presses to move a line of text. With "step" each call moves
+ * the subtitles one fixed step, a thirty-second of the height of the interface (33 pixels at 1080
+ * lines), so a few presses move them above a 2.39:1 picture's bar on a 16:9 screen. "save" keeps
+ * the position for every video, as before. The options can be given in either order, with any case,
+ * as a key map gives them: SubtitleShiftUp(step), SubtitleShiftUp(step,save).
+ * (The idea of a fixed step is CorentinB's, in another build.)
+ */
+namespace KODI::VIDEO::SUBTITLE_SHIFT
+{
+//! the step is the height of the interface divided by this
+constexpr int STEP_DIVISOR = 32;
+
+struct Options
+{
+  bool save = false; //!< keep the position for every video
+  bool step = false; //!< move one fixed step
+};
+
+//! the options from the text of the action: the parameters of the built-in, joined by commas
+inline Options Parse(std::string_view text)
+{
+  Options options;
+  while (!text.empty())
+  {
+    const size_t comma = text.find(',');
+    std::string word(text.substr(0, comma));
+    text = comma == std::string_view::npos ? std::string_view() : text.substr(comma + 1);
+    word.erase(0, word.find_first_not_of(" \t"));
+    word.erase(word.find_last_not_of(" \t") + 1);
+    std::transform(word.begin(), word.end(), word.begin(),
+                   [](unsigned char c) { return static_cast<char>(std::tolower(c)); });
+    if (word == "save")
+      options.save = true;
+    else if (word == "step")
+      options.step = true;
+  }
+  return options;
+}
+
+//! pixels of one step, for an interface this many lines high (at least one)
+constexpr int StepPixels(int guiHeight)
+{
+  return std::max(1, guiHeight / STEP_DIVISOR);
+}
+} // namespace KODI::VIDEO::SUBTITLE_SHIFT
