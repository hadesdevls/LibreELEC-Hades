diff --git a/xbmc/rendering/capture/VideoFrameCapture.h b/xbmc/rendering/capture/VideoFrameCapture.h
new file mode 100644
index 0000000..a78f3c8
--- /dev/null
+++ b/xbmc/rendering/capture/VideoFrameCapture.h
@@ -0,0 +1,135 @@
+/*
+ *  Copyright (C) 2026 Hades
+ *  This file is part of LibreELEC Hades. It is not in Kodi as Team Kodi publishes it.
+ *
+ *  SPDX-License-Identifier: GPL-2.0-or-later
+ *  See LICENSES/README.md for more information.
+ */
+
+#pragma once
+
+// Hades: the frame of the video alone (issue #30): the picture of the film as Kodi draws it for the
+// display, without the menus, the OSD, the player information or subtitles, at the video's own size,
+// saved as videoNNNNN.png (CScreenShot::TakeVideoFrame()) to compare pictures or to attach to a
+// report. Its own size is that of the part of the picture that Kodi shows (the source rectangle of
+// the renderer: the whole picture in the usual view, one eye of a 3D video): one pixel of the
+// picture to one pixel of the capture.
+//
+// Where it comes from (Decide(), on the thread that draws, right after the picture is presented,
+// before anything is drawn over it: CRenderManager::ServiceVideoFrame()):
+//   RENDERER  Kodi's own renderer drew it: the renderer gives it at its own size, the picture before
+//             its scaler (CLinuxRendererGLES::CaptureVideoOwnSize()); also where it is shown larger,
+//             smaller, zoomed past the screen or stretched;
+//   READ      it is drawn at its own size, at a whole pixel, all of it on the screen: read where it is
+//             drawn, as it is (the way of the bridge, native Dolby Vision's picture before it is
+//             packed);
+//   AS_SHOWN  a way that draws only into the window drew it at another size, all of it on the screen
+//             and in its own proportions: read at the size it is shown, and said so;
+//   NONE      nothing can be read that is the picture: nothing is saved, and kodi.log says why (why).
+
+#include <algorithm>
+#include <cmath>
+
+namespace KODI
+{
+namespace RENDERING
+{
+namespace CAPTURE
+{
+namespace VIDEOFRAME
+{
+
+enum class Way
+{
+  RENDERER,
+  READ,
+  AS_SHOWN,
+  NONE,
+};
+
+struct Decision
+{
+  Way way{Way::NONE};
+  //! the size of the capture: the video's own, or (AS_SHOWN) the one it is shown at
+  unsigned int width{0};
+  unsigned int height{0};
+  //! AS_SHOWN and NONE: why not at its own size (for kodi.log)
+  const char* why{nullptr};
+};
+
+//! the part of the picture that is shown (srcW x srcH, the renderer's source rectangle), where it is
+//! drawn (the destination rectangle, in pixels of the output, which may reach past it), the size of
+//! the output, and whether the renderer itself can give the picture at its own size
+inline Decision Decide(float srcW,
+                       float srcH,
+                       float x1,
+                       float y1,
+                       float x2,
+                       float y2,
+                       int outWidth,
+                       int outHeight,
+                       bool renderer)
+{
+  Decision d;
+  const long width = std::lround(srcW);
+  const long height = std::lround(srcH);
+  if (width < 2 || height < 2)
+  {
+    d.why = "no picture is shown";
+    return d;
+  }
+  d.width = static_cast<unsigned int>(width);
+  d.height = static_cast<unsigned int>(height);
+  if (renderer)
+  {
+    d.way = Way::RENDERER;
+    return d;
+  }
+  const auto whole = [](float v) { return std::abs(v - std::round(v)) < 0.01f; };
+  const bool onScreen = x1 > -0.01f && y1 > -0.01f && x2 < static_cast<float>(outWidth) + 0.01f &&
+                        y2 < static_cast<float>(outHeight) + 0.01f;
+  if (!onScreen)
+  {
+    d.why = "the picture is zoomed past the edges of the screen";
+    return d;
+  }
+  // drawn at its own size: one pixel of the picture on one of the output, at a whole pixel (a
+  // picture drawn a fraction of a pixel off, or a fraction larger, is resampled)
+  const float w = x2 - x1;
+  const float h = y2 - y1;
+  if (std::abs(w - static_cast<float>(width)) < 0.01f &&
+      std::abs(h - static_cast<float>(height)) < 0.01f && whole(x1) && whole(y1))
+  {
+    d.way = Way::READ;
+    return d;
+  }
+  // shown at another size in its own proportions: read as it is shown (the region the capture
+  // reads, in whole pixels as CCaptureBlit takes it)
+  const float wide = w * static_cast<float>(height);
+  const float tall = h * static_cast<float>(width);
+  if (std::abs(wide - tall) > 0.01f * std::max(wide, tall))
+  {
+    d.why = "the picture is shown stretched or squeezed (a view mode, or the half of a 3D output)";
+    return d;
+  }
+  const long shownWidth = std::lround(x2) - std::lround(x1);
+  const long shownHeight = std::lround(y2) - std::lround(y1);
+  if (shownWidth < 2 || shownHeight < 2)
+  {
+    d.why = "no picture is shown";
+    return d;
+  }
+  d.way = Way::AS_SHOWN;
+  d.width = static_cast<unsigned int>(shownWidth);
+  d.height = static_cast<unsigned int>(shownHeight);
+  d.why = "the way that draws this video draws it only at the size it is shown";
+  return d;
+}
+
+//! the name of the frames of the video in the screenshot folder (CUtil::GetNextFilename())
+constexpr const char* FILE_PATTERN = "video{:05}.png";
+
+} // namespace VIDEOFRAME
+} // namespace CAPTURE
+} // namespace RENDERING
+} // namespace KODI
