+// Hades: the frame of the video at its own size (VideoFrameCapture.h): the picture presented last, where
+// these shaders drew it whole (Render()), not rotated
+bool CLinuxRendererGLES::CanCaptureVideoOwnSize() const
+{
+  if (m_ownDrawn < 0 || m_ownDrawn != m_iYUVRenderBuffer || m_renderOrientation != 0)
+    return false;
+  return m_ownDrawnMultiPass ? m_fbo.fbo.IsValid() && m_fbo.width >= 1.0f && m_fbo.height >= 1.0f
+                             : m_pYUVProgShader != nullptr;
+}
+
+bool CLinuxRendererGLES::CaptureVideoOwnSize(KODI::RENDERING::CAPTURE::CaptureResult& result,
+                                             std::string& how)
+{
+  using namespace KODI::RENDERING::CAPTURE;
+  if (!CanCaptureVideoOwnSize())
+    return false;
+
+  ReadbackBuffer buffer;
+  if (m_ownDrawnMultiPass)
+  {
+    // drawn in two passes: the first one drew the picture at its own size (the part of it that is
+    // shown, from its corner: RenderToFBO()), which the second one scales to the screen with the
+    // display's 3D LUT and the dither of the window, where they are on
+    if (!ReadTextureCorner(m_fbo.fbo.Texture(), static_cast<unsigned int>(std::lround(m_fbo.width)),
+                           static_cast<unsigned int>(std::lround(m_fbo.height)), buffer))
+      return false;
+    how = "the picture of Kodi's renderer before its scaler (the first of its two passes)";
+  }
+  else
+  {
+    // drawn in one pass: drawn again, the same picture with the same shader, into a picture of its
+    // own size, one pixel of the picture to one (the display's 3D LUT left out, as a picture drawn
+    // anywhere but into the window takes none: Lut3dTake() sets it again for the next frame)
+    const unsigned int width = static_cast<unsigned int>(std::lround(m_sourceRect.Width()));
+    const unsigned int height = static_cast<unsigned int>(std::lround(m_sourceRect.Height()));
+    const bool deep = CServiceBroker::GetWinSystem()->GetOutputBitDepth() > 8;
+    const int index = m_ownDrawn;
+    const auto draw = [&]()
+    {
+      glMatrixModview.Push();
+      glMatrixModview->LoadIdentity();
+      glMatrixModview.Load();
+      glMatrixProject.Push();
+      glMatrixProject->LoadIdentity();
+      glMatrixProject->Ortho2D(0, static_cast<float>(width), 0, static_cast<float>(height));
+      glMatrixProject.Load();
+      // (the top of the picture at y = 0: the first row of the framebuffer, read first)
+      saveRotatedCoords();
+      m_rotatedDestCoords[0] = CPoint(0.0f, 0.0f);
+      m_rotatedDestCoords[1] = CPoint(static_cast<float>(width), 0.0f);
+      m_rotatedDestCoords[2] = CPoint(static_cast<float>(width), static_cast<float>(height));
+      m_rotatedDestCoords[3] = CPoint(0.0f, static_cast<float>(height));
+#ifdef HAVE_DVBRIDGE
+      m_lut3d.SetSignal(!m_fullRange, false);
+#endif
+      m_pYUVProgShader->SetAlpha(1.0f);
+      RenderSinglePass(index, FIELD_FULL);
+#ifdef HAVE_DVBRIDGE
+      m_lut3d.SetSignal(!m_fullRange, m_lut3dShaders && m_lut3d.Valid());
+#endif
+      restoreRotatedCoords();
+      glMatrixProject.PopLoad();
+      glMatrixModview.PopLoad();
+      return true;
+    };
+    if (!DrawOwnSize(width, height, deep, draw, buffer))
+      return false;
+    how =
+        StringUtils::Format("drawn again at its own size by Kodi's renderer, with the shader that "
+                            "drew it ({} bits)",
+                            deep ? 10 : 8);
+  }
+
+  result.pixels = std::make_shared<CHeapCapturePixels>(std::move(buffer.pixels));
+  result.width = buffer.width;
+  result.height = buffer.height;
+  result.stride = buffer.stride;
+  result.format = buffer.format;
+  return true;
+}
