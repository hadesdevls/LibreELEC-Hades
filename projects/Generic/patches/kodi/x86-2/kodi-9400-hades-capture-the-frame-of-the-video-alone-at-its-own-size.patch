+void CRenderManager::ServiceVideoFrame(KODI::RENDERING::CAPTURE::CaptureResult& result)
+{
+  using namespace KODI::RENDERING::CAPTURE;
+  namespace VF = VIDEOFRAME;
+
+  const auto start = std::chrono::steady_clock::now();
+  result.content = CaptureContent::VIDEO;
+  CWinSystemBase& winSystem = *CServiceBroker::GetWinSystem();
+  const CGraphicContext& gfx = winSystem.GetGfxContext();
+  std::string how;
+  bool captured = false;
+
+  if (m_pRenderer->VideoBypassesFramebuffer())
+  {
+    // the video goes to the display on a plane of its own, never into the framebuffer: the renderer
+    // draws its decoded picture at its own size, tagged as the video is coded (CaptureVideoFrame())
+    CaptureSpec own;
+    own.content = CaptureContent::VIDEO;
+    own.format = CaptureFormat::NATIVE;
+    captured = m_pRenderer->CaptureVideoFrame(own, result);
+    if (captured)
+    {
+      result.videoOwnSize = true;
+      how = "the decoded picture, drawn at its own size from the plane that shows it";
+    }
+    else
+      result.videoWhyNot = "the video goes to the display on a plane of its own, and this way of "
+                           "showing it gives no picture to read";
+  }
+  else
+  {
+    CRect src;
+    CRect dst;
+    CRect view;
+    m_pRenderer->GetVideoRect(src, dst, view);
+    // (a picture of its own for what is presented, native Dolby Vision's: read there, never drawn)
+    const bool separate = winSystem.HasCaptureFramebuffer();
+    VF::Decision d =
+        VF::Decide(src.Width(), src.Height(), dst.x1, dst.y1, dst.x2, dst.y2, gfx.GetWidth(),
+                   gfx.GetHeight(), !separate && m_pRenderer->CanCaptureVideoOwnSize());
+    if (d.way == VF::Way::RENDERER)
+    {
+      captured = m_pRenderer->CaptureVideoOwnSize(result, how);
+      result.videoOwnSize = captured;
+      // (the renderer could not: where it is drawn, as for any other way)
+      if (!captured)
+        d = VF::Decide(src.Width(), src.Height(), dst.x1, dst.y1, dst.x2, dst.y2, gfx.GetWidth(),
+                       gfx.GetHeight(), false);
+    }
+    if (!captured && (d.way == VF::Way::READ || d.way == VF::Way::AS_SHOWN))
+    {
+      CRect visible{dst};
+      visible.Intersect(CRect(0.0f, 0.0f, static_cast<float>(gfx.GetWidth()),
+                              static_cast<float>(gfx.GetHeight())));
+      if (!m_captureBlit)
+        m_captureBlit = std::make_unique<CCaptureBlit>();
+      // (at the size of the region read: no scaling)
+      captured = m_captureBlit->Blit(visible, d.width, d.height, CaptureFormat::NATIVE) &&
+                 m_captureBlit->Read(result);
+      if (captured)
+      {
+        result.videoOwnSize = d.way == VF::Way::READ;
+        if (d.way == VF::Way::AS_SHOWN)
+          how = StringUtils::Format("read at the size it is shown, not its own ({}x{}): {}",
+                                    std::lround(src.Width()), std::lround(src.Height()), d.why);
+        else if (separate)
+          how = "read at its own size from the picture of the output before it is packed for the "
+                "link";
+        else
+          how = "read at its own size where it is drawn for the display (with the display's 3D "
+                "LUT where one is applied)";
+      }
+      else
+        result.videoWhyNot = "the picture could not be read where it is drawn";
+    }
+    else if (!captured)
+      result.videoWhyNot = d.why ? d.why : "no picture is shown";
+
+    if (captured)
+    {
+      // tagged as the picture drawn for the display is coded, with the HDR metadata of the picture
+      // on the output, as a screenshot is (ServiceVideoCaptures())
+      result.color = GetOutputColorMetadata(winSystem);
+      result.hasDisplayMetadata = m_picture.hasDisplayMetadata;
+      result.displayMetadata = m_picture.displayMetadata;
+      result.hasLightMetadata = m_picture.hasLightMetadata;
+      result.lightMetadata = m_picture.lightMetadata;
+      FillOutputHdrMetadata(winSystem, result);
+    }
+  }
+
+  if (!captured)
+  {
+    result.pixels.reset();
+    return;
+  }
+  // (of a 3D video, what is presented first: one eye, as the source rectangle of that pass takes it)
+  if (!m_picture.stereoMode.empty() && m_picture.stereoMode != "mono")
+    how += "; of a 3D video, the eye drawn first";
+  const auto ms = std::chrono::duration_cast<std::chrono::microseconds>(
+                      std::chrono::steady_clock::now() - start)
+                      .count() /
+                  1000.0;
+  result.videoHow = StringUtils::Format("{}; {:.1f} ms on the thread that draws", how, ms);
+}
