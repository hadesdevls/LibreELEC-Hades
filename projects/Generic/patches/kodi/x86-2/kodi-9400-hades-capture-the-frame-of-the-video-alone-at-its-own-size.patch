+ *  This file is part of LibreELEC Hades. It is not in Kodi as Team Kodi publishes it.
+ *
+ *  SPDX-License-Identifier: GPL-2.0-or-later
+ *  See LICENSES/README.md for more information.
+ */
+
+#pragma once
+
+#include "rendering/capture/CaptureReadback.h"
+
+#include <functional>
+
+namespace KODI
+{
+namespace RENDERING
+{
+namespace CAPTURE
+{
+
+// Hades: the frame of the video at its own size (VideoFrameCapture.h), as Kodi's own renderer gives
+// it: on the thread that draws, with the GL context current. Both leave the framebuffers bound for
+// reading and drawing, the viewport, the scissor and the blending as they found them, and make
+// nothing that outlives the call.
+
+//! A picture drawn by draw() into a framebuffer of its own of width x height, and read back: 10 bits
+//! a channel (GL_RGB10_A2) where deep, else 8 (GL_RGBA8). draw() is called with that framebuffer
+//! bound, the viewport on all of it, no scissor and no blending; it draws the top row of the picture
+//! at y = 0 of GL's coordinates (the first row of the framebuffer, read first), and returns whether
+//! it drew. out holds the rows top-down.
+bool DrawOwnSize(unsigned int width,
+                 unsigned int height,
+                 bool deep,
+                 const std::function<bool()>& draw,
+                 ReadbackBuffer& out);
+
+//! The width x height corner of a 2D texture whose first row is the top one of a picture (the
+//! picture of Kodi's renderer before its scaler, CLinuxRendererGLES::RenderToFBO()), read back at the
+//! depth of the texture (a floating-point texture as 16 bits a channel). out holds the rows top-down.
+bool ReadTextureCorner(unsigned int texture,
+                       unsigned int width,
+                       unsigned int height,
+                       ReadbackBuffer& out);
+
+} // namespace CAPTURE
+} // namespace RENDERING
+} // namespace KODI
