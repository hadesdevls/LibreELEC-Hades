diff --git a/xbmc/rendering/capture/test/TestVideoFrameCapture.cpp b/xbmc/rendering/capture/test/TestVideoFrameCapture.cpp
new file mode 100644
index 0000000..4851191
--- /dev/null
+++ b/xbmc/rendering/capture/test/TestVideoFrameCapture.cpp
@@ -0,0 +1,124 @@
+/*
+ *  Copyright (C) 2026 Hades
+ *  This file is part of LibreELEC Hades. It is not in Kodi as Team Kodi publishes it.
+ *
+ *  SPDX-License-Identifier: GPL-2.0-or-later
+ *  See LICENSES/README.md for more information.
+ */
+
+// Hades: where the frame of the video at its own size comes from (VideoFrameCapture.h)
+
+#include "rendering/capture/VideoFrameCapture.h"
+
+#include <string>
+
+#include <gtest/gtest.h>
+
+using namespace KODI::RENDERING::CAPTURE::VIDEOFRAME;
+
+namespace
+{
+struct Case
+{
+  float srcW, srcH, x1, y1, x2, y2;
+  int outW, outH;
+};
+
+Decision Of(const Case& c, bool renderer)
+{
+  return Decide(c.srcW, c.srcH, c.x1, c.y1, c.x2, c.y2, c.outW, c.outH, renderer);
+}
+} // namespace
+
+// a 4K film on a 4K output, in full: read where it is drawn, at its own size
+TEST(TestVideoFrameCapture, OwnSizeOnTheScreenIsRead)
+{
+  const Decision d = Of({3840, 2160, 0, 0, 3840, 2160, 3840, 2160}, false);
+  EXPECT_EQ(d.way, Way::READ);
+  EXPECT_EQ(d.width, 3840u);
+  EXPECT_EQ(d.height, 2160u);
+}
+
+// ... and a film of 2.39:1 between bars, its picture at a whole line
+TEST(TestVideoFrameCapture, LetterboxedAtAWholeLineIsRead)
+{
+  const Decision d = Of({3840, 1606, 0, 277, 3840, 1883, 3840, 2160}, false);
+  EXPECT_EQ(d.way, Way::READ);
+  EXPECT_EQ(d.width, 3840u);
+  EXPECT_EQ(d.height, 1606u);
+}
+
+// ... and one eye of a frame-packed 3D output, below the gap
+TEST(TestVideoFrameCapture, AnEyeOfFramePackingIsRead)
+{
+  const Decision d = Of({1920, 1080, 0, 1125, 1920, 2205, 1920, 2205}, false);
+  EXPECT_EQ(d.way, Way::READ);
+  EXPECT_EQ(d.width, 1920u);
+  EXPECT_EQ(d.height, 1080u);
+}
+
+// Kodi's own renderer gives it at its own size, at whatever size it is shown
+TEST(TestVideoFrameCapture, TheRendererGivesItWheneverItCan)
+{
+  for (const Case& c : {Case{3840, 2160, 0, 0, 3840, 2160, 3840, 2160},
+                        Case{1920, 1080, 0, 0, 3840, 2160, 3840, 2160},
+                        Case{3840, 2160, 0, 0, 1920, 1080, 1920, 1080},
+                        Case{1920, 1080, -192, -108, 2112, 1188, 1920, 1080},
+                        Case{1920, 1080, 0, 0, 1920, 2160, 1920, 2160}})
+  {
+    const Decision d = Of(c, true);
+    EXPECT_EQ(d.way, Way::RENDERER);
+    EXPECT_EQ(d.width, static_cast<unsigned int>(c.srcW));
+    EXPECT_EQ(d.height, static_cast<unsigned int>(c.srcH));
+  }
+}
+
+// a way that draws only into the window, at another size: read as it is shown, and said so
+TEST(TestVideoFrameCapture, ScaledIsReadAsShown)
+{
+  Decision d = Of({1920, 1080, 0, 0, 3840, 2160, 3840, 2160}, false);
+  EXPECT_EQ(d.way, Way::AS_SHOWN);
+  EXPECT_EQ(d.width, 3840u);
+  EXPECT_EQ(d.height, 2160u);
+  ASSERT_NE(d.why, nullptr);
+
+  d = Of({3840, 2160, 0, 0, 1920, 1080, 1920, 1080}, false);
+  EXPECT_EQ(d.way, Way::AS_SHOWN);
+  EXPECT_EQ(d.width, 1920u);
+  EXPECT_EQ(d.height, 1080u);
+}
+
+// drawn half a line off, or a fraction of a pixel larger, the picture is resampled: not its own
+TEST(TestVideoFrameCapture, OffAWholePixelIsNotOwnSize)
+{
+  Decision d = Of({1920, 800, 0, 139.5f, 1920, 939.5f, 1920, 1080}, false);
+  EXPECT_EQ(d.way, Way::AS_SHOWN);
+  d = Of({1920, 1080, 0, 0, 1920.3f, 1080.2f, 1921, 1081}, false);
+  EXPECT_EQ(d.way, Way::AS_SHOWN);
+}
+
+// zoomed past the edges of the screen, or stretched: nothing that is the picture can be read
+TEST(TestVideoFrameCapture, ZoomedOrStretchedGivesNothing)
+{
+  Decision d = Of({1920, 1080, -192, -108, 2112, 1188, 1920, 1080}, false);
+  EXPECT_EQ(d.way, Way::NONE);
+  ASSERT_NE(d.why, nullptr);
+  EXPECT_NE(std::string(d.why).find("zoomed"), std::string::npos);
+
+  d = Of({1920, 1080, 0, 0, 1920, 2160, 1920, 2160}, false);
+  EXPECT_EQ(d.way, Way::NONE);
+  ASSERT_NE(d.why, nullptr);
+  EXPECT_NE(std::string(d.why).find("stretched"), std::string::npos);
+}
+
+// no picture shown: nothing, by any way
+TEST(TestVideoFrameCapture, NoPictureGivesNothing)
+{
+  EXPECT_EQ(Of({0, 0, 0, 0, 0, 0, 1920, 1080}, true).way, Way::NONE);
+  EXPECT_EQ(Of({1, 1080, 0, 0, 1, 1080, 1920, 1080}, false).way, Way::NONE);
+}
+
+TEST(TestVideoFrameCapture, FileName)
+{
+  EXPECT_EQ(std::string(FILE_PATTERN), "video{:05}.png");
+}
