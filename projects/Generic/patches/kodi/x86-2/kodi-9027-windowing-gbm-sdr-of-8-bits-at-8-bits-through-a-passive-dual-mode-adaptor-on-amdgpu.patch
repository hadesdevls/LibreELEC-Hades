From 6114be07e8e14248c7e70659ae77c41e30b2ad04 Mon Sep 17 00:00:00 2001
From: Hades <15710513+hadesdevls@users.noreply.github.com>
Date: Wed, 18 Nov 2026 04:19:14 +0000
Subject: [PATCH] windowing/gbm: SDR of 8 bits at 8 bits through a passive
 dual-mode adaptor on amdgpu

Through a passive DisplayPort dual-mode (DP++) adaptor amdgpu sends the
deepest colour that the display declares and the adaptor's TMDS clock
carries (link_validate_mode_timing(), DC_EXCEED_DONGLE_CAP; "max bpc" is 16
there unless something lowers it): 12 bits at 1080p60 (222.75 MHz) through a
300 MHz adaptor to a display with 36-bit deep colour, while 3840x2160 at 30 Hz
(297 MHz) only fits at 8. Windows and Intel graphics send SDR at 8 bits
through the same adaptors (Hades does on Intel: LinkDepth.h). Issue 26 of
LibreELEC Hades, an A10-8730B (DCE 11.0) with an LG 3D TV whose EDID declares
36-bit deep colour: through its first passive adaptor 1080p60 and frame
packing gave no picture, 4K30 did, and the same adaptor and TV work at 1080p60
and in 3D from the user's Intel computers.

So on amdgpu, an output on a DisplayPort connector with a passive adaptor
behind it (DVBRIDGE_DUAL_MODE "HDMI adaptor" or "other adaptor", read again
with each request as the dual-mode connector of nvidia-drm is) sends SDR of 8
bits at 8 bits, as on i915 and nvidia-drm HDMI links. HDR, and SDR of more than
8 bits, keep the depth that the driver takes; a DisplayPort output without an
adaptor and every HDMI connector of amdgpu are as before; the setting "Maximum
bit depth" still decides where the user chose a value. The cost is the
spatial dither that amdgpu applies to an 8-bit stream (LinkDepth.h), only
through such adaptors. kodi.log says what is done and when the adaptor comes
or goes; the kernel log says what each commit sends through the adaptor
(linux-9861).

Not tried on hardware.
---
 xbmc/windowing/gbm/LinkDepth.h      | 20 ++++++++++++++++-
 xbmc/windowing/gbm/WinSystemGbm.cpp | 35 +++++++++++++++++++++++++++--
 xbmc/windowing/gbm/WinSystemGbm.h   |  3 +++
 3 files changed, 55 insertions(+), 3 deletions(-)

diff --git a/xbmc/windowing/gbm/LinkDepth.h b/xbmc/windowing/gbm/LinkDepth.h
index 162a45c..5ec5a62 100644
--- a/xbmc/windowing/gbm/LinkDepth.h
+++ b/xbmc/windowing/gbm/LinkDepth.h
@@ -35,7 +35,15 @@ namespace KODI::WINDOWING::GBM
  *
  * Not amdgpu: its display core dithers an 8-bit stream by default (DITHER_OPTION_SPATIAL8) and
  * not a 12-bit one (resource_build_bit_depth_reduction_params()), so the GUI at 2160p24 goes out
- * at 12 bits with its codes as they are, and at 8 bits it would be dithered.
+ * at 12 bits with its codes as they are, and at 8 bits it would be dithered. Except through a
+ * passive DisplayPort dual-mode (DP++) adaptor (PassiveAdaptorSdrAt8()): there amdgpu sends the
+ * deepest colour that the display declares and the adaptor's TMDS clock carries
+ * (link_validate_mode_timing()), 12 bits at 1080p60 through a 300 MHz adaptor, while Windows and
+ * Intel graphics send SDR at 8 bits through the same adaptors; an A10-8730B (issue 26) had no
+ * picture at 1080p60 and in frame packing through one, with a display that the same adaptor
+ * shows at 8 bits from Intel graphics, and 4K30, which only fits at 8 bits, worked. There SDR of
+ * 8 bits goes out at 8 bits, with the dither of amdgpu, which the setting "Maximum bit depth"
+ * can still undo.
  *
  * A change of "max bpc" is a modeset in the kernel (drm_atomic_helper_check_modeset():
  * connectors_changed), and on nvidia-drm a modeset of NVKMS that sets the head again
@@ -80,6 +88,16 @@ struct LinkDepthOutput
   bool defaultsToMaximum = false;
 };
 
+/*!
+ * \brief Hades: SDR of 8 bits at 8 bits on an output of amdgpu on a DisplayPort connector (SST),
+ *        while a passive dual-mode adaptor is behind it (DVBRIDGE_DUAL_MODE 1, one that says HDMI,
+ *        or 2, any other); not without one, nor for a value this Kodi does not know
+ */
+constexpr bool PassiveAdaptorSdrAt8(bool amdgpuDisplayPort, std::optional<uint64_t> dualMode)
+{
+  return amdgpuDisplayPort && dualMode.has_value() && (*dualMode == 1 || *dualMode == 2);
+}
+
 //! "max bpc" holds the link at 8 bits (below 10: nvidia-drm asks NVKMS for 8 there and for
 //! nothing from 10 on, nv_drm_connector_requested_bpc(); Kodi sets only 8 or the maximum)
 constexpr bool LinkHeldAt8(uint64_t maxBpc)
diff --git a/xbmc/windowing/gbm/WinSystemGbm.cpp b/xbmc/windowing/gbm/WinSystemGbm.cpp
index e6af37f..72016f0 100644
--- a/xbmc/windowing/gbm/WinSystemGbm.cpp
+++ b/xbmc/windowing/gbm/WinSystemGbm.cpp
@@ -5134,6 +5134,7 @@ void CWinSystemGbm::ReadLinkDepthOutput(CDRMConnector& connector)
   m_linkNewOutput = true;
   m_linkWaitTold = false;
   m_linkNextContent.reset();
+  m_linkAmdgpuDualMode = false;
   const auto limits = connector.GetRangePropertyLimits("max bpc");
   if (!limits || limits->second < 8)
     return;
@@ -5160,6 +5161,16 @@ void CWinSystemGbm::ReadLinkDepthOutput(CDRMConnector& connector)
     m_linkDepth.managed = true;
     m_linkDepth.sdrAt8 = true;
   }
+  else if (driver == "amdgpu" && type == "DP" && limits->first <= 8 &&
+           connector.SupportsProperty(DV_DUAL_MODE::PROPERTY))
+  {
+    // Hades: amdgpu on a DisplayPort connector: SDR of 8 bits at 8 bits while a passive dual-mode
+    // adaptor is behind it (LinkDepth.h, issue 26), read again with each request (QueueLinkDepth())
+    m_linkDepth.managed = true;
+    m_linkAmdgpuDualMode = true;
+    m_linkDepth.sdrAt8 =
+        PassiveAdaptorSdrAt8(true, connector.ReadPropertyValue(DV_DUAL_MODE::PROPERTY));
+  }
   m_linkDepth.maximum = limits->second;
   // (the drivers that give a connector the top of its range of "max bpc" and keep it there: what a
   // program that had the output before Kodi left lower is put back with the first commit, as
@@ -5175,8 +5186,14 @@ void CWinSystemGbm::ReadLinkDepthOutput(CDRMConnector& connector)
               "Output depth: {} ({}): Kodi sets \"max bpc\" for what it shows: {}; HDR, and SDR of "
               "more than 8 bits, at the depth the driver takes ({}); it has {} now",
               connector.GetName(), driver.empty() ? "unknown driver" : driver,
-              m_linkDepth.sdrAt8 ? "SDR of 8 bits at 8 bits, as Windows sends it"
-                                 : "SDR at the depth the driver takes (no HDMI link)",
+              m_linkAmdgpuDualMode
+                  ? (m_linkDepth.sdrAt8
+                         ? "SDR of 8 bits at 8 bits through the passive dual-mode adaptor behind "
+                           "this DisplayPort output, as Windows and Intel graphics send it there"
+                         : "SDR at the depth the driver takes (no passive dual-mode adaptor behind "
+                           "this DisplayPort output now)")
+              : m_linkDepth.sdrAt8 ? "SDR of 8 bits at 8 bits, as Windows sends it"
+                                   : "SDR at the depth the driver takes (no HDMI link)",
               m_linkDepth.maximum,
               value ? std::to_string(*value) : std::string("nothing readable"));
 }
@@ -5286,6 +5303,20 @@ void CWinSystemGbm::QueueLinkDepth(LinkContent content,
                               : std::nullopt;
     m_linkDepth.sdrAt8 = NVIDIA_DUAL_MODE::DrivenAsHdmi("DP", dualMode);
   }
+  // (Hades: ... and one of amdgpu has a passive dual-mode adaptor behind it or not by what is
+  // plugged into it)
+  if (m_linkAmdgpuDualMode)
+  {
+    const bool before = m_linkDepth.sdrAt8;
+    m_linkDepth.sdrAt8 =
+        PassiveAdaptorSdrAt8(true, connector->ReadPropertyValue(DV_DUAL_MODE::PROPERTY));
+    if (before != m_linkDepth.sdrAt8)
+      CLog::Log(LOGINFO,
+                "Output depth: {} now has {} passive dual-mode adaptor behind it: SDR of 8 bits "
+                "goes out {}",
+                connector->GetName(), m_linkDepth.sdrAt8 ? "a" : "no",
+                m_linkDepth.sdrAt8 ? "at 8 bits" : "at the depth the driver takes");
+  }
   const auto component = CServiceBroker::GetSettingsComponent();
   const auto settings = component ? component->GetSettings() : nullptr;
   const int hdrSetting = m_hdrDepthChoice && settings
diff --git a/xbmc/windowing/gbm/WinSystemGbm.h b/xbmc/windowing/gbm/WinSystemGbm.h
index 58fc570..dd5c64d 100644
--- a/xbmc/windowing/gbm/WinSystemGbm.h
+++ b/xbmc/windowing/gbm/WinSystemGbm.h
@@ -767,6 +767,9 @@ protected:
   //! Hades: the depth of the link to the display (LinkDepth.h): the output, as read when Kodi
   //! takes it (ReadLinkDepthOutput())
   LinkDepthOutput m_linkDepth;
+  //! ... an output of amdgpu on a DisplayPort connector with DVBRIDGE_DUAL_MODE: whether a passive
+  //! adaptor is behind it is read again with each request (QueueLinkDepth())
+  bool m_linkAmdgpuDualMode = false;
   //! ... what Kodi asked for "max bpc" last (QueueLinkDepth()): queued again with what a request
   //! that is made again carries (RequeueOutputProperties())
   std::optional<uint64_t> m_linkBpc;
-- 
2.53.0

