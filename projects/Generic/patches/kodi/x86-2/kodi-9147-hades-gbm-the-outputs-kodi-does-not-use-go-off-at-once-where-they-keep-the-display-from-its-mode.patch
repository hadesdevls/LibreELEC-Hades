From 298683464ef81007db4762b0ab28e4e38883d06a Mon Sep 17 00:00:00 2001
From: Hades <15710513+hadesdevls@users.noreply.github.com>
Date: Thu, 19 Nov 2026 08:38:00 +0000
Subject: [PATCH] [Hades][GBM] The outputs Kodi does not use go off at once
 where they keep the display from its mode

Kodi leaves the other outputs lit for 10 s after it starts, so that the notice on their displays can
be read, and turns them off with a commit after that (DisableOtherOutputs()). A mode of the menus that
needs what those outputs hold of the display engine is refused until then: 2560x1440 at 360 Hz on
the Samsung Odyssey G60SD takes two heads of an RTX 4080 SUPER and DSC, and with the LG C5 and an LG
UltraGear lit by the console the driver refused it (in four starts, 4 or 5
refusals each, taken in the commit that turned the others off). Meanwhile the display stayed in the
mode the console left, and where the monitor gave no EDID as the PC started (nvidia-modeset: "Unable
to read EDID") that was 1024x768: the interface, drawn for 2560x1440, showed huge and cut for 10 to
14 s.

- A change of mode that the driver refuses while those outputs wait for the end of the notice turns
  them off with the next commit, which carries the mode too.
- A commit that is due and waits for a frame (a refused change of mode asked for again, or the
  outputs that Kodi does not use turned off) gets one: an interface with nothing that changes drew
  none, and a retry waited for the next movement of the menus (CommitDue(), AskFrameForCommit()).
- The wait for the audio engine to say which outputs carry its sound is looked at each second
  instead of every 5 s, with the same 30 s at most, so that the outputs go off within a second of
  its answer.

Checked: the changed files and the sources that include them compile with the commands of the
image's build. Not run on a GPU.
---
 xbmc/windowing/gbm/WinSystemGbm.cpp           | 11 +++++++++
 xbmc/windowing/gbm/WinSystemGbm.h             |  6 +++++
 .../windowing/gbm/WinSystemGbmGLESContext.cpp |  3 +++
 xbmc/windowing/gbm/drm/DRMAtomic.cpp          | 24 ++++++++++++++++++-
 xbmc/windowing/gbm/drm/DRMAtomic.h            |  5 ++++
 xbmc/windowing/gbm/drm/DRMUtils.cpp           | 15 ++++++++----
 xbmc/windowing/gbm/drm/DRMUtils.h             | 15 ++++++++----
 7 files changed, 70 insertions(+), 9 deletions(-)

diff --git a/xbmc/windowing/gbm/WinSystemGbm.cpp b/xbmc/windowing/gbm/WinSystemGbm.cpp
index 810a7f3..dc67945 100644
--- a/xbmc/windowing/gbm/WinSystemGbm.cpp
+++ b/xbmc/windowing/gbm/WinSystemGbm.cpp
@@ -3142,6 +3142,17 @@ const char* CWinSystemGbm::ModesInTheWay()
   return MODELIST::InTheWay(busy);
 }
 
+void CWinSystemGbm::AskFrameForCommit(bool frameComes)
+{
+  if (frameComes || NativeDVOutputInUse())
+    return;
+  const auto drm = std::dynamic_pointer_cast<CDRMAtomic>(m_DRM);
+  if (!drm || !drm->CommitDue())
+    return;
+  if (auto* gui = CServiceBroker::GetGUI())
+    gui->GetWindowManager().MarkDirty();
+}
+
 void CWinSystemGbm::LookAtModes()
 {
   // Nothing at all while no hot-plug event of the device in use came since the last look: two
diff --git a/xbmc/windowing/gbm/WinSystemGbm.h b/xbmc/windowing/gbm/WinSystemGbm.h
index e63bd3b..b2eb095 100644
--- a/xbmc/windowing/gbm/WinSystemGbm.h
+++ b/xbmc/windowing/gbm/WinSystemGbm.h
@@ -97,6 +97,12 @@ public:
   //! the thread that draws, which posts the look to the application thread (RefreshModes()).
   //! While no such event came, nothing at all is done.
   void LookAtModes();
+  //! Hades: a commit of the ordinary output that is due and waits for a frame (CDRMAtomic::CommitDue():
+  //! a change of mode that the driver refused, asked for again; the outputs that Kodi does not use
+  //! turned off): where this pass draws none (frameComes false), the interface is marked dirty, so
+  //! that the next pass draws one and its commit carries them. Called for every pass by the thread
+  //! that draws; nothing while native Dolby Vision has the output.
+  void AskFrameForCommit(bool frameComes);
   //! Hades: ... the look: the display probed, and where it has other modes, the resolutions made
   //! again of them, every choice the one a start makes with them (application thread)
   void RefreshModes();
diff --git a/xbmc/windowing/gbm/WinSystemGbmGLESContext.cpp b/xbmc/windowing/gbm/WinSystemGbmGLESContext.cpp
index 1fec252..846d4f4 100644
--- a/xbmc/windowing/gbm/WinSystemGbmGLESContext.cpp
+++ b/xbmc/windowing/gbm/WinSystemGbmGLESContext.cpp
@@ -581,6 +581,9 @@ void CWinSystemGbmGLESContext::PresentRender(bool rendered, bool videoLayer)
   LookForWake();
   // Hades: the modes of the display, where a hot-plug event of the device came (nothing otherwise)
   LookAtModes();
+  // Hades: ... and a frame for a commit that is due, where this pass draws none (a change of mode
+  // that the driver refused, the outputs that Kodi does not use turned off)
+  AskFrameForCommit(rendered || videoLayer);
   // Hades: ... and its link, where it came back on a scrambled HDMI link of nvidia-drm
   LookForRelink();
   // Hades: ... and whether the display locked onto HDR of more than 8 bits that the parameters of
diff --git a/xbmc/windowing/gbm/drm/DRMAtomic.cpp b/xbmc/windowing/gbm/drm/DRMAtomic.cpp
index 4d15bba..4effad1 100644
--- a/xbmc/windowing/gbm/drm/DRMAtomic.cpp
+++ b/xbmc/windowing/gbm/drm/DRMAtomic.cpp
@@ -176,7 +176,7 @@ bool CDRMAtomic::DrmAtomicCommit(int fb_id, int flags, bool rendered, bool video
     // (Hades: not before the audio engine has said which audio outputs it uses, whose graphics
     // outputs stay on: DecideSoundOutputs())
     if (WaitsForSoundOutputs())
-      m_otherOutputsOff = std::chrono::steady_clock::now() + std::chrono::seconds(5);
+      m_otherOutputsOff = std::chrono::steady_clock::now() + SOUND_RECHECK;
     else
     {
       // (the outputs of the graphics devices that Kodi does not use: not part of this commit)
@@ -493,6 +493,22 @@ bool CDRMAtomic::DrmAtomicCommit(int fb_id, int flags, bool rendered, bool video
     // (Hades: the outputs that it turned off stay on: asked for again later)
     if (othersOff)
       OtherOutputsOffRefused(refused);
+    // Hades: a change of mode refused while the outputs that Kodi does not use are still lit for the
+    // notice on them (noticeTime above): they may hold what the mode needs of the display engine (a
+    // head, its bandwidth: 2560x1440 at 360 Hz takes two heads of an RTX 40, with DSC), and until
+    // they go off the output keeps the mode the console left, in which the interface drawn for the
+    // new one is cut (1024x768 where the display gave no EDID as the PC started). They go off with
+    // the next commit (CommitDue()), with the mode, not when the notice ends.
+    else if ((flags & DRM_MODE_ATOMIC_ALLOW_MODESET) && m_otherOutputsOff &&
+             *m_otherOutputsOff > std::chrono::steady_clock::now())
+    {
+      m_otherOutputsOff = std::chrono::steady_clock::now();
+      CLog::LogF(LOGINFO,
+                 "the driver refused a change of mode of {} while the outputs that Kodi does not "
+                 "use are on for the notice on them: they are turned off with the next commit, "
+                 "not when the notice ends, as they may hold what the mode needs",
+                 m_connector ? m_connector->GetName() : "the output");
+    }
     // (Hades: ... and those that it lit again stay off: BringBack())
     if (!m_bringingBack.empty())
       CLog::LogF(LOGWARNING,
@@ -1367,6 +1383,12 @@ void CDRMAtomic::FlipPage(struct gbm_bo* bo, bool rendered, bool videoLayer, boo
     SettleModeset(accepted, now);
 }
 
+bool CDRMAtomic::CommitDue() const
+{
+  const auto now = std::chrono::steady_clock::now();
+  return (m_active && m_modesetRetry.Due(now)) || (m_otherOutputsOff && now >= *m_otherOutputsOff);
+}
+
 void CDRMAtomic::SettleModeset(bool accepted, CModesetRetry::Clock::time_point now)
 {
   // (an output that is meant to be off shows no mode: nothing to ask for again)
diff --git a/xbmc/windowing/gbm/drm/DRMAtomic.h b/xbmc/windowing/gbm/drm/DRMAtomic.h
index ae72d5b..247e2fd 100644
--- a/xbmc/windowing/gbm/drm/DRMAtomic.h
+++ b/xbmc/windowing/gbm/drm/DRMAtomic.h
@@ -91,6 +91,11 @@ public:
   bool TakeModesetGivenUp() override { return std::exchange(m_modesetGivenUp, false); }
   //! Hades: a change of mode that the driver refused waits to be asked for again (CModesetRetry)
   bool ModesetRetryPending() const { return m_modesetRetry.Pending(); }
+  //! Hades: a commit of the ordinary output is due now that only a frame carries: a change of mode
+  //! that the driver refused, asked for again (CModesetRetry), or the turning off of the outputs
+  //! that Kodi does not use. An interface with nothing that changes draws no frame, and they waited
+  //! for one (the window system asks for it: CWinSystemGbm::AskFrameForCommit())
+  bool CommitDue() const;
   //! Hades: the next commit would carry more than a framebuffer: properties added since the last
   //! one, or a modeset that is pending
   bool HasPendingRequest() const { return m_need_modeset || (m_req && !m_req->Empty()); }
diff --git a/xbmc/windowing/gbm/drm/DRMUtils.cpp b/xbmc/windowing/gbm/drm/DRMUtils.cpp
index 155dada..d79a5d4 100644
--- a/xbmc/windowing/gbm/drm/DRMUtils.cpp
+++ b/xbmc/windowing/gbm/drm/DRMUtils.cpp
@@ -1564,16 +1564,23 @@ bool CDRMUtils::SoundOutputsChanged() const
   return m_otherOutputsDone && KODI::UTILS::CSoundOutputsInUse::Generation() != m_soundGeneration;
 }
 
+bool CDRMUtils::SoundWaitOver() const
+{
+  return m_soundWaitSince && std::chrono::steady_clock::now() - *m_soundWaitSince >= SOUND_WAIT;
+}
+
 bool CDRMUtils::WaitsForSoundOutputs()
 {
   // (30 s at most: then every output that can carry sound and has a display stays on, which is
   // what KEEP_OUTPUTS::OutputsForSound() keeps while the engine has said nothing)
-  if (m_otherOutputsDone || KODI::UTILS::CSoundOutputsInUse::Generation() != 0 ||
-      m_soundWaits >= SOUND_WAITS)
+  if (m_otherOutputsDone || KODI::UTILS::CSoundOutputsInUse::Generation() != 0 || SoundWaitOver())
     return false;
-  if (m_soundWaits++ == 0)
+  if (!m_soundWaitSince)
+  {
+    m_soundWaitSince = std::chrono::steady_clock::now();
     CLog::LogF(LOGINFO, "the audio engine has not said yet which audio output it uses: the outputs "
                         "that Kodi does not use are turned off once it has (30 s at most)");
+  }
   return true;
 }
 
@@ -1586,7 +1593,7 @@ void CDRMUtils::DecideSoundBeforeMove()
     return;
   }
   // (as the turning off of the outputs that Kodi does not use waits: WaitsForSoundOutputs())
-  if (KODI::UTILS::CSoundOutputsInUse::Generation() == 0 && m_soundWaits < SOUND_WAITS)
+  if (KODI::UTILS::CSoundOutputsInUse::Generation() == 0 && !SoundWaitOver())
   {
     if (!m_moveBeforeSoundTold)
       CLog::LogF(LOGINFO, "the audio engine has not said yet which audio output it uses: in this "
diff --git a/xbmc/windowing/gbm/drm/DRMUtils.h b/xbmc/windowing/gbm/drm/DRMUtils.h
index 56ef8f1..845a52a 100644
--- a/xbmc/windowing/gbm/drm/DRMUtils.h
+++ b/xbmc/windowing/gbm/drm/DRMUtils.h
@@ -20,6 +20,7 @@
 #include "windowing/gbm/GBMUtils.h"
 
 #include <atomic>
+#include <chrono>
 #include <optional>
 #include <set>
 #include <string>
@@ -373,9 +374,15 @@ protected:
   //! Hades: whether ReconsiderSoundOutputs() has something to do
   bool SoundOutputsChanged() const;
   //! Hades: whether the turning off of the outputs that Kodi does not use waits a while more for
-  //! the audio engine to say which audio outputs it uses (5 s each time, six times at most)
+  //! the audio engine to say which audio outputs it uses (looked at again each SOUND_RECHECK,
+  //! SOUND_WAIT at most from the first wait)
   bool WaitsForSoundOutputs();
-  static constexpr int SOUND_WAITS = 6; //!< see WaitsForSoundOutputs()
+  static constexpr std::chrono::seconds SOUND_WAIT{30}; //!< see WaitsForSoundOutputs()
+  //! (1 s: a change of mode that waits for those outputs, CDRMAtomic::DrmAtomicCommit(), goes out
+  //! within a second of the engine's answer; it was 5 s, with no mode waiting)
+  static constexpr std::chrono::seconds SOUND_RECHECK{1};
+  //! Hades: the wait of WaitsForSoundOutputs() is over (the engine never said)
+  bool SoundWaitOver() const;
   //! Hades: a move to another output (PlanOutputMove()) follows the outputs that carry the sound in
   //! use as the turning off does: decided now when the audio engine has said them and nothing was
   //! turned off yet (with the file alone while the turning off would still wait for the engine)
@@ -416,8 +423,8 @@ protected:
   std::vector<std::string> m_otherDeviceFdNodes;
   //! Hades: what DecideSoundOutputs() said last of what was not certain, so that it is said once
   std::vector<std::string> m_soundNotesTold;
-  //! Hades: how many times DisableOtherDevices() waited for the audio engine to say its outputs
-  int m_soundWaits{0};
+  //! Hades: when DisableOtherDevices() first waited for the audio engine to say its outputs
+  std::optional<std::chrono::steady_clock::time_point> m_soundWaitSince;
   //! Hades: says, once, which entries of hades-keep-outputs name none of the outputs of this
   //! device and of those that DisableOtherDevices() looked at, and which outputs of this device
   //! that it names drive nothing (DisableOtherOutputs() says what became of the others)
