From 9b68379936e481f2cb8a08e659f02db05a55e500 Mon Sep 17 00:00:00 2001
From: Hades <15710513+hadesdevls@users.noreply.github.com>
Date: Wed, 18 Nov 2026 04:04:42 +0000
Subject: [PATCH] player information: the composer said by its fields, the
 sound in kHz and kb/s
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

The composer of Dolby Vision was one value, "10/10/12 bit · poly/MMR/MMR · NLQ",
whose name had to say what its fields are ("Composer (bits BL/EL/out, maps
Y/Cb/Cr)") and took two lines beside a value of two lines. It is two values now,
each saying its fields, under a short name:
 - hades.dv.composebits, "BL 10 + EL 10 → 12": the base layer, the enhancement
   layer where its residual is used, and the result ("BL 10 → 12" where the
   residual is not used);
 - hades.dv.composemaps, "Y poly, Cb/Cr MMR, NLQ": how each component is mapped
   (the components mapped alike said together) and the NLQ of the residual.

The sound of the film was given in Hz (hades.audio.srcrate "48000") and its
bitrate in units of 1024 bits ("Kb/s"), next to a sound out in kHz and Kodi's
own audio bitrate in kb/s of 1000 bits (VideoGUIInfo). hades.audio.srcrate is
in kHz now (KiloHertz(), as hades.audio.rate) and hades.audio.bitrate in kb/s,
so that the panel says each in one form. For the same reason the bitrate of
the video, in Mb/s, is of a million bits now, as Kodi's own video bitrate in kb/s
is of a thousand (it was of 1048576 bits: "58.2 Mb/s" beside "61027 kb/s").
---
 .../windowing/gbm/WinSystemGbmGLESContext.cpp | 31 +++++++++++++------
 1 file changed, 22 insertions(+), 9 deletions(-)

diff --git a/xbmc/windowing/gbm/WinSystemGbmGLESContext.cpp b/xbmc/windowing/gbm/WinSystemGbmGLESContext.cpp
index df9c339..2b93c99 100644
--- a/xbmc/windowing/gbm/WinSystemGbmGLESContext.cpp
+++ b/xbmc/windowing/gbm/WinSystemGbmGLESContext.cpp
@@ -8601,12 +8601,24 @@ void PublishLevelValues(std::map<std::string, std::string>& info,
     info["hades.dv.l255"] = StringUtils::Format("{} / {}", lv.l255Mode, lv.l255Version);
   if (lv.composer)
   {
-    // "10/10/12 bit · poly/MMR/MMR · NLQ": bits of the base layer, the enhancement layer and the
-    // result; how the three components are mapped
+    // Two rows, each value saying its fields: the bits, "BL 10 + EL 10 → 12" (the base layer,
+    // the enhancement layer where its residual is used, and the result); the maps, "Y poly, Cb/Cr
+    // MMR, NLQ" (how each component is mapped, the components mapped alike together, and the NLQ
+    // of the residual)
     static const char* const kinds[] = {"-", "poly", "MMR", "poly+MMR"};
-    info["hades.dv.compose"] = StringUtils::Format(
-        "{}/{}/{} bit \xc2\xb7 {}/{}/{}{}", lv.blBits, lv.elBits, lv.vdrBits, kinds[lv.curve[0] & 3],
-        kinds[lv.curve[1] & 3], kinds[lv.curve[2] & 3], lv.nlq ? " \xc2\xb7 NLQ" : "");
+    info["hades.dv.composebits"] =
+        lv.nlq ? StringUtils::Format("BL {} + EL {} \xe2\x86\x92 {}", lv.blBits, lv.elBits,
+                                     lv.vdrBits)
+               : StringUtils::Format("BL {} \xe2\x86\x92 {}", lv.blBits, lv.vdrBits);
+    const unsigned int y = lv.curve[0] & 3, cb = lv.curve[1] & 3, cr = lv.curve[2] & 3;
+    std::string maps;
+    if (y == cb && cb == cr)
+      maps = StringUtils::Format("Y/Cb/Cr {}", kinds[y]);
+    else if (cb == cr)
+      maps = StringUtils::Format("Y {}, Cb/Cr {}", kinds[y], kinds[cb]);
+    else
+      maps = StringUtils::Format("Y {}, Cb {}, Cr {}", kinds[y], kinds[cb], kinds[cr]);
+    info["hades.dv.composemaps"] = maps + (lv.nlq ? ", NLQ" : "");
   }
   if (lv.count)
   {
@@ -8799,7 +8811,8 @@ void CWinSystemGbmGLESContext::PublishDVInfo(bool force)
       {"hades.dv.lvfile", ""},
       {"hades.dv.lvused", ""},
       {"hades.dv.lvsent", ""},
-      {"hades.dv.compose", ""},
+      {"hades.dv.composebits", ""},
+      {"hades.dv.composemaps", ""},
       {"hades.dv.trims", ""},
       {"hades.dv.origin", ""},
       {"hades.dv.hdr10plus", ""},
@@ -11447,13 +11460,13 @@ void CWinSystemGbmGLESContext::PublishPlayerInfo()
       info["hades.video.size"] =
           StringUtils::Format("{}x{}", cache.GetVideoWidth(), cache.GetVideoHeight());
     if (const int rate = cache.GetAudioSampleRate(); rate > 0)
-      info["hades.audio.srcrate"] = std::to_string(rate);
+      info["hades.audio.srcrate"] = KiloHertz(static_cast<unsigned>(rate));
     if (const int bits = cache.GetAudioBitsPerSample(); bits > 0)
       info["hades.audio.srcbits"] = std::to_string(bits);
     if (const int bitrate = cache.GetAudioLiveBitRate(); bitrate > 0)
-      info["hades.audio.bitrate"] = std::to_string(bitrate / 1024);
+      info["hades.audio.bitrate"] = std::to_string(bitrate / 1000); // kb/s, as Kodi's own
     if (const int bitrate = cache.GetVideoLiveBitRate(); bitrate > 0)
-      info["hades.video.bitrate"] = StringUtils::Format("{:.1f}", bitrate / 1048576.0);
+      info["hades.video.bitrate"] = StringUtils::Format("{:.1f}", bitrate / 1000000.0); // Mb/s
 
     // The use of all processors, as System.CpuUsage gives it on other systems (on Linux it
     // gives each processor); the memory in use and in all, in MB as System.Memory() has them
-- 
