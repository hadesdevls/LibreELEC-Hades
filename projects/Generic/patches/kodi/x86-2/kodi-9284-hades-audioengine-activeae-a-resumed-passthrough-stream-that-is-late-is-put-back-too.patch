From 74619c3c63a42b5d2d09a0bc987535bfc4e8c239 Mon Sep 17 00:00:00 2001
From: Hades <15710513+hadesdevls@users.noreply.github.com>
Date: Wed, 25 Nov 2026 05:05:35 +0000
Subject: [PATCH] [Hades][AudioEngine] ActiveAE: a resumed passthrough stream
 that is late is put back too

With "Adjust late passthrough audio again" the player's clock no longer
follows passthrough sound (clockFollowsAudio is false in MODE_RAW). The
check of a passthrough stream that resumed from a pause
(ResumeRawStream()) is only made in passthrough, so its exception for
late sound left to the player could no longer hold: it goes, and the
comment says what happens now. A resume that is 30 ms or more off, late
or ahead, is put back once, as one that is ahead already was.
---
 xbmc/cores/AudioEngine/Engines/ActiveAE/ActiveAE.cpp | 6 +++---
 1 file changed, 3 insertions(+), 3 deletions(-)

diff --git a/xbmc/cores/AudioEngine/Engines/ActiveAE/ActiveAE.cpp b/xbmc/cores/AudioEngine/Engines/ActiveAE/ActiveAE.cpp
index 0491a7f..0893afb 100644
--- a/xbmc/cores/AudioEngine/Engines/ActiveAE/ActiveAE.cpp
+++ b/xbmc/cores/AudioEngine/Engines/ActiveAE/ActiveAE.cpp
@@ -3339,14 +3339,14 @@ CSampleBuffer* CActiveAE::SyncStream(CActiveAEStream *stream)
 
   // Hades: the first average of a passthrough stream that resumed in sync from a pause
   // (ResumeRawStream()) is said, and held to the 30 ms that a correction lands in rather than to
-  // the threshold: a resume that the reckoning got wrong is put back once. Sound that is late is
-  // left to the player's clock where it follows the sound, as at a start.
+  // the threshold: a resume that the reckoning got wrong is put back once, late or ahead (the
+  // player's clock does not follow passthrough sound, see clockFollowsAudio above).
   bool resumeOff{false};
   if (newerror && stream->m_rawResumeCheck &&
       stream->m_syncState == CAESyncInfo::AESyncState::SYNC_INSYNC)
   {
     stream->m_rawResumeCheck = false;
-    resumeOff = fabs(error) >= 30 * scale && !(clockFollowsAudio && error < 0);
+    resumeOff = fabs(error) >= 30 * scale;
     CLog::Log(LOGINFO,
               "ActiveAE::SyncStream - the passthrough stream ({}) that resumed from a pause is "
               "{:.0f} ms {} the video{}",
-- 
