+void CWinSystemGbm::VrrFenceReset()
+{
+  if (m_vrrFencePending >= 0)
+    close(m_vrrFencePending);
+  m_vrrFencePending = -1;
+  m_vrrFencePendingAsked = 0;
+  m_vrrFenceLastNs = 0;
+  m_vrrFenceLastAsked = 0;
