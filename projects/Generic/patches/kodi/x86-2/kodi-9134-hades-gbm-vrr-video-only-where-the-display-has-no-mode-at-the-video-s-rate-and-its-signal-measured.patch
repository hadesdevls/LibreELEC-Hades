@@ -86,20 +86,6 @@ RESOLUTION CResolutionUtils::ChooseBestResolution(float fps,
   float weight = 0.0f;
   g_wholeMultipleKept = RES_INVALID;
 
-  // Hades: the video at its own rate with VRR, in the mode of the menus (windowing/gbm/VrrVideo.h):
-  // with the setting off this says no at once, and Kodi's choice goes on as it was
-  {
-    RESOLUTION gui = res;
-    if (CServiceBroker::GetWinSystem()->TakeVideoAtOwnRate(fps, is3D, nativeDV, progressive, video,
-                                                           gui, false))
-    {
-      CLog::Log(LOGINFO,
-                "Display resolution ADJUST : {} ({}) kept: the video goes at its own rate with VRR",
-                CServiceBroker::GetWinSystem()->GetGfxContext().GetResInfo(gui).strMode, gui);
-      return gui;
-    }
-  }
-
   if (!FindResolutionFromOverride(fps, width, is3D, res, weight, false)) //find a refreshrate from overrides
