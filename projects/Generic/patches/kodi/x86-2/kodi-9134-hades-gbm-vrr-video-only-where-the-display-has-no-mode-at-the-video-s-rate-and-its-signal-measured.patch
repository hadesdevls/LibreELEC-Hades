+// Hades: the time at which a fence that a commit gave (its out-fence) signalled, by the kernel's
+// monotonic clock, where it has signalled by now; the fence is not waited for
+std::optional<int64_t> FenceSignalledNs(int fd)
+{
+  struct pollfd waited = {fd, POLLIN, 0};
+  if (poll(&waited, 1, 0) <= 0 || (waited.revents & POLLIN) == 0)
+    return std::nullopt;
+  struct sync_fence_info fence = {};
+  struct sync_file_info info = {};
+  info.num_fences = 1;
+  info.sync_fence_info = static_cast<__u64>(reinterpret_cast<uintptr_t>(&fence));
+  if (ioctl(fd, SYNC_IOC_FILE_INFO, &info) != 0 || info.num_fences != 1 || fence.timestamp_ns == 0)
+    return std::nullopt;
+  return static_cast<int64_t>(fence.timestamp_ns);
+}
