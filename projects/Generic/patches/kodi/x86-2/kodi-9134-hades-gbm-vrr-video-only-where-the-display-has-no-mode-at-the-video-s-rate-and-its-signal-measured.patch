+void CWinSystemGbm::VrrVideoFenced(std::optional<int64_t> asked)
+{
+  // The out-fence of the flip before this one, which has come by now (a fence that has not, or that
+  // the kernel gives no time of, breaks the chain of intervals)
+  if (m_vrrFencePending >= 0)
