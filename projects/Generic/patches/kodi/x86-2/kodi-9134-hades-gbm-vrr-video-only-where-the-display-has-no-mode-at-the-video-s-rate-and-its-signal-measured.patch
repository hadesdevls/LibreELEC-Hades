+    const auto signalled = FenceSignalledNs(m_vrrFencePending);
+    close(m_vrrFencePending);
+    m_vrrFencePending = -1;
+    if (signalled && m_vrrFenceLastNs && m_vrrFencePendingAsked && m_vrrFenceLastAsked)
+    {
+      const int64_t error =
