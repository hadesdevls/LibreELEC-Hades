From 8a2a978dfc67c894320460974b50478d500bb968 Mon Sep 17 00:00:00 2001
From: Hades <15710513+hadesdevls@users.noreply.github.com>
Date: Wed, 18 Nov 2026 06:53:29 +0000
Subject: [PATCH] VideoPlayer: the size change for native Dolby Vision does not
 wait past a stop either

With "Adjust display refresh rate" off, Hades has OpenVideoStream() ask
for a second change of mode from the VideoPlayer thread: the 3840x2160
mode at the same refresh rate for native Dolby Vision where the mode of
the menus cannot carry it, and back for a stream without it. It is sent
with the same blocking TMSG_SETVIDEORESOLUTION as the refresh rate
switch, so it can deadlock in the same way when a stop is handled first
(Piers bca5a93): CloseFile() waits in StopThread() for this thread,
which waits for the app thread.

It now goes with the thread's stop event as well, and OpenVideoStream()
returns early once the player is stopping. A switch that is dropped for
a stop is said once in kodi.log by CGraphicContext::SetVideoResolution(),
for either of the two.
---
 xbmc/cores/VideoPlayer/VideoPlayer.cpp | 5 ++++-
 xbmc/windowing/GraphicContext.cpp      | 9 +++++++--
 2 files changed, 11 insertions(+), 3 deletions(-)

diff --git a/xbmc/cores/VideoPlayer/VideoPlayer.cpp b/xbmc/cores/VideoPlayer/VideoPlayer.cpp
index 7018a51..c7ecfa5 100644
--- a/xbmc/cores/VideoPlayer/VideoPlayer.cpp
+++ b/xbmc/cores/VideoPlayer/VideoPlayer.cpp
@@ -6039,8 +6039,11 @@ bool CVideoPlayer::OpenVideoStream(CDVDStreamInfo& hint, bool reset)
       if (res != gfx.GetVideoResolution())
       {
         const KODI::WINDOWING::CVideoModeChange::CScope playerSetsMode; // (Hades: as above)
-        gfx.SetVideoResolution(res, false);
+        // (Hades: and, as above, not waited for once CloseFile() waits for this thread)
+        gfx.SetVideoResolution(res, false, &GetStopEvent());
       }
+      if (m_bStop)
+        return false;
     }
 #endif
   }
diff --git a/xbmc/windowing/GraphicContext.cpp b/xbmc/windowing/GraphicContext.cpp
index 021818f..2c0cf69 100644
--- a/xbmc/windowing/GraphicContext.cpp
+++ b/xbmc/windowing/GraphicContext.cpp
@@ -402,8 +402,13 @@ void CGraphicContext::SetVideoResolution(RESOLUTION res, bool forceUpdate, CEven
   }
   else if (abortEvent)
   {
-    CServiceBroker::GetAppMessenger()->SendMsgAbortable(TMSG_SETVIDEORESOLUTION, res,
-                                                        forceUpdate ? 1 : 0, nullptr, *abortEvent);
+    // (Hades: said, for the logs of a test: a stop that came before the switch was made)
+    if (!CServiceBroker::GetAppMessenger()->SendMsgAbortable(
+            TMSG_SETVIDEORESOLUTION, res, forceUpdate ? 1 : 0, nullptr, *abortEvent))
+      CLog::Log(LOGINFO,
+                "CGraphicContext::SetVideoResolution: the change to resolution {} was not made: "
+                "the thread that asked for it is stopping",
+                static_cast<int>(res));
   }
   else
   {
-- 
