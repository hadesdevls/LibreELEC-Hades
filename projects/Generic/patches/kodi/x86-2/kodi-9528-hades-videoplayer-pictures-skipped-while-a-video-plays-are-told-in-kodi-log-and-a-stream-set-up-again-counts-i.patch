+/*!
+ * \brief Hades: each choice of a picture that skipped pictures while the video plays (counted in
+ *        the player information), told in kodi.log with what came before it
+ *
+ * A picture is skipped when the one after it is due as well (late by nearly a period or more, the
+ * renderer's rule). That has two causes, which kodi.log tells apart: the output showed no new
+ * picture for longer than a refresh and a half before this choice (a pass of the interface, a
+ * change of mode, a seek, the render thread held up: the time since the picture before was chosen
+ * says it), or the pictures were already late when they came (the decoder, the player). Up to 1.2.3 the
+ * player information counted them without a word in kodi.log. MOST lines a video, then one that
+ * says the rest are counted only.
+ */
+class CSkipsTold
+{
+public:
+  using Clock = std::chrono::steady_clock;
+  static constexpr int MOST = 10;
+
+  //! a video starts (CRenderManager::PreInit())
+  void Start()
+  {
+    m_told = 0;
+    m_chosen = {};
+    m_first = {};
+  }
+
+  /*!
+   * \brief A picture was chosen to be shown
+   * \param now when
+   * \param skipped the pictures this choice counted as skipped (0: none)
+   * \param lateUs how late the picture chosen is by the clock (DVD_TIME_BASE)
+   * \param periodMs the refresh period
+   * \param total the pictures counted as skipped in this video, these included
+   * \return the line of kodi.log, empty where nothing is told
+   */
+  std::string Chosen(Clock::time_point now, int skipped, double lateUs, double periodMs, int total)
+  {
+    const Clock::time_point before = m_chosen;
+    m_chosen = now;
+    if (m_first == Clock::time_point{})
+      m_first = now;
+    if (skipped <= 0 || m_told > MOST)
+      return "";
+    if (m_told++ == MOST)
+      return "further pictures skipped in this video are counted only (" + std::to_string(MOST) +
+             " choices told)";
+    const double sinceMs =
+        before == Clock::time_point{}
+            ? -1.0
+            : std::chrono::duration<double, std::milli>(now - before).count();
+    const double sinceFirstS = std::chrono::duration<double>(now - m_first).count();
+    const double lateMs = std::max(lateUs, 0.0) / 1000.0;
+    const bool stalled = sinceMs >= 0 && periodMs > 0 && sinceMs > 1.5 * periodMs;
+    char text[512];
+    std::snprintf(
+        text, sizeof(text),
+        "%d picture%s skipped as late while the video plays (%d in this video, %.1f s after its "
+        "first picture was shown): the one shown instead was %.1f ms after its time by the clock, "
+        "and the picture before it was chosen %.1f ms earlier (%.1f refresh periods): %s",
+        skipped, skipped == 1 ? "" : "s", total, sinceFirstS, lateMs, std::max(sinceMs, 0.0),
+        periodMs > 0 ? std::max(sinceMs, 0.0) / periodMs : 0.0,
+        stalled ? "the output showed no new picture meanwhile (a pass of the interface, a change "
+                  "of mode, a seek, the render thread held up)"
+                : "the pictures were late when they came (the decoder, the player)");
+    return text;
+  }
+
+private:
+  int m_told = 0;
+  Clock::time_point m_chosen{};
+  Clock::time_point m_first{};
 };
 
 } // namespace KODI::RENDERQUEUE
