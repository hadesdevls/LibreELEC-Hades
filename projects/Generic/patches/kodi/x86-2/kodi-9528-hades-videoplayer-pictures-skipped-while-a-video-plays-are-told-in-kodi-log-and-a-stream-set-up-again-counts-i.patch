     }
 
     // skip late frames
+    const int skippedBefore = m_QueueSkip; // (Hades: what this choice skips is told, CSkipsTold)
     while (m_queued.front() != idx)
     {
       if (m_presentsourcePast >= 0)
@@ -1951,6 +1958,13 @@ void CRenderManager::PrepareNextRender()
     // (Hades: the first picture of the video shown: what was left out before it is said, once)
     if (const auto said = m_startSkips.Shown(renderPts - m_Queue[idx].pts); !said.empty())
       CLog::Log(LOGINFO, "CRenderManager: {}", said);
+    // (Hades: and what this choice skipped while the video plays, with what came before it)
+    if (const auto told = m_skipsTold.Chosen(std::chrono::steady_clock::now(),
