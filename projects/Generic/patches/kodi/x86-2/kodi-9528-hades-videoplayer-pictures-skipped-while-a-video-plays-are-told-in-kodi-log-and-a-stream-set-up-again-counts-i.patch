     m_presentstep = PRESENT_FLIP;
     m_discard.push_back(m_presentsource);
     m_presentsource = idx;
@@ -1971,6 +1985,7 @@ void CRenderManager::PrepareNextRender()
     m_presentstep = PRESENT_FLIP;
     if (const auto said = m_startSkips.Shown(renderPts - m_Queue[m_queued.front()].pts); !said.empty())
