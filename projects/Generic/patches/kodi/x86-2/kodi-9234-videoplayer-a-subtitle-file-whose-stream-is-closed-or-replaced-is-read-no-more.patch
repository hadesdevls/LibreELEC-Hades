From 840d46f9cde875b486bd88d2bdfc9492e6a73070 Mon Sep 17 00:00:00 2001
From: matthane <matthan.evans@icloud.com>
Date: Wed, 11 Nov 2026 14:57:32 +0000
Subject: [PATCH] VideoPlayer: a subtitle file whose stream is closed or
 replaced is read no more

The demuxer of a subtitle file stayed the player's subtitle demuxer after
its stream was closed (subtitles turned off) or replaced by a subtitle of
another source (an embedded one, or a text file that Kodi parses itself).
ReadPacket() kept reading it before the audio and video, whenever the
subtitle player took data, and every packet was then thrown away; every
seek still sought it. OpenStream() also made a file the subtitle demuxer
before its stream had opened, and kept it when the stream failed.

The subtitle demuxer is now set when a subtitle stream opens: the file
of that stream, or none for a subtitle of another source. CloseStream()
of a stream of a subtitle file drops it, as does the change to the next
stream of an input (whose current subtitle is cleared there). Of a file
with several streams (a VobSub file has one per language), the stream
chosen is enabled and the others disabled: every language of it was
delivered before, to be thrown away.

From matthane's change for CoreELEC (CoreELEC/xbmc commit 7be06c82f3,
"VideoPlayer: stop reading a deselected subtitle file").
---
 xbmc/cores/VideoPlayer/VideoPlayer.cpp | 32 +++++++++++++++++++++-----
 1 file changed, 26 insertions(+), 6 deletions(-)

diff --git a/xbmc/cores/VideoPlayer/VideoPlayer.cpp b/xbmc/cores/VideoPlayer/VideoPlayer.cpp
index d24c1d2..31fbd3f 100644
--- a/xbmc/cores/VideoPlayer/VideoPlayer.cpp
+++ b/xbmc/cores/VideoPlayer/VideoPlayer.cpp
@@ -2339,6 +2339,8 @@ void CVideoPlayer::Process()
         m_CurrentAudio.Clear();
         m_CurrentVideo.Clear();
         m_CurrentSubtitle.Clear();
+        // (the subtitle file of the stream cleared is read no more)
+        m_pSubtitleDemuxer.reset();
         continue;
       }
 
@@ -5691,6 +5693,8 @@ bool CVideoPlayer::OpenStream(CCurrentStream& current, int64_t demuxerId, int iS
 {
   CDemuxStream* stream = NULL;
   CDVDStreamInfo hint;
+  // Hades: the demuxer of a subtitle file, which becomes the player's only once its stream opened
+  std::shared_ptr<CDVDDemux> subtitleDemuxer;
 
   // CloseFile() is waiting for this thread
   if (m_bStop)
@@ -5706,7 +5710,6 @@ bool CVideoPlayer::OpenStream(CCurrentStream& current, int64_t demuxerId, int iS
     const SelectionStream& st = m_SelectionStreams.Get(current.type, index);
 
     CLog::Log(LOGINFO, "Opening Subtitle file: {}", CURL::GetRedacted(st.filename));
-    m_pSubtitleDemuxer.reset();
     const auto demux = m_subtitleDemuxerMap.find(demuxerId);
     if (demux == m_subtitleDemuxerMap.end())
     {
@@ -5714,7 +5717,7 @@ bool CVideoPlayer::OpenStream(CCurrentStream& current, int64_t demuxerId, int iS
       return false;
     }
 
-    m_pSubtitleDemuxer = demux->second;
+    subtitleDemuxer = demux->second;
 
     double pts = m_VideoPlayerVideo->GetCurrentPts();
     if(pts == DVD_NOPTS_VALUE)
@@ -5722,14 +5725,12 @@ bool CVideoPlayer::OpenStream(CCurrentStream& current, int64_t demuxerId, int iS
     if(pts == DVD_NOPTS_VALUE)
       pts = 0;
     pts += m_offset_pts;
-    if (!m_pSubtitleDemuxer->SeekTime((int)(1000.0 * pts / (double)DVD_TIME_BASE)))
+    if (!subtitleDemuxer->SeekTime((int)(1000.0 * pts / (double)DVD_TIME_BASE)))
       CLog::Log(LOGDEBUG, "{} - failed to start subtitle demuxing from: {:f}", __FUNCTION__, pts);
-    stream = m_pSubtitleDemuxer->GetStream(demuxerId, iStream);
+    stream = subtitleDemuxer->GetStream(demuxerId, iStream);
     if(!stream || stream->disabled)
       return false;
 
-    m_pSubtitleDemuxer->EnableStream(demuxerId, iStream, true);
-
     hint.Assign(*stream, true);
   }
   else if(STREAM_SOURCE_MASK(source) == STREAM_SOURCE_TEXT)
@@ -5839,6 +5840,21 @@ bool CVideoPlayer::OpenStream(CCurrentStream& current, int64_t demuxerId, int iS
 
   if (res)
   {
+    // Hades: the subtitle demuxer is the file of the subtitle stream that opened, and none for a
+    // subtitle of another source: a file closed or replaced was still read in the place of audio
+    // and video (its packets then thrown away), and sought at every seek. Of a file with several
+    // streams (VobSub: one per language), the one chosen alone is delivered.
+    if (current.type == StreamType::SUBTITLE)
+    {
+      m_pSubtitleDemuxer = subtitleDemuxer;
+      if (m_pSubtitleDemuxer)
+      {
+        for (const CDemuxStream* fileStream : m_pSubtitleDemuxer->GetStreams())
+          m_pSubtitleDemuxer->EnableStream(demuxerId, fileStream->uniqueId,
+                                           fileStream->uniqueId == iStream);
+      }
+    }
+
     int oldId = current.id;
     current.id = iStream;
     current.demuxerId = demuxerId;
@@ -6554,6 +6570,10 @@ bool CVideoPlayer::CloseStream(CCurrentStream& current, bool bWaitForBuffers)
   //! identification from reaching the demuxer.
   SetEnableStream(current, false);
 
+  // Hades: a subtitle file whose stream is closed is read no more (OpenStream())
+  if (STREAM_SOURCE_MASK(current.source) == STREAM_SOURCE_DEMUX_SUB)
+    m_pSubtitleDemuxer.reset();
+
   IDVDStreamPlayer* player = GetStreamPlayer(current.player);
   if (player)
   {
