From ff2f15fa28588e0aa68e1dd981e0f135709c6b6c Mon Sep 17 00:00:00 2001
From: olympia <olympia@xbmc.org>
Date: Wed, 18 Nov 2026 10:59:14 +0100
Subject: [PATCH] [Video] Do not join the thumb loader when playback starts

OnPlayMedia() asked the thumb loader to stop only after holding the
item, so the loader could go on with another item meanwhile. Right
after Play() it restarted the whole load unless video was playing, and
as VideoPlayer opens the file on its own thread, no video was playing
yet for almost every playback. The restart joined the loader thread on
the GUI thread, and the switch to fullscreen joined it once more.

Stop the loader before the hold, and restart it only once playback has
started while the window is still active, or once nothing plays any
more. After AVSTARTED the restart goes through the application
messenger, behind the player's request to switch to fullscreen, which
deinitializes the window. External players do not switch, so for them
the loader waits until they stop. A file that waits for the playing one
to close counts as started, and a reload of the window drops a pending
restart. Party mode keeps the loader running as before.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
(cherry picked from commit 1050935e00e7ef2cf8249de82a1827bc6c527231)
---
 xbmc/application/ApplicationPlayer.h      |  4 ++
 xbmc/video/windows/GUIWindowVideoBase.cpp | 56 +++++++++++++++++++----
 xbmc/video/windows/GUIWindowVideoBase.h   |  6 +++
 3 files changed, 57 insertions(+), 9 deletions(-)

diff --git a/xbmc/application/ApplicationPlayer.h b/xbmc/application/ApplicationPlayer.h
index bc386c4..26c5c5b 100644
--- a/xbmc/application/ApplicationPlayer.h
+++ b/xbmc/application/ApplicationPlayer.h
@@ -47,6 +47,10 @@ public:
                 const CPlayerCoreFactory &factory,
                 const std::string &playerName, IPlayerCallback& callback);
   void OpenNext(const CPlayerCoreFactory &factory);
+  /*!
+   \brief Whether a file waits to be opened once the playing one is closed.
+   */
+  bool HasNextItem() const { return m_nextItem.pItem != nullptr; }
   void SetPlaySpeed(float speed);
   void SetTempo(float tempo);
   void FrameAdvance(int frames);
diff --git a/xbmc/video/windows/GUIWindowVideoBase.cpp b/xbmc/video/windows/GUIWindowVideoBase.cpp
index 8712341..877302c 100644
--- a/xbmc/video/windows/GUIWindowVideoBase.cpp
+++ b/xbmc/video/windows/GUIWindowVideoBase.cpp
@@ -134,6 +134,7 @@ bool CGUIWindowVideoBase::OnMessage(CGUIMessage& message)
   switch ( message.GetMessage() )
   {
   case GUI_MSG_WINDOW_DEINIT:
+    m_restartThumbLoader = false;
     if (m_thumbLoader.IsLoading())
       m_thumbLoader.StopThread();
     m_database.Close();
@@ -232,6 +233,25 @@ bool CGUIWindowVideoBase::OnMessage(CGUIMessage& message)
         return CGUIMediaWindow::OnMessage(message);
       }
       break;
+    case GUI_MSG_PLAYBACK_AVSTARTED:
+    {
+      // queued after the player's switch to fullscreen, which deinitializes the window. External
+      // players do not switch, the loader restarts once they stop.
+      const auto appPlayer{CServiceBroker::GetAppComponents().GetComponent<CApplicationPlayer>()};
+      if (m_restartThumbLoader && !appPlayer->IsExternalPlaying())
+        CServiceBroker::GetAppMessenger()->PostMsg(TMSG_CALLBACK, -1, -1,
+                                                   &m_restartThumbLoaderCallback);
+      break;
+    }
+    case GUI_MSG_PLAYBACK_ERROR:
+    case GUI_MSG_PLAYBACK_STOPPED:
+    case GUI_MSG_PLAYBACK_ENDED:
+    {
+      const auto appPlayer{CServiceBroker::GetAppComponents().GetComponent<CApplicationPlayer>()};
+      if (!appPlayer->IsPlaying() && !appPlayer->HasNextItem())
+        RestartThumbLoader();
+      break;
+    }
     case GUI_MSG_SEARCH:
       OnSearch();
       break;
@@ -740,6 +760,7 @@ bool CGUIWindowVideoBase::UpdateMovieListItem(const std::string& listItemPath,
   }
 
   // loading the art can open the video file, so it is left to the loader thread
+  m_restartThumbLoader = false;
   m_thumbLoader.Load(*m_vecItems);
 
   RemoveDiscCache(m_vecItems->GetPath());
@@ -1159,10 +1180,16 @@ bool CGUIWindowVideoBase::OnContextButton(int itemNumber, CONTEXT_BUTTON button)
 bool CGUIWindowVideoBase::OnPlayMedia(const std::shared_ptr<CFileItem>& pItem,
                                       const std::string& player)
 {
+  const bool partyMode{g_partyModeManager.IsEnabled(PartyModeContext::VIDEO)};
+  // before the hold, so that the loader stops instead of going on with another item
+  const bool loaderStopped{!partyMode && m_thumbLoader.IsLoading()};
+  if (loaderStopped)
+    m_thumbLoader.StopAsync();
+
   const CBackgroundInfoLoader::CItemHold itemHold{m_thumbLoader, pItem.get()};
 
   // party mode
-  if (g_partyModeManager.IsEnabled(PartyModeContext::VIDEO))
+  if (partyMode)
   {
     PLAYLIST::CPlayList playlistTemp;
     playlistTemp.Add(pItem);
@@ -1186,22 +1213,31 @@ bool CGUIWindowVideoBase::OnPlayMedia(const std::shared_ptr<CFileItem>& pItem,
 
   itemCopy->SetProperty("playlist_type_hint", static_cast<int>(m_guiState->GetPlaylist()));
 
-  if (m_thumbLoader.IsLoading())
-    m_thumbLoader.StopAsync();
-
   CServiceBroker::GetPlaylistPlayer().Play(itemCopy, player);
 
   // Reset force selection flag
   pItem->ClearProperty("force_playlist_selection");
 
-  const auto& components = CServiceBroker::GetAppComponents();
-  const auto appPlayer = components.GetComponent<CApplicationPlayer>();
-  if (!appPlayer->IsPlayingVideo())
-    m_thumbLoader.Load(*m_vecItems);
-
+  if (loaderStopped)
+  {
+    const auto appPlayer{CServiceBroker::GetAppComponents().GetComponent<CApplicationPlayer>()};
+    if (appPlayer->IsPlaying() || appPlayer->HasNextItem())
+      m_restartThumbLoader = true;
+    else
+      m_thumbLoader.Load(*m_vecItems);
+  }
   return true;
 }
 
+void CGUIWindowVideoBase::RestartThumbLoader()
+{
+  if (!m_restartThumbLoader || !IsActive())
+    return;
+
+  m_restartThumbLoader = false;
+  m_thumbLoader.Load(*m_vecItems);
+}
+
 bool CGUIWindowVideoBase::OnPlayMedia(int iItem, const std::string& player)
 {
   if (iItem < 0 || iItem >= m_vecItems->Size())
@@ -1371,6 +1407,7 @@ bool CGUIWindowVideoBase::PlayItem(const std::shared_ptr<CFileItem>& pItem,
 
 bool CGUIWindowVideoBase::Update(const std::string &strDirectory, bool updateFilterPath /* = true */)
 {
+  m_restartThumbLoader = false;
   if (m_thumbLoader.IsLoading())
     m_thumbLoader.StopThread();
 
@@ -1476,6 +1513,7 @@ void CGUIWindowVideoBase::GetGroupedItems(CFileItemList &items)
 
 void CGUIWindowVideoBase::OnFilterItems(const std::string& filter)
 {
+  m_restartThumbLoader = false;
   // stop before the items are changed, the loader thread reads them
   if (m_thumbLoader.IsLoading())
     m_thumbLoader.StopThread();
diff --git a/xbmc/video/windows/GUIWindowVideoBase.h b/xbmc/video/windows/GUIWindowVideoBase.h
index 0cb8658..66c2cb5 100644
--- a/xbmc/video/windows/GUIWindowVideoBase.h
+++ b/xbmc/video/windows/GUIWindowVideoBase.h
@@ -8,6 +8,7 @@
 
 #pragma once
 
+#include "messaging/ApplicationMessenger.h"
 #include "playlists/PlayListTypes.h"
 #include "video/VideoDatabase.h"
 #include "video/VideoThumbLoader.h"
@@ -140,9 +141,14 @@ protected:
   CVideoDatabase m_database;
 
   CVideoThumbLoader m_thumbLoader;
+  bool m_restartThumbLoader{false}; //!< stopped for playback, restarted if the window stays active
+  KODI::MESSAGING::ThreadMessageCallback m_restartThumbLoaderCallback{
+      [](void* window) { static_cast<CGUIWindowVideoBase*>(window)->RestartThumbLoader(); }, this};
   bool m_stackingAvailable;
 
 private:
+  void RestartThumbLoader();
+
   enum class ShowInfoResult
   {
     RESULT_ERROR, // some error occurred
-- 
