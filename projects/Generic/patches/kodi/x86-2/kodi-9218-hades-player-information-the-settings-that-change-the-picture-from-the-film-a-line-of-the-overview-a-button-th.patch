+ *
+ *  SPDX-License-Identifier: GPL-2.0-or-later
+ *  See LICENSES/README.md for more information.
+ */
+
+#pragma once
+
+#include "settings/PictureDefaults.h"
+#include "settings/lib/Setting.h"
+
+#include <optional>
+
+namespace KODI::SETTINGS::PICTURE
+{
+
+//! Hades: a setting of Kodi as PictureDefaults.h reads it: a boolean as 1 or 0, an integer as it is,
+//! and whether that is its default; nothing for a setting of another type
+inline std::optional<Value> ValueOf(const CSetting& setting)
+{
+  if (setting.GetType() == SettingType::Boolean)
+    return Value{static_cast<const CSettingBool&>(setting).GetValue() ? 1 : 0, setting.IsDefault()};
+  if (setting.GetType() == SettingType::Integer)
+    return Value{static_cast<const CSettingInt&>(setting).GetValue(), setting.IsDefault()};
+  return std::nullopt;
+}
+
+} // namespace KODI::SETTINGS::PICTURE
