+void CGUIDialogVideoSettings::RestorePictureDefaults()
+{
+  // Hades: the settings that the line of the overview page names (the window system publishes their
+  // ids with it, hades.pic.ids: settings/PictureDefaults.h), exactly those. The question names them in
+  // the words of the line, every one; only Yes puts them back, as a reset of each setting does in the
+  // settings (and saves them); a question closed another way changes nothing.
+  namespace PIC = KODI::SETTINGS::PICTURE;
+  auto* gui = CServiceBroker::GetGUI();
+  const CGUIWindow* home = gui ? gui->GetWindowManager().GetWindow(WINDOW_HOME) : nullptr;
+  const auto component = CServiceBroker::GetSettingsComponent();
+  const auto settings = component ? component->GetSettings() : nullptr;
+  if (!home || !settings)
+    return;
+  const std::vector<std::string> ids =
+      StringUtils::Split(home->GetProperty("hades.pic.ids").asString(), ";");
+  const auto word = [](uint32_t id, const std::string& english)
+  {
+    const std::string& text =
+        CServiceBroker::GetResourcesComponent().GetLocalizeStrings().GetAddonString("skin.estuary",
+                                                                                    id);
+    return text.empty() ? english : text;
+  };
+  std::vector<PIC::Changed> changed;
+  for (const std::string& id : ids)
+  {
+    const auto setting = id.empty() ? nullptr : settings->GetSetting(id);
+    const std::optional<PIC::Value> value = setting ? PIC::ValueOf(*setting) : std::nullopt;
+    if (!value || value->isDefault)
+      continue;
+    // (the words of the entry of this value, as the line has them)
+    for (const PIC::Entry& e : PIC::Entries())
+      if (id == e.setting && (e.value == PIC::ANY_VALUE || e.value == value->value))
+      {
+        changed.push_back({id, value->value, e.word, e.english});
+        break;
+      }
+  }
+  if (changed.empty())
+  {
+    CLog::Log(LOGINFO,
+              "Picture settings: a restore was asked for, and no setting named is away from "
+              "its default now");
+    return;
+  }
+  std::string list;
+  for (const auto& [id, english] : PIC::Words(changed))
+    list += "[CR]- " + word(id, english);
+  const std::string text = StringUtils::Format(CGUIUtils::GetHadesString(62421, 54447), list);
+  CLog::Log(LOGINFO,
+            "Picture settings: a restore of {} setting(s) was asked for from the player "
+            "information",
+            changed.size());
+  if (!CGUIDialogYesNo::ShowAndGetInput(CVariant{CGUIUtils::GetHadesString(62420, 54446)},
+                                        CVariant{text}))
+  {
+    CLog::Log(LOGINFO, "Picture settings: the restore was not confirmed: nothing changed");
+    return;
+  }
+  for (const PIC::Changed& c : changed)
+  {
+    const auto setting = settings->GetSetting(c.setting);
+    if (!setting)
+      continue;
+    setting->Reset();
+    CLog::Log(LOGINFO, "Picture settings: {} put back to its default ({})", c.setting, c.english);
+  }
+  settings->Save();
+}
+#endif
