+void CLinuxRendererGLES::LogPictureSettings(const VideoPicture& picture,
+                                            bool nativeDV,
+                                            bool dvAsHdr10)
+{
+  // Hades: the settings that change the picture of this video from the film (settings/
+  // PictureDefaults.h), said in kodi.log when it is set up, so that a diagnostic report has them at
+  // its top; once for each kind of video and value of the line (a video set up again with the same
+  // settings says nothing new). The renderer of the native output sends HDR10 and HLG videos as Dolby
+  // Vision too (they are named so).
+  namespace PIC = KODI::SETTINGS::PICTURE;
+  std::string source;
+  switch (picture.hdrType)
+  {
+    case StreamHdrType::HDR_TYPE_DOLBYVISION:
+      source = "dolbyvision";
+      break;
+    case StreamHdrType::HDR_TYPE_HDR10:
+    case StreamHdrType::HDR_TYPE_HDR10PLUS:
+      source = "hdr10";
+      break;
+    case StreamHdrType::HDR_TYPE_HLG:
+      source = "hlg";
+      break;
+    default:
+      return;
+  }
+  const unsigned scope = PIC::ScopeOf(source,
+                                      nativeDV    ? "native"
+                                      : dvAsHdr10 ? "hdr10"
+                                                  : "",
+                                      nativeDV ? "dv" : "");
+  if (!scope)
+    return;
+  const auto component = CServiceBroker::GetSettingsComponent();
+  const auto settings = component ? component->GetSettings() : nullptr;
+  const std::vector<PIC::Changed> changed =
+      PIC::ChangedFor(scope,
+                      [&settings](const char* id) -> std::optional<PIC::Value>
+                      {
+                        const auto s = settings ? settings->GetSetting(id) : nullptr;
+                        if (!s)
+                          return std::nullopt;
+                        return PIC::ValueOf(*s);
+                      });
+  const std::string line = PIC::LogLine(PIC::KindName(scope), changed);
+  static std::map<unsigned, std::string> said; // (the thread that configures the renderer)
+  if (said[scope] == line)
+    return;
+  said[scope] = line;
+  CLog::Log(changed.empty() ? LOGINFO : LOGWARNING, "{}", line);
+}
