diff --git a/xbmc/settings/PictureDefaults.h b/xbmc/settings/PictureDefaults.h
new file mode 100644
index 0000000..b05b02e
--- /dev/null
+++ b/xbmc/settings/PictureDefaults.h
@@ -0,0 +1,257 @@
+/*
+ *  Copyright (C) 2026 Hades
+ *  This file is part of LibreELEC Hades. It is not in Kodi as Team Kodi publishes it.
+ *
+ *  SPDX-License-Identifier: GPL-2.0-or-later
+ *  See LICENSES/README.md for more information.
+ */
+
+#pragma once
+
+#include <cstdint>
+#include <functional>
+#include <optional>
+#include <string>
+#include <vector>
+
+/*!
+ * \file
+ * \brief Hades: the settings that, away from their defaults, change the picture of an HDR video from
+ *        the film (the studio's trims left out, content mapping v4.0 added, a peak set by hand, another
+ *        transport, a tone mapping of Hades in place of the display's...). The player information says
+ *        which of them apply to the video that plays, in one line of its overview page with a button that
+ *        puts exactly those back to their defaults (after a question), and kodi.log says them when a video
+ *        starts, so that a diagnostic report has them at the top.
+ *
+ * Why: a comparison of builds was made with three expert settings of Dolby Vision off their defaults and
+ * the player information open, and Hades was found dimmer (forum, lvasan, 2026-11). Nothing said that the
+ * picture was not the film's as Hades sends it by default.
+ *
+ * What counts: a setting whose value is not its default, and, where only some of its values change the
+ * picture, one of those (the step-down of fidelity "Never" keeps the picture; "Level 2" lowers it). Each
+ * entry says for which videos it changes anything (Scope): a setting of native Dolby Vision is not named
+ * for an HDR10 video. A setting that this Kodi does not have (another build, a setting of a later
+ * version) is passed over. Nothing of Kodi is here: the caller reads the settings (a host test runs it).
+ */
+namespace KODI::SETTINGS::PICTURE
+{
+
+//! For which videos a setting changes the picture
+enum Scope : unsigned
+{
+  DV_NATIVE =
+      1, //!< Dolby Vision sent as Dolby Vision (Standard or Low-Latency), also made from HDR10/HLG
+  DV_HDR10 = 2, //!< a Dolby Vision video rebuilt and sent as HDR10
+  HDR10 = 4, //!< an HDR10 or HDR10+ video
+  HLG = 8, //!< an HLG video
+  ANY_HDR = DV_NATIVE | DV_HDR10 | HDR10 | HLG,
+};
+
+//! Any value other than the default counts
+constexpr int ANY_VALUE = -2147483647 - 1;
+
+//! One setting, or one of its values, that changes the picture
+struct Entry
+{
+  const char* setting; //!< its id
+  unsigned scope; //!< Scope
+  int value; //!< the value that counts (a boolean: 1 true, 0 false), or ANY_VALUE
+  uint32_t word; //!< Estuary's string of the short words that say it in the player information
+  const char* english; //!< the same words in English (kodi.log; the page where the skin has none)
+};
+
+/*!
+ * \brief The settings, in the order the line says them: what the film carries first (trims, content
+ *        mapping), then how it is sent, then the tone mapping of Hades
+ *
+ * The words are short (the line is one line of the overview page: Line()), and say what happens, not the
+ * name of the setting. The settings of the form of the metadata (videoscreen.hadesdvl5form and the four
+ * after it) compare native Dolby Vision with what licensed players send.
+ */
+inline const std::vector<Entry>& Entries()
+{
+  static const std::vector<Entry> entries{
+      // the metadata of the film
+      {"videoscreen.hadesdvnotrims", DV_NATIVE, 1, 54420, "trims left out"},
+      {"videoscreen.hadesdvcm40", DV_NATIVE, 1, 54421, "v4.0 added"},
+      {"videoscreen.hadesdvcm40", DV_NATIVE, 2, 54421, "v4.0 added"},
+      {"videoscreen.hadesdvcm40", DV_NATIVE, 4, 54421, "v4.0 added"},
+      {"videoscreen.hadesdvcm40", DV_NATIVE, 3, 54422, "v4.0 left out"},
+      {"videoscreen.hadesdvcm40manual", DV_NATIVE, 1, 54423, "v4.0 peak by hand"},
+      {"videoscreen.hadesdvl5form", DV_NATIVE, ANY_VALUE, 54424, "active area changed"},
+      {"videoscreen.hadesdvlevelorder", DV_NATIVE, 0, 54425, "blocks reordered"},
+      {"videoscreen.hadesdvl254zero", DV_NATIVE, 1, 54426, "level 254 changed"},
+      {"videoscreen.hadesdvl3neutral", DV_NATIVE, 1, 54427, "level 3 added"},
+      // how it is sent
+      {"videoscreen.hadesdvtransport", DV_NATIVE, 0, 54428, "sent in IPT"},
+      {"videoscreen.hadesdvtransport", DV_NATIVE, 1, 54429, "converted to BT.2020"},
+      {"videoscreen.hadesdvavibt2020", DV_NATIVE, 1, 54430, "AVI colorimetry changed"},
+      {"videoscreen.hadesdvcomposer", DV_NATIVE | DV_HDR10, 1, 54431, "libplacebo's composition"},
+      {"videoscreen.hadesdvstepmode", DV_NATIVE, 2, 54432, "fidelity lowered by hand"},
+      {"videoscreen.hadesdvstepmode", DV_NATIVE, 3, 54432, "fidelity lowered by hand"},
+      {"videoscreen.hadesdvstepmode", DV_NATIVE, 4, 54432, "fidelity lowered by hand"},
+      {"videoscreen.hadesdvllalways", DV_NATIVE, 1, 54433, "Low-Latency forced"},
+      {"videoscreen.hadesdvllmanual", DV_NATIVE, 1, 54434, "TV set by hand"},
+      {"videoscreen.hadesdvllblackedid", DV_NATIVE, 0, 54435, "TV black not used"},
+      {"videoscreen.hadeshdrdepth", ANY_HDR, 8, 54436, "8 bits by hand"},
+      {"videoscreen.hadesmaxbpc", ANY_HDR, 8, 54436, "8 bits by hand"},
+      {"videoscreen.hadeshdr420", ANY_HDR, 1, 54437, "8-bit RGB"},
+      // the tone mapping of Hades in place of the display's, and conversions
+      {"videoscreen.hadesdvhdr10map", DV_HDR10, 1, 54438, "mapped to your peak"},
+      {"videoscreen.hadesdvtrimpass", DV_HDR10, 1, 54439, "trims in the mapping"},
+      {"videoscreen.hadeshdr10adapt", HDR10, ANY_VALUE, 54440, "adapted to your TV"},
+      {"videoscreen.hadeshdr10scenes", HDR10, 1, 54441, "mapped scene by scene"},
+      {"videoscreen.hadeshdr10limiton", HDR10, 1, 54442, "peak told limited"},
+      {"videoscreen.hadesdvfromhdr10", HDR10, 1, 54443, "made Dolby Vision"},
+      {"videoscreen.hadesdvfromhdr10plus", HDR10, 1, 54443, "made Dolby Vision"},
+      {"videoscreen.hadeshlgasdv", HLG, 1, 54443, "made Dolby Vision"},
+  };
+  return entries;
+}
+
+/*!
+ * \brief For which settings a video is played
+ * \param source what the video is (hades.src.hdrtype): dolbyvision, hdr10, hdr10plus, hlg, or empty
+ * \param dvState how Dolby Vision goes out (hades.dv.state): native, hdr10, sdr, or empty
+ * \param signal what the display is told (hades.out.signal): dv, ... (an HDR10 or HLG video sent as
+ *        Dolby Vision is told dv)
+ * \return the Scope bits, 0 for an SDR video and for Dolby Vision mapped to SDR (the settings of SDR
+ *         output are not these)
+ */
+inline unsigned ScopeOf(const std::string& source,
+                        const std::string& dvState,
+                        const std::string& signal)
+{
+  unsigned scope = 0;
+  if (source == "dolbyvision")
+  {
+    if (dvState == "native" || signal == "dv")
+      scope |= DV_NATIVE;
+    else if (dvState == "hdr10")
+      scope |= DV_HDR10;
+  }
+  else if (source == "hdr10" || source == "hdr10plus")
+    scope |= HDR10 | (signal == "dv" ? DV_NATIVE : 0u);
+  else if (source == "hlg")
+    scope |= HLG | (signal == "dv" ? DV_NATIVE : 0u);
+  return scope;
+}
+
+//! What a setting is now: its value (a boolean as 1 or 0) and whether that is its default
+struct Value
+{
+  int value = 0;
+  bool isDefault = true;
+};
+
+//! A setting that counts, as it is now
+struct Changed
+{
+  std::string setting;
+  int value = 0;
+  uint32_t word = 0;
+  std::string english;
+};
+
+/*!
+ * \brief The settings that change the picture of a video of this scope away from the film
+ * \param read gives a setting as it is now, or nothing where this Kodi has no such setting
+ * \return one entry per setting, in the order of Entries(); the same words are said once
+ */
+inline std::vector<Changed> ChangedFor(unsigned scope,
+                                       const std::function<std::optional<Value>(const char*)>& read)
+{
+  std::vector<Changed> out;
+  if (!scope || !read)
+    return out;
+  for (const Entry& e : Entries())
+  {
+    if (!(e.scope & scope))
+      continue;
+    bool seen = false;
+    for (const Changed& c : out)
+      seen = seen || c.setting == e.setting;
+    if (seen)
+      continue;
+    const std::optional<Value> v = read(e.setting);
+    if (!v || v->isDefault || (e.value != ANY_VALUE && v->value != e.value))
+      continue;
+    out.push_back({e.setting, v->value, e.word, e.english});
+  }
+  return out;
+}
+
+//! The words of the settings that count, each once, in order (two settings may say the same)
+inline std::vector<std::pair<uint32_t, std::string>> Words(const std::vector<Changed>& changed)
+{
+  std::vector<std::pair<uint32_t, std::string>> words;
+  for (const Changed& c : changed)
+  {
+    bool said = false;
+    for (const auto& w : words)
+      said = said || w.first == c.word;
+    if (!said)
+      words.emplace_back(c.word, c.english);
+  }
+  return words;
+}
+
+//! At most this many words in the line of the overview page (one line of its heading, under the
+//! sentence); the rest are counted ("+2"), and the question of its button names every one
+constexpr size_t LINE_WORDS = 3;
+
+/*!
+ * \brief The line of the overview page: the first LINE_WORDS words, joined by ", ", and "+N" for the
+ *        rest; empty where nothing counts
+ * \param word gives the words of a string in the language of the interface (English where none)
+ */
+inline std::string Line(const std::vector<Changed>& changed,
+                        const std::function<std::string(uint32_t, const std::string&)>& word)
+{
+  const auto words = Words(changed);
+  std::string line;
+  for (size_t i = 0; i < words.size() && i < LINE_WORDS; ++i)
+  {
+    if (i)
+      line += ", ";
+    line += word ? word(words[i].first, words[i].second) : words[i].second;
+  }
+  if (words.size() > LINE_WORDS)
+    line += " +" + std::to_string(words.size() - LINE_WORDS);
+  return line;
+}
+
+/*!
+ * \brief The line of kodi.log: every setting that counts with its value and its words, or that none
+ *        does ("Picture settings: ...", which the diagnostic report puts at its top)
+ */
+inline std::string LogLine(const std::string& kind, const std::vector<Changed>& changed)
+{
+  if (changed.empty())
+    return "Picture settings: for this " + kind +
+           " video every setting that changes the picture is at its default";
+  std::string line = "Picture settings: for this " + kind + " video " +
+                     std::to_string(changed.size()) +
+                     (changed.size() == 1 ? " setting changes" : " settings change") +
+                     " the picture from the film (Settings > System > Display, expert level):";
+  for (size_t i = 0; i < changed.size(); ++i)
+    line += (i ? "; " : " ") + changed[i].setting + "=" + std::to_string(changed[i].value) + " (" +
+            changed[i].english + ")";
+  return line;
+}
+
+//! The kind of video, as kodi.log names it
+inline std::string KindName(unsigned scope)
+{
+  if (scope & DV_NATIVE && !(scope & (HDR10 | HLG)))
+    return "native Dolby Vision";
+  if (scope & DV_HDR10)
+    return "Dolby Vision as HDR10";
+  if (scope & HDR10)
+    return scope & DV_NATIVE ? "HDR10 as Dolby Vision" : "HDR10";
+  if (scope & HLG)
+    return scope & DV_NATIVE ? "HLG as Dolby Vision" : "HLG";
+  return "SDR";
+}
+
+} // namespace KODI::SETTINGS::PICTURE
