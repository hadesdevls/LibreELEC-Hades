From 671a88786248e714e9f7e846dd8f0cd518d6117f Mon Sep 17 00:00:00 2001
From: Hades <15710513+hadesdevls@users.noreply.github.com>
Date: Wed, 18 Nov 2026 04:19:14 +0000
Subject: [PATCH] windowing/gbm: amdgpu.dvbridge_dce offered on a DisplayPort
 output behind an adaptor that says HDMI

The Dolby Vision tunnel of amdgpu goes through a passive dual-mode (DP++)
adaptor that says HDMI (linux-9998), but on Radeon RX 400, RX 500 and Vega
cards (DCE 11.2 to 12) it is offered only with amdgpu.dvbridge_dce=1, whose
setting ("Dolby Vision on this Radeon (experimental)") was shown only where the
kernel names the option on the connector, which it did on HDMI connectors
only. The kernel now names it on the DisplayPort connectors of those cards too
(linux-9860).

Kodi offers the setting on a DisplayPort connector only while
DVBRIDGE_DUAL_MODE says that a passive adaptor that says HDMI is behind it
(BOOT_OPTION::OfferedOn()): a DisplayPort display or a converter is not offered
a setting that does nothing there, and kodi.log says why it is not. HDMI
connectors, and the other option (i915.hdmi_hdr_gmp), are as before.
---
 xbmc/windowing/gbm/BootOptions.cpp  | 18 ++++++++++++++++++
 xbmc/windowing/gbm/drm/BootOption.h | 18 ++++++++++++++++++
 2 files changed, 36 insertions(+)

diff --git a/xbmc/windowing/gbm/BootOptions.cpp b/xbmc/windowing/gbm/BootOptions.cpp
index 57de7c3..676d0a4 100644
--- a/xbmc/windowing/gbm/BootOptions.cpp
+++ b/xbmc/windowing/gbm/BootOptions.cpp
@@ -22,6 +22,7 @@
 #include "utils/StringUtils.h"
 #include "utils/log.h"
 #include "windowing/gbm/drm/DRMConnector.h"
+#include "windowing/gbm/drm/DVDualMode.h"
 
 #include <cerrno>
 #include <cstring>
@@ -170,6 +171,23 @@ void CBootOptions::Read(CDRMConnector& connector)
     return;
   }
 
+  // Hades: ... on a DisplayPort connector, only behind a passive adaptor that says HDMI (OfferedOn())
+  const bool displayPort = connector.GetType() == "DP";
+  const std::optional<uint64_t> dualMode =
+      displayPort && connector.SupportsProperty(DV_DUAL_MODE::PROPERTY)
+          ? connector.ReadPropertyValue(DV_DUAL_MODE::PROPERTY)
+          : std::nullopt;
+  if (!BO::OfferedOn(*named, displayPort, dualMode))
+  {
+    m_offered = nullptr;
+    CLog::Log(LOGINFO,
+              "BootOption: {} names {} ({}), but no passive dual-mode adaptor that says HDMI is "
+              "behind this DisplayPort output now ({} {}): the setting \"{}\" is not offered here",
+              connector.GetName(), named->kernel, BO::PROPERTY, DV_DUAL_MODE::PROPERTY,
+              dualMode ? std::to_string(*dualMode) : std::string("not readable"), named->setting);
+    return;
+  }
+
   std::string said;
   const BO::State state = Ask(*named, said);
   if (!BO::Offered(named, state))
diff --git a/xbmc/windowing/gbm/drm/BootOption.h b/xbmc/windowing/gbm/drm/BootOption.h
index db4451b..bcc5247 100644
--- a/xbmc/windowing/gbm/drm/BootOption.h
+++ b/xbmc/windowing/gbm/drm/BootOption.h
@@ -23,6 +23,7 @@
 
 #include <array>
 #include <cstdint>
+#include <optional>
 #include <string>
 #include <string_view>
 #include <vector>
@@ -65,6 +66,23 @@ inline const Option* OfSetting(std::string_view id)
   return nullptr;
 }
 
+/*!
+ * \brief Whether a connector that names an option offers it: on an HDMI connector, as named; on a
+ *        DisplayPort one (amdgpu names amdgpu.dvbridge_dce there too, linux-9860) only while a
+ *        passive dual-mode adaptor that says HDMI is behind it (DVBRIDGE_DUAL_MODE 1): the tunnel
+ *        goes through such an adaptor and nowhere else on that connector, so a DisplayPort display or
+ *        a converter is not offered a setting that does nothing there. Any other option named on a
+ *        DisplayPort connector, or a value not known: not offered (fail closed).
+ * \param dualMode DVBRIDGE_DUAL_MODE of the connector, nothing where it has no such property
+ */
+inline bool OfferedOn(const Option& option, bool displayPort, std::optional<uint64_t> dualMode)
+{
+  if (!displayPort)
+    return true;
+  return std::string_view(option.kernel) == "amdgpu.dvbridge_dce" && dualMode.has_value() &&
+         *dualMode == 1;
+}
+
 //! What the boot menus say of an option: the answer of "internal-disks option NAME"
 enum class State
 {
-- 
2.53.0

