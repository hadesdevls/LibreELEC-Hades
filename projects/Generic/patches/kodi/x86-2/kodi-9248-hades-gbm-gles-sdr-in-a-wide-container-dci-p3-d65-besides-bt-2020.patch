 // pure power, 2.4 (BT.1886 with its black at zero: how a TV shows the same GUI in SDR, and how ITU-R
@@ -52,6 +53,13 @@ const mat3 bt709_to_bt2020 = mat3(
   0.329283038, 0.919540395, 0.088013308,
   0.043313066, 0.011362316, 0.895595253
 );
+// Hades: BT.709 -> DCI-P3 (D65) in linear light, from the CIE xy of SMPTE EG 432-1 and BT.709 with the white of D65
+// (KODI::UTILS::SDRWIDE::BT709_TO_P3_D65, by columns here)
+const mat3 bt709_to_p3_d65 = mat3(
+  0.822461969, 0.033194199, 0.017082631,
+  0.177538031, 0.966805801, 0.072397441,
+  0.0,         0.0,         0.910519929
+);
 #else
 const mat3 bt709_to_bt2020 = mat3(
   0.6274,  0.0691,  0.0164,
@@ -101,11 +109,16 @@ void main()
 #if defined(KODI_GUI_EXACT)
   // Hades: SDR of BT.2020 primaries (ITU-R BT.2087 case #1): the colour of the GUI, which the FBO
   // holds premultiplied by its coverage, to linear light by the EOTF of ITU-R BT.1886 (2.40), to
-  // BT.2020, and back; mixed over the picture by its coverage, as Kodi mixes the GUI in SDR
+  // BT.2020 (or to DCI-P3 (D65)), and back; mixed over the picture by its coverage, as Kodi mixes the GUI in SDR
   if (u_sdrWide > 0.5)
   {
     vec3 colour = clamp(gui.rgb / gui.a, 0.0, 1.0);
-    vec3 wide = pow(max(bt709_to_bt2020 * pow(colour, vec3(2.4)), vec3(0.0)), vec3(1.0 / 2.4));
+    vec3 light = pow(colour, vec3(2.4));
+    if (u_sdrWide > 1.5)
+      light = bt709_to_p3_d65 * light;
+    else
+      light = bt709_to_bt2020 * light;
+    vec3 wide = pow(max(light, vec3(0.0)), vec3(1.0 / 2.4));
 #ifdef KODI_LIMITED_RANGE
     wide = wide * ((235.0 - 16.0) / 255.0) + (16.0 / 255.0);
 #endif
