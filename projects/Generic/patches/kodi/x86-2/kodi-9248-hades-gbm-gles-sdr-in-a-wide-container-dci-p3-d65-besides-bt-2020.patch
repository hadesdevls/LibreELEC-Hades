diff --git a/xbmc/utils/SdrWide.h b/xbmc/utils/SdrWide.h
index 870ef32..daa3f73 100644
--- a/xbmc/utils/SdrWide.h
+++ b/xbmc/utils/SdrWide.h
@@ -49,8 +49,51 @@ namespace SDRWIDE
  * premultiplied by its coverage (the blend functions of the GUI: CGUITextureGLES::DrawQuad(),
  * CGUIFontTTFGLES), which is divided out, converted and mixed (not the squared alpha that the
  * composite into PQ and HLG uses).
+ *
+ * Hades: the same is done for an HDR picture mapped to SDR (by the bridge or by Kodi's own tone mapping), sent in the
+ * container that videoscreen.hadessdrhdrgamut asks for: BT.2020 or DCI-P3 with the white of D65 (Container), for a
+ * projector or a TV that takes SDR in a wider gamut. The picture is mapped into that container; the GUI is converted
+ * into it by the same conversion with the matrix of that container (BT.709 to DCI-P3 (D65) in linear light, made from
+ * the CIE xy of SMPTE EG 432-1 and BT.709 as BT.2087's is from BT.709 and BT.2020); and the display is told it
+ * (BT2020_RGB, or DCI-P3_RGB_D65: DCI-P3 RGB (D65) of CTA-861, which the CTA colorimetry data block declares by its
+ * bit of SMPTE ST 2113 RGB, "DCI-P3" before CTA-861-H).
  */
 
+//! Hades: the container of an SDR signal: BT.709 as Kodi sends every SDR picture, or a wider one
+enum class Container
+{
+  BT709 = 0,
+  BT2020 = 1,
+  P3_D65 = 2, //!< DCI-P3 primaries with the white of D65 (SMPTE EG 432-1)
+};
+
+//! The container that a value of videoscreen.hadessdrhdrgamut asks for (any other value: BT.709)
+constexpr Container ContainerOfSetting(int value)
+{
+  return value == 1 ? Container::BT2020 : value == 2 ? Container::P3_D65 : Container::BT709;
+}
+
+constexpr const char* ContainerName(Container container)
+{
+  switch (container)
+  {
+    case Container::BT2020:
+      return "BT.2020";
+    case Container::P3_D65:
+      return "DCI-P3 (D65)";
+    default:
+      return "BT.709";
+  }
+}
+
+//! The primaries that Kodi's own shaders draw an SDR picture into for a container (CConvertMatrix's destination)
+constexpr AVColorPrimaries Primaries(Container container)
+{
+  return container == Container::BT2020   ? AVCOL_PRI_BT2020
+         : container == Container::P3_D65 ? AVCOL_PRI_SMPTE432
+                                          : AVCOL_PRI_BT709;
+}
+
 //! ITU-R BT.2087: BT.709 to BT.2020 in linear light, by rows of BT.2020's R, G and B (the same
 //! numbers as gles_gui_composite.frag, which has them by columns)
 constexpr std::array<std::array<double, 3>, 3> BT709_TO_BT2020{{
@@ -59,13 +102,33 @@ constexpr std::array<std::array<double, 3>, 3> BT709_TO_BT2020{{
     {0.016391439, 0.088013308, 0.895595253},
 }};
 
+//! Hades: BT.709 to DCI-P3 with the white of D65 in linear light, by rows of DCI-P3's R, G and B (the same numbers as
+//! gles_gui_composite.frag, which has them by columns): from the CIE xy of SMPTE EG 432-1 (red 0.680, 0.320; green
+//! 0.265, 0.690; blue 0.150, 0.060) and of BT.709, the white of D65 (0.3127, 0.3290) for both. BT.709's blue is
+//! DCI-P3's: the third column is 0, 0 and its own.
+constexpr std::array<std::array<double, 3>, 3> BT709_TO_P3_D65{{
+    {0.822461969, 0.177538031, 0.0},
+    {0.033194199, 0.966805801, 0.0},
+    {0.017082631, 0.072397441, 0.910519929},
+}};
+
+//! The matrix of a container (BT.709: none to apply, the identity)
+inline const std::array<std::array<double, 3>, 3>& Matrix(Container container)
+{
+  static constexpr std::array<std::array<double, 3>, 3> identity{{{1, 0, 0}, {0, 1, 0}, {0, 0, 1}}};
+  return container == Container::BT2020   ? BT709_TO_BT2020
+         : container == Container::P3_D65 ? BT709_TO_P3_D65
+                                          : identity;
+}
+
 //! The exponent of the reference EOTF of ITU-R BT.1886 with a black of 0 (BT.2087 case #1)
 constexpr double BT1886_GAMMA = 2.40;
 
-//! A colour of the GUI (the non-linear signal of BT.709, 0 to 1) in BT.2020, as the SDR mode of
+//! A colour of the GUI (the non-linear signal of BT.709, 0 to 1) in a container, as the SDR mode of
 //! the composite converts it
-inline std::array<double, 3> ToBt2020(const std::array<double, 3>& colour)
+inline std::array<double, 3> ToContainer(const std::array<double, 3>& colour, Container container)
 {
+  const auto& m = Matrix(container);
   std::array<double, 3> linear{};
   for (int i = 0; i < 3; ++i)
     linear[i] = std::pow(std::clamp(colour[i], 0.0, 1.0), BT1886_GAMMA);
@@ -74,25 +137,33 @@ inline std::array<double, 3> ToBt2020(const std::array<double, 3>& colour)
   {
     double v = 0.0;
     for (int c = 0; c < 3; ++c)
-      v += BT709_TO_BT2020[r][c] * linear[c];
+      v += m[r][c] * linear[c];
     out[r] = std::pow(std::max(v, 0.0), 1.0 / BT1886_GAMMA);
   }
   return out;
 }
 
+//! ... in BT.2020
+inline std::array<double, 3> ToBt2020(const std::array<double, 3>& colour)
+{
+  return ToContainer(colour, Container::BT2020);
+}
+
 //! A pixel of the SDR mode of the composite: the FBO's colour (premultiplied by its coverage) and
 //! coverage, over the picture's pixel; all of them the non-linear signal, 0 to 1. A coverage of 0
-//! leaves the picture (the composite discards such a pixel).
+//! leaves the picture (the composite discards such a pixel). (Hades: into the container given,
+//! BT.2020 where none is.)
 inline std::array<double, 3> Composite(const std::array<double, 3>& premultiplied,
                                        double coverage,
-                                       const std::array<double, 3>& picture)
+                                       const std::array<double, 3>& picture,
+                                       Container container = Container::BT2020)
 {
   if (coverage <= 0.0)
     return picture;
   std::array<double, 3> colour{};
   for (int i = 0; i < 3; ++i)
     colour[i] = std::clamp(premultiplied[i] / coverage, 0.0, 1.0);
-  const std::array<double, 3> wide = ToBt2020(colour);
+  const std::array<double, 3> wide = ToContainer(colour, container);
   std::array<double, 3> out{};
   for (int i = 0; i < 3; ++i)
     out[i] = wide[i] * coverage + picture[i] * (1.0 - coverage);
@@ -106,21 +177,37 @@ constexpr bool Candidate(int primaries, int transfer)
          transfer != AVCOL_TRC_ARIB_STD_B67;
 }
 
+//! Hades: whether the setting of HDR mapped to SDR (videoscreen.hadessdrhdrgamut) is about a picture: PQ or HLG
+constexpr bool MappedCandidate(int transfer)
+{
+  return transfer == AVCOL_TRC_SMPTE2084 || transfer == AVCOL_TRC_ARIB_STD_B67;
+}
+
 //! Why such a picture is drawn in BT.709, as without the setting
 enum class Why
 {
-  NONE, //!< it goes out in BT.2020
+  NONE, //!< it goes out in BT.2020 (Hades: or in the container asked for)
   SETTING, //!< the setting is off
   DOLBY_VISION, //!< native Dolby Vision output, or its menus, hold the output
   STEREO, //!< a 3D output
   DISPLAY, //!< the EDID does not declare BT2020_RGB
   DRIVER, //!< the connector has no Colorspace property with BT2020_RGB
+  DISPLAY_P3, //!< Hades: the EDID does not declare DCI-P3 RGB (SMPTE ST 2113 RGB)
+  DRIVER_P3, //!< Hades: the connector has no Colorspace property with DCI-P3_RGB_D65
