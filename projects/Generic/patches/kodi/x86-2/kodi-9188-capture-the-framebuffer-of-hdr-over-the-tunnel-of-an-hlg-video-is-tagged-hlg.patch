From 064b953127d3c2751d4197df482903f365ec4970 Mon Sep 17 00:00:00 2001
From: Hades <15710513+hadesdevls@users.noreply.github.com>
Date: Fri, 20 Nov 2026 21:33:19 +0000
Subject: [PATCH] [Capture] The framebuffer of HDR over the tunnel of an HLG
 video is tagged HLG

A capture during native output (CWinSystemBase::HasCaptureFramebuffer())
reads the picture before it is packed for the link, and
GetOutputColorMetadata() tagged it PQ with BT.2020 primaries, as native
Dolby Vision has it. HDR over the tunnel (YCbCr 4:2:2 at 12 bits in the
RGB transport) carries an HLG video as the HLG it is: the picture there
is HLG (the GUI is composited for its transfer, BeginDVBridge()), and
the output signals HLG (GetEotf()). A screenshot of it was tagged PQ in
its cICP chunk, so an HDR viewer showed it with the wrong transfer.

It is tagged HLG now where the output signals HLG; PQ otherwise, as
before. Tests: TestCaptureMetadata, the framebuffer as PQ and as HLG.
---
 xbmc/rendering/capture/CaptureMetadata.cpp    |  4 ++-
 .../capture/test/TestCaptureMetadata.cpp      | 25 ++++++++++++++++++-
 xbmc/windowing/WinSystem.h                    |  3 ++-
 3 files changed, 29 insertions(+), 3 deletions(-)

diff --git a/xbmc/rendering/capture/CaptureMetadata.cpp b/xbmc/rendering/capture/CaptureMetadata.cpp
index fa73053..4ca1edf 100644
--- a/xbmc/rendering/capture/CaptureMetadata.cpp
+++ b/xbmc/rendering/capture/CaptureMetadata.cpp
@@ -33,10 +33,12 @@ ImageColorMetadata GetOutputColorMetadata(CWinSystemBase& winSystem)
   ImageColorMetadata color;
   // With native Dolby Vision output a capture is of the picture before it is packed for the
   // link (CWinSystemBase::HasCaptureFramebuffer()), not of what the display mode says.
+  // (Hades: HDR over the tunnel of an HLG video holds it in HLG there, as the output signals it)
   if (winSystem.HasCaptureFramebuffer())
   {
     color.primaries = AVCOL_PRI_BT2020;
-    color.transfer = AVCOL_TRC_SMPTE2084;
+    color.transfer =
+        winSystem.GetEotf() == Eotf::HLG ? AVCOL_TRC_ARIB_STD_B67 : AVCOL_TRC_SMPTE2084;
     color.range = AVCOL_RANGE_JPEG;
     return color;
   }
diff --git a/xbmc/rendering/capture/test/TestCaptureMetadata.cpp b/xbmc/rendering/capture/test/TestCaptureMetadata.cpp
index a58e1b7..785f84e 100644
--- a/xbmc/rendering/capture/test/TestCaptureMetadata.cpp
+++ b/xbmc/rendering/capture/test/TestCaptureMetadata.cpp
@@ -24,7 +24,11 @@ namespace
 class CTestWinSystem : public CWinSystemBase
 {
 public:
-  explicit CTestWinSystem(KODI::UTILS::Eotf eotf) : m_eotf(eotf) {}
+  explicit CTestWinSystem(KODI::UTILS::Eotf eotf, bool captureFramebuffer = false)
+    : m_eotf(eotf),
+      m_captureFramebuffer(captureFramebuffer)
+  {
+  }
 
   bool CreateNewWindow(const std::string& name, bool fullScreen, RESOLUTION_INFO& res) override
   {
@@ -39,9 +43,11 @@ public:
   void Unregister(IDispResource* resource) override {}
   bool UseLimitedColor() override { return false; }
   KODI::UTILS::Eotf GetEotf() const override { return m_eotf; }
+  bool HasCaptureFramebuffer() const override { return m_captureFramebuffer; }
 
 private:
   const KODI::UTILS::Eotf m_eotf;
+  const bool m_captureFramebuffer;
 };
 } // namespace
 
@@ -59,3 +65,20 @@ TEST(TestCaptureMetadata, TagsPqAsPq)
   CTestWinSystem winSystem(KODI::UTILS::Eotf::PQ);
   EXPECT_EQ(GetOutputColorMetadata(winSystem).transfer, AVCOL_TRC_SMPTE2084);
 }
+
+// Hades: the framebuffer of native Dolby Vision is PQ; that of HDR over the tunnel of an HLG
+// video is HLG, as the output signals it
+TEST(TestCaptureMetadata, CaptureFramebufferIsPq)
+{
+  CTestWinSystem winSystem(KODI::UTILS::Eotf::TRADITIONAL_SDR, true);
+  const ImageColorMetadata color = GetOutputColorMetadata(winSystem);
+  EXPECT_EQ(color.primaries, AVCOL_PRI_BT2020);
+  EXPECT_EQ(color.transfer, AVCOL_TRC_SMPTE2084);
+  EXPECT_EQ(color.range, AVCOL_RANGE_JPEG);
+}
+
+TEST(TestCaptureMetadata, CaptureFramebufferOfHlgIsHlg)
+{
+  CTestWinSystem winSystem(KODI::UTILS::Eotf::HLG, true);
+  EXPECT_EQ(GetOutputColorMetadata(winSystem).transfer, AVCOL_TRC_ARIB_STD_B67);
+}
diff --git a/xbmc/windowing/WinSystem.h b/xbmc/windowing/WinSystem.h
index 339c8c9..c167985 100644
--- a/xbmc/windowing/WinSystem.h
+++ b/xbmc/windowing/WinSystem.h
@@ -187,7 +187,8 @@ public:
    * packed for the HDMI link, which is no picture to look at. The picture itself, the video and
    * the GUI over it, is then in a framebuffer of its own: floating-point components, full
    * range, BT.2020 primaries and the PQ transfer, of the size of the output, its first row the
-   * top one.
+   * top one. (Hades: HDR over the tunnel of an HLG video has it in HLG, the transfer that
+   * GetEotf() says then.)
    */
   virtual bool HasCaptureFramebuffer() const { return false; }
   /*!
