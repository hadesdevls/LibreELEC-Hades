From cf4bf043b93701783e8b50d2348ab0f21de5aef8 Mon Sep 17 00:00:00 2001
From: Hades <15710513+hadesdevls@users.noreply.github.com>
Date: Wed, 18 Nov 2026 06:34:56 +0000
Subject: [PATCH] tools/hades-playerinfo: the folder of the upscalers is not
 the script's

The mpv shaders of the upscalers are in system/hades/upscalers, beside
what make-playerinfo.py makes from Estuary, and its check took that
folder for something it should have written. It leaves the folder alone
now, and the README of system/hades says what it holds.
---
 system/hades/README.txt                   |  3 +++
 tools/hades-playerinfo/make-playerinfo.py | 10 ++++++++--
 2 files changed, 11 insertions(+), 2 deletions(-)

diff --git a/system/hades/README.txt b/system/hades/README.txt
index 6baedc6..d6a4bec 100644
--- a/system/hades/README.txt
+++ b/system/hades/README.txt
@@ -16,3 +16,6 @@ licence (https://creativecommons.org/licenses/by-sa/4.0/), and so are these copi
 HadesIncludes.xml and DialogHadesPlayerInfo.xml are made of Estuary's code, which is licensed under the GNU General
 Public License, version 2.0, and they are under that licence; what the script adds to them is Copyright (C) 2026
 Hades. Estuary's licence: addons/skin.estuary/LICENSE.txt of Kodi's source.
+
+The folder upscalers is not made by the script: the mpv shaders of the upscalers of the Dolby Vision bridge,
+unmodified, with where they come from and their licences (upscalers/SOURCES.md).
diff --git a/tools/hades-playerinfo/make-playerinfo.py b/tools/hades-playerinfo/make-playerinfo.py
index 61604c7..341c7b7 100644
--- a/tools/hades-playerinfo/make-playerinfo.py
+++ b/tools/hades-playerinfo/make-playerinfo.py
@@ -399,7 +399,10 @@ outputs["README.txt"] = (
     "\n"
     "HadesIncludes.xml and DialogHadesPlayerInfo.xml are made of Estuary's code, which is licensed under the GNU General\n"
     "Public License, version 2.0, and they are under that licence; what the script adds to them is Copyright (C) 2026\n"
-    "Hades. Estuary's licence: addons/skin.estuary/LICENSE.txt of Kodi's source.\n")
+    "Hades. Estuary's licence: addons/skin.estuary/LICENSE.txt of Kodi's source.\n"
+    "\n"
+    "The folder upscalers is not made by the script: the mpv shaders of the upscalers of the Dolby Vision bridge,\n"
+    "unmodified, with where they come from and their licences (upscalers/SOURCES.md).\n")
 
 check = "--check" in sys.argv
 stale = []
@@ -416,7 +419,10 @@ for name, data in outputs.items():
             os.makedirs(OUT, exist_ok=True)
             with open(path, "wb" if mode == "rb" else "w", **({} if mode == "rb" else {"encoding": "utf-8"})) as f:
                 f.write(data)
-extra = sorted(set(os.listdir(OUT)) - set(outputs)) if os.path.isdir(OUT) else []
+# (folders of system/hades that another part of Hades puts there, which the script leaves alone: the mpv shaders of
+# the upscalers, tools/dvbridge/dvbridge_upscale.c)
+OTHERS = {"upscalers"}
+extra = sorted(set(os.listdir(OUT)) - set(outputs) - OTHERS) if os.path.isdir(OUT) else []
 print("make-playerinfo: %d variables, %d maps, %d includes, %d textures; %s" % (
     len(used_vars), len(maps_out), len(INCLUDES), len(TEXTURES),
     ("stale: " + ", ".join(stale)) if stale else "up to date"))
-- 
2.53.0

