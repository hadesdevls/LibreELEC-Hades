From 5e28770d3542b5d341e86a66e26c8f103ba00c9d Mon Sep 17 00:00:00 2001
From: Hades <15710513+hadesdevls@users.noreply.github.com>
Date: Thu, 19 Nov 2026 00:40:01 +0000
Subject: [PATCH] [Hades][GBM] HDR10+ at its own rate with VRR where the driver
 has a slot for it next to the VRR packet

"Video at its own rate with VRR" (with the setting, or on its own where the display has no mode at the
video's rate) left HDR10+ out: on Turing and Ampere the EMP of HDMI VRR takes the one InfoFrame slot of
HDR10+. On Ada and Blackwell it does not: NVKMS sends HDR10+ in shared generic slot 2 next to the EMP
in the generic one on AD10x, in shared generic slot 9 on Blackwell (nvHadesHdr10PlusHdmiSlot()), and the
RTX 4080 SUPER did so with 1.0 (an HDR10+ video on a Samsung Odyssey G60SD:
"HDR10+ InfoFrame on head 3, in shared generic slot 2 (HDMI VRR sends its EMP in the generic one)").
The G60SD has no mode of 24 Hz: HDR10+ went at a fixed 359.999 Hz.

The driver says it now: NV_HDR10PLUS_WITH_VRR, read-only, of the connector
(nvidia-open-kernel-modules-9082), 1 where HDR10+ goes out over HDMI next to the EMP.
- VRR_VIDEO::Decide() takes HDR10+ where the query has it (Query::hdr10PlusWithVrr), as SDR and
  HDR10, with the same check that VRR came on (NV_VRR_ACTIVE) and the same way back where it did not.
  Dolby Vision, HLG and HDR10+ where the driver does not say it stay as they were.
- CHdmiVrrOff::Wanted() no longer leaves HDMI VRR off in the mode set of an HDR10+ video where the driver
  says it (withVrrSlot): there it gained HDR10+ nothing and took VRR from the video (the depth of HDR is
  a mode set on NVIDIA). Turing and Ampere: as before.
- The HDR10+ InfoFrame is what it was: the flip that carries the metadata of a picture writes it
  (nvHadesUpdateHdr10Plus() from the flip of NVKMS, every frame in its slot), with VRR or without.
- kodi.log says "VRR video: HDR10+ goes out next to the VRR packet (NV_HDR10PLUS_WITH_VRR 1)"; the kernel
  log says both packets, the VTEM in the generic slot and the HDR10+ InfoFrame in its own.

Checked: the host tests (vrr_video_test.cpp, vrr_test.cpp: HDR10+ with and without the slot, Dolby
Vision and HLG still out; Wanted() with the slot), which do not build against the headers before this
change, and their mutants; the changed files and the sources that include them compile with the
commands of the image's build. Not run on a GPU.
---
 xbmc/windowing/gbm/HdmiVrrOff.h     | 10 +++++++---
 xbmc/windowing/gbm/VrrVideo.h       | 21 ++++++++++++++++-----
 xbmc/windowing/gbm/WinSystemGbm.cpp | 21 ++++++++++++++-------
 3 files changed, 37 insertions(+), 15 deletions(-)

diff --git a/xbmc/windowing/gbm/HdmiVrrOff.h b/xbmc/windowing/gbm/HdmiVrrOff.h
index daf5832..ce1f984 100644
--- a/xbmc/windowing/gbm/HdmiVrrOff.h
+++ b/xbmc/windowing/gbm/HdmiVrrOff.h
@@ -101,16 +101,20 @@ public:
    *        the request is the commit of the mode of the video (withMode); the video sends HDR10+
    *        (hdr10Plus: a payload that goes out to the display, or Dolby Vision sent as HDR10+ that
    *        will have one); the display declares HDMI VRR; and the mode is one NVKMS would turn HDMI
-   *        VRR on in (nvGetAllowedDpyVrrType(): vVisible 720 or more, RRx1k 50000 or more)
+   *        VRR on in (nvGetAllowedDpyVrrType(): vVisible 720 or more, RRx1k 50000 or more).
+   *        Not where the driver sends HDR10+ in a slot that the EMP of HDMI VRR does not take
+   *        (withVrrSlot: NV_HDR10PLUS_WITH_VRR, nvidia-open-kernel-modules-9082: Ada, Blackwell),
+   *        where VRR off would gain nothing for HDR10+ and take VRR from the video.
    */
   static bool Wanted(bool property,
                      bool withMode,
                      bool hdr10Plus,
                      bool displayVrr,
                      int vdisplay,
-                     int64_t refreshMilliHz)
+                     int64_t refreshMilliHz,
+                     bool withVrrSlot = false)
   {
-    return property && withMode && hdr10Plus && displayVrr && vdisplay >= 720 &&
+    return property && withMode && hdr10Plus && displayVrr && !withVrrSlot && vdisplay >= 720 &&
            refreshMilliHz >= 50000;
   }
 
diff --git a/xbmc/windowing/gbm/VrrVideo.h b/xbmc/windowing/gbm/VrrVideo.h
index 128d890..4b82062 100644
--- a/xbmc/windowing/gbm/VrrVideo.h
+++ b/xbmc/windowing/gbm/VrrVideo.h
@@ -51,7 +51,10 @@ namespace KODI::WINDOWING::GBM::VRR_VIDEO
  * (Automatic(); AutoForDisplay() leaves VRR to the driver in the mode sets of the menus of such a
  * display). A display with modes at the video's rate keeps its change of mode.
  *
- * Never for Dolby Vision (native output, or a video that says it is Dolby Vision), HDR10+, HLG, 3D,
+ * HDR10+ only where the driver sends its InfoFrame in a slot that the VRR packet does not take
+ * (NV_HDR10PLUS_WITH_VRR of nvidia-drm, nvidia-open-kernel-modules-9082: Ada and Blackwell; on
+ * Turing and Ampere the EMP of HDMI VRR takes the one slot of HDR10+). Never for Dolby Vision (native
+ * output, or a video that says it is Dolby Vision), HDR10+ elsewhere, HLG, 3D,
  * a video not known to be progressive, or a video whose kind is not known: those change the mode as
  * before, and so does anything this cannot do exactly (Decide()). Nothing of Kodi is here: a test
  * runs it on the host.
@@ -62,6 +65,9 @@ constexpr const char* SETTING = "videoscreen.hadesvrrvideo";
 constexpr const char* FLIP_TIME_RAW_NS = "NV_FLIP_TIME_RAW_NS";
 //! nvidia-drm: Media VRR for the mode set of the head, where the GPU has it (same patch)
 constexpr const char* VRR_MEDIA = "NV_VRR_MEDIA";
+//! nvidia-drm, read-only, of the connector: 1 where HDR10+ goes out over HDMI in a slot that the
+//! EMP of HDMI VRR does not take (nvidia-open-kernel-modules-9082)
+constexpr const char* HDR10PLUS_WITH_VRR = "NV_HDR10PLUS_WITH_VRR";
 //! nvidia-drm: the rate of Media VRR that the flips ask for (Hz << 1, bit 0 for 1.001)
 constexpr const char* MEDIA_TARGET = "NV_VRR_MEDIA_TARGET";
 //! nvidia-drm, read-only: whether the last flip of the head went out with VRR active in NVKMS (bit 0),
@@ -191,6 +197,8 @@ struct Query
   bool hdmiVrrOffInMode = false;
   bool flipTime = false; //!< the CRTC has NV_FLIP_TIME_RAW_NS
   bool media = false; //!< the CRTC has NV_VRR_MEDIA_TARGET, and NV_VRR_MEDIA is 1 in its mode
+  //! the connector's NV_HDR10PLUS_WITH_VRR is 1: HDR10+ goes out next to the VRR packet
+  bool hdr10PlusWithVrr = false;
   int vrrMin = 0; //!< the display's VRR range, in Hz (0: not known)
   int vrrMax = 0;
   float guiRefresh = 0.0f; //!< the mode of the menus, which stays
@@ -223,11 +231,14 @@ inline Verdict Decide(const Query& q)
     return v;
   if (q.nativeDV || q.video == WholeMultipleVideo::DOLBY_VISION)
     v.why = "the video is Dolby Vision, which keeps the change of mode it always had";
-  else if (q.video == WholeMultipleVideo::HDR10PLUS)
-    v.why = "the video is HDR10+: only SDR and HDR10 go at their own rate";
+  else if (q.video == WholeMultipleVideo::HDR10PLUS && !q.hdr10PlusWithVrr)
+    v.why = "the video is HDR10+, and the driver has no slot for its InfoFrame next to the VRR "
+            "packet (NV_HDR10PLUS_WITH_VRR is not 1: Turing and Ampere, or another driver)";
   else if (q.video == WholeMultipleVideo::HLG)
-    v.why = "the video is HLG: only SDR and HDR10 go at their own rate";
-  else if (!WholeMultipleVideoTakes(q.video))
+    v.why = "the video is HLG: only SDR, HDR10 and HDR10+ (where the driver says so) go at "
+            "their own rate";
+  else if (!WholeMultipleVideoTakes(q.video) &&
+           !(q.video == WholeMultipleVideo::HDR10PLUS && q.hdr10PlusWithVrr))
     v.why = "what the video is was not told";
   else if (q.is3D)
     v.why = "the video is 3D";
diff --git a/xbmc/windowing/gbm/WinSystemGbm.cpp b/xbmc/windowing/gbm/WinSystemGbm.cpp
index 322788b..2e08d55 100644
--- a/xbmc/windowing/gbm/WinSystemGbm.cpp
+++ b/xbmc/windowing/gbm/WinSystemGbm.cpp
@@ -4266,6 +4266,7 @@ bool CWinSystemGbm::TakeVideoAtOwnRate(float fps,
     q.nvidia = q.flipTime || connector->SupportsProperty(CHdmiVrrOff::PROPERTY);
     q.media = crtc->SupportsProperty(MEDIA_TARGET) && crtc->GetPropertyValue(VRR_MEDIA) == 1u;
     q.hdmiVrrOffInMode = connector->GetPropertyValue(CHdmiVrrOff::PROPERTY) == 1u;
+    q.hdr10PlusWithVrr = connector->GetPropertyValue(HDR10PLUS_WITH_VRR) == 1u;
   }
   q.hdmiVrrAllowed = HdmiVrrAllowedBySetting();
   if (const auto info = DisplayInfo())
@@ -4338,6 +4339,13 @@ bool CWinSystemGbm::TakeVideoAtOwnRate(float fps,
   else if (tell)
     CLog::Log(LOGINFO, "VRR video: {:.3f} fps changes the mode as before: {}", fps,
               v.why ? v.why : "not chosen");
+  if (tell && v.use && video == WholeMultipleVideo::HDR10PLUS)
+    CLog::Log(
+        LOGINFO,
+        "VRR video: HDR10+ goes out next to the VRR packet ({} 1): the kernel log says each "
+        "packet, the VTEM of HDMI VRR in the generic slot and the HDR10+ InfoFrame in its own "
+        "(\"shared generic slot 2\" on Ada, 9 on Blackwell), every frame",
+        HDR10PLUS_WITH_VRR);
   if (v.use)
     gui = menus;
   return v.use;
@@ -5327,8 +5335,8 @@ void CWinSystemGbm::SetHDR10Plus(const std::optional<std::array<uint8_t, 27>>& o
                                          drm->RequestValue(connector, "HDR_OUTPUT_METADATA"));
 
   // Hades: HDMI VRR left off in that commit, where its EMP would take the slot of HDR10+ (Turing
-  // and Ampere; on Ada and Blackwell it changes nothing for HDR10+: CHdmiVrrOff), for a video that
-  // sends HDR10+ to this display
+  // and Ampere; not where the driver says that HDR10+ has a slot next to it, NV_HDR10PLUS_WITH_VRR:
+  // Ada and Blackwell, CHdmiVrrOff::Wanted()), for a video that sends HDR10+ to this display
   if (output.withMode && connector->SupportsProperty(CHdmiVrrOff::PROPERTY))
   {
     const auto* mode = drm->GetSelectedMode();
@@ -5338,11 +5346,10 @@ void CWinSystemGbm::SetHDR10Plus(const std::optional<std::array<uint8_t, 27>>& o
                  : HDR10PlusExpected());
     m_hdmiVrrOffWanted =
         m_hdmiVrrOffWanted ||
-        CHdmiVrrOff::Wanted(true, true, sends, info && info->SupportsHdmiVrr(),
-                            mode ? mode->vdisplay : 0,
-                            mode ? CHdmiVrrOff::RefreshMilliHz(mode->clock, mode->htotal,
-                                                               mode->vtotal)
-                                 : 0);
+        CHdmiVrrOff::Wanted(
+            true, true, sends, info && info->SupportsHdmiVrr(), mode ? mode->vdisplay : 0,
+            mode ? CHdmiVrrOff::RefreshMilliHz(mode->clock, mode->htotal, mode->vtotal) : 0,
+            connector->GetPropertyValue(VRR_VIDEO::HDR10PLUS_WITH_VRR) == 1u);
   }
 
   if (payload && output.pq && output.display && !output.driver &&
-- 
