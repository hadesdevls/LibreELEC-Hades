From 3a67cf6eb32dce2c278e196cd755a8d047ce8b6a Mon Sep 17 00:00:00 2001
From: olympia <olympia@xbmc.org>
Date: Thu, 19 Nov 2026 23:45:29 +0100
Subject: [PATCH] [Video] Look up a refreshed movie with the current smart
 playlist path

After an open smart playlist is edited from its context menu, Refresh()
keeps the filter path, so it still holds the library path of the
playlist as it was first listed. The lookup of a refreshed movie used
that path, with the old rules and without a newly added limit, and could
keep a movie in place that the edited playlist no longer lists.

Take the library path from the path.db property of the listing, which
every load sets again. Without it the list gets a full refresh.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
(cherry picked from commit b45a29adfa191c0c6f143415969e1dd4eaad3ddb)
---
 xbmc/video/windows/GUIWindowVideoBase.cpp | 7 ++++---
 1 file changed, 4 insertions(+), 3 deletions(-)

diff --git a/xbmc/video/windows/GUIWindowVideoBase.cpp b/xbmc/video/windows/GUIWindowVideoBase.cpp
index f9b6290..26f9a3e 100644
--- a/xbmc/video/windows/GUIWindowVideoBase.cpp
+++ b/xbmc/video/windows/GUIWindowVideoBase.cpp
@@ -696,9 +696,10 @@ bool CGUIWindowVideoBase::UpdateMovieListItem(const std::string& listItemPath,
     if (!m_database.Open())
       return false;
 
-    // the filter path holds the library path a smart playlist was listed from
-    const std::string dbPath{VIDEO::IsVideoDb(*m_vecItems) ? m_vecItems->GetPath()
-                                                           : m_strFilterPath};
+    // path.db holds the library path of a smart playlist listing
+    const std::string dbPath{VIDEO::IsVideoDb(*m_vecItems)
+                                 ? m_vecItems->GetPath()
+                                 : m_vecItems->GetProperty("path.db").asString()};
     if (URIUtils::IsVideoDb(dbPath))
     {
       // a query by id finds the movie even when a limit leaves it out of the listing
