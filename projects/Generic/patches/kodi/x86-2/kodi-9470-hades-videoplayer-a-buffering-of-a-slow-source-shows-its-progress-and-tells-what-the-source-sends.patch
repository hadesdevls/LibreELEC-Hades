diff --git a/xbmc/cores/VideoPlayer/SourceRate.h b/xbmc/cores/VideoPlayer/SourceRate.h
new file mode 100644
index 0000000..33bc09a
--- /dev/null
+++ b/xbmc/cores/VideoPlayer/SourceRate.h
@@ -0,0 +1,70 @@
+/*
+ *  Copyright (C) 2026 Hades
+ *  This file is part of LibreELEC Hades. It is not in Kodi as Team Kodi publishes it.
+ *
+ *  SPDX-License-Identifier: GPL-2.0-or-later
+ *  See LICENSES/README.md for more information.
+ */
+
+#pragma once
+
+#include <algorithm>
+#include <cstdint>
+
+/*!
+ * \brief Hades: what the source of a cached input (CFileCache: a network share, HTTP) sends while
+ *        the player buffers, and what the skin shows of that buffering
+ *
+ * After a seek the player buffers (CACHESTATE_FULL) until what the cache and its queues hold lasts
+ * longer than its queue time (HandlePlaySpeed(): CacheInfo::time). The skin shows that buffering
+ * with Player.CacheLevel, which was the read-ahead level of the cache alone (the bytes ahead of the
+ * reader over the 1.5 GiB that a cache of 2 GiB keeps ahead). While a slow source sends, the
+ * demuxer takes every byte as it comes: that level stays at 0, Estuary shows its ring only above 0,
+ * and the picture stood still with nothing on it. A laptop that played a 3D film of 3840x2160 at 48
+ * frames a second over Wi-Fi from a network share waited 14.7 s so after a seek of 30 minutes, then
+ * played at a third of its speed: its source sent less than the film takes.
+ *
+ * So, while the player buffers, the level is how far it got to playing on (Progress()), and what
+ * the source sends is measured from where the input is and what the cache holds ahead of it, from
+ * the first pass of the buffering to its end: kodi.log says it once the buffering ends, and where
+ * the source sent less than the video takes on average (its length over its duration) for
+ * TELL_AFTER_MS, the user is told once a file that the source is slower than the video.
+ */
+namespace SOURCE_RATE
+{
+
+//! Megabits a second of `bytes` in `ms` milliseconds (0 without a time)
+constexpr double Mbits(int64_t bytes, int64_t ms)
+{
+  return ms > 0 ? static_cast<double>(bytes) * 8.0 / (static_cast<double>(ms) * 1000.0) : 0.0;
+}
+
+/*!
+ * \brief The level that the skin shows while the player buffers, [0, 1]
+ * \param level the read-ahead level of the cache (CacheInfo::level; -1 where Kodi found the source
+ *        too slow once the cache was full)
+ * \param time the seconds that the cache and the queues hold (CacheInfo::time)
+ * \param queueSeconds the queue time that the player waits for (m_messageQueueTimeSize)
+ */
+constexpr double Progress(double level, double time, double queueSeconds)
+{
+  const double toPlay = queueSeconds > 0 ? time / queueSeconds : 0.0;
+  return std::clamp(std::max(level, toPlay), 0.0, 1.0);
+}
+
+//! A buffering that lasts this long, with a source slower than the video, is told to the user
+constexpr int64_t TELL_AFTER_MS = 3000;
+
+/*!
+ * \brief The source sent less than the video takes, over a buffering long enough to tell it
+ * \param elapsedMs since the first pass of the buffering
+ * \param bytes what came from the source meanwhile (< 0: not known)
+ * \param neededBytesPerSecond what the video takes on average (its length over its duration)
+ */
+constexpr bool Slower(int64_t elapsedMs, int64_t bytes, uint32_t neededBytesPerSecond)
+{
+  return elapsedMs >= TELL_AFTER_MS && neededBytesPerSecond > 0 && bytes >= 0 &&
+         bytes * 1000 < static_cast<int64_t>(neededBytesPerSecond) * elapsedMs;
+}
+
+} // namespace SOURCE_RATE
diff --git a/xbmc/cores/VideoPlayer/VideoPlayer.cpp b/xbmc/cores/VideoPlayer/VideoPlayer.cpp
index 32df5f1..66e0830 100644
--- a/xbmc/cores/VideoPlayer/VideoPlayer.cpp
+++ b/xbmc/cores/VideoPlayer/VideoPlayer.cpp
@@ -1092,6 +1092,8 @@ bool CVideoPlayer::OpenInputStream()
   // Hades: and what the closed one held for its BD-J application, or showed with no picture
   m_bdjStamps.clear();
   m_renderManager.SetDiscMenuWithoutPicture(nullptr);
+  // Hades: and what was measured of its source (SourceRate.h)
+  m_buffering = BufferingState{};
 
   CLog::Log(LOGINFO, "Creating InputStream");
 
@@ -3037,6 +3039,62 @@ void CVideoPlayer::InputWaitEnded()
   m_inputWait = InputWaitState{};
 }
 
+void CVideoPlayer::WatchBuffering(bool ends)
+{
+  // Hades: SourceRate.h. What came from the source: where the input is, and what the cache holds
+  // ahead of it, against the same at the first pass of the buffering.
+  XFILE::SCacheStatus status;
+  const int64_t position = m_pInputStream ? m_pInputStream->Seek(0, SEEK_CUR) : -1;
+  if (position < 0 || !m_pInputStream->GetCacheStatus(&status))
+  {
+    m_buffering.since.reset();
+    return;
+  }
+  const int64_t bytes = position + static_cast<int64_t>(status.forward);
+  const auto now = std::chrono::steady_clock::now();
+  if (!m_buffering.since)
+  {
+    if (!ends)
+    {
+      m_buffering.since = now;
+      m_buffering.startBytes = bytes;
+    }
+    return;
+  }
+  const int64_t ms =
+      std::chrono::duration_cast<std::chrono::milliseconds>(now - *m_buffering.since).count();
+  const int64_t sent = bytes - m_buffering.startBytes;
+  const double needed = SOURCE_RATE::Mbits(status.maxrate, 1000);
+  if (ends)
+  {
+    m_buffering.since.reset();
+    m_buffering.startBytes = -1;
+    if (ms >= 1000 && sent >= 0)
+      CLog::Log(LOGINFO,
+                "VideoPlayer: the player buffered for {} ms; its source sent {:.1f} MB meanwhile "
+                "({:.1f} Mbit/s), and this video takes {:.1f} Mbit/s on average{}",
+                ms, static_cast<double>(sent) / 1e6, SOURCE_RATE::Mbits(sent, ms), needed,
+                SOURCE_RATE::Mbits(sent, ms) < needed ? ": the source is slower than the video"
+                                                      : "");
+    return;
+  }
+  if (m_buffering.told || !SOURCE_RATE::Slower(ms, sent, status.maxrate))
+    return;
+  m_buffering.told = true;
+  const double rate = SOURCE_RATE::Mbits(sent, ms);
+  CLog::Log(LOGINFO,
+            "VideoPlayer: the source sent {:.1f} Mbit/s in the {} ms that the player has buffered, "
+            "less than the {:.1f} Mbit/s that this video takes on average: playback waits for it, "
+            "and the user is told (once a file)",
+            rate, ms, needed);
+  CGUIDialogKaiToast::QueueNotification(CGUIDialogKaiToast::Info,
+                                        CGUIUtils::GetHadesString(62869, 54928),
+                                        StringUtils::Format(CGUIUtils::GetHadesString(62870, 54929),
+                                                            StringUtils::Format("{:.1f}", rate),
+                                                            StringUtils::Format("{:.1f}", needed)),
+                                        8000, false);
+}
+
 void CVideoPlayer::HandlePlaySpeed()
 {
   const bool isInMenu = IsInMenuInternal();
@@ -3048,6 +3106,8 @@ void CVideoPlayer::HandlePlaySpeed()
 
   if (m_caching == CACHESTATE_FULL)
   {
+    // Hades: what the source sends while the player buffers (SourceRate.h)
+    WatchBuffering(false);
     CacheInfo cache = GetCachingTimes();
     if (cache.valid)
     {
@@ -4948,6 +5008,10 @@ void CVideoPlayer::HandleMessages()
 
 void CVideoPlayer::SetCaching(ECacheState state)
 {
+  // Hades: a buffering ends, or a seek begins another one (SourceRate.h)
+  if (state == CACHESTATE_FLUSH || (m_caching == CACHESTATE_FULL && state != CACHESTATE_FULL))
+    WatchBuffering(true);
+
   if(state == CACHESTATE_FLUSH)
   {
     CacheInfo cache = GetCachingTimes();
@@ -8042,7 +8106,11 @@ void CVideoPlayer::UpdatePlayState(double timeout)
 
   if (cache.valid)
   {
-    state.cache_level = std::max(0.0, std::min(1.0, cache.level));
+    // Hades: while the player buffers, how far it got to playing on; the read-ahead level of the
+    // cache alone stays at 0 while a slow source sends, and the skin showed nothing (SourceRate.h)
+    state.cache_level = state.caching
+                            ? SOURCE_RATE::Progress(cache.level, cache.time, m_messageQueueTimeSize)
+                            : std::max(0.0, std::min(1.0, cache.level));
     state.cache_offset = cache.offset;
     state.cache_time = cache.time;
   }
diff --git a/xbmc/cores/VideoPlayer/VideoPlayer.h b/xbmc/cores/VideoPlayer/VideoPlayer.h
index 1a6758d..051a071 100644
--- a/xbmc/cores/VideoPlayer/VideoPlayer.h
+++ b/xbmc/cores/VideoPlayer/VideoPlayer.h
@@ -16,6 +16,7 @@
 #include "IVideoPlayer.h"
 #include "SeekLeftOut.h"
 #include "SeekPending.h"
+#include "SourceRate.h"
 #include "SubtitleSeekSearch.h"
 #include "VideoOnlyReopen.h"
 #include "VideoPlayerAudioID3.h"
@@ -855,6 +856,16 @@ protected:
     std::optional<std::chrono::milliseconds> toldAt; // the notification, last at this wait
   } m_inputWait;
 
+  //! Hades: a buffering of a cached input, and what its source sent meanwhile (SourceRate.h)
+  struct BufferingState
+  {
+    std::optional<std::chrono::steady_clock::time_point> since; // its first pass
+    int64_t startBytes{-1}; // where the input was, and what the cache held ahead of it, then
+    bool told{false}; // the user was told that the source is slower than the video (once a file)
+  } m_buffering;
+  //! Hades: on each pass of a buffering (ends: false), and as it ends (true)
+  void WatchBuffering(bool ends);
+
   //! Hades: SupersedeHeldFile(). A read of a packet takes milliseconds; one that has lasted this
   //! long waits for its drive or its source.
   static constexpr std::chrono::milliseconds HELD_READ{500};
