From 5c8971932bd67cfb2144d73250a59ce0aa8bbda2 Mon Sep 17 00:00:00 2001
From: Hades <15710513+hadesdevls@users.noreply.github.com>
Date: Wed, 18 Nov 2026 05:40:05 +0000
Subject: [PATCH] tools/dvbridge: a plain HDR10 picture mapped by its own
 scene, as measured

Where Hades maps an HDR10 picture itself (to SDR, or adapted to the
display, such as a projector), it maps it by the static metadata of
the whole film: the mastering display's peak, or MaxCLL. Every scene
is then compressed as if it held the brightest highlight of the film,
which a scene seldom does. A Dolby Vision picture shown the same way is
mapped by its level 1 instead, the brightest and the average of its own
scene, and libplacebo maps an HDR10 picture the same way when it is
given those values (PL_HDR_METADATA_CIE_Y).

dvbridge_plain::scene carries them, and render_hdr10() gives them to
libplacebo for a plain PQ picture that is mapped and has no HDR10+
statistics (the studio's own come first). Values that do not hold (out
of (0, 1], an average above the brightest) are not taken, and the
picture is mapped by its static metadata, bit for bit as before.
Without dynamic_target (libplacebo-9943): the curve maps to the
display's peak.

dvbridge_scene_map decides the values a picture is mapped by from the
measurement of each picture (dvbridge_measured.c, as for HDR10 measured
as Dolby Vision), so that the picture does not pump within a scene: at
a cut, or the first measurement, it takes the scene's values at once;
within a scene it follows a change only beyond a band of 32 codes (of
4095, PQ), and then by at most 4 codes a picture; a picture not
measured in time keeps the values of the one before it; a seek starts
again. Tested on the host: the band, the rate and the cuts each make
the test fail when taken out.
---
 tools/dvbridge/CMakeLists.txt       |  2 +-
 tools/dvbridge/dvbridge_render.c    | 23 +++++++
 tools/dvbridge/dvbridge_render.h    | 10 ++++
 tools/dvbridge/dvbridge_scene_map.c | 93 +++++++++++++++++++++++++++++
 tools/dvbridge/dvbridge_scene_map.h | 63 +++++++++++++++++++
 5 files changed, 190 insertions(+), 1 deletion(-)
 create mode 100644 tools/dvbridge/dvbridge_scene_map.c
 create mode 100644 tools/dvbridge/dvbridge_scene_map.h

diff --git a/tools/dvbridge/CMakeLists.txt b/tools/dvbridge/CMakeLists.txt
index f340f1b..ed4e2a4 100644
--- a/tools/dvbridge/CMakeLists.txt
+++ b/tools/dvbridge/CMakeLists.txt
@@ -19,7 +19,7 @@ add_library(dvbridge_core STATIC dvbridge_core.c dvbridge_placebo.c dvbridge_ren
                                 dvbridge_source.c dvbridge_probe.c dvbridge_hdr10plus.c
                                 dvbridge_measure.c dvbridge_measured.c
                                 dvbridge_dvplus.c dvbridge_dvplus_gl.c dvbridge_graphics.c
-                                dvbridge_upscale.c)
+                                dvbridge_upscale.c dvbridge_scene_map.c)
 set_target_properties(dvbridge_core PROPERTIES POSITION_INDEPENDENT_CODE ON C_STANDARD 11)
 target_include_directories(dvbridge_core PUBLIC "${CMAKE_CURRENT_SOURCE_DIR}")
 target_link_libraries(dvbridge_core PUBLIC PkgConfig::DVPlacebo PkgConfig::DVAvutil
diff --git a/tools/dvbridge/dvbridge_render.c b/tools/dvbridge/dvbridge_render.c
index d5a0188..cb327b2 100644
--- a/tools/dvbridge/dvbridge_render.c
+++ b/tools/dvbridge/dvbridge_render.c
@@ -2511,6 +2511,25 @@ static bool value_within(float v, float lo, float hi)
     return isfinite(v) && v >= lo && v <= hi;
 }
 
+/* Hades: the mapping of a plain PQ picture (map_to_display(), already made) guided by its own scene as measured
+ * (dvbridge_plain::scene, dvbridge_scene_map.h): libplacebo is given the brightest and the average of the scene as
+ * the CIE Y metadata it maps by, as display_mapping() gives it the level 1 of a Dolby Vision picture shown as
+ * HDR10, instead of the static metadata of the whole film (the gamut of its mastering display still bounds the
+ * colours). The mapping asks for any metadata (PL_HDR_METADATA_ANY, display_mapping()), and libplacebo takes the
+ * CIE Y pair over the static values wherever both are above 0 (pl_color_space_nominal_luma_ex()). A scene that
+ * does not hold (a value outside (0, 1], an average above the brightest) is not taken: the picture is mapped by its
+ * static metadata, as before, bit for bit. The tone curve's table is made again only where the values change
+ * (pl_tone_map_params_equal()), which within a scene is rarely (dvbridge_scene_map.c); the gamut table does not
+ * depend on them. Without dynamic_target (libplacebo-9943): the curve maps to the display's peak. */
+static void map_scene(struct pl_color_space *source, const struct dvbridge_plain *p)
+{
+    if (!p->scene.present || !value_within(p->scene.max_pq, 0.0f, 1.0f) || !(p->scene.max_pq > 0.0f) ||
+        !value_within(p->scene.avg_pq, 0.0f, p->scene.max_pq) || !(p->scene.avg_pq > 0.0f))
+        return;
+    source->hdr.max_pq_y = p->scene.max_pq;
+    source->hdr.avg_pq_y = p->scene.avg_pq;
+}
+
 void dvbridge_render_set_upscaler(struct dvbridge_renderer *r, const struct dvbridge_upscaler *u)
 {
     if (!r)
@@ -3027,6 +3046,10 @@ static bool render_hdr10(struct dvbridge_renderer *r, const struct pl_frame *sou
         /* Hades: a plain PQ picture with HDR10+ metadata: guided by them (dvbridge_hdr10plus_map.h) */
         if (plain && !plain->hlg)
             map_hdr10plus(r, &r->hdr10_mapping, &image.color, &mapping, &plain->hdr10plus, false);
+        /* Hades: ... or, without them, by its own scene as measured (dvbridge_plain::scene), as a Dolby Vision
+         * picture is by its level 1 */
+        if (plain && !plain->hlg && !plain->hdr10plus.present)
+            map_scene(&image.color, plain);
         params.color_map_params = &mapping;
         if (!plain)
             trim_prepare(r, &r->hdr10_mapping, metadata, bytes, &trim);
diff --git a/tools/dvbridge/dvbridge_render.h b/tools/dvbridge/dvbridge_render.h
index 89b0e77..56f598d 100644
--- a/tools/dvbridge/dvbridge_render.h
+++ b/tools/dvbridge/dvbridge_render.h
@@ -174,6 +174,16 @@ struct dvbridge_plain {
      * is (no mapping). */
 #define DVBRIDGE_RENDER_PLAIN_HDR10PLUS 1
     struct dvbridge_plain_hdr10plus hdr10plus;
+    /* Hades: the picture's own scene, measured (videoscreen.hadeshdr10scenes, dvbridge_scene_map.h): the brightest
+     * and the average of its scene, PQ in (0, 1], that its mapping to a display maps from (as the level 1 of a Dolby
+     * Vision picture: PL_HDR_METADATA_CIE_Y) instead of the static HDR10 metadata. Only for a PQ picture that is
+     * mapped and has no HDR10+ statistics (the studio's own come first). present false: none, and the picture is
+     * mapped as before, bit for bit. */
+#define DVBRIDGE_RENDER_PLAIN_SCENE 1
+    struct {
+        bool present;
+        float max_pq, avg_pq;
+    } scene;
     /* Hades: an SDR picture drawn as it is, for an upscaler (dvbridge_render_set_upscaler()): its matrix
      * (DVBRIDGE_PLAIN_SDR_*) and its primaries (DVBRIDGE_PLAIN_PRIM_*), the BT.1886 transfer; it goes out in
      * BT.709, as Kodi's shaders draw an SDR picture (the primaries converted and clipped), and nothing is mapped
diff --git a/tools/dvbridge/dvbridge_scene_map.c b/tools/dvbridge/dvbridge_scene_map.c
new file mode 100644
index 0000000..a85d6ca
--- /dev/null
+++ b/tools/dvbridge/dvbridge_scene_map.c
@@ -0,0 +1,93 @@
+/*
+ *  Copyright (C) 2026 Hades
+ *  This file is part of LibreELEC Hades. It is not in Kodi as Team Kodi publishes it.
+ *
+ *  SPDX-License-Identifier: GPL-2.0-or-later
+ *  See LICENSES/README.md for more information.
+ */
+/* Hades: see dvbridge_scene_map.h. */
+#include "dvbridge_scene_map.h"
+
+#include <stddef.h>
+
+/* The dead bands and the steps, in codes of 12-bit PQ. Within a scene, the measurement of the scene so far
+ * already moves only by more than 16 codes for the brightest and 24 for the average (dvbridge_measured.c,
+ * max_step, avg_step), which is right for metadata that a TV filters in time on its own; mapped here, every
+ * change moves the curve of every pixel, so the bands are wider (32 codes is about 7 % of the luminance near
+ * 1000 cd/m2) and a change is spread over at least 8 pictures (a third of a second at 24 fps). */
+const struct dvbridge_scene_map_params dvbridge_scene_map_default_params = {
+    .max_band = 32, .avg_band = 32, .max_rate = 4, .avg_rate = 4,
+};
+
+void dvbridge_scene_map_init(struct dvbridge_scene_map *s, const struct dvbridge_scene_map_params *params)
+{
+    if (!s)
+        return;
+    *s = (struct dvbridge_scene_map){0};
+    s->p = params ? *params : dvbridge_scene_map_default_params;
+}
+
+void dvbridge_scene_map_reset(struct dvbridge_scene_map *s)
+{
+    if (!s)
+        return;
+    const struct dvbridge_scene_map_params p = s->p;
+    *s = (struct dvbridge_scene_map){0};
+    s->p = p;
+}
+
+/* the value moved towards its target by at most rate */
+static float approach(float value, unsigned target, unsigned rate)
+{
+    const float t = (float)target;
+    if (value < t)
+        return value + (float)rate < t ? value + (float)rate : t;
+    return value - (float)rate > t ? value - (float)rate : t;
+}
+
+static unsigned distance(float value, unsigned target)
+{
+    const float d = value > (float)target ? value - (float)target : (float)target - value;
+    return (unsigned)(d + 0.5f);
+}
+
+bool dvbridge_scene_map_next(struct dvbridge_scene_map *s, bool measured, bool refresh, unsigned max_pq,
+                             unsigned avg_pq, float *max_out, float *avg_out)
+{
+    if (!s || !max_out || !avg_out)
+        return false;
+    if (max_pq > 4095)
+        max_pq = 4095;
+    if (avg_pq > max_pq)
+        avg_pq = max_pq;
+    if (measured && (refresh || !s->present)) {
+        /* a new scene (or the first one measured): taken as it is */
+        s->present = true;
+        s->max = (float)max_pq;
+        s->avg = (float)avg_pq;
+        s->target_max = max_pq;
+        s->target_avg = avg_pq;
+        s->scenes++;
+    } else if (measured) {
+        /* within the scene: a target that moved past its band is the new target */
+        if (distance(s->max, max_pq) > s->p.max_band)
+            s->target_max = max_pq;
+        if (distance(s->avg, avg_pq) > s->p.avg_band)
+            s->target_avg = avg_pq;
+    }
+    if (!s->present)
+        return false;
+    const float before_max = s->max, before_avg = s->avg;
+    s->max = approach(s->max, s->target_max, s->p.max_rate);
+    s->avg = approach(s->avg, s->target_avg, s->p.avg_rate);
+    if (s->avg > s->max)
+        s->avg = s->max;
+    if (s->max != before_max || s->avg != before_avg)
+        s->moves++;
+    *max_out = s->max / 4095.0f;
+    /* libplacebo maps by the pair only where both are above 0 (pl_hdr_metadata_contains()) */
+    *avg_out = (s->avg < 1.0f ? 1.0f : s->avg) / 4095.0f;
+    if (*avg_out > *max_out)
+        *avg_out = *max_out;
+    return *max_out > 0.0f;
+}
diff --git a/tools/dvbridge/dvbridge_scene_map.h b/tools/dvbridge/dvbridge_scene_map.h
new file mode 100644
index 0000000..de47264
--- /dev/null
+++ b/tools/dvbridge/dvbridge_scene_map.h
@@ -0,0 +1,63 @@
+/*
+ *  Copyright (C) 2026 Hades
+ *  This file is part of LibreELEC Hades. It is not in Kodi as Team Kodi publishes it.
+ *
+ *  SPDX-License-Identifier: GPL-2.0-or-later
+ *  See LICENSES/README.md for more information.
+ */
+#ifndef DVBRIDGE_SCENE_MAP_H
+#define DVBRIDGE_SCENE_MAP_H
+/* Hades: an HDR10 picture mapped to a display by its own scene, measured (videoscreen.hadeshdr10scenes). An
+ * HDR10 video carries one brightness for the whole film (its mastering display, or MaxCLL); mapped to a projector
+ * or to SDR by that, a dark scene is compressed as much as the brightest scene of the film. Where Hades measures
+ * each scene (dvbridge_measured.h, as for HDR10 sent as Dolby Vision: level 1 of ST 2094-10 over the active area,
+ * held per scene, the cuts found from the picture), the mapping can take the brightest and the average of the
+ * scene instead, as it takes level 1 of a Dolby Vision video shown as HDR10 (dvbridge_render.c, display_mapping():
+ * PL_HDR_METADATA_CIE_Y).
+ *
+ * This decides, picture by picture in the order of presentation, what the mapping is given, with hysteresis, so
+ * that the picture does not pump within a shot:
+ * - nothing measured yet (the start, after a seek): nothing (the static metadata map it, as before);
+ * - the first picture of a scene (a cut, where the picture changes anyway): the scene as measured;
+ * - within a scene the measurement of the scene so far can still rise (a highlight that comes in): a change of
+ *   the brightest or of the average smaller than its dead band is not followed, and a larger one is followed
+ *   gradually, by at most a step of codes a picture, so that the curve never jumps in the middle of a shot;
+ * - a picture that was not measured in time keeps what the one before it had.
+ * Values are codes of 12-bit PQ (0 to 4095), as level 1 carries them. It holds no GL and allocates nothing. */
+#include <stdbool.h>
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+struct dvbridge_scene_map_params {
+    unsigned max_band, avg_band; /* changes within a scene smaller than these are not followed (codes) */
+    unsigned max_rate, avg_rate; /* within a scene, the most a value moves in one picture (codes) */
+};
+extern const struct dvbridge_scene_map_params dvbridge_scene_map_default_params;
+
+struct dvbridge_scene_map {
+    struct dvbridge_scene_map_params p;
+    bool present;          /* a scene is being mapped by */
+    float max, avg;        /* what the mapping was given last (codes, fractional while it moves) */
+    unsigned target_max, target_avg; /* what it moves towards within the scene */
+    unsigned scenes, moves; /* counts since the last reset, for the log: scenes begun, pictures that moved */
+};
+
+/* params NULL: the defaults. Starts with nothing (present false). */
+void dvbridge_scene_map_init(struct dvbridge_scene_map *s, const struct dvbridge_scene_map_params *params);
+/* A seek, a new stream, or a failure of the measurement: nothing until the next scene is measured */
+void dvbridge_scene_map_reset(struct dvbridge_scene_map *s);
+
+/* What the picture presented now is mapped by. measured: its scene was measured (dvbridge_measured_take()
+ * returned true, or a level 1 of measurements is held: dvbridge_measured_l1::measured); refresh: it is the first
+ * picture of a scene; max_pq, avg_pq: the level 1 of its scene so far (codes). Out: true and the brightest and
+ * the average to map by, PQ in [0, 1] (the average at least one code: libplacebo takes the pair only with both
+ * above 0); false: none (the static metadata). */
+bool dvbridge_scene_map_next(struct dvbridge_scene_map *s, bool measured, bool refresh, unsigned max_pq,
+                             unsigned avg_pq, float *max_out, float *avg_out);
+
+#ifdef __cplusplus
+}
+#endif
+#endif
-- 
