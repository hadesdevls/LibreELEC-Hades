 }
 
+// Hades: an HDMI 3D frame-packed mode of nvidia-drm (issue #33; FramePackedOwn.h has the why). The
+// window's buffer is asked first, in a test commit of the mode; where the driver takes it, or it
+// cannot be asked, nothing changes. Only where the driver refuses it are Kodi's own buffers made: of
+// the format, size and modifier (DRM_FORMAT_MOD_LINEAR) of the window's, for scanout and rendering,
+// each checked (8-bit values written and read back, a frame flipped by the GPU and read back, what
+// nvidia-drm asks of a frame-packed buffer) and asked the same; where the driver takes every one of
+// them, the frames go out through them, drawn upright and flipped by the GPU (the plane of a
+// frame-packed mode takes no rotation: nvidia-drm-crtc.c, plane_config_update_frame_packed()).
+// Otherwise the window's buffer goes to the driver as before, and where the driver refuses the
+// mode, Kodi takes the 3D layout that comes next (CWinSystemGbm::CheckStereoOutput()). kodi.log
+// says which buffer the frame goes out in, and what the two answers say of the refusal.
+void CWinSystemGbmEGLContext::FramePackedOwnStart(struct gbm_bo* window)
+{
+  // (every other mode, and every other driver: nothing, not even a test)
+  if (!m_DRM || !m_DRM->FramePackedByOffsets())
+    return;
+#if defined(HAS_GLES)
+  std::string why;
+  const FP_OWN::Asked asked = FP_OWN::AskedOf(m_DRM->TestFramePacked(window, why));
+  if (!FP_OWN::MakeOwn(m_DRM->FramePackedByOffsets(), m_renderableType != EGL_OPENGL_BIT, asked))
+  {
+    if (asked == FP_OWN::Asked::TAKEN)
+      CLog::LogF(LOGINFO,
+                 "3D output: the driver takes the window's buffer in the frame-packed mode "
+                 "(a test commit): the frame goes out in it");
+    else if (asked == FP_OWN::Asked::REFUSED)
+      CLog::LogF(LOGWARNING,
+                 "3D output: the driver refused the window's buffer in a test commit of the "
+                 "frame-packed mode ({}); Kodi's own buffers are made only with OpenGL ES: the "
+                 "frame goes out in the window's buffer",
+                 why);
+    else
+      CLog::LogF(LOGINFO, "3D output: the window's buffer of the frame-packed mode could not be "
+                          "asked in a test commit (the output is off, or not atomic): the frame "
+                          "goes out in it");
+    return;
+  }
+
+  CDRMPlane* plane = m_DRM->GetGuiPlane() ? m_DRM->GetGuiPlane() : m_DRM->GetVideoPlane();
+  const STEREO::Mode mode = m_DRM->GetSelectedStereoMode();
+  const uint32_t format = gbm_bo_get_format(window);
+  const int width = static_cast<int>(gbm_bo_get_width(window));
+  const int height = static_cast<int>(gbm_bo_get_height(window));
+  std::string failed;
+  std::shared_ptr<COwnScanout> own;
+  if (!plane || !m_GBM)
+    failed = "there is no plane or GBM device";
+  else if (!FP_OWN::HoldsFrame(mode, width, height))
+    failed = StringUtils::Format("the window's buffer of {}x{} does not hold the frame of the mode",
+                                 width, height);
+  else
+    // (the size and format of the window's buffer: as wide as the second eye needs,
+    // CDRMUtils::FramePackedBufferDemands(), and of 8 bits, CreateNewWindow())
+    own = COwnScanout::Create(m_GBM->GetDevice().Get(), m_eglContext.GetEGLDisplay(), width, height,
+                              format, {DRM_FORMAT_MOD_LINEAR}, true, true, failed);
+
+  // Each buffer as nvidia-drm asks a frame-packed one to be, and taken in a test of the mode
+  FP_OWN::Asked ownAsked = FP_OWN::Asked::NOT_ASKED;
+  std::string ownWhy;
+  if (own)
+  {
+    ownAsked = FP_OWN::Asked::TAKEN;
+    for (unsigned int i = 0; i < COwnScanout::BUFFERS && ownAsked == FP_OWN::Asked::TAKEN; ++i)
+    {
+      std::string wrong;
+      if (!m_DRM->FramePackedBufferUsable(own->BufferAt(i), wrong))
+      {
+        failed =
+            "a buffer that GBM made is not one that the driver takes for frame packing: " + wrong;
+        own.reset();
+        ownAsked = FP_OWN::Asked::NOT_ASKED;
+        break;
+      }
+      ownAsked = FP_OWN::AskedOf(m_DRM->TestFramePacked(own->BufferAt(i), ownWhy));
+    }
+  }
+
+  const FP_OWN::Verdict verdict = FP_OWN::Decide(asked, own != nullptr, ownAsked);
+  if (verdict.use != FP_OWN::Use::OWN)
+  {
+    std::string what;
+    if (!failed.empty())
+      what = "Kodi's own buffers could not be made: " + failed;
+    else if (ownAsked == FP_OWN::Asked::REFUSED)
+      what = "the driver refused Kodi's own buffer too (" + ownWhy + ")";
+    else
+      what = "Kodi's own buffers could not be asked in a test commit";
+    CLog::LogF(LOGWARNING,
+               "3D output: the driver refused the window's buffer in a test commit of the "
+               "frame-packed mode ({}); {}: {}. The frame goes out in the window's buffer; where "
+               "the driver refuses the mode, the 3D layout that comes next is taken",
+               why, what, FP_OWN::CauseText(verdict.cause));
+    return;
+  }
+
+  // In place of the window's buffers, which stay, unswapped, for the next mode
+  m_DRM->SetReflectY(false);
+  m_ownWindowFormat = plane->GetFormat();
+  m_ownWindowModifier = plane->GetModifier();
+  m_GBM->GetDevice().GetSurface().SetOwnBuffers(own);
+  m_ownScanout = own;
+  m_ownFramePacked = true;
+  m_ownFramePackedRefused = false;
+  plane->SetFormat(own->Format());
+  plane->SetModifier(own->Modifier());
+  BindOwnBack();
+  if (!OwnScanoutOn())
+    return;
+  const auto rows = FP_OWN::RowsOf(mode);
+  CLog::LogF(LOGINFO,
+             "3D output: the driver refused the window's buffer in a test commit of the "
+             "frame-packed mode ({}) and takes Kodi's own: {}. The frame goes out in {} buffers "
+             "that Kodi allocates itself for scanout and draws into, each {}; drawn upright and "
+             "flipped from top to bottom by the GPU when each frame is swapped (the plane of a "
+             "frame-packed mode takes no rotation): the left eye in lines {}-{}, black in {}-{}, "
+             "the right eye in {}-{}; checked before use (8-bit values written and read back, a "
+             "frame flipped by the GPU and read back, a test commit of the mode with each buffer)",
+             why, FP_OWN::CauseText(verdict.cause), COwnScanout::BUFFERS,
+             m_DRM->DescribeFramePackedBuffer(own->FirstBuffer()), rows ? rows->leftFirst : 0,
+             rows ? rows->leftEnd - 1 : 0, rows ? rows->gapFirst : 0, rows ? rows->gapEnd - 1 : 0,
+             rows ? rows->rightFirst : 0, rows ? rows->rightEnd - 1 : 0);
+#endif
+}
