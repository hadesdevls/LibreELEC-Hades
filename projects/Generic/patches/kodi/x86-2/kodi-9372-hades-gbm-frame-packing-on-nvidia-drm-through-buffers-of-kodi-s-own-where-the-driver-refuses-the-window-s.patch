--- /dev/null
+++ b/xbmc/windowing/gbm/FramePackedOwn.h
@@ -0,0 +1,168 @@
+/*
+ *  Copyright (C) 2026 Hades
+ *  This file is part of LibreELEC Hades. It is not in Kodi as Team Kodi publishes it.
+ *
+ *  SPDX-License-Identifier: GPL-2.0-or-later
+ *  See LICENSES/README.md for more information.
+ */
+
+#pragma once
+
+#include "drm/DRMStereo.h"
+
+#include <optional>
+
+/*!
+ * \brief Hades: the frame of an HDMI 3D frame-packed mode of nvidia-drm in buffers that Kodi
+ *        allocates itself, where the driver refuses the window's (issue #33)
+ *
+ * nvidia-drm gives NVKMS, whose hardware does the frame packing, the lines of each eye of the one
+ * buffer as a surface of its own (DRMStereo.h, NVKMS_SURFACE_OFFSET_ALIGNMENT). It registers a
+ * framebuffer with NVKMS only where its memory is video memory (nvidia-drm-fb.c,
+ * nv_drm_framebuffer_init(): no NVKMS surface where !isVidmem on a GPU that has video memory), and
+ * refuses a commit of a framebuffer without one, in a 2D mode as in a frame-packed one
+ * (nvidia-drm-crtc.c, plane_req_config_update(); nvidia-drm-fb.c,
+ * nv_drm_framebuffer_get_frame_packed_surfaces()). The window's buffers of a frame-packed mode are
+ * made by the EGL of NVIDIA's driver (egl-gbm: the images of an EGLStream, with the one modifier
+ * DRM_FORMAT_MOD_LINEAR, which the driver asks for that mode), and where that driver places them is
+ * not in any source that can be read. The buffers that Kodi allocates itself are made by GBM for
+ * scanout (GBM_BO_USE_SCANOUT), as Kodi's own buffers of more than 8 bits are, which nvidia-drm has
+ * scanned out on the 580 driver (issue #17).
+ *
+ * So the window's buffer is asked first, in a test commit of the frame-packed mode: where the driver
+ * takes it, nothing changes. Only where it refuses it are Kodi's own buffers made (8 bits, the
+ * format of the window, DRM_FORMAT_MOD_LINEAR, the size of the window's buffer) and asked the same;
+ * where the driver takes them, the frames go out through them, drawn upright into a framebuffer
+ * object and flipped by the GPU into the buffer that goes to the screen (the plane of a frame-packed
+ * mode takes no rotation, so it cannot reflect them). What the two answers say of the refusal is
+ * told in kodi.log (Decide()).
+ */
+namespace KODI::WINDOWING::GBM::FP_OWN
+{
+
+//! What a test commit of the frame-packed mode said of a buffer
+enum class Asked
+{
+  TAKEN,
+  REFUSED,
+  NOT_ASKED //!< no test could be made (no atomic output, the output is off, no plane or mode)
+};
+
+//! \brief The answer of CDRMUtils::TestFramePacked() (nothing: not asked)
+inline Asked AskedOf(std::optional<bool> taken)
+{
+  if (!taken)
+    return Asked::NOT_ASKED;
+  return *taken ? Asked::TAKEN : Asked::REFUSED;
+}
+
+/*!
+ * \brief Whether Kodi makes buffers of its own for a frame-packed mode
+ * \param framePackedByOffsets the mode is frame packed and the driver is nvidia-drm
+ *        (CDRMUtils::FramePackedByOffsets()): never in any other mode or with any other driver
+ * \param gles Kodi draws with OpenGL ES (COwnScanout draws through framebuffer objects of GLES)
+ * \param window what the test said of the window's buffer: only where the driver refused it
+ */
+inline bool MakeOwn(bool framePackedByOffsets, bool gles, Asked window)
+{
+  return framePackedByOffsets && gles && window == Asked::REFUSED;
+}
+
+//! Which buffers the frame-packed frame goes to the driver in
+enum class Use
+{
+  WINDOW,
+  OWN
+};
+
+//! What the answers say of the refusal of the window's buffer
+enum class Cause
+{
+  NONE, //!< the window's buffer was taken, or not asked: nothing was refused
+  BUFFER, //!< Kodi's own buffer was taken: the driver refused the window's buffer for itself
+  NOT_BUFFER, //!< Kodi's own buffer was refused too: what the driver refuses is not the buffer
+  NOT_KNOWN //!< Kodi's own buffers could not be made, or not asked
+};
+
+struct Verdict
+{
+  Use use{Use::WINDOW};
+  Cause cause{Cause::NONE};
+};
+
+/*!
+ * \param window what the test said of the window's buffer
+ * \param ownMade Kodi's own buffers were made and passed their checks (GL, the demands of the
+ *        driver: CDRMUtils::FramePackedBufferUsable())
+ * \param ownTaken what the test said of them: taken only where every one of them was taken
+ */
+inline Verdict Decide(Asked window, bool ownMade, Asked ownTaken)
+{
+  if (window != Asked::REFUSED)
+    return {Use::WINDOW, Cause::NONE};
+  if (!ownMade || ownTaken == Asked::NOT_ASKED)
+    return {Use::WINDOW, Cause::NOT_KNOWN};
+  if (ownTaken == Asked::TAKEN)
+    return {Use::OWN, Cause::BUFFER};
+  return {Use::WINDOW, Cause::NOT_BUFFER};
+}
+
+/*!
+ * \brief The lines of a frame-packed frame, from the first one of the buffer (its top line): the
+ *        left eye, the gap of the active space, the right eye; each [first, end)
+ */
+struct Rows
+{
+  int leftFirst{0};
+  int leftEnd{0};
+  int gapFirst{0};
+  int gapEnd{0};
+  int rightFirst{0};
+  int rightEnd{0};
+};
+
+//! \brief The rows of a frame-packed mode (the right eye from line vtotal, as nvidia-drm takes it:
+//! nvidia-drm-crtc.c, plane_config_update_frame_packed()); nothing for any other mode
+inline std::optional<Rows> RowsOf(const STEREO::Mode& mode)
+{
+  if (STEREO::LayoutOf(mode.flags) != STEREO::Layout::FRAME_PACKING || mode.vdisplay == 0 ||
+      mode.vtotal <= mode.vdisplay)
+    return std::nullopt;
+  const int eye = mode.vdisplay;
+  const int total = mode.vtotal;
+  return Rows{0, eye, eye, total, total, total + eye};
+}
+
+/*!
+ * \brief Whether one of Kodi's own buffers holds the frame of the mode: as tall as the frame (the
+ *        right eye's last line included: STEREO::ScanoutHeight()) and as wide as the mode
+ * \param width, height of the buffer
+ */
+inline bool HoldsFrame(const STEREO::Mode& mode, int width, int height)
+{
+  const auto rows = RowsOf(mode);
+  return rows && width >= mode.hdisplay && height >= rows->rightEnd;
+}
+
+//! For kodi.log
+inline const char* CauseText(Cause cause)
+{
+  switch (cause)
+  {
+    case Cause::BUFFER:
+      return "the driver refused the window's buffer itself, and takes one in video memory";
+    case Cause::NOT_BUFFER:
+      return "the driver refuses Kodi's own buffer as well: what it refuses is not where the "
+             "buffer is (the kernel log says why, in its lines \"Hades: HDMI 3D frame packing "
+             "refused\")";
+    case Cause::NOT_KNOWN:
+      return "Kodi's own buffers could not be made or asked: what the driver refuses is not known "
+             "here (the kernel log says why, in its lines \"Hades: HDMI 3D frame packing "
+             "refused\")";
+    case Cause::NONE:
+    default:
+      return "nothing was refused";
+  }
+}
+
+} // namespace KODI::WINDOWING::GBM::FP_OWN
