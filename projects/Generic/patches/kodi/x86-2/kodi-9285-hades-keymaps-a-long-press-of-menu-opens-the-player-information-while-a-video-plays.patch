From 26fa5eba349281908d780d7fe1d7dcc52c6861b1 Mon Sep 17 00:00:00 2001
From: Hades <15710513+hadesdevls@users.noreply.github.com>
Date: Wed, 25 Nov 2026 05:52:51 +0000
Subject: [PATCH] [Hades][Keymaps] A long press of Menu opens the player
 information while a video plays

The player information opens with O on a keyboard and with the title
and red keys on a remote. A remote without colour keys, such as a Fire
TV remote over Bluetooth, which sends Menu as a key of a keyboard, had
no key for it.

In the FullscreenVideo and FullscreenInfo sections of the default keymaps
(a video that plays, with or without its info over it), a long press of
Menu opens it with the same action (PlayerProcessInfo): on the keyboard,
and on a remote the menu key and the "Contents menu" and "Root menu"
that a TV remote sends over CEC (a long press where the TV tells how
long the key is held). A short press of each is the OSD, as before; the
sections had no other long press of these keys, and the long press of
Menu outside a video (Menu, in the global section) does not change.
LibreELEC and Hades change no other line of these keymaps.
---
 system/keymaps/keyboard.xml |  5 +++++
 system/keymaps/remote.xml   | 11 +++++++++++
 2 files changed, 16 insertions(+)

diff --git a/system/keymaps/keyboard.xml b/system/keymaps/keyboard.xml
index dc63dd8..5357c76 100644
--- a/system/keymaps/keyboard.xml
+++ b/system/keymaps/keyboard.xml
@@ -418,6 +418,9 @@
       <ok mod="longpress">PlayPause</ok>
       <m>OSD</m>
       <menu>OSD</menu>
+      <!-- Hades: a long press of Menu opens the player information, as O does, for remotes without colour keys (a
+           Fire TV remote over Bluetooth sends Menu as a key of a keyboard); a short press is the OSD, as before -->
+      <menu mod="longpress">PlayerProcessInfo</menu>
       <i>Info</i>
       <o>PlayerProcessInfo</o>
       <o mod="ctrl,shift">PlayerDebug</o>
@@ -512,6 +515,8 @@
       <d mod="ctrl">Back</d>
       <m>OSD</m>
       <menu>OSD</menu>
+      <!-- Hades: a long press of Menu opens the player information, as in FullscreenVideo -->
+      <menu mod="longpress">PlayerProcessInfo</menu>
       <return mod="longpress">PlayPause</return>
       <enter mod="longpress">PlayPause</enter>
       <ok mod="longpress">PlayPause</ok>
diff --git a/system/keymaps/remote.xml b/system/keymaps/remote.xml
index 0959b99..bdfbd4e 100644
--- a/system/keymaps/remote.xml
+++ b/system/keymaps/remote.xml
@@ -193,6 +193,13 @@
       <menu>OSD</menu>
       <contentsmenu>OSD</contentsmenu>
       <rootmenu>OSD</rootmenu>
+      <!-- Hades: a long press of a menu key opens the player information, as the title and red keys do, for remotes
+           without colour keys; a TV remote over CEC sends its menu key as "Contents menu" or "Root menu"
+           (PeripheralCecAdapter.cpp), and a long press where the TV tells how long it is held. A short press is the
+           OSD, as before -->
+      <menu mod="longpress">PlayerProcessInfo</menu>
+      <contentsmenu mod="longpress">PlayerProcessInfo</contentsmenu>
+      <rootmenu mod="longpress">PlayerProcessInfo</rootmenu>
       <start>OSD</start>
       <select>OSD</select>
       <title>PlayerProcessInfo</title>
@@ -242,6 +249,10 @@
       <menu>OSD</menu>
       <contentsmenu>OSD</contentsmenu>
       <rootmenu>OSD</rootmenu>
+      <!-- Hades: a long press of a menu key opens the player information, as in FullscreenVideo -->
+      <menu mod="longpress">PlayerProcessInfo</menu>
+      <contentsmenu mod="longpress">PlayerProcessInfo</contentsmenu>
+      <rootmenu mod="longpress">PlayerProcessInfo</rootmenu>
     </remote>
   </FullscreenInfo>
   <PlayerControls>
-- 
2.53.0

