   else if (m_hdmiPath.address != EdidHdmiPath::NONE)
     CLog::Log(LOGINFO, "[display-info] hdmi address {}: says nothing of where the source is",
diff --git a/xbmc/utils/EdidHdmiPath.h b/xbmc/utils/EdidHdmiPath.h
index 0b4b7e5..8a953cf 100644
--- a/xbmc/utils/EdidHdmiPath.h
+++ b/xbmc/utils/EdidHdmiPath.h
@@ -169,7 +169,8 @@ inline EdidHdmiPath EdidHdmiPathOf(const std::vector<uint8_t>& edid)
             path.pcmChannels = std::max(path.pcmChannels, (blk[k] & 7u) + 1);
         }
       }
-      else if (tag == 3 && avail >= 5 && blk[0] == 0x03 && blk[1] == 0x0c && blk[2] == 0x00 && !addressed)
+      else if (tag == 3 && avail >= 5 && blk[0] == 0x03 && blk[1] == 0x0c && blk[2] == 0x00 &&
+               !addressed)
       {
         path.address = static_cast<uint16_t>((blk[3] << 8) | blk[4]);
         addressed = true;
diff --git a/xbmc/windowing/gbm/DVPathChoice.h b/xbmc/windowing/gbm/DVPathChoice.h
index c759b2e..1febe36 100644
--- a/xbmc/windowing/gbm/DVPathChoice.h
+++ b/xbmc/windowing/gbm/DVPathChoice.h
@@ -1057,16 +1057,18 @@ public:
   //! What the text has for that key; false when it has nothing
   static bool Get(const std::string& all, uint64_t key, std::string& plain, std::string& layered)
   {
-    return Find(all, [name = Name(key)](const std::string& entry)
-                { return entry.compare(0, name.size(), name) == 0; }, plain, layered);
+    return Find(
+        all, [name = Name(key)](const std::string& entry)
+        { return entry.compare(0, name.size(), name) == 0; }, plain, layered);
   }
 
   //! What the text has for that GPU in another driver or build (the last put), for a key that has nothing; false when
   //! it has nothing
   static bool Prior(const std::string& all, uint64_t gpu, std::string& plain, std::string& layered)
   {
-    return Find(all, [machine = Name(gpu)](const std::string& entry) { return GpuOf(entry) == machine; }, plain,
-                layered);
+    return Find(
+        all, [machine = Name(gpu)](const std::string& entry) { return GpuOf(entry) == machine; },
+        plain, layered);
   }
 
 private:
@@ -1084,7 +1086,8 @@ private:
   //! The gpu of an entry, "" for one without (written by Hades up to 1.1)
   static std::string GpuOf(const std::string& entry)
   {
-    return entry.size() > 2 * KEY + 1 && entry[KEY] == '.' ? entry.substr(KEY + 1, KEY) : std::string();
+    return entry.size() > 2 * KEY + 1 && entry[KEY] == '.' ? entry.substr(KEY + 1, KEY)
+                                                           : std::string();
   }
 
   template<typename Match>
diff --git a/xbmc/windowing/gbm/WinSystemGbmGLESContext.cpp b/xbmc/windowing/gbm/WinSystemGbmGLESContext.cpp
index 0dd39d1..668f5cd 100644
--- a/xbmc/windowing/gbm/WinSystemGbmGLESContext.cpp
+++ b/xbmc/windowing/gbm/WinSystemGbmGLESContext.cpp
@@ -10485,8 +10485,8 @@ void CWinSystemGbmGLESContext::DVStepRemember()
       !settings->GetSetting(CSettings::SETTING_VIDEOSCREEN_HADESDVSTEP))
     return;
   const std::string before = settings->GetString(CSettings::SETTING_VIDEOSCREEN_HADESDVSTEP);
-  const std::string after = CDVPathMemory::Put(before, m_dvPathKey, m_dvPathGpu, m_dvStep.Kept()[0].Known(),
-                                               m_dvStep.Kept()[1].Known());
+  const std::string after = CDVPathMemory::Put(
+      before, m_dvPathKey, m_dvPathGpu, m_dvStep.Kept()[0].Known(), m_dvStep.Kept()[1].Known());
   // written with the other settings when Kodi stops
   if (after != before)
     settings->SetString(CSettings::SETTING_VIDEOSCREEN_HADESDVSTEP, after);
@@ -10655,7 +10655,8 @@ void CWinSystemGbmGLESContext::DVPathRecall()
     }
   }
   std::array<std::string, 2> known;
-  const char* knownFrom = recall(settings->GetString(CSettings::SETTING_VIDEOSCREEN_HADESDVPATH), known);
+  const char* knownFrom =
+      recall(settings->GetString(CSettings::SETTING_VIDEOSCREEN_HADESDVPATH), known);
   if (!knownFrom)
     return;
   for (size_t layered = 0; layered < known.size(); ++layered)
@@ -10679,8 +10680,8 @@ void CWinSystemGbmGLESContext::DVPathRemember()
       !settings->GetSetting(CSettings::SETTING_VIDEOSCREEN_HADESDVPATH))
     return;
   const std::string before = settings->GetString(CSettings::SETTING_VIDEOSCREEN_HADESDVPATH);
-  const std::string after = CDVPathMemory::Put(before, m_dvPathKey, m_dvPathGpu, m_dvPath.Kept()[0].Known(),
-                                               m_dvPath.Kept()[1].Known());
+  const std::string after = CDVPathMemory::Put(
+      before, m_dvPathKey, m_dvPathGpu, m_dvPath.Kept()[0].Known(), m_dvPath.Kept()[1].Known());
   // written with the other settings when Kodi stops
   if (after != before)
     settings->SetString(CSettings::SETTING_VIDEOSCREEN_HADESDVPATH, after);
