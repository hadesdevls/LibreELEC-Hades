From 828d5b6d9ba504cb352c5a110335318349f21e35 Mon Sep 17 00:00:00 2001
From: Hades <15710513+hadesdevls@users.noreply.github.com>
Date: Wed, 25 Nov 2026 00:17:35 +0000
Subject: [PATCH] Hades: clang-format on the lines of the EDID path, the file
 cache and the start of Dolby Vision

clang-format-21 with the tree's .clang-format on the lines that the three commits before changed (git
clang-format against their parent): line breaks only.
---
 xbmc/settings/AdvancedSettings.cpp            | 24 ++++++++++++-------
 xbmc/settings/FileCacheDefaults.h             | 12 ++++++----
 xbmc/settings/ServicesSettings.cpp            |  1 -
 xbmc/utils/DisplayInfo.cpp                    |  9 ++++---
 xbmc/utils/EdidHdmiPath.h                     |  3 ++-
 xbmc/windowing/gbm/DVPathChoice.h             | 13 ++++++----
 .../windowing/gbm/WinSystemGbmGLESContext.cpp | 11 +++++----
 xbmc/windowing/gbm/WinSystemGbmGLESContext.h  |  3 ++-
 8 files changed, 46 insertions(+), 30 deletions(-)

diff --git a/xbmc/settings/AdvancedSettings.cpp b/xbmc/settings/AdvancedSettings.cpp
index 565ce97..2df1b4d 100644
--- a/xbmc/settings/AdvancedSettings.cpp
+++ b/xbmc/settings/AdvancedSettings.cpp
@@ -118,12 +118,14 @@ void CAdvancedSettings::ApplyFileCacheDefaults() const
     return;
   KODI::MEMORY::MemoryStatus memory{};
   KODI::MEMORY::GetMemoryStatus(&memory);
-  const auto at = [](const std::optional<std::string>& text) { return text ? text->c_str() : nullptr; };
+  const auto at = [](const std::optional<std::string>& text)
+  { return text ? text->c_str() : nullptr; };
   const KODI::SETTINGS::FILECACHE::FromAdvanced taken = KODI::SETTINGS::FILECACHE::TakeAdvanced(
       at(m_cacheMemorySize), at(m_cacheBufferMode), at(m_cacheReadFactor), at(m_cacheChunkSize),
       memory.totalPhys);
   // each as the default of its setting: it holds unless the setting was set to something else in the settings
-  const auto take = [&settings](const char* id, const char* name, const std::optional<std::string>& text,
+  const auto take = [&settings](const char* id, const char* name,
+                                const std::optional<std::string>& text,
                                 const std::optional<int>& value)
   {
     if (!text)
@@ -131,26 +133,30 @@ void CAdvancedSettings::ApplyFileCacheDefaults() const
     const auto setting = std::static_pointer_cast<CSettingInt>(settings->GetSetting(id));
     if (!value || !setting)
     {
-      CLog::Log(LOGWARNING,
-                "advancedsettings.xml: <cache><{}>{}</{}> is not a value of {} (Settings > Services > "
-                "Caching): left out",
-                name, *text, name, id);
+      CLog::Log(
+          LOGWARNING,
+          "advancedsettings.xml: <cache><{}>{}</{}> is not a value of {} (Settings > Services > "
+          "Caching): left out",
+          name, *text, name, id);
       return;
     }
     const bool set = setting->GetValue() != setting->GetDefault();
     setting->SetDefault(*value);
     if (set)
       CLog::Log(LOGINFO,
-                "advancedsettings.xml: <cache><{}> is taken as the default of {} ({}), but the value set in "
+                "advancedsettings.xml: <cache><{}> is taken as the default of {} ({}), but the "
+                "value set in "
                 "Settings > Services > Caching ({}) is used",
                 name, id, *value, setting->GetValue());
     else
-      CLog::Log(LOGINFO, "advancedsettings.xml: <cache><{}> {} is taken as {} = {}", name, *text, id, *value);
+      CLog::Log(LOGINFO, "advancedsettings.xml: <cache><{}> {} is taken as {} = {}", name, *text,
+                id, *value);
   };
   take(CSettings::SETTING_FILECACHE_MEMORYSIZE, "memorysize", m_cacheMemorySize, taken.memorySize);
   if (taken.memoryBounded)
     CLog::Log(LOGWARNING,
-              "advancedsettings.xml: <cache><memorysize> is more than a quarter of the RAM ({} MiB): {} MB is taken",
+              "advancedsettings.xml: <cache><memorysize> is more than a quarter of the RAM ({} "
+              "MiB): {} MB is taken",
               memory.totalPhys / (1024 * 1024), *taken.memorySize);
   take(CSettings::SETTING_FILECACHE_BUFFERMODE, "buffermode", m_cacheBufferMode, taken.bufferMode);
   take(CSettings::SETTING_FILECACHE_READFACTOR, "readfactor", m_cacheReadFactor, taken.readFactor);
diff --git a/xbmc/settings/FileCacheDefaults.h b/xbmc/settings/FileCacheDefaults.h
index e900a06..78efd6e 100644
--- a/xbmc/settings/FileCacheDefaults.h
+++ b/xbmc/settings/FileCacheDefaults.h
@@ -45,13 +45,15 @@ namespace SETTINGS
 namespace FILECACHE
 {
 //! the choices of filecache.memorysize, in MB (0, the cache on disk, besides), as CServicesSettings lists them
-inline constexpr int MEMORY_SIZES[] = {16, 20, 24, 32, 48, 64, 96, 128, 192, 256, 384, 512, 768, 1024, 2048};
+inline constexpr int MEMORY_SIZES[] = {16,  20,  24,  32,  48,  64,   96,  128,
+                                       192, 256, 384, 512, 768, 1024, 2048};
 //! ... of filecache.readfactor, x100 (0, adaptive, besides)
-inline constexpr int READ_FACTORS[] = {110, 125, 150, 175, 200, 250, 300, 400, 500, 700, 1000, 1500, 2000, 3000, 5000};
+inline constexpr int READ_FACTORS[] = {110, 125, 150,  175,  200,  250,  300, 400,
+                                       500, 700, 1000, 1500, 2000, 3000, 5000};
 //! ... of filecache.chunksize, in bytes
-inline constexpr int CHUNK_SIZES[] = {256,        512,         1024,       2 * 1024,   4 * 1024,
-                                      8 * 1024,   16 * 1024,   32 * 1024,  64 * 1024,  128 * 1024,
-                                      256 * 1024, 512 * 1024,  1024 * 1024};
+inline constexpr int CHUNK_SIZES[] = {256,        512,        1024,       2 * 1024,  4 * 1024,
+                                      8 * 1024,   16 * 1024,  32 * 1024,  64 * 1024, 128 * 1024,
+                                      256 * 1024, 512 * 1024, 1024 * 1024};
 //! ... of filecache.buffermode: CacheBufferMode, INTERNET (0) to NETWORK (4)
 inline constexpr int BUFFER_MODE_MAX = 4;
 
