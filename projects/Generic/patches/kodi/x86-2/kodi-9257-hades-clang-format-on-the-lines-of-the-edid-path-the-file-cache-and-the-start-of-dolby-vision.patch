diff --git a/xbmc/utils/DisplayInfo.cpp b/xbmc/utils/DisplayInfo.cpp
index 8b16ff9..b6173b7 100644
--- a/xbmc/utils/DisplayInfo.cpp
+++ b/xbmc/utils/DisplayInfo.cpp
@@ -781,12 +781,15 @@ void CDisplayInfo::LogInfo() const
   // declares (the Dolby Vision block, the sound formats, the FRL) is that device's, which can differ from the TV's own
   if (m_hdmiPath.Between() > 0)
     CLog::Log(LOGINFO,
-              "[display-info] hdmi address {}: this EDID comes through {} device{} between the source and the "
-              "display (a sound bar, an AV receiver or a switch): its Dolby Vision block, sound formats and FRL are "
+              "[display-info] hdmi address {}: this EDID comes through {} device{} between the "
+              "source and the "
+              "display (a sound bar, an AV receiver or a switch): its Dolby Vision block, sound "
