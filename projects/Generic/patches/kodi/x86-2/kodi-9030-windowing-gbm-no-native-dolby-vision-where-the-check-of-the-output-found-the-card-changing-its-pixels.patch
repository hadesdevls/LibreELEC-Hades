-
 bool CWinSystemGbmGLESContext::Hdr10TunnelWanted(const VideoPicture& picture)
 {
   namespace T = KODI::WINDOWING::GBM::HDR10_TUNNEL;
@@ -5633,7 +5603,7 @@ bool CWinSystemGbmGLESContext::Hdr10TunnelWanted(const VideoPicture& picture)
     in.hdmiTmds = connector->GetType().rfind("HDMI", 0) == 0;
     // Hades: ... and not where the check of the output found that this card changes its pixels
     if (in.kernelBackend && in.hasProperty)
-      in.checkNotExact = OutputCheckNotExact(m_DRM->GetFileDescriptor(), *connector);
