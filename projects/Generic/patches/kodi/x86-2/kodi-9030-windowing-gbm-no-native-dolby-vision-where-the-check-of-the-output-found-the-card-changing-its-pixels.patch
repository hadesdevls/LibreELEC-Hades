From 6083defa11c336e92e13ffd4fa18e9993b01f207 Mon Sep 17 00:00:00 2001
From: Hades <15710513+hadesdevls@users.noreply.github.com>
Date: Wed, 18 Nov 2026 04:35:16 +0000
Subject: [PATCH] windowing/gbm: no native Dolby Vision where the check of the
 output found the card changing its pixels

HDR over the tunnel is no longer used on an output where the last check of
the Dolby Vision output said "not-exact" (OutputCheckVerdict.h). Native Dolby
Vision goes through the same tunnel, and a Dolby Vision display cannot read
its metadata from bytes that the card changed: the RX 550 of issue 20
(Polaris 12, DCE 11.2), whose check said "not-exact", showed its Dolby Vision
logo over a black picture. Dolby Vision converted to HDR10 works there.

So native output is refused too on such an output (SupportsNativeDVOutput(),
OUTPUT_CHECK::RefusesNative(): only an output of the kernel's tunnel, which is
what the check measures), with the same conditions: the report holds while
the driver, the output, the running kernel and the driver's parameters of the
tunnel are what they were when it was made. Dolby Vision plays converted to
HDR10, as on a display without it, and kodi.log says why ("unavailable: the
last \"Check the Dolby Vision output\" found that this graphics card changes
the pixels of the tunnel on this output ..."); the code of the player
information stays "output", as for the cards where the tunnel is not offered.

The verdict is now one member of CWinSystemGbm, kept for the file of the
report (its time and size) and the output, because it is asked with each
picture of a Dolby Vision video; HDR over the tunnel asks the same member.

Not tried on hardware.
---
 xbmc/windowing/gbm/OutputCheckVerdict.h       | 21 +++++++-
 xbmc/windowing/gbm/WinSystemGbm.cpp           | 51 +++++++++++++++++++
 xbmc/windowing/gbm/WinSystemGbm.h             |  9 ++++
 .../windowing/gbm/WinSystemGbmGLESContext.cpp | 32 +-----------
 4 files changed, 81 insertions(+), 32 deletions(-)

diff --git a/xbmc/windowing/gbm/OutputCheckVerdict.h b/xbmc/windowing/gbm/OutputCheckVerdict.h
index f3cd745..dbb700f 100644
--- a/xbmc/windowing/gbm/OutputCheckVerdict.h
+++ b/xbmc/windowing/gbm/OutputCheckVerdict.h
@@ -37,7 +37,10 @@ namespace KODI::WINDOWING::GBM
  * kernel and each of those parameters are what they were when it was made (a new kernel or another
  * value of a parameter may change the pipe: a new check is needed); a report without the kernel
  * line (made before it said it) holds for nothing. A result other than "not-exact" leaves things as
- * they are without the check. Pure but for the reading of files: a test runs it on the host.
+ * they are without the check. Native Dolby Vision is not used there either (RefusesNative()): the
+ * same tunnel carries it, and a Dolby Vision display cannot read its metadata from bytes that the card
+ * changed (the RX 550 of issue 20 showed its logo over a black picture); Dolby Vision plays as HDR10
+ * there, as on a display without it. Pure but for the reading of files: a test runs it on the host.
  */
 namespace OUTPUT_CHECK
 {
@@ -159,6 +162,22 @@ Verdict Judge(const std::optional<Report>& report, const Now& now, Lookup&& curr
   return Verdict::NOT_EXACT;
 }
 
+//! Native Dolby Vision is refused on the output: the check found the card not exact there
+//! (Judge() said NOT_EXACT), and the output is one of the kernel's tunnel (the backend that the
+//! check measures; NVIDIA's driver offers no CRC, and its outputs are never judged by it)
+constexpr bool RefusesNative(bool checkNotExact, bool kernelBackend)
+{
+  return kernelBackend && checkNotExact;
+}
+
+//! What a verdict is kept for (CWinSystemGbm::OutputCheckNotExact()): the report as a file (its
+//! time and size) and the output. The kernel and the parameters of the driver cannot change while
+//! the system runs (they are read only), so the verdict holds while these are the same.
+inline std::string CacheKey(long long mtimeNs, long long size, const std::string& output)
+{
+  return std::to_string(mtimeNs) + ":" + std::to_string(size) + ":" + output;
+}
+
 //! What kodi.log says of a verdict, after "the last check of the Dolby Vision output"
 inline const char* Says(Verdict verdict)
 {
diff --git a/xbmc/windowing/gbm/WinSystemGbm.cpp b/xbmc/windowing/gbm/WinSystemGbm.cpp
index 196fe80..715ec1b 100644
--- a/xbmc/windowing/gbm/WinSystemGbm.cpp
+++ b/xbmc/windowing/gbm/WinSystemGbm.cpp
@@ -30,6 +30,7 @@
 #include "drm/DetectedProperty.h"
 #ifdef HAVE_DVBRIDGE
 #include "DVEndOfStream.h"
+#include "OutputCheckVerdict.h"
 #include "OutputFormat.h"
 #include "cores/VideoPlayer/DVDCodecs/Video/DVPlaybackPolicy.h"
 #include "drm/DVBridgeRefused.h"
@@ -71,6 +72,7 @@
 #include <cmath>
 #include <cstdlib>
 #include <string.h>
+#include <sys/stat.h>
 #include <time.h>
 #include <tuple>
 #include <utility>
@@ -1448,6 +1450,42 @@ const char* DVDisplayReasonText(std::string_view code)
 }
 } // namespace
 
+// Hades: whether the last check of the Dolby Vision output (hades-output-check) said that the card of
+// this output changes the pixels of the tunnel, with this kernel and these parameters of its driver
+// (OutputCheckVerdict.h); kodi.log says what the report holds for when that changes
+bool CWinSystemGbm::OutputCheckNotExact(CDRMConnector& connector) const
+{
+  namespace OC = KODI::WINDOWING::GBM::OUTPUT_CHECK;
+  struct stat st{};
+  const bool there = stat(OC::RESULT_FILE, &st) == 0;
+  const std::string key =
+      there ? OC::CacheKey(static_cast<long long>(st.st_mtim.tv_sec) * 1000000000LL +
+                               st.st_mtim.tv_nsec,
+                           static_cast<long long>(st.st_size), connector.GetName())
+            : std::string("none:") + connector.GetName();
+  std::unique_lock lock(m_outputCheckLock);
+  if (key == m_outputCheckKey)
+    return m_outputCheckNotExact;
+  std::optional<OC::Report> report;
+  if (there)
+    if (const auto text = OC::ReadFile(OC::RESULT_FILE))
+      report = OC::Parse(*text);
+  OC::Now now;
+  now.driver = m_DRM ? std::string(m_DRM->DriverName()) : std::string();
+  now.output = connector.GetName();
+  if (report && report->result == "not-exact")
+    now.system = OC::SystemNow();
+  const OC::Verdict verdict =
+      OC::Judge(report, now, [](const std::string& name) { return OC::ParameterNow(name); });
+  m_outputCheckKey = key;
+  m_outputCheckNotExact = verdict == OC::Verdict::NOT_EXACT;
+  if (std::exchange(m_outputCheckTold, static_cast<int>(verdict)) != static_cast<int>(verdict) &&
+      verdict != OC::Verdict::NONE && verdict != OC::Verdict::NOT_NOT_EXACT)
+    CLog::Log(LOGINFO, "Output check: the last check of the Dolby Vision output ({}) {}",
+              OC::RESULT_FILE, OC::Says(verdict));
+  return m_outputCheckNotExact;
+}
+
 bool CWinSystemGbm::SupportsNativeDVOutput(bool anyMode, bool report) const
 {
   const auto info = DVDisplayInfo();
@@ -1563,6 +1601,19 @@ bool CWinSystemGbm::SupportsNativeDVOutput(bool anyMode, bool report) const
                "told so (amdgpu.dvbridge_dce=1), because it has not been seen to show a picture "
                "there (the kernel log says so); Dolby Vision plays converted to HDR10";
   }
+  // Hades: ... or the last check of the output found that this card changes the pixels of the
+  // tunnel on this output (OutputCheckVerdict.h, RefusesNative(); the reason code stays "output", as
+  // for the cards where the tunnel is not offered)
+  else if (KODI::WINDOWING::GBM::OUTPUT_CHECK::RefusesNative(
+               backend == COutputHandover::Driver::KMS_PROPERTIES && OutputCheckNotExact(*connector),
+               backend == COutputHandover::Driver::KMS_PROPERTIES))
+  {
+    code = "output";
+    reason = "the last \"Check the Dolby Vision output\" found that this graphics card changes the "
+             "pixels of the tunnel on this output, with this kernel and these parameters of its "
+             "driver: a Dolby Vision display could not read its metadata, and Dolby Vision plays "
+             "converted to HDR10. A new check after a change of the system decides again";
+  }
   else if (lowLatency && !COutputHandover::SupportsLowLatency(*connector))
   {
     // Hades: a kernel or NVIDIA module without Low-Latency over the tunnel
diff --git a/xbmc/windowing/gbm/WinSystemGbm.h b/xbmc/windowing/gbm/WinSystemGbm.h
index dd5c64d..d2d9ea8 100644
--- a/xbmc/windowing/gbm/WinSystemGbm.h
+++ b/xbmc/windowing/gbm/WinSystemGbm.h
@@ -770,6 +770,15 @@ protected:
   //! ... an output of amdgpu on a DisplayPort connector with DVBRIDGE_DUAL_MODE: whether a passive
   //! adaptor is behind it is read again with each request (QueueLinkDepth())
   bool m_linkAmdgpuDualMode = false;
+  //! Hades: whether the last check of the Dolby Vision output said that the card of this output
+  //! changes the pixels of the tunnel, with this kernel and these parameters of its driver
+  //! (OutputCheckVerdict.h): kept for the file of the report and the output, as it is asked with
+  //! each picture of a Dolby Vision video (SupportsNativeDVOutput())
+  bool OutputCheckNotExact(CDRMConnector& connector) const;
+  mutable std::mutex m_outputCheckLock;
+  mutable std::string m_outputCheckKey;
+  mutable bool m_outputCheckNotExact = false;
+  mutable int m_outputCheckTold = -1;
   //! ... what Kodi asked for "max bpc" last (QueueLinkDepth()): queued again with what a request
   //! that is made again carries (RequeueOutputProperties())
   std::optional<uint64_t> m_linkBpc;
diff --git a/xbmc/windowing/gbm/WinSystemGbmGLESContext.cpp b/xbmc/windowing/gbm/WinSystemGbmGLESContext.cpp
index 48ed810..c91ba33 100644
--- a/xbmc/windowing/gbm/WinSystemGbmGLESContext.cpp
+++ b/xbmc/windowing/gbm/WinSystemGbmGLESContext.cpp
@@ -90,7 +90,6 @@ extern "C"
 #include "windowing/gbm/DVPlusModeStart.h"
 #include "windowing/gbm/DVPlusVBlank.h"
 #include "windowing/gbm/HotplugRelink.h"
-#include "windowing/gbm/OutputCheckVerdict.h"
 #include "windowing/gbm/drm/DRMDisplayWatch.h"
 #include "windowing/gbm/drm/NvidiaDualMode.h"
 
@@ -5562,35 +5561,6 @@ int CWinSystemGbmGLESContext::Hdr10TunnelOrdinaryLink(const drmModeModeInfo& mod
   return answer;
 }
 
