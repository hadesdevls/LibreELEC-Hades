diff --git a/system/shaders/GLES/2.0/gles_lut3d_curve.frag b/system/shaders/GLES/2.0/gles_lut3d_curve.frag
new file mode 100644
index 0000000..d52bd33
--- /dev/null
+++ b/system/shaders/GLES/2.0/gles_lut3d_curve.frag
@@ -0,0 +1,37 @@
+// Hades: the 1D LUT of a 3D LUT of the display (a .cube of LUT_1D_SIZE, alone or as Resolve's shaper, ArgyllCMS's
+// .cal: dvbridge_lut.h), applied before its 3D table (gles_lut3d.frag) as the bridge applies it (dvbridge_lut_shader()):
+// each channel by its curve, linearly between the two points around it. Put into a shader only where the LUT has one
+// (VideoShaders/Lut3dGLES.h): without one, the shader is the one of a 3D LUT alone, to the byte. Its points are a 2D
+// texture of 32-bit floats of their own, one after the other in rows (tools/dvbridge/dvbridge_lut_atlas.h), read at the
+// centres of their texels, in highp.
+#define KODI_LUT3D_CURVE
+#if __VERSION__ >= 300
+#define KODI_LUT3D_CURVE_TEXTURE texture
+#elif defined(GL_FRAGMENT_PRECISION_HIGH)
+#define KODI_LUT3D_CURVE_TEXTURE texture2D
+#else
+#error "the 1D LUT is read and interpolated in highp, which this GPU does not have in a fragment shader"
+#endif
+
+uniform highp sampler2D m_lut3dCurveTable;
+// points - 1, texels a row, 1 / the width, 1 / the height of its texture
+uniform highp vec4 m_lut3dCurve;
+
+// the value of point i (an integer) of the curves
+highp vec3 KodiLut3dCurveAt(highp float i)
+{
+  highp float row = floor((i + 0.5) / m_lut3dCurve.y);
+  highp float col = i - row * m_lut3dCurve.y;
+  return KODI_LUT3D_CURVE_TEXTURE(m_lut3dCurveTable, vec2(col + 0.5, row + 0.5) * m_lut3dCurve.zw).rgb;
+}
+
+highp vec3 KodiLut3dCurve(highp vec3 c)
+{
+  highp vec3 p = clamp(c, 0.0, 1.0) * m_lut3dCurve.x;
+  highp vec3 i = min(floor(p), vec3(m_lut3dCurve.x - 1.0));
+  highp vec3 f = p - i;
+  return vec3(mix(KodiLut3dCurveAt(i.r).r, KodiLut3dCurveAt(i.r + 1.0).r, f.r),
+              mix(KodiLut3dCurveAt(i.g).g, KodiLut3dCurveAt(i.g + 1.0).g, f.g),
+              mix(KodiLut3dCurveAt(i.b).b, KodiLut3dCurveAt(i.b + 1.0).b, f.b));
+}
+
