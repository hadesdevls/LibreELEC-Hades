 }
 
+bool CLut3dGLES::PutCurve(const float* rgb, int size, int width, int height, std::string& why)
+{
+  why.clear();
+  if (!m_texture || !rgb || size < 2 || width < 1 || height < 1 || size > width * height ||
+      size <= width * (height - 1))
+  {
+    why = "no 1D LUT";
+    return false;
+  }
+#if defined(GL_ES_VERSION_3_0)
+  for (int i = 0; i < 16 && glGetError() != GL_NO_ERROR; ++i)
+    ;
+  GLint alignment = 4, rowLength = 0;
+  glGetIntegerv(GL_UNPACK_ALIGNMENT, &alignment);
+  glGetIntegerv(GL_UNPACK_ROW_LENGTH, &rowLength);
+  glPixelStorei(GL_UNPACK_ALIGNMENT, 4);
+  glPixelStorei(GL_UNPACK_ROW_LENGTH, 0);
+  glGenTextures(1, &m_curveTexture);
+  glActiveTexture(GL_TEXTURE0 + CURVE_UNIT);
+  glBindTexture(GL_TEXTURE_2D, m_curveTexture);
+  // (read at the centres of its texels, as the table)
+  glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_MIN_FILTER, GL_NEAREST);
+  glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_MAG_FILTER, GL_NEAREST);
+  glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_WRAP_S, GL_CLAMP_TO_EDGE);
+  glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_WRAP_T, GL_CLAMP_TO_EDGE);
+  glTexImage2D(GL_TEXTURE_2D, 0, GL_RGB32F, width, height, 0, GL_RGB, GL_FLOAT, nullptr);
+  // the full rows, then the points of the last one, straight from the LUT
+  const int full = size / width, rest = size - full * width;
+  if (full > 0)
+    glTexSubImage2D(GL_TEXTURE_2D, 0, 0, 0, width, full, GL_RGB, GL_FLOAT, rgb);
+  if (rest > 0)
+    glTexSubImage2D(GL_TEXTURE_2D, 0, 0, full, rest, 1, GL_RGB, GL_FLOAT,
+                    rgb + static_cast<size_t>(full) * static_cast<size_t>(width) * 3);
+  const GLenum error = glGetError();
+  glBindTexture(GL_TEXTURE_2D, 0);
+  glActiveTexture(GL_TEXTURE0);
+  glPixelStorei(GL_UNPACK_ALIGNMENT, alignment);
+  glPixelStorei(GL_UNPACK_ROW_LENGTH, rowLength);
+  if (error != GL_NO_ERROR)
+  {
+    why = StringUtils::Format("the GPU did not take its 1D LUT of {} points as a texture of {}x{} 32-bit floats: GL "
+                              "error {:#x}",
+                              size, width, height, error);
+    Release();
+    return false;
+  }
+  m_bytes += static_cast<size_t>(width) * static_cast<size_t>(height) * 3 * sizeof(float);
+  return true;
+#else
+  why = "its 1D LUT is a texture of 32-bit floats, which needs OpenGL ES 3";
+  return false;
+#endif
+}
+
 void CLut3dGLES::Release()
 {
   if (m_texture)
     glDeleteTextures(1, &m_texture);
   m_texture = 0;
+  if (m_curveTexture)
+    glDeleteTextures(1, &m_curveTexture);
+  m_curveTexture = 0;
   m_bytes = 0;
   m_ready = false;
 }
@@ -112,9 +169,11 @@ void CLut3dGLES::SetSignal(bool limited, bool apply)
   m_apply = apply;
 }
 
-bool CLut3dGLES::Insert(CShader& pixel, const std::string& marker)
+bool CLut3dGLES::Insert(CShader& pixel, const std::string& marker) const
 {
-  return pixel.InsertSource("gles_lut3d.frag", "void main()") &&
+  // (the functions of the 1D LUT first: those of the table call them)
+  return (!HasCurve() || pixel.InsertSource("gles_lut3d_curve.frag", "void main()")) &&
+         pixel.InsertSource("gles_lut3d.frag", "void main()") &&
          pixel.InsertSource("gles_lut3d_body.frag", marker);
 }
 
@@ -126,6 +185,9 @@ void CLut3dGLES::Locate(GLuint program, Handles& handles)
   handles.shaper = glGetUniformLocation(program, "m_lut3dShaper");
   handles.out = glGetUniformLocation(program, "m_lut3dOut");
   handles.signal = glGetUniformLocation(program, "m_lut3dSignal");
+  // (-1 in a shader made without the 1D LUT)
+  handles.curveTable = glGetUniformLocation(program, "m_lut3dCurveTable");
+  handles.curve = glGetUniformLocation(program, "m_lut3dCurve");
 }
 
 void CLut3dGLES::Bind(const Handles& handles) const
@@ -141,11 +203,21 @@ void CLut3dGLES::Bind(const Handles& handles) const
   // (the limited range of the output as CConvertMatrix::GetYuvMat() makes it: 64 to 940 of 1023)
   glUniform3f(handles.signal, m_limited ? (940.0f - 64.0f) / 1023.0f : 1.0f, m_limited ? 64.0f / 1023.0f : 0.0f,
               m_apply && Valid() ? 1.0f : 0.0f);
+  if (handles.curveTable >= 0)
+  {
+    glActiveTexture(GL_TEXTURE0 + CURVE_UNIT);
+    glBindTexture(GL_TEXTURE_2D, m_curveTexture);
+    glActiveTexture(GL_TEXTURE0);
+    glUniform1i(handles.curveTable, CURVE_UNIT);
+    glUniform4fv(handles.curve, 1, m_curve);
+  }
 }
 
 void CLut3dGLES::Unbind()
 {
   glActiveTexture(GL_TEXTURE0 + UNIT);
   glBindTexture(GL_TEXTURE_2D, 0);
+  glActiveTexture(GL_TEXTURE0 + CURVE_UNIT);
+  glBindTexture(GL_TEXTURE_2D, 0);
   glActiveTexture(GL_TEXTURE0);
 }
