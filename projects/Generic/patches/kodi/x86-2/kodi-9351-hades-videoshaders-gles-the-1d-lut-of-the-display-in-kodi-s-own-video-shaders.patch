+    GLint curveTable{-1};
+    GLint curve{-1};
   };
   //! The uniforms of the LUT in a linked program
   static void Locate(GLuint program, Handles& handles);
-  //! The table on its unit and the values of the uniforms (the program in use); the active unit is left at 0
+  //! The table on its unit (and its 1D LUT on the next) and the values of the uniforms (the program in use); the
