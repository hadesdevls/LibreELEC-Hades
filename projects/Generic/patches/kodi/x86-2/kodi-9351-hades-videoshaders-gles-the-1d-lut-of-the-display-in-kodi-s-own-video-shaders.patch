   /*!
    * \brief The range of the picture's signal (limited: 64 to 940 of 1023, as CConvertMatrix makes it) and whether the
@@ -72,8 +84,8 @@ public:
   bool Applied() const { return m_apply; }
 
   //! Puts the shader files of the LUT into a pixel shader: its functions before main(), its call before marker (the
-  //! place where the dither goes, which is put in after it)
-  static bool Insert(CShader& pixel, const std::string& marker);
+  //! place where the dither goes, which is put in after it); the functions of its 1D LUT first, where it has one
+  bool Insert(CShader& pixel, const std::string& marker) const;
 
   struct Handles
   {
@@ -83,16 +95,20 @@ public:
     GLint shaper{-1};
     GLint out{-1};
