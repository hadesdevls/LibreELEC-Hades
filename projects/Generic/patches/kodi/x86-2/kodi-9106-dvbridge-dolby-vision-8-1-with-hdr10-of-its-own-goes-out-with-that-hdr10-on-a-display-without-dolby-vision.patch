From 0df8f710e89772c0bd3a6d09d572b3eb45d6ffcd Mon Sep 17 00:00:00 2001
From: Hades <15710513+hadesdevls@users.noreply.github.com>
Date: Wed, 18 Nov 2026 07:15:55 +0000
Subject: [PATCH] DVBridge: Dolby Vision 8.1 with HDR10+ of its own goes out
 with that HDR10+ on a display without Dolby Vision

A video of profile 8.1 whose packets carry HDR10+ metadata of its own
(CDVDDemuxFFmpeg::ProbeDualHdr10Plus()) was given DualVerdict::DISPLAY
on a display that takes HDR10+ and not native Dolby Vision: "as before",
whatever videoscreen.hadesdualhdr says. As before means two things there:

- with the defaults, it is not rebuilt (its base layer is a picture by
  itself), and its base layer goes to the ordinary output with its own
  HDR10+ InfoFrame (VideoPicture::hdr10PlusVsif, sent where HDR passes
  through: CHDR10PlusOutput);
- with "Send it as HDR10+ where the display takes it"
  (videoscreen.hadesdvashdr10plus) on, ConversionEligibleForHDR10Plus()
  rebuilds it, and it goes out with HDR10+ that Hades measures from the
  rebuilt picture: its own HDR10+ metadata, made for that HDR10 base
  layer by whoever graded it, are left aside.

On such a display a profile 8.1 video now goes out with its own HDR10+
in both cases: where the settings would rebuild it, it is sent as the
HDR10+ it also is (HDR10PLUS_DISPLAY, which wins: doviHdr10PlusWins, as
on a display that takes both with the setting on HDR10+); where they do
not, it plays as before and the log says that its own HDR10+ goes with
it (BASE_LAYER_HDR10PLUS). It stays as before where Dolby Vision rebuilt
as HDR10 is mapped to the display (MAPPED: HDR10+ describes a picture as
mastered), where the user chose its Dolby Vision or another output for
the video ("Dolby Vision as HDR10+" still rebuilds and measures it), and
for profile 7, whose enhancement layer is not given up. A file that
carries the two as two streams already plays the HDR10+ one on such a
display (TwoStreamsOf()).

The verdict is said in kodi.log as before: "DV: this video has Dolby
Vision (profile 8) and HDR10+ metadata of its own: ...".
---
 .../DVDCodecs/Video/DVPlaybackPolicy.h        | 60 +++++++++++++++++--
 .../windowing/gbm/WinSystemGbmGLESContext.cpp | 23 ++++++-
 2 files changed, 77 insertions(+), 6 deletions(-)

diff --git a/xbmc/cores/VideoPlayer/DVDCodecs/Video/DVPlaybackPolicy.h b/xbmc/cores/VideoPlayer/DVDCodecs/Video/DVPlaybackPolicy.h
index b001112..c55ed79 100644
--- a/xbmc/cores/VideoPlayer/DVDCodecs/Video/DVPlaybackPolicy.h
+++ b/xbmc/cores/VideoPlayer/DVDCodecs/Video/DVPlaybackPolicy.h
@@ -811,6 +811,16 @@ enum class DualVerdict
   DISPLAY, //!< as before: the display does not take both
   BASE_LAYER, //!< as before: its base layer is not HDR10, so there is no HDR10+ picture to send
   OTHER_CHOICE, //!< as the user chose for the video: another output, which stands
+  //! HDR10+, on a display that takes HDR10+ and not native Dolby Vision: a video of profile 8.1 that
+  //! the settings would rebuild for output as HDR10 (with HDR10+ measured from the picture, "Send it as
+  //! HDR10+ where the display takes it"), whose own HDR10+ metadata describe its base layer as graded
+  HDR10PLUS_DISPLAY,
+  //! as before, on such a display: a video of profile 8.1 that is not rebuilt, whose base layer goes to
+  //! the ordinary output with its own HDR10+ metadata already
+  BASE_LAYER_HDR10PLUS,
+  //! as before, on such a display: Dolby Vision rebuilt as HDR10 is mapped to the display
+  //! (videoscreen.hadesdvhdr10map), and HDR10+ describes a picture as it was mastered
+  MAPPED,
 };
 
 /*!
@@ -821,20 +831,48 @@ enum class DualVerdict
  * \param nativeDV the display takes native Dolby Vision in a mode that carries it
  * \param hdr10Plus HDR10+ metadata can be sent to the display (its block, and the connector's
  *        HDR10PLUS_VSIF: CWinSystemGbm::HDR10PlusOutputVersion())
+ * \param rebuilt where native output is not had, the settings rebuild a video of this profile for
+ *        output as HDR10 (ConversionTargetOf(), with the output chosen as the settings say)
+ * \param mapped the settings map Dolby Vision rebuilt as HDR10 to the display
+ *        (videoscreen.hadesdvhdr10map)
  *
  * HDR10+ only where its base layer is HDR10 (BaseLayerIsHdr10(): profile 7 of a Blu-ray disc, 8.1), whose
  * HDR10+ metadata describe that picture; only where the display takes both; with the output chosen for the
  * video as the settings say (AUTOMATIC) or as HDR10+. Everything else is sent as before.
+ *
+ * Hades: on a display that takes HDR10+ and not native Dolby Vision, a video of profile 8.1 is sent as
+ * the HDR10+ it also is where the settings would rebuild it ("Send it as HDR10+ where the display takes
+ * it": HDR10+ measured from the rebuilt picture): its own HDR10+ metadata, made for its HDR10 base layer,
+ * describe it as it was graded. Where it is not rebuilt (the default), its base layer goes out with them
+ * already. Not where the picture is mapped to the display, which HDR10+ cannot describe, nor where the
+ * user chose its Dolby Vision or another output for the video; a video of profile 7 keeps its enhancement
+ * layer, as before (no Dolby Vision is given up).
  */
-constexpr DualVerdict DualVerdictOf(
-    int setting, OutputChoice choice, int profile, int compatibility, bool nativeDV, bool hdr10Plus)
+constexpr DualVerdict DualVerdictOf(int setting,
+                                    OutputChoice choice,
+                                    int profile,
+                                    int compatibility,
+                                    bool nativeDV,
+                                    bool hdr10Plus,
+                                    bool rebuilt = false,
+                                    bool mapped = false)
 {
   if (!BaseLayerIsHdr10(profile, compatibility))
     return DualVerdict::BASE_LAYER;
   if (choice != OutputChoice::AUTOMATIC && choice != OutputChoice::DOLBY_VISION &&
       choice != OutputChoice::HDR10PLUS)
     return DualVerdict::OTHER_CHOICE;
-  if (!nativeDV || !hdr10Plus)
+  if (!nativeDV)
+  {
+    if (!hdr10Plus || profile != 8 || choice == OutputChoice::DOLBY_VISION)
+      return DualVerdict::DISPLAY;
+    if (mapped)
+      return DualVerdict::MAPPED;
+    if (choice == OutputChoice::HDR10PLUS)
+      return DualVerdict::HDR10PLUS_CHOSEN;
+    return rebuilt ? DualVerdict::HDR10PLUS_DISPLAY : DualVerdict::BASE_LAYER_HDR10PLUS;
+  }
+  if (!hdr10Plus)
     return DualVerdict::DISPLAY;
   if (choice == OutputChoice::HDR10PLUS)
     return DualVerdict::HDR10PLUS_CHOSEN;
@@ -911,7 +949,8 @@ inline const char* TwoStreamsText(TwoStreams verdict)
 //! Hades: the video is sent as the HDR10+ it also is (CDVDStreamInfo::doviHdr10PlusWins)
 constexpr bool Hdr10PlusWins(DualVerdict verdict)
 {
-  return verdict == DualVerdict::HDR10PLUS || verdict == DualVerdict::HDR10PLUS_CHOSEN;
+  return verdict == DualVerdict::HDR10PLUS || verdict == DualVerdict::HDR10PLUS_CHOSEN ||
+         verdict == DualVerdict::HDR10PLUS_DISPLAY;
 }
 
 //! Hades: the verdict for the log
@@ -941,6 +980,19 @@ inline std::string DualVerdictText(
              std::to_string(compatibility) + "): it plays as before, as Dolby Vision";
     case DualVerdict::OTHER_CHOICE:
       return "another output was chosen for this video, which stands; " + setting + " does not apply";
+    case DualVerdict::HDR10PLUS_DISPLAY:
+      return "the display takes HDR10+ and not native Dolby Vision: sent as HDR10+, " +
+             asHdr10Plus +
+             ", rather than rebuilt with HDR10+ measured from the picture (\"Send it as HDR10+ "
+             "where the display takes it\"): its own HDR10+ metadata describe its base layer as "
+             "it was graded";
+    case DualVerdict::BASE_LAYER_HDR10PLUS:
+      return "the display takes HDR10+ and not native Dolby Vision: it plays as before, its base "
+             "layer, the HDR10 picture, with its own HDR10+ metadata (it is not rebuilt)";
+    case DualVerdict::MAPPED:
+      return "the display takes HDR10+ and not native Dolby Vision, and Dolby Vision rebuilt as "
+             "HDR10 is mapped to the display (videoscreen.hadesdvhdr10map), which HDR10+ metadata "
+             "cannot describe: it plays as before, rebuilt and mapped";
   }
   return "";
 }
diff --git a/xbmc/windowing/gbm/WinSystemGbmGLESContext.cpp b/xbmc/windowing/gbm/WinSystemGbmGLESContext.cpp
index 2350c86..610fe1c 100644
--- a/xbmc/windowing/gbm/WinSystemGbmGLESContext.cpp
+++ b/xbmc/windowing/gbm/WinSystemGbmGLESContext.cpp
@@ -2928,6 +2928,10 @@ void DualDisplay(bool& nativeDV, bool& hdr10Plus)
   nativeDV = window && window->SupportsNativeDVOutput(true);
   hdr10Plus = window && window->HDR10PlusSendable();
 }
+
+// (defined further down)
+bool ConversionMappedBySettings();
+DVBRIDGE::ConversionSetting ConversionSettingNow();
 } // namespace
 
 unsigned int DVBRIDGE::VideoNumber()
@@ -3064,8 +3068,23 @@ DVBRIDGE::DualVerdict DVBRIDGE::DualHdr10PlusFound(int profile, int compatibilit
   const int setting = settings && settings->GetSetting(CSettings::SETTING_VIDEOSCREEN_HADESDUALHDR)
                           ? settings->GetInt(CSettings::SETTING_VIDEOSCREEN_HADESDUALHDR)
                           : static_cast<int>(DualHdr::DOLBY_VISION);
-  const DualVerdict verdict =
-      DualVerdictOf(setting, GetOutputChoice(), profile, compatibility, nativeDV, hdr10Plus);
+  // Hades: where native output is not had, whether the settings rebuild such a video for output as HDR10
+  // (as ConversionTargetOf() does with a stream of this profile and no enhancement layer, the output
+  // chosen as the settings say), and whether they map it to the display
+  bool rebuilt = false;
+  const bool mapped = ConversionMappedBySettings();
+  if (const auto* window = dynamic_cast<CWinSystemGbmGLESContext*>(CServiceBroker::GetWinSystem());
+      window && !nativeDV)
+  {
+    const ConversionSetting conversion = ConversionSettingNow();
+    rebuilt = ConversionTargetOf(window->SupportsDVConversion(), false, conversion, false,
+                                 OutputChoice::AUTOMATIC, profile, compatibility, false, false,
+                                 false, false,
+                                 conversion != ConversionSetting::EVERY &&
+                                     window->DVPlusPossible()) == ConversionTarget::HDR10;
+  }
+  const DualVerdict verdict = DualVerdictOf(setting, GetOutputChoice(), profile, compatibility,
+                                            nativeDV, hdr10Plus, rebuilt, mapped);
   CLog::Log(LOGINFO, "DV: this video has Dolby Vision (profile {}) and HDR10+ metadata of its own: {}",
             profile, DualVerdictText(verdict, profile, compatibility, nativeDV, hdr10Plus));
   return verdict;
-- 
2.53.0

