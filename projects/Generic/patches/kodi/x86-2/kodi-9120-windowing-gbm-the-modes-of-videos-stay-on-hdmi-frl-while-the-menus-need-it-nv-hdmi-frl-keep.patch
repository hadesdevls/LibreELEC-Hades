 }
 
+int64_t CWinSystemGbm::MenusClockKHz(std::string& text) const
+{
+  // (the menus as the VRR video has them: the resolution chosen in Settings, or the desktop's; the
+  // mode of a resolution is the one at the place its strId says among the connector's,
+  // CDRMUtils::GetConnectorModes())
+  text.clear();
+  RESOLUTION menus = RES_DESKTOP;
+  if (CDisplaySettings::GetInstance().GetCurrentResolution() > RES_DESKTOP)
+    menus = CDisplaySettings::GetInstance().GetCurrentResolution();
+  const RESOLUTION_INFO info = GetGfxContext().GetResInfo(menus);
+  text = StringUtils::Format("{}x{} @ {:.3f} Hz", info.iScreenWidth, info.iScreenHeight,
+                             info.fRefreshRate);
+  if (!m_DRM || info.strId.empty())
+    return 0;
+  char* end = nullptr;
+  const long place = std::strtol(info.strId.c_str(), &end, 10);
+  if (!end || *end != '\0' || place < 0)
+    return 0;
+  const std::vector<drmModeModeInfo> modes = m_DRM->GetConnectorModes();
+  if (place >= static_cast<long>(modes.size()))
+    return 0;
+  const drmModeModeInfo& mode = modes[static_cast<size_t>(place)];
+  if (mode.hdisplay != info.iScreenWidth || mode.vdisplay != info.iScreenHeight)
+    return 0;
+  return mode.clock;
+}
+
+void CWinSystemGbm::StageFrlKeep()
+{
+  namespace KEEP = KODI::WINDOWING::GBM::FRL_KEEP;
+  m_frlKeepStaged.reset();
+  m_frlKeepModeset = false;
+  auto drm = std::dynamic_pointer_cast<CDRMAtomic>(m_DRM);
+  CDRMConnector* connector = drm ? drm->GetConnector() : nullptr;
+  if (!connector || !connector->SupportsProperty(KEEP::PROPERTY))
+    return;
+  // (a change of it alone is no mode set: it is staged with one, and holds from it)
+  if (!drm->ModesetPending())
+    return;
+  m_frlKeepModeset = true;
+  m_frlKeepMenusKHz = MenusClockKHz(m_frlKeepMenus);
+  m_frlKeepWhy = KEEP::Wanted(KEEP::MenusNeedFrl(m_frlKeepMenusKHz), m_frlKeepBlocked);
+  const auto value = KEEP::Stage(true, m_frlKeepWhy, connector->GetPropertyValue(KEEP::PROPERTY),
+                                 NativeDVOutputInUse());
+  if (value && drm->AddProperty(connector, KEEP::PROPERTY, *value))
+    m_frlKeepStaged = value;
+}
+
+void CWinSystemGbm::FrlKeepCommitted()
+{
+  namespace KEEP = KODI::WINDOWING::GBM::FRL_KEEP;
+  const auto staged = std::exchange(m_frlKeepStaged, std::nullopt);
+  const bool modeset = std::exchange(m_frlKeepModeset, false);
+  CDRMConnector* connector = m_DRM ? m_DRM->GetConnector() : nullptr;
+  if (!connector)
+    return;
+  // the block of the way to a TMDS mode ends once the output is over TMDS
+  if (m_frlKeepBlocked && connector->SupportsProperty("NV_OUTPUT_LINK") &&
+      KEEP::Unblock(true, modeset, connector->ReadPropertyValue("NV_OUTPUT_LINK")))
+  {
+    m_frlKeepBlocked = false;
+    CLog::Log(LOGINFO,
+              "HDMI FRL: the output went over TMDS after the hang: the modes of videos are kept on "
+              "FRL again from the next change of mode that finds the menus over FRL ({})",
+              KEEP::PROPERTY);
+  }
+  if (!staged)
+    return;
+  const auto kernel = connector->GetPropertyValue(KEEP::PROPERTY);
+  if (kernel != staged)
+  {
+    CLog::Log(LOGWARNING,
+              "HDMI FRL: the driver did not take {} {} with this change of mode: the link of the "
+              "modes of videos is the driver's, TMDS where it carries them, as before",
+              KEEP::PROPERTY, *staged);
+    return;
+  }
+  if (*staged == 1)
+    CLog::Log(LOGINFO,
+              "HDMI FRL: the menus ({}, {} kHz) need FRL, more than TMDS carries ({} kHz in RGB at "
+              "8 bits): the modes of videos stay on FRL while the output is on it ({} 1), so that a "
+              "video and the way back to the menus do not change the link between TMDS and FRL "
+              "(the change back to FRL left the RTX 4080 SUPER of the tests without a picture 4 "
+              "times in 35: FrlKeep.h); the kernel log says \"kept on FRL\" in each such mode set",
+              m_frlKeepMenus, m_frlKeepMenusKHz, HOTPLUG_RELINK::TMDS_MAX_KHZ,
+              KEEP::PROPERTY);
+  else
+    CLog::Log(LOGINFO, "HDMI FRL: the link of the modes of videos is the driver's again ({} 0): {}",
+              KEEP::PROPERTY,
+              m_frlKeepWhy == KEEP::Why::TMDS_FALLBACK
+                  ? "the menus go to a TMDS mode after a hang"
+                  : StringUtils::Format("the menus ({}) fit TMDS, or their mode is not known",
+                                        m_frlKeepMenus));
+}
