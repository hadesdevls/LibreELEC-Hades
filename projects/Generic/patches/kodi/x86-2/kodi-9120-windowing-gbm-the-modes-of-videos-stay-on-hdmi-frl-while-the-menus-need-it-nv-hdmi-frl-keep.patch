+/*
+ * Hades: the modes of videos stay on HDMI FRL while the menus need it, on nvidia-drm
+ * (NV_HDMI_FRL_KEEP, nvidia-open-kernel-modules-9078).
+ *
+ * The RTX 4080 SUPER of the Hades tests (driver 620.70.06, an LG C5) left the TV without a picture
+ * in 4 of 35 changes of mode from the TMDS mode of a video back to the 3840x2160 at 120 Hz of the
+ * menus over FRL (2026-11-12 and 18): the link trained, the TV had its four lanes, the raster of
+ * the head stood at line 0 (FrlModeChange.h). The kernel logs of those days have 30 changes of mode
+ * from FRL to FRL on that output (Kodi's start from the console's FRL mode, the same mode again for
+ * HDMI VRR or another output) and 39 from FRL to TMDS, and none of them hung. NVIDIA's driver shuts
+ * the head down and trains the link again in all of them alike; what only the ones that hung have
+ * is the change of the link from TMDS to FRL. NVKMS takes TMDS for every mode that TMDS carries (a
+ * video at 23.976 Hz is 297 MHz), so with the menus over FRL each video went FRL to TMDS and back.
+ *
+ * With NV_HDMI_FRL_KEEP at 1 in a mode set, NVKMS keeps a head that runs over FRL on FRL for a mode
+ * that TMDS would carry, at the rate the link has, without DSC, in the same colour format and depth
+ * (nvHadesFrlKeepDecide() of NVKMS says where; not for HDMI 3D frame packing, YCbCr 4:2:0, or a
+ * head that is not on FRL then). A video and the way back to the menus then go from FRL to FRL; a
+ * Dolby Vision video goes out in the same RGB at 8 bpc over the other link. The kernel log of each
+ * HDMI mode set says "kept on FRL" for such a mode.
+ *
+ * Kodi asks for it in its mode sets (Wanted()) while the mode of its menus (the resolution chosen in
+ * Settings) needs FRL: its pixel clock is more than TMDS carries in RGB at 8 bits (TMDS_MAX_KHZ),
+ * which is how Kodi sends its menus (SDR at 8 bits). Not while the menus go to a TMDS mode after a
+ * hang (FRL_MODE_CHANGE::Fallback(): Block()), until the output is over TMDS (Unblock()); not while
+ * native Dolby Vision has the output (it keeps what it found, and gives it back). A test of a request
+ * that fails with it is made again without it (Without()). A change of it alone is no mode set: it
+ * holds from the next one, so it is staged only in a commit with one (Stage()).
+ * Pure: a test builds it on the host (tools/regress/kodi-host/output/presfix/frl_keep_test.cpp).
+ */
+namespace KODI::WINDOWING::GBM::FRL_KEEP
+{
+constexpr const char* PROPERTY = "NV_HDMI_FRL_KEEP";
+
+//! Whether the mode of the menus needs HDMI FRL: TMDS does not carry its pixel clock in RGB at 8
+//! bits; a clock that is not known (0) does not
+inline bool MenusNeedFrl(int64_t menusClockKHz)
+{
+  return menusClockKHz > HOTPLUG_RELINK::TMDS_MAX_KHZ;
+}
+
+//! Why Kodi asks for it, or does not, in its mode sets (Wanted())
+enum class Why
+{
+  MENUS_NEED_FRL, //!< asked: the menus need FRL
+  MENUS_FIT_TMDS, //!< not asked: TMDS carries the menus (or their clock is not known)
+  TMDS_FALLBACK, //!< not asked: the menus go to a TMDS mode after a hang (Block())
+};
+
+inline Why Wanted(bool menusNeedFrl, bool blocked)
+{
+  if (blocked)
+    return Why::TMDS_FALLBACK;
+  return menusNeedFrl ? Why::MENUS_NEED_FRL : Why::MENUS_FIT_TMDS;
+}
+
+/*!
+ * \brief The value to put in a request (nothing: leave it as the kernel has it): only in a request
+ *        with a mode set, only where the connector has the property (kernel: nothing without it),
+ *        not while native Dolby Vision has the output, and only where it differs from the kernel's
+ */
+inline std::optional<uint64_t> Stage(bool modesetPending,
+                                     Why why,
+                                     std::optional<uint64_t> kernel,
+                                     bool nativeDV)
+{
+  if (nativeDV || !modesetPending || !kernel)
+    return std::nullopt;
+  const uint64_t want = why == Why::MENUS_NEED_FRL ? 1 : 0;
+  if (*kernel == want)
+    return std::nullopt;
+  return want;
+}
+
+//! A test of a request failed whose value is inRequest: test it again with 0 (the link as NVKMS
+//! chooses it), or nothing where the request does not ask for 1
+inline std::optional<uint64_t> Without(std::optional<uint64_t> inRequest)
+{
+  if (!inRequest || *inRequest == 0)
+    return std::nullopt;
+  return 0;
+}
+
+//! Whether the block of the way to a TMDS mode ends after a commit: a change of mode went out and the
+//! output goes over a link that NV_OUTPUT_LINK says is not FRL (while it still says FRL, or says
+//! nothing, the block stays: Kodi then asks for nothing, as before this)
+inline bool Unblock(bool blocked, bool modesetCommitted, std::optional<uint64_t> linkAfter)
+{
+  if (!blocked || !modesetCommitted || !linkAfter)
+    return false;
+  const HOTPLUG_RELINK::Link link = HOTPLUG_RELINK::LinkOf(linkAfter);
+  return link == HOTPLUG_RELINK::Link::TMDS || link == HOTPLUG_RELINK::Link::TMDS_SCRAMBLED;
+}
+
+} // namespace KODI::WINDOWING::GBM::FRL_KEEP
