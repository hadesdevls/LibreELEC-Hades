From 41e598215cd89272a57e0c56608ff5a221fbe1b2 Mon Sep 17 00:00:00 2001
From: Hades <15710513+hadesdevls@users.noreply.github.com>
Date: Tue, 24 Nov 2026 23:39:47 +0000
Subject: [PATCH] [Hades][Settings] The custom gamma of the SDR target and the
 black of the display shown as numbers

Both are numbers, drawn as spinners of the format "string" without a
format of their own. In the screenshots of the settings taken in QEMU,
"Custom: gamma of the display" showed "?0?" at its default of 2.4 instead
of its value, and Kodi's default format for a number has one decimal,
which would show every black of "Black of the display" under 0.05 cd/m2
(its step is 0.0005) as "0.0".

They are sliders with a format now, as "Low-Latency: black of the display"
already is: the gamma with one decimal, the black with four and its unit.
The values, their range and their steps are as before.
---
 system/settings/settings.xml | 8 ++++++--
 1 file changed, 6 insertions(+), 2 deletions(-)

diff --git a/system/settings/settings.xml b/system/settings/settings.xml
index 70c1700..64e3ea8 100644
--- a/system/settings/settings.xml
+++ b/system/settings/settings.xml
@@ -3738,7 +3738,9 @@
           <step>0.2</step>
           <maximum>2.8</maximum>
         </constraints>
-        <control type="spinner" format="string" />
+        <control type="slider" format="number">
+          <format>{:.1f}</format>
+        </control>
       </setting>
       <!-- Hades: the gamut of the SDR output of HDR mapped to SDR (Dolby Vision rebuilt, HDR10, HDR10+ and HLG, by the
            bridge or by Kodi's own tone mapping): BT.709 by default, as every SDR picture; BT.2020 or DCI-P3 (D65) for a
@@ -4514,7 +4516,9 @@
           <step>0.0005</step>
           <maximum>0.5</maximum>
         </constraints>
-        <control type="spinner" format="string" />
+        <control type="slider" format="number">
+          <format>{:.4f} cd/m²</format>
+        </control>
       </setting>
       <!-- Hades: HDR10 and HDR10+ adapted to the display by the player (a projector): off by default,
            the display maps the video as it was mastered -->
-- 
