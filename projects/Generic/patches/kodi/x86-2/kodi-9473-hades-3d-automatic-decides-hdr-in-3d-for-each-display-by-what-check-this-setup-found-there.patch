+namespace
+{
+// What is kept of HDR in 3D, by display (STEREO3D::HDR_IN_3D_FILE); empty where there is no file yet
+DISPLAY_MODES::CDisplayModeMemory ReadHdrIn3D()
+{
+  DISPLAY_MODES::CDisplayModeMemory memory;
+  std::vector<uint8_t> bytes;
+  XFILE::CFile file;
+  if (XFILE::CFile::Exists(S::HDR_IN_3D_FILE) && file.LoadFile(S::HDR_IN_3D_FILE, bytes) > 0)
+    memory.Parse(std::string(bytes.begin(), bytes.end()));
+  return memory;
+}
+} // namespace
+
+void CWinSystemGbmGLESContext::LoadStereo3DHdr()
+{
+  // (the display that plays, known by the make and model of its EDID: no key, nothing found)
+  const std::string key = DisplayModeKey();
+  const auto kept = key.empty() ? std::nullopt : ReadHdrIn3D().Of(key);
+  m_stereo3dHdr = static_cast<int>(S::HdrIn3DOf(kept.value_or("")));
+  m_stereo3dHdrTold = kept && *kept == S::HDR_IN_3D_TOLD;
+  std::unique_lock lock(m_stereo3dHdrLock);
+  m_stereo3dHdrKey = key;
+}
+
+void CWinSystemGbmGLESContext::KeepStereo3DHdrTold() const
+{
+  std::string key;
+  {
+    std::unique_lock lock(m_stereo3dHdrLock);
+    key = m_stereo3dHdrKey;
+  }
+  DISPLAY_MODES::CDisplayModeMemory memory = ReadHdrIn3D();
+  // (never over what the check found there)
+  if (key.empty() || memory.Of(key) || !memory.Remember(key, S::HDR_IN_3D_TOLD))
+    return;
+  const std::string text = memory.Text();
+  const std::string temporary = std::string(S::HDR_IN_3D_FILE) + ".new";
+  XFILE::CFile file;
+  if (!file.OpenForWrite(temporary, true) ||
+      file.Write(text.data(), text.size()) != static_cast<ssize_t>(text.size()))
+  {
+    CLog::Log(LOGWARNING, "3D video: what was told of HDR in 3D could not be kept ({})",
+              S::HDR_IN_3D_FILE);
+    return;
+  }
+  file.Close();
+  if (!XFILE::CFile::Rename(temporary, S::HDR_IN_3D_FILE))
+    CLog::Log(LOGWARNING, "3D video: what was told of HDR in 3D could not be kept ({})",
+              S::HDR_IN_3D_FILE);
+}
