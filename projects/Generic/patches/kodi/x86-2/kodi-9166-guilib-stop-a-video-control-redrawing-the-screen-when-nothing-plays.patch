From 5c6df04043821d9c13553f9b623c839b9225e203 Mon Sep 17 00:00:00 2001
From: Chris <meischris39@hotmail.com>
Date: Mon, 2 Nov 2026 16:52:50 +0000
Subject: [PATCH] [guilib] Stop a video control redrawing the screen when
 nothing plays

Since a3d2a97305 a video control marks itself dirty every frame unless
video has its own plane, and with nothing playing it has none, so a skin
that keeps one visible on an idle screen redraws that screen every
frame. Only do it while the renderer is showing video through the GUI,
and once whenever the video starts, stops or changes layer, so its last
frame is cleared and a video plane's hole is opened and closed. With
smart redraw a window that hasn't changed isn't processed, so the
control also checks for those changes on the refresh timer.

[Hades: Hades already left the mark out of the frames where the GUI
pass can be reused (GuiPassReusable(), the Dolby Vision frames where no
control is dirty); that condition is kept on the every-frame mark, and
the marks of a start, a stop or a change of layer are taken as they
are.]
(cherry picked from commit 67b185e060d9148fae84e0cae5a7e0ae4534ba87)
---
 xbmc/guilib/GUIVideoControl.cpp | 27 ++++++++++++++++++++++++++-
 xbmc/guilib/GUIVideoControl.h   |  5 +++++
 2 files changed, 31 insertions(+), 1 deletion(-)

diff --git a/xbmc/guilib/GUIVideoControl.cpp b/xbmc/guilib/GUIVideoControl.cpp
index 25b671a..4a05bf7 100644
--- a/xbmc/guilib/GUIVideoControl.cpp
+++ b/xbmc/guilib/GUIVideoControl.cpp
@@ -38,12 +38,37 @@ void CGUIVideoControl::Process(unsigned int currentTime, CDirtyRegionList &dirty
   const auto appPlayer = components.GetComponent<CApplicationPlayer>();
   // Only fire for single-plane renderers where video draws via the GUI walk.
   // See CGUIWindowFullScreen::Process for full rationale.
-  if (!appPlayer->IsRenderingVideoLayer() && !CServiceBroker::GetWinSystem()->GuiPassReusable())
+  const bool renderingVideo = appPlayer->IsRenderingVideo();
+  const bool renderingInGui = renderingVideo && !appPlayer->IsRenderingVideoLayer();
+  // Also once whenever the video starts, stops or changes layer, so its area
+  // is redrawn: on its own layer that opens or closes the hole for it
+  // (Hades: but not every frame where the GUI pass can be left out: GuiPassReusable())
+  if ((renderingInGui && !CServiceBroker::GetWinSystem()->GuiPassReusable()) ||
+      renderingVideo != m_renderingVideo || renderingInGui != m_renderingInGui)
     MarkDirtyRegion();
+  m_renderingVideo = renderingVideo;
+  m_renderingInGui = renderingInGui;
 
   CGUIControl::Process(currentTime, dirtyregions);
 }
 
+bool CGUIVideoControl::OnMessage(CGUIMessage& message)
+{
+  // With smart redraw a window that hasn't changed isn't processed, so check on
+  // its refresh timer whether the video has started, stopped or changed layer
+  if (message.GetMessage() == GUI_MSG_REFRESH_TIMER && IsVisible())
+  {
+    const auto& components = CServiceBroker::GetAppComponents();
+    const auto appPlayer = components.GetComponent<CApplicationPlayer>();
+    const bool renderingVideo = appPlayer->IsRenderingVideo();
+    const bool renderingInGui = renderingVideo && !appPlayer->IsRenderingVideoLayer();
+    if (renderingVideo != m_renderingVideo || renderingInGui != m_renderingInGui)
+      MarkDirtyRegion();
+  }
+
+  return CGUIControl::OnMessage(message);
+}
+
 void CGUIVideoControl::Render()
 {
   if (CServiceBroker::GetWinSystem()->GetGfxContext().GetRenderOrder() ==
diff --git a/xbmc/guilib/GUIVideoControl.h b/xbmc/guilib/GUIVideoControl.h
index a7a23b8..5db8248 100644
--- a/xbmc/guilib/GUIVideoControl.h
+++ b/xbmc/guilib/GUIVideoControl.h
@@ -28,10 +28,15 @@ public:
   CGUIVideoControl* Clone() const override { return new CGUIVideoControl(*this); }
 
   void Process(unsigned int currentTime, CDirtyRegionList &dirtyregions) override;
+  bool OnMessage(CGUIMessage& message) override;
   void Render() override;
   void RenderEx() override;
   EVENT_RESULT OnMouseEvent(const CPoint& point, const KODI::MOUSE::CMouseEvent& event) override;
   bool CanFocus() const override;
   bool CanFocusFromPoint(const CPoint &point) const override;
+
+private:
+  bool m_renderingVideo{false};
+  bool m_renderingInGui{false};
 };
 
