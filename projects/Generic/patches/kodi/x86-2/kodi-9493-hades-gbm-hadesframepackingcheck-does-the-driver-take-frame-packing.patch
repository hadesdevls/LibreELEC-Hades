+    answer = gbm->FramePackingCheck();
+#endif
+  if (CGUIWindow* home = CServiceBroker::GetGUI()->GetWindowManager().GetWindow(WINDOW_HOME))
+    home->SetProperty(property, answer);
+  return 0;
+}
