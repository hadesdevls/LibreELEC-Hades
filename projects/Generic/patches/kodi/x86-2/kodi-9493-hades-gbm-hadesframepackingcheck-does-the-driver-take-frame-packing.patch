+
+#pragma once
+
+#include "drm/DRMStereo.h"
+
+#include <cmath>
+#include <cstdio>
+#include <span>
+#include <string>
+
+/*!
+ * \brief Hades: the card "3D: frame packing" of Check this setup asks the driver, with the display
+ *        connected and no 3D video, whether it takes the frame-packed mode that the display declares
+ *        (the builtin HadesFramePackingCheck, CWinSystemGbmEGLContext::FramePackingCheck()). Only
+ *        test commits: nothing changes on the screen. The buffers asked are those that a 3D video
+ *        would go out in: one of the kind of the window's (as GBM makes it), and on nvidia-drm the
+ *        driver's dumb buffers that Kodi makes where the driver refuses the window's (COwnScanout,
+ *        Memory::DUMB, issue #33). What this decides apart from Kodi is here, for the host tests.
+ */
+namespace KODI::WINDOWING::GBM::FP_CHECK
+{
+
+//! The Home window property that the builtin writes its answer to (a line of JSON)
+inline constexpr const char* PROPERTY = "hades.check.fp.result";
+
+/*!
+ * \brief Which of the frame-packed modes that the driver lists is asked: 1080p at 24000/1001 (the
+ *        3D Blu-ray), then 1080p at 24, then any 1080p, then the first; -1 where there is none
+ */
+inline int ChooseMode(std::span<const STEREO::Mode> modes)
+{
+  int best = -1;
+  int bestRank = 0;
+  for (size_t i = 0; i < modes.size(); ++i)
+  {
+    const STEREO::Mode& mode = modes[i];
+    if (STEREO::LayoutOf(mode.flags) != STEREO::Layout::FRAME_PACKING)
+      continue;
+    const double hz = STEREO::RefreshRate(mode);
+    int rank = 1;
+    if (mode.hdisplay == 1920 && mode.vdisplay == 1080)
+      rank = std::fabs(hz - 24000.0 / 1001.0) < 0.01 ? 4 : std::fabs(hz - 24.0) < 0.01 ? 3 : 2;
+    if (rank > bestRank)
+    {
+      best = static_cast<int>(i);
+      bestRank = rank;
+    }
+  }
+  return best;
+}
+
+//! What a test commit said of a kind of buffer
+enum class Answer
+{
+  TAKEN,
+  REFUSED,
+  NOT_MADE, //!< the buffers could not be made
+  NOT_ASKED, //!< made, but no test could be made (an output that is off, not atomic)
+  NONE //!< not a kind that this driver uses
+};
+
+inline const char* Name(Answer answer)
+{
+  switch (answer)
+  {
+    case Answer::TAKEN:
+      return "taken";
+    case Answer::REFUSED:
+      return "refused";
+    case Answer::NOT_MADE:
+      return "notmade";
+    case Answer::NOT_ASKED:
+      return "notasked";
+    case Answer::NONE:
+    default:
+      return "none";
+  }
+}
+
+/*!
+ * \brief What the card says first: taken where the driver took either kind of buffer (a 3D video
+ *        then goes out in frame packing), refused where it refused one and took none, notasked
+ *        where nothing could be asked
+ */
+inline const char* Overall(Answer window, Answer own)
+{
+  if (window == Answer::TAKEN || own == Answer::TAKEN)
+    return "taken";
+  if (window == Answer::REFUSED || own == Answer::REFUSED)
+    return "refused";
+  return "notasked";
+}
+
+//! The mode as the card names it: 1920x1080@23.976
+inline std::string ModeName(const STEREO::Mode& mode)
+{
+  char text[48];
+  std::snprintf(text, sizeof(text), "%ux%u@%.3f", static_cast<unsigned int>(mode.hdisplay),
+                static_cast<unsigned int>(mode.vdisplay), STEREO::RefreshRate(mode));
+  return text;
+}
+
+} // namespace KODI::WINDOWING::GBM::FP_CHECK
