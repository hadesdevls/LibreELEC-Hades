+
+// Hades: the card "3D: frame packing" of Check this setup (FramePackingCheck.h). The frame-packed mode
+// that the display declares, as the driver lists it, is asked in test commits with the buffers that
+// a 3D video would go out in: one of the kind of the window's of a frame-packed mode (CreateNewWindow():
+// 8 bits, and on nvidia-drm linear and as wide as the second eye needs), as GBM makes it, and on
+// nvidia-drm Kodi's own dumb buffers too (FramePackedOwnStart(), COwnScanout, Memory::DUMB: made and
+// checked as for a video, so that what the GPU can draw into them is known too). Nothing changes on
+// the screen, and everything that is made goes at the end.
+std::string CWinSystemGbmEGLContext::FramePackingCheck()
+{
+  using namespace FP_CHECK;
+  CVariant answer(CVariant::VariantTypeObject);
+  answer["result"] = "notasked";
+  answer["declared"] = false;
+  answer["mode"] = "";
+  answer["driver"] = m_DRM ? m_DRM->DriverName() : std::string();
+  answer["window"] = Name(Answer::NONE);
+  answer["windowwhy"] = "";
+  answer["own"] = Name(Answer::NONE);
+  answer["ownwhy"] = "";
+  answer["draw"] = "";
+  answer["drawwhy"] = "";
+  const auto finish = [&answer]()
+  {
+    std::string text;
+    CJSONVariantWriter::Write(answer, text, true);
+    CLog::Log(LOGINFO, "3D output: the check of frame packing (Check this setup): {}", text);
+    return text;
+  };
+
+  answer["declared"] = StereoEdid().present;
+  const auto player = CServiceBroker::GetAppComponents().GetComponent<CApplicationPlayer>();
+  if (player && player->IsPlaying())
+  {
+    answer["result"] = "busy";
+    return finish();
+  }
+  if (!m_DRM || !m_GBM || !m_DRM->GetCrtc())
+    return finish();
+
+  const std::vector<drmModeModeInfo> infos = m_DRM->FramePackedModes();
+  std::vector<STEREO::Mode> modes;
+  for (const auto& info : infos)
+  {
+    STEREO::Mode mode;
+    mode.clock = info.clock;
+    mode.hdisplay = info.hdisplay;
+    mode.hsyncStart = info.hsync_start;
+    mode.hsyncEnd = info.hsync_end;
+    mode.htotal = info.htotal;
+    mode.hskew = info.hskew;
+    mode.vdisplay = info.vdisplay;
+    mode.vsyncStart = info.vsync_start;
+    mode.vsyncEnd = info.vsync_end;
+    mode.vtotal = info.vtotal;
+    mode.vscan = info.vscan;
+    mode.flags = info.flags;
+    modes.push_back(mode);
+  }
+  const int chosen = ChooseMode(modes);
+  if (chosen < 0)
+  {
+    answer["result"] = "nomode";
+    return finish();
+  }
+  const drmModeModeInfo& info = infos[chosen];
+  const STEREO::Mode& mode = modes[chosen];
+  answer["mode"] = ModeName(mode);
+  const bool nvidia = m_DRM->DriverName() == "nvidia-drm";
+  const int height = STEREO::ScanoutHeight(mode);
+
+  // The kind of the window's buffer (8 bits, the plane's modifiers; on nvidia-drm linear and wide)
+  uint32_t format = static_cast<uint32_t>(m_eglContext.GetConfigAttrib(EGL_NATIVE_VISUAL_ID));
+  if (FormatBits(format) > 8)
+    format = DRM_FORMAT_ARGB8888;
+  std::vector<uint64_t> modifiers;
+  for (const auto& fmt : m_DRM->GetOutputFormats())
+    if (fmt.drm == format && fmt.active)
+      modifiers = fmt.modifiers;
+  int width = mode.hdisplay;
+  if (nvidia)
+  {
+    width = STEREO::FramePackedBufferWidth(mode, 4, STEREO::NVKMS_SURFACE_OFFSET_ALIGNMENT);
+    modifiers = {DRM_FORMAT_MOD_LINEAR};
+  }
+  Answer window = Answer::NOT_MADE;
+  {
+    struct gbm_bo* bo = nullptr;
+#if defined(HAS_GBM_MODIFIERS)
+    if (!modifiers.empty())
+      bo = gbm_bo_create_with_modifiers2(
+          m_GBM->GetDevice().Get(), width, height, format, modifiers.data(),
+          static_cast<unsigned int>(modifiers.size()), GBM_BO_USE_SCANOUT | GBM_BO_USE_RENDERING);
+#endif
+    if (!bo && !nvidia)
+      bo = gbm_bo_create(m_GBM->GetDevice().Get(), width, height, format,
+                         GBM_BO_USE_SCANOUT | GBM_BO_USE_RENDERING);
+    if (!bo)
+      answer["windowwhy"] = StringUtils::Format("GBM could not make a buffer of {}x{} ({})", width,
+                                                height, strerror(errno));
+    else
+    {
+      std::string why;
+      const std::optional<bool> taken = m_DRM->TestFramePackedMode(info, bo, why);
+      window = !taken ? Answer::NOT_ASKED : *taken ? Answer::TAKEN : Answer::REFUSED;
+      answer["windowwhy"] = why;
+      // (its framebuffer goes with it: CDRMUtils::DrmFbGetFromBo())
+      gbm_bo_destroy(bo);
+    }
+  }
+  answer["window"] = Name(window);
+
+  // Kodi's own dumb buffers, on nvidia-drm (as FramePackedOwnStart() makes them for a video)
+  Answer own = Answer::NONE;
+#if defined(HAS_GLES)
+  if (nvidia && m_renderableType != EGL_OPENGL_BIT)
+  {
+    std::string failed;
+    auto buffers =
+        COwnScanout::Create(m_GBM->GetDevice().Get(), m_eglContext.GetEGLDisplay(), width, height,
+                            format, {DRM_FORMAT_MOD_LINEAR}, true, true, failed,
+                            COwnScanout::Memory::DUMB, m_DRM->GetFileDescriptor());
+    if (!buffers)
+    {
+      own = Answer::NOT_MADE;
+      answer["ownwhy"] = failed;
+    }
+    else
+    {
+      own = Answer::TAKEN;
+      for (unsigned int i = 0; i < COwnScanout::BUFFERS && own == Answer::TAKEN; ++i)
+      {
+        std::string why;
+        const std::optional<bool> taken =
+            m_DRM->TestFramePackedMode(info, buffers->BufferAt(i), why);
+        own = !taken ? Answer::NOT_ASKED : *taken ? Answer::TAKEN : Answer::REFUSED;
+        answer["ownwhy"] = why;
+      }
+      answer["draw"] = buffers->CopiesOnCpu() ? "copy" : "gpu";
+      answer["drawwhy"] = buffers->CopyReason();
+      // (black and never shown: they go here, as nothing holds them)
+    }
+  }
+#endif
+  answer["own"] = Name(own);
+  answer["result"] = Overall(window, own);
+  return finish();
+}
