+std::vector<drmModeModeInfo> CDRMUtils::FramePackedModes() const
+{
+  std::vector<drmModeModeInfo> modes;
+  if (!m_connector)
+    return modes;
+  for (int i = 0; i < m_connector->GetModesCount(); ++i)
+  {
+    const drmModeModeInfo* mode = m_connector->GetModeForIndex(i);
+    if (STEREO::LayoutOf(mode->flags) == STEREO::Layout::FRAME_PACKING)
+      modes.push_back(*mode);
+  }
+  return modes;
+}
