+ *  screen); the answer, a line of JSON, in the property hades.check.fp.result of the Home window
+ *  (KODI::WINDOWING::GBM::FP_CHECK). Runs on the thread that draws, as every builtin.
+ */
+static int HadesFramePackingCheck(const std::vector<std::string>&)
+{
+  std::string answer = R"({"result":"notasked","why":"not the window system of GBM"})";
+  std::string property = "hades.check.fp.result";
+#ifdef HAVE_DVBRIDGE
+  property = KODI::WINDOWING::GBM::FP_CHECK::PROPERTY;
