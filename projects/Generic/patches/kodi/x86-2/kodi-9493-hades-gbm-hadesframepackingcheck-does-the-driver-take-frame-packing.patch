diff --git a/xbmc/windowing/gbm/drm/DRMAtomic.cpp b/xbmc/windowing/gbm/drm/DRMAtomic.cpp
index 6dfd0df..a47daf3 100644
--- a/xbmc/windowing/gbm/drm/DRMAtomic.cpp
+++ b/xbmc/windowing/gbm/drm/DRMAtomic.cpp
@@ -1312,8 +1312,31 @@ std::optional<bool> CDRMAtomic::TestFramePacked(struct gbm_bo* bo, std::string&
 {
   // Hades: (issue #33, FramePackedOwn.h) only a frame-packed mode of nvidia-drm is asked, and only
   // while the output is meant to be on: a mode that is not lit shows no buffer
+  if (!FramePackedByOffsets() || !m_mode)
+    return std::nullopt;
+  return AskFramePacked(*m_mode, static_cast<uint32_t>(m_width), static_cast<uint32_t>(m_height),
+                        bo, why);
+}
+
+std::optional<bool> CDRMAtomic::TestFramePackedMode(const drmModeModeInfo& mode,
+                                                    struct gbm_bo* bo,
+                                                    std::string& why)
+{
+  // Hades: (the card "3D: frame packing": the plane covers the whole frame of that mode)
+  if (STEREO::LayoutOf(mode.flags) != STEREO::Layout::FRAME_PACKING)
+    return std::nullopt;
+  return AskFramePacked(mode, mode.hdisplay, static_cast<uint32_t>(mode.vdisplay + mode.vtotal), bo,
+                        why);
+}
+
+std::optional<bool> CDRMAtomic::AskFramePacked(const drmModeModeInfo& asked,
+                                               uint32_t srcWidth,
+                                               uint32_t srcHeight,
+                                               struct gbm_bo* bo,
+                                               std::string& why)
+{
   CDRMPlane* plane = m_gui_plane ? m_gui_plane : m_video_plane;
-  if (!FramePackedByOffsets() || !bo || !plane || !m_crtc || !m_connector || !m_mode || !m_active)
+  if (!bo || !plane || !m_crtc || !m_connector || !m_active)
     return std::nullopt;
   struct drm_fb* fb = DrmFbGetFromBo(bo);
   if (!fb)
@@ -1321,7 +1344,7 @@ std::optional<bool> CDRMAtomic::TestFramePacked(struct gbm_bo* bo, std::string&
     why = std::string("no framebuffer of the kernel could be made of it: ") + strerror(errno);
     return false;
   }
-  CDRMPropertyBlob mode(m_fd, m_mode, sizeof(*m_mode));
+  CDRMPropertyBlob mode(m_fd, &asked, sizeof(asked));
   if (!mode.IsValid())
     return std::nullopt;
 
@@ -1346,12 +1369,13 @@ std::optional<bool> CDRMAtomic::TestFramePacked(struct gbm_bo* bo, std::string&
   add(plane, "CRTC_ID", m_crtc->GetCrtcId());
   add(plane, "SRC_X", 0);
   add(plane, "SRC_Y", 0);
-  add(plane, "SRC_W", static_cast<uint64_t>(m_width) << 16);
-  add(plane, "SRC_H", static_cast<uint64_t>(m_height) << 16);
+  add(plane, "SRC_W", static_cast<uint64_t>(srcWidth) << 16);
+  add(plane, "SRC_H", static_cast<uint64_t>(srcHeight) << 16);
   add(plane, "CRTC_X", 0);
   add(plane, "CRTC_Y", 0);
-  add(plane, "CRTC_W", m_mode->hdisplay);
-  add(plane, "CRTC_H", ScanoutHeight());
+  add(plane, "CRTC_W", asked.hdisplay);
+  // (both eyes and the lines between them: STEREO::ScanoutHeight() of a frame-packed mode)
+  add(plane, "CRTC_H", static_cast<uint64_t>(asked.vdisplay) + asked.vtotal);
   if (m_reflectSaid && plane->SupportsProperty("rotation"))
     add(plane, "rotation", PlaneRotation());
   if (plane->SupportsProperty("IN_FENCE_FD"))
