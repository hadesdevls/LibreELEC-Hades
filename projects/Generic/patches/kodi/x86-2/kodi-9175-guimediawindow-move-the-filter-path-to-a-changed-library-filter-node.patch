From c5f91feec48545e6edad8150951b76eff45ae218 Mon Sep 17 00:00:00 2001
From: olympia <olympia@xbmc.org>
Date: Fri, 20 Nov 2026 19:27:50 +0100
Subject: [PATCH] [GUIMediaWindow] Move the filter path to a changed library
 filter node

When the XML rules of a library filter node change while the window
lists it with an advanced filter, a refresh loads the new db path
through the node. Refresh() keeps the filter path though, so the
advanced filter still ran on the old node query and could leave items
of the new listing out.

When the node gives back a different db path, take it as the base of
the filter path and carry over only its filter option.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
(cherry picked from commit 11146d0e564344497ca609c49363db203cce2290)
---
 xbmc/windows/GUIMediaWindow.cpp | 8 ++++++++
 1 file changed, 8 insertions(+)

diff --git a/xbmc/windows/GUIMediaWindow.cpp b/xbmc/windows/GUIMediaWindow.cpp
index 455dc39..83ae532 100644
--- a/xbmc/windows/GUIMediaWindow.cpp
+++ b/xbmc/windows/GUIMediaWindow.cpp
@@ -770,6 +770,14 @@ bool CGUIMediaWindow::GetDirectory(const std::string &strDirectory, CFileItemLis
       viaNode = GetDirectoryItems(nodeUrl, nodeItems, UseFileDirectories());
       if (viaNode)
       {
+        if (nodeItems.GetPath() != m_libraryFilterDbPath)
+        {
+          // Refresh() keeps the filter path, so move it to the new node query
+          CURL filterPathUrl{nodeItems.GetPath()};
+          if (const CURL oldFilterPathUrl{m_strFilterPath}; oldFilterPathUrl.HasOption("filter"))
+            filterPathUrl.SetOption("filter", oldFilterPathUrl.GetOption("filter"));
+          m_strFilterPath = filterPathUrl.Get();
+        }
         m_libraryFilterDbPath = nodeItems.GetPath();
       }
       else if (XFILE::CDirectory::Exists(m_libraryFilterNodePath, false))
