index 7bec0b4..a365da6 100644
--- a/xbmc/cores/VideoPlayer/DVDCodecs/Video/DVDVideoCodecFFmpeg.cpp
+++ b/xbmc/cores/VideoPlayer/DVDCodecs/Video/DVDVideoCodecFFmpeg.cpp
@@ -31,6 +31,9 @@
 #include "utils/XTimeUtils.h"
 #include "utils/HDR10PlusVsif.h"
 #include "utils/log.h"
+#if defined(HAVE_GBM)
+#include "windowing/gbm/WinSystemGbm.h"
+#endif
 
 #include <chrono>
 #include <fstream>
@@ -136,6 +139,39 @@ bool HevcHardwareAllowed()
   }
   return true;
 }
+
+// Hades: a VAAPI device of the graphics card that drives the display, for the decoder of the base
+// view of MV-HEVC (KODI::MULTIVIEW::HybridBase): FFmpeg opens a VA display of its own on that
+// card's render node (the node the DRM PRIME decoder takes); nothing of Kodi's VAAPI decoder or
+// renderer is shared. Null where there is none; node says which it is.
+AVBufferRef* DisplayVaapiDevice(std::string& node)
+{
+#if defined(HAVE_GBM)
+  auto* winSystem =
+      dynamic_cast<KODI::WINDOWING::GBM::CWinSystemGbm*>(CServiceBroker::GetWinSystem());
+  const auto drm = winSystem ? winSystem->GetDrm() : nullptr;
+  const char* path = drm ? drm->GetRenderDevicePath() : nullptr;
+  if (!path)
+    return nullptr;
+  node = path;
+  AVBufferRef* device = nullptr;
+  if (av_hwdevice_ctx_create(&device, AV_HWDEVICE_TYPE_VAAPI, path, nullptr, 0) < 0)
+    return nullptr;
+  return device;
+#else
+  (void)node;
+  return nullptr;
+#endif
+}
+
+// Hades: when the graphics card's decoder gives the base view of MV-HEVC
+// (videoplayer.hades3dmvcbase, KODI::MULTIVIEW::HYBRID_*)
+int HybridSetting()
+{
+  const auto settings = CServiceBroker::GetSettingsComponent()->GetSettings();
+  constexpr const char* name = "videoplayer.hades3dmvcbase";
+  return settings->GetSetting(name) ? settings->GetInt(name) : KODI::MULTIVIEW::HYBRID_DEFAULT;
+}
 } // namespace
 
 enum DecoderState
@@ -726,6 +762,42 @@ bool CDVDVideoCodecFFmpeg::Open(CDVDStreamInfo &hints, CDVDCodecOptions &options
                 "processor decodes them",
                 KODI::MULTIVIEW::NvdecWhyNot(nvdec));
 
+    // Hades: where NVDEC is not, the base view by the graphics card's own decoder (VAAPI) and the
+    // second view by the processor (KODI::MULTIVIEW::HybridBase): FFmpeg's decoder of both views
+    // with a second decoder of its own on that card's device (the option, below), whose pictures
+    // it uses once they are found the same as its own
+    m_multiviewHybrid = false;
+    m_multiviewHybridLost = false;
+    m_hybridState = {};
+    // (as the setting says: by default only where the processor alone did not keep up with this
+    // stream, LeaveMultiview(); the processor decodes both views of any other, as before)
+    const bool processorSlow = m_multiviewHybridTried || StillWantsHybrid(hints);
+    KODI::MULTIVIEW::HybridBase hybrid = KODI::MULTIVIEW::HybridBaseForTwoViews(
+        hints.codec == AV_CODEC_ID_HEVC, (hints.codecOptions & CODEC_FORCE_SOFTWARE) != 0,
+        HevcHardwareAllowed(), m_multiviewHybridFailed, m_multiviewNvdec, HybridSetting(),
+        processorSlow, true);
+    std::string node;
+    if (hybrid == KODI::MULTIVIEW::HybridBase::ASKED)
+    {
+      AVBufferRef* device = DisplayVaapiDevice(node);
+      if (device)
+      {
+        m_pCodecContext->hw_device_ctx = device;
+        m_multiviewHybrid = true;
+      }
+      else
+        hybrid = KODI::MULTIVIEW::HybridBase::NO_DEVICE;
+    }
+    if (hints.codec == AV_CODEC_ID_HEVC)
+      CLog::Log(
+          LOGINFO,
+          "CDVDVideoCodecFFmpeg::Open() the graphics card's decoder for the base view: {}{}{}",
+          m_multiviewHybrid ? "VAAPI on " : KODI::MULTIVIEW::HybridBaseWhyNot(hybrid),
+          m_multiviewHybrid ? node : std::string(),
+          !m_multiviewHybrid ? ""
+          : processorSlow    ? " (the processor alone did not decode both views in time)"
+                             : " (the setting says always)");
+
     // otherwise no hardware decoder gives the second view: both are decoded by the processor,
     // with threads
     // (Hades: 24 at most, KODI::MULTIVIEW::MULTIVIEW_THREADS)
@@ -821,6 +893,16 @@ bool CDVDVideoCodecFFmpeg::Open(CDVDStreamInfo &hints, CDVDCodecOptions &options
                    KODI::MULTIVIEW::DECODER_ALL_VIEWS, AV_OPT_SEARCH_CHILDREN) < 0)
       return OpenWithoutMultiview(hints, options, stateBefore,
                                   "it does not take the option that asks for all views");
+    if (m_multiviewHybrid &&
+        av_opt_set(m_pCodecContext, KODI::MULTIVIEW::BASE_LAYER_OPTION,
+                   KODI::MULTIVIEW::BASE_LAYER_SEPARATE, AV_OPT_SEARCH_CHILDREN) < 0)
+    {
+      // (an FFmpeg without ffmpeg-9976: the processor decodes both views, as before)
+      CLog::Log(LOGINFO, "CDVDVideoCodecFFmpeg::Open() this FFmpeg has no decoder of the base "
+                         "view of its own: the processor decodes both views");
+      av_buffer_unref(&m_pCodecContext->hw_device_ctx);
+      m_multiviewHybrid = false;
+    }
   }
 
   if (avcodec_open2(m_pCodecContext, pCodec, nullptr) < 0)
@@ -836,8 +918,10 @@ bool CDVDVideoCodecFFmpeg::Open(CDVDStreamInfo &hints, CDVDCodecOptions &options
               "CDVDVideoCodecFFmpeg::Open() both views of this stream are decoded ({}, by {}) "
               "and go on as one picture, side by side; the base view is the {} eye",
               MultiviewDecoderName(),
-              m_multiviewNvdec ? "NVIDIA's decoder, NVDEC, the views copied from the card"
