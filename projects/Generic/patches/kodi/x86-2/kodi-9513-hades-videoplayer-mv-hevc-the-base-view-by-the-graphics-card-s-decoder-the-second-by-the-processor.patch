+/*!
+ * \param setting the value of videoplayer.hades3dmvcbase (HYBRID_*); another is taken as the
+ *        default
+ * \param processorSlow the processor alone did not decode both views of this stream in time
+ */
+constexpr HybridBase HybridBaseForTwoViews(bool hevc,
+                                           bool softwareAsked,
+                                           bool hardwareAllowed,
+                                           bool failedBefore,
+                                           bool nvdecAsked,
+                                           int setting,
+                                           bool processorSlow,
+                                           bool device)
+{
+  const int wanted =
+      setting == HYBRID_NEVER || setting == HYBRID_WHERE_SLOW || setting == HYBRID_ALWAYS
+          ? setting
+          : HYBRID_DEFAULT;
+  // (in this order: the first that holds is the reason)
+  return !hevc                                           ? HybridBase::NOT_HEVC
+         : softwareAsked                                 ? HybridBase::SOFTWARE
+         : !hardwareAllowed                              ? HybridBase::NOT_ALLOWED
+         : failedBefore                                  ? HybridBase::FAILED_BEFORE
+         : nvdecAsked                                    ? HybridBase::NVDEC
+         : wanted == HYBRID_NEVER                        ? HybridBase::TURNED_OFF
+         : wanted == HYBRID_WHERE_SLOW && !processorSlow ? HybridBase::PROCESSOR_KEEPS_UP
+         : !device                                       ? HybridBase::NO_DEVICE
+                                                         : HybridBase::ASKED;
+}
+
+//! ... in words for the log
+constexpr const char* HybridBaseWhyNot(HybridBase hybrid)
+{
+  switch (hybrid)
+  {
+    case HybridBase::ASKED:
+      return "asked";
+    case HybridBase::NOT_HEVC:
+      return "not HEVC";
+    case HybridBase::SOFTWARE:
+      return "the player asked for decoding by the processor";
+    case HybridBase::NOT_ALLOWED:
+      return "hardware decoding of HEVC (VAAPI) is off";
+    case HybridBase::FAILED_BEFORE:
+      return "it was given up for this stream before";
+    case HybridBase::NVDEC:
+      return "NVIDIA's decoder takes both views";
+    case HybridBase::TURNED_OFF:
+      return "the setting says never";
+    case HybridBase::PROCESSOR_KEEPS_UP:
+      return "asked only where the processor alone does not keep up (the setting), and it has";
+    case HybridBase::NO_DEVICE:
+      return "the display's graphics card has no VAAPI device";
+  }
+  return "";
+}
