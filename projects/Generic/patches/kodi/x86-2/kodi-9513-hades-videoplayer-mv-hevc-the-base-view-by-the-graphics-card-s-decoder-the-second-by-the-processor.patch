+/*!
+ * \name The graphics card's decoder for the base view, the processor for the second (MV-HEVC)
+ *
+ * Where no decoder of the graphics card takes both views of MV-HEVC (only NVDEC does, above),
+ * most take its base view: a plain HEVC stream of Main or Main 10, which the decoders of AMD
+ * (VCN, Mesa's radeonsi) and of Intel (media-driver) decode through VAAPI as any other; the
+ * second view, the layer above, they do not know. Hades' FFmpeg (ffmpeg-9976, the HEVC decoder's
+ * option base_layer_decoder) then decodes the base layer with a second decoder of its own on the
+ * device that Kodi gives it, copies each of its pictures to memory, and decodes the second view
+ * on the processor from them: the processor does about half the work it does for both views
+ * (measured: the base view is 47 to 62 % of it). The pictures are those of the processor's own
+ * decoding of both views: FFmpeg parses all of the base layer itself (its parameter sets, slice
+ * headers, references, order and output), takes only the samples of its pictures from the
+ * graphics card, and checks that those are its own, bit for bit, on the first 8 pictures (it
+ * decodes them too) and on 4 more about every 480 from a key frame. At the first difference, a
+ * picture the card does not give, an error of it, or a picture whose second view predicts its
+ * motion from an inter-coded base picture (the card gives no motion), FFmpeg decodes the base
+ * layer itself again, says why in the pictures (lavc.hevc.base_layer_error) and marks corrupt
+ * any picture it could then not decode as it would have been; Kodi then opens the stream again
+ * with the processor decoding both views, as before (HybridSaw()).
+ *
+ * When: never where NVDEC takes both views; else as the setting says (HYBRID_DEFAULT): only for a
+ * stream whose two views the processor alone did not decode in time, in place of its base view
+ * alone in 2D (HybridInsteadOf2D(); where the card does not keep up either, 2D then), or for every
+ * stream from its start. The processor alone decodes both views of any other stream as before.
+ * @{
+ */
+
+//! The option of FFmpeg's HEVC decoder that has the base layer decoded by a second decoder, on
+//! the device of AVCodecContext::hw_device_ctx
+inline constexpr const char* BASE_LAYER_OPTION = "base_layer_decoder";
+inline constexpr const char* BASE_LAYER_SEPARATE = "separate";
+//! What each picture says of its base view: "separate" (the card's), "checking" (decoded by the
+//! processor and compared with the card's) or "internal" (the processor's)
+inline constexpr const char* BASE_LAYER_KEY = "lavc.hevc.base_layer";
+//! ... the pictures of the card found the same as the processor's so far
+inline constexpr const char* BASE_LAYER_CHECKS_KEY = "lavc.hevc.base_layer_checks";
+//! ... and, once the card's decoder was given up, why
+inline constexpr const char* BASE_LAYER_ERROR_KEY = "lavc.hevc.base_layer_error";
+
+//! The setting of the graphics card's decoder for the base view (videoplayer.hades3dmvcbase): never,
+inline constexpr int HYBRID_NEVER = 0;
+//! ... only for a stream whose two views the processor alone did not decode in time, in place of
+//! playing its base view alone in 2D (the processor decodes both views otherwise, as in 1.2.2)
+inline constexpr int HYBRID_WHERE_SLOW = 1;
+//! ... for every stream, from its start (the processor's work halved, once the card's pictures
+//! are found the same as its own)
+inline constexpr int HYBRID_ALWAYS = 2;
+//! The default of that setting (system/settings/settings.xml has the same value): where the
+//! processor does not keep up, until a test on hardware has shown that the card's pictures are the
+//! processor's, that nothing is dropped and that the processor works less with it (then: always)
+inline constexpr int HYBRID_DEFAULT = HYBRID_WHERE_SLOW;
+
+//! Whether the graphics card's decoder is asked for the base view, and why not where it is not
+enum class HybridBase
+{
+  ASKED,
+  NOT_HEVC, //!< H.264 MVC
+  SOFTWARE, //!< the player asked for decoding by the processor
+  NOT_ALLOWED, //!< hardware decoding of HEVC is off (the settings of VAAPI)
+  FAILED_BEFORE, //!< it was given up for this stream: the processor decodes both views
+  NVDEC, //!< NVIDIA's decoder takes both views
+  TURNED_OFF, //!< the setting says never
+  PROCESSOR_KEEPS_UP, //!< the setting says where the processor does not keep up, and it has
+  NO_DEVICE, //!< no VAAPI device of the display could be had
+};
