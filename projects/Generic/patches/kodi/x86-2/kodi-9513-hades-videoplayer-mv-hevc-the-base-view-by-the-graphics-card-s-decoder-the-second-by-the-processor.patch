+/*!
+ * \brief The processor did not decode both views of a stream in time: whether the stream is
+ *        opened again with the graphics card's decoder for the base view (true) rather than
+ *        going back to its base view alone, in 2D (false)
+ * \param hybridNow the card's decoder gave the base view already (then it did not help either)
+ * \param hybridTried it was asked for this stream before (it could not be had, or was given up)
+ * \param wouldBe HybridBaseForTwoViews() with processorSlow and a device
+ */
+constexpr bool HybridInsteadOf2D(bool hybridNow, bool hybridTried, HybridBase wouldBe)
+{
+  return !hybridNow && !hybridTried && wouldBe == HybridBase::ASKED;
+}
+
+//! What Kodi does with what a picture says of its base view (HybridSaw())
+enum class HybridStep
+{
+  NONE,
+  FIRST_SEPARATE, //!< the first picture whose base view the card gave: it is said in the log
+  GIVEN_UP, //!< given up before the card gave one: the processor goes on with both, said once
+  REOPEN, //!< given up after: the stream is opened again with the processor decoding both views
+};
+
+//! The pictures of a stream seen so far (HybridSaw())
+struct HybridState
+{
+  bool separate{false};
+  bool givenUp{false};
+};
+
+/*!
+ * \brief A picture of the decoder of both views came out: what it says of its base view
+ * \param mode its BASE_LAYER_KEY, empty where it has none
+ * \param error its BASE_LAYER_ERROR_KEY, empty where it has none
+ *
+ * A card's decoder given up before any of its pictures was used leaves pictures that are all the
+ * processor's: nothing to do but say it. Given up after, FFmpeg decodes as it would have from the
+ * next key frame, but a picture before that may not be (it is then marked corrupt, or not
+ * decoded): the stream is opened again at once, the processor decoding both views, and the player
+ * sends the packets since the last key frame again (as where NVDEC is given up). (FFmpeg marks a
+ * picture corrupt for this only after it gave the card up, so the error says it first.)
+ */
+inline HybridStep HybridSaw(HybridState& state, std::string_view mode, std::string_view error)
+{
+  if (state.givenUp)
+    return HybridStep::NONE;
+  if (!error.empty())
+  {
+    state.givenUp = true;
+    return state.separate ? HybridStep::REOPEN : HybridStep::GIVEN_UP;
+  }
+  if (mode == "separate" && !state.separate)
+  {
+    state.separate = true;
+    return HybridStep::FIRST_SEPARATE;
+  }
+  return HybridStep::NONE;
+}
