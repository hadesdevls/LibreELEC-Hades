+#include "StereoDepthMeter.h"
+
+#include "utils/log.h"
+
+#include <algorithm>
+#include <chrono>
+#include <cmath>
+#include <cstdio>
+
+namespace KODI
+{
+namespace STEREODEPTH
+{
+
+namespace
+{
+double Now()
+{
+  return std::chrono::duration<double>(std::chrono::steady_clock::now().time_since_epoch()).count();
+}
+
+//! a picture is measured at most this often (seconds): a few times a second is enough to follow
+//! a film, and the matching costs the processor nothing more
+constexpr double COPY_EVERY = 0.075;
+
+//! around the place of the subtitles, the area measured reaches so far (shares of the picture)
+constexpr float AREA_ACROSS = 0.08f;
+constexpr float AREA_DOWN = 0.04f;
+
+bool Split(RenderStereoMode mode)
+{
+  return mode == RenderStereoMode::SPLIT_HORIZONTAL || mode == RenderStereoMode::SPLIT_VERTICAL;
+}
+
+bool Anaglyph(RenderStereoMode mode)
+{
+  return mode == RenderStereoMode::ANAGLYPH_RED_CYAN ||
+         mode == RenderStereoMode::ANAGLYPH_GREEN_MAGENTA ||
+         mode == RenderStereoMode::ANAGLYPH_YELLOW_BLUE;
+}
+
+std::string Percent(float share)
+{
+  char text[32];
+  std::snprintf(text, sizeof(text), "%.2f %%", static_cast<double>(share) * 100.0);
+  return text;
+}
+} // namespace
+
+CStereoDepthMeter::CStereoDepthMeter() = default;
+
+CStereoDepthMeter::~CStereoDepthMeter()
+{
+  {
+    std::unique_lock lock(m_lock);
+    m_stop = true;
+  }
+  m_wake.notify_all();
+  if (m_thread.joinable())
+    m_thread.join();
+}
+
+bool CStereoDepthMeter::Measurable(const Facts& facts)
+{
+  if (!facts.automatic)
+    m_why = "the setting asks for a fixed depth";
+  else if (Anaglyph(facts.mode))
+    m_why = "an anaglyph output draws both eyes into one picture";
+  else if (!Split(facts.mode))
+    m_why = "this 3D output does not draw the eyes as two pictures";
+  else if (!facts.drawnInGuiPass)
+    m_why = "the video is drawn under the interface (HDR), once for both eyes";
+  else if (!facts.fullscreen)
+    m_why = "the video is not shown full screen";
+  else if (!m_broken.empty())
+    m_why = m_broken;
+  else
+  {
+    m_why.clear();
+    return true;
+  }
+  return false;
+}
+
+void CStereoDepthMeter::Tell(const Facts& facts)
+{
+  std::string text;
+  const std::string measured = "measured from the two pictures (in front of the nearest thing by " +
+                               Percent(m_planner.Params().margin) +
+                               " of the width, never nearer than " +
+                               Percent(m_planner.Params().comfort) + ")";
+  switch (m_source)
+  {
+    case DepthSource::NONE:
+      // told again at the next 3D video
+      m_told.clear();
+      return;
+    case DepthSource::DISC:
+      text = "subtitles by the plane offsets of the disc; the interface over the video " +
+             (m_why.empty() ? measured : "at the skin's depth (not measured: " + m_why + ")");
+      break;
+    case DepthSource::MEASURED:
+      text = "subtitles and the interface over the video " + measured;
+      if (facts.fixedPixels != 0)
+        text += ", the subtitles " + std::to_string(facts.fixedPixels) +
+                " pixels of each eye nearer as set";
+      break;
+    case DepthSource::FIXED:
+      text = "subtitles at the depth set (" + std::to_string(facts.fixedPixels) +
+             " pixels of each eye), the interface at the skin's depth; not measured: " + m_why;
+      break;
+  }
+  if (text != m_told)
+  {
+    m_told = text;
+    CLog::Log(LOGINFO, "3D depth: {}", text);
+  }
+}
+
+CStereoDepthMeter::Depths CStereoDepthMeter::Frame(const Facts& facts)
+{
+  if (m_flush.exchange(false))
+  {
+    m_capture.Drop();
+    m_planner.Reset();
+    m_pending.clear();
+    m_copying = false;
+    m_lastPicture = -1.0;
+    ++m_generation;
+  }
+
+  const bool threeD = facts.stereoVideo && facts.mode != RenderStereoMode::OFF &&
+                      facts.mode != RenderStereoMode::MONO;
+  const bool measurable = threeD && Measurable(facts);
+  if (!threeD)
+    m_source = DepthSource::NONE;
+  else if (facts.discDepth)
+    m_source = DepthSource::DISC;
+  else
+    m_source = measurable ? DepthSource::MEASURED : DepthSource::FIXED;
+  Tell(facts);
+
+  if (!measurable)
+  {
+    if (m_measure)
+    {
+      m_capture.Drop();
+      m_planner.Reset();
+      m_pending.clear();
+      m_copying = false;
+      ++m_generation;
+    }
+    m_measure = false;
+    return {};
+  }
+  m_measure = true;
+
+  // the copies the graphics have read back go to the thread that matches them
+  std::vector<uint8_t> rgba;
+  uint64_t tag = 0;
+  while (m_capture.Collect(rgba, tag))
+  {
+    while (!m_pending.empty() && m_pending.front().tag < tag)
+      m_pending.pop_front();
+    if (!m_pending.empty() && m_pending.front().tag == tag)
+    {
+      Submit({m_generation, m_pending.front().t, m_pending.front().area, std::move(rgba)});
+      m_pending.pop_front();
+    }
+    rgba = {};
+  }
+
+  std::deque<Result> results;
+  {
+    std::unique_lock lock(m_lock);
+    results.swap(m_results);
+  }
+  for (const Result& r : results)
+    if (r.generation == m_generation)
+      m_planner.AddMeasure(r.t, r.area, r.whole, r.cut);
+
+  if (facts.subtitleArea)
+    m_subtitleArea = facts.subtitleArea;
+
+  const double now = Now();
+  Depths depths;
+  std::optional<float> subtitles;
+  if (m_source == DepthSource::MEASURED && facts.destWidth > 0.0f)
+  {
+    const float measured = m_planner.Subtitles(now, facts.subtitleVisible, facts.subtitleEvent);
+    depths.subtitles = measured + 2.0f * static_cast<float>(facts.fixedPixels) / facts.destWidth;
+    if (facts.subtitleVisible)
+    {
+      subtitles = depths.subtitles;
+      if (facts.subtitleEvent != m_toldEvent)
+      {
+        m_toldEvent = facts.subtitleEvent;
+        CLog::Log(LOGDEBUG, "3D depth: subtitle {} at {} of the width{}", facts.subtitleEvent,
+                  Percent(*depths.subtitles),
+                  m_planner.HasMeasure() ? "" : " (nothing measured yet)");
+      }
+    }
+  }
+  else if (m_source == DepthSource::DISC && facts.subtitleVisible && facts.discOffset &&
+           facts.sourceWidth > 0.0f)
+    subtitles = 2.0f * static_cast<float>(*facts.discOffset) / facts.sourceWidth;
+
+  depths.guiPixels = m_planner.Gui(now, facts.guiShown, subtitles) * 0.5f * facts.destWidth;
+  return depths;
+}
+
+Area CStereoDepthMeter::SubtitleArea() const
+{
+  // before any subtitle was seen: the lower part of the picture, where they are put by default
+  Area area{0.1f, 0.6f, 0.9f, 1.0f};
+  const float width = m_copied.Width();
+  const float height = m_copied.Height();
+  if (!m_subtitleArea || width <= 0.0f || height <= 0.0f)
+    return area;
+  const CRect& s = *m_subtitleArea;
+  Area seen;
+  seen.x1 = std::clamp((s.x1 - m_copied.x1) / width - AREA_ACROSS, 0.0f, 1.0f);
+  seen.x2 = std::clamp((s.x2 - m_copied.x1) / width + AREA_ACROSS, 0.0f, 1.0f);
+  seen.y1 = std::clamp((s.y1 - m_copied.y1) / height - AREA_DOWN, 0.0f, 1.0f);
+  seen.y2 = std::clamp((s.y2 - m_copied.y1) / height + AREA_DOWN, 0.0f, 1.0f);
+  if (seen.x2 - seen.x1 < 0.05f || seen.y2 - seen.y1 < 0.05f)
+    return area;
+  return seen;
+}
+
+void CStereoDepthMeter::AfterVideo(
+    RenderStereoView view, const CRect& dest, int eyeWidth, int eyeHeight, double picture)
+{
+  if (!m_measure)
+    return;
+  if (view != RenderStereoView::RIGHT)
+    m_copying = view == RenderStereoView::LEFT ? false : m_copying;
+  if (view == RenderStereoView::OFF || (view == RenderStereoView::RIGHT && !m_copying))
+    return;
+
+  const double now = Now();
+  if (view == RenderStereoView::LEFT &&
+      (picture == m_lastPicture || now - m_lastCopy < COPY_EVERY || !m_capture.CanRead()))
+    return;
+
+  // the eye's screen is the viewport set for it (CGraphicContext::SetStereoView()): anything
+  // else, and this frame is not measured
+  int vx = 0;
+  int vy = 0;
+  int vw = 0;
+  int vh = 0;
+  if (!CStereoDepthCapture::Viewport(vx, vy, vw, vh) || vw != eyeWidth || vh != eyeHeight)
+  {
+    m_copying = false;
+    return;
+  }
+  CRect shown{dest};
+  shown.Intersect(CRect(0.0f, 0.0f, static_cast<float>(eyeWidth), static_cast<float>(eyeHeight)));
+  if (shown.Width() < 64.0f || shown.Height() < 36.0f)
+  {
+    m_copying = false;
+    return;
+  }
+  const int x1 = static_cast<int>(std::lround(shown.x1));
+  const int x2 = static_cast<int>(std::lround(shown.x2));
+  const int y1 = static_cast<int>(std::lround(shown.y1));
+  const int y2 = static_cast<int>(std::lround(shown.y2));
+
+  std::string why;
+  const int eye = view == RenderStereoView::LEFT ? 0 : 1;
+  if (!m_capture.CopyEye(eye, vx + x1, vy + (eyeHeight - y2), x2 - x1, y2 - y1, why))
+  {
+    m_copying = false;
+    m_broken = why;
+    return;
+  }
+
+  if (eye == 0)
+  {
+    m_copied = shown;
+    m_copying = true;
+    return;
+  }
+
+  m_copying = false;
+  if (!m_capture.CanRead())
+    return;
+  if (!m_capture.StartRead(++m_tag, why))
+  {
+    m_broken = why;
+    return;
+  }
+  m_pending.push_back({m_tag, now, SubtitleArea()});
+  m_lastPicture = picture;
+  m_lastCopy = now;
+}
+
+void CStereoDepthMeter::Submit(Job&& job)
+{
+  {
+    std::unique_lock lock(m_lock);
+    // the matching keeps up with a few pictures a second; were it ever late, the newest count
+    while (m_jobs.size() >= 2)
+      m_jobs.pop_front();
+    m_jobs.push_back(std::move(job));
+    if (!m_thread.joinable())
+      m_thread = std::thread([this] { Work(); });
+  }
+  m_wake.notify_one();
+}
+
+void CStereoDepthMeter::Work()
+{
+  constexpr int W = CStereoDepthCapture::WIDTH;
+  constexpr int H = CStereoDepthCapture::HEIGHT;
+  MatchParams whole;
+  whole.step = 16;
+  Signature before;
+  uint64_t generation = 0;
+
+  while (true)
+  {
+    Job job;
+    {
+      std::unique_lock lock(m_lock);
+      m_wake.wait(lock, [this] { return m_stop || !m_jobs.empty(); });
+      if (m_stop)
+        return;
+      job = std::move(m_jobs.front());
+      m_jobs.pop_front();
+    }
+    std::vector<uint8_t> luma;
+    if (!CStereoDepthCapture::Luma(job.rgba, luma))
+      continue;
+    if (job.generation != generation)
+    {
+      before = {};
+      generation = job.generation;
+    }
+
+    const Plane left{luma.data(), W, H, W};
+    const Plane right{luma.data() + static_cast<size_t>(W) * H, W, H, W};
+    Result result;
+    result.generation = job.generation;
+    result.t = job.t;
+    result.area = MeasureNearest(left, right, job.area).nearest;
+    result.whole = MeasureNearest(left, right, Area{0.02f, 0.02f, 0.98f, 0.98f}, whole).nearest;
+    // the whole picture is sampled more sparsely than the subtitles' area, which is a part of it: it
+    // is never taken as farther than that part (measured so on MV-HEVC conformance stream C)
+    if (result.area && (!result.whole || *result.whole < *result.area))
+      result.whole = result.area;
+    const Signature now = SignatureOf(left);
+    result.cut = IsCut(before, now);
+    before = now;
+
+    std::unique_lock lock(m_lock);
+    m_results.push_back(result);
+    while (m_results.size() > 16)
+      m_results.pop_front();
+  }
+}
+
+void CStereoDepthMeter::Release()
+{
+  m_capture.Release();
+  m_planner.Reset();
+  m_pending.clear();
+  m_copying = false;
+  m_measure = false;
+  m_lastPicture = -1.0;
+  m_subtitleArea.reset();
+  m_broken.clear();
+  ++m_generation;
+}
+
+} // namespace STEREODEPTH
+} // namespace KODI
