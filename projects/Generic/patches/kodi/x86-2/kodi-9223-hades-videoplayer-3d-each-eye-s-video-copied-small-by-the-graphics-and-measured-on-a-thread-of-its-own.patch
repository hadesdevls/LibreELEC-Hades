+#include "StereoDepthCapture.h"
+
+#include <algorithm>
+#include <cstring>
+
+#include "system_gl.h"
+
+namespace KODI
+{
+namespace STEREODEPTH
+{
+
+#if defined(HAS_GL) || HAS_GLES == 3
+
+namespace
+{
+//! the GL state a copy or a read changes, put back as it was
+class CKeepState
+{
+public:
+  CKeepState()
+  {
+    glGetIntegerv(GL_READ_FRAMEBUFFER_BINDING, &m_read);
+    glGetIntegerv(GL_DRAW_FRAMEBUFFER_BINDING, &m_draw);
+    glGetIntegerv(GL_PIXEL_PACK_BUFFER_BINDING, &m_pack);
+    glGetIntegerv(GL_PACK_ALIGNMENT, &m_alignment);
+    glGetIntegerv(GL_TEXTURE_BINDING_2D, &m_texture);
+    m_scissor = glIsEnabled(GL_SCISSOR_TEST);
+  }
+  ~CKeepState()
+  {
+    glBindFramebuffer(GL_READ_FRAMEBUFFER, static_cast<GLuint>(m_read));
+    glBindFramebuffer(GL_DRAW_FRAMEBUFFER, static_cast<GLuint>(m_draw));
+    glBindBuffer(GL_PIXEL_PACK_BUFFER, static_cast<GLuint>(m_pack));
+    glPixelStorei(GL_PACK_ALIGNMENT, m_alignment);
+    glBindTexture(GL_TEXTURE_2D, static_cast<GLuint>(m_texture));
+    if (m_scissor)
+      glEnable(GL_SCISSOR_TEST);
+    else
+      glDisable(GL_SCISSOR_TEST);
+  }
+  GLint Draw() const { return m_draw; }
+
+private:
+  GLint m_read{0};
+  GLint m_draw{0};
+  GLint m_pack{0};
+  GLint m_alignment{4};
+  GLint m_texture{0};
+  GLboolean m_scissor{GL_FALSE};
+};
+
+void ClearErrors()
+{
+  while (glGetError() != GL_NO_ERROR)
+    ;
+}
+
+//! The levels a rectangle of \p width x \p height is halved through: the first copy is never
+//! more than 2:1 on either side
+int LevelsFor(int width, int height)
+{
+  int levels = 1;
+  while (levels < 4 && (CStereoDepthCapture::WIDTH << levels < width ||
+                        CStereoDepthCapture::HEIGHT << levels < height))
+    ++levels;
+  return levels;
+}
+} // namespace
+
+CStereoDepthCapture::~CStereoDepthCapture()
+{
+  Release();
+}
+
+bool CStereoDepthCapture::Supported(std::string& why)
+{
+  // the context's version is a fact of the running system: a winsystem may ask for an ES 2
+  // context where ES 3 headers were there to build with
+  GLint major = 0;
+  glGetIntegerv(GL_MAJOR_VERSION, &major);
+  if (glGetError() != GL_NO_ERROR || major < 3)
+  {
+    ClearErrors();
+    why = "the graphics context is older than OpenGL (ES) 3";
+    return false;
+  }
+  return true;
+}
+
+bool CStereoDepthCapture::Viewport(int& x, int& y, int& width, int& height)
+{
+  GLint viewport[4]{};
+  glGetIntegerv(GL_VIEWPORT, viewport);
+  x = viewport[0];
+  y = viewport[1];
+  width = viewport[2];
+  height = viewport[3];
+  return width > 0 && height > 0;
+}
+
+bool CStereoDepthCapture::EnsureLevels(int levels)
+{
+  if (static_cast<int>(m_levels.size()) == levels)
+    return true;
+  ReleaseLevels();
+
+  GLint texture = 0;
+  glGetIntegerv(GL_TEXTURE_BINDING_2D, &texture);
+  GLint draw = 0;
+  glGetIntegerv(GL_DRAW_FRAMEBUFFER_BINDING, &draw);
+
+  bool ok = true;
+  for (int i = 0; i < levels && ok; ++i)
+  {
+    Level level;
+    level.width = WIDTH << i;
+    level.height = 2 * (HEIGHT << i);
+    glGenTextures(1, &level.texture);
+    glBindTexture(GL_TEXTURE_2D, level.texture);
+    glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_MIN_FILTER, GL_LINEAR);
+    glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_MAG_FILTER, GL_LINEAR);
+    glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_WRAP_S, GL_CLAMP_TO_EDGE);
+    glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_WRAP_T, GL_CLAMP_TO_EDGE);
+    glTexImage2D(GL_TEXTURE_2D, 0, GL_RGBA8, level.width, level.height, 0, GL_RGBA,
+                 GL_UNSIGNED_BYTE, nullptr);
+    glGenFramebuffers(1, &level.fbo);
+    glBindFramebuffer(GL_DRAW_FRAMEBUFFER, level.fbo);
+    glFramebufferTexture2D(GL_DRAW_FRAMEBUFFER, GL_COLOR_ATTACHMENT0, GL_TEXTURE_2D, level.texture,
+                           0);
+    ok = glCheckFramebufferStatus(GL_DRAW_FRAMEBUFFER) == GL_FRAMEBUFFER_COMPLETE;
+    m_levels.push_back(level);
+  }
+
+  glBindTexture(GL_TEXTURE_2D, static_cast<GLuint>(texture));
+  glBindFramebuffer(GL_DRAW_FRAMEBUFFER, static_cast<GLuint>(draw));
+  if (!ok)
+    ReleaseLevels();
+  return ok;
+}
+
+bool CStereoDepthCapture::CopyEye(int eye, int x, int y, int width, int height, std::string& why)
+{
+  if (eye < 0 || eye > 1 || width <= 0 || height <= 0)
+  {
+    why = "no rectangle of the video";
+    return false;
+  }
+  if (eye == 0)
+  {
+    m_eyes[0] = m_eyes[1] = false;
+    m_copiedLevel = -1;
+  }
+  else if (!m_eyes[0])
+  {
+    why = "the left eye was not copied";
+    return false;
+  }
+
+  const int levels = eye == 0 ? LevelsFor(width, height) : m_copiedLevel + 1;
+  if (!EnsureLevels(std::max(levels, static_cast<int>(m_levels.size()))) ||
+      static_cast<int>(m_levels.size()) < levels)
+  {
+    why = "the pictures of the copy could not be made";
+    return false;
+  }
+
+  CKeepState keep;
+
+  // the framebuffer the video was drawn into: its colours must be of fixed point to be blitted
+  // into 8 bits
+  glBindFramebuffer(GL_READ_FRAMEBUFFER, static_cast<GLuint>(keep.Draw()));
+  GLint type = GL_UNSIGNED_NORMALIZED;
+  glGetFramebufferAttachmentParameteriv(GL_READ_FRAMEBUFFER,
+                                        keep.Draw() ? GL_COLOR_ATTACHMENT0 : GL_BACK,
+                                        GL_FRAMEBUFFER_ATTACHMENT_COMPONENT_TYPE, &type);
+  ClearErrors();
+  if (type == GL_FLOAT)
+  {
+    why = "the picture is drawn in floating point";
+    return false;
+  }
+
+  const Level& level = m_levels[static_cast<size_t>(levels - 1)];
+  const int eyeHeight = level.height / 2;
+  // the left eye in the upper half (GL counts from the bottom), the right in the lower
+  const int top = eye == 0 ? eyeHeight : 0;
+
+  glDisable(GL_SCISSOR_TEST);
+  glBindFramebuffer(GL_DRAW_FRAMEBUFFER, level.fbo);
+  glBlitFramebuffer(x, y, x + width, y + height, 0, top, level.width, top + eyeHeight,
+                    GL_COLOR_BUFFER_BIT, GL_LINEAR);
+  if (glGetError() != GL_NO_ERROR)
+  {
+    ClearErrors();
+    why = "the framebuffer could not be blitted";
+    return false;
+  }
+
+  m_eyes[eye] = true;
+  m_copiedLevel = levels - 1;
+  return true;
+}
+
+bool CStereoDepthCapture::CanRead() const
+{
+  return std::any_of(std::begin(m_reads), std::end(m_reads), [](const Read& r) { return !r.busy; });
+}
+
+bool CStereoDepthCapture::StartRead(uint64_t tag, std::string& why)
+{
+  if (!m_eyes[0] || !m_eyes[1] || m_copiedLevel < 0)
+  {
+    why = "both eyes were not copied";
+    return false;
+  }
+  m_eyes[0] = m_eyes[1] = false;
+
+  Read* read = nullptr;
+  for (Read& r : m_reads)
+    if (!r.busy)
+    {
+      read = &r;
+      break;
+    }
+  if (!read)
+  {
+    why = "the reads before have not ended";
+    return false;
+  }
+
+  CKeepState keep;
+  ClearErrors();
+  glDisable(GL_SCISSOR_TEST);
+
+  // halved down to the smallest level, both eyes at once
+  for (int i = m_copiedLevel; i > 0; --i)
+  {
+    const Level& from = m_levels[static_cast<size_t>(i)];
+    const Level& to = m_levels[static_cast<size_t>(i - 1)];
+    glBindFramebuffer(GL_READ_FRAMEBUFFER, from.fbo);
+    glBindFramebuffer(GL_DRAW_FRAMEBUFFER, to.fbo);
+    glBlitFramebuffer(0, 0, from.width, from.height, 0, 0, to.width, to.height, GL_COLOR_BUFFER_BIT,
+                      GL_LINEAR);
+  }
+
+  const size_t size = static_cast<size_t>(WIDTH) * HEIGHT * 2 * 4;
+  if (!read->buffer)
+  {
+    glGenBuffers(1, &read->buffer);
+    glBindBuffer(GL_PIXEL_PACK_BUFFER, read->buffer);
+    glBufferData(GL_PIXEL_PACK_BUFFER, static_cast<GLsizeiptr>(size), nullptr, GL_STREAM_READ);
+  }
+  glBindBuffer(GL_PIXEL_PACK_BUFFER, read->buffer);
+  glBindFramebuffer(GL_READ_FRAMEBUFFER, m_levels[0].fbo);
+  glPixelStorei(GL_PACK_ALIGNMENT, 4);
+  glReadPixels(0, 0, WIDTH, 2 * HEIGHT, GL_RGBA, GL_UNSIGNED_BYTE, nullptr);
+  GLsync fence = glFenceSync(GL_SYNC_GPU_COMMANDS_COMPLETE, 0);
+  if (glGetError() != GL_NO_ERROR || !fence)
+  {
+    if (fence)
+      glDeleteSync(fence);
+    ClearErrors();
+    why = "the copy could not be read back";
+    return false;
+  }
+  // the fence is put in the stream of commands now, so that it is signalled without a wait
+  glFlush();
+
+  read->fence = fence;
+  read->tag = tag;
+  read->order = ++m_order;
+  read->busy = true;
+  return true;
+}
+
+bool CStereoDepthCapture::Luma(const std::vector<uint8_t>& rgba, std::vector<uint8_t>& luma)
+{
+  if (rgba.size() != static_cast<size_t>(WIDTH) * HEIGHT * 2 * 4)
+    return false;
+  // the rows come from the bottom: the right eye's first, from its bottom row up, then the
+  // left eye's. Luma of BT.709 weights, in whole numbers.
+  luma.resize(static_cast<size_t>(WIDTH) * HEIGHT * 2);
+  for (int eye = 0; eye < 2; ++eye)
+  {
+    for (int row = 0; row < HEIGHT; ++row)
+    {
+      const int glRow = (eye == 0 ? HEIGHT : 0) + (HEIGHT - 1 - row);
+      const uint8_t* in = rgba.data() + static_cast<size_t>(glRow) * WIDTH * 4;
+      uint8_t* out = luma.data() + (static_cast<size_t>(eye) * HEIGHT + row) * WIDTH;
+      for (int x = 0; x < WIDTH; ++x)
+        out[x] =
+            static_cast<uint8_t>((54 * in[4 * x] + 183 * in[4 * x + 1] + 19 * in[4 * x + 2]) >> 8);
+    }
+  }
+  return true;
+}
+
+bool CStereoDepthCapture::Collect(std::vector<uint8_t>& rgba, uint64_t& tag)
+{
+  Read* oldest = nullptr;
+  for (Read& r : m_reads)
+    if (r.busy && (!oldest || r.order < oldest->order))
+      oldest = &r;
+  if (!oldest)
+    return false;
+
+  const GLenum state = glClientWaitSync(static_cast<GLsync>(oldest->fence), 0, 0);
+  if (state == GL_TIMEOUT_EXPIRED)
+    return false;
+  glDeleteSync(static_cast<GLsync>(oldest->fence));
+  oldest->fence = nullptr;
+  oldest->busy = false;
+  if (state == GL_WAIT_FAILED)
+  {
+    ClearErrors();
+    return false;
+  }
+
+  CKeepState keep;
+  const size_t size = static_cast<size_t>(WIDTH) * HEIGHT * 2 * 4;
+  glBindBuffer(GL_PIXEL_PACK_BUFFER, oldest->buffer);
+  const auto* pixels = static_cast<const uint8_t*>(
+      glMapBufferRange(GL_PIXEL_PACK_BUFFER, 0, static_cast<GLsizeiptr>(size), GL_MAP_READ_BIT));
+  if (!pixels)
+  {
+    ClearErrors();
+    return false;
+  }
+
+  rgba.assign(pixels, pixels + size);
+  glUnmapBuffer(GL_PIXEL_PACK_BUFFER);
+  tag = oldest->tag;
+  return true;
+}
+
+void CStereoDepthCapture::Drop()
+{
+  for (Read& r : m_reads)
+  {
+    if (r.fence)
+      glDeleteSync(static_cast<GLsync>(r.fence));
+    r.fence = nullptr;
+    r.busy = false;
+  }
+  m_eyes[0] = m_eyes[1] = false;
+}
+
+void CStereoDepthCapture::ReleaseLevels()
+{
+  for (Level& level : m_levels)
+  {
+    if (level.fbo)
+      glDeleteFramebuffers(1, &level.fbo);
+    if (level.texture)
+      glDeleteTextures(1, &level.texture);
+  }
+  m_levels.clear();
+  m_copiedLevel = -1;
+}
+
+void CStereoDepthCapture::Release()
+{
+  Drop();
+  for (Read& r : m_reads)
+  {
+    if (r.buffer)
+      glDeleteBuffers(1, &r.buffer);
+    r.buffer = 0;
+  }
+  ReleaseLevels();
+}
+
+#else
+
+CStereoDepthCapture::~CStereoDepthCapture() = default;
+bool CStereoDepthCapture::Supported(std::string& why)
+{
+  why = "the graphics are not OpenGL (ES) 3";
+  return false;
+}
+bool CStereoDepthCapture::Viewport(int&, int&, int&, int&)
+{
+  return false;
+}
+bool CStereoDepthCapture::CopyEye(int, int, int, int, int, std::string& why)
+{
+  why = "the graphics are not OpenGL (ES) 3";
+  return false;
+}
+bool CStereoDepthCapture::CanRead() const
+{
+  return false;
+}
+bool CStereoDepthCapture::StartRead(uint64_t, std::string& why)
+{
+  why = "the graphics are not OpenGL (ES) 3";
+  return false;
+}
+bool CStereoDepthCapture::Collect(std::vector<uint8_t>&, uint64_t&)
+{
+  return false;
+}
+bool CStereoDepthCapture::Luma(const std::vector<uint8_t>&, std::vector<uint8_t>&)
+{
+  return false;
+}
+void CStereoDepthCapture::Drop()
+{
+}
+void CStereoDepthCapture::Release()
+{
+}
+bool CStereoDepthCapture::EnsureLevels(int)
+{
+  return false;
+}
+void CStereoDepthCapture::ReleaseLevels()
+{
+}
+
+#endif
+
+} // namespace STEREODEPTH
+} // namespace KODI
