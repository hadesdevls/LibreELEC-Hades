+#pragma once
+
+#include <cstdint>
+#include <string>
+#include <vector>
+
+namespace KODI
+{
+namespace STEREODEPTH
+{
+
+/*!
+ * \brief Hades: a small copy of the video of each eye, made by the graphics, read back without
+ *        waiting for them.
+ *
+ * Render thread only, with the GL context current (OpenGL 3 or OpenGL ES 3: framebuffer blits,
+ * pixel buffers and fences). As each eye's video has been drawn, and before anything is drawn over
+ * it, CopyEye() copies its rectangle of the framebuffer bound for drawing into a picture of
+ * WIDTH x HEIGHT, halving it in steps of two (each step averages 2 x 2 pixels, so a large picture
+ * is reduced without aliasing). Once both eyes are in, StartRead() has the graphics read the two
+ * into a pixel buffer, behind a fence; Collect() takes, frames later, the oldest read that is
+ * done. The render thread never waits for the graphics.
+ *
+ * The copy is of the 8 bits of each channel: what is matched is the light of the picture, not
+ * its colour, and only within the picture, so the transfer the framebuffer holds (SDR, PQ) does
+ * not matter.
+ */
+class CStereoDepthCapture
+{
+public:
+  static constexpr int WIDTH = 480;
+  static constexpr int HEIGHT = 270;
+  //! reads in flight at most
+  static constexpr int READS = 3;
+
+  CStereoDepthCapture() = default;
+  ~CStereoDepthCapture();
+  CStereoDepthCapture(const CStereoDepthCapture&) = delete;
+  CStereoDepthCapture& operator=(const CStereoDepthCapture&) = delete;
+
+  //! Whether the context can do it (OpenGL 3 / OpenGL ES 3); why not in \p why
+  static bool Supported(std::string& why);
+
+  //! The viewport set now, in GL window coordinates (from the bottom)
+  static bool Viewport(int& x, int& y, int& width, int& height);
+
+  /*!
+   * \brief Copy one eye's video out of the framebuffer bound for drawing.
+   * \param eye 0 for the left eye, 1 for the right
+   * \param x, y, width, height its rectangle, in GL window coordinates (from the bottom)
+   * \return false where it could not be copied (\p why says why); nothing of this frame is read then
+   */
+  bool CopyEye(int eye, int x, int y, int width, int height, std::string& why);
+
+  //! Whether a slot is free for StartRead()
+  bool CanRead() const;
+
+  /*!
+   * \brief Read both eyes, copied this frame, back.
+   * \param tag given back with the read by Collect()
+   */
+  bool StartRead(uint64_t tag, std::string& why);
+
+  /*!
+   * \brief The oldest read that the graphics have done, as it was read (a copy of the pixel buffer:
+   *        the render thread does nothing more with it).
+   * \param rgba WIDTH x 2 HEIGHT pixels of 4 bytes, the bottom row first (Luma() makes the eyes of it)
+   */
+  bool Collect(std::vector<uint8_t>& rgba, uint64_t& tag);
+
+  /*!
+   * \brief The light of both eyes of a read (any thread).
+   * \param luma WIDTH x HEIGHT bytes of the left eye then as many of the right, top row first
+   * \return false where \p rgba is not a read
+   */
+  static bool Luma(const std::vector<uint8_t>& rgba, std::vector<uint8_t>& luma);
+
+  //! Drop the reads in flight (a seek, a stop): what they hold is of pictures no longer shown
+  void Drop();
+
+  //! Free the GL objects (render thread)
+  void Release();
+
+private:
+  struct Level
+  {
+    uint32_t fbo{0};
+    uint32_t texture{0};
+    int width{0};
+    int height{0}; //!< of both eyes, one above the other
+  };
+  struct Read
+  {
+    uint32_t buffer{0};
+    void* fence{nullptr};
+    uint64_t tag{0};
+    uint64_t order{0};
+    bool busy{false};
+  };
+
+  bool EnsureLevels(int levels);
+  void ReleaseLevels();
+
+  std::vector<Level> m_levels; //!< [0] is WIDTH x 2 HEIGHT; each one after it twice as large
+  Read m_reads[READS];
+  uint64_t m_order{0};
+  bool m_eyes[2]{false, false};
+  int m_copiedLevel{-1}; //!< the level the eyes of this frame were copied into
+};
+
+} // namespace STEREODEPTH
+} // namespace KODI
