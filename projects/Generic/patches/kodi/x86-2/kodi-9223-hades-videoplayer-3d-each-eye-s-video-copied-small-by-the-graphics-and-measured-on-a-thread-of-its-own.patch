+#pragma once
+
+#include "StereoDepth.h"
+#include "StereoDepthCapture.h"
+#include "rendering/RenderSystemTypes.h"
+#include "utils/Geometry.h"
+
+#include <atomic>
+#include <condition_variable>
+#include <cstdint>
+#include <deque>
+#include <mutex>
+#include <optional>
+#include <string>
+#include <thread>
+#include <vector>
+
+namespace KODI
+{
+namespace STEREODEPTH
+{
+
+//! Where the depth of the subtitles over a 3D video comes from
+enum class DepthSource
+{
+  NONE, //!< no 3D output, or not a 3D video: nothing is placed in depth
+  DISC, //!< the plane offsets of a 3D Blu-ray
+  MEASURED, //!< measured from the two pictures
+  FIXED, //!< the setting subtitles.stereoscopicdepth
+};
+
+/*!
+ * \brief Hades: the depth of subtitles and of the interface over a 3D video, from the picture.
+ *
+ * Owned by the render manager, used on the render thread: AfterVideo() as each eye's video is
+ * drawn (it has the graphics copy it, CStereoDepthCapture), Frame() once a frame before drawing
+ * (it collects the copies read back, has them measured on a thread of its own, so that the render
+ * thread never does the matching, and gives the depths of the frame, CPlanner).
+ */
+class CStereoDepthMeter
+{
+public:
+  //! What a frame is
+  struct Facts
+  {
+    bool automatic{true}; //!< the setting asks for the depth to be measured
+    int fixedPixels{0}; //!< subtitles.stereoscopicdepth: a shift of each eye, in pixels
+    RenderStereoMode mode{};
+    bool stereoVideo{false}; //!< the video is a 3D video
+    bool drawnInGuiPass{true}; //!< its renderer draws it in the pass of the interface, per eye
+    bool fullscreen{false};
+    bool discDepth{false}; //!< its subtitles follow the plane offsets of a disc
+    std::optional<int> discOffset; //!< ... of this frame, in the video's pixels
+    float sourceWidth{0.0f}; //!< of one eye's picture, in the video's pixels
+    float destWidth{0.0f}; //!< of one eye's picture as drawn, in pixels of the screen
+    bool subtitleVisible{false};
+    uint64_t subtitleEvent{0};
+    std::optional<CRect> subtitleArea; //!< where they were drawn, in pixels of the screen
+    bool guiShown{false}; //!< the interface was drawn over the video in the frame before
+  };
+
+  struct Depths
+  {
+    //! the depth of the subtitles (a share of the width of the picture), where measured
+    std::optional<float> subtitles;
+    //! the shift of each eye's interface over the video, in pixels of the screen
+    float guiPixels{0.0f};
+  };
+
+  CStereoDepthMeter();
+  ~CStereoDepthMeter();
+  CStereoDepthMeter(const CStereoDepthMeter&) = delete;
+  CStereoDepthMeter& operator=(const CStereoDepthMeter&) = delete;
+
+  //! Once a frame, before it is drawn
+  Depths Frame(const Facts& facts);
+
+  /*!
+   * \brief After an eye's video was drawn, before anything is drawn over it.
+   * \param dest the video's rectangle, in pixels of the screen (of the eye)
+   * \param eyeWidth, eyeHeight the size of an eye's screen
+   * \param picture the picture drawn (its time): a picture is measured once
+   */
+  void AfterVideo(
+      RenderStereoView view, const CRect& dest, int eyeWidth, int eyeHeight, double picture);
+
+  //! A seek or a new stream: what was measured is of pictures no longer shown
+  void Flush() { m_flush = true; }
+
+  //! Free what the graphics hold (render thread)
+  void Release();
+
+  DepthSource Source() const { return m_source; }
+
+private:
+  struct Job
+  {
+    uint64_t generation{0};
+    double t{0.0};
+    Area area;
+    std::vector<uint8_t> rgba; //!< as CStereoDepthCapture::Collect() gives it
+  };
+  struct Result
+  {
+    uint64_t generation{0};
+    double t{0.0};
+    std::optional<float> area;
+    std::optional<float> whole;
+    bool cut{false};
+  };
+  struct Pending
+  {
+    uint64_t tag{0};
+    double t{0.0};
+    Area area;
+  };
+
+  void Work();
+  void Submit(Job&& job);
+  //! Whether it can be measured; why not in m_why
+  bool Measurable(const Facts& facts);
+  void Tell(const Facts& facts);
+  Area SubtitleArea() const;
+
+  CStereoDepthCapture m_capture;
+  CPlanner m_planner;
+  std::atomic<bool> m_flush{false};
+  uint64_t m_generation{1};
+
+  // what AfterVideo() needs of the frame, set by Frame()
+  bool m_measure{false};
+  bool m_copying{false};
+  double m_lastPicture{-1.0};
+  double m_lastCopy{-1.0};
+  uint64_t m_tag{0};
+  std::deque<Pending> m_pending;
+  CRect m_copied; //!< the part of the eye's screen copied, in its pixels
+  std::optional<CRect> m_subtitleArea; //!< the last place of the subtitles, in the same pixels
+  std::string m_broken; //!< why the copy failed for good, in this video
+
+  // the thread that matches
+  std::thread m_thread;
+  std::mutex m_lock;
+  std::condition_variable m_wake;
+  bool m_stop{false};
+  std::deque<Job> m_jobs;
+  std::deque<Result> m_results;
+
+  // what kodi.log was told
+  DepthSource m_source{DepthSource::NONE};
+  std::string m_why;
+  std::string m_told;
+  uint64_t m_toldEvent{0};
+};
+
+} // namespace STEREODEPTH
+} // namespace KODI
