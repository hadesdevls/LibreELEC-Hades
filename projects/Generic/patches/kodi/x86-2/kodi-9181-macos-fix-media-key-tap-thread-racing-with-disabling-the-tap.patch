From ae8ccefbbd8fac50257b137b89faae601f698a63 Mon Sep 17 00:00:00 2001
From: ksooo <kai.sommerfeld@gmx.com>
Date: Mon, 28 Sep 2026 21:55:43 +0200
Subject: [PATCH] [macOS] Fix media key tap thread racing with disabling the
 tap

The tap thread read the run loop source from the tap object once it got
to run. When the tap was disabled right after being enabled - as focus
changes while quitting can do - the source had been released by then,
and adding it to the run loop crashed. Likewise, the thread could
publish its run loop after the tap was disabled, leaving a stale one
behind for the next disabling to stop.

Hand the thread its own reference to the source, and let it register
its run loop only while the source is still valid, under the same lock
disabling uses to invalidate it.

(cherry picked from commit c2d887b6188140944b17544ec4bd4b98585c1b19)
---
 xbmc/platform/darwin/osx/MediaKeys.mm | 36 ++++++++++++++++++++++++---
 1 file changed, 32 insertions(+), 4 deletions(-)

diff --git a/xbmc/platform/darwin/osx/MediaKeys.mm b/xbmc/platform/darwin/osx/MediaKeys.mm
index f2280e5..f6b3fa1 100644
--- a/xbmc/platform/darwin/osx/MediaKeys.mm
+++ b/xbmc/platform/darwin/osx/MediaKeys.mm
@@ -53,6 +53,15 @@ CGEventRef MediaKeyCallback(CGEventTapProxy proxy, CGEventType type, CGEventRef
   CFRunLoopSourceRef m_sourceRef;
   CFRunLoopRef m_tapThreadURL;
   NSThread* m_mediaKeyTapThread;
+  NSLock* m_tapLock;
+}
+
+- (instancetype)init
+{
+  self = [super init];
+  if (self)
+    m_tapLock = [[NSLock alloc] init];
+  return self;
 }
 
 - (void)dealloc
@@ -81,14 +90,17 @@ CGEventRef MediaKeyCallback(CGEventTapProxy proxy, CGEventType type, CGEventRef
     return;
   }
 
+  // The thread gets its own reference to the source, as disabling may release ours before it runs
   m_mediaKeyTapThread = [[NSThread alloc] initWithTarget:self
-                                                selector:@selector(eventTapThread)
-                                                  object:nil];
+                                                selector:@selector(eventTapThread:)
+                                                  object:(__bridge id)m_sourceRef];
   [m_mediaKeyTapThread start];
 }
 
 - (void)disableMediaKeyTap
 {
+  [m_tapLock lock];
+
   if (m_tapThreadURL)
   {
     CFRunLoopStop(m_tapThreadURL);
@@ -104,15 +116,31 @@ CGEventRef MediaKeyCallback(CGEventTapProxy proxy, CGEventType type, CGEventRef
 
   if (m_sourceRef)
   {
+    // Tells a tap thread that has yet to start not to
+    CFRunLoopSourceInvalidate(m_sourceRef);
     CFRelease(m_sourceRef);
     m_sourceRef = nullptr;
   }
+
+  [m_tapLock unlock];
 }
 
-- (void)eventTapThread
+- (void)eventTapThread:(id)source
 {
+  const auto sourceRef = (__bridge CFRunLoopSourceRef)source;
+  [m_tapLock lock];
+
+  if (!CFRunLoopSourceIsValid(sourceRef))
+  {
+    [m_tapLock unlock];
+    return;
+  }
+
   m_tapThreadURL = CFRunLoopGetCurrent();
-  CFRunLoopAddSource(m_tapThreadURL, m_sourceRef, kCFRunLoopCommonModes);
+  CFRunLoopAddSource(m_tapThreadURL, sourceRef, kCFRunLoopCommonModes);
+
+  [m_tapLock unlock];
+
   CFRunLoopRun();
 }
 
-- 
