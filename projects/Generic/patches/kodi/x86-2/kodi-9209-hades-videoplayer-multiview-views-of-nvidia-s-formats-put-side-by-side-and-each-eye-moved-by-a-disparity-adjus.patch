+++ b/xbmc/cores/VideoPlayer/DVDCodecs/Video/MultiviewPacker.cpp
@@ -10,6 +10,8 @@
 
 #include "utils/log.h"
 
+#include <algorithm>
+#include <cstdlib>
 #include <cstring>
 
 extern "C"
@@ -76,6 +78,158 @@ PictureEye EyeOf(const AVFrame* frame)
          : stereo->view == AV_STEREO3D_VIEW_RIGHT ? PictureEye::RIGHT
                                                   : PictureEye::UNSAID;
 }
+
+/*!
+ * \brief The format of the picture of two views, for views of this format
+ *
+ * The same, but for P010, which NVIDIA's decoder gives for 10 bits (each sample in the high bits
+ * of 16, the two chroma planes in one) and which Kodi's renderers on GBM do not take: its views
+ * go into a picture of the planar 10-bit format that the processor's decoder gives, in the same
+ * pass, sample for sample (the low 6 bits of P010 are zero).
+ */
+AVPixelFormat PackedFormat(AVPixelFormat view)
+{
+  return view == AV_PIX_FMT_P010LE ? AV_PIX_FMT_YUV420P10LE : view;
+}
+
+//! The value of a picture with nothing in it (black, no colour, opaque) for one component, in
+//! its bits and at its place
+uint32_t Empty(const AVPixFmtDescriptor& desc, int component, bool fullRange)
+{
+  const AVComponentDescriptor& comp = desc.comp[component];
+  const int depth = comp.depth;
+  uint32_t value = 0;
+  if (desc.flags & AV_PIX_FMT_FLAG_RGB)
+    value = (desc.flags & AV_PIX_FMT_FLAG_ALPHA) && component == 3 ? (1u << depth) - 1 : 0;
+  else if (component == 0)
+    value = fullRange ? 0 : 16u << (depth - 8);
+  else if (component < 3)
+    value = 1u << (depth - 1);
+  else
+    value = (1u << depth) - 1;
+  return value << comp.shift;
+}
+
+/*!
+ * \brief One plane of one view into its half of the picture of two, moved sideways
+ * \param shift how far the view goes to the right, in positions of this plane (a position is
+ *        what a pixel of the plane takes: a sample, or a pair of chroma samples where two are
+ *        interleaved); where it leaves an edge without picture, the picture is empty there
+ */
+void CopyPlane(const AVPixFmtDescriptor& desc,
+               int plane,
+               bool fullRange,
+               uint8_t* dst,
+               int dstLinesize,
+               const uint8_t* src,
+               int srcLinesize,
+               int rowBytes,
+               int positions,
+               int rows,
+               int shift)
+{
+  if (shift == 0 || positions <= 0)
+  {
+    av_image_copy_plane(dst, dstLinesize, src, srcLinesize, rowBytes, rows);
+    return;
+  }
+  const int bytes = rowBytes / positions;
+  // the bytes of one empty position of this plane
+  uint8_t empty[16] = {};
+  if (bytes > static_cast<int>(sizeof(empty)))
+    return;
+  for (int c = 0; c < desc.nb_components; ++c)
+  {
+    const AVComponentDescriptor& comp = desc.comp[c];
+    if (comp.plane != plane)
+      continue;
+    const uint32_t value = Empty(desc, c, fullRange);
+    if (comp.step > 1 || comp.depth > 8)
+    {
+      // (16 bits, little-endian, at the byte of the component)
+      empty[comp.offset] = static_cast<uint8_t>(value & 0xff);
+      if (comp.offset + 1 < bytes)
+        empty[comp.offset + 1] = static_cast<uint8_t>(value >> 8);
+    }
+    else
+      empty[comp.offset] = static_cast<uint8_t>(value);
+  }
+  const int moved = std::min(std::abs(shift), positions);
+  const int kept = positions - moved;
+  for (int y = 0; y < rows; ++y)
+  {
+    uint8_t* row = dst + static_cast<ptrdiff_t>(y) * dstLinesize;
+    const uint8_t* from = src + static_cast<ptrdiff_t>(y) * srcLinesize;
+    // to the right: the edge on the left is empty; to the left: the one on the right
+    uint8_t* edge = shift > 0 ? row : row + static_cast<ptrdiff_t>(kept) * bytes;
+    for (int x = 0; x < moved; ++x)
+      std::memcpy(edge + static_cast<ptrdiff_t>(x) * bytes, empty, bytes);
+    if (shift > 0)
+      std::memcpy(row + static_cast<ptrdiff_t>(moved) * bytes, from,
+                  static_cast<size_t>(kept) * bytes);
+    else
+      std::memcpy(row, from + static_cast<ptrdiff_t>(moved) * bytes,
+                  static_cast<size_t>(kept) * bytes);
+  }
+}
+
+/*!
+ * \brief A view of P010 into its half of a planar 10-bit picture (PackedFormat()), moved sideways
+ *        as CopyPlane() moves one
+ * \param shift in pixels, even
+ */
+void CopyP010(uint8_t* const dst[3],
+              const int dstLinesize[3],
+              const AVFrame* src,
+              int width,
+              int height,
+              int shift,
+              bool fullRange)
+{
+  const uint16_t black = fullRange ? 0 : 16 << 2;
+  const uint16_t neutral = 512;
+  // the samples of a row that come from the view (from first to end), the others empty: loops
+  // without a test inside, which the compiler makes into vector code
+  const auto span = [](int size, int by, int& first, int& end)
+  {
+    first = std::clamp(by, 0, size);
+    end = std::clamp(size + by, 0, size);
+  };
+  int first = 0;
+  int end = 0;
+  span(width, shift, first, end);
+  for (int y = 0; y < height; ++y)
+  {
+    auto* out = reinterpret_cast<uint16_t*>(dst[0] + static_cast<ptrdiff_t>(y) * dstLinesize[0]);
+    const auto* in = reinterpret_cast<const uint16_t*>(src->data[0] + static_cast<ptrdiff_t>(y) *
+                                                                          src->linesize[0]);
+    for (int x = 0; x < first; ++x)
+      out[x] = black;
+    for (int x = first; x < end; ++x)
+      out[x] = static_cast<uint16_t>(in[x - shift] >> 6);
+    for (int x = end; x < width; ++x)
+      out[x] = black;
+  }
+  const int chromaWidth = width / 2;
+  const int chromaShift = shift / 2;
+  span(chromaWidth, chromaShift, first, end);
+  for (int y = 0; y < (height + 1) / 2; ++y)
+  {
+    auto* u = reinterpret_cast<uint16_t*>(dst[1] + static_cast<ptrdiff_t>(y) * dstLinesize[1]);
+    auto* v = reinterpret_cast<uint16_t*>(dst[2] + static_cast<ptrdiff_t>(y) * dstLinesize[2]);
+    const auto* in = reinterpret_cast<const uint16_t*>(src->data[1] + static_cast<ptrdiff_t>(y) *
+                                                                          src->linesize[1]);
+    for (int x = 0; x < first; ++x)
+      u[x] = v[x] = neutral;
+    for (int x = first; x < end; ++x)
+    {
+      u[x] = static_cast<uint16_t>(in[2 * (x - chromaShift)] >> 6);
+      v[x] = static_cast<uint16_t>(in[2 * (x - chromaShift) + 1] >> 6);
+    }
+    for (int x = end; x < chromaWidth; ++x)
+      u[x] = v[x] = neutral;
+  }
+}
 } // namespace
 
 CMultiviewPacker::CMultiviewPacker(BaseEye baseEye, bool eyeFromPictures)
@@ -90,6 +244,49 @@ CMultiviewPacker::~CMultiviewPacker()
 {
   av_frame_free(&m_waiting);
   av_frame_free(&m_packed);
+  // (a pool whose buffers a picture still holds is freed when the last one comes back)
+  for (AVBufferPool*& pool : m_pools)
+    av_buffer_pool_uninit(&pool);
+}
+
+bool CMultiviewPacker::GetBuffers()
+{
+  // Hades: the planes of the picture of two views come from pools that are kept while their size
+  // is: a picture of 2x3840x2160 takes 50 MB (10 bits), which a new allocation would map and
+  // fault in page by page at each picture (measured as the image builds Kodi, on a Ryzen 9
+  // 7950X3D: 28.6 ms a picture at 2160p per eye, against 3.8 ms from a pool)
+  const auto format = static_cast<AVPixelFormat>(m_packed->format);
+  int widths[4] = {};
+  if (av_image_fill_linesizes(widths, format, m_packed->width) < 0)
+    return false;
+  ptrdiff_t linesizes[4] = {};
+  for (int plane = 0; plane < 4; ++plane)
+    linesizes[plane] = (widths[plane] + 63) & ~63;
+  size_t sizes[4] = {};
+  if (av_image_fill_plane_sizes(sizes, format, m_packed->height, linesizes) < 0)
+    return false;
+  for (int plane = 0; plane < 4; ++plane)
+  {
+    if (!sizes[plane])
+      continue;
+    // (and what FFmpeg's own allocation adds at the end, for code that reads past a row)
+    const size_t size = sizes[plane] + 64;
+    if (!m_pools[plane] || m_poolSizes[plane] != size)
+    {
+      av_buffer_pool_uninit(&m_pools[plane]);
+      m_pools[plane] = av_buffer_pool_init(size, nullptr);
+      m_poolSizes[plane] = size;
+    }
+    if (!m_pools[plane])
+      return false;
+    m_packed->buf[plane] = av_buffer_pool_get(m_pools[plane]);
+    if (!m_packed->buf[plane])
+      return false;
+    m_packed->data[plane] = m_packed->buf[plane]->data;
+    m_packed->linesize[plane] = static_cast<int>(linesizes[plane]);
+  }
+  m_packed->extended_data = m_packed->data;
+  return true;
 }
 
