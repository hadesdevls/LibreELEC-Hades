+/*!
+ * \name The graphics card of NVIDIA, decoding both views
+ *
+ * NVIDIA's video decoder (NVDEC) decodes the two layers of MV-HEVC where FFmpeg (9.1 on,
+ * nvdec_hevc.c) gives it the fields of the Video Codec SDK 13.1 that say the layer of each
+ * picture and its references in the other layer. The SDK asks for driver 610 or later (its
+ * Read Me: "Driver version 610 and above", Linux and Windows): an older driver does not know
+ * those fields and would decode the slices of the second view as pictures of the first. So
+ * NVDEC is asked for the two views only with such a driver (Hades: the 620 series for Turing
+ * and later; the 580 series of the older cards is not), and only through the copy back to
+ * memory that the processor's path ends in: the views are copied from the card, put side by
+ * side as the processor's are, and shown the same way. Where NVDEC cannot be had or fails, the
+ * processor decodes both views; where that does not keep up, the base view plays alone (2D).
+ * @{
+ */
+
+//! The first driver series whose NVDEC takes the two layers of MV-HEVC (Video Codec SDK 13.1)
+inline constexpr int NVDEC_TWO_VIEWS_DRIVER = 610;
+
+/*!
+ * \brief The series of the NVIDIA driver that is loaded, from what its module says of its
+ *        version (/sys/module/nvidia/version: "620.73.04"); nothing where it says nothing
+ */
+inline std::optional<int> NvidiaDriverSeries(std::string_view version)
+{
+  int series = 0;
+  size_t digits = 0;
+  for (; digits < version.size() && version[digits] >= '0' && version[digits] <= '9'; ++digits)
+  {
+    if (digits >= 6)
+      return std::nullopt;
+    series = series * 10 + (version[digits] - '0');
+  }
+  if (digits == 0 || (digits < version.size() && version[digits] != '.'))
+    return std::nullopt;
+  return series;
+}
+
+//! Whether NVDEC is asked for both views of a stream, and why not where it is not
+enum class Nvdec
+{
+  ASKED,
+  NOT_HEVC, //!< H.264 MVC: NVDEC has no MVC
+  SOFTWARE, //!< the player asked for decoding by the processor
+  NOT_ALLOWED, //!< hardware decoding is off (the setting of VAAPI, NVIDIA's other path to NVDEC)
+  FAILED_BEFORE, //!< it failed for this stream: the processor decodes both views from then on
+  NO_DRIVER, //!< no NVIDIA driver is loaded
+  OLD_DRIVER, //!< ... or one before NVDEC_TWO_VIEWS_DRIVER
+};
+
+constexpr Nvdec NvdecForTwoViews(bool hevc,
+                                 bool softwareAsked,
+                                 bool hardwareAllowed,
+                                 bool failedBefore,
+                                 std::optional<int> driverSeries)
+{
+  if (!hevc)
+    return Nvdec::NOT_HEVC;
+  if (softwareAsked)
+    return Nvdec::SOFTWARE;
+  if (!hardwareAllowed)
+    return Nvdec::NOT_ALLOWED;
+  if (failedBefore)
+    return Nvdec::FAILED_BEFORE;
+  if (!driverSeries)
+    return Nvdec::NO_DRIVER;
+  if (*driverSeries < NVDEC_TWO_VIEWS_DRIVER)
+    return Nvdec::OLD_DRIVER;
+  return Nvdec::ASKED;
+}
+
+//! ... in words for the log
+constexpr const char* NvdecWhyNot(Nvdec nvdec)
+{
+  switch (nvdec)
+  {
+    case Nvdec::ASKED:
+      return "asked";
+    case Nvdec::NOT_HEVC:
+      return "not HEVC";
+    case Nvdec::SOFTWARE:
+      return "the player asked for decoding by the processor";
+    case Nvdec::NOT_ALLOWED:
+      return "hardware decoding (VAAPI) is off";
+    case Nvdec::FAILED_BEFORE:
+      return "it failed for this stream before";
+    case Nvdec::NO_DRIVER:
+      return "no NVIDIA driver is loaded";
+    case Nvdec::OLD_DRIVER:
+      return "the NVIDIA driver is older than the 610 series, whose NVDEC takes the two views";
+  }
+  return "";
+}
