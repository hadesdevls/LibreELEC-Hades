+/*!
+ * \brief How far the left eye's picture is moved sideways for the disparity adjustment that a
+ *        spatial video of Apple carries, in pixels to the right (the right eye's goes as far the
+ *        other way)
+ * \param adjustment the adjustment in ten-thousandths of the width of a view, -10000 to 10000
+ *        (the box 'dadj' of 'cmfy' in 'eyes', which FFmpeg gives as
+ *        AVStereo3D::horizontal_disparity_adjustment over 10000); 0 where there is none
+ * \param width the width of a view
+ * \param step the pixels that a chroma sample spans across (2 for 4:2:0): the move is a whole
+ *        number of them, so that the chroma moves with the luma
+ *
+ * Apple's "QuickTime and ISO Base Media File Formats and Spatial and Immersive Media" (1.9.8,
+ * StereoComfortDisparityAdjustmentBox) maps the value over the width of a view's image and
+ * applies half of it to each eye, positive denoting more disparity from the parallel direction,
+ * negative toward the viewer; Apple's Compressor says it plainly: "When horizontal disparity is
+ * negative, content in the footage appears closer; when it's positive, content seems farther
+ * away". Content goes farther when the left eye's picture moves left and the right eye's right.
+ * The cameras of a spatial video look in parallel, which puts everything far away at the plane
+ * of the screen and everything else in front of it; the adjustment is where its maker put that
+ * plane instead, as the Vision Pro shows it.
+ */
+constexpr int LeftEyeShift(int adjustment, int width, int step)
+{
+  if (adjustment == 0 || adjustment < -10000 || adjustment > 10000 || width <= 0 || step <= 0)
+    return 0;
+  // half of adjustment / 10000 of the width, to the nearest whole step (and away from 0 at .5)
+  const int64_t numerator = static_cast<int64_t>(adjustment) * width;
+  const int64_t denominator = int64_t{20000} * step;
+  const int64_t steps = numerator >= 0 ? (numerator + denominator / 2) / denominator
+                                       : -((-numerator + denominator / 2) / denominator);
+  return static_cast<int>(-steps * step);
+}
