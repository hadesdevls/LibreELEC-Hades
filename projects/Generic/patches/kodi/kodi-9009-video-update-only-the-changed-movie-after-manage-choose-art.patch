From 6df01f9d51749e3db5dc8cf0a949aeacd5c9b6f5 Mon Sep 17 00:00:00 2001
From: olympia <olympia@xbmc.org>
Date: Tue, 27 Oct 2026 18:30:55 +0100
Subject: [PATCH] [Video] Update only the changed movie after Manage > Choose
 art

Choosing art for a movie through the Manage context menu still reloaded
the whole list. The art is set on the list item itself, so the window
now only reloads the art of that item, the same way as after the
information dialog. Other Manage actions and other media types still
refresh the whole list.
---
 xbmc/video/windows/GUIWindowVideoBase.h  | 26 ++++++++++++------------
 xbmc/video/windows/GUIWindowVideoNav.cpp |  6 ++++++
 2 files changed, 19 insertions(+), 13 deletions(-)

diff --git a/xbmc/video/windows/GUIWindowVideoBase.h b/xbmc/video/windows/GUIWindowVideoBase.h
index 63a39f3..1c12499 100644
--- a/xbmc/video/windows/GUIWindowVideoBase.h
+++ b/xbmc/video/windows/GUIWindowVideoBase.h
@@ -108,6 +108,19 @@ protected:
                           const ADDON::ScraperPtr& content,
                           const std::string& listItemPath);
 
+  /*!
+   \brief Update the list item of a movie in place after its information or art was changed
+   \param listItemPath path of the list item to update
+   \param originalFile file of the movie the change was requested for
+   \param item the changed movie
+   \param infoRefreshed true if the movie was refreshed, false if only its art changed
+   \return true if the list item was updated, false if the list has to be refreshed instead
+   */
+  bool UpdateMovieListItem(const std::string& listItemPath,
+                           const std::string& originalFile,
+                           const CFileItem& item,
+                           bool infoRefreshed);
+
   void OnSearch();
   void OnSearchItemFound(const CFileItem* pSelItem);
   int GetScraperForItem(CFileItem* item,
@@ -148,17 +161,4 @@ private:
   ShowInfoResult ShowInfo(const std::shared_ptr<CFileItem>& item,
                           const std::shared_ptr<ADDON::CScraper>& content,
                           std::shared_ptr<CFileItem>& updatedItem);
-
-  /*!
-   \brief Update the list item of a movie in place after the information dialog changed it
-   \param listItemPath path of the list item to update
-   \param originalFile file of the movie the information was requested for
-   \param item the movie as last shown by the information dialog
-   \param infoRefreshed true if the movie was refreshed, false if only its art changed
-   \return true if the list item was updated, false if the list has to be refreshed instead
-   */
-  bool UpdateMovieListItem(const std::string& listItemPath,
-                           const std::string& originalFile,
-                           const CFileItem& item,
-                           bool infoRefreshed);
 };
diff --git a/xbmc/video/windows/GUIWindowVideoNav.cpp b/xbmc/video/windows/GUIWindowVideoNav.cpp
index df9f276..405c310 100644
--- a/xbmc/video/windows/GUIWindowVideoNav.cpp
+++ b/xbmc/video/windows/GUIWindowVideoNav.cpp
@@ -934,6 +934,12 @@ bool CGUIWindowVideoNav::OnContextButton(int itemNumber, CONTEXT_BUTTON button)
     {
       const int ret{CGUIDialogVideoInfo::ManageVideoItem(item)};
 
+      // changed art of a movie only needs its own list item updated
+      if (ret == CONTEXT_BUTTON_SET_ART && item->HasVideoInfoTag() &&
+          UpdateMovieListItem(item->GetPath(), item->GetVideoInfoTag()->m_strFileNameAndPath, *item,
+                              false))
+        return true;
+
       if (ret >= 0)
       {
         Refresh(true);
-- 
