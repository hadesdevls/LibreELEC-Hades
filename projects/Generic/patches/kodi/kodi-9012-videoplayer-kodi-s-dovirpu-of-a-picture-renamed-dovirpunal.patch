From 3f2667a9fc2af526939328375fd0b52d40402975 Mon Sep 17 00:00:00 2001
From: Hades <15710513+hadesdevls@users.noreply.github.com>
Date: Wed, 11 Nov 2026 03:19:37 +0000
Subject: [PATCH] VideoPlayer: Kodi's doviRpu of a picture renamed doviRpuNal

This tree has a doviRpu of its own in VideoPicture (the coded RPU that the Dolby Vision bridge pairs
the layers by), so the member that Kodi added with the Xbox Dolby Vision plugin (b675c1e of Piers)
takes another name. Seven places: the Reset of VideoPicture, its declaration, the two in the FFmpeg
decoder and the four readers in the Windows renderers.
---
 xbmc/cores/VideoPlayer/DVDCodecs/Video/DVDVideoCodec.cpp    | 2 +-
 xbmc/cores/VideoPlayer/DVDCodecs/Video/DVDVideoCodec.h      | 4 +++-
 .../VideoPlayer/DVDCodecs/Video/DVDVideoCodecFFmpeg.cpp     | 4 ++--
 .../VideoPlayer/VideoRenderers/windows/RendererBase.cpp     | 2 +-
 .../VideoPlayer/VideoRenderers/windows/RendererShaders.cpp  | 6 +++---
 5 files changed, 10 insertions(+), 8 deletions(-)

diff --git a/xbmc/cores/VideoPlayer/DVDCodecs/Video/DVDVideoCodec.cpp b/xbmc/cores/VideoPlayer/DVDCodecs/Video/DVDVideoCodec.cpp
index a41939d..1d3af3c 100644
--- a/xbmc/cores/VideoPlayer/DVDCodecs/Video/DVDVideoCodec.cpp
+++ b/xbmc/cores/VideoPlayer/DVDCodecs/Video/DVDVideoCodec.cpp
@@ -49,7 +49,7 @@ void VideoPicture::Reset()
   pict_type = 0;
 
   hdrType = StreamHdrType::HDR_TYPE_NONE;
-  doviRpu.reset();
+  doviRpuNal.reset();
 
   hasDisplayMetadata = false;
   hasLightMetadata = false;
diff --git a/xbmc/cores/VideoPlayer/DVDCodecs/Video/DVDVideoCodec.h b/xbmc/cores/VideoPlayer/DVDCodecs/Video/DVDVideoCodec.h
index 08933a0..138613b 100644
--- a/xbmc/cores/VideoPlayer/DVDCodecs/Video/DVDVideoCodec.h
+++ b/xbmc/cores/VideoPlayer/DVDCodecs/Video/DVDVideoCodec.h
@@ -77,7 +77,9 @@ public:
   StreamHdrType hdrType;
   StreamHdrType hdrTypeAlt;
   std::string strDVELType;
-  std::shared_ptr<const DoviRpu> doviRpu;
+  //! Hades: Kodi's doviRpu, renamed, as this tree has a doviRpu of its own (below, the coded RPU
+  //! that the Dolby Vision bridge pairs the layers by)
+  std::shared_ptr<const DoviRpu> doviRpuNal;
 
   bool hasDisplayMetadata = false;
   AVMasteringDisplayMetadata displayMetadata;
diff --git a/xbmc/cores/VideoPlayer/DVDCodecs/Video/DVDVideoCodecFFmpeg.cpp b/xbmc/cores/VideoPlayer/DVDCodecs/Video/DVDVideoCodecFFmpeg.cpp
index 34ba54e..aa1a895 100644
--- a/xbmc/cores/VideoPlayer/DVDCodecs/Video/DVDVideoCodecFFmpeg.cpp
+++ b/xbmc/cores/VideoPlayer/DVDCodecs/Video/DVDVideoCodecFFmpeg.cpp
@@ -1193,7 +1193,7 @@ bool CDVDVideoCodecFFmpeg::GetPictureCommon(VideoPicture* pVideoPicture)
     pVideoPicture->hasLightMetadata = true;
   }
 
-  pVideoPicture->doviRpu.reset();
+  pVideoPicture->doviRpuNal.reset();
   if (m_exportDoviRpu)
   {
     std::vector<uint8_t> rpu;
@@ -1214,7 +1214,7 @@ bool CDVDVideoCodecFFmpeg::GetPictureCommon(VideoPicture* pVideoPicture)
     }
 
     if (!rpu.empty())
-      pVideoPicture->doviRpu = std::make_shared<DoviRpu>(DoviRpu{
+      pVideoPicture->doviRpuNal = std::make_shared<DoviRpu>(DoviRpu{
           m_hints.dovi.dv_profile, m_hints.dovi.dv_bl_signal_compatibility_id, std::move(rpu)});
   }
 
diff --git a/xbmc/cores/VideoPlayer/VideoRenderers/windows/RendererBase.cpp b/xbmc/cores/VideoPlayer/VideoRenderers/windows/RendererBase.cpp
index bc5d23f..e5b48fc 100644
--- a/xbmc/cores/VideoPlayer/VideoRenderers/windows/RendererBase.cpp
+++ b/xbmc/cores/VideoPlayer/VideoRenderers/windows/RendererBase.cpp
@@ -66,7 +66,7 @@ void CRenderBuffer::AppendPicture(const VideoPicture& picture)
   bits = picture.colorBits;
   stereoMode = picture.stereoMode;
   pixelFormat = picture.pixelFormat;
-  doviRpu = picture.doviRpu;
+  doviRpu = picture.doviRpuNal;
 
   hasDisplayMetadata = picture.hasDisplayMetadata;
   displayMetadata = picture.displayMetadata;
diff --git a/xbmc/cores/VideoPlayer/VideoRenderers/windows/RendererShaders.cpp b/xbmc/cores/VideoPlayer/VideoRenderers/windows/RendererShaders.cpp
index dd4a2f9..4340caa 100644
--- a/xbmc/cores/VideoPlayer/VideoRenderers/windows/RendererShaders.cpp
+++ b/xbmc/cores/VideoPlayer/VideoRenderers/windows/RendererShaders.cpp
@@ -115,7 +115,7 @@ void CRendererShaders::GetWeight(std::map<RenderMethod, int>& weights, const Vid
 
 #if defined(TARGET_WINDOWS_STORE)
   // Dolby Vision is only reshaped by the renderer effect on this path
-  if (picture.doviRpu && IsDolbyVisionEffectFormat(av_pixel_format))
+  if (picture.doviRpuNal && IsDolbyVisionEffectFormat(av_pixel_format))
   {
     static const bool effectAvailable = CDolbyVisionEffect::IsAvailable();
     if (effectAvailable)
@@ -164,13 +164,13 @@ bool CRendererShaders::Configure(const VideoPicture& picture, float fps, unsigne
     m_dvFrameIdx = UINT64_MAX;
     m_dvUpload.Release();
     m_dolbyVisionEffect =
-        picture.doviRpu && IsDolbyVisionEffectFormat(picture.videoBuffer->GetFormat());
+        picture.doviRpuNal && IsDolbyVisionEffectFormat(picture.videoBuffer->GetFormat());
     if (m_dolbyVisionEffect)
     {
       // opened before the first ProcessHDR(), which only switches to Dolby Vision output for a
       // working effect
       m_dvEffect = OpenEffect(IntendToRenderAsHDR(picture), m_fps,
-                              GetStreamInfo(*picture.doviRpu, picture.color_space,
+                              GetStreamInfo(*picture.doviRpuNal, picture.color_space,
                                             picture.color_transfer, picture.color_range == 1,
                                             picture.hasDisplayMetadata, picture.displayMetadata));
       m_dvEffectDolbyVisionOutput = m_DolbyVisionOutput;
-- 
2.53.0

