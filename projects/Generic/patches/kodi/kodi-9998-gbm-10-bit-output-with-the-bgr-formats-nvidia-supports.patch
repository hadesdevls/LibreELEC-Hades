From be07a5f9fd06907b527493d9a6dbb9de6bf33f99 Mon Sep 17 00:00:00 2001
From: Hades <15710513+hadesdevls@users.noreply.github.com>
Date: Sun, 27 Sep 2026 23:16:34 +0000
Subject: [PATCH] windowing/gbm: 10-bit output with the BGR formats nvidia-drm
 supports

On real NVIDIA hardware HDR10 played through an 8-bit surface: "failed to
choose EGL config for 10-bit". Kodi only offers ARGB2101010 and
XRGB2101010 for high bit depth output, but nvidia-drm 615 advertises 10
bits only as ABGR2101010 and XBGR2101010 (A2B10G10R10/X2B10G10R10 in
nvidia-drm-format.c), so no 10-bit format was ever active.

Offer ABGR2101010 and XBGR2101010 after the RGB formats, and keep the
order of the list among formats of the same depth (stable sort), so
drivers that support the RGB formats pick exactly what they picked
before.

When a high bit depth output is still impossible, say once why: which
output formats the planes support and which window EGL configs exist.
Whether NVIDIA's EGL offers configs for the BGR formats is not verified
yet; that report answers it.
---
 xbmc/windowing/gbm/WinSystemGbmEGLContext.cpp | 55 ++++++++++++++++++-
 xbmc/windowing/gbm/WinSystemGbmEGLContext.h   |  1 +
 xbmc/windowing/gbm/drm/DRMUtils.h             |  5 +-
 3 files changed, 59 insertions(+), 2 deletions(-)

diff --git a/xbmc/windowing/gbm/WinSystemGbmEGLContext.cpp b/xbmc/windowing/gbm/WinSystemGbmEGLContext.cpp
index cb6df88..b7517cf 100644
--- a/xbmc/windowing/gbm/WinSystemGbmEGLContext.cpp
+++ b/xbmc/windowing/gbm/WinSystemGbmEGLContext.cpp
@@ -12,11 +12,52 @@
 #include "cores/VideoPlayer/DVDCodecs/DVDFactoryCodec.h"
 #include "cores/VideoPlayer/DVDCodecs/Video/DVDVideoCodec.h"
 #include "cores/VideoPlayer/VideoRenderers/RenderFactory.h"
+#include "utils/DRMHelpers.h"
+#include "utils/StringUtils.h"
 #include "utils/log.h"
 
+#include <set>
+#include <string>
+#include <vector>
+
 using namespace KODI::WINDOWING::GBM;
 using namespace KODI::WINDOWING::LINUX;
 
+namespace
+{
+// Window-capable EGL configs of the given API as "R10G10B10A2:AB30", for diagnostics.
+std::string DescribeWindowConfigs(EGLDisplay display, EGLint renderableType)
+{
+  EGLint count = 0;
+  if (display == EGL_NO_DISPLAY || eglGetConfigs(display, nullptr, 0, &count) != EGL_TRUE ||
+      count <= 0)
+    return "none";
+  std::vector<EGLConfig> configs(count);
+  if (eglGetConfigs(display, configs.data(), count, &count) != EGL_TRUE)
+    return "none";
+  std::set<std::string> described;
+  for (int i = 0; i < count; ++i)
+  {
+    EGLint surface = 0, renderable = 0, r = 0, g = 0, b = 0, a = 0, visual = 0;
+    eglGetConfigAttrib(display, configs[i], EGL_SURFACE_TYPE, &surface);
+    eglGetConfigAttrib(display, configs[i], EGL_RENDERABLE_TYPE, &renderable);
+    if (!(surface & EGL_WINDOW_BIT) || !(renderable & renderableType))
+      continue;
+    eglGetConfigAttrib(display, configs[i], EGL_RED_SIZE, &r);
+    eglGetConfigAttrib(display, configs[i], EGL_GREEN_SIZE, &g);
+    eglGetConfigAttrib(display, configs[i], EGL_BLUE_SIZE, &b);
+    eglGetConfigAttrib(display, configs[i], EGL_ALPHA_SIZE, &a);
+    eglGetConfigAttrib(display, configs[i], EGL_NATIVE_VISUAL_ID, &visual);
+    described.insert(StringUtils::Format("R{}G{}B{}A{}:{}", r, g, b, a,
+                                         DRMHELPERS::FourCCToString(visual)));
+  }
+  std::string list;
+  for (const auto& config : described)
+    list += (list.empty() ? "" : " ") + config;
+  return list.empty() ? "none" : list;
+}
+} // namespace
+
 bool CWinSystemGbmEGLContext::InitWindowSystemEGL(EGLint renderableType, EGLint apiType)
 {
   if (!m_DRM && !CWinSystemGbm::InitWindowSystem())
@@ -89,7 +130,8 @@ bool CWinSystemGbmEGLContext::ChooseEGLConfig(EGLint renderableType, int bitDept
                            return format.bpp >= 10 && format.bpp <= bitDepth;
                          return format.bpp <= 8;
                        });
-  std::ranges::sort(candidates, std::greater<>{}, &outputformat::bpp);
+  // Among formats of the same depth keep the order of the list (RGB before BGR).
+  std::ranges::stable_sort(candidates, std::greater<>{}, &outputformat::bpp);
 
   for (const auto& format : candidates)
   {
@@ -97,6 +139,17 @@ bool CWinSystemGbmEGLContext::ChooseEGLConfig(EGLint renderableType, int bitDept
       return true;
   }
 
+  // Say once why there is no high bit depth output: formats the planes lack, or no EGL config.
+  if (bitDepth > 8 && !m_highBitDepthReported)
+  {
+    m_highBitDepthReported = true;
+    std::string formats;
+    for (const auto& format : outputformats)
+      formats += StringUtils::Format(" {}:{}", DRMHELPERS::FourCCToString(format.drm),
+                                     format.active ? "plane" : "no-plane");
+    CLog::LogF(LOGWARNING, "no {}-bit output; output formats{}; EGL window configs: {}", bitDepth,
+               formats, DescribeWindowConfigs(m_eglContext.GetEGLDisplay(), renderableType));
+  }
   return false;
 }
 
diff --git a/xbmc/windowing/gbm/WinSystemGbmEGLContext.h b/xbmc/windowing/gbm/WinSystemGbmEGLContext.h
index d382c87..d0dd39f 100644
--- a/xbmc/windowing/gbm/WinSystemGbmEGLContext.h
+++ b/xbmc/windowing/gbm/WinSystemGbmEGLContext.h
@@ -61,6 +61,7 @@ protected:
   virtual int VideoOutputBitDepth(const VideoPicture* picture) const;
 
   EGLint m_renderableType{0};
+  bool m_highBitDepthReported{false};
 
   std::unique_ptr<KODI::UTILS::EGL::CEGLFence> m_eglFence;
 
diff --git a/xbmc/windowing/gbm/drm/DRMUtils.h b/xbmc/windowing/gbm/drm/DRMUtils.h
index 357ca86..3909673 100644
--- a/xbmc/windowing/gbm/drm/DRMUtils.h
+++ b/xbmc/windowing/gbm/drm/DRMUtils.h
@@ -141,7 +141,10 @@ private:
   std::vector<outputformat> m_output_formats = {{DRM_FORMAT_ARGB8888, 8, 8, false, {}},
                                                 {DRM_FORMAT_XRGB8888, 8, 0, false, {}},
                                                 {DRM_FORMAT_ARGB2101010, 10, 2, false, {}},
-                                                {DRM_FORMAT_XRGB2101010, 10, 0, false, {}}};
+                                                {DRM_FORMAT_XRGB2101010, 10, 0, false, {}},
+                                                // nvidia-drm offers 10 bits only in BGR order.
+                                                {DRM_FORMAT_ABGR2101010, 10, 2, false, {}},
+                                                {DRM_FORMAT_XBGR2101010, 10, 0, false, {}}};
 };
 
 } // namespace GBM
