From 702dd2ae99db3bb19cd3b9ae2a7897ccd67cb9ef Mon Sep 17 00:00:00 2001
From: Hades <15710513+hadesdevls@users.noreply.github.com>
Date: Sun, 27 Sep 2026 23:17:14 +0000
Subject: [PATCH] windowing/gbm: prefer the HDMI output with Dolby Vision
 Standard

A TV input set up for games (Quick Frame Transport on an LG C5) advertises
Dolby Vision Low-Latency only; an input set up for films advertises
Standard, which native Dolby Vision output needs. With a second HDMI
cable from the same graphics card to a second input, Windows can keep the
gaming input while Hades uses the other one without changing any TV
setting.

Among connected HDMI outputs, prefer the one whose display advertises
Dolby Vision Standard, then any HDMI output, then the first connected
output, as before. A monitor chosen in the settings is still honoured.
---
 xbmc/windowing/gbm/drm/DRMUtils.cpp | 16 ++++++++++++++--
 1 file changed, 14 insertions(+), 2 deletions(-)

diff --git a/xbmc/windowing/gbm/drm/DRMUtils.cpp b/xbmc/windowing/gbm/drm/DRMUtils.cpp
index f09bdf9..1e03287 100644
--- a/xbmc/windowing/gbm/drm/DRMUtils.cpp
+++ b/xbmc/windowing/gbm/drm/DRMUtils.cpp
@@ -12,6 +12,7 @@
 #include "settings/Settings.h"
 #include "settings/SettingsComponent.h"
 #include "utils/DRMHelpers.h"
+#include "utils/DisplayInfo.h"
 #include "utils/StringUtils.h"
 #include "utils/log.h"
 #include "windowing/GraphicContext.h"
@@ -718,8 +719,19 @@ bool CDRMUtils::FindConnector()
     // With several displays connected, prefer an HDMI output, where the TV normally is,
     // over DisplayPort monitors; otherwise the first connected output, as before.
     const auto usable = [](auto& conn) { return conn->GetEncoderId() > 0 && conn->IsConnected(); };
-    connector = std::ranges::find_if(m_connectors, [&usable](auto& conn)
-                                     { return usable(conn) && conn->GetType() == "HDMI-A"; });
+    const auto hdmi = [&usable](auto& conn) { return usable(conn) && conn->GetType() == "HDMI-A"; };
+    // With two HDMI cables to one TV (an input set up for games, another for films), prefer
+    // the output whose display advertises Dolby Vision Standard.
+    connector = std::ranges::find_if(m_connectors,
+                                     [&hdmi](auto& conn)
+                                     {
+                                       if (!hdmi(conn))
+                                         return false;
+                                       const auto info = UTILS::CDisplayInfo::Create(conn->GetEDID());
+                                       return info && info->SupportsStandardDolbyVision();
+                                     });
+    if (connector == m_connectors.end())
+      connector = std::ranges::find_if(m_connectors, hdmi);
     if (connector == m_connectors.end())
       connector = std::ranges::find_if(m_connectors, usable);
   }
