From ac6834a91f1bea3c7d0a20fbc34ec7e9395ab7b7 Mon Sep 17 00:00:00 2001
From: olympia <olympia@xbmc.org>
Date: Sun, 25 Oct 2026 22:28:35 +0100
Subject: [PATCH] [Video] Report art changes of every art type chosen in a row

Choosing art goes through the art types in a loop, and only the result
of the last type opened was returned. Saving a poster and then backing
out of the fanart browser reported no change, so the information dialog
and the Manage menu did not refresh the list for the saved poster. Any
art saved in the loop is now reported.
---
 xbmc/video/dialogs/GUIDialogVideoInfo.cpp | 6 ++++--
 1 file changed, 4 insertions(+), 2 deletions(-)

diff --git a/xbmc/video/dialogs/GUIDialogVideoInfo.cpp b/xbmc/video/dialogs/GUIDialogVideoInfo.cpp
index 33e6a4a..a740fbc 100644
--- a/xbmc/video/dialogs/GUIDialogVideoInfo.cpp
+++ b/xbmc/video/dialogs/GUIDialogVideoInfo.cpp
@@ -1866,9 +1866,11 @@ bool CGUIDialogVideoInfo::ChooseAndManageVideoItemArtwork(const std::shared_ptr<
       break;
 
     const std::string chosenArtType{chooser.GetArtType()};
-    result = ManageVideoItemArtwork(item, item->GetVideoInfoTag()->m_type, chosenArtType);
-    if (result)
+    if (ManageVideoItemArtwork(item, item->GetVideoInfoTag()->m_type, chosenArtType))
+    {
+      result = true;
       chooser.UpdateArtType(chosenArtType, item->GetArt(chosenArtType));
+    }
 
   } while (true);
 
