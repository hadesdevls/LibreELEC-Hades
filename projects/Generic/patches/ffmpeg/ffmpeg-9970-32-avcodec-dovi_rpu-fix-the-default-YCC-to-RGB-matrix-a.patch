From 5986d3031439c392d8517a0cca903264ed60c33e Mon Sep 17 00:00:00 2001
From: =?UTF-8?q?Kacper=20Michaj=C5=82ow?= <kasper93@gmail.com>
Date: Fri, 30 Oct 2026 08:05:07 +0100
Subject: [PATCH] avcodec/dovi_rpu: fix the default YCC to RGB matrix and
 offsets

The defaults of an RPU without display management metadata had the two
chroma coefficients of the green row with the wrong sign and the offsets
as 1/4 and 2, where ETSI GS CCM 001 clause 6.2.2 gives -1754 and -4383
and the offsets 1/16 and 1/2, as every stream carries them.

(cherry picked from commit 5986d3031439c392d8517a0cca903264ed60c33e)
---
 libavcodec/dovi_rpu.c | 10 +++++-----
 1 file changed, 5 insertions(+), 5 deletions(-)

diff --git a/libavcodec/dovi_rpu.c b/libavcodec/dovi_rpu.c
index f19c1922f16a..99765b9f773c 100644
--- a/libavcodec/dovi_rpu.c
+++ b/libavcodec/dovi_rpu.c
@@ -99,16 +99,16 @@ const AVDOVIColorMetadata ff_dovi_color_default = {
         {     0, 8192 },
         { 14742, 8192 },
         {  9575, 8192 },
-        {  1754, 8192 },
-        {  4383, 8192 },
+        { -1754, 8192 },
+        { -4383, 8192 },
         {  9575, 8192 },
         { 17372, 8192 },
         {     0, 8192 },
     },
     .ycc_to_rgb_offset = {
-        { 1, 4 },
-        { 2, 1 },
-        { 2, 1 },
+        { 1, 16 },
+        { 1,  2 },
+        { 1,  2 },
     },
     .rgb_to_lms_matrix = {
         {  5845, 16384 },
