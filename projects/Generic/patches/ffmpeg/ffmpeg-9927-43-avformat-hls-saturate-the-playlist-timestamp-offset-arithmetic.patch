From 857ee5f9c5e55689f480a2dca089fece89f029f7 Mon Sep 17 00:00:00 2001
From: Michael Niedermayer <michael@niedermayer.cc>
Date: Mon, 12 Oct 2026 02:11:45 +0200
Subject: [PATCH] avformat/hls: saturate the playlist timestamp offset
 arithmetic

Fixes: signed integer overflow
Fixes: 2PuIAHF3wU0b
Regression since: e27ad5760c
Found during triage of the review of https://code.ffmpeg.org/FFmpeg/FFmpeg/pulls/24873
Signed integer overflow Replicated through UnModified FFmpeg with UBSAN

(cherry picked from commit 857ee5f9c5e55689f480a2dca089fece89f029f7)

[Hades: adapted to 9.0.2's hls.c. Of the seven additions upstream saturates, 9.0.2
has four: the catch-up seek_timestamp in recheck_discard_flags() and the per playlist
seek threshold in hls_read_seek() take upstream's hunks unchanged; the subtraction of
the segment durations of an EVENT playlist and the ts_offset of a playlist in
hls_read_packet() are the same change on 9.0.2's lines. The other three (lowering
first_timestamp by a delta, shifting the ts_offset of the other playlists by it, and
subtracting one segment duration from the seek threshold) are in code that 9.0.2 does
not have, so they are not here.]
---
 libavformat/hls.c | 10 +++++-----
 1 file changed, 5 insertions(+), 5 deletions(-)

diff --git a/libavformat/hls.c b/libavformat/hls.c
index 4368d85..e40fd35 100644
--- a/libavformat/hls.c
+++ b/libavformat/hls.c
@@ -2604,8 +2604,8 @@ static int recheck_discard_flags(AVFormatContext *s, int first)
             pls->pb.pub.eof_reached = 0;
             if (c->cur_timestamp != AV_NOPTS_VALUE) {
                 /* catch up */
-                pls->seek_timestamp = c->cur_timestamp +
-                    (pls->ts_offset != AV_NOPTS_VALUE ? pls->ts_offset : 0);
+                pls->seek_timestamp = av_sat_add64(c->cur_timestamp,
+                    pls->ts_offset != AV_NOPTS_VALUE ? pls->ts_offset : 0);
                 pls->seek_flags = AVSEEK_FLAG_ANY;
                 pls->seek_stream_index = -1;
             }
@@ -2731,7 +2731,7 @@ static int hls_read_packet(AVFormatContext *s, AVPacket *pkt)
                         /* EVENT playlists preserve all segments from the start */
                         if (pls->type == PLS_TYPE_EVENT)
                             for (int64_t k = 0; k < seg_idx && k < pls->n_segments; k++)
-                                ts -= pls->segments[k]->duration;
+                                ts = av_sat_sub64(ts, pls->segments[k]->duration);
 
                         if (c->first_timestamp == AV_NOPTS_VALUE) {
                             c->first_timestamp = ts;
@@ -2745,7 +2745,7 @@ static int hls_read_packet(AVFormatContext *s, AVPacket *pkt)
                                             AV_TIME_BASE_Q, st->time_base);
                                 }
                         }
-                        pls->ts_offset = ts - c->first_timestamp;
+                        pls->ts_offset = av_sat_sub64(ts, c->first_timestamp);
                     }
                 }
 
@@ -2967,7 +2967,7 @@ static int hls_read_seek(AVFormatContext *s, int stream_index,
          * have different DTS baselines, so translate the threshold onto this
          * playlist's own baseline using its captured offset. */
         if (pls->ts_offset != AV_NOPTS_VALUE)
-            pls->seek_timestamp = seek_timestamp + pls->ts_offset;
+            pls->seek_timestamp = av_sat_add64(seek_timestamp, pls->ts_offset);
         else
             pls->seek_timestamp = seek_timestamp;
         pls->seek_flags = flags;
-- 
