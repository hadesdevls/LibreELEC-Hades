From 6d898e0c1726afa9cb47e0835202e69d36c2d059 Mon Sep 17 00:00:00 2001
From: Michael Niedermayer <michael@niedermayer.cc>
Date: Wed, 11 Nov 2026 19:36:54 +0100
Subject: [PATCH] avformat/http: reject CR and LF in the hostname

Fixes: CRLF injection
Fixes: eiIHGT2jJznc
Fixes: proxy_host_crlf_poc.py
CRLF injection Replicated through UnModified FFmpeg with a local TCP listener

Found during triage of the security report iUFdqPjbigVZ (ZDI-CAN-35984)

(cherry picked from commit 6d898e0c1726afa9cb47e0835202e69d36c2d059)
---
 libavformat/http.c | 2 ++
 1 file changed, 2 insertions(+)

diff --git a/libavformat/http.c b/libavformat/http.c
index b7d974d73ec0..44528e47d0de 100644
--- a/libavformat/http.c
+++ b/libavformat/http.c
@@ -246,6 +246,8 @@ static int http_open_cnx_internal(URLContext *h, AVDictionary **options)
     av_url_split(proto, sizeof(proto), auth, sizeof(auth),
                  hostname, sizeof(hostname), &port,
                  path1, sizeof(path1), s->location);
+    if (strpbrk(hostname, "\r\n"))
+        return AVERROR(EINVAL);
 
     av_freep(&s->host);
     s->host = av_strdup(hostname);
