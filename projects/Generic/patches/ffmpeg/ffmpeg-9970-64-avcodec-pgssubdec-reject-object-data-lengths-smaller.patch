From 73e91f7f41172e0b3b919e0cb53586bd7e5c678a Mon Sep 17 00:00:00 2001
From: Michael Niedermayer <michael@niedermayer.cc>
Date: Mon, 16 Nov 2026 19:10:29 +0100
Subject: [PATCH] avcodec/pgssubdec: reject object data lengths smaller than
 the dimension fields

The object data length includes the 4 bytes of width and height.
A smaller length wrapped around and was only rejected by the
allocation failing with ENOMEM.

(cherry picked from commit 73e91f7f41172e0b3b919e0cb53586bd7e5c678a)
---
 libavcodec/pgssubdec.c | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/libavcodec/pgssubdec.c b/libavcodec/pgssubdec.c
index 354a29716241..1300bdf83928 100644
--- a/libavcodec/pgssubdec.c
+++ b/libavcodec/pgssubdec.c
@@ -247,7 +247,7 @@ static int parse_object_segment(AVCodecContext *avctx,
     PGSSubObject *object;
 
     uint8_t sequence_desc;
-    unsigned int rle_bitmap_len, width, height;
+    int rle_bitmap_len, width, height;
     int id;
 
     if (buf_size <= 4)
