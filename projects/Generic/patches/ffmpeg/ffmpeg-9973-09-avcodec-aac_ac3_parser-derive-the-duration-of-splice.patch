From 37f5b5defed77c742ce053b7037b72f5eeb383e3 Mon Sep 17 00:00:00 2001
From: Romain Beauxis <romain.beauxis@gmail.com>
Date: Wed, 4 Nov 2026 15:14:22 -0600
Subject: [PATCH] avcodec/aac_ac3_parser: derive the duration of spliced ADTS
 frames

The parser sets the duration of an ADTS frame that does not match the probed stream from the sample count and sample rate in its header, including frames completed from buffered input.

It warns when this happens, since the stream changed its frame duration mid-stream.

The splice test reference now gives each section its own frame duration.

[Hades: backport to 9.1 without tests/ref/fate/aac-adts-splice: FATE files of tests that master added after 9.1 (or, for libavformat/tests/.gitignore, a file the release tarball does not have).]

(cherry picked from commit 37f5b5defed77c742ce053b7037b72f5eeb383e3)
Upstream: https://github.com/FFmpeg/FFmpeg/commit/37f5b5defed77c742ce053b7037b72f5eeb383e3
---
 libavcodec/aac_ac3_parser.c | 42 +++++++++++++++++++++++++++++++++++++
 libavcodec/aac_ac3_parser.h |  5 +++++
 2 files changed, 47 insertions(+)

diff --git a/libavcodec/aac_ac3_parser.c b/libavcodec/aac_ac3_parser.c
index 51c8012..0cfb0bc 100644
--- a/libavcodec/aac_ac3_parser.c
+++ b/libavcodec/aac_ac3_parser.c
@@ -29,6 +29,46 @@
 #include "ac3_parser_internal.h"
 #include "adts_header.h"
 
+#if CONFIG_AAC_PARSER
+/// divisible by every ADTS sampling rate
+#define ADTS_RATES_LCM 28224000
+
+/**
+ * Set the duration of an ADTS frame that does not match the probed stream,
+ * as when two streams are spliced together.
+ *
+ * The ratio of the ADTS sample count to the ADTS sample rate is the frame
+ * duration even for HE-AAC, so it is expressed in units of
+ * avctx->sample_rate and the remainder carried to the next frame.
+ */
+static void set_spliced_adts_duration(AVCodecParserContext *s1,
+                                      AVCodecContext *avctx,
+                                      const AACADTSHeaderInfo *hdr)
+{
+    AACAC3ParseContext *s = s1->priv_data;
+
+    if (avctx->frame_size <= 0 || avctx->sample_rate <= 0)
+        return;
+
+    int64_t num  = (int64_t)hdr->samples * avctx->sample_rate;
+    int mismatch = num / hdr->num_aac_frames !=
+                   (int64_t)avctx->frame_size * hdr->sample_rate;
+
+    if (mismatch) {
+        if (!s->spliced)
+            av_log(avctx, AV_LOG_WARNING,
+                   "ADTS frame duration changed mid-stream to "
+                   "%d samples at %d Hz\n", hdr->samples, hdr->sample_rate);
+        num = num * (ADTS_RATES_LCM / hdr->sample_rate) + s->duration_rem;
+        s1->duration    = num / ADTS_RATES_LCM;
+        s->duration_rem = num % ADTS_RATES_LCM;
+    } else {
+        s1->duration = 0;
+    }
+    s->spliced = mismatch;
+}
+#endif
+
 int ff_aac_ac3_parse(AVCodecParserContext *s1,
                      AVCodecContext *avctx,
                      const uint8_t **poutbuf, int *poutbuf_size,
@@ -52,6 +92,7 @@ get_next:
             if(s->remaining_size && !s->need_next_header){
                 i= s->remaining_size;
                 s->remaining_size = 0;
+                got_frame = avctx->codec_id == AV_CODEC_ID_AAC;
             }else{ //we need a header first
                 len=0;
                 for(i=s->remaining_size; i<buf_size; i++){
@@ -156,6 +197,7 @@ get_next:
                 avctx->profile = hdr.object_type - 1;
             /* ADTS does not support USAC */
             s1->key_frame = 1;
+            set_spliced_adts_duration(s1, avctx, &hdr);
             bit_rate = hdr.bit_rate;
 #endif
         }
diff --git a/libavcodec/aac_ac3_parser.h b/libavcodec/aac_ac3_parser.h
index e3259d1..0271801 100644
--- a/libavcodec/aac_ac3_parser.h
+++ b/libavcodec/aac_ac3_parser.h
@@ -39,6 +39,11 @@ typedef struct AACAC3ParseContext {
 
     int need_next_header;
     int frame_number;
+    /// remainder of the spliced ADTS frame durations, in units of
+    /// 1 / 28224000 of an avctx->sample_rate sample
+    int64_t duration_rem;
+    /// whether the last ADTS frame did not match the probed stream
+    int spliced;
 } AACAC3ParseContext;
 
 int ff_aac_ac3_parse(AVCodecParserContext *s1,
