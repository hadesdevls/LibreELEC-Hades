From 4dfdbc94c6ca4c38c9f2111f44e6f18e76235ae5 Mon Sep 17 00:00:00 2001
From: Romain Beauxis <romain.beauxis@gmail.com>
Date: Thu, 19 Nov 2026 07:55:57 -0600
Subject: [PATCH] avformat/mov: count the samples an edit list skips at the
 sample rate

mov_fix_index counted them in the track's clock, which for HE-AAC with
explicit SBR is often the core rate, so an edit starting mid-packet
kept the samples before it.

Tracks with several sample descriptions are left alone: the sample rate
may come from one the packets do not use.

[Hades: backport to 9.1 without tests/ref/fate/mov-aac-he-core-rate-mid-packet, tests/ref/fate/mov-aac-he-core-rate-priming: FATE files of tests that master added after 9.1 (or, for libavformat/tests/.gitignore, a file the release tarball does not have).]

(cherry picked from commit 4dfdbc94c6ca4c38c9f2111f44e6f18e76235ae5)
Upstream: https://github.com/FFmpeg/FFmpeg/commit/4dfdbc94c6ca4c38c9f2111f44e6f18e76235ae5
---
 libavformat/mov.c | 9 +++++++++
 1 file changed, 9 insertions(+)

diff --git a/libavformat/mov.c b/libavformat/mov.c
index ec5f7db..b15708f 100644
--- a/libavformat/mov.c
+++ b/libavformat/mov.c
@@ -4841,6 +4841,15 @@ truncated:
 
     // Update av stream length, if it ends up shorter than the track's media duration
     st->duration = FFMIN(st->duration, edit_list_dts_entry_end - start_dts);
+    // The skipped samples are counted in the track's clock. With explicit SBR
+    // signalling, HE-AAC often keeps it at the core rate, half the output
+    // rate. A sample rate below the clock may be the core rate of implicit
+    // SBR. With several sample descriptions, the rate may come from one the
+    // packets do not use.
+    if (st->codecpar->codec_id == AV_CODEC_ID_AAC && msc->stsd_count == 1 &&
+        st->codecpar->sample_rate > msc->time_scale && msc->time_scale > 0)
+        sti->skip_samples = FFMIN(av_rescale(sti->skip_samples, st->codecpar->sample_rate,
+                                             msc->time_scale), INT_MAX);
     st->codecpar->initial_padding = sti->skip_samples;
 
     // Free the old index and the old CTTS structures
