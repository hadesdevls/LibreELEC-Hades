From: Hades <15710513+hadesdevls@users.noreply.github.com>
Date: Wed, 28 Oct 2026 20:40:00 +0000
Subject: [PATCH] avcodec/hevc/parser: give a picture the time of the PES of
 its first slice when nothing else can have it

The HEVC parser gives a picture the time of the PES that the picture
begins in. When a muxer puts the parameter sets and SEI of a picture in a
PES of their own without a time and the slices of the picture in the next
PES, with the picture's time, the picture comes out with no time at all:
the time of the second PES is never used, because no picture begins in it.
At the start of a stream (or after a seek) that is the first picture the
player gets.

The muxer's intention is plain in that case: a time refers to the first
access unit that begins in its PES (ISO/IEC 13818-1, 2.4.3.7), and a PES in
which no access unit begins has none to refer to but the one it continues.
So when a picture got no time from the PES it began in, and its first slice
begins in a later PES that has a time, the parser notes that time; once the
picture is complete, the picture takes it if the picture goes on to the end
of that PES or beyond, that is, if no other access unit begins in it. When
one does, the time is that access unit's, as before, and the picture stays
without one, as before. A picture that has a time from the PES it began in
keeps it, and a picture whose slices carry no time stays without one: no
time is made up.

Only the framing of a stream that is not split into frames by its
container changes (MPEG-TS, raw HEVC); MP4 and Matroska frames are complete
and their path does not run this code.

The idea is from the CroqueMr fork (ffmpeg-9900-06, his issue 26: an ISO
that starts on a black screen); written anew, with the rule that keeps the
time of the next access unit away from the picture before it.
---
 libavcodec/hevc/parser.c | 54 ++++++++++++++++++++++++++++++++++++++++++++++
 1 file changed, 54 insertions(+)

diff --git a/libavcodec/hevc/parser.c b/libavcodec/hevc/parser.c
--- a/libavcodec/hevc/parser.c
+++ b/libavcodec/hevc/parser.c
@@ -51,6 +51,13 @@ typedef struct HEVCParserContext {
 
     int poc;
     int pocTid0;
+
+    /* the time of the PES that the first slice of the picture being
+     * framed begins in (hevc_slice_clock()) */
+    int     slice_clock;
+    int64_t slice_pts;
+    int64_t slice_dts;
+    int64_t slice_pes_end;
 } HEVCParserContext;
 
 static int hevc_parse_slice_header(AVCodecParserContext *s, H2645NAL *nal,
@@ -252,6 +259,40 @@ static int parse_nal_units(AVCodecParserContext *s, const uint8_t *buf,
     return -1;
 }
 
+/**
+ * Note the time of the PES that the first slice of a picture begins in, at
+ * index of the current buffer, when the picture has no time from the PES that
+ * it began in (its parameter sets or SEI came in a PES of their own without a
+ * time) and the slice begins in a later PES that has one. hevc_parse() gives
+ * the picture that time once the picture is complete, if no other access unit
+ * begins in that PES: a time refers to the first access unit that begins in
+ * its PES (ISO/IEC 13818-1, 2.4.3.7), so when one does, the time is its own.
+ */
+static void hevc_slice_clock(AVCodecParserContext *s, int index)
+{
+    HEVCParserContext *ctx = s->priv_data;
+    int64_t pos = s->cur_offset + index;
+
+    ctx->slice_clock = 0;
+    if (s->pts != AV_NOPTS_VALUE || s->dts != AV_NOPTS_VALUE)
+        return;
+
+    for (int i = 0; i < AV_PARSER_PTS_NB; i++) {
+        /* a PES that began after the picture did, and holds the slice */
+        if (s->cur_frame_offset[i] > s->next_frame_offset &&
+            s->cur_frame_offset[i] <= pos && pos < s->cur_frame_end[i]) {
+            if (s->cur_frame_pts[i] == AV_NOPTS_VALUE &&
+                s->cur_frame_dts[i] == AV_NOPTS_VALUE)
+                return;
+            ctx->slice_clock   = 1;
+            ctx->slice_pts     = s->cur_frame_pts[i];
+            ctx->slice_dts     = s->cur_frame_dts[i];
+            ctx->slice_pes_end = s->cur_frame_end[i];
+            return;
+        }
+    }
+}
+
 /**
  * Find the end of the current frame in the bitstream.
  * @return the position of the first byte of the next frame, or END_NOT_FOUND
@@ -292,6 +333,8 @@ static int hevc_find_frame_end(AVCodecParserContext *s, const uint8_t *buf,
             if (first_slice_segment_in_pic_flag) {
                 if (!pc->frame_start_found) {
                     pc->frame_start_found = 1;
+                    // the start code of the slice
+                    hevc_slice_clock(s, i - 5);
                 } else { // First slice of next frame found
                     pc->frame_start_found = 0;
                     if (!((pc->state64 >> 6 * 8) & 0xFF))
@@ -331,6 +374,17 @@ static int hevc_parse(AVCodecParserContext *s, AVCodecContext *avctx,
             *poutbuf_size = 0;
             return buf_size;
         }
+        if (ctx->slice_clock) {
+            /* the picture ends where the next one begins, or at the end of
+             * the stream (a flush, with END_NOT_FOUND) */
+            int64_t end = s->cur_offset + (next == END_NOT_FOUND ? 0 : next);
+            if (s->pts == AV_NOPTS_VALUE && s->dts == AV_NOPTS_VALUE &&
+                end >= ctx->slice_pes_end) {
+                s->pts = ctx->slice_pts;
+                s->dts = ctx->slice_dts;
+            }
+            ctx->slice_clock = 0;
+        }
     }
 
     is_dummy_buf &= (dummy_buf == buf);
-- 
2.53.0

