From def599cc17d1d250172f2afc7626733423b07a6d Mon Sep 17 00:00:00 2001
From: =?UTF-8?q?Kacper=20Michaj=C5=82ow?= <kasper93@gmail.com>
Date: Wed, 28 Oct 2026 04:09:54 +0100
Subject: [PATCH] avformat/hls: parse the EXT-X-START attributes in any order
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

TIME-OFFSET was only read as the first attribute of EXT-X-START, so a
tag with PRECISE first was ignored. RFC 8216 4.2 does not order the
pairs of an attribute-list. Parse it with ff_parse_key_value() as the
other attribute lists are.

Signed-off-by: Kacper Michajłow <kasper93@gmail.com>

[Hades: backport to 9.1 without tests/fate/demux.mak, tests/ref/fate/hls-start-master-demux: FATE files of tests that master added after 9.1 (or, for libavformat/tests/.gitignore, a file the release tarball does not have).]

(cherry picked from commit def599cc17d1d250172f2afc7626733423b07a6d)
Upstream: https://github.com/FFmpeg/FFmpeg/commit/def599cc17d1d250172f2afc7626733423b07a6d
---
 libavformat/hls.c | 21 ++++++++++++++++++---
 1 file changed, 18 insertions(+), 3 deletions(-)

diff --git a/libavformat/hls.c b/libavformat/hls.c
index 27870b7..a350c9a 100644
--- a/libavformat/hls.c
+++ b/libavformat/hls.c
@@ -594,6 +594,20 @@ static void handle_init_section_args(void *context, const char *key,
     }
 }
 
+struct start_info {
+    char time_offset[MAX_FIELD_LEN];
+};
+
+static void handle_start_args(void *context, const char *key,
+                              int key_len, char **dest, int *dest_len)
+{
+    struct start_info *info = context;
+    if (!strncmp(key, "TIME-OFFSET=", key_len)) {
+        *dest     =        info->time_offset;
+        *dest_len = sizeof(info->time_offset);
+    }
+}
+
 struct rendition_info {
     char type[16];
     char uri[MAX_URL_SIZE];
@@ -1158,9 +1172,10 @@ static int parse_playlist(HLSContext *c, const char *url,
             }
 
         } else if (av_strstart(line, "#EXT-X-START:", &ptr)) {
-            const char *time_offset_value = NULL;
-            if (av_strstart(ptr, "TIME-OFFSET=", &time_offset_value)) {
-                double offset = strtod(time_offset_value, NULL) * AV_TIME_BASE;
+            struct start_info info = {0};
+            ff_parse_key_value(ptr, handle_start_args, &info);
+            if (info.time_offset[0]) {
+                double offset = strtod(info.time_offset, NULL) * AV_TIME_BASE;
                 if (offset >= -0x1p63 && offset < 0x1p63) {
                     start_time_offset = offset;
                     time_offset_flag  = 1;
