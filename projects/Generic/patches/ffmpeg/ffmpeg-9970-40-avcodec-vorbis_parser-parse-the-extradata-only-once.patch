From 90f5e61a1da2dcc0050169af8ca593530f26071b Mon Sep 17 00:00:00 2001
From: Michael Niedermayer <michael@niedermayer.cc>
Date: Thu, 5 Nov 2026 03:41:23 +0100
Subject: [PATCH] avcodec/vorbis_parser: parse the extradata only once

Fixes: Timeout
Fixes: nsq7AyzgMo4U
Fixes: AISLE-2026-0150-00507
Timeout Replicated through UnModified FFmpeg

Found-by: Joshua Rogers (AISLE)
(cherry picked from commit 90f5e61a1da2dcc0050169af8ca593530f26071b)
---
 libavcodec/vorbis_parser.c | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/libavcodec/vorbis_parser.c b/libavcodec/vorbis_parser.c
index 8070004e61ae..9102ae0bce61 100644
--- a/libavcodec/vorbis_parser.c
+++ b/libavcodec/vorbis_parser.c
@@ -309,7 +309,7 @@ static int vorbis_parse(AVCodecParserContext *s1, AVCodecContext *avctx,
     AVVorbisParseContext *s = s1->priv_data;
     int duration;
 
-    if (!s->valid_extradata && avctx->extradata && avctx->extradata_size) {
+    if (!s->extradata_parsed && avctx->extradata && avctx->extradata_size) {
         ff_vorbis_parse_init(s, avctx->extradata, avctx->extradata_size);
     }
     if (!s->valid_extradata)
