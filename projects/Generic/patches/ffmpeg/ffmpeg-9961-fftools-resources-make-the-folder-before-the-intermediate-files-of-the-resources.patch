From 0cc15498a45bd90ef54394efcbeda006c4f4bcef Mon Sep 17 00:00:00 2001
From: Hades <15710513+hadesdevls@users.noreply.github.com>
Date: Thu, 19 Nov 2026 05:58:18 +0000
Subject: [PATCH] fftools/resources: make the folder before the intermediate
 files of the resources

The minified CSS and the gzip files of the resources of the ffmpeg program are made in
fftools/resources of the build folder. That folder is an order-only prerequisite of the objects of
the program only (fftools/Makefile, DOFFTOOL), so with parallel jobs in a build out of the source
tree, make could start the first file of the chain of graph.css.o (graph.css.min) before the folder
existed: "cannot create fftools/resources/graph.css.min: Directory nonexistent", and the build
stopped. Seen once in the host build of a LibreELEC Hades image (make -j32); it depends on the order
of the jobs.

Now the first intermediate file of each chain (%.css.min, %.html.gz) has the folder as an order-only
prerequisite too (its rule is in OUTDIRS, ffbuild of the top Makefile). Nothing that is built
changes.
---
 fftools/resources/Makefile | 5 +++++
 1 file changed, 5 insertions(+)

diff --git a/fftools/resources/Makefile b/fftools/resources/Makefile
index 3c93648..436f435 100644
--- a/fftools/resources/Makefile
+++ b/fftools/resources/Makefile
@@ -13,6 +13,11 @@ RESOBJS +=                         \
     fftools/resources/graph.css.o  \
 
 
+# The intermediate files of the resources (minified CSS, gzip) are made in this folder too, and before the objects
+# whose order-only prerequisite makes it: with parallel jobs out of the source tree, the first of them could come
+# first ("cannot create fftools/resources/graph.css.min: Directory nonexistent")
+$(RESOBJS:%.css.o=%.css.min) $(RESOBJS:%.html.o=%.html.gz): | fftools/resources
+
 $(RESOBJS): CCDEP       =
 $(RESOBJS): CC_DEPFLAGS =
 
