From 9b8e45b3ba3f2b515119aaf9d620f49e0b807419 Mon Sep 17 00:00:00 2001
From: Michael Niedermayer <michael@niedermayer.cc>
Date: Sat, 19 Sep 2026 20:59:22 +0200
Subject: [PATCH] avformat/http: match cookie paths case-sensitively

RFC 6265 section 5.1.4
---
 libavformat/http.c | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/libavformat/http.c b/libavformat/http.c
index 686aa6b7b236..cc4bb606f860 100644
--- a/libavformat/http.c
+++ b/libavformat/http.c
@@ -1492,7 +1492,7 @@ static int get_cookies(HTTPContext *s, char **cookies, const char *path)
         e = av_dict_get(cookie_params, "path", NULL, 0);
         if (e) {
             size_t len = strlen(e->value);
-            if (av_strncasecmp(path, e->value, len) ||
+            if (strncmp(path, e->value, len) ||
                 (len && path[len] && path[len] != '/' && path[len] != '?' &&
                  e->value[len - 1] != '/'))
                 goto skip_cookie;
