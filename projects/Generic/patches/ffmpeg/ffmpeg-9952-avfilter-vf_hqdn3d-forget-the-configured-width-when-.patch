From ca9aa7edd60622d8548114cbf09f165d358e5705 Mon Sep 17 00:00:00 2001
From: Michael Niedermayer <michael@niedermayer.cc>
Date: Tue, 13 Oct 2026 06:25:02 +0200
Subject: [PATCH] avfilter/vf_hqdn3d: forget the configured width when the
 buffers are freed

Fixes: WDZyf7w7BNU1
Fixes: NULL pointer dereference
NULL dereference after a failed allocation Replicated through API with ASAN
Found during the review of https://code.ffmpeg.org/FFmpeg/FFmpeg/pulls/24765
---
 libavfilter/vf_hqdn3d.c | 1 +
 1 file changed, 1 insertion(+)

diff --git a/libavfilter/vf_hqdn3d.c b/libavfilter/vf_hqdn3d.c
index 80495aaa27..3b46b6d4f8 100644
--- a/libavfilter/vf_hqdn3d.c
+++ b/libavfilter/vf_hqdn3d.c
@@ -254,6 +254,7 @@ static int config_input(AVFilterLink *inlink)
     int i, depth;
 
     uninit(inlink->dst);
+    s->width = 0;
 
     s->hsub  = desc->log2_chroma_w;
     s->vsub  = desc->log2_chroma_h;
-- 
2.53.0

