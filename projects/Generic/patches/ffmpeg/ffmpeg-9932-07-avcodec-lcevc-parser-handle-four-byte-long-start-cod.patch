From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: James Almer <jamrial@gmail.com>
Date: Wed, 28 Oct 2026 14:58:07 -0300
Subject: [PATCH] avcodec/lcevc_parser: handle four byte long start codes

Start codes can be 0x000001 or 0x00000001, but lcevc_find_frame_end() was
only looking for the former. This resulted in a stray zero being included in
the following packet.

Signed-off-by: James Almer <jamrial@gmail.com>
(cherry picked from commit 4611078b40931f0a42056f78b9e37d02f905b881)
---
 libavcodec/lcevc_parser.c | 8 ++++----
 1 file changed, 4 insertions(+), 4 deletions(-)

diff --git a/libavcodec/lcevc_parser.c b/libavcodec/lcevc_parser.c
index ce1635e..90e7b22 100644
--- a/libavcodec/lcevc_parser.c
+++ b/libavcodec/lcevc_parser.c
@@ -51,12 +51,12 @@ static int lcevc_find_frame_end(AVCodecParserContext *s, const uint8_t *buf,
     for (int i = 0; i < buf_size; i++) {
         int nut;
 
-        pc->state = (pc->state << 8) | buf[i];
+        pc->state64 = (pc->state64 << 8) | buf[i];
 
-        if (((pc->state >> 8) & 0xFFFFFF) != START_CODE)
+        if (((pc->state64 >> 24) & 0xFFFFFF) != START_CODE)
             continue;
 
-        nut = (pc->state >> 1) & 0x1F;
+        nut = (pc->state64 >> 17) & 0x1F;
 
         // Beginning of access unit
         if (nut == LCEVC_IDR_NUT || nut == LCEVC_NON_IDR_NUT) {
@@ -64,7 +64,7 @@ static int lcevc_find_frame_end(AVCodecParserContext *s, const uint8_t *buf,
                 pc->frame_start_found = 1;
             else {
                 pc->frame_start_found = 0;
-                return i - 3;
+                return i - (5 + !((pc->state64 >> 48) & 0xFF));
             }
         }
     }
