From 61362812fd2ad9c76a96334c89ff99d1d35f58df Mon Sep 17 00:00:00 2001
From: Michael Niedermayer <michael@niedermayer.cc>
Date: Wed, 11 Nov 2026 18:40:21 +0100
Subject: [PATCH] avformat/mpegts: free a PESContext with its filter unless the
 stream owns it

Fixes: double free
Fixes: fHugfEQx8Ec0
Fixes: ffmpeg-n902-pmt-move-retype-20261027.ts
Double free Replicated through UnModified FFmpeg with ASAN

Found-by: Min Kang
(cherry picked from commit 61362812fd2ad9c76a96334c89ff99d1d35f58df)
---
 libavformat/mpegts.c | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/libavformat/mpegts.c b/libavformat/mpegts.c
index 3d773e7daf7c..0f72ee79e031 100644
--- a/libavformat/mpegts.c
+++ b/libavformat/mpegts.c
@@ -600,7 +600,7 @@ static void mpegts_close_filter(MpegTSContext *ts, MpegTSFilter *filter)
         av_buffer_unref(&pes->buffer);
         /* referenced private data will be freed later in
          * avformat_close_input (pes->st->priv_data == pes) */
-        if (!pes->st || pes->merged_st || !pes->st->priv_data) {
+        if (!pes->st || pes->st->priv_data != pes) {
             av_freep(&filter->u.pes_filter.opaque);
         }
     }
