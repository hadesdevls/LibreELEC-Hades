From 1ab2694560f75eadcf23f33718a737d0ec4bfeca Mon Sep 17 00:00:00 2001
From: Michael Niedermayer <michael@niedermayer.cc>
Date: Tue, 17 Nov 2026 00:34:44 +0100
Subject: [PATCH] avcodec/hevc/hevcdec: reject slices of a picture that is not
 the current one

NULL pointer dereference Replicated through UnModified FFmpeg with ASAN

Fixes: NULL pointer dereference
Fixes: 580179382/clusterfuzz-testcase-minimized-ffmpeg_AV_CODEC_ID_HEVC_fuzzer-5261322888216576
Fixes: 580320486/clusterfuzz-testcase-minimized-ffmpeg_AV_CODEC_ID_HEVC_fuzzer-6478957072154624
Fixes: SP0JBx1mfohj
Regression since: eedf8f0165fe6523be692c5a91ebf6744808335d

Found-by: continuous fuzzing process https://github.com/google/oss-fuzz/tree/master/projects/ffmpeg
Signed-off-by: Michael Niedermayer <michael@niedermayer.cc>
(cherry picked from commit 1ab2694560f75eadcf23f33718a737d0ec4bfeca)
---
 libavcodec/hevc/hevcdec.c | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/libavcodec/hevc/hevcdec.c b/libavcodec/hevc/hevcdec.c
index 777dd6d60cf1..14ab78cece59 100644
--- a/libavcodec/hevc/hevcdec.c
+++ b/libavcodec/hevc/hevcdec.c
@@ -3588,7 +3588,7 @@ static int decode_slice(HEVCContext *s, unsigned nal_idx, GetBitContext *gb)
         ret = hevc_frame_start(s, l, nal_idx);
         if (ret < 0)
             return ret;
-    } else if (!l->cur_frame) {
+    } else if (!l->cur_frame || l->cur_frame != s->cur_frame) {
         av_log(s->avctx, AV_LOG_ERROR, "First slice in a frame missing.\n");
         return AVERROR_INVALIDDATA;
     }
