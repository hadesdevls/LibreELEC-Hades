new file mode 100644
index 0000000..a8effd8
--- /dev/null
+++ b/libavcodec/hevc/baselayer.h
@@ -0,0 +1,162 @@
+/*
+ * HEVC decoder: the base layer of a multilayer stream decoded by a separate decoder
+ *
+ * This file is part of FFmpeg.
+ *
+ * FFmpeg is free software; you can redistribute it and/or
+ * modify it under the terms of the GNU Lesser General Public
+ * License as published by the Free Software Foundation; either
+ * version 2.1 of the License, or (at your option) any later version.
+ *
+ * FFmpeg is distributed in the hope that it will be useful,
+ * but WITHOUT ANY WARRANTY; without even the implied warranty of
+ * MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the GNU
+ * Lesser General Public License for more details.
+ *
+ * You should have received a copy of the GNU Lesser General Public
+ * License along with FFmpeg; if not, write to the Free Software
+ * Foundation, Inc., 51 Franklin Street, Fifth Floor, Boston, MA 02110-1301 USA
+ */
+
+#ifndef AVCODEC_HEVC_BASELAYER_H
+#define AVCODEC_HEVC_BASELAYER_H
+
+#include "libavutil/frame.h"
+
+#include "libavcodec/packet.h"
+
+/*
+ * When more than one layer of a stream is decoded (MV-HEVC), the pictures of
+ * the base layer may come from a second, separate HEVC decoder that decodes
+ * that layer alone: on the hardware device of AVCodecContext.hw_device_ctx
+ * where the caller set one (no hardware decoder takes the layers above the base
+ * on most devices, but most take the base layer, which is plain Main or Main 10
+ * HEVC), in software otherwise. This decoder then decodes the other layers,
+ * whose inter-layer reference is the separate decoder's picture of the same
+ * access unit, copied to memory. Its own decoding of the base layer is only the
+ * part every layer above it depends on: parameter sets, slice headers,
+ * reference picture sets, POC, the DPB and output. Every picture the caller gets
+ * is the same as it would be with every layer decoded here, as long as the
+ * separate decoder's pictures are the same as this decoder's, which is checked
+ * as it goes (below).
+ *
+ * What a layer above the base takes from its inter-layer reference besides its
+ * samples is the motion field, where that picture is its collocated picture
+ * for temporal motion vector prediction (MV-HEVC allows it). The separate
+ * decoder gives samples only, so such a picture is decoded from it only where
+ * the base picture has no motion: every slice of it is intra, whose motion field
+ * is known (all intra) without decoding it. A stream that predicts the motion of
+ * a layer from an inter-coded base picture is decoded here entirely.
+ *
+ * The separate decoder is trusted only once its pictures were the same, bit for
+ * bit, as this decoder's own for HEVC_BASE_LAYER_CHECKS pictures in a row, the
+ * base layer being decoded here too meanwhile. After that, a window of
+ * HEVC_BASE_LAYER_WINDOW pictures is checked the same way about every
+ * HEVC_BASE_LAYER_PERIOD pictures, starting at a random access point. Any
+ * difference, a picture the separate decoder does not give, an error of it, or
+ * a picture it cannot be used for, and this decoder decodes the base layer
+ * itself again, for good. A picture whose base layer the separate decoder gave
+ * and that is returned after it was given up (one set up while an earlier
+ * picture whose comparison found the fault was still being decoded, or one whose
+ * picture could not be copied in) says so too, and is marked corrupt
+ * (AV_FRAME_FLAG_CORRUPT): this is done as it is returned, when every frame
+ * thread that set a picture up before it has ended (FrameDecodeData.post_process).
+ * Where a picture then needs the motion field of one
+ * that came from the separate decoder, it cannot be decoded as it would have
+ * been, and is marked corrupt, as is every picture that refers to it until the
+ * next random access point (HEVC_FRAME_FLAG_CORRUPT); a caller that wants every
+ * picture as it would have been decodes from the last key frame again with the
+ * option off.
+ *
+ * Each picture says how its base layer was decoded in its metadata:
+ * "lavc.hevc.base_layer" is "separate", "checking" (decoded here and compared)
+ * or "internal"; "lavc.hevc.base_layer_checks" the number of pictures found the
+ * same so far; and once the separate decoder was given up,
+ * "lavc.hevc.base_layer_error" says why.
+ */
+
+/** Pictures compared before the separate decoder is trusted */
+#define HEVC_BASE_LAYER_CHECKS 8
+/** Pictures compared in each later window */
+#define HEVC_BASE_LAYER_WINDOW 4
+/** Pictures between the starts of two windows, at least */
+#define HEVC_BASE_LAYER_PERIOD 480
+
+/** Values of the option base_layer_decoder */
+enum {
+    HEVC_BASE_LAYER_SAME = 0,
+    HEVC_BASE_LAYER_SEPARATE,
+    /** as SEPARATE, its software pictures repacked as a hardware decoder
+     * gives them in memory (NV12, P010) first: tests that path in software */
+    HEVC_BASE_LAYER_SEPARATE_SEMIPLANAR,
+};
+
+/** How the base layer of an access unit is decoded */
+enum HEVCBaseLayerMode {
+    HEVC_BASE_LAYER_INTERNAL = 0,
+    HEVC_BASE_LAYER_USED,     ///< its samples are the separate decoder's
+    HEVC_BASE_LAYER_CHECKED,  ///< decoded here, and compared with the separate decoder's
+};
+
+#define HEVC_BASE_LAYER_MAX_PICTURES 2
+
+/** The pictures the separate decoder gave for a packet, in memory */
+typedef struct HEVCBaseLayerPicture {
+    AVFrame *frame;
+    int      poc;
+    int      intra;     ///< every slice of it is intra
+    int      corrupt;
+} HEVCBaseLayerPicture;
+
+typedef struct HEVCBaseLayerUnit {
+    HEVCBaseLayerPicture pic[HEVC_BASE_LAYER_MAX_PICTURES];
+    int nb_pics;        ///< the pictures it gave (more than it keeps, if so)
+    int fed;            ///< the packet went to the separate decoder
+    int failed;         ///< it returned an error for it
+    int64_t transfer_ns;
+} HEVCBaseLayerUnit;
+
+struct HEVCContext;
+struct HEVCFrame;
+typedef struct HEVCBaseLayer HEVCBaseLayer;
+
+/** Make the shared state (the first frame thread, or the only context). */
+int  ff_hevc_base_layer_alloc(struct HEVCContext *s);
+/** Give the packet to the separate decoder and take what it gives (setup). */
+void ff_hevc_base_layer_feed(struct HEVCContext *s, const AVPacket *pkt);
+/** At the start of a base-layer picture (setup): how it is decoded. */
+enum HEVCBaseLayerMode ff_hevc_base_layer_choose(struct HEVCContext *s);
+/** At the start of a picture of a layer above the base, in an access unit whose
+ * base picture came from the separate decoder (setup): whether it can be
+ * decoded, i.e. does not need the motion of that picture. */
+int  ff_hevc_base_layer_check_upper(struct HEVCContext *s);
+/** Put the separate decoder's picture in the base-layer frame (after setup). */
+void ff_hevc_base_layer_fill(struct HEVCContext *s);
+/** Compare this decoder's base picture with the separate decoder's (after
+ * setup); decoded: this decoder decoded the packet without an error */
+void ff_hevc_base_layer_compare(struct HEVCContext *s, int decoded);
