+static const char *edition_tag_title(MatroskaDemuxContext *matroska, uint64_t uid)
+{
+    MatroskaTags *tags = matroska->tags.elem;
+
+    for (int i = 0; uid && i < matroska->tags.nb_elem; i++) {
+        MatroskaTag *tag = tags[i].tag.elem;
+        if (tags[i].target.editionuid != uid)
+            continue;
+        for (int j = 0; j < tags[i].tag.nb_elem; j++)
+            if (tag[j].name && tag[j].string && !av_strcasecmp(tag[j].name, "TITLE"))
+                return tag[j].string;
+    }
+    return NULL;
+}
+
+static int set_u64(AVDictionary **d, const char *key, uint64_t value)
+{
+    char buf[24];
+    snprintf(buf, sizeof(buf), "%"PRIu64, value);
+    return av_dict_set(d, key, buf, 0);
+}
+
+static int set_hex(AVDictionary **d, const char *key, const EbmlBin *bin)
+{
+    char buf[2 * 64 + 1];
+    if (bin->size <= 0 || bin->size > 64)
+        return 0;
+    ff_data_to_hex(buf, bin->data, bin->size, 1);
+    buf[2 * bin->size] = 0;
+    return av_dict_set(d, key, buf, 0);
+}
+
+/* Every edition and every top-level chapter of each, as they are in the file, in the
+ * read-only "editions" option of the demuxer, so that a player can offer the editions.
+ * Nothing that is demuxed changes: not the packets, not the AVChapters, not the metadata.
+ * Keys: "count", "segment_uid" (hex, if the file has one), and for edition N (from 0):
+ * "N.uid", "N.default", "N.hidden", "N.ordered", "N.name" (EditionString, or the TITLE
+ * of a tag that targets the edition, if any), "N.chapters"; for its chapter M (from 0):
+ * "N.M.start" and "N.M.end" (ns; no end if the file has none), "N.M.uid", "N.M.hidden",
+ * "N.M.enabled", "N.M.segment_uid" (hex, only if the chapter names a segment) and
+ * "N.M.title" (if any). */
+static void matroska_export_editions(AVFormatContext *s)
+{
+    MatroskaDemuxContext *matroska = s->priv_data;
+    MatroskaEdition *editions = matroska->editions.elem;
+    AVDictionary *d = NULL;
+    char key[64];
+    int ret = 0;
+
+    if (!matroska->editions.nb_elem)
+        return;
+
+    ret |= av_dict_set_int(&d, "count", matroska->editions.nb_elem, 0);
+    ret |= set_hex(&d, "segment_uid", &matroska->segment_uid);
+    for (int e = 0; e < matroska->editions.nb_elem && ret >= 0; e++) {
+        MatroskaChapter *chapters = editions[e].chapters.elem;
+        const char *name = editions[e].title ? editions[e].title
+                                             : edition_tag_title(matroska, editions[e].uid);
+
+#define EKEY(field) (snprintf(key, sizeof(key), "%d." field, e), key)
+        ret |= set_u64(&d, EKEY("uid"), editions[e].uid);
+        ret |= av_dict_set_int(&d, EKEY("default"), !!editions[e].is_default, 0);
+        ret |= av_dict_set_int(&d, EKEY("hidden"), !!editions[e].hidden, 0);
+        ret |= av_dict_set_int(&d, EKEY("ordered"), !!editions[e].ordered, 0);
+        ret |= av_dict_set_int(&d, EKEY("chapters"), editions[e].chapters.nb_elem, 0);
+        if (name && *name)
+            ret |= av_dict_set(&d, EKEY("name"), name, 0);
+#undef EKEY
+
+        for (int c = 0; c < editions[e].chapters.nb_elem && ret >= 0; c++) {
+            MatroskaChapter *ch = &chapters[c];
+#define CKEY(field) (snprintf(key, sizeof(key), "%d.%d." field, e, c), key)
+            if (ch->start != AV_NOPTS_VALUE)
+                ret |= set_u64(&d, CKEY("start"), ch->start);
+            if (ch->end != AV_NOPTS_VALUE)
+                ret |= set_u64(&d, CKEY("end"), ch->end);
+            ret |= set_u64(&d, CKEY("uid"), ch->uid);
+            ret |= av_dict_set_int(&d, CKEY("hidden"), !!ch->hidden, 0);
+            ret |= av_dict_set_int(&d, CKEY("enabled"), !!ch->enabled, 0);
+            ret |= set_hex(&d, CKEY("segment_uid"), &ch->segment_uid);
+            if (ch->title && *ch->title)
+                ret |= av_dict_set(&d, CKEY("title"), ch->title, 0);
+#undef CKEY
+        }
+    }
+
+    if (ret < 0) {
+        /* Not needed to demux: say so and export nothing. */
+        av_log(s, AV_LOG_WARNING, "Could not export the editions of the file\n");
+        av_dict_free(&d);
+        return;
+    }
+    av_dict_free(&matroska->editions_info);
+    matroska->editions_info = d;
+}
