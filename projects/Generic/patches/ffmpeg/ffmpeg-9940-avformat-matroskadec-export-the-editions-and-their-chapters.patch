-                                   (AVRational) { 1, 1000000000 },
-                                   chapters[i].start, chapters[i].end,
-                                   chapters[i].title);
-            max_start = chapters[i].start;
-        }
+    /* The chapters of all editions, in the order of the file, as one list:
+     * the AVChapters are the same as when the editions were not kept apart. */
+    editions = matroska->editions.elem;
+    for (int e = 0; e < matroska->editions.nb_elem; e++) {
+        MatroskaChapter *chapters = editions[e].chapters.elem;
+        for (i = 0; i < editions[e].chapters.nb_elem; i++)
+            if (chapters[i].start != AV_NOPTS_VALUE && chapters[i].uid &&
+                (max_start == 0 || chapters[i].start > max_start)) {
+                chapters[i].chapter =
+                    avpriv_new_chapter(s, chapters[i].uid,
+                                       (AVRational) { 1, 1000000000 },
+                                       chapters[i].start, chapters[i].end,
+                                       chapters[i].title);
+                max_start = chapters[i].start;
+            }
+    }
 
     matroska_add_index_entries(matroska);
 
     matroska_convert_tags(s);
 
+    matroska_export_editions(s);
+
     res = matroska_parse_dovi_streams(s);
     if (res < 0)
         return res;
@@ -4577,6 +4708,7 @@
         if (tracks[n].type == MATROSKA_TRACK_TYPE_AUDIO)
             av_freep(&tracks[n].audio.buf);
     ebml_free(matroska_segment, matroska);
+    av_dict_free(&matroska->editions_info);
 
     return 0;
 }
@@ -5034,11 +5166,26 @@
 };
 #endif
 
