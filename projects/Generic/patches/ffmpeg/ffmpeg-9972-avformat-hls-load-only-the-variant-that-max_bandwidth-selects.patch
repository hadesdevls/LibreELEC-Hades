From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Hades <15710513+hadesdevls@users.noreply.github.com>
Date: Tue, 24 Nov 2026 21:10:30 +0000
Subject: [PATCH] avformat/hls: load only the variant that max_bandwidth
 selects when load_all_variants is off

The HLS demuxer loads every variant of a master playlist: it downloads
the Media Playlist of each, and of each external rendition, and opens
and probes all their streams, with a program for each variant. A player
that plays one variant (Kodi takes one program, HLSSelectProgram()) waits
for all of them at every start, and the stream is downloaded several
times while they are probed. Its author measured 15 to 25 s per HLS
channel switch in Kodi.

Two options of the demuxer change that. With load_all_variants off (it
is on by default, as before), only one variant is loaded: the one of the
highest RESOLUTION, then BANDWIDTH, of those whose bandwidth is within
max_bandwidth (0, the default, is no limit), or else the one of the
lowest bandwidth. It goes first and becomes the only variant and program;
the playlists it does not play (the other variants', and the external
renditions of groups it does not reference) are marked broken before
they are loaded, as a playlist that fails to load is, so none of them is
downloaded, probed, opened or read; they and the other variants stay
allocated until they are freed with the lists. When the variant chosen
has nothing to play (its Media Playlist does not load or is empty), the
open fails with AVERROR_INVALIDDATA, so that the caller can open the
stream again with all variants.

The RESOLUTION attribute of a variant is now read for that
(av_parse_video_size()).

This is Hades' form, for FFmpeg 9.1, of the patch that Daniil Gentili
proposed to Kodi with xbmc/xbmc#30046 ("[VideoPlayer] DemuxFFmpeg: fix
slow start of HLS streams", tools/depends/target/ffmpeg/
009-ffmpeg-all-hls-load-single-variant.patch; also in CoreELEC as
010-ffmpeg-all-hls-load-single-variant.patch): the options, their names
and the rule of the choice are his. FFmpeg 9.1 keeps the renditions in
groups (struct rendition_group) and the playlists in a tree by URL, so
here nothing is freed while the header is read: the playlists not
played are skipped as broken ones, and the variants not loaded are
freed with the list (n_all_variants). Not in FFmpeg upstream.
---
 libavformat/hls.c | 107 +++++++++++++++++++++++++++++++++++++++++++++-
 1 file changed, 106 insertions(+), 1 deletion(-)

diff --git a/libavformat/hls.c b/libavformat/hls.c
index c68b5e8..27870b7 100644
--- a/libavformat/hls.c
+++ b/libavformat/hls.c
@@ -37,6 +37,7 @@
 #include "libavutil/mathematics.h"
 #include "libavutil/mem.h"
 #include "libavutil/opt.h"
+#include "libavutil/parseutils.h"
 #include "libavutil/dict.h"
 #include "libavutil/time.h"
 #include "libavutil/tree.h"
@@ -215,6 +216,7 @@ struct rendition {
 
 struct variant {
     int bandwidth;
+    int64_t pixels; /* width * height of its RESOLUTION, 0 if it has none */
 
     /* every variant contains at least the main Media Playlist in index 0 */
     int n_playlists;
@@ -281,6 +283,11 @@ typedef struct HLSContext {
     int http_multiple;
     int http_seekable;
     int seg_max_retry;
+    int load_all_variants;
+    int64_t max_bandwidth;
+    /* with load_all_variants off: the number of variants of the master
+     * playlist, of which only the first (the one chosen) is n_variants */
+    int n_all_variants;
     AVIOContext *playlist_pb;
     HLSCryptoContext  crypto_ctx;
 } HLSContext;
@@ -349,13 +356,14 @@ static void free_playlist_list(HLSContext *c)
 static void free_variant_list(HLSContext *c)
 {
     int i;
-    for (i = 0; i < c->n_variants; i++) {
+    for (i = 0; i < FFMAX(c->n_variants, c->n_all_variants); i++) {
         struct variant *var = c->variants[i];
         av_freep(&var->playlists);
         av_free(var);
     }
     av_freep(&c->variants);
     c->n_variants = 0;
+    c->n_all_variants = 0;
 }
 
 static void free_rendition_list(HLSContext *c)
@@ -438,6 +446,7 @@ fail:
 
 struct variant_info {
     char bandwidth[20];
+    char resolution[24];
     /* variant group ids: */
     char audio[MAX_FIELD_LEN];
     char video[MAX_FIELD_LEN];
@@ -459,7 +468,11 @@ static struct variant *new_variant(HLSContext *c, struct variant_info *info,
         return NULL;
 
     if (info) {
+        int w = 0, h = 0;
+
         var->bandwidth = atoi(info->bandwidth);
+        if (info->resolution[0] && av_parse_video_size(&w, &h, info->resolution) >= 0)
+            var->pixels = (int64_t)w * h;
         strcpy(var->audio_group, info->audio);
         strcpy(var->video_group, info->video);
         strcpy(var->subtitles_group, info->subtitles);
@@ -477,6 +490,9 @@ static void handle_variant_args(void *context, const char *key,
     if (!strncmp(key, "BANDWIDTH=", key_len)) {
         *dest     =        info->bandwidth;
         *dest_len = sizeof(info->bandwidth);
+    } else if (!strncmp(key, "RESOLUTION=", key_len)) {
+        *dest     =        info->resolution;
+        *dest_len = sizeof(info->resolution);
     } else if (!strncmp(key, "AUDIO=", key_len)) {
         *dest     =        info->audio;
         *dest_len = sizeof(info->audio);
@@ -2469,6 +2485,80 @@ static int hls_close(AVFormatContext *s)
     return 0;
 }
 
+/*
+ * The playlist is one the variant plays: its own (the main Media Playlist),
+ * or one of the external renditions of a group the variant references.
+ */
+static int variant_has_playlist(HLSContext *c, const struct variant *var,
+                                const struct playlist *pls)
+{
+    const struct {
+        enum AVMediaType type;
+        const char *id;
+    } groups[] = {
+        { AVMEDIA_TYPE_AUDIO,    var->audio_group     },
+        { AVMEDIA_TYPE_VIDEO,    var->video_group     },
+        { AVMEDIA_TYPE_SUBTITLE, var->subtitles_group },
+    };
+
+    for (int i = 0; i < var->n_playlists; i++)
+        if (var->playlists[i] == pls)
+            return 1;
+    for (int i = 0; i < FF_ARRAY_ELEMS(groups); i++) {
+        const struct rendition_group *group;
+
+        if (!groups[i].id[0])
+            continue;
+        group = find_rendition_group(c, groups[i].type, groups[i].id);
+        for (int j = 0; group && j < group->n_playlists; j++)
+            if (group->playlists[j] == pls)
+                return 1;
+    }
+    return 0;
+}
+
+/*
+ * With load_all_variants off, only one variant of a master playlist is
+ * loaded: the one of the highest RESOLUTION, then BANDWIDTH, of those whose
+ * bandwidth is within max_bandwidth (0: no limit), or else the one of the
+ * lowest bandwidth. It is moved to the first place and becomes the only
+ * variant (and program); the others stay allocated until the variants are
+ * freed. The playlists that it does not play are marked broken before they
+ * are loaded, as a playlist that failed to load is: none of them is
+ * downloaded, probed, opened or read.
+ */
+static void select_single_variant(HLSContext *c)
+{
+    struct variant *sel = NULL;
+    int sel_index = 0, sel_fits = 0;
+
+    for (int i = 0; i < c->n_variants; i++) {
+        struct variant *var = c->variants[i];
+        int fits = !c->max_bandwidth || var->bandwidth <= c->max_bandwidth;
+
+        if (!sel ||
+            (fits && (!sel_fits || var->pixels > sel->pixels ||
+                      (var->pixels == sel->pixels && var->bandwidth > sel->bandwidth))) ||
+            (!fits && !sel_fits && var->bandwidth < sel->bandwidth)) {
+            sel       = var;
+            sel_index = i;
+            sel_fits  = fits;
+        }
+    }
+
+    c->variants[sel_index] = c->variants[0];
+    c->variants[0]         = sel;
+    c->n_all_variants      = c->n_variants;
+    c->n_variants          = 1;
+
+    for (int i = 0; i < c->n_playlists; i++)
+        if (!variant_has_playlist(c, sel, c->playlists[i]))
+            c->playlists[i]->broken = 1;
+
+    av_log(c->ctx, AV_LOG_VERBOSE, "Loading 1 of %d variants: bandwidth %d, %"PRId64" pixels\n",
+           c->n_all_variants, sel->bandwidth, sel->pixels);
+}
+
 static int hls_read_header(AVFormatContext *s)
 {
     HLSContext *c = s->priv_data;
@@ -2515,11 +2605,18 @@ static int hls_read_header(AVFormatContext *s)
         av_log(s, AV_LOG_WARNING, "Empty playlist\n");
         return AVERROR_EOF;
     }
+
+    if (!c->load_all_variants && c->n_variants > 1)
+        select_single_variant(c);
+
     /* If the playlist only contained playlists (Master Playlist),
      * parse each individual playlist. */
     if (c->n_playlists > 1 || c->playlists[0]->n_segments == 0) {
         for (i = 0; i < c->n_playlists; i++) {
             struct playlist *pls = c->playlists[i];
+            /* (of a variant that is not loaded) */
+            if (c->n_all_variants && pls->broken)
+                continue;
             pls->m3u8_hold_counters = 0;
             if ((ret = parse_playlist(c, pls->url, pls, NULL)) < 0) {
                 av_log(s, AV_LOG_WARNING, "parse_playlist error %s [%s]\n", av_err2str(ret), pls->url);
@@ -2537,6 +2634,10 @@ static int hls_read_header(AVFormatContext *s)
             c->variants[i]->playlists[0]->broken = 1;
         }
     }
+    /* The one variant loaded has nothing to play: the caller may open the
+     * stream again with all of them, as one may play where this one fails. */
+    if (c->n_all_variants && c->variants[0]->playlists[0]->broken)
+        return AVERROR_INVALIDDATA;
 
     /* Calculate the total duration of the stream if all segments are
      * available (finished or EVENT playlists). */
@@ -3352,6 +3453,10 @@ static const AVOption hls_options[] = {
         OFFSET(seg_format_opts), AV_OPT_TYPE_DICT, {.str = NULL}, 0, 0, FLAGS},
     {"seg_max_retry", "Maximum number of times to reload a segment on error.",
      OFFSET(seg_max_retry), AV_OPT_TYPE_INT, {.i64 = 0}, 0, INT_MAX, FLAGS},
+    {"load_all_variants", "Load every variant of a master playlist; else only the one max_bandwidth selects",
+     OFFSET(load_all_variants), AV_OPT_TYPE_BOOL, {.i64 = 1}, 0, 1, FLAGS},
+    {"max_bandwidth", "The highest bandwidth of the variant loaded when load_all_variants is off (0: no limit)",
+     OFFSET(max_bandwidth), AV_OPT_TYPE_INT64, {.i64 = 0}, 0, INT64_MAX, FLAGS},
     {NULL}
 };
 
