From 5c35cd56d0b41d6ee786b742b1c3cd870f434a1c Mon Sep 17 00:00:00 2001
From: Peter Krefting <peter@softwolves.pp.se>
Date: Wed, 18 Nov 2026 14:49:26 +0100
Subject: [PATCH] avformat/mov: Fix memory leak

The AES context allocated by cbc1_scheme_decrypt() or
cbcs_scheme_decrypt() was never cleaned up.

Found-by: Claude Opus 5.5
(cherry picked from commit 5c35cd56d0b41d6ee786b742b1c3cd870f434a1c)
---
 libavformat/mov.c | 1 +
 1 file changed, 1 insertion(+)

diff --git a/libavformat/mov.c b/libavformat/mov.c
index b28da681a3f8..4c4b618f94ec 100644
--- a/libavformat/mov.c
+++ b/libavformat/mov.c
@@ -10409,6 +10409,7 @@ static void mov_free_stream_context(AVFormatContext *s, AVStream *st)
     mov_free_encryption_index(&sc->cenc.encryption_index);
     av_encryption_info_free(sc->cenc.default_encrypted_sample);
     av_aes_ctr_free(sc->cenc.aes_ctr);
+    av_freep(&sc->cenc.aes_ctx);
 
     av_freep(&sc->stereo3d);
     av_freep(&sc->spherical);
