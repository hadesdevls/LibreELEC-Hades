From 9695f0c831d46444b6e5d92e3a20f94b30a2c1dc Mon Sep 17 00:00:00 2001
From: Timo Rothenpieler <timo@rothenpieler.org>
Date: Thu, 24 Sep 2026 14:21:41 +0200
Subject: [PATCH] avformat/mux: don't let positive write_trailer ret shadow pb
 failure

(cherry picked from commit 1de217ad4b98163b7f5a372853b1c943ed6f070d)
---
 libavformat/avformat.h | 2 +-
 libavformat/mux.c      | 4 ++--
 2 files changed, 3 insertions(+), 3 deletions(-)

diff --git a/libavformat/avformat.h b/libavformat/avformat.h
index ef2b08c4f3fc..7779476b1a0d 100644
--- a/libavformat/avformat.h
+++ b/libavformat/avformat.h
@@ -2767,7 +2767,7 @@ int av_write_uncoded_frame_query(AVFormatContext *s, int stream_index);
  * May only be called after a successful call to avformat_write_header.
  *
  * @param s media file handle
- * @return 0 if OK, AVERROR_xxx on error
+ * @return >=0 if OK, AVERROR_xxx on error
  */
 int av_write_trailer(AVFormatContext *s);
 
diff --git a/libavformat/mux.c b/libavformat/mux.c
index ea9838e38068..01115e9d21b9 100644
--- a/libavformat/mux.c
+++ b/libavformat/mux.c
@@ -1268,8 +1268,8 @@ int av_write_trailer(AVFormatContext *s)
 
     if (s->pb)
        avio_flush(s->pb);
-    if (ret == 0)
-       ret = s->pb ? s->pb->error : 0;
+    if (ret >= 0 && s->pb && s->pb->error < 0)
+       ret = s->pb->error;
     for (unsigned i = 0; i < s->nb_streams; i++) {
         av_freep(&s->streams[i]->priv_data);
         av_freep(&ffstream(s->streams[i])->index_entries);
