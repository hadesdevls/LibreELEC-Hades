From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: James Almer <jamrial@gmail.com>
Date: Thu, 29 Oct 2026 12:46:31 -0300
Subject: [PATCH] avcodec/cbs_lcevc: fix setting offsets for Encoded Data block
 payloads

It was including almost every byte from the entire NAL rather than the
Encoded Data block.

Signed-off-by: James Almer <jamrial@gmail.com>
(cherry picked from commit f806a79b7282b9a4ecf42bdb3959c78ff8234298)
---
 libavcodec/cbs_lcevc.c                 | 2 +-
 libavcodec/cbs_lcevc.h                 | 2 +-
 libavcodec/cbs_lcevc_syntax_template.c | 2 +-
 3 files changed, 3 insertions(+), 3 deletions(-)

diff --git a/libavcodec/cbs_lcevc.c b/libavcodec/cbs_lcevc.c
index f13e717..52337ca 100644
--- a/libavcodec/cbs_lcevc.c
+++ b/libavcodec/cbs_lcevc.c
@@ -453,7 +453,7 @@ static int cbs_lcevc_read_nal_unit(CodedBitstreamContext *ctx,
                 slice->data_ref = av_buffer_ref(unit->data_ref);
                 if (!slice->data_ref)
                      return AVERROR(ENOMEM);
-                slice->data = unit->data + slice->header_size;
+                slice->data = unit->data + slice->data_offset;
             }
         }
         break;
diff --git a/libavcodec/cbs_lcevc.h b/libavcodec/cbs_lcevc.h
index 371c791..0dde83a 100644
--- a/libavcodec/cbs_lcevc.h
+++ b/libavcodec/cbs_lcevc.h
@@ -121,7 +121,7 @@ typedef struct LCEVCRawEncodedData {
 
     uint8_t     *data;
     AVBufferRef *data_ref;
-    size_t       header_size;
+    ptrdiff_t    data_offset;
     size_t       data_size;
 
     LCEVCRawSequenceConfig *sc; ///< RefStruct references
diff --git a/libavcodec/cbs_lcevc_syntax_template.c b/libavcodec/cbs_lcevc_syntax_template.c
index c497c5c..cfc7a5c 100644
--- a/libavcodec/cbs_lcevc_syntax_template.c
+++ b/libavcodec/cbs_lcevc_syntax_template.c
@@ -294,7 +294,7 @@ LCEVC_BLOCK_FUNC(encoded_data, (CodedBitstreamContext *ctx, RWContext *rw,
     int pos = get_bits_count(rw) - start;
     int len = state->payload_size;
 
-    current->header_size = pos / 8;
+    current->data_offset = get_bits_count(rw) / 8;
     current->data_size = len - pos / 8;
     skip_bits_long(rw, current->data_size * 8);
 #else
