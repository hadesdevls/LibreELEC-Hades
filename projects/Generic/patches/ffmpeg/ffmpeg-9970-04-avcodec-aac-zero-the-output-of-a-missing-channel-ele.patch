From 9cee5ae719d6f82356d12782611b4a1d5866d251 Mon Sep 17 00:00:00 2001
From: Romain Beauxis <romain.beauxis@gmail.com>
Date: Tue, 22 Sep 2026 19:01:31 -0500
Subject: [PATCH] avcodec/aac: zero the output of a missing channel element

(cherry picked from commit 9cee5ae719d6f82356d12782611b4a1d5866d251)

Hades: the FATE test of this commit (tests/fate/aac.mak,
tests/ref/fate/aac-sce-in-stereo) is left out: the entries around it in
9.0.2's tests/fate/aac.mak differ from master's. The change to aacdec.c
is upstream's.
---
 libavcodec/aac/aacdec.c | 3 +++
 1 file changed, 3 insertions(+)

diff --git a/libavcodec/aac/aacdec.c b/libavcodec/aac/aacdec.c
index f8236ec89ec0..a1bface30f88 100644
--- a/libavcodec/aac/aacdec.c
+++ b/libavcodec/aac/aacdec.c
@@ -2183,6 +2183,9 @@ static void spectral_to_sample(AACDecContext *ac, int samples)
                 che->present = 0;
             } else if (che) {
                 av_log(ac->avctx, AV_LOG_VERBOSE, "ChannelElement %d.%d missing \n", type, i);
+                memset(che->ch[0].output, 0, samples * sizeof(*che->ch[0].output));
+                if (type == TYPE_CPE)
+                    memset(che->ch[1].output, 0, samples * sizeof(*che->ch[1].output));
             }
         }
     }
