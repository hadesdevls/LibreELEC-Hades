From e965898fde7bac41ac9213c91e11992a413c3112 Mon Sep 17 00:00:00 2001
From: Sakib Sarkar <sakibsarkar74@gmail.com>
Date: Wed, 11 Nov 2026 19:09:26 +0100
Subject: [PATCH] avformat/mov: reject HEIF grids without coded dimensions

Fixes: infinite loop
Fixes: YgVX1m47At6V
Fixes: heif-grid-tile-without-ispe.heic
Infinite loop Replicated through UnModified FFmpeg with timeout

Found-by: Sakib Sarkar
(cherry picked from commit e965898fde7bac41ac9213c91e11992a413c3112)
---
 libavformat/mov.c | 2 ++
 1 file changed, 2 insertions(+)

diff --git a/libavformat/mov.c b/libavformat/mov.c
index dcd290f078a8..e641f0887a4d 100644
--- a/libavformat/mov.c
+++ b/libavformat/mov.c
@@ -10710,6 +10710,8 @@ static int read_image_grid(AVFormatContext *s, const HEIFGrid *grid,
 
     if (coded_width > INT_MAX || coded_height > INT_MAX)
         return AVERROR_INVALIDDATA;
+    if (coded_width == 0 || coded_height == 0)
+        return AVERROR_INVALIDDATA;
 
     tile_grid->coded_width  = coded_width;
     tile_grid->coded_height = coded_height;
