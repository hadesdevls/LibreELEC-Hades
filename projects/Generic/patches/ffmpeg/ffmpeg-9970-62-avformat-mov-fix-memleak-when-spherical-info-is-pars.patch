From d35e13b9e05cc20f48373f88e399c8ef0c16fc61 Mon Sep 17 00:00:00 2001
From: Sathvik Prabhu <sathvik.avenger@gmail.com>
Date: Wed, 21 Oct 2026 03:55:50 +0530
Subject: [PATCH] avformat/mov: fix memleak when spherical info is parsed more
 than once

mov_read_sv3d() and mov_read_vexu_proj() unconditionally assign
sc->spherical, leaking the previous allocation when a sample
description contains both an sv3d box and a vexu box with a proj
child, as in spherical-vexu-orientation.mp4 from the FATE suite.

Free any existing structure before allocating a new one. The last
box still wins, as before.

Signed-off-by: Sathvik Prabhu <sathvik.avenger@gmail.com>
(cherry picked from commit d35e13b9e05cc20f48373f88e399c8ef0c16fc61)
---
 libavformat/mov.c | 2 ++
 1 file changed, 2 insertions(+)

diff --git a/libavformat/mov.c b/libavformat/mov.c
index 2005e0f0c72b..7c8033030054 100644
--- a/libavformat/mov.c
+++ b/libavformat/mov.c
@@ -7104,6 +7104,7 @@ static int mov_read_sv3d(MOVContext *c, AVIOContext *pb, MOVAtom atom)
         return 0;
     }
 
+    av_freep(&sc->spherical);
     sc->spherical = av_spherical_alloc(&sc->spherical_size);
     if (!sc->spherical)
         return AVERROR(ENOMEM);
@@ -7188,6 +7189,7 @@ static int mov_read_vexu_proj(MOVContext *c, AVIOContext *pb, MOVAtom atom)
         return AVERROR_INVALIDDATA;
     }
 
+    av_freep(&sc->spherical);
     sc->spherical = av_spherical_alloc(&sc->spherical_size);
     if (!sc->spherical)
         return AVERROR(ENOMEM);
