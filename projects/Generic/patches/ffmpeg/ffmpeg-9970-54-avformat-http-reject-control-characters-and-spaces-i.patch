From 1bdc17e2c8f9528c3db2140cb45002a3663d938f Mon Sep 17 00:00:00 2001
From: Michael Niedermayer <michael@niedermayer.cc>
Date: Wed, 11 Nov 2026 19:25:26 +0100
Subject: [PATCH] avformat/http: reject control characters and spaces in the
 CONNECT target

Fixes: CRLF injection
Fixes: ZDI-CAN-35984
Fixes: iUFdqPjbigVZ
CRLF injection Replicated through UnModified FFmpeg with a local TCP listener

Found-by: Yves Bieri (@yves_bieri) of Xint (@xint_official) working with TrendAI Zero Day Initiative
(cherry picked from commit 1bdc17e2c8f9528c3db2140cb45002a3663d938f)
---
 libavformat/http.c | 3 +++
 1 file changed, 3 insertions(+)

diff --git a/libavformat/http.c b/libavformat/http.c
index f5d50eaeadbb..b7d974d73ec0 100644
--- a/libavformat/http.c
+++ b/libavformat/http.c
@@ -2530,6 +2530,9 @@ static int http_proxy_open(URLContext *h, const char *uri, int flags)
     path = pathbuf;
     if (*path == '/')
         path++;
+    for (const char *p = path; *p; p++)
+        if ((uint8_t)*p <= ' ' || *p == 0x7f)
+            return AVERROR(EINVAL);
 
     ff_url_join(lower_url, sizeof(lower_url), "tcp", NULL, hostname, port,
                 NULL);
