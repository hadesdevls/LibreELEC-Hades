From 51c4a23d74ac2fbf2fb066e0ce274a966a16da23 Mon Sep 17 00:00:00 2001
From: James Almer <jamrial@gmail.com>
Date: Fri, 25 Sep 2026 13:48:10 -0300
Subject: [PATCH] avcodec/opus/dec: only add offsets to valid channel pointers

Fixes clang-ubsan warning "src/libavcodec/opus/dec.c:187:27: runtime error: applying non-zero offset 96 to null pointer"

Signed-off-by: James Almer <jamrial@gmail.com>
(cherry picked from commit c966a1de0a66de605f6f3c97fc90aff27eee71f0)
---
 libavcodec/opus/dec.c | 4 ++--
 1 file changed, 2 insertions(+), 2 deletions(-)

diff --git a/libavcodec/opus/dec.c b/libavcodec/opus/dec.c
index c353e6623d47..1617890fd59c 100644
--- a/libavcodec/opus/dec.c
+++ b/libavcodec/opus/dec.c
@@ -183,8 +183,8 @@ static int opus_flush_resample(OpusStreamContext *s, int nb_samples)
         s->redundancy_idx = 0;
     }
 
-    s->cur_out[0]         += nb_samples;
-    s->cur_out[1]         += nb_samples;
+    for (i = 0; i < s->output_channels; i++)
+        s->cur_out[i]     += nb_samples;
     s->remaining_out_size -= nb_samples * sizeof(float);
 
     return 0;
