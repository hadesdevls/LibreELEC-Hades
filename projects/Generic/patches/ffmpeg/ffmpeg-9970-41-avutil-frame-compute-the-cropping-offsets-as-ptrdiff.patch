From 19ed6f17d3b9a7d6a8904508857a3a7c5fd0d0bf Mon Sep 17 00:00:00 2001
From: Michael Niedermayer <michael@niedermayer.cc>
Date: Sat, 10 Oct 2026 07:20:27 +0200
Subject: [PATCH] avutil/frame: compute the cropping offsets as ptrdiff_t

Found during triage/review of the security report NzELYSvufGfQ
(ANT-2026-324B3XNF), which does not report this.

Fixes: pointer overflow
Pointer overflow Replicated through UnModified FFmpeg with UBSAN

(cherry picked from commit 19ed6f17d3b9a7d6a8904508857a3a7c5fd0d0bf)
---
 libavutil/frame.c | 8 ++++----
 1 file changed, 4 insertions(+), 4 deletions(-)

diff --git a/libavutil/frame.c b/libavutil/frame.c
index be30eb09d2a8..0deb25521ba3 100644
--- a/libavutil/frame.c
+++ b/libavutil/frame.c
@@ -727,7 +727,7 @@ void av_frame_remove_side_data(AVFrame *frame, enum AVFrameSideDataType type)
     av_frame_side_data_remove(&frame->side_data, &frame->nb_side_data, type);
 }
 
-static int calc_cropping_offsets(size_t offsets[4], const AVFrame *frame,
+static int calc_cropping_offsets(ptrdiff_t offsets[4], const AVFrame *frame,
                                  const AVPixFmtDescriptor *desc)
 {
     for (int i = 0; frame->data[i]; i++) {
@@ -750,8 +750,8 @@ static int calc_cropping_offsets(size_t offsets[4], const AVFrame *frame,
         if (!comp)
             return AVERROR_BUG;
 
-        offsets[i] = (frame->crop_top  >> shift_y) * frame->linesize[i] +
-                     (frame->crop_left >> shift_x) * comp->step;
+        offsets[i] = (ptrdiff_t)(frame->crop_top  >> shift_y) * frame->linesize[i] +
+                     (ptrdiff_t)(frame->crop_left >> shift_x) * comp->step;
     }
 
     return 0;
@@ -760,7 +760,7 @@ static int calc_cropping_offsets(size_t offsets[4], const AVFrame *frame,
 int av_frame_apply_cropping(AVFrame *frame, int flags)
 {
     const AVPixFmtDescriptor *desc;
-    size_t offsets[4];
+    ptrdiff_t offsets[4];
     int ret;
 
     if (!(frame->width > 0 && frame->height > 0))
