From 0b007e0634de5b4424b9993c95a6c1c50de0115b Mon Sep 17 00:00:00 2001
From: Michael Niedermayer <michael@niedermayer.cc>
Date: Fri, 30 Oct 2026 19:05:53 +0100
Subject: [PATCH] avcodec/mpegaudiodec: fail on packets too large for the bit
 reader

Fixes: NULL pointer dereference
Fixes: signed integer overflow
Fixes: LV4ZEjFMTZt7
Fixes: AISLE-2026-0150-00644
NULL pointer dereference Replicated through API with ASAN and UBSAN

Found-by: Joshua Rogers (AISLE)
(cherry picked from commit 0b007e0634de5b4424b9993c95a6c1c50de0115b)

Hades: in 9.0.2 the header fields are members of MPADecodeContext itself
(s->error_protection, not s->hdr.error_protection), so one context line
differs. The change is upstream's.
---
 libavcodec/mpegaudiodec_template.c | 4 +++-
 1 file changed, 3 insertions(+), 1 deletion(-)

diff --git a/libavcodec/mpegaudiodec_template.c b/libavcodec/mpegaudiodec_template.c
index 1aa124c0ac0a..e4f9ca0bc36e 100644
--- a/libavcodec/mpegaudiodec_template.c
+++ b/libavcodec/mpegaudiodec_template.c
@@ -1474,7 +1474,9 @@ static int mp_decode_frame(MPADecodeContext *s, OUT_INT **samples,
     int i, nb_frames, ch, ret;
     OUT_INT *samples_ptr;
 
-    init_get_bits(&s->gb, buf + HEADER_SIZE, (buf_size - HEADER_SIZE) * 8);
+    ret = init_get_bits8(&s->gb, buf + HEADER_SIZE, buf_size - HEADER_SIZE);
+    if (ret < 0)
+        return ret;
     if (s->error_protection)
         s->crc = get_bits(&s->gb, 16);
 
