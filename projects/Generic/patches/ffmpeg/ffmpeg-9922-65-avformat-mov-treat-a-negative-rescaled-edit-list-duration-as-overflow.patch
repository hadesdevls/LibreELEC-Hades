From 58416458a0ba176464a42d894cd4aabfd54171a7 Mon Sep 17 00:00:00 2001
From: Michael Niedermayer <michael@niedermayer.cc>
Date: Sat, 10 Oct 2026 04:50:50 +0200
Subject: [PATCH] avformat/mov: treat a negative rescaled edit list duration as
 overflow

Signed integer overflow Replicated through API with UBSAN

Fixes: signed integer overflow: -9223372036854775808 + -72057594037927936 cannot be represented in type 'int64_t'
Fixes: 538868974/clusterfuzz-testcase-minimized-ffmpeg_dem_MOV_fuzzer-5819272002338816
Fixes: erHRV4uA0F71

Found-by: continuous fuzzing process https://github.com/google/oss-fuzz/tree/master/projects/ffmpeg
Signed-off-by: Michael Niedermayer <michael@niedermayer.cc>
---
 libavformat/mov.c | 3 ++-
 1 file changed, 2 insertions(+), 1 deletion(-)

diff --git a/libavformat/mov.c b/libavformat/mov.c
index 0057ca7d921c..be931c3a8bb1 100644
--- a/libavformat/mov.c
+++ b/libavformat/mov.c
@@ -4204,7 +4204,8 @@ static int get_edit_list_entry(MOVContext *mov,
     *edit_list_duration = av_rescale(*edit_list_duration, msc->time_scale,
                                      global_timescale);
 
-    if (*edit_list_duration + (uint64_t)*edit_list_media_time > INT64_MAX)
+    if (*edit_list_duration < 0 ||
+        *edit_list_duration + (uint64_t)*edit_list_media_time > INT64_MAX)
         *edit_list_duration = 0;
 
     return 1;
