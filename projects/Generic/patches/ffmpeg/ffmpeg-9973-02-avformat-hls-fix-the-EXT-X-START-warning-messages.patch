From be7a24041b9d2216285781d398c23ad984af4b5d Mon Sep 17 00:00:00 2001
From: =?UTF-8?q?Kacper=20Michaj=C5=82ow?= <kasper93@gmail.com>
Date: Wed, 28 Oct 2026 04:10:20 +0100
Subject: [PATCH] avformat/hls: fix the EXT-X-START warning messages
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

Signed-off-by: Kacper Michajłow <kasper93@gmail.com>

(cherry picked from commit be7a24041b9d2216285781d398c23ad984af4b5d)
Upstream: https://github.com/FFmpeg/FFmpeg/commit/be7a24041b9d2216285781d398c23ad984af4b5d
---
 libavformat/hls.c | 8 ++++----
 1 file changed, 4 insertions(+), 4 deletions(-)

diff --git a/libavformat/hls.c b/libavformat/hls.c
index a350c9a..fd4b2ea 100644
--- a/libavformat/hls.c
+++ b/libavformat/hls.c
@@ -1180,12 +1180,12 @@ static int parse_playlist(HLSContext *c, const char *url,
                     start_time_offset = offset;
                     time_offset_flag  = 1;
                 } else {
-                    av_log(c->ctx, AV_LOG_WARNING, "TIME-OFFSET value is"
-                                                    "invalid, it will be ignored");
+                    av_log(c->ctx, AV_LOG_WARNING, "TIME-OFFSET value is "
+                                                    "invalid, it will be ignored\n");
                 }
             } else {
-                av_log(c->ctx, AV_LOG_WARNING, "#EXT-X-START value is"
-                                                "invalid, it will be ignored");
+                av_log(c->ctx, AV_LOG_WARNING, "#EXT-X-START value is "
+                                                "invalid, it will be ignored\n");
                 continue;
             }
         } else if (av_strstart(line, "#EXT-X-ENDLIST", &ptr)) {
