From 0834db516348d253b2c51f969188501d324c698d Mon Sep 17 00:00:00 2001
From: Romain Beauxis <romain.beauxis@gmail.com>
Date: Thu, 12 Nov 2026 21:39:25 -0600
Subject: [PATCH] avcodec/mpegaudiodec: set the sample rate before allocating
 the frame

decode_frame() sets the sample rate from the parsed header along with
the channel layout, before mp_decode_frame() allocates the output frame,
as decode_frame_adu() does.

The first frame after a mid-stream sample rate change carries its own
rate, as the updated mpegaudiodec-sample-rate-change reference shows.

[Hades: backport to 9.1 without tests/ref/fate/mpegaudiodec-sample-rate-change: FATE files of tests that master added after 9.1 (or, for libavformat/tests/.gitignore, a file the release tarball does not have).]

(cherry picked from commit 0834db516348d253b2c51f969188501d324c698d)
Upstream: https://github.com/FFmpeg/FFmpeg/commit/0834db516348d253b2c51f969188501d324c698d
---
 libavcodec/mpegaudiodec_template.c | 5 ++---
 1 file changed, 2 insertions(+), 3 deletions(-)

diff --git a/libavcodec/mpegaudiodec_template.c b/libavcodec/mpegaudiodec_template.c
index b146307..cb86ea1 100644
--- a/libavcodec/mpegaudiodec_template.c
+++ b/libavcodec/mpegaudiodec_template.c
@@ -1592,6 +1592,8 @@ static int decode_frame(AVCodecContext *avctx, AVFrame *frame,
         return AVERROR_INVALIDDATA;
     }
     /* update codec info */
+    if (avctx->codec_id != AV_CODEC_ID_AHX)
+        avctx->sample_rate = s->hdr.sample_rate;
     av_channel_layout_uninit(&avctx->ch_layout);
     avctx->ch_layout = s->hdr.nb_channels == 1 ? (AVChannelLayout)AV_CHANNEL_LAYOUT_MONO :
                                              (AVChannelLayout)AV_CHANNEL_LAYOUT_STEREO;
@@ -1612,9 +1614,6 @@ static int decode_frame(AVCodecContext *avctx, AVFrame *frame,
     if (ret >= 0) {
         s->frame->nb_samples = avctx->frame_size;
         *got_frame_ptr       = 1;
-        if (avctx->codec_id != AV_CODEC_ID_AHX)
-            avctx->sample_rate = s->hdr.sample_rate;
-        //FIXME maybe move the other codec info stuff from above here too
     } else {
         av_log(avctx, AV_LOG_ERROR, "Error while decoding MPEG audio frame.\n");
         /* Only return an error if the bad frame makes up the whole packet or
