From a281f3ca736805f473c69710730d3d61c6314a14 Mon Sep 17 00:00:00 2001
From: Michael Niedermayer <michael@niedermayer.cc>
Date: Wed, 11 Nov 2026 17:00:32 +0100
Subject: [PATCH] avformat/mov: do not copy an empty index to the IAMF
 substreams

Fixes: null pointer passed as argument 2, which is declared to never be null
Fixes: DPPYwrys5OTb

Found during the triage of a finding from the review of https://code.ffmpeg.org/FFmpeg/FFmpeg/pulls/25671

Null pointer argument Replicated through UnModified FFmpeg with UBSAN

(cherry picked from commit a281f3ca736805f473c69710730d3d61c6314a14)
---
 libavformat/mov.c | 3 ++-
 1 file changed, 2 insertions(+), 1 deletion(-)

diff --git a/libavformat/mov.c b/libavformat/mov.c
index 9ed34b327c12..2005e0f0c72b 100644
--- a/libavformat/mov.c
+++ b/libavformat/mov.c
@@ -5314,7 +5314,8 @@ static int mov_update_iamf_streams(MOVContext *c, const AVStream *st)
             out_sti->index_entries_allocated_size = sti->index_entries_allocated_size;
             out_sti->nb_index_entries = sti->nb_index_entries;
             out_sti->skip_samples = sti->skip_samples;
-            memcpy(out_sti->index_entries, sti->index_entries, sti->index_entries_allocated_size);
+            if (sti->index_entries_allocated_size)
+                memcpy(out_sti->index_entries, sti->index_entries, sti->index_entries_allocated_size);
         }
     }
 
