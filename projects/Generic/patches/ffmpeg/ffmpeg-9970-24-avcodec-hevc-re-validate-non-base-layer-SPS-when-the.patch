From 847acdff187e6f2f1b725644ac9eabdea7aed9f2 Mon Sep 17 00:00:00 2001
From: Nicholas Carlini <nicholas@carlini.com>
Date: Sat, 19 Sep 2026 22:06:26 +0200
Subject: [PATCH] avcodec/hevc: re-validate non-base layer SPS when the base
 SPS changes

Fixes: out of array access
Fixes: Ot8zjwCVrunh
Regression since: f926b6045522c5f9887a108f5d9b6ae017e9ba02

Found-by: Nicholas Carlini <nicholas@carlini.com>
Signed-off-by: Michael Niedermayer <michael@niedermayer.cc>
(cherry picked from commit 847acdff187e6f2f1b725644ac9eabdea7aed9f2)
---
 libavcodec/hevc/hevcdec.c | 3 +++
 1 file changed, 3 insertions(+)

diff --git a/libavcodec/hevc/hevcdec.c b/libavcodec/hevc/hevcdec.c
index bf732e734436..e4483b915736 100644
--- a/libavcodec/hevc/hevcdec.c
+++ b/libavcodec/hevc/hevcdec.c
@@ -3256,6 +3256,9 @@ static int hevc_frame_start(HEVCContext *s, HEVCLayerContext *l,
                        "Base/non-base layer SPS have unsupported parameter combination\n");
                 return AVERROR(ENOSYS);
             }
+        } else {
+            for (int i = 1; i < FF_ARRAY_ELEMS(s->layers); i++)
+                set_sps(s, &s->layers[i], NULL);
         }
 
         ff_hevc_clear_refs(l);
