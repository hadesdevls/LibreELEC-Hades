From c9bb7fb6428757dfbe270e92cc91f75723de8f74 Mon Sep 17 00:00:00 2001
From: Michael Niedermayer <michael@niedermayer.cc>
Date: Sat, 7 Nov 2026 22:08:08 +0100
Subject: [PATCH] avutil/frame: count the trailing zeros of the whole cropping
 offset

Fixes: passing zero to __builtin_ctz()
Fixes: bHs7sJdzdvhW

Found during the review of https://code.ffmpeg.org/FFmpeg/FFmpeg/pulls/25020

Passing zero to __builtin_ctz() Replicated through API with UBSAN

(cherry picked from commit c9bb7fb6428757dfbe270e92cc91f75723de8f74)
---
 libavutil/frame.c | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/libavutil/frame.c b/libavutil/frame.c
index 0deb25521ba3..ff9a8de354e7 100644
--- a/libavutil/frame.c
+++ b/libavutil/frame.c
@@ -799,7 +799,7 @@ int av_frame_apply_cropping(AVFrame *frame, int flags)
         int min_log2_align = INT_MAX;
 
         for (int i = 0; frame->data[i]; i++) {
-            int log2_align = offsets[i] ? ff_ctz(offsets[i]) : INT_MAX;
+            int log2_align = offsets[i] ? ff_ctzll(offsets[i]) : INT_MAX;
             min_log2_align = FFMIN(log2_align, min_log2_align);
         }
 
