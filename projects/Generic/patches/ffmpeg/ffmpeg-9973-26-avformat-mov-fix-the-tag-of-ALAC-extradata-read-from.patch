From 7a1aa77a3f80bbbaeeba0edc909067e005c3fa11 Mon Sep 17 00:00:00 2001
From: Baptiste Coudurier <baptiste.coudurier@gmail.com>
Date: Fri, 20 Nov 2026 15:53:48 -0800
Subject: [PATCH] avformat/mov: fix the tag of ALAC extradata read from a bare
 wave atom

It was stored as 'cala', remuxes to MOV and MP4 were undecodable.

Co-Authored-By: Claude Fable 5.2 <noreply@anthropic.com>
Signed-off-by: Baptiste Coudurier <baptiste.coudurier@gmail.com>

(cherry picked from commit 7a1aa77a3f80bbbaeeba0edc909067e005c3fa11)
Upstream: https://github.com/FFmpeg/FFmpeg/commit/7a1aa77a3f80bbbaeeba0edc909067e005c3fa11
---
 libavformat/mov.c                       | 2 +-
 tests/fate/mov.mak                      | 4 ++++
 tests/ref/fate/mov-alac-bare-wave-remux | 9 +++++++++
 3 files changed, 14 insertions(+), 1 deletion(-)
 create mode 100644 tests/ref/fate/mov-alac-bare-wave-remux

diff --git a/libavformat/mov.c b/libavformat/mov.c
index a91ed56..ec5f7db 100644
--- a/libavformat/mov.c
+++ b/libavformat/mov.c
@@ -2580,7 +2580,7 @@ static int mov_read_wave(MOVContext *c, AVIOContext *pb, MOVAtom atom)
                     return AVERROR(ENOMEM);
                 st->codecpar->extradata_size = ALAC_EXTRADATA_SIZE;
                 AV_WB32(st->codecpar->extradata    , ALAC_EXTRADATA_SIZE);
-                AV_WB32(st->codecpar->extradata + 4, MKTAG('a','l','a','c'));
+                AV_WL32(st->codecpar->extradata + 4, MKTAG('a','l','a','c'));
                 AV_WB64(st->codecpar->extradata + 12, buffer);
                 avio_read(pb, st->codecpar->extradata + 20, 16);
                 avio_skip(pb, atom.size - 24);
diff --git a/tests/fate/mov.mak b/tests/fate/mov.mak
index e467acd..57fe6b1 100644
--- a/tests/fate/mov.mak
+++ b/tests/fate/mov.mak
@@ -338,6 +338,10 @@ FATE_MOV_FFMPEG_SAMPLES-$(call REMUX, MP4 MOV, H264_PARSER) \
                           += fate-mov-mp4-multiple-stsd-muxing
 fate-mov-mp4-multiple-stsd-muxing: CMD = transcode mov $(TARGET_SAMPLES)/h264/extradata-reload-multi-stsd.mov mp4 "-c:v copy" "-c:v copy"
 
+# ALAC config stored in the wave atom without an atom header
+FATE_MOV_FFMPEG_SAMPLES-$(call REMUX, MP4 MOV, ALAC_DECODER) += fate-mov-alac-bare-wave-remux
+fate-mov-alac-bare-wave-remux: CMD = transcode mov $(TARGET_SAMPLES)/mov/01snd09.mov mp4 "-c copy -frames:a 1" "-c copy"
+
 FATE_MOV_FFMPEG_SAMPLES-$(call REMUX, MP4 MOV, AAC_PARSER) \
                           += fate-mov-mp4-edst-remainder
 fate-mov-mp4-edst-remainder: CMD = stream_remux mov $(TARGET_SAMPLES)/audiomatch/tones_fdkaac_44100_stereo_aac_lc.m4a "" mp4 "" "" "-c:a copy"
diff --git a/tests/ref/fate/mov-alac-bare-wave-remux b/tests/ref/fate/mov-alac-bare-wave-remux
new file mode 100644
index 0000000..faae8f3
--- /dev/null
+++ b/tests/ref/fate/mov-alac-bare-wave-remux
@@ -0,0 +1,9 @@
+a3fb319cc6e24b49158feefcbad691d0 *tests/data/fate/mov-alac-bare-wave-remux.mp4
+13095 tests/data/fate/mov-alac-bare-wave-remux.mp4
+#extradata 0:       36, 0x504d04a7
+#tb 0: 1/44100
+#media_type 0: audio
+#codec_id 0: alac
+#sample_rate 0: 44100
+#channel_layout_name 0: stereo
+0,          0,          0,     4096,    12372, 0x4d82c14e
