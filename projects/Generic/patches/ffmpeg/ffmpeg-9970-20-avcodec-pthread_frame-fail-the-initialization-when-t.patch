From 7a1c3ae522e770552b501021d66df20fbaeacb84 Mon Sep 17 00:00:00 2001
From: Michael Niedermayer <michael@niedermayer.cc>
Date: Mon, 12 Oct 2026 15:46:04 +0200
Subject: [PATCH] avcodec/pthread_frame: fail the initialization when the first
 worker cannot be copied back

A failed channel layout copy left the user context with a custom order
and no channel map, the following workers were then set up from it.

This is hardening, the failure was not replicated.
Found during the review of the fix for l08oZE4M5Rmz

(cherry picked from commit 7a1c3ae522e770552b501021d66df20fbaeacb84)
---
 libavcodec/pthread_frame.c | 7 +++++--
 1 file changed, 5 insertions(+), 2 deletions(-)

diff --git a/libavcodec/pthread_frame.c b/libavcodec/pthread_frame.c
index 4b9ff485a475..b88962ff5001 100644
--- a/libavcodec/pthread_frame.c
+++ b/libavcodec/pthread_frame.c
@@ -889,8 +889,11 @@ static av_cold int init_thread(PerThreadContext *p, int *threads_to_free,
     }
     p->thread_init = NEEDS_CLOSE;
 
-    if (first)
-        update_context_from_thread(avctx, copy, 1);
+    if (first) {
+        err = update_context_from_thread(avctx, copy, 1);
+        if (err < 0)
+            return err;
+    }
 
     const AVCodecContext *src = first ? copy : avctx;
     AVCodecContext       *dst = first ? avctx : copy;
