<?xml version="1.0" encoding="utf-8" ?>
<!--
  Hades: merged after packages/mediacenter/kodi/config/appliance.xml and appliance-gbm-generic.xml
  (packages/mediacenter/kodi/package.mk), and over them.

  The Monitor setting is shown. LibreELEC hides it on GBM (LibreELEC PR 11716) because in Kodi 22
  a change of it there takes effect only when Kodi starts again, past the question that keeps or
  undoes a change: a monitor that shows nothing is found out only after the restart. Hades moves
  to another display of the graphics card in use at once, with that question and the way back when
  the change is not kept, and asks before it starts Kodi again for a display of another card.
-->
<settings version="1">
  <section id="system">
    <category id="display">
      <group id="1">
        <setting id="videoscreen.monitor">
          <visible>true</visible>
        </setting>
      </group>
    </category>
  </section>
</settings>
