# Hades: what the next start of this PC starts, and the one change to it that Hades makes: BootNext, the variable
# of the firmware (UEFI) that names the boot entry to start at the next start only. The firmware deletes it when it
# uses it, so the start after that one goes by the boot order again, as always. Nothing else of the firmware is
# written: no boot entry is made, changed or deleted, and the boot order stays as it is. (That is the rule of the
# dual boot of Hades: Windows first in the boot order, the other system for one start.)
#
#   hades-bootnext status [--save]  what the firmware says: the entry this start came from, the boot order, what a
#                                   plain restart starts, and the entry of Windows if there is one. --save writes it
#                                   to /run/hades-bootnext as well, which Kodi reads for "Restart into Windows" in its
#                                   power menu, and says it in the kernel log. Exit status 0 when there is an entry
#                                   of Windows that BootNext can name.
#   hades-bootnext windows          the next start, and only that one, starts Windows.
#   hades-bootnext again            the next start, and only that one, starts this system again: for the restarts
#                                   that the system makes itself to finish something (the first start, an update, a
#                                   reset), which would otherwise go by the boot order: to Windows, on a PC where
#                                   Hades is started from the boot menu of the firmware or by "Restart into
#                                   LibreELEC Hades". Nothing is written when a plain restart starts this system
#                                   already.
#   hades-bootnext again --keep-chosen
#                                   the same, for "Reboot" of Kodi, but a BootNext that was set during this start (by
#                                   "Restart into Windows", the only thing that sets one then) is the next start that
#                                   was chosen: it is left as it is, and said ("kept=").
#
# The entry of Windows is an active boot entry whose file is \EFI\Microsoft\Boot\bootmgfw.efi, which is the entry
# that Windows makes for itself (an entry of the firmware for the disk of Windows, which starts
# \EFI\Boot\bootx64.efi, is not taken: Hades never starts Windows through that file); the first of them in the boot
# order when there are more. Only entries that are in the boot order count. What was done is on a line
# "hades-bootnext: ..." in the kernel log. Exit status: 0 done; 1 not done, with the reason on a line "error=...".
# HADES_EFIVARS and HADES_BOOTNEXT_STATE are for the tests: another folder of variables, another file.

EFIVARS=${HADES_EFIVARS:-/sys/firmware/efi/efivars}
STATE=${HADES_BOOTNEXT_STATE:-/run/hades-bootnext}
GLOBAL=8be4df61-93ca-11d2-aa0d-00e098032b8c
WINDOWS='\efi\microsoft\boot\bootmgfw.efi'
KMSG=/dev/kmsg

kmsg() {
  { echo "hades-bootnext: $1" >$KMSG; } 2>/dev/null
}

# the bytes of a variable of the firmware, its 4 bytes of attributes first, as decimal numbers on one line;
# fails when it is not there
bytes() {
  [ -f "$EFIVARS/$1-$GLOBAL" ] || return 1
  od -An -v -tu1 "$EFIVARS/$1-$GLOBAL" 2>/dev/null | tr -s ' \n' '  '
}

# A boot entry (EFI_LOAD_OPTION after the 4 bytes of attributes of efivarfs): one line
# "<active 0|1>|<category>|<description>|<file of its device path>", or "bad" when it is not one that holds
# together (a length that goes past its end, a description without its end, a node of the device path shorter
# than its header). Characters outside printable ASCII are given as "?", and "|" as "/".
ENTRY='
function chr(c) { return (c >= 32 && c < 127 && c != 124) ? sprintf("%c", c) : (c == 124 ? "/" : "?") }
{
  n = split($0, b, " ")
  if (n < 4 + 6 + 2) { print "bad"; exit }
  attr = b[5] + 256 * b[6] + 65536 * b[7] + 16777216 * b[8]
  len = b[9] + 256 * b[10]
  i = 11; desc = ""; ended = 0
  while (i + 1 <= n) {
    c = b[i] + 256 * b[i + 1]; i += 2
    if (c == 0) { ended = 1; break }
    desc = desc chr(c)
  }
  if (!ended) { print "bad"; exit }
  last = i + len - 1
  if (len < 4 || last > n) { print "bad"; exit }
  file = ""; prev = 0
  while (i + 3 <= last) {
    t = b[i]; s = b[i + 1]; l = b[i + 2] + 256 * b[i + 3]
    if (l < 4 || i + l - 1 > last) { print "bad"; exit }
    if (t == 127 && s == 255) break
    if (t == 4 && s == 4) {
      # (two file nodes in a row are one path)
      if (!prev) file = ""
      for (j = i + 4; j + 1 <= i + l - 1; j += 2) { c = b[j] + 256 * b[j + 1]; if (c == 0) break; file = file chr(c) }
      prev = 1
    } else prev = 0
    i += l
  }
  print (attr % 2) "|" (int(attr / 256) % 32) "|" desc "|" file
}'

entry() {
  local raw
  raw=$(bytes "Boot$1") || return 1
  echo "$raw" | awk "$ENTRY"
}

# a variable that is one or more 16-bit numbers (BootCurrent, BootNext, BootOrder): the numbers as 4 hexadecimal
# digits, in capitals, one after the other; nothing when it is not there or not made of whole numbers
numbers() {
  local raw
  raw=$(bytes "$1") || return 1
  echo "$raw" | awk '{ n = split($0, b, " "); if (n < 6 || n % 2) exit 1
                       for (i = 5; i < n; i += 2) printf "%s%04X", (i > 5 ? " " : ""), b[i] + 256 * b[i + 1]; print "" }'
}

field() {
  echo "$1" | cut -d'|' -f"$2"
}

lower() {
  echo "$1" | tr 'A-Z/' 'a-z\\'
}

# the file system that holds the variables (efivarfs) is mounted writable: the options of the mount with the longest
# mount point that the folder is in. (Not "test -w": busybox says yes to root for any file.)
writable() {
  awk -v p="$EFIVARS" '{ m = $2; if ((m == "/" || p == m || index(p, m "/") == 1) && length(m) >= best) { best = length(m); o = "," $4 "," } }
                       END { exit !(o != "" && o !~ /,ro,/) }' /proc/mounts 2>/dev/null
}

ORDER=""; CURRENT=""; PENDING=""; NEXT=""; WIN=""; WIN_NAME=""; CURRENT_NAME=""; NEXT_NAME=""

# reads what the firmware says into the variables above; fails when it says nothing (not a start by UEFI, or no
# boot order)
look() {
  local n e
  [ -d "$EFIVARS" ] || return 1
  ORDER=$(numbers BootOrder) || return 1
  [ -n "$ORDER" ] || return 1
  CURRENT=$(numbers BootCurrent) || CURRENT=""
  case "$CURRENT" in ????) ;; *) CURRENT="" ;; esac
  PENDING=$(numbers BootNext) || PENDING=""
  case "$PENDING" in ????) ;; *) PENDING="" ;; esac
  [ -n "$CURRENT" ] && CURRENT_NAME=$(field "$(entry "$CURRENT")" 3)
  for n in $ORDER; do
    e=$(entry "$n") || continue
    [ "$e" = bad ] && continue
    [ "$(field "$e" 1)" = 1 ] || continue
    if [ -z "$NEXT" ]; then
      NEXT=$n
      NEXT_NAME=$(field "$e" 3)
    fi
    if [ -z "$WIN" ] && [ "$(field "$e" 2)" = 0 ] && [ "$(lower "$(field "$e" 4)")" = "$WINDOWS" ]; then
      WIN=$n
      WIN_NAME=$(field "$e" 3)
    fi
  done
  # a BootNext that is there already is what the next start starts
  if [ -n "$PENDING" ]; then
    NEXT=$PENDING
    NEXT_NAME=$(field "$(entry "$PENDING")" 3)
  fi
  return 0
}

# BootNext = $1, written in one go (efivarfs takes every write as the whole variable: its 4 bytes of attributes,
# here non-volatile and seen by the firmware and by the system, and the number) and read back
set_next() {
  local n=$1 tmp="${TMPDIR:-/run}/hades-bootnext.$$" f="$EFIVARS/BootNext-$GLOBAL" got
  printf "\\007\\000\\000\\000\\$(printf %o $((0x$n % 256)))\\$(printf %o $((0x$n / 256)))" >"$tmp" 2>/dev/null
  if ! [ "$(wc -c <"$tmp" 2>/dev/null)" -eq 6 ] 2>/dev/null; then
    rm -f "$tmp"
    return 1
  fi
  if ! dd if="$tmp" of="$f" bs=6 count=1 2>/dev/null; then
    # one that is there with other attributes is not changed by the firmware: it goes, and is written again
    rm -f "$f" 2>/dev/null
    dd if="$tmp" of="$f" bs=6 count=1 2>/dev/null
  fi
  rm -f "$tmp"
  got=$(numbers BootNext) || return 1
  [ "$got" = "$n" ]
}

say_state() {
  echo "uefi=yes"
  echo "current=$CURRENT"
  echo "current_name=$CURRENT_NAME"
  echo "order=$ORDER"
  echo "next=$NEXT"
  echo "next_name=$NEXT_NAME"
  echo "windows=$WIN"
  echo "windows_name=$WIN_NAME"
  if writable; then echo "writable=yes"; else echo "writable=no"; fi
}

case "$1" in
  status)
    if ! look; then
      out="uefi=no"
      kmsg_line="no boot order of UEFI firmware here: 'Restart into Windows' is not offered"
      code=1
    else
      out=$(say_state)
      if [ -z "$WIN" ]; then
        kmsg_line="no entry of Windows in the boot order (${ORDER}): 'Restart into Windows' is not offered"
        code=1
      elif ! writable; then
        kmsg_line="the variables of the firmware are read-only here: 'Restart into Windows' is not offered"
        code=1
      else
        kmsg_line="Windows is Boot$WIN \"$WIN_NAME\"; this start came from Boot${CURRENT:-?} \"$CURRENT_NAME\"; a plain restart starts Boot${NEXT:-?} \"$NEXT_NAME\""
        code=0
      fi
    fi
    echo "$out"
    if [ "$2" = "--save" ]; then
      rm -f "$STATE.new"
      if echo "$out" >"$STATE.new" && mv -f "$STATE.new" "$STATE"; then
        kmsg "$kmsg_line"
      else
        rm -f "$STATE.new"
        kmsg "$kmsg_line (and $STATE could not be written)"
      fi
    fi
    exit $code
    ;;
  windows)
    if ! look; then
      echo "error=not-uefi"
      kmsg "Windows not set for the next start: no boot order of UEFI firmware here"
      exit 1
    fi
    if [ -z "$WIN" ]; then
      echo "error=no-windows-entry"
      kmsg "Windows not set for the next start: no entry of Windows in the boot order ($ORDER)"
      exit 1
    fi
    if ! writable; then
      echo "error=read-only"
      kmsg "Windows not set for the next start: the variables of the firmware are read-only"
      exit 1
    fi
    if ! set_next "$WIN"; then
      echo "error=not-written"
      kmsg "Windows not set for the next start: the firmware did not keep BootNext=$WIN"
      exit 1
    fi
    echo "bootnext=$WIN"
    kmsg "the next start, and only that one, starts Windows: BootNext=$WIN \"$WIN_NAME\""
    exit 0
    ;;
  again)
    if [ "$2" = "--keep-chosen" ] && look && [ -n "$PENDING" ] && [ "$PENDING" != "$CURRENT" ]; then
      echo "bootnext=none"
      echo "kept=$PENDING"
      kmsg "the next start was chosen already (BootNext=$PENDING \"$NEXT_NAME\"): left as it is"
      exit 0
    fi
    if ! look || [ -z "$CURRENT" ]; then
      echo "error=no-current-entry"
      kmsg "the next start goes by the boot order: the firmware does not say which entry this start came from"
      exit 1
    fi
    if [ "$NEXT" = "$CURRENT" ]; then
      echo "bootnext=none"
      kmsg "a plain restart starts this system already (Boot$CURRENT \"$CURRENT_NAME\"): nothing written"
      exit 0
    fi
    if ! entry "$CURRENT" >/dev/null || ! writable || ! set_next "$CURRENT"; then
      echo "error=not-written"
      kmsg "the next start goes by the boot order (Boot${NEXT:-?} \"$NEXT_NAME\"): BootNext=$CURRENT could not be set"
      exit 1
    fi
    echo "bootnext=$CURRENT"
    kmsg "the next start, and only that one, starts this system again: BootNext=$CURRENT \"$CURRENT_NAME\" (a plain restart would start Boot${NEXT:-?} \"$NEXT_NAME\")"
    exit 0
    ;;
  *)
    echo "usage: hades-bootnext status [--save] | windows | again [--keep-chosen]"
    exit 1
    ;;
esac
