# Hades: gives the boot menus back their wait after an update. The update (usr/share/bootloader/update.sh,
# run by the init of the system that applies it) makes the menus of the PC start the system at once, for the
# one start that follows, by a block of lines between "# hades-once-begin" and "# hades-once-end" that it
# puts in each menu: without it, the update would show the boot menu twice (before it is applied and after the
# restart that ends it), which looks to anyone who did not ask for a menu like an installer that came back.
# This runs at every start of the system (hades-menu-once.service) and, where those lines are in a menu, takes
# exactly them out: the menu is then byte for byte the one that was there before the update. Where the lines
# are not there it does nothing and does not touch the boot partition.
#
# Written the way the rest of the code that changes a menu is: the new menu is written next to the old one,
# written through to the device and read back, and renamed over it, so that a power cut leaves the menu with
# the lines or without them; never one cut in two. The boot partition is made writable for that and read-only
# again after, unless it was writable before. A menu that cannot be made right is left as it is, and said;
# the lines stay and the next start tries again (they only make the system start at once, they do not
# take the entries away: Shift held at the start of the BIOS menu, Escape in the one of GRUB).
# The exit status is always 0.

BOOT=/flash
BEGIN='# hades-once-begin'
END='# hades-once-end'
KMSG=/dev/kmsg
MOUNTS=/proc/mounts

say() {
  echo "hades-menu: $1"
  { echo "hades-menu: $1" >$KMSG; } 2>/dev/null
}

# the menu without the block (lines may end with CR LF); fails if a block does not end
REMOVE='
{ l = $0; sub(/\r$/, "", l) }
!skip && l == b { skip = 1; next }
skip && l == e { skip = 0; next }
!skip { print }
END { if (skip) exit 1 }
'

same() {
  local a b
  a=$(md5sum <"$1" 2>/dev/null) || return 1
  b=$(md5sum <"$2" 2>/dev/null) || return 1
  [ -n "$a" ] && [ "$a" = "$b" ]
}

flash_is() {
  awk -v m="$BOOT" '$2 == m { o = "," $4 "," } END { if (o == "") print "none"; else if (o ~ /,ro,/) print "ro"; else print "rw" }' "$MOUNTS" 2>/dev/null
}

restore() {
  local f="$1" was tmp="${HADES_MENU_TMP:-/run}/hades-menu-once.$$"
  [ -f "$f" ] && [ ! -L "$f" ] || return 0
  grep -q -F -e "$BEGIN" "$f" 2>/dev/null || return 0
  if ! awk -v b="$BEGIN" -v e="$END" "$REMOVE" "$f" >"$tmp" 2>/dev/null; then
    say "${f#$BOOT/} is left as it is: its lines of the update do not end"
    rm -f "$tmp"
    return 0
  fi
  if grep -q -F -e "$BEGIN" "$tmp" || grep -q -F -e "$END" "$tmp" || [ ! -s "$tmp" ]; then
    say "${f#$BOOT/} is left as it is: what would be left is not a menu"
    rm -f "$tmp"
    return 0
  fi
  was=$(flash_is)
  if [ "$was" = ro ] && ! mount -o remount,rw "$BOOT"; then
    say "${f#$BOOT/} is left as it is: the boot partition could not be made writable"
    rm -f "$tmp"
    return 0
  fi
  rm -f "$f.new"
  if cp "$tmp" "$f.new" && sync "$f.new" && same "$f.new" "$tmp" && mv -f "$f.new" "$f" &&
     sync "$f" "${f%/*}" && same "$f" "$tmp"; then
    say "${f#$BOOT/} has its wait again"
  else
    rm -f "$f.new"
    say "${f#$BOOT/} could not be given its wait again: the next start tries again"
  fi
  sync
  if [ "$was" = ro ] && ! mount -o remount,ro "$BOOT"; then
    say "the boot partition could not be made read-only again"
  fi
  rm -f "$tmp"
  return 0
}

restore "$BOOT/EFI/BOOT/grub.cfg"
restore "$BOOT/syslinux.cfg"
exit 0
