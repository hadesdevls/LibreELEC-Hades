[Unit]
Description=Notes what a restart of the PC starts, for the power menu of Kodi (Hades)
# (/run/hades-bootnext: whether "Restart into Windows" is offered; written before Kodi starts)
After=sys-firmware-efi-efivars.mount
Before=kodi.service

[Service]
Type=oneshot
ExecStart=/bin/sh /usr/lib/libreelec/hades-bootnext status --save
# (1: no entry of Windows, or no UEFI firmware: the file says so, and that is not a failure)
SuccessExitStatus=1
TimeoutStartSec=20

[Install]
WantedBy=multi-user.target
