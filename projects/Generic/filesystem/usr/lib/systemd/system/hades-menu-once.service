[Unit]
Description=Gives the boot menus their wait again after an update (Hades)
RequiresMountsFor=/flash

[Service]
Type=oneshot
ExecStart=/bin/sh /usr/lib/libreelec/hades-menu-once
# (it only reads and writes the two boot menus on the boot partition)
TimeoutStartSec=30

[Install]
WantedBy=multi-user.target
