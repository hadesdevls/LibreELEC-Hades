#!/bin/bash

# SPDX-License-Identifier: GPL-2.0-or-later
# Copyright (C) 2009-2016 Stephan Raue (stephan@openelec.tv)
# Copyright (C) 2016-present Team LibreELEC (https://libreelec.tv)

################################################################################
# variables such as ${ROOT} ${PATH} etc... that are required for this
# script to work must be passed via env ... in scripts/image
################################################################################

# set variables
IMG_TMP=$(mktemp -d -p ${TARGET_IMG})
SAVE_ERROR="${IMG_TMP}/save_error"

if [ -z "${SYSTEM_SIZE}" -o -z "${SYSTEM_PART_START}" ]; then
  echo "mkimage: SYSTEM_SIZE and SYSTEM_PART_START must be configured!"
  exit 1
fi

DISK_START_PADDING=$(((${SYSTEM_PART_START} + 2048 - 1) / 2048))
DISK_GPT_PADDING=1
DISK_SIZE=$((${DISK_START_PADDING} + ${SYSTEM_SIZE} + ${STORAGE_SIZE} + ${DISK_GPT_PADDING}))
DISK_BASENAME="${TARGET_IMG}/${IMAGE_NAME}"
DISK="${DISK_BASENAME}.img"

# functions
cleanup() {
  echo -e "image: cleanup...\n"
  rm -rf "${IMG_TMP}"
}

show_error() {
  echo "image: An error has occurred..."
  echo
  if [ -s "${SAVE_ERROR}" ]; then
    cat "${SAVE_ERROR}"
  else
    echo "Folder ${IMG_TMP} might be out of free space..."
  fi
  echo
  cleanup
  exit 1
}

trap cleanup SIGINT

# create an image
echo -e "\nimage: creating sparse file for disk image ${DISK##*/}..."
dd if=/dev/zero of="${DISK}" bs=1M count=0 seek="${DISK_SIZE}" conv=fsync >"${SAVE_ERROR}" 2>&1 || show_error

if [ "${BOOTLOADER}" = "syslinux" ]; then
  DISK_LABEL=gpt
else
  DISK_LABEL=msdos
fi

# write a disklabel
echo "image: creating ${DISK_LABEL} partition table..."
parted -s "${DISK}" mklabel ${DISK_LABEL}
sync

# create partitions
echo "image: creating partitions..."

SYSTEM_PART_END=$((${SYSTEM_PART_START} + (${SYSTEM_SIZE} * 1024 * 1024 / 512) - 1))
STORAGE_PART_START=$((${SYSTEM_PART_END} + 1))
STORAGE_PART_END=$((${STORAGE_PART_START} + (${STORAGE_SIZE} * 1024 * 1024 / 512) - 1))

if [ "${DISK_LABEL}" = "gpt" ]; then
  parted -s "${DISK}" -a min unit s mkpart system fat32 ${SYSTEM_PART_START} ${SYSTEM_PART_END}
  parted -s "${DISK}" -a min unit s mkpart storage ext4 ${STORAGE_PART_START} ${STORAGE_PART_END}
  parted -s "${DISK}" set 1 legacy_boot on
else
  parted -s "${DISK}" -a min unit s mkpart primary fat32 ${SYSTEM_PART_START} ${SYSTEM_PART_END}
  parted -s "${DISK}" -a min unit s mkpart primary ext4 ${STORAGE_PART_START} ${STORAGE_PART_END}
  parted -s "${DISK}" set 1 boot on
fi
sync

if [ "${BOOTLOADER}" = "syslinux" ]; then
  # write mbr
  echo "image: writing mbr..."
  dd bs=440 count=1 conv=fsync,notrunc if="${TOOLCHAIN}/share/syslinux/gptmbr.bin" of="${DISK}" >"${SAVE_ERROR}" 2>&1 || show_error
fi

# create part2 to format and copy files
echo "image: creating sparse file for part2..."
STORAGE_PART_COUNT=$((${STORAGE_PART_END} - ${STORAGE_PART_START} + 1))
sync
dd if="${DISK}" of="${IMG_TMP}/part2.ext4" bs=512 count=0 seek="${STORAGE_PART_COUNT}" conv=fsync >"${SAVE_ERROR}" 2>&1 || show_error

# create filesystem on part2
echo "image: creating filesystem on part2..."
mke2fs -F -q -t ext4 -O ^orphan_file -m 0 "${IMG_TMP}/part2.ext4"
tune2fs -L "${DISTRO_DISKLABEL}" -U ${UUID_STORAGE} "${IMG_TMP}/part2.ext4" >"${SAVE_ERROR}" 2>&1 || show_error
e2fsck -n "${IMG_TMP}/part2.ext4" >"${SAVE_ERROR}" 2>&1 || show_error
sync

# add resize mark
mkdir "${IMG_TMP}/part2.fs"
touch "${IMG_TMP}/part2.fs/.please_resize_me"
echo "image: populating filesystem on part2..."
populatefs -U -d "${IMG_TMP}/part2.fs" "${IMG_TMP}/part2.ext4" >"${SAVE_ERROR}" 2>&1 || show_error
sync
e2fsck -n "${IMG_TMP}/part2.ext4" >"${SAVE_ERROR}" 2>&1 || show_error

# merge part2 into disk image
echo "image: merging part2 into disk image..."
dd if="${IMG_TMP}/part2.ext4" of="${DISK}" bs=512 seek="${STORAGE_PART_START}" conv=fsync,notrunc >"${SAVE_ERROR}" 2>&1 || show_error

# create disk image for virtual appliance
if [ "${PROJECT}" = "Generic" ]; then
  echo "image: creating open virtual appliance..."
  # duplicate ${DISK} so anything we do to it directly doesn't effect original
  dd if="${DISK}" of="${DISK_BASENAME}.tmp" bs=1M conv=fsync >"${SAVE_ERROR}" 2>&1 || show_error
fi

# create part1 to format and copy files
echo "image: creating sparse file for part1..."
SYSTEM_PART_COUNT=$((${SYSTEM_PART_END} - ${SYSTEM_PART_START} + 1))
sync
dd if=/dev/zero of="${IMG_TMP}/part1.fat" bs=512 count=0 seek="${SYSTEM_PART_COUNT}" conv=fsync >"${SAVE_ERROR}" 2>&1 || show_error

shopt -s expand_aliases # enables alias expansion in script
alias mcopy='mcopy -i "${IMG_TMP}/part1.fat" -o'
alias mmd='mmd -i "${IMG_TMP}/part1.fat"'

# create filesystem on part1
echo "image: creating filesystem on part1..."

if [ "${BOOTLOADER}" = "syslinux" -o "${BOOTLOADER}" = "bcm2835-bootloader" -o "${BOOTLOADER}" = "u-boot" ]; then
  mformat -i "${IMG_TMP}/part1.fat" -v "${DISTRO_BOOTLABEL}" -N "${UUID_SYSTEM//-/}" :: >"${SAVE_ERROR}" 2>&1 || show_error
fi
sync

# Hades: on USB boot entries the NVMe and AHCI (SATA) controllers are not initialised, so the
# internal disks do not exist for the running system. The installer and
# the .ova keep them visible.
HIDE_INTERNAL_DISKS="initcall_blacklist=nvme_init,ahci_pci_driver_init"
# The same entries lock the kernel down (integrity), so that the running system cannot undo that:
# only modules signed with the key of this build, no /dev/mem, no PCI or I/O port access from
# user space. The entry that shows the internal disks, and the installer,
# keep the kernel as LibreELEC has it (driver add-ons with their own modules, debugfs writes,
# serial port settings).
LOCK_DOWN_KERNEL="lockdown=integrity"
# The same entries ask for DMA translation, so that a device reaches only the memory that the kernel maps for
# its transfers: a device whose firmware is not its maker's (the kernel loads firmware from files that root can
# put there, and the lockdown does not look at them) cannot write to the memory of the kernel and undo the two
# above. iommu.passthrough=0 gives each device a translated domain where the computer has an IOMMU (on AMD the
# kernel uses it whenever the firmware describes it); intel_iommu=on turns on the DMA remapping of Intel, which
# the kernel of this build leaves off unless asked, and igfx_off leaves the unit of Intel's integrated graphics
# off, as it is today (the AMD IOMMU driver keeps the integrated graphics of AMD, which can share the address
# space of a program, in passthrough by itself). The unmapping is the kernel's default, in batches, as in the
# kernels of Ubuntu, Fedora, Debian and Arch. Without an IOMMU, or with it off in the firmware setup, the words do
# nothing. The entry that shows the internal disks, the installer and the .ova start as LibreELEC does: every
# device in passthrough. What a start has is in the kernel log ("hades-iommu:", the init).
PROTECT_DMA="iommu.passthrough=0 intel_iommu=on,igfx_off"
# What a person chooses for the start of the system is kept in these two menus, and nowhere else: which entry
# starts by itself (the setting of the internal disks), how long the menus wait for a key, and the kernel options
# below. The system changes them in place (internal-disks), and the installer for Windows carries them across an
# update. That installer writes this partition as a whole and can only change bytes of it, not the length of a
# file, so each choice is written in a form whose length does not depend on the value:
#   - the wait, 5 seconds: in syslinux.cfg in tenths of a second with three digits (TIMEOUT 050; syslinux reads it
#     with atoi(), in base 10), in grub.cfg in seconds with two ("05"; grub_strtoul() takes a leading 0 for octal
#     only when the next digit is 0 to 7, so 01 to 09 are 1 to 9), and the line of the BIOS text menu that says it
#     padded with spaces to the length that it has with two digits;
#   - each option as NAME=0 or NAME=1, on the entries that start the system for use (not the installer): 0 is the
#     default of the parameter, so the kernel starts as it would without the word. i915 and amdgpu are built into
#     the kernel, and the kernel line is the only place where their parameters reach them.
#     i915.hdmi_hdr_gmp: HDR over the HDMI port of Intel graphics of display version 9 (linux-9988).
#     amdgpu.dvbridge_dce: the Dolby Vision tunnel on the display cores of AMD Polaris and Vega (linux-9971).
# The word boot-choices in the first line of the menus says so.
BOOT_WAIT=5
BOOT_WAIT_TENTHS=$(printf '%03d' $((BOOT_WAIT * 10)))
BOOT_WAIT_SECONDS=$(printf '%02d' ${BOOT_WAIT})
if [ ${BOOT_WAIT} -eq 1 ]; then
  BOOT_WAIT_WORDS="1 second..."
else
  BOOT_WAIT_WORDS="${BOOT_WAIT} seconds..."
fi
BOOT_WAIT_WORDS=$(printf '%-13s' "${BOOT_WAIT_WORDS}")
BOOT_OPTIONS="i915.hdmi_hdr_gmp=0 amdgpu.dvbridge_dce=0"

if [ "${BOOTLOADER}" = "syslinux" ]; then
  # create bootloader configuration
  echo "image: creating bootloader configuration..."
  # Hades: the first line of both menus says what the installer for Windows may do with this
  # image. storage-anywhere: /storage can be any partition of its disk (see fs-resize).
  # other-disks-hidden: on an internal disk, where the parameter that hides the internal disks
  # would hide the disk of the system itself, the installer puts hades.otherdisks=hide in its
  # place, and the init takes the other internal disks away (hide_other_disks in the init).
  # boot-choices: the wait and the kernel options are written in a form of a fixed length (BOOT_WAIT above), so
  # that the installer can keep them across an update.
  # The words of the options say what each one does, for a person who did not ask for a menu. On a BIOS
  # computer the menu is drawn by vesamenu.c32 with the look of the build (hades/menu.cfg, from
  # packages/tools/syslinux): each entry with its name and, under the list, the line of the chosen one
  # (TEXT HELP, at most 63 characters: after the 16 spaces that put it under the list it has to fit the
  # 80 columns of the text menu that vesamenu shows without a graphic mode); without it, or without
  # vesamenu.c32, the words below and the prompt, as before. The
  # labels are what is typed, and the init and internal-disks know them; the entry that starts by
  # itself is first and the installer last.
  cat <<EOF >"${IMG_TMP}/syslinux.cfg"
# hades-features: storage-anywhere other-disks-hidden boot-choices
SAY Wait for run mode to start automatically in ${BOOT_WAIT_WORDS}
SAY
SAY LibreELEC Hades: type an option and press Enter
SAY ===============================================
SAY run:       the normal start (recommended). This computer's other NVMe and SATA disks stay hidden
SAY internal:  like run, and shows the internal disks, mounted read-only
SAY live:      settings and add-ons stay in memory only, gone at power off
SAY installer: installs LibreELEC Hades on a disk you choose, erasing it. Asks twice first
SAY
DEFAULT run
TIMEOUT ${BOOT_WAIT_TENTHS}
PROMPT 1
INCLUDE /hades/menu.cfg

LABEL run
  MENU LABEL Run (recommended)
  TEXT HELP
                The normal start. The other NVMe and SATA disks stay hidden.
  ENDTEXT
  KERNEL /${KERNEL_NAME}
  APPEND boot=UUID=${UUID_SYSTEM} disk=UUID=${UUID_STORAGE} portable quiet ${HIDE_INTERNAL_DISKS} ${LOCK_DOWN_KERNEL} ${BOOT_OPTIONS} ${PROTECT_DMA}

LABEL internal
  MENU LABEL Run (internal disks read-only)
  TEXT HELP
                Like Run, and shows the internal disks, mounted read-only.
  ENDTEXT
  KERNEL /${KERNEL_NAME}
  APPEND boot=UUID=${UUID_SYSTEM} disk=UUID=${UUID_STORAGE} portable quiet ${BOOT_OPTIONS}

LABEL live
  MENU LABEL Live
  TEXT HELP
                Settings and add-ons stay in memory only, gone at power off.
  ENDTEXT
  KERNEL /${KERNEL_NAME}
  APPEND boot=UUID=${UUID_SYSTEM} live quiet vga=current ${HIDE_INTERNAL_DISKS} ${LOCK_DOWN_KERNEL} ${BOOT_OPTIONS} ${PROTECT_DMA}

LABEL installer
  MENU LABEL Installer
  TEXT HELP
                Installs it on a disk you choose, erasing it. Asks twice first.
  ENDTEXT
  KERNEL /${KERNEL_NAME}
  APPEND boot=UUID=${UUID_SYSTEM} installer quiet systemd.debug_shell vga=current
EOF

  # The GRUB menu: the entry that starts by itself first and the installer last, the wait above, and the look of
  # the build (packages/tools/grub/theme: a picture for each entry, its name and what it does), read
  # from EFI/BOOT/hades only where it is there; without it, or in a mode it has no theme for, the
  # same entries as a text menu. The titles are the ones that the init, internal-disks and the
  # installers know; the class of an entry names its picture. Each entry first goes back to the
  # console, which gives the screen back to the mode of the firmware where the theme had to switch
  # it, so that the kernel starts in the mode it always started in (theme.cfg).
  # Each entry starts the kernel of the partition that its boot= names, the system partition of this
  # image: the one whose file system has that identifier (search --fs-uuid, which GRUB compares without
  # regard to case), looked for first on the partition that GRUB read this menu from (its root when the
  # entry starts). LibreELEC took the first /KERNEL on any disk, and with a second drive that has another
  # build on it GRUB could start that drive's kernel with the SYSTEM of this one, which has no modules for
  # it. Where no file system has that identifier, the kernel of the partition of this menu is started if
  # it has one, and only then the first /KERNEL on any disk, as before: what started before still starts.
  # The installers know these lines (installer-bootmenus, internal-disks; the installer for Windows
  # writes this partition as it is, with its identifier).
  cat <<EOF >"${IMG_TMP}/grub.cfg"
# hades-features: storage-anywhere other-disks-hidden boot-choices
if [ -f "\${prefix}/hades/theme.cfg" ]; then source "\${prefix}/hades/theme.cfg"; fi
set timeout="${BOOT_WAIT_SECONDS}"
set default="Run"
menuentry "Run" --class hades-run {
	terminal_output console
	search --no-floppy --fs-uuid --set=root --hint="\${root}" ${UUID_SYSTEM}
	if [ ! -f /KERNEL ]; then search --set -f /KERNEL; fi
	linux /KERNEL boot=UUID=${UUID_SYSTEM} disk=UUID=${UUID_STORAGE} grub_portable quiet ${HIDE_INTERNAL_DISKS} ${LOCK_DOWN_KERNEL} ${BOOT_OPTIONS} ${PROTECT_DMA}
}
menuentry "Run (internal disks read-only)" --class hades-internal {
	terminal_output console
	search --no-floppy --fs-uuid --set=root --hint="\${root}" ${UUID_SYSTEM}
	if [ ! -f /KERNEL ]; then search --set -f /KERNEL; fi
	linux /KERNEL boot=UUID=${UUID_SYSTEM} disk=UUID=${UUID_STORAGE} grub_portable quiet ${BOOT_OPTIONS}
}
menuentry "Live" --class hades-live {
	terminal_output console
	search --no-floppy --fs-uuid --set=root --hint="\${root}" ${UUID_SYSTEM}
	if [ ! -f /KERNEL ]; then search --set -f /KERNEL; fi
	linux /KERNEL boot=UUID=${UUID_SYSTEM} grub_live quiet vga=current ${HIDE_INTERNAL_DISKS} ${LOCK_DOWN_KERNEL} ${BOOT_OPTIONS} ${PROTECT_DMA}
}
menuentry "Installer" --class hades-installer {
	terminal_output console
	search --no-floppy --fs-uuid --set=root --hint="\${root}" ${UUID_SYSTEM}
	if [ ! -f /KERNEL ]; then search --set -f /KERNEL; fi
	linux /KERNEL boot=UUID=${UUID_SYSTEM} installer quiet systemd.debug_shell vga=current
}
EOF

  mcopy "${IMG_TMP}/syslinux.cfg" :: >"${SAVE_ERROR}" 2>&1 || show_error

  # install syslinux
  echo "image: installing syslinux to part1..."
  syslinux.mtools -i "${IMG_TMP}/part1.fat" >"${SAVE_ERROR}" 2>&1 || show_error
  # Hades: the look of the BIOS menu, which syslinux.cfg includes (packages/tools/syslinux)
  mcopy -s "${TOOLCHAIN}/share/syslinux/hades" :: >"${SAVE_ERROR}" 2>&1 || show_error

  # copy files
  echo "image: copying files to part1..."
  mcopy "${TARGET_IMG}/${BUILD_NAME}.kernel" "::/${KERNEL_NAME}" >"${SAVE_ERROR}" 2>&1 || show_error
  mcopy "${TARGET_IMG}/${BUILD_NAME}.system" ::/SYSTEM >"${SAVE_ERROR}" 2>&1 || show_error
  mcopy "${RELEASE_DIR}/target/KERNEL.md5" "::/${KERNEL_NAME}.md5" >"${SAVE_ERROR}" 2>&1 || show_error
  mcopy "${RELEASE_DIR}/target/SYSTEM.md5" ::/SYSTEM.md5 >"${SAVE_ERROR}" 2>&1 || show_error

  mmd EFI EFI/BOOT >"${SAVE_ERROR}" 2>&1 || show_error
  # Hades: 64-bit UEFI boots GRUB built from source instead of the prebuilt syslinux EFI
  # loader
  mcopy "${TOOLCHAIN}/share/grub/bootx64.efi" ::/EFI/BOOT >"${SAVE_ERROR}" 2>&1 || show_error
  mcopy "${TOOLCHAIN}/share/grub/bootia32.efi" ::/EFI/BOOT >"${SAVE_ERROR}" 2>&1 || show_error
  mcopy "${IMG_TMP}/grub.cfg" ::/EFI/BOOT >"${SAVE_ERROR}" 2>&1 || show_error
  # Hades: the look of the boot menu, which grub.cfg reads (packages/tools/grub/theme)
  mcopy -s "${TOOLCHAIN}/share/grub/hades" ::/EFI/BOOT >"${SAVE_ERROR}" 2>&1 || show_error

  # Hades: the notice of the build and the licence texts go with the image, on the partition that
  # any system can read. The release .tar has them too (scripts/image).
  mcopy -s "${RELEASE_DIR}/licenses" :: >"${SAVE_ERROR}" 2>&1 || show_error
  for notice in "${RELEASE_DIR}"/NOTICE*; do
    mcopy "${notice}" :: >"${SAVE_ERROR}" 2>&1 || show_error
  done

  # Hades: the switch of the diagnostics, off (packages/sysutils/hades-diag): renamed to DIAG-ON.TXT it
  # turns them on. An upper-case 8.3 name, which takes one directory entry: the installer for Windows
  # turns it on by changing that entry in place.
  mcopy "${RELEASE_DIR}/DIAG-OFF.TXT" :: >"${SAVE_ERROR}" 2>&1 || show_error

elif [ "${BOOTLOADER}" = "bcm2835-bootloader" ]; then
  # create bootloader configuration
  echo "image: creating bootloader configuration..."
  cat <<EOF >"${IMG_TMP}/cmdline.txt"
boot=UUID=${UUID_SYSTEM} disk=UUID=${UUID_STORAGE} quiet ${EXTRA_CMDLINE}
EOF

  mcopy "${IMG_TMP}/cmdline.txt" :: >"${SAVE_ERROR}" 2>&1 || show_error

  # copy files
  echo "image: copying files to part1..."
  mcopy "${TARGET_IMG}/${BUILD_NAME}.kernel" "::/${KERNEL_NAME}" >"${SAVE_ERROR}" 2>&1 || show_error
  mcopy "${TARGET_IMG}/${BUILD_NAME}.system" ::/SYSTEM >"${SAVE_ERROR}" 2>&1 || show_error
  mcopy "${RELEASE_DIR}/target/KERNEL.md5" "::/${KERNEL_NAME}.md5" >"${SAVE_ERROR}" 2>&1 || show_error
  mcopy "${RELEASE_DIR}/target/SYSTEM.md5" ::/SYSTEM.md5 >"${SAVE_ERROR}" 2>&1 || show_error

  for f in bootcode.bin fixup.dat start.elf; do
    if [ -f "${RELEASE_DIR}/3rdparty/bootloader/$f" ]; then
      mcopy "${RELEASE_DIR}/3rdparty/bootloader/$f" :: >"${SAVE_ERROR}" 2>&1 || show_error
    fi
  done

  mcopy "${RELEASE_DIR}/3rdparty/bootloader/config.txt" :: >"${SAVE_ERROR}" 2>&1 || show_error
  for distro in "${RELEASE_DIR}/3rdparty/bootloader/distroconfig"*.txt; do
    if [ -f "${distro}" ]; then
      mcopy "${distro}" ::/"${distro##*/}" >"${SAVE_ERROR}" 2>&1 || show_error
    fi
  done

  for dtb in "${RELEASE_DIR}/3rdparty/bootloader/"*.dtb; do
    if [ -f "${dtb}" ]; then
      mcopy "${dtb}" ::/"${dtb##*/}" >"${SAVE_ERROR}" 2>&1 || show_error
    fi
  done

  if [ -d "${RELEASE_DIR}/3rdparty/bootloader/overlays" ]; then
    mcopy -s "${RELEASE_DIR}/3rdparty/bootloader/overlays" :: >"${SAVE_ERROR}" 2>&1 || show_error
  fi

elif [ "${BOOTLOADER}" = "u-boot" -a -n "${UBOOT_SYSTEM}" ]; then
  # create bootloader configuration
  echo "image: creating bootloader configuration..."

  DTB="$(${SCRIPTS}/uboot_helper ${PROJECT} ${DEVICE} ${UBOOT_SYSTEM} dtb)"
  if [ -n "${DTB}" ]; then

    if [ -f "${RELEASE_DIR}/3rdparty/bootloader/${DTB}" ]; then
      mcopy "${RELEASE_DIR}/3rdparty/bootloader/${DTB}" :: >"${SAVE_ERROR}" 2>&1 || show_error
    fi

    if [ -d "${RELEASE_DIR}/3rdparty/bootloader/overlays" ]; then
      mcopy -s "${RELEASE_DIR}/3rdparty/bootloader/overlays" :: >"${SAVE_ERROR}" 2>&1 || show_error
    fi

    mkdir -p "${IMG_TMP}/extlinux"

    cat <<EOF >"${IMG_TMP}/extlinux/extlinux.conf"
LABEL ${DISTRO}
  LINUX /${KERNEL_NAME}
  FDT /${DTB}
  APPEND boot=UUID=${UUID_SYSTEM} disk=UUID=${UUID_STORAGE} quiet ${EXTRA_CMDLINE}
EOF

    mcopy -s "${IMG_TMP}/extlinux" :: >"${SAVE_ERROR}" 2>&1 || show_error
  fi

  if [ -f "${PROJECT_DIR}/${PROJECT}/devices/${DEVICE}/bootloader/mkimage" ]; then
    . "${PROJECT_DIR}/${PROJECT}/devices/${DEVICE}/bootloader/mkimage"
  elif [ -f "${PROJECT_DIR}/${PROJECT}/bootloader/mkimage" ]; then
    . "${PROJECT_DIR}/${PROJECT}/bootloader/mkimage"
  else
    echo "image: skipping u-boot. no mkimage script found"
  fi

  echo "image: copying files to part1..."
  mcopy "${TARGET_IMG}/${BUILD_NAME}.kernel" "::/${KERNEL_NAME}" >"${SAVE_ERROR}" 2>&1 || show_error
  mcopy "${TARGET_IMG}/${BUILD_NAME}.system" ::/SYSTEM >"${SAVE_ERROR}" 2>&1 || show_error
  mcopy "${RELEASE_DIR}/target/KERNEL.md5" "::/${KERNEL_NAME}.md5" >"${SAVE_ERROR}" 2>&1 || show_error
  mcopy "${RELEASE_DIR}/target/SYSTEM.md5" ::/SYSTEM.md5 >"${SAVE_ERROR}" 2>&1 || show_error

elif [ "${BOOTLOADER}" = "u-boot" ]; then
  echo "to make an image using u-boot UBOOT_SYSTEM must be set"
  cleanup
  exit
fi # bootloader

# run fsck
echo "image: checking filesystem on part1..."
sync
fsck.fat -n "${IMG_TMP}/part1.fat" >"${SAVE_ERROR}" 2>&1 || show_error

# merge part1 into disk image
echo "image: merging part1 into disk image..."
dd if="${IMG_TMP}/part1.fat" of="${DISK}" bs=512 seek="${SYSTEM_PART_START}" conv=fsync,notrunc >"${SAVE_ERROR}" 2>&1 || show_error

# finalize virtual appliance
if [ "${PROJECT}" = "Generic" ]; then
  # change syslinux default to 'run'
  echo "image: modifying files on part1 for open virtual appliance..."
  sed -e "/DEFAULT/ s/installer/run/" -i "${IMG_TMP}/syslinux.cfg"
  sed -e "/set default=/s/\"Installer\"/\"Run\"/" -i "${IMG_TMP}/grub.cfg"
  # the virtual machine's system disk is internal: never hide internal disks in the .ova, nor lock
  # the kernel down for that, nor ask for DMA translation (an IOMMU that a hypervisor emulates makes every
  # unmapping a trap to it)
  sed -e "s/ ${HIDE_INTERNAL_DISKS}//" -e "s/ ${LOCK_DOWN_KERNEL}//" -e "s/ ${PROTECT_DMA//./\\.}//" \
    -i "${IMG_TMP}/syslinux.cfg" "${IMG_TMP}/grub.cfg"
  mcopy "${IMG_TMP}/syslinux.cfg" :: >"${SAVE_ERROR}" 2>&1 || show_error
  mcopy "${IMG_TMP}/grub.cfg" ::/EFI/BOOT >"${SAVE_ERROR}" 2>&1 || show_error
  sync
  # run fsck
  echo "image: checking filesystem on part1..."
  fsck.fat -n "${IMG_TMP}/part1.fat" >"${SAVE_ERROR}" 2>&1 || show_error
  # merge modified part1 into tmp disk image
  echo "image: merging part1 into open virtual appliance..."
  dd if="${IMG_TMP}/part1.fat" of="${DISK_BASENAME}.tmp" bs=512 seek="${SYSTEM_PART_START}" conv=fsync,notrunc >"${SAVE_ERROR}" 2>&1 || show_error
  # create vmdk from tmp ${DISK}
  echo "image: creating vmdk for open virtual appliance..."
  qemu-img convert -O vmdk -o subformat=streamOptimized "${DISK_BASENAME}.tmp" "${DISK_BASENAME}.vmdk"
  # generate ovf from template
  sed -e "s,@DISTRO@,${DISTRO},g" \
    -e "s,@DISTRO_HOME_URL@,${DISTRO_HOME_URL},g" \
    -e "s,@DISK@,${IMAGE_NAME},g" \
    -e "s,@OVA_SIZE@,$((${OVA_SIZE} * 1024 * 1024)),g" \
    "${PROJECT_DIR}/${PROJECT}/config/ovf.template" >"${DISK_BASENAME}.ovf"
  # combine ovf and vmdk into official ova
  tar -C "${TARGET_IMG}" -cf "${DISK_BASENAME}.ova" "${IMAGE_NAME}.ovf" "${IMAGE_NAME}.vmdk"
  # create sha256 checksum of ova image
  (
    cd "${TARGET_IMG}"
    sha256sum "${IMAGE_NAME}.ova" >"${IMAGE_NAME}.ova.sha256"
  )
  echo "image: cleaning up open virtual appliance..."
  # remove tmp ${DISK}, vmdk and ovf
  rm "${DISK_BASENAME}.tmp" "${DISK_BASENAME}.vmdk" "${DISK_BASENAME}.ovf"
fi

# gzip
echo "image: compressing..."
# Hades: the gzip header keeps the time of the file: the one of SOURCE_DATE_EPOCH (config/options)
if [ -n "${SOURCE_DATE_EPOCH}" ]; then
  touch -d "@${SOURCE_DATE_EPOCH}" "${DISK}"
fi
pigz --best --force "${DISK}"

# create sha256 checksum of image
(
  cd "${TARGET_IMG}"
  sha256sum "${DISK##*/}.gz" >"${DISK##*/}.gz.sha256"
)

# cleanup
cleanup
exit
